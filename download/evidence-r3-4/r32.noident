INSERT INTO public.document_chunks VALUES ('c67d7349-c52d-4aee-b275-65a1d12d66a4', '7d73db06-aceb-4fb9-afe9-f3b2c3322a0c', 9, '(d) The maximum temperature rise in Experiment 2 was less than that in Experiment 1. Suggest a reason why.
