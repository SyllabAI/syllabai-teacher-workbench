INSERT INTO public.question_parts VALUES ('600a528b-db20-4252-8d72-acea96b16d14', '39b0ed09-d8ff-4a7f-b2c3-ebe10df7c5fd', 'a', 'One week after the start of the experiment the volume of gas in the measuring cylinder has decreased. After two weeks there is no further decrease in volume of gas in the measuring cylinder. Explain these observations.', NULL, 0, 0, '2026-09-13 12:59:09.692602+00');
INSERT INTO public.question_parts VALUES ('b6670574-1774-4510-bf4c-cb84ab260b05', '39b0ed09-d8ff-4a7f-b2c3-ebe10df7c5fd', 'b', 'Iron reacts with dilute sulfuric acid. The chemical equation for this reaction is $\mathrm {F e} + \mathrm {H} _ {2} \mathrm {S O} _ {4} \rightarrow \mathrm {F e S O} _ {4} + \mathrm {H} _ {2}$ Complete the word equation for the reaction. $\mathrm {I r o n} + \mathrm {s u l f u r i c a c i d} \rightarrow$', NULL, 0, 1, '2026-09-13 12:59:09.692624+00');
INSERT INTO public.question_parts VALUES ('0063c8ac-f2c3-4784-ae58-4152df660204', '39b0ed09-d8ff-4a7f-b2c3-ebe10df7c5fd', 'c', 'Aqueous sodium hydroxide can be used to distinguish between solutions containing iron(II) ions $ \mathrm{(F e^{2+})} $ and iron(III) ions $ \mathrm{(F e^{3+})}. $ State the observation made when aqueous sodium hydroxide is added separately to each solution. $\mathrm {F e} ^ {2 +} (\mathrm {a q}).$ $\mathrm {F e} ^ {3 +} (\mathrm {a q}).$', NULL, 0, 2, '2026-09-13 12:59:09.692649+00');
