alse, "label": "5", "marks": 1, "number": 5, "entryId": "ms-89ae639f-q5", "guidance": [{"kind": "note", "text": "5/five"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "(iii)"}, {"kind": "note", "text": "M1 hydrocarbons contain only carbon and hydrogen (atoms)"}, {"kind": "note", "text": "M2 methanoic acid/it contains oxygen (as well as hydrogen and carbon)"}, {"kind": "note", "text": "REJECT molecules"}, {"kind": "note", "text": "(b)(i)"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "M1(electrostatic) attraction between nuclei"}, {"kind": "note", "text": "Must be plural"}, {"kind": "note", "text": "M2(and the) shared pair of electrons"}, {"kind": "note", "text": "OR"}, {"kind": "note", "text": "M1(electrostatic) attraction between shared pair(s) of electrons"}, {"kind": "note", "text": "Must be plural"}, {"kind": "note", "text": "M2 and nuclei"}, {"kind": "allow", "text": "ALLOW any combination of dots and crosses"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "M13 pairs of electrons for 3 single bonds"}, {"kind": "note", "text": "M3 dep on M1 and M2 correct"}, {"kind": "note", "text": "M22 shared pairs for one C=O double bond"}, {"kind": "note", "text": "M3rest of molecule fully correct(lone pairs on oxygen atoms must be shown)"}, {"kind": "note", "text": "(c)"}, {"kind": "note", "text": "(c)"}, {"kind": "note", "text": "·divide percentages by relative atomic masses"}, {"kind": "note", "text": "·divide results by smallest value to obtain ratio"}, {"kind": "note", "text": "·write empirical formula"}, {"kind": "note", "text": "0 marks if division by atomic numbers or upside-down calculation"}, {"kind": "example-calculation", "text": "Example calculation"}, {"kind": "note", "text": "M1"}, {"kind": "note", "text": "C52.2/12"}, {"kind": "note", "text": "H13.0/1"}, {"kind": "note", "text": "O34.8/16"}, {"kind": "note", "text": "M2"}, {"kind": "note", "text": "4.35/2.175"}, {"kind": "note", "text": "13.0/2.175"}, {"kind": "note", "text": "2.175/2.175"}, {"kind": "note", "text": "OR"}, {"kind": "note", "text": "M3"}, {"kind": "note", "text": "C2H6O"}, {"kind": "note", "text": "ACCEPT symbols in any order"}, {"kind": "note", "text": "Total 12"}], "answerText": "(a)(i)", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "7(a)", "marks": 2, "number": 7, "entryId": "ms-89ae639f-q7a", "guidance": [{"kind": "note", "text": "M2white powder/solid(formed)"}, {"kind": "allow", "text": "ALLOWwhite smoke/ashALLOWgrey powderREJECTwhite precipitate"}, {"kind": "note", "text": "gives out/releases heat(energy)/thermal energy"}, {"kind": "ignore", "text": "IGNOREenergy alone"}, {"kind": "note", "text": "(b)(i)"}, {"kind": "note", "text": "2Al+Fe2O3→2Fe+Al2O3"}, {"kind": "allow", "text": "ALLOWmultiples and fractions"}, {"kind": "note", "text": "An explanation that links two of the following pairs of points"}, {"kind": "note", "text": "M1aluminium/Al gains oxygen so is oxidised"}, {"kind": "note", "text": "ACCEPTaluminium loses electrons so is oxidised"}, {"kind": "note", "text": "M2iron oxide/Fe2O3loses oxygen so is reduced"}, {"kind": "note", "text": "ACCEPTiron ions/Fe3+ions gain electrons so are reduced"}, {"kind": "note", "text": "OR"}, {"kind": "note", "text": "M1aluminium/Al is oxidised and iron oxide/Fe2O3is reduced"}, {"kind": "note", "text": "ACCEPTaluminium loses electrons and iron ions/Fe3+ions gain electrons"}, {"kind": "note", "text": "M2as aluminium/Al gains oxygen and iron oxide/Fe2O3loses oxygen"}, {"kind": "allow", "text": "ALLOWanswers in terms of change in oxidation number"}, {"kind": "note", "text": "(c)(i)"}, {"kind": "note", "text": "An explanation that links the following two points"}, {"kind": "note", "text": "M1to allow air/oxygen to enter the crucible OWTTE"}, {"kind": "note", "text": "M2so that oxygen can react with the magnesium"}, {"kind": "note", "text": "A description that refers to the following points"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "M1heat the crucible again and reweigh"}, {"kind": "note", "text": "Heat and reweigh to constant mass scores 2"}, {"kind": "note", "text": "M2repeat until constant mass"}, {"kind": "note", "text": "Total 10"}], "answerText": "M1(bright) white flame/light", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "8", "marks": 1, "number": 8, "entryId": "ms-89ae639f-q8", "guidance": [{"kind": "note", "text": "(thermal) decomposition"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "M1amount ofPbCO3=5.34/267=0.02(00)(mol)"}, {"kind": "note", "text": "Correct answer without working scores2"}, {"kind": "note", "text": "M2mass ofPbO=0.02(00)x223=4.46(g)"}, {"kind": "note", "text": "ACCEPT alternative methods"}, {"kind": "note", "text": "(b)(i)"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "M1diagram showing delivery tube going into test tube containing liquid"}, {"kind": "note", "text": "REJECT if sealed with a bung"}, {"kind": "note", "text": "M2limewater labelled(limewater)turns cloudy/milky"}, {"kind": "allow", "text": "ALLOWwhite precipitate(ii) dep on mention of limewater in either(i) or(ii)"}, {"kind": "note", "text": "(c)"}, {"kind": "note", "text": "An explanation that links six of the following points"}, {"kind": "note", "text": "M1silicon dioxide has a giant(covalent) structure"}, {"kind": "note", "text": "M2covalent bonds are(very) strong"}, {"kind": "note", "text": "M3(in silicon dioxide)many covalent bonds need to be broken"}, {"kind": "note", "text": "M4a large amount of energy/more energy is required to break the bonds in silicon dioxide"}, {"kind": "note", "text": "NoM3orM4if reference to intermolecular forces in silicon dioxide"}, {"kind": "note", "text": "M5carbon dioxide has a simple molecular structure/is a simple molecule"}, {"kind": "note", "text": "M6the forces between the molecules/intermolecular forces(in carbon dioxide)are weak"}, {"kind": "note", "text": "NoM6orM7if any reference to weak covalent bonds or breaking of covalent bonds in carbon dioxideAccept bonds between molecules weak"}, {"kind": "note", "text": "M7very little energy/less energy is needed to overcome the forces between the molecules/intermolecular forces(in carbon dioxide)"}, {"kind": "note", "text": "A statement such as‘more energy is needed to break the bonds in silicon dioxide than to overcome the forces between the molecules/intermolecular forces(in carbon dioxide)’scoresM4andM7"}], "answerText": "(a)(i)\nTotal12", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "9(a)(i)", "marks": 1, "number": 9, "entryId": "ms-89ae639f-q9ai", "guidance": [{"kind": "note", "text": "ACCEPT upper case letters"}, {"kind": "note", "text": "effervescence/bubbles/fizzing"}, {"kind": "ignore", "text": "IGNORE gas produced/given off"}, {"kind": "ignore", "text": "IGNORE hydrogen produced/given off"}, {"kind": "allow", "text": "ALLOW colourless solution formed/get hot/exothermic reaction/zinc dissolves"}, {"kind": "ignore", "text": "IGNORE crystals form"}, {"kind": "note", "text": "(b)(i)"}, {"kind": "note", "text": "so all the nitric acid reacts/is neutralised"}, {"kind": "note", "text": "A description which refers to the following five points"}, {"kind": "note", "text": "M1 filter off the excess zinc"}, {"kind": "note", "text": "M2 heat the solution until crystals form"}, {"kind": "allow", "text": "ALLOW heat until the solution is saturated/heat until crystals form on the end of a glass rod/heat to evaporate some of the water"}, {"kind": "note", "text": "M3 leave the solution to cool (and crystallise)"}, {"kind": "note", "text": "M4 pour/filter off excess liquid (to obtain crystals)"}, {"kind": "ignore", "text": "IGNORE washing"}, {"kind": "note", "text": "M5 leave (crys