INSERT INTO public.document_chunks VALUES ('2312e065-6f48-4e91-aa77-b2b32e76edc6', 'af780c72-e434-4ad3-a427-2d60f856f6b3', 6, '(ii) Complete the following diagram to show the structural formula of heptene $ \mathrm{(C_{7}H_{14})} $ by inserting lines to represent the covalent bonds between the carbon atoms.
\begin{array}{c c c c c c c} H & H & H & H & H & H \\ | & | & | & | & | \\ C & C & C & C & C & C \\ | & & | & | & | \\ H & & H & H & H & H \end{array}
