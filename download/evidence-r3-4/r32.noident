INSERT INTO public.question_parts VALUES ('c5c3d69f-58b7-423b-93bc-57b8e7a1f6f8', 'e341d05a-d8dd-4c63-80f8-e7869b40e808', 'd', 'Complete the chemical equation for the reaction between lead nitrate and potassium iodide. $\mathrm {P b} \left(\mathrm {N O} _ {3}\right) _ {2} (\mathrm {a q}) + \dots \dots \dots \dots \dots \dots \dots \mathrm {K I} (\mathrm {a q}) \rightarrow \mathrm {P b I} _ {2} (\mathrm {s}) + \dots \dots \dots \dots \dots \dots \dots \mathrm {K N O} _ {3} (\mathrm {a q})$', NULL, 0, 4, '2026-09-13 12:55:23.884582+00');
INSERT INTO public.question_parts VALUES ('e47763ac-3cee-404d-b9d4-e1cd93ed1378', 'f1a85966-527f-4130-a591-5a9f5fd149c0', 'a', 'When iron rusts, it reacts with oxygen in the air. A student uses the rusting of iron to find the percentage of oxygen in a sample of air. The diagram shows the apparatus. These are the student''s results. volume of air in conical flask and connecting tube $ = 2 6 5 \mathrm{c m}^{3} $ volume of air in gas syringe at start = 100 $ cm^{3} $ volume of air in gas syringe at end = 25 $ cm^{3} $ Calculate the percentage of oxygen in the sample of air using the student''s results.', NULL, 0, 0, '2026-09-13 12:55:23.884628+00');
INSERT INTO public.question_parts VALUES ('826561a7-43ad-4159-9b4a-df91db143cc7', 'f1a85966-527f-4130-a591-5a9f5fd149c0', 'b', 'Cars are painted to prevent the iron in car bodies from rusting. Explain how painting prevents the iron in car bodies from rusting.', NULL, 0, 1, '2026-09-13 12:55:23.884652+00');
INSERT INTO public.question_parts VALUES ('a8b242b1-a092-4cd1-89f8-7c902f12298d', 'f1a85966-527f-4130-a591-5a9f5fd149c0', 'b-ii', 'Some car manufacturers use paint containing tiny particles of zinc. Explain how particles of zinc prevent iron in car bodies from rusting even when this paint is scratched.', NULL, 0, 2, '2026-09-13 12:55:23.884692+00');
INSERT INTO public.question_parts VALUES ('1af5655f-23c0-4f89-ab2a-ed04a5d6b12a', '7b736eea-6e94-4725-a0eb-fabe4ab06e5d', 'a', 'The box gives some methods used to separate mixtures. Complete the table by giving the correct method from the box for each separation. Each method can be used once, more than once or not at all.', NULL, 4, 0, '2026-09-13 12:55:23.884736+00');
INSERT INTO public.question_parts VALUES ('5ef8d32e-e6ff-4984-bdd1-3760c70397b6', '7b736eea-6e94-4725-a0eb-fabe4ab06e5d', 'b', 'A student uses chromatography to analyse the composition of purple ink. The diagram shows the student''s chromatogram at the end of the experiment.', NULL, 0, 1, '2026-09-13 12:55:23.884763+00');
INSERT INTO public.question_parts VALUES ('67c4b723-ae46-48da-9b02-f3b536c1e94d', '7b736eea-6e94-4725-a0eb-fabe4ab06e5d', 'b-i', 'Explain which dyes are contained in the purple ink.', NULL, 0, 2, '2026-09-13 12:55:23.884791+00');
INSERT INTO public.question_parts VALUES ('9790a1e8-11e0-4b49-93a4-8cdd2025eb37', '7b736eea-6e94-4725-a0eb-fabe4ab06e5d', 'b-ii', 'Explain which dye is least soluble in the solvent.', NULL, 0, 3, '2026-09-13 12:55:23.884813+00');
INSERT INTO public.question_parts VALUES ('07dfb9dc-2c09-4ff8-92ab-54c2a66792be', '7b736eea-6e94-4725-a0eb-fabe4ab06e5d', 'c', 'A different chromatography experiment is set up. A spot of food colouring is placed on the start line. A food dye in the colouring has an $ R_{f} $ value of 0.72 The distance between the start line and the solvent front is 120mm. Calculate the distance the food dye moves from the start line.', NULL, 0, 4, '2026-09-13 12:55:23.884836+00');
INSERT INTO public.question_parts VALUES ('b69f3267-3771-4446-bcd6-bc0b734c0f47', '34c79939-56f4-4ec1-a0fb-bcf27faacf11', 'a', 'When solutions of salts are mixed together, precipitates sometimes form. The insoluble salt barium carbonate forms as a precipitate when solutions of the soluble salts ammonium carbonate and barium chloride react together. When solutions of the soluble salts potassium chloride and magnesium sulfate are mixed, no precipitate forms. Complete the table to show the results of mixing solutions of some soluble salts.', NULL, 0, 0, '2026-09-13 12:55:23.884872+00');
INSERT INTO public.question_parts VALUES ('8a00884e-7659-40b1-b351-e98623b421f8', '34c79939-56f4-4ec1-a0fb-bcf27faacf11', 'b', 'A student has four unlabelled beakers, each containing a colourless solution of a different salt. The four solutions are potassium chloride potassium carbonate potassium iodide sodium chloride Describe a method to identify each solution. Do not refer to safety in your answer.', NULL, 0, 1, '2026-09-13 12:55:23.8849+00');
INSERT INTO public.question_parts VALUES ('61e6f8a4-5285-4385-97b9-4ddcfc2362da', '97f03133-60d0-46ef-9562-64de1a8c78a8', 'a', 'The diagram shows the electron configurations of an atom of lithium and an atom of oxygen. oxygen Describe the changes in electronic configuration when lithium and oxygen react to form lithium oxide, $ \mathrm{L i_{2} O} $', NULL, 0, 0, '2026-09-13 12:55:23.884932+00');
INSERT INTO public.question_parts VALUES ('f13ee124-b6a5-4f1d-8f7c-27189328fbf7', '97f03133-60d0-46ef-9562-64de1a8c78a8', 'b', 'Lithium oxide reacts with water to form lithium hydroxide as the only product. A scientist uses this apparatus to measure the temperature change of the reaction. This is the scientist''s method. pour 100g of water into a polystyrene cup record the temperature of the water add the lithium oxide and stir the mixture record the maximum temperature reached The diagram shows the thermometer readings before and after adding the lithium oxide.', NULL, 0, 1, '2026-09-13 12:55:23.884959+00');
INSERT INTO public.question_parts VALUES ('b1d92132-984f-4554-81d8-313483a9afbd', '97f03133-60d0-46ef-9562-64de1a8c78a8', 'b-i', 'Complete the table, giving all values to the nearest 0.1 $ ^{\circ} \mathrm{C}. $', NULL, 0, 2, '2026-09-13 12:55:23.884983+00');
INSERT INTO public.question_parts VALUES ('83b3e3fa-640e-4f00-b4f2-343dd1fea0b5', '97f03133-60d0-46ef-9562-64de1a8c78a8', 'b-ii', 'Calculate the heat energy change in the reaction. Give your answer to two significant figures. $[ \mathrm {c} = 4. 2 \mathrm {J} / \mathrm {g} / ^ {\circ} \mathrm {C} ]$', NULL, 0, 3, '2026-09-13 12:55:23.885007+00');
INSERT INTO public.question_parts VALUES ('5e4f2f59-84ee-43e8-a9fd-885b326f0faa', '97f03133-60d0-46ef-9562-64de1a8c78a8', 'b-iii', 'In another experiment the scientist obtains these results. Calculate the molar enthalpy change $ (\Delta H) $ in kJ/mol. Include a sign in your answer.', NULL, 0, 4, '2026-09-13 12:55:23.885041+00');
