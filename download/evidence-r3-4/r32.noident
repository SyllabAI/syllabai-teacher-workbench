\begin{array}{l l l l} \mathrm {R e a c t i o n 1} & \mathrm {C O (g)} + 2 \mathrm {H} _ {2} (\mathrm {g}) \rightleftharpoons \mathrm {C H} _ {3} \mathrm {O H} (\mathrm {g}) & \Delta H = - 9 1 \mathrm {k J / m o l} \\ \mathrm {R e a c t i o n 2} & \mathrm {C O} _ {2} (\mathrm {g}) + 3 \mathrm {H} _ {2} (\mathrm {g}) \rightleftharpoons \mathrm {C H} _ {3} \mathrm {O H} (\mathrm {g}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {g}) & \Delta H = - 4 9 \mathrm {k J / m o l} \end{array}
