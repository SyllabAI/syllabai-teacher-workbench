INSERT INTO public.question_versions VALUES ('e910ba58-bb96-4401-98bf-f06ea26f2e96', 'c67b8e10-632a-4c42-9444-cb3f54a642a2', 1, 'Sodium hydroxide dissolves in water, forming a strongly alkaline solution. Ammonia dissolves in water, forming a slightly less alkaline solution. (a) (i) Identify the ion that makes the sodium hydroxide solution alkaline. (ii) What is a possible pH of ammonia solution? (1) A 3 B 6 C 11 D 14', 1, 3, 90, NULL, 'SUGGESTED', '0f21a459-f60c-59ba-807b-612e0e57b5bd', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:55:23.308576+00');
INSERT INTO public.question_versions VALUES ('1fdeaa16-65cb-4f19-8822-9746c42e1fb4', 'cf2b2d22-dde6-438c-8ef9-a1932c6ba6e6', 1, '(a) Chlorine, bromine and iodine are elements in the Periodic Table. Explain how the position of these elements in the Periodic Table depends on their electronic configurations.', 12, 3, 1080, NULL, 'SUGGESTED', '0f21a459-f60c-59ba-807b-612e0e57b5bd', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:55:23.30905+00');
