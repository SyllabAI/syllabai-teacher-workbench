mathrm {a q}) + 2 \\mathrm {H} _ {2} \\mathrm {O} (\\mathrm {I})", "latex": "2 \\mathrm {L i O H} (\\mathrm {a q}) + \\mathrm {H} _ {2} \\mathrm {S O} _ {4} (\\mathrm {a q}) \\rightarrow \\mathrm {L i} _ {2} \\mathrm {S O} _ {4} (\\mathrm {a q}) + 2 \\mathrm {H} _ {2} \\mathrm {O} (\\mathrm {I})", "confidence": 1.0, "element_id": "e000130", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 130, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {C} _ {2} \\mathrm {H} _ {4} + \\mathrm {H} _ {2} \\rightarrow \\mathrm {C} _ {2} \\mathrm {H} _ {6}", "latex": "\\mathrm {C} _ {2} \\mathrm {H} _ {4} + \\mathrm {H} _ {2} \\rightarrow \\mathrm {C} _ {2} \\mathrm {H} _ {6}", "confidence": 1.0, "element_id": "e000138", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 138, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {C} _ {6} \\mathrm {H} _ {1 2} \\mathrm {O} _ {6} \\rightarrow 2 \\mathrm {C} _ {2} \\mathrm {H} _ {5} \\mathrm {O H} + 2", "latex": "\\mathrm {C} _ {6} \\mathrm {H} _ {1 2} \\mathrm {O} _ {6} \\rightarrow 2 \\mathrm {C} _ {2} \\mathrm {H} _ {5} \\mathrm {O H} + 2", "confidence": 1.0, "element_id": "e000152", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 152, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {C} _ {2} \\mathrm {H} _ {4} (\\mathrm {g}) + \\mathrm {H} _ {2} \\mathrm {O} (\\mathrm {g}) \\rightleftharpoons \\mathrm {C} _ {2} \\mathrm {H} _ {5} \\mathrm {O H} (\\mathrm {g})", "latex": "\\mathrm {C} _ {2} \\mathrm {H} _ {4} (\\mathrm {g}) + \\mathrm {H} _ {2} \\mathrm {O} (\\mathrm {g}) \\rightleftharpoons \\mathrm {C} _ {2} \\mathrm {H} _ {5} \\mathrm {O H} (\\mathrm {g})", "confidence": 1.0, "element_id": "e000158", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 158, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "pageCount": 1, "documentId": "517cf287-98ae-553f-9c06-a0b2adeb4644", "provenance": {"engine": "glm-ocr-markdown", "application": "syllabai-parser", "extractedAt": "2026-09-13T13:01:04.617734605Z", "engineVersion": "1.1.0", "schemaVersion": "1.0", "extractionParams": {"pageBoundaries": "none-in-source", "sourceLineCount": 214, "upstreamConverter": "zai-glm-ocr", "entityDecodedLines": 0, "signedUrlFigureRefs": 0, "normalizedHtmlEntities": true}}, "textBlocks": [{"role": "heading", "text": "Instructions", "confidence": 1.0, "element_id": "e000001", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 1, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Use black ink or ball-point pen.", "confidence": 1.0, "element_id": "e000002", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 2, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Fill in the boxes at the top of this page with your name, centre number and candidate number.", "confidence": 1.0, "element_id": "e000003", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 3, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer all questions.", "confidence": 1.0, "element_id": "e000004", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 4, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer the questions in the spaces provided", "confidence": 1.0, "element_id": "e000005", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 5, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "there may be more space than you need.", "confidence": 1.0, "element_id": "e000006", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 6, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Show all the steps in any calculations and state the units.", "confidence": 1.0, "element_id": "e000007", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 7, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Some questions must be answered with a cross in a box . If you change your mind about an answer, put a line through the box and then mark your new answer with a cross.", "confidence": 1.0, "element_id": "e000008", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 8, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Information", "confidence": 1.0, "element_id": "e000009", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 9, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The total mark for this paper is 70.", "confidence": 1.0, "element_id": "e000010", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 10, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The marks for each question are shown in brackets", "confidence": 1.0, "element_id": "e000011", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 11, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Advice", "confidence": 1.0, "element_id": "e000012", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 12, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Read each question carefully before you start to answer it.", "confidence": 1.0, "element_id": "e000013", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 13, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "use this as a guide as to how much time to spend on each question.", "confidence": 1.0, "element_id": "e000014", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 14, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Write your answers neatly and in good English.", "confidence": 1.0, "element_id": "e000015", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 15, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Try to answer every question.", "confidence": 1.0, "element_id": "e000016", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 16, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Check your answers if you have time at the end.", "confidence": 1.0, "element_id": "e000017", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 17, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Turn over", "confidence": 1.0, "element_id": "e000018", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 18, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The lanthanoids (atomic numbers 58-71) and the actinoids (atomic numbers 90-103) have been omitted.", "confidence": 1.0, "element_id": "e000020", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 20, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The relative atomic masses of copper and chlorine have not been rounded to the nearest whole number.", "confidence": 1.0, "element_id": "e000021", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 21, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000022", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 22, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Answer ALL questions.", "confidence": 1.0, "element_id": "e000023", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 23, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "1 Substances can be classified as elements, mixtures or compounds.", "confidence": 1.0, "element_id": "e000024", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 24, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Each box represents an element, a mixture or a compound.", "confidence": 1.0, "element_id": "e000025", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 25, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Box1", "confidence": 1.0, "element_id": "e000027", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 27, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Box2", "confidence": 1.0, "element_id": "e000029", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 29, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Box3", "confidence": 1.0, "element_id": "e000031", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 31, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Box4", "confidence": 1.0, "element_id": "e000033", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 33, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Box 5", "confidence": 1.0, "element_id": "e000035", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 35, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Which box represents a mixture?", "confidence": 1.0, "element_id": "e000036", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 36, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A 1", "confidence": 1.0, "element_id": "e000037", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 37, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B 2", "confidence": 1.0, "element_id": "e000038", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 38, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C 3", "confidence": 1.0, "element_id": "e000039", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 39, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D 4", "confidence": 1.0, "element_id": "e000040", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 40, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Which two boxes represent elements?", "confidence": 1.0, "element_id": "e000041", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 41, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A 1 and 2", "confidence": 1.0, "element_id": "e000042", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 42, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B 2 and 3", "confidence": 1.0, "element_id": "e000043", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 43, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C 1 and 3", "confidence": 1.0, "element_id": "e000044", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 44, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D 3 and 4", "confidence": 1.0, "element_id": "e000045", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 45, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(1)", "confidence": 1.0, "element_id": "e000046", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 46, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Explain why Box 5 represents a compound.", "confidence": 1.0, "element_id": "e000047", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 47, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The Periodic Table contains all the known elements.", "confidence": 1.0, "element_id": "e000048", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 48, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) How are the elements arranged in the Periodic Table?", "confidence": 1.0, "element_id": "e000049", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 49, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A increasing mass number", "confidence": 1.0, "element_id": "e000050", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 50, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B increasing number of neutrons", "confidence": 1.0, "element_id": "e000051", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 51, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C increasing number of protons", "confidence": 1.0, "element_id": "e000052", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 52, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Elements in the same group have the same number of", "confidence": 1.0, "element_id": "e000053", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 53, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D increasing reactivity", "confidence": 1.0, "element_id": "e000054", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 54, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A electrons in the outer shell", "confidence": 1.0, "element_id": "e000055", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 55, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B electron shells", "confidence": 1.0, "element_id": "e000056", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 56, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "neutrons", "confidence": 1.0, "element_id": "e000057", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 57, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D protons", "confidence": 1.0, "element_id": "e000058", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 58, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 1 = 6 marks)", "confidence": 1.0, "element_id": "e000059", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 59, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000060", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 60, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "2 Chromatography is used to analyse mixtures.", "confidence": 1.0, "element_id": "e000061", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 61, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A student does a chromatography experiment to analyse the composition of green food colouring in sweets.", "confidence": 1.0, "element_id": "e000062", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 62, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "She places four known dyes, A, B, C and D, and the green food colouring on chromatography paper.", "confidence": 1.0, "element_id": "e000063", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 63, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The diagram shows the student''s apparatus at the start of her experiment.", "confidence": 1.0, "element_id": "e000064", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 64, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) The diagram shows that the student makes two mistakes when setting up her apparatus. State the two changes that the student should make so that her experiment works.", "confidence": 1.0, "element_id": "e000066", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 66, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Another student does the chromatography experiment correctly.", "confidence": 1.0, "element_id": "e000067", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 67, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The diagram shows her chromatogram at the end of the experiment.", "confidence": 1.0, "element_id": "e000068", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 68, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Explain what the chromatogram shows about the composition of the green food colouring.", "confidence": 1.0, "element_id": "e000070", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 70, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The distance between the start line and the spot for dye C is 6.2 cm. Calculate the $ R_{f} $ value of dye C.", "confidence": 1.0, "element_id": "e000071", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 71, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "$ R_{\\mathrm{f}} $ value=", "confidence": 1.0, "element_id": "e000072", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 72, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Suggest why dye A does not move.", "confidence": 1.0, "element_id": "e000073", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 73, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 2 = 9 marks)", "confidence": 1.0, "element_id": "e000074", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 74, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "3 Solutions of silver nitrate and potassium chloride react together to make the insoluble salt, silver chloride.", "confidence": 1.0, "element_id": "e000075", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 75, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A student uses this method to prepare a sample of silver chloride.", "confidence": 1.0, "element_id": "e000076", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 76, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 1 add $ 2 5 \\mathrm{c m}^{3} $ of silver nitrate solution to a conical flask", "confidence": 1.0, "element_id": "e000077", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 77, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 2 add potassium chloride solution to the flask", "confidence": 1.0, "element_id": "e000078", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 78, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 3 filter off the silver chloride", "confidence": 1.0, "element_id": "e000079", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 79, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) What term is used for this reaction?", "confidence": 1.0, "element_id": "e000080", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 80, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "neutralisation", "confidence": 1.0, "element_id": "e000081", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 81, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B precipitation", "confidence": 1.0, "element_id": "e000082", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 82, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(1)", "confidence": 1.0, "element_id": "e000083", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 83, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C redox", "confidence": 1.0, "element_id": "e000084", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 84, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D thermal decomposition", "confidence": 1.0, "element_id": "e000085", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 85, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Give two more steps that will produce a pure, dry sample of silver chloride.", "confidence": 1.0, "element_id": "e000086", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 86, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 4.", "confidence": 1.0, "element_id": "e000087", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 87, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 5.", "confidence": 1.0, "element_id": "e000088", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 88, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Acidified silver nitrate solution is used to test for chloride ions.", "confidence": 1.0, "element_id": "e000089", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 89, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Give a reason why hydrochloric acid is not used to acidify silver nitrate solution.", "confidence": 1.0, "element_id": "e000090", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 90, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) The chemical equation for the reaction between solutions of silver nitrate and potassium chloride is", "confidence": 1.0, "element_id": "e000091", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 91, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A student adds an excess of potassium chloride solution to $ 2 5. 0 \\mathrm{c m}^{3} $ of $ 0. 1 0 0 \\mathrm{m o l} / \\mathrm{d m}^{3} $ silver nitrate solution.", "confidence": 1.0, "element_id": "e000092", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 92, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Calculate the maximum mass of silver chloride, in grams, that can be produced.", "confidence": 1.0, "element_id": "e000094", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 94, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "[M of AgCl =143.5]", "confidence": 1.0, "element_id": "e000095", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 95, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 3 = 6 marks)", "confidence": 1.0, "element_id": "e000096", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 96, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "4 This question is about the metal, lead.", "confidence": 1.0, "element_id": "e000097", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 97, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Explain why metals, such as lead, are malleable.", "confidence": 1.0, "element_id": "e000098", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 98, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) A teacher uses this apparatus in a fume cupboard to demonstrate the electrolysis of lead(II) bromide.", "confidence": 1.0, "element_id": "e000099", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 99, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The lead(II) bromide is heated until it melts.", "confidence": 1.0, "element_id": "e000101", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 101, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "When the lead(II) bromide melts, the lamp lights.", "confidence": 1.0, "element_id": "e000102", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 102, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "One of the products of this electrolysis is lead.", "confidence": 1.0, "element_id": "e000103", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 103, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) State why solid lead(II) bromide does not conduct electricity.", "confidence": 1.0, "element_id": "e000104", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 104, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Bromine is formed by the oxidation of bromide ions at the positive electrode.", "confidence": 1.0, "element_id": "e000105", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 105, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Complete the ionic half-equation for the oxidation of bromide ions.", "confidence": 1.0, "element_id": "e000106", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 106, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Explain why lead metal forms at the negative electrode.", "confidence": 1.0, "element_id": "e000108", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 108, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iv) The teacher stops heating the mixture and allows it to solidify. Suggest why the lamp stays alight.", "confidence": 1.0, "element_id": "e000109", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 109, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 4 = 7 marks)", "confidence": 1.0, "element_id": "e000110", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 110, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "5 This question is about Group 1 metals and their reactions.", "confidence": 1.0, "element_id": "e000111", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 111, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) When lithium is added to water, bubbles of hydrogen gas are observed.", "confidence": 1.0, "element_id": "e000112", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 112, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Give two other observations that could be made.", "confidence": 1.0, "element_id": "e000113", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 113, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Give the test for hydrogen gas.", "confidence": 1.0, "element_id": "e000114", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 114, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) (i) Give one observation that would be different if potassium is used instead of lithium.", "confidence": 1.0, "element_id": "e000115", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 115, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The diagram represents an atom of lithium and an atom of potassium.", "confidence": 1.0, "element_id": "e000116", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 116, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Explain why potassium is more reactive than lithium.", "confidence": 1.0, "element_id": "e000119", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 119, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(3)", "confidence": 1.0, "element_id": "e000120", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 120, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) The equation for the reaction between lithium and water is", "confidence": 1.0, "element_id": "e000121", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 121, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) A mass of 0.500g of lithium reacts with an excess of water.", "confidence": 1.0, "element_id": "e000123", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 123, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Calculate the volume, in $ cm^{3} $ , of hydrogen gas produced at rtp.", "confidence": 1.0, "element_id": "e000124", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 124, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "[molar volume of a gas at rtp=24000 $ cm^{3} $]", "confidence": 1.0, "element_id": "e000125", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 125, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Give your answer to three significant figures.", "confidence": 1.0, "element_id": "e000126", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 126, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) In a reaction between lithium and water, $ 1 5 0 \\mathrm{c m}^{3} $ of lithium hydroxide solution is formed.", "confidence": 1.0, "element_id": "e000127", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 127, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The lithium hydroxide solution is then completely neutralised by $ 2 4. 8 5 \\mathrm{c m}^{3} $ of $ 0. 1 0 0 \\mathrm{m o l / d m}^{3} $ sulfuric acid.", "confidence": 1.0, "element_id": "e000128", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 128, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The equation for the neutralisation is", "confidence": 1.0, "element_id": "e000129", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 129, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Calculate the concentration, in mol/dm $ ^{3} $ , of the lithium hydroxide solution.", "confidence": 1.0, "element_id": "e000131", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 131, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 5 = 13 marks)", "confidence": 1.0, "element_id": "e000132", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 132, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000133", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 133, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "6 This question is about ethane and ethene.", "confidence": 1.0, "element_id": "e000134", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 134, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Ethane can be obtained from crude oil.", "confidence": 1.0, "element_id": "e000135", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 135, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Describe the industrial process used to separate crude oil into fractions.", "confidence": 1.0, "element_id": "e000136", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 136, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The equation for the reaction between ethene gas and hydrogen gas is", "confidence": 1.0, "element_id": "e000137", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 137, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The rate of this reaction can be increased by increasing the pressure.", "confidence": 1.0, "element_id": "e000139", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 139, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Explain why increasing the pressure increases the rate of this reaction.", "confidence": 1.0, "element_id": "e000140", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 140, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The rate of this reaction can also be increased by using a catalyst. Explain how using a catalyst increases the rate of a reaction.", "confidence": 1.0, "element_id": "e000141", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 141, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Give one other way that the rate of reaction between ethene gas and hydrogen gas can be increased.", "confidence": 1.0, "element_id": "e000142", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 142, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iv) The reaction between ethene and hydrogen is exothermic.", "confidence": 1.0, "element_id": "e000143", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 143, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Complete the reaction profile diagram, including labels for the activation energy and the enthalpy change, $ \\Delta H. $", "confidence": 1.0, "element_id": "e000144", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 144, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) The reaction between ethene and hydrogen can be represented using displayed formulae.", "confidence": 1.0, "element_id": "e000146", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 146, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Use the bond energies in the table to calculate the enthalpy change, $ \\Delta H $ in kJ/mol for this reaction.", "confidence": 1.0, "element_id": "e000149", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 149, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "7 (a) Ethanol, $ \\mathrm{C_{2} H_{5} O H} $ , can be produced by the fermentation of glucose, $ \\mathrm{C_{6} H_{1 2} O_{6}} $", "confidence": 1.0, "element_id": "e000150", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 150, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Complete the equation for the fermentation of glucose.", "confidence": 1.0, "element_id": "e000151", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 151, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) State why it is necessary for fermentation to be done in the absence of air.", "confidence": 1.0, "element_id": "e000153", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 153, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Explain why the temperature should not be higher than $ 4 0^{\\circ} \\mathrm{C} $", "confidence": 1.0, "element_id": "e000154", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 154, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iv) When 4 mol of glucose is fermented, a mass of 55.2 g of ethanol is produced. Show that the percentage yield of ethanol is 15%.", "confidence": 1.0, "element_id": "e000155", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 155, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "[M $ _{r} $ of C $ _{2} $ H $ _{5} $ OH=46]", "confidence": 1.0, "element_id": "e000156", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 156, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Ethanol can also be produced by the reaction between ethene and steam. The equation for the reaction is", "confidence": 1.0, "element_id": "e000157", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 157, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) This reaction is in dynamic equilibrium.", "confidence": 1.0, "element_id": "e000159", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 159, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Give two features of a reaction in dynamic equilibrium.", "confidence": 1.0, "element_id": "e000160", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 160, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) When the equilibrium mixture is heated,the yield of ethanol decreases Explain whether the forward reaction is exothermic or endothermic.", "confidence": 1.0, "element_id": "e000161", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 161, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Carboxylic acids react with alcohols to form esters.", "confidence": 1.0, "element_id": "e000162", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 162, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The displayed formula of an ester is", "confidence": 1.0, "element_id": "e000163", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 163, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Carboxylic acid A and alcohol B react to produce this ester.", "confidence": 1.0, "element_id": "e000165", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 165, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Give the displayed formula of carboxylic acid A and of alcohol B.", "confidence": 1.0, "element_id": "e000166", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 166, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Indicators can be used to test for carboxylic acids.", "confidence": 1.0, "element_id": "e000168", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 168, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Describe a different chemical test for a carboxylic acid.", "confidence": 1.0, "element_id": "e000169", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 169, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "TOTAL FOR PAPER = 70 MARKS", "confidence": 1.0, "element_id": "e000170", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 170, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000171", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 171, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "schemaVersion": "1.0"}', NULL, '2026-09-13 13:01:25.455854+00');
INSERT INTO public.documents VALUES ('f51cea78-c3f9-4373-8558-842bfccb6cd2', '4faf474b-ca4e-5517-82c5-a4403f0b090e', '1.0', 1, 'MARK_SCHEME', 'corpus/igcse-chemistry-4ch0-2c-2020janr/MS.md', 'MS.md', 'text/markdown', '36455b08236bd0ed4c95767ab5e8823afb575bbc3cef0c2136272d0143418c35', 'SHA-256', 1, 29, 29, 13, 'glm-ocr-markdown', '1.1.0', '2026-09-13 13:01:04.669308+00', '{"pages": [{"width": null, "height": null, "pageNumber": 1}], "source": {"uri": "corpus/igcse-chemistry-4ch0-2c-2020janr/MS.md", "checksum": "36455b08236bd0ed4c95767ab5e8823afb575bbc3cef0c2136272d0143418c35", "fileName": "MS.md", "mimeType": "text/markdown", "checksumAlgorithm": "SHA-256"}, "tables": [{"rows": [["Question number", "Answer", "Notes", "Marks"], ["1(a)(i)", "B box 2\nThe only correct answer is B because box 2 contains two different particles in the same space that are not chemically joined", "", "1"], ["A is not correct because box A shows an element\nC is not correct because box C shows an element\nD is not correct because box 4 shows a compound", "", ""], ["C Boxes 1 and 3\nThe only correct answer is C because boxes 1 and 2 contain one type of atom only.\nA is not correct because box 2 shows a mixture\nB is not correct because box 2 shows a mixture\nD is not correct because box 4 shows a compound", "", "1"], ["(iii)", "M1 (box 5 shows) two (different) elements", "ALLOW two (different) types of atoms", "2"], ["M2 (chemically) bonded (together)", "REJECT mixture for M1", ""], ["", "ALLOW (chemically) combined/joined (together)\nM2 DEP on mention of elements/atoms in M1", ""], ["(b)(i)", "C number of protons", "", "1"], ["The only correct answer is B because the elements in the periodic table are arranged in order of proton number\nA is not correct because elements are not arranged in order of mass number\nB is not correct because elements are not arranged in order of the number of neutrons\nD is not correct because elements are not arranged in order of reactivity", "", ""], ["A electrons in the outer shell", "", "1"], ["(ii)", "The only correct answer is A because elements in the same group of the periodic table have the same number of electrons in the outer shell.\nB Is not the correct answer because elements in the same period have the same number of shells\nC elements in the same group do not have the same number of neutrons\nD is not the correct answer because elements in the same group do not have the same number of protons", "", ""], ["", "", ""], ["", "", ""]], "text": "Question number | Answer | Notes | Marks\n1(a)(i) | B box 2\nThe only correct answer is B because box 2 contains two different particles in the same space that are not chemically joined |  | 1\nA is not correct because box A shows an element\nC is not correct because box C shows an element\nD is not correct because box 4 shows a compound |  | \nC Boxes 1 and 3\nThe only correct answer is C because boxes 1 and 2 contain one type of atom only.\nA is not correct because box 2 shows a mixture\nB is not correct because box 2 shows a mixture\nD is not correct because box 4 shows a compound |  | 1\n(iii) | M1 (box 5 shows) two (different) elements | ALLOW two (different) types of atoms | 2\nM2 (chemically) bonded (together) | REJECT mixture for M1 | \n | ALLOW (chemically) combined/joined (together)\nM2 DEP on mention of elements/atoms in M1 | \n(b)(i) | C number of protons |  | 1\nThe only correct answer is B because the elements in the periodic table are arranged in order of proton number\nA is not correct because elements are not arranged in order of mass number\nB is not correct because elements are not arranged in order of the number of neutrons\nD is not correct because elements are not arranged in order of reactivity |  | \nA electrons in the outer shell |  | 1\n(ii) | The only correct answer is A because elements in the same group of the periodic table have the same number of electrons in the outer shell.\nB Is not the correct answer because elements in the same period have the same number of shells\nC elements in the same group do not have the same number of neutrons\nD is not the correct answer because elements in the same group do not have the same number of protons |  | \n |  | \n |  | ", "row_count": 13, "confidence": 1.0, "element_id": "e000019", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 19, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["2(a)", "M1 level of the water must be below the dyes/start lineM2 the start line must be drawn in pencil", "ACCEPT dyes/start line should be above water level", "2"], ["2(b)(i)", "2 marks for any two conclusions from(the green food colouringM1 contains(dye)B and(dye)D M2 contains an unknown dyeM3 does not containA orC M4 contains three dyesand1 mark for a correct explanation of given conclusion for the green food colouringeg(explanation forM1)because has spots at same level(asB andD)eg(explanation forM2)because has a spot at different level(fromA B C D)eg(explanation forM3)because has no spots at same level(asA andC)eg(explanation forM4)because has three spots", "ALLOW is not pure", "3"], ["(ii)", "M1(distance moved by solvent correctly measured)=9.5(cm)M2 use ofRf=distance moved by the dye C distance moved by the solventM3 evaluation ofRf", "ALLOW a tolerance of±2mmeg6.29.5ALLOW ECF fromM1eg(6.2)=0.65(3)(9.5)ALLOW1-4sig figALLOW ECF fromM2", "3"], ["(iii)", "(dyeA)is not soluble in water", "ALLOW solvent for water", "1"]], "text": "Question number | Answer | Notes | Marks\n2(a) | M1 level of the water must be below the dyes/start lineM2 the start line must be drawn in pencil | ACCEPT dyes/start line should be above water level | 2\n2(b)(i) | 2 marks for any two conclusions from(the green food colouringM1 contains(dye)B and(dye)D M2 contains an unknown dyeM3 does not containA orC M4 contains three dyesand1 mark for a correct explanation of given conclusion for the green food colouringeg(explanation forM1)because has spots at same level(asB andD)eg(explanation forM2)because has a spot at different level(fromA B C D)eg(explanation forM3)because has no spots at same level(asA andC)eg(explanation forM4)because has three spots | ALLOW is not pure | 3\n(ii) | M1(distance moved by solvent correctly measured)=9.5(cm)M2 use ofRf=distance moved by the dye C distance moved by the solventM3 evaluation ofRf | ALLOW a tolerance of±2mmeg6.29.5ALLOW ECF fromM1eg(6.2)=0.65(3)(9.5)ALLOW1-4sig figALLOW ECF fromM2 | 3\n(iii) | (dyeA)is not soluble in water | ALLOW solvent for water | 1", "row_count": 5, "confidence": 1.0, "element_id": "e000020", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 20, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["3(a)", "B Precipitation\nThe only correct answer is B the reaction of two solutions to produce an insoluble solid is precipitation.\nA is not correct because this reaction is not neutralisation\nC is not correct because this reaction is not a redox reaction\nD is not correct because this reaction is not thermal decomposition", "", "1"], ["3(b)", "M1 wash the solid with (deionised) water\nM2 suitable method of drying solid eg dry between filter papers/on paper towel/in (warm) oven/in a desiccator", "ALLOW leave to dry\nALLOW leave in a warm place\nALLOW leave for the water to evaporate\nIGNORE dry it alone\nREJECT hot oven or any method of direct heating eg Bunsen burner\nREJECT references (direct or inferred) to silver chloride solution or crystallisation for M1 and M2\nNo M2 if solid washed after drying", "2"], ["3(c)", "Any one from:\nM1 (hydrochloric acid/it) contains chloride ions\nM2 (hydrochloric acid/it) produces a (white) precipitate with silver nitrate\nM3 (hydrochloric acid/it) reacts with silver nitrate", "ALLOW contains Cl-", "1"], ["3(d)", "M1 n(AgNO3orAgCl)=0.0025\nM2(mass AgCl)=0.0025x143.5=0.35(9)g", "ALLOW ECF from M1\nALLOW one or more sig fig\nCorrect answer without working scores 2 marks.", "2"]], "text": "Question number | Answer | Notes | Marks\n3(a) | B Precipitation\nThe only correct answer is B the reaction of two solutions to produce an insoluble solid is precipitation.\nA is not correct because this reaction is not neutralisation\nC is not correct because this reaction is not a redox reaction\nD is not correct because this reaction is not thermal decomposition |  | 1\n3(b) | M1 wash the solid with (deionised) water\nM2 suitable method of drying solid eg dry between filter papers/on paper towel/in (warm) oven/in a desiccator | ALLOW leave to dry\nALLOW leave in a warm place\nALLOW leave for the water to evaporate\nIGNORE dry it alone\nREJECT hot oven or any method of direct heating eg Bunsen burner\nREJECT references (direct or inferred) to silver chloride solution or crystallisation for M1 and M2\nNo M2 if solid washed after drying | 2\n3(c) | Any one from:\nM1 (hydrochloric acid/it) contains chloride ions\nM2 (hydrochloric acid/it) produces a (white) precipitate with silver nitrate\nM3 (hydrochloric acid/it) reacts with silver nitrate | ALLOW contains Cl- | 1\n3(d) | M1 n(AgNO3orAgCl)=0.0025\nM2(mass AgCl)=0.0025x143.5=0.35(9)g | ALLOW ECF from M1\nALLOW one or more sig fig\nCorrect answer without working scores 2 marks. | 2", "row_count": 5, "confidence": 1.0, "element_id": "e000021", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 21, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["4(a)", "M1 layers of atoms/positive ions", "IGNORE layers unqualified\nREJECT layers of molecules", "2"], ["M2 can slide over one another", "M2 DEP on mention of layers/atoms/ions in M1"], ["4(b)(i)", "ions cannot move", "ALLOW ions are in fixed positions/in a lattice", "1"], ["(ii)2Br-→Br2+2e-", "IGNORE no free ions\nREJECT any reference to electrons"], ["(iii)M1 lead ions (are positive and) are attracted to the negative electrode/Pb2+ (ions) are attracted to the negative electrode", "ALLOW cathode for negative electrode", "2"], ["M2 lead ions gain electrons/Pb2+ (ions) gain electrons (to form lead)"], ["(iv)metal or lead connects the electrodes or completes the circuit OWTTE", "ALLOW metal or lead conducts electricity\nALLOW metal or lead allows electrons to flow", "1"]], "text": "Question number | Answer | Notes | Marks\n4(a) | M1 layers of atoms/positive ions | IGNORE layers unqualified\nREJECT layers of molecules | 2\nM2 can slide over one another | M2 DEP on mention of layers/atoms/ions in M1\n4(b)(i) | ions cannot move | ALLOW ions are in fixed positions/in a lattice | 1\n(ii)2Br-→Br2+2e- | IGNORE no free ions\nREJECT any reference to electrons\n(iii)M1 lead ions (are positive and) are attracted to the negative electrode/Pb2+ (ions) are attracted to the negative electrode | ALLOW cathode for negative electrode | 2\nM2 lead ions gain electrons/Pb2+ (ions) gain electrons (to form lead)\n(iv)metal or lead connects the electrodes or completes the circuit OWTTE | ALLOW metal or lead conducts electricity\nALLOW metal or lead allows electrons to flow | 1", "row_count": 8, "confidence": 1.0, "element_id": "e000022", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 22, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["5(a)(i)", "Any two from:", "", "2"], ["M1(lithium) moves(on the surface)", "ALLOW floats", ""], ["M2(lithium) gets smaller/disappears", "ALLOW dissolves", ""], ["M3 colourless solution forms", "IGNORE white trail forms", ""], ["", "REJECT melts/turns into a ball", ""], ["", "ALLOW temperature increases/heat given off", ""], ["(ii)(when mixed with air)lit spill/splint or flame gives(squeaky)pop", "must refer to test and resultIGNORE squeaky poptest aloneALLOW burns with(squeaky)popREJECT glowingspill/splint and pop", "1"], ["5(b)(i)", "Any one from:", "", "1"], ["M1more rapid bubbles/fizzing/effervescence", "", ""], ["M2turns into a ball", "ALLOW potassium melts", ""], ["M3moves more quickly", "ALLOW getssmaller/disappearsmore quickly", ""], ["M4catches alight/burns/produces a flame", "IGNORE flame colour", ""], ["M1potassium has more shells than lithium", "ALLOW potassium atomis bigger than lithium", "3"], ["", "ALLOW outershell/electron is furtherfrom nucleus", ""], ["(ii)", "M2(therefore)there is less attraction between theouter shell/electron and the nucleus", "ALLOW more repulsion(from inner shell)ormore shielding(from the nuclear attraction)", ""], ["", "ALLOW nuclear pull forthe outer shell/electronis weaker", ""], ["M3so the electron in the outer shell is more easilylost", "ACCEPT answersinterms of lithium forM1,M2andM3", ""]], "text": "Question number | Answer | Notes | Marks\n5(a)(i) | Any two from: |  | 2\nM1(lithium) moves(on the surface) | ALLOW floats | \nM2(lithium) gets smaller/disappears | ALLOW dissolves | \nM3 colourless solution forms | IGNORE white trail forms | \n | REJECT melts/turns into a ball | \n | ALLOW temperature increases/heat given off | \n(ii)(when mixed with air)lit spill/splint or flame gives(squeaky)pop | must refer to test and resultIGNORE squeaky poptest aloneALLOW burns with(squeaky)popREJECT glowingspill/splint and pop | 1\n5(b)(i) | Any one from: |  | 1\nM1more rapid bubbles/fizzing/effervescence |  | \nM2turns into a ball | ALLOW potassium melts | \nM3moves more quickly | ALLOW getssmaller/disappearsmore quickly | \nM4catches alight/burns/produces a flame | IGNORE flame colour | \nM1potassium has more shells than lithium | ALLOW potassium atomis bigger than lithium | 3\n | ALLOW outershell/electron is furtherfrom nucleus | \n(ii) | M2(therefore)there is less attraction between theouter shell/electron and the nucleus | ALLOW more repulsion(from inner shell)ormore shielding(from the nuclear attraction) | \n | ALLOW nuclear pull forthe outer shell/electronis weaker | \nM3so the electron in the outer shell is more easilylost | ACCEPT answersinterms of lithium forM1,M2andM3 | ", "row_count": 18, "confidence": 1.0, "element_id": "e000023", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 23, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["5(c)(i)", "M1 n(Li) = 0.500/7 OR 0.0714", "", "3"], ["M2 n(H2) = 0.0714/2 OR 0.0357", "ALLOW ECF from M1", ""], ["M3 volume of H2(=0.0357x24000)=857(cm3)", "ALLOW ECF M2x24000M3 must be to 3 sig figCorrect answer to 3 sig fig without working scores 3 marks.", ""], ["(ii)M1 n(H2SO4)=0.02485x0.1OR0.002485M2 n(LiOH)=2x0.002485OR0.00497M3 concentration of LiOH=0.0331(mol/dm3)", "", "3"], ["ALLOW ECF from M1", ""], ["ALLOW ECF from M2(M2÷0.150)", ""], ["ALLOW any number of sig fig except one for M1 M2 and M3Correct answer without working scores 3 marks.", ""]], "text": "Question number | Answer | Notes | Marks\n5(c)(i) | M1 n(Li) = 0.500/7 OR 0.0714 |  | 3\nM2 n(H2) = 0.0714/2 OR 0.0357 | ALLOW ECF from M1 | \nM3 volume of H2(=0.0357x24000)=857(cm3) | ALLOW ECF M2x24000M3 must be to 3 sig figCorrect answer to 3 sig fig without working scores 3 marks. | \n(ii)M1 n(H2SO4)=0.02485x0.1OR0.002485M2 n(LiOH)=2x0.002485OR0.00497M3 concentration of LiOH=0.0331(mol/dm3) |  | 3\nALLOW ECF from M1 | \nALLOW ECF from M2(M2÷0.150) | \nALLOW any number of sig fig except one for M1 M2 and M3Correct answer without working scores 3 marks. | ", "row_count": 8, "confidence": 1.0, "element_id": "e000024", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 24, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["6(a)", "A description including the following points:", "", "4"], ["M1(use) fractional distillation/ fractionating column/ fractionating tower", "", ""], ["M2(crude oil) heated/ vaporised", "ALLOW boiled", ""], ["M3 column is cooler at top/ hotter at the bottom/ idea of temperature gradient", "", ""], ["M4 fractions condense/collected at different heights OWTTE OR fractions have different boiling point(ranges)", "ALLOW fractions with high(er) boiling points/large(r) molecules condense/collected near bottom ORA", ""], ["6(b)(i)", "M1 particles/molecules are closer together", "ALLOW more particles/molecules per unit volume", "2"], ["M2 therefore more(successful) collisions per unit time", "ALLOW more frequent(successful) collisions If reference to particles have more energy/move faster, then0/2", ""], ["(ii)M1(a catalyst provides) an alternative pathway", "ALLOW a catalyst provides a surface for the reaction to take place on", "2"], ["", "M2 of lower activation energy", "ALLOW so more collisions/particles have energy greater than the activation energy.", ""], ["(iii)", "increase the temperature", "ALLOW heat it up IGNORE references to concentration REJECT increase the surface area", "1"]], "text": "Question number | Answer | Notes | Marks\n6(a) | A description including the following points: |  | 4\nM1(use) fractional distillation/ fractionating column/ fractionating tower |  | \nM2(crude oil) heated/ vaporised | ALLOW boiled | \nM3 column is cooler at top/ hotter at the bottom/ idea of temperature gradient |  | \nM4 fractions condense/collected at different heights OWTTE OR fractions have different boiling point(ranges) | ALLOW fractions with high(er) boiling points/large(r) molecules condense/collected near bottom ORA | \n6(b)(i) | M1 particles/molecules are closer together | ALLOW more particles/molecules per unit volume | 2\nM2 therefore more(successful) collisions per unit time | ALLOW more frequent(successful) collisions If reference to particles have more energy/move faster, then0/2 | \n(ii)M1(a catalyst provides) an alternative pathway | ALLOW a catalyst provides a surface for the reaction to take place on | 2\n | M2 of lower activation energy | ALLOW so more collisions/particles have energy greater than the activation energy. | \n(iii) | increase the temperature | ALLOW heat it up IGNORE references to concentration REJECT increase the surface area | 1", "row_count": 11, "confidence": 1.0, "element_id": "e000025", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 25, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["6(b)(iv)", "M1 $C_{2}H_{6}$ on horizontal line below the reactants\nM2 activation energy correctly shown and labelled\nM3 $\\Delta H$ correctly shown and labelled\n• find energy needed to break bonds\n• find energy released when bonds form\n• correct evaluation of $\\Delta H$\nExample calculation\nM1 (4 x 412) + 612 + 436 OR 2696\nM2 (6 x 412) + 348 OR 2820\nM3 -124 if M1 M2 correct", "ACCEPT arrow pointing upwards or double headed arrow\nACCEPT arrow pointing from reactants level to product level or double headed arrow\nALLOW max 2 for a correctly labelled endothermic reaction\nIGNORE sign ALLOW 1048\nIGNORE sign ALLOW 1172\n-124 without working scores 3 (+)124 scores 2\nALLOW M3 ECF M1 M2", "3"]], "text": "6(b)(iv) | M1 $C_{2}H_{6}$ on horizontal line below the reactants\nM2 activation energy correctly shown and labelled\nM3 $\\Delta H$ correctly shown and labelled\n• find energy needed to break bonds\n• find energy released when bonds form\n• correct evaluation of $\\Delta H$\nExample calculation\nM1 (4 x 412) + 612 + 436 OR 2696\nM2 (6 x 412) + 348 OR 2820\nM3 -124 if M1 M2 correct | ACCEPT arrow pointing upwards or double headed arrow\nACCEPT arrow pointing from reactants level to product level or double headed arrow\nALLOW max 2 for a correctly labelled endothermic reaction\nIGNORE sign ALLOW 1048\nIGNORE sign ALLOW 1172\n-124 without working scores 3 (+)124 scores 2\nALLOW M3 ECF M1 M2 | 3", "row_count": 1, "confidence": 1.0, "element_id": "e000026", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 26, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["7(a)(i)", "CO2", "", "1"], ["(ii)", "(otherwise) ethanoic acid will form", "ALLOW(otherwise) ethanol will be oxidised or react with oxygen ALLOW fermentation/reaction/respiration needs to be anaerobic ALLOW(otherwise) ethanol would not be formed/CO2和H2O would be formed", "1"], ["(iii)", "M1(reaction is catalysed by) enzymes(in yeast)M2which will denature(above40℃)", "IGNORE yeast unqualifiedALLOW enzymes do not work above40℃", "2"], ["(iv)", "M1 maximum mass of ethanol=8x46=368(g)M255.2x100(=15%)Alternative method:M1 actual yield of ethanol in mol=55.2/46=1.2M21.2x100(=15%)", "", "2"], ["(b)(i)", "M1 rate of the forwards reaction=the rate of the backwards reactionM2the concentrations of reactants and products remain constant", "IGNORE it is reversible reactionREJECT concentrations of reactants and products are equal or are the same", "2"], ["(b)(ii)", "M1 an increase in temperature shifts the (position of) equilibrium in the endothermic direction(so backwards reaction is endothermic)M2so forward reaction is exothermic", "IGNORE references to LeChatelier''s PrincipleALLOW heating for increase in temperatureM2DEP M1 or near miss", "2"]], "text": "Question number | Answer | Notes | Marks\n7(a)(i) | CO2 |  | 1\n(ii) | (otherwise) ethanoic acid will form | ALLOW(otherwise) ethanol will be oxidised or react with oxygen ALLOW fermentation/reaction/respiration needs to be anaerobic ALLOW(otherwise) ethanol would not be formed/CO2和H2O would be formed | 1\n(iii) | M1(reaction is catalysed by) enzymes(in yeast)M2which will denature(above40℃) | IGNORE yeast unqualifiedALLOW enzymes do not work above40℃ | 2\n(iv) | M1 maximum mass of ethanol=8x46=368(g)M255.2x100(=15%)Alternative method:M1 actual yield of ethanol in mol=55.2/46=1.2M21.2x100(=15%) |  | 2\n(b)(i) | M1 rate of the forwards reaction=the rate of the backwards reactionM2the concentrations of reactants and products remain constant | IGNORE it is reversible reactionREJECT concentrations of reactants and products are equal or are the same | 2\n(b)(ii) | M1 an increase in temperature shifts the (position of) equilibrium in the endothermic direction(so backwards reaction is endothermic)M2so forward reaction is exothermic | IGNORE references to LeChatelier''s PrincipleALLOW heating for increase in temperatureM2DEP M1 or near miss | 2", "row_count": 7, "confidence": 1.0, "element_id": "e000027", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 27, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["7(c)(i)", "M1(displayed formula ofA-propanoic acid)\nChemical structure ofM1\nM2(displayed formula ofB-butan-1-ol)\nChemical structure ofM2", "ALLOW1markifbothOHbutotherwisecorrect", "2"], ["(c)(ii)", "M1addanamedcarbonateorhydrogencarbonate\nM2effervescence/bubbles/fizzing\nOR\nM1adda suitable namedmetale.g.magnesium,aluminium,zinc,iron\nM2effervescence/bubbles/fizzing\nOR\nM1adda namedalcohol(andsomeconcentratedsulfuricacidandwarm)\nM2sweetsmell(ofanester)", "ALLOWcorrectformula\nM2DEP M1ornearmiss\nALLOWcarbondioxide/CO2produced\nREJECTincorrectgas\nALLOWcorrectsymbol\nREJECTametalthatistoo reactivee.g.potassiumortoo unreactivee.g.copper\nM2DEP M1ornearmiss\nALLOWhydrogen/H2produced\nREJECTincorrectgas\nALLOWcorrectformula\nM2DEP M1ornearmiss", "2"]], "text": "7(c)(i) | M1(displayed formula ofA-propanoic acid)\nChemical structure ofM1\nM2(displayed formula ofB-butan-1-ol)\nChemical structure ofM2 | ALLOW1markifbothOHbutotherwisecorrect | 2\n(c)(ii) | M1addanamedcarbonateorhydrogencarbonate\nM2effervescence/bubbles/fizzing\nOR\nM1adda suitable namedmetale.g.magnesium,aluminium,zinc,iron\nM2effervescence/bubbles/fizzing\nOR\nM1adda namedalcohol(andsomeconcentratedsulfuricacidandwarm)\nM2sweetsmell(ofanester) | ALLOWcorrectformula\nM2DEP M1ornearmiss\nALLOWcarbondioxide/CO2produced\nREJECTincorrectgas\nALLOWcorrectsymbol\nREJECTametalthatistoo reactivee.g.potassiumortoo unreactivee.g.copper\nM2DEP M1ornearmiss\nALLOWhydrogen/H2produced\nREJECTincorrectgas\nALLOWcorrectformula\nM2DEP M1ornearmiss | 2", "row_count": 2, "confidence": 1.0, "element_id": "e000028", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 28, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "figures": [], "version": 1, "sections": [{"level": 1, "title": "Mark Scheme (Results)", "sectionId": "s001", "elementIds": ["e000003", "e000004"], "pageNumber": 1}, {"level": 2, "title": "Edexcel and BTEC Qualifications", "sectionId": "s002", "elementIds": ["e000006"], "pageNumber": 1}, {"level": 2, "title": "Pearson: helping people progress, everywhere", "sectionId": "s003", "elementIds": ["e000008", "e000009"], "pageNumber": 1}, {"level": 2, "title": "General Marking Guidance", "sectionId": "s004", "elementIds": ["e000011", "e000012", "e000013", "e000014", "e000015", "e000016", "e000017", "e000018"], "pageNumber": 1}], "equations": [], "pageCount": 1, "documentId": "4faf474b-ca4e-5517-82c5-a4403f0b090e", "provenance": {"engine": "glm-ocr-markdown", "application": "syllabai-parser", "extractedAt": "2026-09-13T13:01:04.669308396Z", "engineVersion": "1.1.0", "schemaVersion": "1.0", "extractionParams": {"pageBoundaries": "none-in-source", "sourceLineCount": 100, "upstreamConverter": "zai-glm-ocr", "entityDecodedLines": 1, "signedUrlFigureRefs": 0, "normalizedHtmlEntities": true}}, "textBlocks": [{"role": "paragraph", "text": "PMT", "confidence": 1.0, "element_id": "e000000", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 0, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Pearson Edexcel", "confidence": 1.0, "element_id": "e000001", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 1, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Mark Scheme (Results)", "confidence": 1.0, "element_id": "e000002", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 1, "reading_order": 2, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "January 2020", "confidence": 1.0, "element_id": "e000003", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 3, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Pearson Edexcel International GCSE in Chemistry (4CH1) Paper 2CR", "confidence": 1.0, "element_id": "e000004", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 4, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Edexcel and BTEC Qualifications", "confidence": 1.0, "element_id": "e000005", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 5, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Edexcel and BTEC qualifications are awarded by Pearson, the UK''s largest awarding body. We provide a wide range of qualifications including academic, vocational, occupational and specific programmes for employers. For further information visit our qualifications websites at www.edexcel.com or www.btec.co.uk. Alternatively, you can get in touch with us using the details on our contact us page at www.edexcel.com/contactus.", "confidence": 1.0, "element_id": "e000006", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 6, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Pearson: helping people progress, everywhere", "confidence": 1.0, "element_id": "e000007", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 7, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Pearson aspires to be the world''s leading learning company. Our aim is to help everyone progress in their lives through education. We believe in every kind of learning, for all kinds of people, wherever they are in the world. We''ve been involved in education for over 150 years, and by working across 70 countries, in 100 languages, we have built an international reputation for our commitment to high standards and raising achievement through innovation in education. Find out more about how we can help you and your students at: www.pearson.com/uk", "confidence": 1.0, "element_id": "e000008", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 8, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "January 2020 Publications Code 4CH1_2CR_msc_20200305 All the material in this publication is copyright $ \\textcircled{c} $ Pearson Education Ltd 2020", "confidence": 1.0, "element_id": "e000009", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 9, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "General Marking Guidance", "confidence": 1.0, "element_id": "e000010", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 10, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "All candidates must receive the same treatment. Examiners must mark the first candidate in exactly the same way as they mark the last.", "confidence": 1.0, "element_id": "e000011", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 11, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Mark schemes should be applied positively. Candidates must be rewarded for what they have shown they can do rather than penalised for omissions.", "confidence": 1.0, "element_id": "e000012", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 12, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Examiners should mark according to the mark scheme not according to their perception of where the grade boundaries may lie.", "confidence": 1.0, "element_id": "e000013", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 13, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "There is no ceiling on achievement. All marks on the mark scheme should be used appropriately.", "confidence": 1.0, "element_id": "e000014", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 14, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "All the marks on the mark scheme are designed to be awarded. Examiners should always award full marks if deserved, i.e. if the answer matches the mark scheme. Examiners should also be prepared to award zero marks if the candidate''s response is not worthy of credit according to the mark scheme.", "confidence": 1.0, "element_id": "e000015", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 15, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Where some judgement is required, mark schemes will provide the principles by which marks will be awarded and exemplification may be limited.", "confidence": 1.0, "element_id": "e000016", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 16, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "When examiners are in doubt regarding the application of the mark scheme to a candidate''s response, the team leader must be consulted.", "confidence": 1.0, "element_id": "e000017", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 17, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Crossed out work should be marked UNLESS the candidate has replaced it with an alternative response.", "confidence": 1.0, "element_id": "e000018", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 18, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "schemaVersion": "1.0"}', NULL, '2026-09-13 13:01:25.529045+00');
