INSERT INTO public.question_parts VALUES ('7c5b5b77-44c1-4684-a0b2-7ffa924882e0', '2f786e0c-d9de-4226-994f-5e74fd055ec5', 'b-ii', 'Give the displayed formula of this compound.', NULL, 0, 3, '2026-09-13 12:58:26.49913+00');
INSERT INTO public.question_parts VALUES ('e0fc33c7-f926-4d86-9237-d709e47ad981', '17a85e4d-d51b-4112-876c-16714ebd179a', 'c', 'The equation shows the reaction of sodium with water. $2 \mathrm {N a} (\mathrm {s}) + 2 \mathrm {H} _ {2} \mathrm {O} (\mathrm {l}) \rightarrow 2 \mathrm {N a O H} (\mathrm {a q}) + \mathrm {H} _ {2} (\mathrm {g})$ A sample of sodium of mass 0.138 g reacts with excess water. Calculate the volume of hydrogen, in $ cm^{3} $ , produced at room temperature and pressure (rtp). [The volume of one mole of a gas at rtp is $ 2 4 0 0 0 \mathrm{c m}^{3} $]', NULL, 0, 2, '2026-09-13 12:58:26.375797+00');
INSERT INTO public.question_parts VALUES ('38eca147-93aa-4fe0-82fe-115f29dcf71c', '17a85e4d-d51b-4112-876c-16714ebd179a', 'd', 'Sodium chloride can be made by many different reactions. A student prepared a sample of sodium chloride using the following method. Step1 She added an excess of a solid sodium compound, X, to dilute hydrochloric acid. The mixture fizzed as the solid reacted. Step 2 She filtered the mixture produced to remove the excess solid X. The filtrate was a colourless liquid. Step 3 She evaporated the colourless liquid. A white solid remained.', NULL, 0, 3, '2026-09-13 12:58:26.375847+00');
INSERT INTO public.question_parts VALUES ('085f9991-1203-4025-bb2e-ed34dad1e188', '17a85e4d-d51b-4112-876c-16714ebd179a', 'd-i', 'Describe a chemical test that the student could do to show that the colourless liquid in Step 2 contained chloride ions, $ \mathrm{C l}^{-} $ . Test', NULL, 0, 4, '2026-09-13 12:58:26.375891+00');
INSERT INTO public.question_parts VALUES ('a4167c92-125e-46ec-ab2a-1d716c8518f6', '17a85e4d-d51b-4112-876c-16714ebd179a', 'd-ii', 'The student concluded that solid X was sodium hydroxide. State one reason why this conclusion was not correct. Suggest a possible identity of solid X. Solid X could be', NULL, 0, 5, '2026-09-13 12:58:26.375931+00');
INSERT INTO public.question_parts VALUES ('086b6156-981b-45b0-a4c1-aace279bc9e9', '17a85e4d-d51b-4112-876c-16714ebd179a', 'e', 'Sodium chloride can also be made by reacting sodium with chlorine gas. Draw a dot and cross diagram to show the arrangement of the electrons in each of the ions in sodium chloride. Show the charge on each ion. Show only the outer electrons.', NULL, 0, 6, '2026-09-13 12:58:26.37597+00');
INSERT INTO public.question_parts VALUES ('a1ae8dcc-e384-4155-91c2-9d73ce097795', '17a85e4d-d51b-4112-876c-16714ebd179a', 'f', 'Potassium bromide can be made by reacting potassium with bromine gas. Explain why it is difficult to be sure whether the reaction between potassium and bromine gas would be more vigorous than the reaction between sodium and chlorine gas.', NULL, 0, 7, '2026-09-13 12:58:26.376006+00');
INSERT INTO public.question_parts VALUES ('0c5abd72-5ccb-42a5-9288-717845b26b7c', '63f6819e-5443-44b2-8c8b-47068a013b73', 'b', 'Water can be decomposed by electrolysis using this apparatus.', NULL, 0, 0, '2026-09-13 12:58:26.376091+00');
INSERT INTO public.question_parts VALUES ('5681effc-6809-4afe-a593-76589c05ef7d', '63f6819e-5443-44b2-8c8b-47068a013b73', 'b-i', 'Suggest a suitable element for the inert electrodes.', NULL, 0, 1, '2026-09-13 12:58:26.376136+00');
INSERT INTO public.question_parts VALUES ('f3c239af-eb84-4c54-bb35-d97375de887a', '63f6819e-5443-44b2-8c8b-47068a013b73', 'b-ii', 'Suggest why a small amount of dilute acid is added to the water before it is electrolysed.', NULL, 0, 2, '2026-09-13 12:58:26.376182+00');
INSERT INTO public.question_parts VALUES ('8194caad-2a63-442d-89dc-9901592cbd01', '63f6819e-5443-44b2-8c8b-47068a013b73', 'c', 'The overall equation for the decomposition of water is $2 \mathrm {H} _ {2} \mathrm {O} (\mathrm {I}) \rightarrow 2 \mathrm {H} _ {2} (\mathrm {g}) + \mathrm {O} _ {2} (\mathrm {g})$ Use this equation to explain why the volume of hydrogen collected should be twice that of the volume of oxygen.', NULL, 0, 3, '2026-09-13 12:58:26.376223+00');
INSERT INTO public.question_parts VALUES ('c481f830-b3ea-4fdd-b4cf-7096269ccfee', '63f6819e-5443-44b2-8c8b-47068a013b73', 'c-ii', 'The volume of oxygen collected is always slightly less than expected, even though there are no leaks in the apparatus. Suggest a reason for this.', NULL, 0, 4, '2026-09-13 12:58:26.376272+00');
INSERT INTO public.question_parts VALUES ('fce3f447-0a40-4d95-89e9-b7c1728f2513', '63f6819e-5443-44b2-8c8b-47068a013b73', 'd', 'The equation represents the formation of hydrogen gas at the negative electrode. $2 \mathrm {H} _ {2} \mathrm {O} (\mathrm {I}) + 2 \mathrm {e} ^ {-} \rightarrow 2 \mathrm {O H} ^ {-} (\mathrm {a q}) + \mathrm {H} _ {2} (\mathrm {g})$ During electrolysis, 482 500 coulombs were passed through the solution. Calculate the amount, in moles, of hydrogen gas formed. [One faraday=96500coulombs] Amount of hydrogen gas formed = mol', NULL, 0, 5, '2026-09-13 12:58:26.376312+00');
INSERT INTO public.question_parts VALUES ('beaf6503-2f89-4cff-a206-d9e6f3cefdf6', 'ee74edf8-7c83-4f70-8974-4ee65ec02c2f', 'a', 'the element in group 3 and period 4.', NULL, 0, 0, '2026-09-13 12:58:26.498082+00');
INSERT INTO public.question_parts VALUES ('ff87ef94-650e-4e5d-b8d9-d9764c55a083', 'ee74edf8-7c83-4f70-8974-4ee65ec02c2f', 'b', 'an element in period 3 that is a good conductor of electricity.', NULL, 0, 1, '2026-09-13 12:58:26.498224+00');
INSERT INTO public.question_parts VALUES ('a61ebd5a-4956-4ebe-8551-640f50bdaf25', 'ee74edf8-7c83-4f70-8974-4ee65ec02c2f', 'c', 'the element in group 7 that is the most reactive.', NULL, 0, 2, '2026-09-13 12:58:26.498278+00');
INSERT INTO public.question_parts VALUES ('55002edd-16a7-40fb-a56b-0281be9f7483', 'ee74edf8-7c83-4f70-8974-4ee65ec02c2f', 'd', 'the element in group 5 that is present in a molecule of ammonia.', NULL, 0, 3, '2026-09-13 12:58:26.498322+00');
INSERT INTO public.question_parts VALUES ('d3e31fe2-fb3e-4634-a0d2-242f99015917', 'ee74edf8-7c83-4f70-8974-4ee65ec02c2f', 'e', 'an element with an atom containing 8 electrons in its outer shell.', NULL, 0, 4, '2026-09-13 12:58:26.498359+00');
INSERT INTO public.question_parts VALUES ('eb905488-7cf6-48b3-a215-385624ed238f', 'd2a73bfc-b8a1-4f10-8ff2-1ca8dd3ba738', 'b', 'Gold occurs in ores, which are mixtures of gold and other substances. Several elements and compounds are used in the extraction of gold from its ores. Each box below represents the substances present in one part of the extraction process. Classify the contents of each box as a compound, an element or a mixture by writing your choice below each box.', NULL, 0, 0, '2026-09-13 12:58:26.498414+00');
INSERT INTO public.question_parts VALUES ('18c41997-af01-4b00-9f06-15b8fb268bc7', '5c48f67f-ca81-4feb-a154-0ef018c2d5a8', 'a', 'Identify the gas that causes the fizzing and describe a test for it.', NULL, 0, 0, '2026-09-13 12:58:26.498464+00');
INSERT INTO public.question_parts VALUES ('cdbd78a5-3e57-46e2-ab23-8dd1a1f2cf82', '5c48f67f-ca81-4feb-a154-0ef018c2d5a8', 'b', 'Solution X contains chloride ions.', NULL, 0, 1, '2026-09-13 12:58:26.498507+00');
INSERT INTO public.question_parts VALUES ('0c0a2049-1d49-48cc-bc82-9fb525cc8dc3', '5c48f67f-ca81-4feb-a154-0ef018c2d5a8', 'b-i', 'The student confirmed this by adding some silver nitrate solution. She observed a white precipitate of silver chloride. Give the formula of the white precipitate, and name the other solution she should have added before the silver nitrate solution. Formula of white precipitate. Other solution.', NULL, 0, 2, '2026-09-13 12:58:26.498569+00');
INSERT INTO public.question_parts VALUES ('7f2bec70-19ab-4fa4-87bf-e18944b59f50', '5c48f67f-ca81-4feb-a154-0ef018c2d5a8', 'b-ii', 'Complete the word equation for the reaction in this test. iron chloride + silver nitrate $ \rightarrow $ silver chloride +', NULL, 0, 3, '2026-09-13 12:58:26.498605+00');
INSERT INTO public.question_parts VALUES ('0423dcad-1612-4907-95f8-166d66126cd3', '5c48f67f-ca81-4feb-a154-0ef018c2d5a8', 'c', 'Solution X also contains ions of iron. The student thought that these ions had the formula $ \mathrm{F e}^{2+} $ or $ \mathrm{F e}^{3+} $ What reagent should she add to decide whether solution X contains $ \mathrm{F e}^{2+} $ or $ \mathrm{F e}^{3+} $ ions? State the result of the test in each case. Reagent... Result with $ \mathrm{F e}^{2+} $ ions... Result with $ \mathrm{F e}^{3+} $ ions...', NULL, 0, 4, '2026-09-13 12:58:26.498657+00');
INSERT INTO public.question_parts VALUES ('ef883d96-298f-4c50-87a1-bc5cb95fa905', 'c29220cf-1349-4745-b9ec-724ae93f9038', 'a', 'State two observations that could be made when a small piece of sodium is added to a large trough containing water.', NULL, 0, 0, '2026-09-13 12:58:26.498731+00');
