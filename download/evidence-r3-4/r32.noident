INSERT INTO public.question_parts VALUES ('d9769e70-1e4e-41ec-8527-e52903d6bb0d', '16eabe32-a79f-4fd1-afd4-518bf435a1b8', 'b', 'The following equations represent reactions in the blast furnace. A $ \mathrm{C+O_{2}\rightarrow CO_{2}} $ B $ \mathrm{CaCO_{3}\rightarrow CaO+CO_{2}} $ C $ \mathrm{C+CO_{2}\rightarrow 2CO} $ D $ \mathrm{Fe_{2}O_{3}+3CO\rightarrow 2Fe+3CO_{2}} $ E $ \mathrm{CaO+SiO_{2}\rightarrow CaSiO_{3}} $ Choose from the letters A,B,C,D or E to answer parts (i) - (iv). Each letter may be used once, more than once or not at all.', NULL, 0, 3, '2026-09-13 12:57:42.153711+00');
