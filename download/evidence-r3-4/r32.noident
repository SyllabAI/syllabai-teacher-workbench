INSERT INTO public.question_parts VALUES ('0e72ba4b-6c79-4427-9630-d56a6c664c83', '61d376e8-dac9-41ed-baa1-959201d4728b', 'a', 'Give the name of raw material P and of product Q.', NULL, 0, 0, '2026-09-13 12:59:09.219646+00');
INSERT INTO public.question_parts VALUES ('7f418964-c1bd-4713-97e5-264c78239a28', '61d376e8-dac9-41ed-baa1-959201d4728b', 'b', 'The equations for some reactions in a blast furnace are $\mathrm {C} + \mathrm {O} _ {2} \rightarrow \mathrm {C O} _ {2}$ B C + $ \mathrm{C O_{2}} $ $ \rightarrow $ 2CO C $ \mathrm{F e_{2}O_{3}}+3 \mathrm{C O} \rightarrow 2 \mathrm{F e}+3 \mathrm{C O}_{2} $ D $ \mathrm{C a C O}_{3} \rightarrow \mathrm{C a O}+ \mathrm{C O}_{2} $ $\mathrm {E} \quad \mathrm {C a O} + \mathrm {S i O} _ {2} \rightarrow \mathrm {C a S i O} _ {3}$ The table shows some types of reaction that occur in a blast furnace. Complete the table by writing a letter, A, B, C, D, or E, to link each type of reaction to an appropriate reaction equation. Each letter may be used once, more than once or not at all. The first one has been done for you.', NULL, 0, 1, '2026-09-13 12:59:09.219711+00');
INSERT INTO public.question_parts VALUES ('8dae3f79-d0af-498c-b485-e36dd289cf47', '61d376e8-dac9-41ed-baa1-959201d4728b', 'c', 'The rusting of iron objects is a major problem. Name the two substances needed for iron to rust.', NULL, 0, 2, '2026-09-13 12:59:09.219765+00');
INSERT INTO public.question_parts VALUES ('63254f8c-58b4-4d75-8e04-9648d0372d06', '61d376e8-dac9-41ed-baa1-959201d4728b', 'd', 'The order of reactivity of three metals is zinc iron tin least reactive Iron objects can be prevented from rusting by coating them with zinc or tin. Some of these objects may be scratched when used, so the coating may come off. Use the order of reactivity of the metals to suggest why coating these objects with zinc is more effective than coating them with tin.', NULL, 0, 3, '2026-09-13 12:59:09.2198+00');
INSERT INTO public.question_parts VALUES ('3df523ca-c849-4bca-b22e-fa764dcc2cab', '595c8645-b7d5-4ef3-a6bd-727c1b9dd6a2', 'b', 'Grape vines can be attacked by a fungus that ruins the grapes. The fungus can be killed using Bordeaux mixture, a solid containing copper(II) sulfate and calcium hydroxide.', NULL, 0, 0, '2026-09-13 12:59:09.219867+00');
