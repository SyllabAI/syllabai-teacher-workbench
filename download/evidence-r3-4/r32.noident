INSERT INTO public.question_parts VALUES ('7c95dc07-80a1-4c26-89c3-38f45f122785', '8b4eaa16-aa8e-4075-8a14-d7494788d705', 'a', 'Molybdenum sulfide is converted into molybdenum oxide by heating in air. The equation for this reaction is $2 \mathrm {M o S} _ {2} + 7 \mathrm {O} _ {2} \rightarrow 2 \mathrm {M o O} _ {3} + 4 \mathrm {S O} _ {2}$', NULL, 0, 0, '2026-09-13 12:53:10.993008+00');
