INSERT INTO public.question_parts VALUES ('491427c5-f072-4b30-98e3-146fb0b3fbb7', '2ca19f87-f2e2-49d0-9d26-8808159988ba', 'c', 'In the future, it may be necessary to convert the ethanol (produced by reaction 2) into ethene. Write the equation for this reaction and state the type of reaction that occurs. Equation Type of reaction', NULL, 0, 4, '2026-09-13 12:57:42.153943+00');
INSERT INTO public.question_parts VALUES ('4f8e00f5-3b4d-451a-9aa3-46051608a05f', '3c999e8d-00eb-41aa-bb57-ebf6ad5e9d7d', 'a', 'Draw an arrow on the diagram to show the direction of electron flow at point X.', NULL, 0, 0, '2026-09-13 12:57:42.153951+00');
