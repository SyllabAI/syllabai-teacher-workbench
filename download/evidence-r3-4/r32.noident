INSERT INTO public.question_parts VALUES ('0647f4bf-19d2-4d2b-8ae9-9a5755ddd4bd', 'd737814b-1e5c-436d-8c82-26e61cf61b3c', 'c', 'Octane is a compound in petrol. The equation for the complete combustion of octane is $\mathrm {C} _ {8} \mathrm {H} _ {1 8} + 1 2. 5 \mathrm {O} _ {2} \rightarrow 8 \mathrm {C O} _ {2} + 9 \mathrm {H} _ {2} \mathrm {O}$', NULL, 0, 4, '2026-09-13 12:55:24.086218+00');
