INSERT INTO public.questions VALUES ('9e71ba8d-44bc-4171-80db-cbc5fdcdf176', 'q07-07ced82a', 'STRUCTURED', 'A student uses this apparatus to investigate the rate of reaction between dilute sulfuric acid and an excess of small pieces of zinc. This is the student''s method. Step 1 use 50 $ cm^{3} $ of dilute sulfuric acid Step 2 add approximately 5 g of small zinc pieces to the sulfuric acid Step 3 quickly connect the gas syringe Step 4 record the reading on the gas syringe every 30 seconds until the reaction stops', 13, 3, 1170, NULL, '724a7bac-3b9a-4ce1-86d0-3a8d3165a4a5', 'PAST_PAPER', true, 1, '2026-09-13 12:57:40.990279+00', '21a01adc-71f6-41a2-9829-7e04de46cc2a');
