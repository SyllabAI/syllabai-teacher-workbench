INSERT INTO public.question_parts VALUES ('eb565bdb-7ba7-4072-a5ba-0e0e91d2b248', '3599a42e-ff89-4964-8a30-64c02fd32054', 'a', 'The table gives some statements about the reaction of potassium with water. Place ticks ( $ \surd $ ) in three boxes to show which three statements are correct.', NULL, 0, 0, '2026-09-13 12:54:40.214963+00');
