INSERT INTO public.question_versions VALUES ('8dbb848a-aa02-4d71-88f0-ce461d58fa7d', '4ebd685b-6512-4a7c-9464-88871d362fad', 1, 'The diagram shows how the electrons are arranged in an atom of oxygen. Oxygen atoms form both covalent and ionic bonds.', 14, 3, 1260, NULL, 'SUGGESTED', '36b71b6c-5e35-532f-9a1c-6c6281badb30', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:41:17.663494+00');
