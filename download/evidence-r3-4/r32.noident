INSERT INTO public.question_versions VALUES ('31dbc345-f98c-4c39-a35f-7d65a084ba8f', '84e48d16-f668-4cc2-8215-cecad026b97c', 1, 'A student uses this method to do a titration. use a measuring cylinder to obtain $ 2 5 \mathrm{c m}^{3} $ of sodium hydroxide solution transfer the solution to a conical flask add a few drops of universal indicator to the flask fill a burette with dilute sulfuric acid and record the initial burette reading add the acid to the flask, swirling the flask continuously add the acid slowly near the end-point record the final burette reading at the end-point The student repeats the titration until at least two concordant results are obtained.', 12, 3, 1080, NULL, 'SUGGESTED', '35fdc8b0-ffff-5f0d-a81b-100139963e77', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:03:37.867497+00');
