INSERT INTO public.document_chunks VALUES ('d8fa9890-ce88-4152-84a4-ea22802a3224', '5b9817b7-9922-4821-a500-5d3cf02d1155', 2, 'The lanthanoids (atomic numbers 58-71) and the actinoids (atomic numbers 90-103) have been omitted.
The relative atomic masses of copper and chlorine have not been rounded to the nearest whole number.
