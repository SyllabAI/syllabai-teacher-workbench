INSERT INTO public.document_chunks VALUES ('c3877acd-fbf7-4aa6-bd68-07bf97d9821e', '8f9b5637-a597-44cb-808b-b7119b3aa0e0', 7, '6 (a) Describe the forces of attraction in metallic bonding.
