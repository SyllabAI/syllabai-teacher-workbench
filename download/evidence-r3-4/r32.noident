INSERT INTO public.question_parts VALUES ('577daa98-fcb2-4480-8549-7e0632a14618', '30abad1d-06a6-4644-a920-b0924993ee16', 'c', 'One of the compounds sometimes present in crude oil has the formula $ \mathrm{C_{6} H_{1 2} S} $ Explain why it is important to remove this compound from a fuel.', NULL, 0, 8, '2026-09-13 12:53:12.066656+00');
INSERT INTO public.question_parts VALUES ('dcf0f599-627b-49e7-a973-e82dbf33efd9', '30abad1d-06a6-4644-a920-b0924993ee16', 'd', 'One compound obtained from crude oil is used as a monomer in polymerisation. It has the displayed formula Complete the following structure to show a part of the polymer formed from this monomer. Every effort has been made to contact copyright holders to obtain their permission for the use of copyright material. Pearson Education Ltd. will, if notified, be happy to rectify any errors or omissions and include any such rectifications in future editions.', NULL, 0, 9, '2026-09-13 12:53:12.066659+00');
