INSERT INTO public.questions VALUES ('bedf25fe-2239-489a-b32f-f3eb7b07f8b3', 'q05-2c4bb314', 'STRUCTURED', 'Fractional distillation and cracking are important steps in processing crude oil.', 1, 3, 90, NULL, '196ccd06-a551-424e-bf05-e0b035cddc1e', 'PAST_PAPER', true, 1, '2026-09-13 12:58:26.491087+00', '55a1d582-e61d-4ce4-be95-2890b8abc932');
INSERT INTO public.questions VALUES ('8decd1d0-ac59-4e58-912c-944e53569fb3', 'q06-2c4bb314', 'STRUCTURED', 'Most experiments involving electrolysis use inert electrodes, which do not take part in the reactions. However, in some experiments the electrodes do take part in the reactions. She uses this method. weigh two clean strips of copper use one strip as the positive electrode and the other as the negative electrode after electrolysis wash the strips of copper with ethanol (a liquid that boils at $ 7 8^{\circ} \mathrm{C} $) dry the strips of copper and reweigh them The ionic half-equations for the reactions at the electrodes are Positive electrode $\mathrm {C u} (\mathrm {s}) - 2 \mathrm {e} ^ {-} \rightarrow \mathrm {C u} ^ {2 +} (\mathrm {a q})$ Negative electrode $\mathrm {C u} ^ {2 +} (\mathrm {a q}) + 2 \mathrm {e} ^ {-} \rightarrow \mathrm {C u} (\mathrm {s})$ A student investigates the electrolysis of copper(II) sulfate solution using copper electrodes which do take part in the reaction. She uses this apparatus.', 12, 3, 1080, NULL, '196ccd06-a551-424e-bf05-e0b035cddc1e', 'PAST_PAPER', true, 1, '2026-09-13 12:58:26.491386+00', '55a1d582-e61d-4ce4-be95-2890b8abc932');
INSERT INTO public.questions VALUES ('a5948dfd-39ad-42cc-a522-1ff0420e8e9f', 'q02-7e261528', 'STRUCTURED', 'This question is about gases.', 5, 3, 450, NULL, 'a655ea63-a7cb-4fca-a68b-bac4ebf8106a', 'PAST_PAPER', true, 1, '2026-09-13 13:01:26.259967+00', 'c7cb58db-7f0b-4f65-84b3-a45244d6e886');
INSERT INTO public.questions VALUES ('a31fdca6-a236-4eb0-b3f1-ca2fe2026369', 'q03-d9f7c281', 'STRUCTURED', 'This question is about alcohols. Ethanol can be manufactured using two different methods. hydration of ethene fermentation of glucose This is the equation for hydration. $\mathrm {C} _ {2} \mathrm {H} _ {4} + \mathrm {H} _ {2} \mathrm {O} \rightarrow \mathrm {C} _ {2} \mathrm {H} _ {5} \mathrm {O H}$', 1, 3, 90, NULL, '1eadc1ae-d0f5-405f-9a3c-bbfcb58eeb34', 'PAST_PAPER', true, 1, '2026-09-13 13:03:38.50454+00', '6538f327-91b4-4cfb-beef-f401554e16b6');
