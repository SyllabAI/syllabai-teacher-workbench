INSERT INTO public.question_parts VALUES ('75c7f9fc-203e-4c99-904c-c064d9276b20', 'ce86bf77-ed13-490a-9d69-e53b058f6bfd', 'a', 'Calcium and magnesium are metals. Carbon and sulfur are non-metals.', NULL, 0, 0, '2026-09-13 12:59:56.215393+00');
