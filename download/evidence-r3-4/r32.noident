040", "e000041", "e000042", "e000043", "e000044", "e000045", "e000047", "e000048", "e000049", "e000050", "e000051", "e000052", "e000053", "e000054", "e000055", "e000056", "e000057", "e000058", "e000059", "e000060", "e000061", "e000062", "e000063", "e000064", "e000065", "e000066", "e000067", "e000068", "e000069", "e000070", "e000071", "e000072", "e000073", "e000075", "e000076", "e000077", "e000078", "e000079", "e000080", "e000081", "e000083", "e000084", "e000085", "e000086", "e000087", "e000088", "e000089", "e000090", "e000091", "e000092", "e000093", "e000094", "e000095", "e000096", "e000097", "e000099", "e000100", "e000101", "e000102", "e000103", "e000104", "e000105", "e000107", "e000108", "e000110", "e000111"], "pageNumber": 1}, {"level": 2, "title": "BLANK PAGE", "sectionId": "s005", "elementIds": ["e000113", "e000115", "e000116", "e000117", "e000118", "e000119", "e000120", "e000121", "e000122", "e000124", "e000125", "e000126", "e000127", "e000128", "e000130", "e000131", "e000133", "e000134", "e000135", "e000136", "e000137", "e000138", "e000139", "e000140", "e000141", "e000143", "e000144", "e000145", "e000146", "e000147", "e000148", "e000149", "e000150", "e000151", "e000152", "e000153", "e000155", "e000157", "e000158", "e000159", "e000160", "e000161"], "pageNumber": 1}, {"level": 2, "title": "BLANK PAGE", "sectionId": "s006", "elementIds": ["e000163"], "pageNumber": 1}], "equations": [{"text": "\\mathrm {C} _ {1 6} \\mathrm {H} _ {3 4} \\rightarrow 2 \\mathrm {C} _ {2} \\mathrm {H} _ {4} +", "latex": "\\mathrm {C} _ {1 6} \\mathrm {H} _ {3 4} \\rightarrow 2 \\mathrm {C} _ {2} \\mathrm {H} _ {4} +", "confidence": 1.0, "element_id": "e000109", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 109, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {N a O H} + \\mathrm {H C l} \\rightarrow \\mathrm {N a C l} + \\mathrm {H} _ {2} \\mathrm {O}", "latex": "\\mathrm {N a O H} + \\mathrm {H C l} \\rightarrow \\mathrm {N a C l} + \\mathrm {H} _ {2} \\mathrm {O}", "confidence": 1.0, "element_id": "e000142", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 142, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {H N O} _ {3} + \\mathrm {K O H} \\rightarrow \\mathrm {K N O} _ {3} + \\mathrm {H} _ {2} \\mathrm {O}", "latex": "\\mathrm {H N O} _ {3} + \\mathrm {K O H} \\rightarrow \\mathrm {K N O} _ {3} + \\mathrm {H} _ {2} \\mathrm {O}", "confidence": 1.0, "element_id": "e000154", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 154, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {a m o u n t o f K O H} =", "latex": "\\mathrm {a m o u n t o f K O H} =", "confidence": 1.0, "element_id": "e000156", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 156, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "pageCount": 1, "documentId": "65fd691d-410e-5536-8ce4-e997fc25beea", "provenance": {"engine": "glm-ocr-markdown", "application": "syllabai-parser", "extractedAt": "2026-09-13T12:59:36.312860237Z", "engineVersion": "1.1.0", "schemaVersion": "1.0", "extractionParams": {"pageBoundaries": "none-in-source", "sourceLineCount": 201, "upstreamConverter": "zai-glm-ocr", "entityDecodedLines": 0, "signedUrlFigureRefs": 0, "normalizedHtmlEntities": true}}, "textBlocks": [{"role": "heading", "text": "Instructions", "confidence": 1.0, "element_id": "e000001", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 1, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Use black ink or ball-point pen.", "confidence": 1.0, "element_id": "e000002", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 2, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Fill in the boxes at the top of this page with your name, centre number and candidate number.", "confidence": 1.0, "element_id": "e000003", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 3, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer all questions.", "confidence": 1.0, "element_id": "e000004", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 4, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer the questions in the spaces provided", "confidence": 1.0, "element_id": "e000005", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 5, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "there may be more space than you need.", "confidence": 1.0, "element_id": "e000006", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 6, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Show all the steps in any calculations and state the units.", "confidence": 1.0, "element_id": "e000007", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 7, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Some questions must be answered with a cross in a box. If you change your mind about an answer, put a line through the box and then mark your new answer with a cross.", "confidence": 1.0, "element_id": "e000008", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 8, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Information", "confidence": 1.0, "element_id": "e000009", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 9, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The total mark for this paper is 60.", "confidence": 1.0, "element_id": "e000010", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 10, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The marks for each question are shown in brackets", "confidence": 1.0, "element_id": "e000011", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 11, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "use this as a guide as to how much time to spend on each question.", "confidence": 1.0, "element_id": "e000012", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 12, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Advice", "confidence": 1.0, "element_id": "e000013", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 13, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Read each question carefully before you start to answer it.", "confidence": 1.0, "element_id": "e000014", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 14, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Write your answers neatly and in good English.", "confidence": 1.0, "element_id": "e000015", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 15, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Try to answer every question.", "confidence": 1.0, "element_id": "e000016", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 16, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Check your answers if you have time at the end.", "confidence": 1.0, "element_id": "e000017", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 17, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Turn over", "confidence": 1.0, "element_id": "e000018", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 18, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000020", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 20, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Answer ALL questions.", "confidence": 1.0, "element_id": "e000021", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 21, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "1 The diagram represents an atom of an element.", "confidence": 1.0, "element_id": "e000022", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 22, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) (i) What is the particle labelled X?", "confidence": 1.0, "element_id": "e000024", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 24, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A an electron", "confidence": 1.0, "element_id": "e000025", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 25, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B an ion", "confidence": 1.0, "element_id": "e000026", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 26, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C a proton", "confidence": 1.0, "element_id": "e000027", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 27, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D a neutron", "confidence": 1.0, "element_id": "e000028", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 28, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) What is the mass number of this atom?", "confidence": 1.0, "element_id": "e000029", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 29, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A 4", "confidence": 1.0, "element_id": "e000030", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 30, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B 5", "confidence": 1.0, "element_id": "e000031", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 31, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C 9", "confidence": 1.0, "element_id": "e000032", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 32, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D 13", "confidence": 1.0, "element_id": "e000033", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 33, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Name the element that contains these atoms.", "confidence": 1.0, "element_id": "e000034", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 34, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Hydrogen has three isotopes.", "confidence": 1.0, "element_id": "e000035", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 35, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "State, in terms of subatomic particles, one way in which these isotopes are the same and one way in which they are different.", "confidence": 1.0, "element_id": "e000036", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 36, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "different", "confidence": 1.0, "element_id": "e000037", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 37, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 1 = 5 marks)", "confidence": 1.0, "element_id": "e000038", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 38, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "2 A small piece of magnesium ribbon is added to dilute sulfuric acid in a test tube. Hydrogen gas is produced.", "confidence": 1.0, "element_id": "e000039", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 39, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) State two observations that are seen during the reaction.", "confidence": 1.0, "element_id": "e000040", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 40, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The reaction is exothermic.", "confidence": 1.0, "element_id": "e000041", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 41, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "State what happens to the temperature of the acid during the reaction.", "confidence": 1.0, "element_id": "e000042", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 42, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Write a word equation for the reaction.", "confidence": 1.0, "element_id": "e000043", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 43, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 2 = 4 marks)", "confidence": 1.0, "element_id": "e000044", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 44, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "3 This apparatus can be used to prepare carbon dioxide from reagents A and B.", "confidence": 1.0, "element_id": "e000045", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 45, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Calcium chloride and water are also products of the reaction between A and B. Identify reagent A and reagent B.", "confidence": 1.0, "element_id": "e000047", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 47, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) In the diagram, the carbon dioxide is collected over water. State another way of collecting the carbon dioxide.", "confidence": 1.0, "element_id": "e000048", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 48, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) At the end of the experiment, the solution in the trough is weakly acidic.", "confidence": 1.0, "element_id": "e000049", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 49, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) State the colour of the solution when some Universal Indicator is added.", "confidence": 1.0, "element_id": "e000050", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 50, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Give the name and the formula of the acid that forms when carbon dioxide dissolves in water.", "confidence": 1.0, "element_id": "e000051", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 51, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "name ... formula", "confidence": 1.0, "element_id": "e000052", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 52, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 3 = 6 marks)", "confidence": 1.0, "element_id": "e000053", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 53, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "4 Crude oil is a complex mixture containing many compounds and is a source of many chemicals.", "confidence": 1.0, "element_id": "e000054", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 54, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Most of the compounds in crude oil contain two elements. Name these two elements.", "confidence": 1.0, "element_id": "e000055", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 55, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "and", "confidence": 1.0, "element_id": "e000056", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 56, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Crude oil is separated into fractions in order to produce useful chemicals.", "confidence": 1.0, "element_id": "e000057", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 57, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) State what is meant by the term fraction.", "confidence": 1.0, "element_id": "e000058", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 58, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Describe the industrial process used to obtain fractions from crude oil.", "confidence": 1.0, "element_id": "e000059", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 59, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) The box shows four fractions obtained from crude oil.", "confidence": 1.0, "element_id": "e000060", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 60, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "bitumen", "confidence": 1.0, "element_id": "e000061", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 61, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "diesel", "confidence": 1.0, "element_id": "e000062", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 62, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "fuel oil", "confidence": 1.0, "element_id": "e000063", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 63, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "gasoline", "confidence": 1.0, "element_id": "e000064", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 64, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Which of these fractions contains compounds with the highest boiling points?", "confidence": 1.0, "element_id": "e000065", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 65, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Which of these fractions is the most volatile?", "confidence": 1.0, "element_id": "e000066", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 66, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) Fuel oil can be burned to heat homes.", "confidence": 1.0, "element_id": "e000067", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 67, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "If combustion is incomplete, a dangerous gas is produced.", "confidence": 1.0, "element_id": "e000068", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 68, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Name this gas.", "confidence": 1.0, "element_id": "e000069", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 69, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) State why this gas is dangerous.", "confidence": 1.0, "element_id": "e000070", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 70, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 4 = 9 marks)", "confidence": 1.0, "element_id": "e000071", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 71, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "5 Ammonia is a toxic gas that is very soluble in water.", "confidence": 1.0, "element_id": "e000072", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 72, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A teacher uses this apparatus to investigate the solubility of ammonia in water at different temperatures.", "confidence": 1.0, "element_id": "e000073", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 73, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "This is the teacher''s method.", "confidence": 1.0, "element_id": "e000075", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 75, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "pour 100 $ cm^{3} $ of water into the beaker and measure the temperature of the water", "confidence": 1.0, "element_id": "e000076", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 76, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "place the beaker on the balance and record the mass of the beaker and water", "confidence": 1.0, "element_id": "e000077", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 77, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "bubble ammonia into the water until the mass is constant", "confidence": 1.0, "element_id": "e000078", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 78, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "record the constant mass", "confidence": 1.0, "element_id": "e000079", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 79, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The teacher repeats the experiment with the water at different temperatures.", "confidence": 1.0, "element_id": "e000080", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 80, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The table shows the teacher''s results.", "confidence": 1.0, "element_id": "e000081", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 81, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) (i) Calculate the mass of ammonia dissolved in $ 1 0 0 \\mathrm{c m}^{3} $ of water at $ 2 5 \\mathrm{^o C}. $", "confidence": 1.0, "element_id": "e000083", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 83, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "mass of ammonia =", "confidence": 1.0, "element_id": "e000084", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 84, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) State the relationship between temperature and solubility of ammonia.", "confidence": 1.0, "element_id": "e000085", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 85, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Explain one safety precaution that the teacher should take when doing this experiment.", "confidence": 1.0, "element_id": "e000086", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 86, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) When the teacher does the experiment at a higher temperature, the reading on the balance gradually increases but then slowly decreases.", "confidence": 1.0, "element_id": "e000087", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 87, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Suggest why the reading on the balance slowly decreases.", "confidence": 1.0, "element_id": "e000088", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 88, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) Ammonia is an alkaline gas.", "confidence": 1.0, "element_id": "e000089", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 89, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Suggest a different method that the teacher could use to compare the mass of ammonia dissolved in the water at different temperatures.", "confidence": 1.0, "element_id": "e000090", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 90, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 5 = 6 marks)", "confidence": 1.0, "element_id": "e000091", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 91, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "6 Ethanol can be made by two different methods.", "confidence": 1.0, "element_id": "e000092", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 92, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "method1 fermentation of glucose", "confidence": 1.0, "element_id": "e000093", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 93, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "method2 reaction of ethene with steam", "confidence": 1.0, "element_id": "e000094", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 94, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Name the catalyst used in each method.", "confidence": 1.0, "element_id": "e000095", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 95, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "method 1", "confidence": 1.0, "element_id": "e000096", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 96, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Two companies produce ethanol for different purposes. The table gives some information about each company.", "confidence": 1.0, "element_id": "e000097", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 97, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Explain which method of production each company is more likely to use.", "confidence": 1.0, "element_id": "e000099", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 99, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(4)", "confidence": 1.0, "element_id": "e000100", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 100, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Company A", "confidence": 1.0, "element_id": "e000101", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 101, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Company B", "confidence": 1.0, "element_id": "e000102", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 102, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Most of the ethene used to make polymers is produced by the cracking of crude oil fractions.", "confidence": 1.0, "element_id": "e000103", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 103, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) One of the polymers made from ethene is poly(ethene).", "confidence": 1.0, "element_id": "e000104", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 104, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Complete the equation to show the formation of poly(ethene) from ethene.", "confidence": 1.0, "element_id": "e000105", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 105, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The kerosene fraction obtained from crude oil contains a hydrocarbon with the formula $ \\mathrm{C_{1 6} H_{3 4}} $", "confidence": 1.0, "element_id": "e000107", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 107, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Complete the equation to show the formation of ethene and one molecule of another hydrocarbon from the cracking of $ \\mathrm{C_{1 6} H_{3 4}} $", "confidence": 1.0, "element_id": "e000108", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 108, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Suggest why it may be necessary, in future, to make ethene from ethanol.", "confidence": 1.0, "element_id": "e000110", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 110, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 6 = 10 marks)", "confidence": 1.0, "element_id": "e000111", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 111, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000112", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 112, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "7 A student uses this apparatus to investigate the change in temperature when dilute hydrochloric acid is added to aqueous sodium hydroxide.", "confidence": 1.0, "element_id": "e000113", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 113, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "This is the student''s method.", "confidence": 1.0, "element_id": "e000115", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 115, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "pour some aqueous sodium hydroxide into the polystyrene cup", "confidence": 1.0, "element_id": "e000116", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 116, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "record the temperature of the sodium hydroxide", "confidence": 1.0, "element_id": "e000117", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 117, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "add some dilute hydrochloric acid and stir the mixture", "confidence": 1.0, "element_id": "e000118", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 118, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "record the highest temperature of the mixture", "confidence": 1.0, "element_id": "e000119", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 119, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The student repeats the experiment using different volumes of the two solutions.", "confidence": 1.0, "element_id": "e000120", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 120, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Explain why the student uses a polystyrene cup to contain the solution,rather than a beaker.", "confidence": 1.0, "element_id": "e000121", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 121, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The diagram shows the thermometer readings for one experiment before and after adding the acid.", "confidence": 1.0, "element_id": "e000122", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 122, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Record the temperatures before and after adding the acid.", "confidence": 1.0, "element_id": "e000124", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 124, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "before ... °C", "confidence": 1.0, "element_id": "e000125", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 125, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "after ... °C", "confidence": 1.0, "element_id": "e000126", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 126, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) The table shows the results of a series of experiments.", "confidence": 1.0, "element_id": "e000127", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 127, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The initial temperatures of the aqueous sodium hydroxide and the dilute hydrochloric acid are the same.", "confidence": 1.0, "element_id": "e000128", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 128, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Plot the results from the table on the grid.", "confidence": 1.0, "element_id": "e000130", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 130, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Highest temperature of mixture in $ ^{\\circ} \\mathrm{C} $", "confidence": 1.0, "element_id": "e000131", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 131, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Volume of aqueous sodium hydroxide in $ \\mathrm{c m}^{3} $", "confidence": 1.0, "element_id": "e000133", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 133, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Draw a straight line of best fit for experiments 1,2 and 3.", "confidence": 1.0, "element_id": "e000134", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 134, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Draw a second straight line of best fit for experiments 4,5 and 6.", "confidence": 1.0, "element_id": "e000135", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 135, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Extend both lines so that they cross.", "confidence": 1.0, "element_id": "e000136", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 136, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The point where the two lines cross indicates when equal amounts, in moles, of sodium hydroxide and hydrochloric acid react.", "confidence": 1.0, "element_id": "e000137", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 137, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Use your graph to find the volumes that contain equal amounts of sodium hydroxide and hydrochloric acid.", "confidence": 1.0, "element_id": "e000138", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 138, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "volume of sodium hydroxide", "confidence": 1.0, "element_id": "e000139", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 139, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "volume of hydrochloric acid", "confidence": 1.0, "element_id": "e000140", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 140, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) The equation for the reaction between sodium hydroxide and hydrochloric acid is", "confidence": 1.0, "element_id": "e000141", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 141, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Explain which solution, the sodium hydroxide or the hydrochloric acid, has the greater concentration.", "confidence": 1.0, "element_id": "e000143", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 143, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 7 = 12 marks)", "confidence": 1.0, "element_id": "e000144", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 144, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "8 A student does a titration to find the concentration of a solution of nitric acid.", "confidence": 1.0, "element_id": "e000145", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 145, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "This is the student''s method.", "confidence": 1.0, "element_id": "e000146", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 146, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "pipette 25.0 $ cm^{3} $ of the nitric acid into a conical flask", "confidence": 1.0, "element_id": "e000147", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 147, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "add a few drops of indicator", "confidence": 1.0, "element_id": "e000148", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 148, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "add aqueous potassium hydroxide from a burette until the indicator just changes colour", "confidence": 1.0, "element_id": "e000149", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 149, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "determine the volume of alkali added from the burette", "confidence": 1.0, "element_id": "e000150", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 150, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The concentration of the potassium hydroxide solution is 0.0200 mol/dm $ ^{3} $", "confidence": 1.0, "element_id": "e000151", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 151, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The volume of potassium hydroxide required to neutralise the acid is $ 2 3. 5 0 \\mathrm{c m}^{3}. $", "confidence": 1.0, "element_id": "e000152", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 152, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The equation for the reaction between nitric acid and potassium hydroxide is", "confidence": 1.0, "element_id": "e000153", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 153, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) (i) Calculate the amount, in moles, of KOH used in this titration.", "confidence": 1.0, "element_id": "e000155", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 155, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Calculate the concentration, in mol/dm $ ^{3} $ , of the nitric acid.", "confidence": 1.0, "element_id": "e000157", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 157, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The student makes a solution of potassium nitrate by neutralising aqueous potassium hydroxide with dilute nitric acid.", "confidence": 1.0, "element_id": "e000158", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 158, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Describe how he could use crystallisation to obtain a pure, dry sample of potassium nitrate crystals from the solution of potassium nitrate.", "confidence": 1.0, "element_id": "e000159", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 159, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 8 = 8 marks)", "confidence": 1.0, "element_id": "e000160", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 160, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "TOTAL FOR PAPER=60 MARKS", "confidence": 1.0, "element_id": "e000161", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 161, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000162", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 162, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Every effort has been made to contact copyright holders to obtain their permission for the use of copyright material. Pearson Education Ltd. will, if notified, be happy to rectify any errors or omissions and include any such rectifications in future editions.", "confidence": 1.0, "element_id": "e000163", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 163, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "schemaVersion": "1.0"}', NULL, '2026-09-13 12:59:56.476695+00');
