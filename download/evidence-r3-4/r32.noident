"1.1.0"}], "version": 1, "sections": [{"level": 2, "title": "Instructions", "sectionId": "s001", "elementIds": ["e000002", "e000003", "e000004", "e000005", "e000006", "e000007", "e000008"], "pageNumber": 1}, {"level": 2, "title": "Information", "sectionId": "s002", "elementIds": ["e000010", "e000011", "e000012"], "pageNumber": 1}, {"level": 2, "title": "Advice", "sectionId": "s003", "elementIds": ["e000014", "e000015", "e000016", "e000017"], "pageNumber": 1}, {"level": 2, "title": "BLANK PAGE", "sectionId": "s004", "elementIds": [], "pageNumber": 1}, {"level": 2, "title": "Answer ALL questions.", "sectionId": "s005", "elementIds": ["e000021", "e000022", "e000024", "e000026", "e000028", "e000029", "e000030", "e000031", "e000032", "e000033", "e000034", "e000035", "e000036", "e000037", "e000038", "e000039", "e000040", "e000041", "e000042", "e000043", "e000044", "e000045", "e000046", "e000047", "e000050", "e000052", "e000053", "e000054", "e000055", "e000056", "e000058", "e000060", "e000061", "e000064", "e000065", "e000067", "e000068", "e000069", "e000070", "e000072", "e000073", "e000075", "e000076"], "pageNumber": 1}, {"level": 2, "title": "(c) Aluminium is extracted from aluminium oxide using electrolysis.", "sectionId": "s006", "elementIds": ["e000078", "e000079", "e000081", "e000082", "e000083", "e000084", "e000085", "e000086", "e000087", "e000088", "e000089", "e000090", "e000091", "e000092", "e000093", "e000094", "e000095", "e000096", "e000097", "e000099", "e000100", "e000102", "e000103", "e000104", "e000105", "e000106", "e000107", "e000108", "e000109", "e000111", "e000113", "e000115", "e000116", "e000117", "e000118", "e000119", "e000120", "e000121", "e000122", "e000123", "e000124", "e000126", "e000128", "e000129", "e000131", "e000133", "e000134", "e000135", "e000136", "e000138", "e000139", "e000140", "e000141", "e000142", "e000143", "e000144", "e000145", "e000147", "e000148", "e000149", "e000150", "e000151", "e000152", "e000153", "e000154", "e000155", "e000157"], "pageNumber": 1}, {"level": 2, "title": "mass of carbon dioxide =", "sectionId": "s007", "elementIds": ["e000159", "e000160"], "pageNumber": 1}, {"level": 2, "title": "TOTAL FOR PAPER = 60 MARKS", "sectionId": "s008", "elementIds": [], "pageNumber": 1}, {"level": 2, "title": "BLANK PAGE", "sectionId": "s009", "elementIds": [], "pageNumber": 1}, {"level": 2, "title": "BLANK PAGE", "sectionId": "s010", "elementIds": ["e000166"], "pageNumber": 1}], "equations": [{"text": "\\mathrm {F e} + \\mathrm {H} _ {2} \\mathrm {S O} _ {4} \\rightarrow \\mathrm {F e S O} _ {4} + \\mathrm {H} _ {2}", "latex": "\\mathrm {F e} + \\mathrm {H} _ {2} \\mathrm {S O} _ {4} \\rightarrow \\mathrm {F e S O} _ {4} + \\mathrm {H} _ {2}", "confidence": 1.0, "element_id": "e000057", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 57, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {I r o n} + \\mathrm {s u l f u r i c a c i d} \\rightarrow", "latex": "\\mathrm {I r o n} + \\mathrm {s u l f u r i c a c i d} \\rightarrow", "confidence": 1.0, "element_id": "e000059", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 59, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {F e} ^ {2 +} (\\mathrm {a q}).", "latex": "\\mathrm {F e} ^ {2 +} (\\mathrm {a q}).", "confidence": 1.0, "element_id": "e000062", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 62, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {F e} ^ {3 +} (\\mathrm {a q}).", "latex": "\\mathrm {F e} ^ {3 +} (\\mathrm {a q}).", "confidence": 1.0, "element_id": "e000063", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 63, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "M g + C l _ {2} \\rightarrow M g C l _ {2}", "latex": "M g + C l _ {2} \\rightarrow M g C l _ {2}", "confidence": 1.0, "element_id": "e000071", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 71, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {A l} ^ {3 +} + 3 \\mathrm {e} ^ {-} \\rightarrow \\mathrm {A l}", "latex": "\\mathrm {A l} ^ {3 +} + 3 \\mathrm {e} ^ {-} \\rightarrow \\mathrm {A l}", "confidence": 1.0, "element_id": "e000080", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 80, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {C H} _ {2} = \\mathrm {C H C H} _ {2} \\mathrm {C H} _ {3} + \\mathrm {H} _ {2} \\mathrm {O} \\rightarrow \\quad \\begin{array}{c c c c} | & | & | & | \\\\ - C & - C & - C & - C & - \\\\ | & | & | & | \\end{array}", "latex": "\\mathrm {C H} _ {2} = \\mathrm {C H C H} _ {2} \\mathrm {C H} _ {3} + \\mathrm {H} _ {2} \\mathrm {O} \\rightarrow \\quad \\begin{array}{c c c c} | & | & | & | \\\\ - C & - C & - C & - C & - \\\\ | & | & | & | \\end{array}", "confidence": 1.0, "element_id": "e000110", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 110, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "n \\quad \\begin{array}{c c c} H & H \\\\ | & | \\\\ C = C \\\\ | & | \\\\ H & C _ {2} H _ {5} \\end{array} \\rightarrow", "latex": "n \\quad \\begin{array}{c c c} H & H \\\\ | & | \\\\ C = C \\\\ | & | \\\\ H & C _ {2} H _ {5} \\end{array} \\rightarrow", "confidence": 1.0, "element_id": "e000112", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 112, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "C _ {8} H _ {1 8} + 1 2 \\frac {1}{2} O _ {2} \\rightarrow 8 C O _ {2} + 9 H _ {2} O", "latex": "C _ {8} H _ {1 8} + 1 2 \\frac {1}{2} O _ {2} \\rightarrow 8 C O _ {2} + 9 H _ {2} O", "confidence": 1.0, "element_id": "e000146", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 146, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "2 \\mathrm {N a H C O} _ {3} \\rightarrow \\mathrm {N a} _ {2} \\mathrm {C O} _ {3} + \\mathrm {H} _ {2} \\mathrm {O} + \\mathrm {C O} _ {2}", "latex": "2 \\mathrm {N a H C O} _ {3} \\rightarrow \\mathrm {N a} _ {2} \\mathrm {C O} _ {3} + \\mathrm {H} _ {2} \\mathrm {O} + \\mathrm {C O} _ {2}", "confidence": 1.0, "element_id": "e000156", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 156, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {c m} ^ {3}", "latex": "\\mathrm {c m} ^ {3}", "confidence": 1.0, "element_id": "e000161", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 161, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "(\\mathrm {T o t a l f o r Q u e s t i o n 8 = 4 m a r k s})", "latex": "(\\mathrm {T o t a l f o r Q u e s t i o n 8 = 4 m a r k s})", "confidence": 1.0, "element_id": "e000162", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 162, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "pageCount": 1, "documentId": "9ef9b0c8-3a05-5e34-977c-7af899b976bc", "provenance": {"engine": "glm-ocr-markdown", "application": "syllabai-parser", "extractedAt": "2026-09-13T12:58:50.467089173Z", "engineVersion": "1.1.0", "schemaVersion": "1.0", "extractionParams": {"pageBoundaries": "none-in-source", "sourceLineCount": 241, "upstreamConverter": "zai-glm-ocr", "entityDecodedLines": 0, "signedUrlFigureRefs": 0, "normalizedHtmlEntities": true}}, "textBlocks": [{"role": "heading", "text": "Instructions", "confidence": 1.0, "element_id": "e000001", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 1, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Use black ink or ball-point pen.", "confidence": 1.0, "element_id": "e000002", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 2, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Fill in the boxes at the top of this page with your name, centre number and candidate number.", "confidence": 1.0, "element_id": "e000003", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 3, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer all questions.", "confidence": 1.0, "element_id": "e000004", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 4, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer the questions in the spaces provided", "confidence": 1.0, "element_id": "e000005", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 5, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "-сессуары - there may be more space than you need.", "confidence": 1.0, "element_id": "e000006", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 6, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Show all the steps in any calculations and state the units.", "confidence": 1.0, "element_id": "e000007", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 7, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Some questions must be answered with a cross in a box. If you change your mind about an answer, put a line through the box and then mark your new answer with a cross.", "confidence": 1.0, "element_id": "e000008", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 8, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Information", "confidence": 1.0, "element_id": "e000009", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 9, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The total mark for this paper is 60.", "confidence": 1.0, "element_id": "e000010", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 10, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The marks for each question are shown in brackets", "confidence": 1.0, "element_id": "e000011", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 11, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "use this as a guide as to how much time to spend on each question.", "confidence": 1.0, "element_id": "e000012", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 12, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Advice", "confidence": 1.0, "element_id": "e000013", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 13, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Read each question carefully before you start to answer it.", "confidence": 1.0, "element_id": "e000014", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 14, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Write your answers neatly and in good English.", "confidence": 1.0, "element_id": "e000015", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 15, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Try to answer every question.", "confidence": 1.0, "element_id": "e000016", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 16, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Check your answers if you have time at the end.", "confidence": 1.0, "element_id": "e000017", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 17, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000019", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 19, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Answer ALL questions.", "confidence": 1.0, "element_id": "e000020", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 20, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "1 The diagram shows the apparatus a student uses to separate a mixture of salt and sand.", "confidence": 1.0, "element_id": "e000021", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 21, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "She adds the mixture to water in a beaker and then carries out the three stages shown.", "confidence": 1.0, "element_id": "e000022", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 22, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "stage 1", "confidence": 1.0, "element_id": "e000024", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 24, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "stage 2", "confidence": 1.0, "element_id": "e000026", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 26, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "stage 3", "confidence": 1.0, "element_id": "e000028", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 28, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Give the names of the pieces of apparatus labelled X and Y.", "confidence": 1.0, "element_id": "e000029", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 29, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(2)", "confidence": 1.0, "element_id": "e000030", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 30, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) (i) A liquid that dissolves substances is a", "confidence": 1.0, "element_id": "e000031", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 31, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(1)", "confidence": 1.0, "element_id": "e000032", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 32, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A solute", "confidence": 1.0, "element_id": "e000033", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 33, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B solution", "confidence": 1.0, "element_id": "e000034", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 34, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C solvent", "confidence": 1.0, "element_id": "e000035", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 35, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D suspension", "confidence": 1.0, "element_id": "e000036", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 36, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The clear liquid that forms in stage 1 is a", "confidence": 1.0, "element_id": "e000037", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 37, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A solute", "confidence": 1.0, "element_id": "e000038", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 38, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B solution", "confidence": 1.0, "element_id": "e000039", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 39, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C solvent", "confidence": 1.0, "element_id": "e000040", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 40, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D suspension", "confidence": 1.0, "element_id": "e000041", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 41, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(1)", "confidence": 1.0, "element_id": "e000042", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 42, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) (i) At which stage,1,2 or 3,is the sand collected?", "confidence": 1.0, "element_id": "e000043", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 43, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) At which stage, 1, 2 or 3, is the salt collected?", "confidence": 1.0, "element_id": "e000044", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 44, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) What happens to the water in stage 3?", "confidence": 1.0, "element_id": "e000045", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 45, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 1 = 7 marks)", "confidence": 1.0, "element_id": "e000046", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 46, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "2 The apparatus in the diagram was set up to demonstrate the rusting of iron.", "confidence": 1.0, "element_id": "e000047", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 47, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "after one week", "confidence": 1.0, "element_id": "e000050", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 50, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "after two weeks", "confidence": 1.0, "element_id": "e000052", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 52, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) One week after the start of the experiment the volume of gas in the measuring cylinder has decreased.", "confidence": 1.0, "element_id": "e000053", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 53, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "After two weeks there is no further decrease in volume of gas in the measuring cylinder.", "confidence": 1.0, "element_id": "e000054", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 54, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Explain these observations.", "confidence": 1.0, "element_id": "e000055", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 55, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Iron reacts with dilute sulfuric acid. The chemical equation for this reaction is", "confidence": 1.0, "element_id": "e000056", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 56, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Complete the word equation for the reaction.", "confidence": 1.0, "element_id": "e000058", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 58, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Aqueous sodium hydroxide can be used to distinguish between solutions containing iron(II) ions $ \\mathrm{(F e^{2+})} $ and iron(III) ions $ \\mathrm{(F e^{3+})}. $", "confidence": 1.0, "element_id": "e000060", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 60, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "State the observation made when aqueous sodium hydroxide is added separately to each solution.", "confidence": 1.0, "element_id": "e000061", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 61, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 2 = 6 marks)", "confidence": 1.0, "element_id": "e000064", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 64, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "3 The diagram shows the elements in Period 3 of the Periodic Table.", "confidence": 1.0, "element_id": "e000065", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 65, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) (i) Identify an element in Period 3 that forms a basic oxide.", "confidence": 1.0, "element_id": "e000067", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 67, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Identify an element in Period 3 that forms an acidic oxide.", "confidence": 1.0, "element_id": "e000068", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 68, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Magnesium and chlorine react together to form magnesium chloride, a compound with ionic bonding.", "confidence": 1.0, "element_id": "e000069", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 69, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The equation for the reaction is", "confidence": 1.0, "element_id": "e000070", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 70, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Complete the dot and cross diagram to show the arrangement of the outer electrons in the magnesium and chloride ions formed.", "confidence": 1.0, "element_id": "e000072", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 72, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Show the charge on each ion.", "confidence": 1.0, "element_id": "e000073", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 73, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) State what is meant by the term ionic bonding.", "confidence": 1.0, "element_id": "e000075", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 75, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Explain why magnesium chloride has a high melting point.", "confidence": 1.0, "element_id": "e000076", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 76, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "(c) Aluminium is extracted from aluminium oxide using electrolysis.", "confidence": 1.0, "element_id": "e000077", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 77, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Calculate the mass, in grams, of aluminium formed when a charge of 20 faradays is passed through aluminium oxide dissolved in molten cryolite.", "confidence": 1.0, "element_id": "e000078", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 78, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The ionic half-equation for the formation of aluminium is", "confidence": 1.0, "element_id": "e000079", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 79, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "4 Crystals of copper(II) nitrate, $ \\mathrm{C u} \\left( \\mathrm{N O}_{3} \\right)_{2} $ , can be prepared by reacting solid copper(II) oxide, CuO, with dilute nitric acid.", "confidence": 1.0, "element_id": "e000081", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 81, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Write a chemical equation for this reaction.", "confidence": 1.0, "element_id": "e000082", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 82, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) A student is given a sample of copper(II) oxide containing small amounts of insoluble impurities.", "confidence": 1.0, "element_id": "e000083", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 83, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The passage is from her notebook and describes the method she uses to prepare some pure, dry crystals of copper(II) nitrate from her sample of copper(II) oxide.", "confidence": 1.0, "element_id": "e000084", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 84, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Stage 1: Place 50 $ cm^{3} $ of dilute nitric acid into a beaker and warm.", "confidence": 1.0, "element_id": "e000085", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 85, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Stage 2: Add the impure copper(II) oxide a little at a time and stir, until it is in excess.", "confidence": 1.0, "element_id": "e000086", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 86, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Stage 3: Filter the mixture.", "confidence": 1.0, "element_id": "e000087", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 87, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Stage 4: Heat the filtrate until the crystallisation point is reached.", "confidence": 1.0, "element_id": "e000088", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 88, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Stage 5: Allow the filtrate to cool.", "confidence": 1.0, "element_id": "e000089", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 89, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Stage 6: Filter off the crystals and dry with filter paper.", "confidence": 1.0, "element_id": "e000090", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 90, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Why is the acid warmed in stage 1?", "confidence": 1.0, "element_id": "e000091", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 91, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) How will the student know when the copper(II) oxide is in excess in stage 2?", "confidence": 1.0, "element_id": "e000092", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 92, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) How will the student know when the crystallisation point is reached in stage 4?", "confidence": 1.0, "element_id": "e000093", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 93, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iv) In which stage are the insoluble impurities removed?", "confidence": 1.0, "element_id": "e000094", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 94, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 4 = 5 marks)", "confidence": 1.0, "element_id": "e000095", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 95, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "5 But-1-ene is a member of the homologous series of alkenes.", "confidence": 1.0, "element_id": "e000096", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 96, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The displayed formula of but-1-ene is", "confidence": 1.0, "element_id": "e000097", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 97, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The saturated compound cyclobutane is an isomer of but-1-ene.", "confidence": 1.0, "element_id": "e000099", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 99, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The displayed formula of cyclobutane is", "confidence": 1.0, "element_id": "e000100", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 100, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) (i) State what is meant by the term isomers.", "confidence": 1.0, "element_id": "e000102", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 102, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(2)", "confidence": 1.0, "element_id": "e000103", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 103, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Draw the displayed formula of another isomer of but-1-ene.", "confidence": 1.0, "element_id": "e000104", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 104, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(1)", "confidence": 1.0, "element_id": "e000105", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 105, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Describe a test that would distinguish between but-1-ene and cyclobutane.", "confidence": 1.0, "element_id": "e000106", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 106, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(3)", "confidence": 1.0, "element_id": "e000107", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 107, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Using your knowledge of the reactions of ethene, complete the two chemical equations to show the formula of the organic product.", "confidence": 1.0, "element_id": "e000108", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 108, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) The reaction between but-1-ene and steam.", "confidence": 1.0, "element_id": "e000109", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 109, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The polymerisation of but-1-ene.", "confidence": 1.0, "element_id": "e000111", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 111, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "6 This apparatus can be used in a method to find the volume of sulfuric acid required to neutralise a solution of potassium hydroxide (KOH).", "confidence": 1.0, "element_id": "e000113", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 113, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) What name is given to this method?", "confidence": 1.0, "element_id": "e000115", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 115, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Which piece of apparatus should be used to measure the $ 2 5. 0 \\mathrm{c m}^{3} $ of KOH?", "confidence": 1.0, "element_id": "e000116", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 116, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A beaker", "confidence": 1.0, "element_id": "e000117", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 117, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B measuring cylinder", "confidence": 1.0, "element_id": "e000118", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 118, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C pipette", "confidence": 1.0, "element_id": "e000119", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 119, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D syringe", "confidence": 1.0, "element_id": "e000120", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 120, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) State the colours that are seen if methyl orange is used as the indicator.", "confidence": 1.0, "element_id": "e000121", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 121, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "colour before adding the acid ...", "confidence": 1.0, "element_id": "e000122", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 122, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "colour after KOH is neutralised.", "confidence": 1.0, "element_id": "e000123", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 123, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) A student carries out the experiment. His burette readings are shown in the diagram.", "confidence": 1.0, "element_id": "e000124", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 124, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "before", "confidence": 1.0, "element_id": "e000126", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 126, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "after", "confidence": 1.0, "element_id": "e000128", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 128, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Use the diagram to complete the table. Give the readings to the nearest 0.05 $ \\mathrm{c m}^{3}. $", "confidence": 1.0, "element_id": "e000129", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 129, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(e) A second student did the experiment four times, using a different solution of potassium hydroxide. The table shows her results.", "confidence": 1.0, "element_id": "e000131", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 131, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Concordant results are those within $ 0. 2 0 \\mathrm{c m}^{3} $ of one another.", "confidence": 1.0, "element_id": "e000133", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 133, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Place ticks in the table to indicate which results are concordant with one another.", "confidence": 1.0, "element_id": "e000134", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 134, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Use your ticked results to calculate the average (mean) volume of acid added.", "confidence": 1.0, "element_id": "e000135", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 135, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "7 Crude oil is a complex mixture of organic compounds called hydrocarbons. It is separated into fractions using a fractionating tower.", "confidence": 1.0, "element_id": "e000136", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 136, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Which fraction has the lowest boiling point?", "confidence": 1.0, "element_id": "e000138", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 138, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(1)", "confidence": 1.0, "element_id": "e000139", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 139, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Which fraction is the most viscous?", "confidence": 1.0, "element_id": "e000140", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 140, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(1)", "confidence": 1.0, "element_id": "e000141", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 141, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) (i) Some fractions containing long-chain hydrocarbons are cracked. The cracking of octadecane, $ ( C_{1 8} H_{3 8} ) $ , produces octane, $ ( C_{8} H_{1 8} ) $ , and one other product.", "confidence": 1.0, "element_id": "e000142", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 142, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Write a chemical equation for this cracking reaction.", "confidence": 1.0, "element_id": "e000143", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 143, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Explain why it is important to crack long-chain hydrocarbon fractions.", "confidence": 1.0, "element_id": "e000144", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 144, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) Octane is one of the hydrocarbons in the petrol used in cars.", "confidence": 1.0, "element_id": "e000145", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 145, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The equation for the complete combustion of octane is", "confidence": 1.0, "element_id": "e000147", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 147, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The incomplete combustion of octane produces a poisonous gas that reduces the capacity of blood to carry oxygen.", "confidence": 1.0, "element_id": "e000148", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 148, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Write a chemical equation for this incomplete combustion of octane.", "confidence": 1.0, "element_id": "e000149", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 149, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "8 This is a recipe for making Irish soda bread.", "confidence": 1.0, "element_id": "e000150", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 150, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "add 170g of wholemeal flour, 170g of plain flour, 10g of salt and 10.5g of bicarbonate of soda (sodium hydrogencarbonate, $ \\mathrm{N a H C O_{3}} $ ）to a bowl and stir", "confidence": 1.0, "element_id": "e000151", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 151, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "pour in $ 2 9 0 \\mathrm{c m}^{3} $ of buttermilk and stir quickly to form a soft dough", "confidence": 1.0, "element_id": "e000152", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 152, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "form the dough into a round ball and slightly flatten it", "confidence": 1.0, "element_id": "e000153", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 153, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "cut a cross in the top and bake for 30 minutes in an oven at $ 2 0 0^{\\circ} \\mathrm{C} $", "confidence": 1.0, "element_id": "e000154", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 154, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "When sodium hydrogencarbonate is heated, it forms carbon dioxide gas.", "confidence": 1.0, "element_id": "e000155", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 155, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Calculate the mass, in grams, of carbon dioxide that would be produced by completely decomposing 10.5 g of sodium hydrogencarbonate. $ [ M_{r} $ of $ \\mathrm{N a H C O_{3}}=8 4 ] $", "confidence": 1.0, "element_id": "e000157", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 157, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "mass of carbon dioxide =", "confidence": 1.0, "element_id": "e000158", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 158, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Use your answer from part (a) to calculate the volume, in $ cm^{3} $ , at room temperature and pressure, of carbon dioxide that would be produced by completely decomposing 10.5 g of sodium hydrogencarbonate.", "confidence": 1.0, "element_id": "e000159", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 159, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Assume one mole of carbon dioxide has a volume of $ 2 4 0 0 0 \\mathrm{c m}^{3} $ at room temperature and pressure.", "confidence": 1.0, "element_id": "e000160", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 160, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "TOTAL FOR PAPER = 60 MARKS", "confidence": 1.0, "element_id": "e000163", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 163, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000164", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 164, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000165", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 165, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Every effort has been made to contact copyright holders to obtain their permission for the use of copyright material. Pearson Education Ltd. will, if notified, be happy to rectify any errors or omissions and include any such rectifications in future editions.", "confidence": 1.0, "element_id": "e000166", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 166, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "schemaVersion": "1.0"}', NULL, '2026-09-13 12:59:09.623308+00');
INSERT INTO public.documents VALUES ('dc68c04f-47f6-4eab-b751-077751f0ddf1', 'ae9e233f-1826-5a87-864e-a527fecbcaec', '1.0', 1, 'MARK_SCHEME', 'corpus/igcse-chemistry-4ch0-2c-2016jun/MS.md', 'MS.md', 'text/markdown', '7af5654149ba6ebbda3d3d86b8a87590b0a7f5b532f5b82ba51c3398077eeef8', 'SHA-256', 1, 34, 34, 12, 'glm-ocr-markdown', '1.1.0', '2026-09-13 12:58:50.520864+00', '{"pages": [{"width": null, "height": null, "pageNumber": 1}], "source": {"uri": "corpus/igcse-chemistry-4ch0-2c-2016jun/MS.md", "checksum": "7af5654149ba6ebbda3d3d86b8a87590b0a7f5b532f5b82ba51c3398077eeef8", "fileName": "MS.md", "mimeType": "text/markdown", "checksumAlgorithm": "SHA-256"}, "tables": [{"rows": [["Question number", "Answer", "Notes", "Marks"], ["1(a)", "M1(X)-(stirring/glass/plastic)rodM2(Y)-Bunsen(burner)", "Accept stirrerReject metal", "2"], ["(b)(i)(ii)", "C(solvent)B(solution)", "", "11"], ["(c)(i)(ii)", "23", "", "11"], ["(d)", "evaporated/went into the air", "accept boilsaccept turns into vapour", "1"]], "text": "Question number | Answer | Notes | Marks\n1(a) | M1(X)-(stirring/glass/plastic)rodM2(Y)-Bunsen(burner) | Accept stirrerReject metal | 2\n(b)(i)(ii) | C(solvent)B(solution) |  | 11\n(c)(i)(ii) | 23 |  | 11\n(d) | evaporated/went into the air | accept boilsaccept turns into vapour | 1", "row_count": 5, "confidence": 1.0, "element_id": "e000021", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 21, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["2(a)", "M1 iron reacted with oxygen", "Accept iron combined/bonded with oxygenAccept iron oxide formedAccept iron is oxidisedIgnore iron uses oxygenIgnore iron rustsIgnore references to reacting with water", "2"], ["M2 all oxygen is reacted/(all oxygen used up/no oxygen left", "Accept references to 20% or 20cm3of the air which is oxygen used up/reactedReject all iron used upIgnore reaction has finished", ""], ["(b)", "M1 iron(II) sulfate/iron sulfateM2 hydrogen", "reject any other oxidation state", "2"], ["", "", "", ""]], "text": "Question number | Answer | Notes | Marks\n2(a) | M1 iron reacted with oxygen | Accept iron combined/bonded with oxygenAccept iron oxide formedAccept iron is oxidisedIgnore iron uses oxygenIgnore iron rustsIgnore references to reacting with water | 2\nM2 all oxygen is reacted/(all oxygen used up/no oxygen left | Accept references to 20% or 20cm3of the air which is oxygen used up/reactedReject all iron used upIgnore reaction has finished | \n(b) | M1 iron(II) sulfate/iron sulfateM2 hydrogen | reject any other oxidation state | 2\n |  |  | ", "row_count": 5, "confidence": 1.0, "element_id": "e000022", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 22, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["(c)", "M1(Fe2+) - green precipitate/solid", "ignore shades reject other colours eg blue-green", "2"], ["M2(Fe3+) - brown precipitate/solid", "accept red-brown / orange brown Ignore rust coloured", ""], ["", "reject red on its own", ""], ["", "Allow 1 mark if both answers correct but reversed", ""], ["", "Ignore references to colours of solutions", ""]], "text": "(c) | M1(Fe2+) - green precipitate/solid | ignore shades reject other colours eg blue-green | 2\nM2(Fe3+) - brown precipitate/solid | accept red-brown / orange brown Ignore rust coloured | \n | reject red on its own | \n | Allow 1 mark if both answers correct but reversed | \n | Ignore references to colours of solutions | ", "row_count": 5, "confidence": 1.0, "element_id": "e000023", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 23, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["3(a)", "", "Ignore name and formula of compound", "1"], ["(i)", "Na/Sodium/Mg/Magnesium", "Accept aluminium", ""], ["(ii)", "Si/Silicon/P/Phosphorus/S/Sulfur/Cl/Chlorine", "If both name and formula given both must be correct", "1"], ["(b)(i)", "[Mg]2+ [:Clx]- [x:Cl]", "Allow electrons on brackets", "3"], ["", "M1 correct electronic configuration for magnesium ion and correct charge on ion", "Allow any combination of dots and crosses", ""], ["", "M2 correct electronic configuration for both chloride ions", "Allow 0 or 8 electrons in outer shell", ""], ["", "M3 correct charges on both chloride ions", "", ""], ["(ii)", "M1 electrostatic attraction/forces between ions", "M3 indep", "2"], ["", "M2 of opposite charge", "accept positive", ""]], "text": "Question number | Answer | Notes | Marks\n3(a) |  | Ignore name and formula of compound | 1\n(i) | Na/Sodium/Mg/Magnesium | Accept aluminium | \n(ii) | Si/Silicon/P/Phosphorus/S/Sulfur/Cl/Chlorine | If both name and formula given both must be correct | 1\n(b)(i) | [Mg]2+ [:Clx]- [x:Cl] | Allow electrons on brackets | 3\n | M1 correct electronic configuration for magnesium ion and correct charge on ion | Allow any combination of dots and crosses | \n | M2 correct electronic configuration for both chloride ions | Allow 0 or 8 electrons in outer shell | \n | M3 correct charges on both chloride ions |  | \n(ii) | M1 electrostatic attraction/forces between ions | M3 indep | 2\n | M2 of opposite charge | accept positive | ", "row_count": 10, "confidence": 1.0, "element_id": "e000024", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 24, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["(iii)", "M1 attraction (between ions) is strong\nM2 lots of ions (in structure)/giant structure/lattice/lots of/many bonds\nM3 (therefore) lot of (thermal/heat) energy required to overcome attraction/to break down the lattice", "and negative ions accept cations and anions M2 dep on M1 Accept attraction/forces between oppositely charged ions for 1 mark only\nReject references to atoms/molecules/IMF for M1 and M2\nAccept strong (ionic) bonding/strong (ionic) bonds\nAccept lot of (thermal/heat) energy required to break (ionic) bonds\nIf any reference to attraction between atoms/molecules/electrons scores 0/3\nIf any reference to covalent bonding/covalent structure/IMF scores 0/3", "3"], ["(c)", "", "Correct answer with or without working scores 2 marks", "2"]], "text": "(iii) | M1 attraction (between ions) is strong\nM2 lots of ions (in structure)/giant structure/lattice/lots of/many bonds\nM3 (therefore) lot of (thermal/heat) energy required to overcome attraction/to break down the lattice | and negative ions accept cations and anions M2 dep on M1 Accept attraction/forces between oppositely charged ions for 1 mark only\nReject references to atoms/molecules/IMF for M1 and M2\nAccept strong (ionic) bonding/strong (ionic) bonds\nAccept lot of (thermal/heat) energy required to break (ionic) bonds\nIf any reference to attraction between atoms/molecules/electrons scores 0/3\nIf any reference to covalent bonding/covalent structure/IMF scores 0/3 | 3\n(c) |  | Correct answer with or without working scores 2 marks | 2", "row_count": 2, "confidence": 1.0, "element_id": "e000025", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 25, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["", "M1 mol Al=20/3(=6.67)\nM2 mass Al=(answer to M1x27)=180(g)\nOR\nM1 3 faradays give 1 mol OR 27g/30 faradays give 10 mol OR 270g\nM2 20 faradays gives 180(g)", "M2 CQ on M1\neg 540 scores\n1 mark\n6.67 gives\n180(.09)\nscores 2 marks\n6.7 gives\n180.9=181\nscores 2 marks\n6.66 gives\n179.82 scores\nM2 only\nAccept any number of sig fig except 1", ""]], "text": " | M1 mol Al=20/3(=6.67)\nM2 mass Al=(answer to M1x27)=180(g)\nOR\nM1 3 faradays give 1 mol OR 27g/30 faradays give 10 mol OR 270g\nM2 20 faradays gives 180(g) | M2 CQ on M1\neg 540 scores\n1 mark\n6.67 gives\n180(.09)\nscores 2 marks\n6.7 gives\n180.9=181\nscores 2 marks\n6.66 gives\n179.82 scores\nM2 only\nAccept any number of sig fig except 1 | ", "row_count": 1, "confidence": 1.0, "element_id": "e000026", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 26, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["4(a)", "CuO+2HNO3→Cu(NO3)2+H2O", "Ignore state symbols", "1"], ["(b)(i)", "to increase the rate of reaction", "ignore references to dissolving/solubility", "1"], ["(b)(ii)", "(copper(II) oxide/it) stops disappearing/stays as a solid/forms as a solid(at the bottom of the beaker)", "Accept stops dissolving/forms a suspension/forms a residueAccept when copper oxide remains/settles in the beakerAllow liquid goes cloudy/blackIgnore references to stops reacting ignore references to bubbling", "1"], ["(iii)", "a drop of solution forms crystals when removed(and cooled)", "Accept when crystals start to form/start to be seenReject if all water evaporated", "1"], ["(iv)", "(stage)3", "accept any reference to first filtration stage", "1"]], "text": "Question number | Answer | Notes | Marks\n4(a) | CuO+2HNO3→Cu(NO3)2+H2O | Ignore state symbols | 1\n(b)(i) | to increase the rate of reaction | ignore references to dissolving/solubility | 1\n(b)(ii) | (copper(II) oxide/it) stops disappearing/stays as a solid/forms as a solid(at the bottom of the beaker) | Accept stops dissolving/forms a suspension/forms a residueAccept when copper oxide remains/settles in the beakerAllow liquid goes cloudy/blackIgnore references to stops reacting ignore references to bubbling | 1\n(iii) | a drop of solution forms crystals when removed(and cooled) | Accept when crystals start to form/start to be seenReject if all water evaporated | 1\n(iv) | (stage)3 | accept any reference to first filtration stage | 1", "row_count": 6, "confidence": 1.0, "element_id": "e000027", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 27, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Mark"], ["5(a)(i)", "M1(compounds/molecules with the) same molecular formula/same number of each type of atom", "Ignore references to chemical/general/empirical formulaIf use elements/atoms instead of compounds/molecules can score M2 onlyAllow reference to isomers in question ie have same number of carbon and hydrogen (atoms as each other)", "2"], ["(ii)", "M2but different displayed formula/structural formula/structures/arrangement of atoms", "Ignore atoms in different orderIgnore references to stereoisomerism", "1"], ["(iii)", "Any one for 1 mark", "Accept structure of trans but-2-eneIgnore bond angles", "3"], ["", "M1(Reagent)-bromine(water)", "accept decolourisedIgnore clear/discolours", ""], ["", "M2(But-1-ene)-goes(from orange)to colourless", "accept stays orangeignore no reaction", ""], ["", "M3(cyclobutane)-no change(unless UV light present)", "If start with bromine(water)in presence of UV light then scores0/3", ""]], "text": "Question number | Answer | Notes | Mark\n5(a)(i) | M1(compounds/molecules with the) same molecular formula/same number of each type of atom | Ignore references to chemical/general/empirical formulaIf use elements/atoms instead of compounds/molecules can score M2 onlyAllow reference to isomers in question ie have same number of carbon and hydrogen (atoms as each other) | 2\n(ii) | M2but different displayed formula/structural formula/structures/arrangement of atoms | Ignore atoms in different orderIgnore references to stereoisomerism | 1\n(iii) | Any one for 1 mark | Accept structure of trans but-2-eneIgnore bond angles | 3\n | M1(Reagent)-bromine(water) | accept decolourisedIgnore clear/discolours | \n | M2(But-1-ene)-goes(from orange)to colourless | accept stays orangeignore no reaction | \n | M3(cyclobutane)-no change(unless UV light present) | If start with bromine(water)in presence of UV light then scores0/3 | ", "row_count": 7, "confidence": 1.0, "element_id": "e000028", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 28, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["", "", "", ""], ["(b)(i)", "Chemical structure of a repeat unit of a carbon to carbon single bond OR Chemical structure of a repeat unit of a carbon to carbon single bond", "Allow -O-H and -OH but not -HO", "1"], ["(ii)", "M1 correct formula of repeat unit (with carbon to carbon single bond)M2 brackets and continuation bonds and n", "Accept displayed C2H5Accept C2H5 on either CAllow if more than one monomer correctly joined togetherAccept n anywhere after brackets but not beforeM2 dep on M1or near miss", "2"]], "text": " |  |  | \n(b)(i) | Chemical structure of a repeat unit of a carbon to carbon single bond OR Chemical structure of a repeat unit of a carbon to carbon single bond | Allow -O-H and -OH but not -HO | 1\n(ii) | M1 correct formula of repeat unit (with carbon to carbon single bond)M2 brackets and continuation bonds and n | Accept displayed C2H5Accept C2H5 on either CAllow if more than one monomer correctly joined togetherAccept n anywhere after brackets but not beforeM2 dep on M1or near miss | 2", "row_count": 3, "confidence": 1.0, "element_id": "e000029", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 29, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["6(a)", "titration / volumetric analysis", "", "1"], ["(b)", "C(25cm3pipette)", "", "1"], ["(c)", "M1(before)-yellowM2(after)-orange", "accept pink/red and combinations with orangeAllow 1 mark if correct colours reversed", "2"], ["(d)", "after adding acid", "23.60", "", "If readings are correct but in the wrong order, award 1 mark for M1 and M2M3 CQ on(M1-M2)", "3"], ["before adding acid", "2.75"], ["volume added", "20.85"], ["M12.75M320.85"], ["(e)(i)(ii)", "22.90", "22.60", "22.45", "22.55", "Correct final answer with no working scores(2)Accept 22.53 with 3 recurringIf no results ticked in(i),then only use of two or three concordant titres can score in(ii)If only one result ticked,then no marks can be scored in(ii)Otherwise,both marks CQ on ticked results in(e)(i)Answer with zero as2nd dp does not need trailing zero", "1"], ["", "√", "√", "√", "2"], ["M1(22.60+22.45+22.55)÷3M222.53(cm3)", ""]], "text": "Question number | Answer | Notes | Marks\n6(a) | titration / volumetric analysis |  | 1\n(b) | C(25cm3pipette) |  | 1\n(c) | M1(before)-yellowM2(after)-orange | accept pink/red and combinations with orangeAllow 1 mark if correct colours reversed | 2\n(d) | after adding acid | 23.60 |  | If readings are correct but in the wrong order, award 1 mark for M1 and M2M3 CQ on(M1-M2) | 3\nbefore adding acid | 2.75\nvolume added | 20.85\nM12.75M320.85\n(e)(i)(ii) | 22.90 | 22.60 | 22.45 | 22.55 | Correct final answer with no working scores(2)Accept 22.53 with 3 recurringIf no results ticked in(i),then only use of two or three concordant titres can score in(ii)If only one result ticked,then no marks can be scored in(ii)Otherwise,both marks CQ on ticked results in(e)(i)Answer with zero as2nd dp does not need trailing zero | 1\n | √ | √ | √ | 2\nM1(22.60+22.45+22.55)÷3M222.53(cm3) | ", "row_count": 11, "confidence": 1.0, "element_id": "e000030", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 30, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["", "", "Answers obtained by averaging other titre values do require answers to 2 dp", ""]], "text": " |  | Answers obtained by averaging other titre values do require answers to 2 dp | ", "row_count": 1, "confidence": 1.0, "element_id": "e000031", "page_