INSERT INTO public.questions VALUES ('7c7174aa-6974-44f9-92ff-bbd2d7061212', 'q03-29fe818b', 'STRUCTURED', 'A group of students planned an experiment to find the temperature rise in a neutralisation reaction. This is their method. Use a measuring cylinder to add $ 2 5 \mathrm{c m}^{3} $ of an alkali to a $ 1 0 0 \mathrm{c m}^{3} $ beaker Record the temperature of the alkali Use a burette to add an acid to the alkali in 5.0 $ cm^{3} $ portions Record the temperature of the mixture after adding each portion of acid Stop the experiment when the neutralisation is complete', 19, 3, 1710, NULL, '635c9130-a5df-4966-be44-bddd95bd9533', 'PAST_PAPER', true, 1, '2026-09-13 12:57:42.115923+00', 'b5dab6f0-c089-4a69-a790-7ae78afbbf65');
INSERT INTO public.questions VALUES ('38514e30-c99e-4b64-bb73-b860ff2e6cb5', 'q04-29fe818b', 'STRUCTURED', 'There are two important ways to manufacture ethanol. Reaction 1 $\mathrm {C} _ {2} \mathrm {H} _ {4} + \mathrm {H} _ {2} \mathrm {O} \rightarrow \mathrm {C} _ {2} \mathrm {H} _ {5} \mathrm {O H}$ Reaction 2 $C _ {6} H _ {1 2} O _ {6} \rightarrow 2 C _ {2} H _ {5} O H + 2 C O _ {2}$', 8, 3, 720, NULL, '635c9130-a5df-4966-be44-bddd95bd9533', 'PAST_PAPER', true, 1, '2026-09-13 12:57:42.117755+00', 'b5dab6f0-c089-4a69-a790-7ae78afbbf65');
