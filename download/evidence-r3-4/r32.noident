INSERT INTO public.question_parts VALUES ('6ac0d107-7367-495f-9963-10c53a5b76c4', '30abad1d-06a6-4644-a920-b0924993ee16', 'a-ii', 'Identify which of these fractions has the highest boiling point.', NULL, 0, 2, '2026-09-13 12:53:12.066629+00');
INSERT INTO public.question_parts VALUES ('821796c7-8f8a-4346-bdff-77634dc33cb4', '30abad1d-06a6-4644-a920-b0924993ee16', 'a-iii', 'Identify which of these fractions contains molecules with the fewest carbon atoms.', NULL, 0, 3, '2026-09-13 12:53:12.066634+00');
INSERT INTO public.question_parts VALUES ('103fdebd-98a9-45df-9f96-89a6cc52f430', '30abad1d-06a6-4644-a920-b0924993ee16', 'b', 'Cracking involves heating some of the fractions to about $ 6 5 0 \, \mathrm{^ \circ C} $', NULL, 0, 4, '2026-09-13 12:53:12.066637+00');
INSERT INTO public.question_parts VALUES ('5ead3217-28c6-4b86-ac8b-73a71a0bc1e4', '30abad1d-06a6-4644-a920-b0924993ee16', 'b-i', 'Name a catalyst used in industry for cracking.', NULL, 0, 5, '2026-09-13 12:53:12.066643+00');
INSERT INTO public.question_parts VALUES ('9ee9c5a3-4c4d-4e73-a6da-18d09a294049', '30abad1d-06a6-4644-a920-b0924993ee16', 'b-ii', 'One reaction that occurs in cracking involves the conversion of one molecule of hexadecane into one molecule of octane and two molecules of an alkene. Complete the equation for this reaction. $\mathrm {C} _ {1 6} \mathrm {H} _ {3 4} \rightarrow \mathrm {C} _ {8} \mathrm {H} _ {1 8} +$', NULL, 0, 6, '2026-09-13 12:53:12.066647+00');
