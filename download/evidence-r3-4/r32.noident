INSERT INTO public.question_parts VALUES ('a45f58b5-24c3-4192-ae44-3440921e2631', 'b6e3c846-1b22-43b7-809e-4f42a92c7887', 'c-iii', 'In an experiment using different solutions, the mass of silver chloride produced is 0.744 g. The maximum mass of silver chloride that could be produced is 0.850 g. Calculate the percentage yield.', NULL, 0, 9, '2026-09-13 13:01:26.268353+00');
