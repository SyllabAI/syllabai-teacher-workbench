INSERT INTO public.question_parts VALUES ('7aa24b62-c902-4d9c-ba74-bf8523875aa1', 'a02c8e04-e48e-4469-b411-9a527a540a01', 'd', 'Aluminium reacts with iron(III) oxide. The reaction is exothermic. $2 \mathrm {A l} + \mathrm {F e} _ {2} \mathrm {O} _ {3} \rightarrow \mathrm {A l} _ {2} \mathrm {O} _ {3} + 2 \mathrm {F e}$ The equation for the reaction is', NULL, 0, 8, '2026-09-13 13:01:26.267932+00');
INSERT INTO public.question_parts VALUES ('69c64e32-53ba-4aa1-a537-7b42c748bc48', 'a02c8e04-e48e-4469-b411-9a527a540a01', 'd-i', 'State how the equation shows that iron(III) oxide is reduced.', NULL, 0, 9, '2026-09-13 13:01:26.267954+00');
