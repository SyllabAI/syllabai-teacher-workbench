INSERT INTO public.questions VALUES ('3e242268-67aa-41ba-809d-d3dc92ee4f95', 'q04-2f82da9d', 'STRUCTURED', 'The maximum mass of a solid that dissolves in 100g of water at a given temperature is called its solubility. The table gives the solubility of potassium nitrate at six different temperatures.', 7, 3, 630, NULL, '4db63338-5d31-45b9-87ca-c5e5ae693ae1', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.392429+00', '5cd177ba-bfaf-4adc-8e89-e65c40880fe3');
