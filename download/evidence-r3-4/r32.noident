INSERT INTO public.question_parts VALUES ('596350ea-846d-471d-bef0-a6b51dcc8c62', 'ca276482-b38b-4c33-b7b9-4ec8f3aa78bb', 'a-ii', 'Why is mass lost from the flask? A acid particles are moving B gas is given off heat energy is produced D marble chips are dissolving', NULL, 0, 2, '2026-09-13 12:54:40.215565+00');
INSERT INTO public.question_parts VALUES ('3e7f0f7d-2cfd-4810-9824-2bc78cf2bfac', 'ca276482-b38b-4c33-b7b9-4ec8f3aa78bb', 'b', 'This is the equation for the reaction between marble chips and dilute hydrochloric acid. Complete the equation by adding the state symbols. $\mathrm {C a C O} _ {3} (\dots \dots \dots \dots) + 2 \mathrm {H C l} (\dots \dots \dots \dots) \rightarrow \mathrm {C a C l} _ {2} (\dots \dots \dots \dots) + \mathrm {H} _ {2} \mathrm {O} (\dots \dots \dots \dots) + \mathrm {C O} _ {2} (\dots \dots \dots \dots)$', NULL, 0, 3, '2026-09-13 12:54:40.215592+00');
INSERT INTO public.question_parts VALUES ('ef4dbaf5-d820-4e8a-ac12-3416ea0bc372', 'ca276482-b38b-4c33-b7b9-4ec8f3aa78bb', 'c', 'The student uses large marble chips in the investigation. This is a graph of his results. The student repeats the experiment using the same total mass of smaller marble chips. On the graph, draw the curve that would be obtained. [assume the marble chips are in excess]', NULL, 0, 4, '2026-09-13 12:54:40.215612+00');
INSERT INTO public.question_parts VALUES ('50389b3a-3595-4b09-b342-733dca78ea02', 'ca276482-b38b-4c33-b7b9-4ec8f3aa78bb', 'd', 'The rate of this reaction can be altered by increasing the temperature or by increasing the concentration of the hydrochloric acid.', NULL, 0, 5, '2026-09-13 12:54:40.21564+00');
