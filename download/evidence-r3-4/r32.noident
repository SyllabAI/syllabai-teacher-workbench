INSERT INTO public.question_parts VALUES ('114abbd0-4d75-4e0d-a551-5fdbddc0b9f8', '6ac047eb-80ed-443d-b954-fa43a0bce7c5', 'b-ii', 'Which of these colour changes occurs during the reaction? A green to orange B orange to green C red to yellow D yellow to red', NULL, 0, 3, '2026-09-13 13:02:54.084219+00');
