INSERT INTO public.question_versions VALUES ('f4db1693-0faf-44aa-9f28-8499c3cf2a98', 'bde20c53-5ea6-4ea7-8cdf-832cac442997', 1, 'The diagram shows how hydrated copper(II) sulfate crystals can be made by reacting copper(II) oxide with dilute sulfuric acid. filter the mixture from stage 2 stage 4 heat the solution from stage 3 until a hot, saturated solution forms allow the solution to cool so that hydrated copper(II) sulfate crystals form', 6, 3, 540, NULL, 'SUGGESTED', '87d9135e-d9af-5b60-b2f3-82bc89ba5a1a', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:26.060391+00');
