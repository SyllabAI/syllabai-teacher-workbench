INSERT INTO public.question_versions VALUES ('9907ec9b-d7b8-4624-a28f-9e2592538bca', 'a2aa05e1-9c94-495d-aa4e-2a37c15d3557', 1, 'This question is about the reactions of calcium and some calcium compounds.', 7, 3, 630, NULL, 'SUGGESTED', 'f4948ec0-cbe0-5f7e-982e-278246156fda', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:11.816898+00');
INSERT INTO public.question_versions VALUES ('0b546ebb-4f79-4d99-ade4-72637941be94', '7e0d261e-b17b-4c93-9c84-4cb26e1958e2', 1, 'The apparatus in the diagram is used to heat a sample of hydrated copper(II) sulfate crystals, $ \mathrm{C u S O_{4}. 5 H_{2} O} $ The equation for the reaction that takes place is $\mathrm {C u S O} _ {4}. 5 \mathrm {H} _ {2} \mathrm {O} (\mathrm {s}) \rightarrow \mathrm {C u S O} _ {4} (\mathrm {s}) + 5 \mathrm {H} _ {2} \mathrm {O} (\mathrm {l})$ hydrated copper(ll) sulfate', 1, 3, 90, NULL, 'SUGGESTED', 'f4948ec0-cbe0-5f7e-982e-278246156fda', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:11.817137+00');
INSERT INTO public.question_versions VALUES ('e2d79313-4462-40ac-9204-ce2f3a476256', '468420c1-4282-425a-bc93-d28bac77b05a', 1, 'Hydrogen iodide can be manufactured from its elements using this reaction. $\mathrm {H} _ {2} (\mathrm {g}) + \mathrm {I} _ {2} (\mathrm {g}) \rightleftharpoons 2 \mathrm {H I} (\mathrm {g}) \quad \Delta H = - 9 \mathrm {k J / m o l}$ A temperature of $ 5 0 0^{\circ} \mathrm{C} $ a pressure of 4 atm and a platinum catalyst are used in this manufacturing process.', 9, 3, 810, NULL, 'SUGGESTED', '8346f04a-82a1-548a-b78c-481bca57fb37', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:55.925426+00');
INSERT INTO public.question_versions VALUES ('e15a8e76-0c51-41b7-b544-b479f39aceff', '04115bd5-d24d-4be6-ae0c-60048a2df44d', 1, 'A student investigates the reaction of aqueous sodium hydroxide with two different aqueous solutions of hydrochloric acid, solution X and solution Y. She carries out two experiments. Experiment 1 Using a measuring cylinder, she pours 20 $ cm^{3} $ of aqueous sodium hydroxide into a conical flask and records its temperature. Using a burette, she adds 5 $ cm^{3} $ of solution X to the conical flask. She stirs the mixture with the thermometer and records the temperature. She adds further 5 $ cm^{3} $ volumes of solution X and stirs with the thermometer. She records the temperature after each addition of solution X. She stops when a total of $ 4 0 \mathrm{c m}^{3} $ of solution X has been added. She empties the burette and rinses it first with water and then with solution Y. She then fills the burette with solution Y. She repeats the experiment using solution Y. The table shows the results she obtains in Experiment 1.', 9, 3, 810, NULL, 'SUGGESTED', 'f4948ec0-cbe0-5f7e-982e-278246156fda', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:11.817314+00');
INSERT INTO public.question_versions VALUES ('f5c64e2e-5dac-4ed4-ba78-dc7334909ebb', 'ff57b076-9961-4809-862f-50121fe76a74', 1, 'This question is about hydrochloric acid.', 1, 3, 90, NULL, 'SUGGESTED', 'f4948ec0-cbe0-5f7e-982e-278246156fda', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:11.81749+00');
