r": 120, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {C} _ {\\mathrm {n}} \\mathrm {H} _ {2 \\mathrm {n}} + \\mathrm {o x y g e n} \\rightarrow \\mathrm {c a r b o n d i o x i d e} + \\mathrm {n H} _ {2} \\mathrm {O}", "latex": "\\mathrm {C} _ {\\mathrm {n}} \\mathrm {H} _ {2 \\mathrm {n}} + \\mathrm {o x y g e n} \\rightarrow \\mathrm {c a r b o n d i o x i d e} + \\mathrm {n H} _ {2} \\mathrm {O}", "confidence": 1.0, "element_id": "e000139", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 139, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {C} _ {7} \\mathrm {H} _ {1 6} + 1 1 \\mathrm {O} _ {2} \\rightarrow 7 \\mathrm {C O} _ {2} + 8 \\mathrm {H} _ {2} \\mathrm {O}", "latex": "\\mathrm {C} _ {7} \\mathrm {H} _ {1 6} + 1 1 \\mathrm {O} _ {2} \\rightarrow 7 \\mathrm {C O} _ {2} + 8 \\mathrm {H} _ {2} \\mathrm {O}", "confidence": 1.0, "element_id": "e000147", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 147, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {C a} \\left(\\mathrm {N O} _ {3}\\right) _ {2} \\rightarrow \\mathrm {C a O} + \\mathrm {N O} _ {2} + \\mathrm {O} _ {2}", "latex": "\\mathrm {C a} \\left(\\mathrm {N O} _ {3}\\right) _ {2} \\rightarrow \\mathrm {C a O} + \\mathrm {N O} _ {2} + \\mathrm {O} _ {2}", "confidence": 1.0, "element_id": "e000173", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 173, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "pageCount": 1, "documentId": "c98f5542-e243-59b9-af1b-93357fe393ff", "provenance": {"engine": "glm-ocr-markdown", "application": "syllabai-parser", "extractedAt": "2026-09-13T12:56:36.608692489Z", "engineVersion": "1.1.0", "schemaVersion": "1.0", "extractionParams": {"pageBoundaries": "none-in-source", "sourceLineCount": 289, "upstreamConverte