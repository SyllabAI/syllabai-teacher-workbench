INSERT INTO public.document_chunks VALUES ('35d3a780-3550-4678-9380-c8cf944cbe97', '7370a5be-60c7-4780-a488-5ea4ce8959e8', 3, '$ ^{*} $ The lanthanoids (atomic numbers 58-71) and the actinoids (atomic numbers 90-103) have been omitted
