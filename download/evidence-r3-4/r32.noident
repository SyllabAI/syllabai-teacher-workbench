: "allow", "text": "ALLOW burette/pipette/syringe"}, {"kind": "note", "text": "REJECT gas syringe"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "(the) zinc/Zn/it is in excess"}, {"kind": "note", "text": "(iii)"}, {"kind": "note", "text": "so as little gas as possible is lost"}, {"kind": "note", "text": "ACCEPT to keep as much gas as possible"}, {"kind": "allow", "text": "ALLOW to avoid loss of gas/so gas does not escape"}, {"kind": "note", "text": "(iv)"}, {"kind": "note", "text": "any one from"}, {"kind": "note", "text": "no further effervescence/bubbles/fizzing"}, {"kind": "note", "text": "no more gas collects in the syringe"}, {"kind": "allow", "text": "ALLOW gas syringe does not move"}, {"kind": "note", "text": "(b)(i)"}, {"kind": "note", "text": "(i)"}, {"kind": "note", "text": "M1 calculation of gradient OR 50÷150"}, {"kind": "note", "text": "triangle needs to be drawn on graph for M1"}, {"kind": "note", "text": "M2 0.33"}, {"kind": "allow", "text": "ALLOW ECF from M1"}, {"kind": "note", "text": "M3 units cm3/s"}, {"kind": "note", "text": "ACCEPT cm3s-1"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "from 0 to 60 s"}, {"kind": "note", "text": "M1 gradient is steepest"}, {"kind": "note", "text": "M2 because there are most acid particles(per unit volume)/most collisions(per unit time)/most frequent collisions"}, {"kind": "note", "text": "ACCEPT because concentration is greatest/highest"}, {"kind": "note", "text": "from 60 to 150 s"}, {"kind": "note", "text": "M3 the curve becomes less steep"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "M4 because there are fewer particles(per unit volume)/fewer collisions(per unit time)/fewer frequent collisions"}, {"kind": "note", "text": "ACCEPT because concentration is lower"}, {"kind": "note", "text": "from 150 to 240 s"}, {"kind": "note", "text": "M5 the reaction has stopped/curve levels off/becomes flat/plateaus"}, {"kind": "allow", "text": "ALLOW the volume of gas becomes constant"}, {"kind": "note", "text": "M6 because the(sulfuric) acid has been used up"}], "answerText": "(a)(i)", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "8(a)", "marks": 4, "number": 8, "entryId": "ms-a47b8ff7-q8a", "guidance": [{"kind": "note", "text": "M1 crude oil is heated / vapourised"}, {"kind": "allow", "text": "ALLOW boiled"}, {"kind": "note", "text": "M2 the vapour enters the lower part / bottom of the column"}, {"kind": "note", "text": "ACCEPT cooler at the top and hotter at the bottom"}, {"kind": "note", "text": "M3 there is a temperature gradient in the column"}, {"kind": "note", "text": "M4 the vapours rise up the column until they condense"}, {"kind": "allow", "text": "ALLOW the fractions are separated according to their boiling point"}, {"kind": "note", "text": "(b)"}, {"kind": "note", "text": "an explanation that links any 4 of the following points"}, {"kind": "note", "text": "M1 fractional distillation of crude oil produces more long chain hydrocarbons than can be used directly"}, {"kind": "allow", "text": "ALLOW is a lower demand for long chain hydrocarbons / a higher demand for short chain hydrocarbons"}, {"kind": "note", "text": "M2 (cracking) produces shorter (chain) alkanes"}, {"kind": "allow", "text": "ALLOW petrol / gasoline"}, {"kind": "note", "text": "M3 which are more flammable / more useful as fuels"}, {"kind": "note", "text": "M3 dep on M2"}, {"kind": "note", "text": "M4 (cracking) produces alkenes"}, {"kind": "note", "text": "(c)"}, {"kind": "note", "text": "M5 which are used to make polymers/plastics"}, {"kind": "note", "text": "M5 dep on M4"}, {"kind": "note", "text": "M1 fuels contain sulfur"}, {"kind": "ignore", "text": "IGNORE C / CO / CO2 and any reference to global warming etc."}, {"kind": "note", "text": "M2 which burns producing sulfur dioxide"}, {"kind": "note", "text": "REJECT nitrogen for M1"}, {"kind": "note", "text": "M3 causing acid 