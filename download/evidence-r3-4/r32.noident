INSERT INTO public.question_parts VALUES ('6fdd646d-0dda-43d4-86cf-9f2eb3bc5689', '2e118484-350f-4661-8ba4-175d03ef7f84', 'a', 'Why is it important that the platinum wire is clean?', NULL, 0, 0, '2026-09-13 12:52:25.611997+00');
INSERT INTO public.question_parts VALUES ('45cbe9cb-2497-4072-a766-1d08080b1a75', '9561465e-65fb-4c6c-b9f7-86642ac63318', 'c-i', 'There is no colour change during this reaction. Suggest one observation, other than the change in temperature, that could be made during the reaction.', NULL, 0, 3, '2026-09-13 12:52:25.373522+00');
INSERT INTO public.question_parts VALUES ('c81409db-cbf3-4115-81d9-5f9fde7e16e3', '9561465e-65fb-4c6c-b9f7-86642ac63318', 'c-ii', 'The compound $ \mathrm{C H_{3} C O O H} $ is an acid and the compound $ \mathrm{C H_{3} C O O N a} $ is a salt. The graph shows that the temperature goes down during the reaction. Use this information to state the two types of reaction occurring.', NULL, 0, 4, '2026-09-13 12:52:25.373559+00');
INSERT INTO public.question_parts VALUES ('1070662f-66b9-4709-86b9-bdc7fb974583', '9561465e-65fb-4c6c-b9f7-86642ac63318', 'd', 'Complete the energy level diagram by showing the products of the reaction. $\text{Energy} \xrightarrow {\mathrm {C H} _ {3} \mathrm {C O O H} + \mathrm {N a H C O} _ {3}}$', NULL, 0, 5, '2026-09-13 12:52:25.373587+00');
INSERT INTO public.question_parts VALUES ('80b8bb90-2c0b-4d12-a44e-fd4b730d3b32', '9561465e-65fb-4c6c-b9f7-86642ac63318', 'd-ii', 'Label the diagram to show the energy change, $ \Delta H $ , for the reaction.', NULL, 0, 6, '2026-09-13 12:52:25.373627+00');
INSERT INTO public.question_parts VALUES ('ba593284-6090-4625-8cc9-f541f14ed0f7', '9561465e-65fb-4c6c-b9f7-86642ac63318', 'e', 'The student repeated the experiment using the same method with a different sample of vinegar. She recorded these results. $\text{Volume of vinegar} = 1 0 0 \mathrm {c m} ^ {3}$ $\mathrm {M a s s o f b a k i n g s o d a} = 5. 0 \mathrm {g}$ $\text{Temperature at start} = 1 8. 7 ^ {\circ} \mathrm {C}$ $\text{Temperature at end} = 1 3. 2 ^ {\circ} \mathrm {C}$', NULL, 0, 7, '2026-09-13 12:52:25.373655+00');
INSERT INTO public.question_parts VALUES ('e09df9f3-1d95-4624-a9b0-91d2fe5c4555', '9561465e-65fb-4c6c-b9f7-86642ac63318', 'e-i', 'Calculate the heat energy change in this experiment using the expression heat energy change = volume of vinegar $ \times4.2\times $ temperature change', NULL, 0, 8, '2026-09-13 12:52:25.373691+00');
INSERT INTO public.question_parts VALUES ('045489ba-9409-4683-ac37-0c26ccbe138b', '9561465e-65fb-4c6c-b9f7-86642ac63318', 'e-ii', 'The student wanted to calculate the amount, in moles, of ethanoic acid in the vinegar. Apart from the volume of vinegar, what other information would she need to be able to calculate the amount of ethanoic acid?', NULL, 0, 9, '2026-09-13 12:52:25.37374+00');
INSERT INTO public.question_parts VALUES ('63308763-f450-4198-87f0-5ab02b4a151a', 'b9f97fb4-68b2-4a4d-809a-227a80e6a222', 'a', 'The students tried to keep the amount of calcium carbonate constant by using the same number of marble chips in each experiment. State two other properties of the marble chips that should be the same in each experiment.', NULL, 0, 0, '2026-09-13 12:52:25.373781+00');
INSERT INTO public.question_parts VALUES ('c177a0b9-2d8a-418b-bfaf-5da1a990e9cc', 'b9f97fb4-68b2-4a4d-809a-227a80e6a222', 'b', 'The table shows how some of the students wrote down their results. The teacher said that she could only use the results from student 1 because the other students had not recorded enough information. Identify the piece of information that each student failed to record. Student 2 Student 3 Student 4 Student 5', NULL, 0, 1, '2026-09-13 12:52:25.373803+00');
INSERT INTO public.question_parts VALUES ('2a300713-6c91-475e-afdc-304aba499533', 'b9f97fb4-68b2-4a4d-809a-227a80e6a222', 'c', 'The students repeated the experiment to make sure that it was a fair test. They used a different supply of hydrochloric acid. They all measured the time to collect $ 1 0 0 \mathrm{c m}^{3} $ of carbon dioxide and calculated the rate of each reaction. Their results are shown in the table.', NULL, 0, 2, '2026-09-13 12:52:25.37383+00');
INSERT INTO public.question_parts VALUES ('7b68c402-e21e-49d7-8cfb-8b888083f1f7', 'b9f97fb4-68b2-4a4d-809a-227a80e6a222', 'c-i', 'Plot these results on the grid and draw a straight line of best fit. Rate of reaction in $ \mathrm{c m^{3}/s} $', NULL, 0, 3, '2026-09-13 12:52:25.373854+00');
INSERT INTO public.question_parts VALUES ('6ceffc88-4d86-4496-9a66-afbd133abdee', 'b9f97fb4-68b2-4a4d-809a-227a80e6a222', 'c-ii', 'One of the points is anomalous. Circle this point on the graph.', NULL, 0, 4, '2026-09-13 12:52:25.37388+00');
INSERT INTO public.question_parts VALUES ('44bf8c19-368d-470e-ac62-ac0a457b6c7e', 'b9f97fb4-68b2-4a4d-809a-227a80e6a222', 'c-iii', 'Suggest two errors in the experiment that could have caused this anomalous result.', NULL, 0, 5, '2026-09-13 12:52:25.373906+00');
INSERT INTO public.question_parts VALUES ('ebe9c4a1-3efb-47a4-b14a-8f85db9b6e2a', 'b9f97fb4-68b2-4a4d-809a-227a80e6a222', 'c-iv', 'Use your graph to estimate the rate of reaction using an acid concentration of 50%. Show on your graph how you obtained your answer.', NULL, 0, 6, '2026-09-13 12:52:25.37393+00');
INSERT INTO public.question_parts VALUES ('5e68db7f-3dd7-4d71-9407-1e81657b5379', '7efc1af6-3fd9-4491-8f97-445c14b800cf', 'a', 'Give the name of the most suitable piece of apparatus in the diagram that should be used in Step 1.', NULL, 0, 0, '2026-09-13 12:52:25.373961+00');
INSERT INTO public.question_parts VALUES ('24f5f5eb-fc09-489c-b345-347978c0f5c9', '7efc1af6-3fd9-4491-8f97-445c14b800cf', 'a-ii', 'Give the name of the piece of apparatus in the diagram that should be used instead of a measuring cylinder in Step 2.', NULL, 0, 1, '2026-09-13 12:52:25.37399+00');
INSERT INTO public.question_parts VALUES ('7c367ca6-bb25-4e1b-a5a3-f7169dc3e25c', '7efc1af6-3fd9-4491-8f97-445c14b800cf', 'a-iii', 'State why universal indicator is not a good choice for this experiment and suggest an indicator that would be more suitable.', NULL, 0, 2, '2026-09-13 12:52:25.374013+00');
INSERT INTO public.question_parts VALUES ('9e8f84c1-b6ff-43bc-bfb2-2016bc3739bf', '7efc1af6-3fd9-4491-8f97-445c14b800cf', 'a-iv', 'Why is a pipette not suitable for adding the acid in Step 4?', NULL, 0, 3, '2026-09-13 12:52:25.374039+00');
INSERT INTO public.question_parts VALUES ('ee3d8a3a-bf05-48a8-849a-6b5224a2c45d', '7efc1af6-3fd9-4491-8f97-445c14b800cf', 'b', 'The diagram shows the burette readings in one experiment before and after adding the acid. Use the readings to complete the table, entering all values to the nearest 0.05 $ cm^{3}. $', NULL, 0, 4, '2026-09-13 12:52:25.374058+00');
INSERT INTO public.question_parts VALUES ('9401e867-c9d4-4521-b4fb-1efab935cfca', '7efc1af6-3fd9-4491-8f97-445c14b800cf', 'c', 'The student repeated the experiment using a different concentration of sodium hydroxide solution and recorded these results. The volumes of acid added during these titrations are not all the same. The average (mean) volume of acid should be calculated using only concordant results. Concordant results are those volumes that differ from each other by 0.20 $ cm^{3} $ or less.', NULL, 0, 5, '2026-09-13 12:52:25.374082+00');
INSERT INTO public.question_parts VALUES ('45c49c33-35b9-461b-b359-ab89c6b7d8d0', '7efc1af6-3fd9-4491-8f97-445c14b800cf', 'c-i', 'Identify the concordant results by placing ticks ( $ \checkmark $ ) in the table where appropriate.', NULL, 0, 6, '2026-09-13 12:52:25.37417+00');
INSERT INTO public.question_parts VALUES ('41d2919c-b5f8-4021-a23b-fbf76d99fc76', '7efc1af6-3fd9-4491-8f97-445c14b800cf', 'c-ii', 'Use your ticked results to calculate the average (mean) volume of acid added.', NULL, 0, 7, '2026-09-13 12:52:25.374195+00');
INSERT INTO public.question_parts VALUES ('57e6163f-7dc0-4a30-a614-df85775e29d8', '7efc1af6-3fd9-4491-8f97-445c14b800cf', 'd', 'The student used the same method to find the concentration of a solution of potassium hydroxide. The equation for the reaction is $2 \mathrm {K O H} + \mathrm {H} _ {2} \mathrm {S O} _ {4} \rightarrow \mathrm {K} _ {2} \mathrm {S O} _ {4} + 2 \mathrm {H} _ {2} \mathrm {O}$ These are his results. He used these results to calculate the concentration of the potassium hydroxide solution. $\text{Step 1} \quad \text{amount of } \mathrm{H}_{2} \mathrm{SO}_{4} = \frac{0.0500 \times 23.60}{100} = 0.0118 \mathrm{~mol}$ $\text{Step 2} \quad \mathrm{amount of KOH} = \frac {0 . 0 1 1 8}{2} = 0. 0 0 5 9 0 \mathrm{~ mol}$ $\mathrm {S t e p 3} \quad \mathrm {c o n c e n t r a t i o n o f K O H} = \frac {0 . 0 0 5 9 0}{2 3 . 6 0} \times 1 0 0 0 = 0. 2 5 0 \mathrm {m o l} / \mathrm {d m} ^ {3}$ There is one mistake in each step of the calculation. What correction should the student make in each step?', NULL, 0, 8, '2026-09-13 12:52:25.37422+00');
INSERT INTO public.question_parts VALUES ('4ab802f4-1e6d-4948-aebd-c963a7ed93ed', '7efc1af6-3fd9-4491-8f97-445c14b800cf', 'd-i', 'Step 1', NULL, 0, 9, '2026-09-13 12:52:25.374241+00');
INSERT INTO public.question_parts VALUES ('1c7f53b6-d9ff-4f29-8e8d-1f948534d3df', '7efc1af6-3fd9-4491-8f97-445c14b800cf', 'd-ii', 'Step 2', NULL, 0, 10, '2026-09-13 12:52:25.374268+00');
INSERT INTO public.question_parts VALUES ('c3583a02-6997-4475-9274-b26e4e502bc5', 'bc9fc6f5-894d-4435-9e0e-607bcff3c725', 'a', 'Which raw material is the source of the nitrogen?', NULL, 0, 0, '2026-09-13 12:52:25.374299+00');
INSERT INTO public.question_parts VALUES ('bfa32478-27d7-4898-84d3-4b03a4bcae85', 'bc9fc6f5-894d-4435-9e0e-607bcff3c725', 'b', 'The hydrogen for this process is obtained using reactions 1 and 2 Reaction 1 Reaction 2 $\begin{array}{l} \mathrm {C H} _ {4} (\mathrm {g}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {g}) \rightleftharpoons \mathrm {C O} (\mathrm {g}) + 3 \mathrm {H} _ {2} (\mathrm {g}) \quad \Delta H = + 2 1 0 \mathrm {k J} \mathrm {m o l} ^ {- 1} \\ \mathrm {C O} (\mathrm {g}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {g}) \rightleftharpoons \mathrm {C O} _ {2} (\mathrm {g}) + \mathrm {H} _ {2} (\mathrm {g}) \quad \Delta H = - 4 2 \mathrm {k J} \mathrm {m o l} ^ {- 1} \\ \end{array}$', NULL, 0, 1, '2026-09-13 12:52:25.374326+00');
INSERT INTO public.question_parts VALUES ('05e4ce39-726f-4f93-87b9-f9a17f47332f', 'bc9fc6f5-894d-4435-9e0e-607bcff3c725', 'b-i', 'Predict what will happen to the equilibrium position in reaction 1 when the pressure is increased. Give a reason for your prediction. Prediction Reason', NULL, 0, 2, '2026-09-13 12:52:25.374348+00');
INSERT INTO public.question_parts VALUES ('658b6dbb-d116-43f2-a164-09f95e82680e', 'bc9fc6f5-894d-4435-9e0e-607bcff3c725', 'b-ii', 'Predict what will happen to the equilibrium position in reaction 2 when the temperature is increased. Give a reason for your prediction. Prediction Reason', NULL, 0, 3, '2026-09-13 12:52:25.374368+00');
INSERT INTO public.question_parts VALUES ('ea6b8505-05c6-430e-967a-46599ead9b66', 'bc9fc6f5-894d-4435-9e0e-607bcff3c725', 'c', 'Predict what will happen to the rate of reaction 1 when the pressure and temperature are increased. Effect of increased pressure Effect of increased temperature.', NULL, 0, 4, '2026-09-13 12:52:25.374405+00');
INSERT INTO public.question_parts VALUES ('eadd9fca-6a57-4a9b-85da-ff0986486cd2', 'bc9fc6f5-894d-4435-9e0e-607bcff3c725', 'd', 'Some of the ammonia from the Haber process is made into fertilisers such as ammonium nitrate. The equation for the formation of ammonium nitrate is $\mathrm {N H} _ {3} + \mathrm {H N O} _ {3} \rightarrow \mathrm {N H} _ {4} \mathrm {N O} _ {3}$ A manufacturer makes a batch of 40 kg of ammonium nitrate.', NULL, 0, 5, '2026-09-13 12:52:25.374427+00');
INSERT INTO public.question_parts VALUES ('bafe406d-756c-4bac-baae-f006bbb1b289', 'bc9fc6f5-894d-4435-9e0e-607bcff3c725', 'd-i', 'Calculate the amount, in moles, of $ \mathrm{N H_{4} N O_{3}} $ in 40 kg of ammonium nitrate. $f N H _ {4} N O _ {3}$', NULL, 0, 6, '2026-09-13 12:52:25.374453+00');
INSERT INTO public.question_parts VALUES ('770fa518-b8d0-4774-b8a7-fdc004191c91', 'bc9fc6f5-894d-4435-9e0e-607bcff3c725', 'd-ii', 'Deduce the amount, in moles, of ammonia needed to make this amount of ammonium nitrate.', NULL, 0, 7, '2026-09-13 12:52:25.37448+00');
INSERT INTO public.question_parts VALUES ('3ad41bc0-766e-493d-9474-d619cef6d78a', 'bc9fc6f5-894d-4435-9e0e-607bcff3c725', 'd-iii', 'Calculate the mass, in kg, of ammonia needed.', NULL, 0, 8, '2026-09-13 12:52:25.374502+00');
INSERT INTO public.question_parts VALUES ('da29a83c-fc90-4c98-b1b3-f5d65fd80cf4', 'bc9fc6f5-894d-4435-9e0e-607bcff3c725', 'e', 'The manufacturer also produces fertilisers that are labelled NPK. Suggest the names of two elements, other than nitrogen, that are likely to be present in NPK fertilisers.', NULL, 0, 9, '2026-09-13 12:52:25.374523+00');
INSERT INTO public.question_parts VALUES ('8d36f4e6-a570-44b7-8ca8-981365ff63aa', '176569a7-b98c-4f6c-bbae-bf98b9dc2140', 'a', 'Aluminium is used for the overhead lines because it is a good conductor of electricity and is ductile (can be pulled into a wire). This diagram can be used to represent the structure of aluminium. aluminium atom', NULL, 0, 0, '2026-09-13 12:52:25.374562+00');
