INSERT INTO public.glm_ocr_bridge_records VALUES ('6857c71a-43de-4460-a1a4-33872611e56b', 'ed01416c-8269-4c5b-988a-9c007908ea0f', 'glm-ocr-v1', 'edb9d604-b77e-5591-ad47-33e8d60f8048', '85af486d-e179-56ff-b401-7e9b8fa30715', 'f74b47cb-7ac2-4681-8b8e-b6af29c71c5e', '648145ca-d12b-4807-8cfd-089258546f94', 'b8613965b79a51b9151cdb5e806ea3791003c8a010aa071c3de4b44c82a16bf3', '24919a05f6f049333ba132c077f60db92e3120912e739cc4aad12aba02ccd2a9', 'glm-ocr-qp-v1+glm-ocr-ms-v1', 'OK', '[{"detail": "Q1: QP total 7 vs MS total 7 (match)", "source": "RECONCILIATION", "msMarks": 7, "qpMarks": 7, "severity": "match", "questionNumber": "1"}, {"detail": "Q2: QP total 5 vs MS total 5 (match)", "source": "RECONCILIATION", "msMarks": 5, "qpMarks": 5, "severity": "match", "questionNumber": "2"}, {"detail": "Q3: QP total 10 vs MS total 10 (match)", "source": "RECONCILIATION", "msMarks": 10, "qpMarks": 10, "severity": "match", "questionNumber": "3"}, {"detail": "Q4: QP total 8 vs MS total 8 (match)", "source": "RECONCILIATION", "msMarks": 8, "qpMarks": 8, "severity": "match", "questionNumber": "4"}, {"detail": "Q5: QP total 11 vs MS total 11 (match)", "source": "RECONCILIATION", "msMarks": 11, "qpMarks": 11, "severity": "match", "questionNumber": "5"}, {"detail": "Q6: QP total 13 vs MS total 13 (match)", "source": "RECONCILIATION", "msMarks": 13, "qpMarks": 13, "severity": "match", "questionNumber": "6"}, {"detail": "Q7: QP total 6 vs MS total unknown (qp-only)", "source": "RECONCILIATION", "msMarks": null, "qpMarks": 6, "severity": "qp-only", "questionNumber": "7"}, {"detail": "unclassified heading: amount of chlorine=", "source": "QP_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "Q4: incomplete MCQ option set folded into stem", "source": "QP_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "2: bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "ms