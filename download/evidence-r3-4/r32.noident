", "elementId": "e000030", "sourceName": "assets/crop_1_1789069692983.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Predict the appearance of the iron nail after several days.", "label": "a-i", "marks": null, "partId": "q02-f37697b2-pa-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Name the main compound in rust.", "label": "a-ii", "marks": null, "partId": "q02-f37697b2-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The student then sets up two more test tubes containing iron nails. tube 1 tube 2 Explain why the iron nail in tube 1 and the iron nail in tube 2 do not rust. tube 2.", "label": "b", "marks": 4, "partId": "q02-f37697b2-pb", "figures": [{"url": "assets/crop_2_1789069692986.png", "width": 383, "format": "png", "height": 345, "sha256": "5e43fda5f23bfb94eaced58a56d049f92c0fe3be7d09a9496cc0e167b34269cc", "assetId": "img:5e43fda5f23bfb94eaced58a56d049f92c0fe3be7d09a9496cc0e167b34269cc", "mimeType": "image/jpeg", "elementId": "e000034", "sourceName": "assets/crop_2_1789069692986.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_3_1789069692994.png", "width": 281, "format": "png", "height": 344, "sha256": "6b2c13298a87960b7a1bbdf5678aeeb4dbb84ea213e13533cdd5b5ea585478e9", "assetId": "img:6b2c13298a87960b7a1bbdf5678aeeb4dbb84ea213e13533cdd5b5ea585478e9", "mimeType": "image/jpeg", "elementId": "e000036", "sourceName": "assets/crop_3_1789069692994.png", "availability": "available", "formatMismatch": true}], "confidence": 0.8, "answerPrompts": []}], "number": 2, "figures": [{"url": "assets/crop_1_1789069692983.png", "width": 290, "format": "png", "height": 330, "sha256": "5c828863babe2ec5a587212edc1097011d607dd85bb9f8727dad778271cb760c", "assetId": "img:5c828863babe2ec5a587212edc1097011d607dd85bb9f8727dad778271cb760c", "mimeType": "image/jpeg", "elementId": "e000030", "sourceName": "assets/crop_1_1789069692983.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789069692986.png", "width": 383, "format": "png", "height": 345, "sha256": "5e43fda5f23bfb94eaced58a56d049f92c0fe3be7d09a9496cc0e167b34269cc", "assetId": "img:5e43fda5f23bfb94eaced58a56d049f92c0fe3be7d09a9496cc0e167b34269cc", "mimeType": "image/jpeg", "elementId": "e000034", "sourceName": "assets/crop_2_1789069692986.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_3_1789069692994.png", "width": 281, "format": "png", "height": 344, "sha256": "6b2c13298a87960b7a1bbdf5678aeeb4dbb84ea213e13533cdd5b5ea585478e9", "assetId": "img:6b2c13298a87960b7a1bbdf5678aeeb4dbb84ea213e13533cdd5b5ea585478e9", "mimeType": "image/jpeg", "elementId": "e000036", "sourceName": "assets/crop_3_1789069692994.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q02-f37697b2", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "The diagram shows the industrial equipment used to separate crude oil into fractions.", "marks": 10, "parts": [{"qwc": false, "text": "Give the name of the industrial equipment.", "label": "a", "marks": null, "partId": "q03-f37697b2-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give one use of the fuel oil fraction.", "label": "a-ii", "marks": null, "partId": "q03-f37697b2-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give the names of fraction A and fraction F. fraction A. fraction F.", "label": "a-iii", "marks": null, "partId": "q03-f37697b2-pa-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "One compound in the gasoline fraction is the alkane octane $ \\left( \\mathrm{C}_{8} \\mathrm{H}_{1 8} \\right) $ and one compound in the kerosene fraction is the alkane dodecane $ \\left( \\mathrm{C}_{1 2} \\mathrm{H}_{2 6} \\right) $ These two alkanes are covalently bonded and have simple molecular structures.", "label": "b", "marks": null, "partId": "q03-f37697b2-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give the general formula for the alkanes.", "label": "b-i", "marks": null, "partId": "q03-f37697b2-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain, in terms of their structures, why $ \\mathrm{C_{1 2} H_{2 6}} $ has a higher boiling point than $ \\mathrm{C_{8} H_{1 8}} $", "label": "b-ii", "marks": null, "partId": "q03-f37697b2-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Catalytic cracking can be used to convert the alkane $ C_{1 2} H_{2 6} $ into more useful products.", "label": "c", "marks": null, "partId": "q03-f37697b2-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give the name of the catalyst used for catalytic cracking.", "label": "c-i", "marks": null, "partId": "q03-f37697b2-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Complete the equation for this cracking reaction. $\\mathrm {C} _ {1 2} \\mathrm {H} _ {2 6} \\rightarrow \\mathrm {C} _ {9} \\mathrm {H} _ {2 0} +$", "label": "c-ii", "marks": null, "partId": "q03-f37697b2-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 3, "figures": [{"url": "assets/crop_1_1789069693008.png", "width": 972, "format": "png", "height": 736, "sha256": "b500a6caa587f2eaa1850130778d877faca84d7fc0a0a9fa99c42f0226c940e9", "assetId": "img:b500a6caa587f2eaa1850130778d877faca84d7fc0a0a9fa99c42f0226c940e9", "mimeType": "image/jpeg", "elementId": "e000043", "sourceName": "assets/crop_1_1789069693008.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q03-f37697b2", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "A student investigates the solubility of potassium nitrate in water. She measures the masses of potassium nitrate that dissolve in $ 2 5 \\mathrm{c m}^{3} $ of water at different temperatures. The table shows the student''s results. One of the results is anomalous.", "marks": 0, "parts": [{"qwc": false, "text": "Plot the results on the grid.", "label": "a", "marks": null, "partId": "q04-f37697b2-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Draw a circle around the anomalous result.", "label": "a-ii", "marks": null, "partId": "q04-f37697b2-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Ignoring the anomalous result, draw a curve of best fit.", "label": "a-iii", "marks": null, "partId": "q04-f37697b2-pa-iii", "figures": [{"url": "assets/crop_1_1789069693030.png", "width": 1261, "format": "png", "height": 1524, "sha256": "8f327484e50aecf366eb57143b7a164126df6de3ba4f6c0aefd6eadba5eae3c3", "assetId": "img:8f327484e50aecf366eb57143b7a164126df6de3ba4f6c0aefd6eadba5eae3c3", "mimeType": "image/jpeg", "elementId": "e000064", "sourceName": "assets/crop_1_1789069693030.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Suggest two possible mistakes that could have caused the anomalous result.", "label": "b", "marks": null, "partId": "q04-f37697b2-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Use your graph to find the maximum mass of potassium nitrate that dissolves in $ 2 5 \\mathrm{c m}^{3} $ of water at $ 7 5^{\\circ} \\mathrm{C} $. Show on your graph how you obtained your answer.", "label": "c", "marks": null, "partId": "q04-f37697b2-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Use your graph to calculate the solubility of potassium nitrate in g per 100 g of water at $ 2 5^{\\circ} \\mathrm{C} $. [1.0 $ \\mathrm{c m^{3}} $ of water has a mass of 1.0 g] solubility = g per 100 g of water (Total for Question 4 = 9 marks)", "label": "d", "marks": null, "partId": "q04-f37697b2-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 4, "figures": [{"url": "assets/crop_1_1789069693030.png", "width": 1261, "format": "png", "height": 1524, "sha256": "8f327484e50aecf366eb57143b7a164126df6de3ba4f6c0aefd6eadba5eae3c3", "assetId": "img:8f327484e50aecf366eb57143b7a164126df6de3ba4f6c0aefd6eadba5eae3c3", "mimeType": "image/jpeg", "elementId": "e000064", "sourceName": "assets/crop_1_1789069693030.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.45, "marksKnown": false, "questionId": "q04-f37697b2", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000060"]}, {"mcq": false, "qwc": false, "stem": "Ethanol, $ \\mathrm{C_{2} H_{5} O H} $ is a member of the homologous series of alcohols.", "marks": 14, "parts": [{"qwc": false, "text": "Give two characteristics of a homologous series.", "label": "a", "marks": null, "partId": "q05-f37697b2-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "When ethanol is heated with potassium dichromate(VI) and one other reagent, the ethanol is oxidised to ethanoic acid, $ \\mathrm{C H_{3} C O O H} $", "label": "b", "marks": null, "partId": "q05-f37697b2-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give the formula of the other reagent.", "label": "b-i", "marks": null, "partId": "q05-f37697b2-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State the colour change that occurs during this oxidation reaction. from ... to ...", "label": "b-ii", "marks": null, "partId": "q05-f37697b2-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Draw the displayed formulae for ethanol and ethanoic acid in the boxes.", "label": "b-iii", "marks": null, "partId": "q05-f37697b2-pb-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Ethanol can be manufactured by two different methods. The table gives some information about the two methods.", "label": "c", "marks": null, "partId": "q05-f37697b2-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Discuss the advantages and disadvantages of these two methods, using information from the table.", "label": "c-i", "marks": null, "partId": "q05-f37697b2-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The word equation for the fermentation process is glucose $ \\rightarrow $ ethanol + carbon dioxide Complete the chemical equation for this reaction. $\\mathrm {C} _ {6} \\mathrm {H} _ {1 2} \\mathrm {O} _ {6} \\rightarrow$", "label": "c-ii", "marks": null, "partId": "q05-f37697b2-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 5, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q05-f37697b2", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000079", "e000081"]}, {"mcq": false, "qwc": false, "stem": "The diagram shows how hydrogen gas and chlorine gas can be prepared in the laboratory by electrolysis of a concentrated solution of sodium chloride.", "marks": 13, "parts": [{"qwc": false, "text": "Give a test for hydrogen gas.", "label": "a", "marks": 1, "partId": "q06-f37697b2-pa", "figures": [], "confidence": 0.8, "answerPrompts": []}, {"qwc": false, "text": "Give a test for chlorine gas.", "label": "a-ii", "marks": null, "partId": "q06-f37697b2-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The ionic half-equation for the formation of chlorine at the positive electrode is $2 \\mathrm {C l} ^ {-} \\rightarrow \\mathrm {C l} _ {2} + 2 \\mathrm {e} ^ {-}$", "label": "b", "marks": null, "partId": "q06-f37697b2-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State why this reaction is an oxidation reaction.", "label": "b-i", "marks": null, "partId": "q06-f37697b2-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give the ionic half-equation for the formation of hydrogen at the negative electrode.", "label": "b-ii", "marks": null, "partId": "q06-f37697b2-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State why it is safer to do this electrolysis in a fume cupboard.", "label": "b-iii", "marks": null, "partId": "q06-f37697b2-pb-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Suggest why the volume of chlorine collected during this electrolysis is less than the volume of hydrogen collected.", "label": "b-iv", "marks": null, "partId": "q06-f37697b2-pb-iv", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "In the chemical industry, chlorine can be produced by the electrolysis of molten sodium chloride. The overall equation for this reaction is $2 \\mathrm {N a C l} (\\mathrm {I}) \\rightarrow 2 \\mathrm {N a} (\\mathrm {I}) + \\mathrm {C l} _ {2} (\\mathrm {g})$", "label": "c", "marks": null, "partId": "q06-f37697b2-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain why sodium chloride needs to be molten rather than solid for electrolysis to occur.", "label": "c-i", "marks": null, "partId": "q06-f37697b2-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the maximum volume, in $ \\mathrm{d m}^{3} $ of chlorine gas at rtp that can be obtained from 23.4 tonnes of molten sodium chloride. [1 tonne=10 $ ^{6} $ g] [Mr of NaCl=58.5] [molar volume of chlorine at rtp=24 dm $ ^{3} $] Give your answer in standard form.", "label": "c-ii", "marks": null, "partId": "q06-f37697b2-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 6, "figures": [{"url": "assets/crop_1_1789069693121.png", "width": 1303, "format": "png", "height": 948, "sha256": "0bd7c1e6922c283f4e11f7259b1e42262c2da5e5af6d5cd9f48b88be37c07c06", "assetId": "img:0bd7c1e6922c283f4e11f7259b1e42262c2da5e5af6d5cd9f48b88be37c07c06", "mimeType": "image/jpeg", "elementId": "e000089", "sourceName": "assets/crop_1_1789069693121.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q06-f37697b2", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "A student does a titration to find the concentration of a solution of phosphoric acid. He uses these pieces of apparatus X, Y and Z in his titration. Y Diagrams are not to scale. Z", "marks": 12, "parts": [{"qwc": false, "text": "Give the names of X, Y and Z.", "label": "a", "marks": null, "partId": "q07-f37697b2-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "What is the colour of phenolphthalein in phosphoric acid? A blue B colourless C pink D red", "label": "b", "marks": null, "partId": "q07-f37697b2-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The student titrates $ 2 5. 0 \\mathrm{c m}^{3} $ of phosphoric acid with a solution of sodium hydroxide (NaOH). Table 1 shows the student''s results. Table 1 Concordant results are those within $ 0. 2 0 \\mathrm{c m}^{3} $ of each other.", "label": "c", "marks": null, "partId": "q07-f37697b2-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Add ticks ( $ \\surd $ ) to table 1 to show the concordant results.", "label": "c-i", "marks": null, "partId": "q07-f37697b2-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Use your ticked results to calculate the mean (average) volume of NaOH added.", "label": "c-ii", "marks": null, "partId": "q07-f37697b2-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": ["mean volume"]}, {"qwc": false, "text": "Table 2 shows the titration results of another student. The equation for the reaction is $3 \\mathrm {N a O H} + \\mathrm {H} _ {3} \\mathrm {P O} _ {4} \\rightarrow \\mathrm {N a} _ {3} \\mathrm {P O} _ {4} + 3 \\mathrm {H} _ {2} \\mathrm {O}$", "label": "d", "marks": null, "partId": "q07-f37697b2-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the amount, in moles, of NaOH in $ 3 0. 4 0 \\mathrm{c m}^{3} $ of sodium hydroxide solution.", "label": "d-i", "marks": null, "partId": "q07-f37697b2-pd-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the amount, in moles, of $ \\mathrm{H_{3} P O_{4}} $ in $ 2 5. 0 \\mathrm{c m}^{3} $ of phosphoric acid.", "label": "d-ii", "marks": null, "partId": "q07-f37697b2-pd-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the concentration, in mol/dm $ ^{3} $ , of the phosphoric acid. $\\mathrm {m o l / d m ^ {3}}$", "label": "d-iii", "marks": null, "partId": "q07-f37697b2-pd-iii", "figures": [], "confidence": 0.55, "answerPrompts": ["concentration"]}], "number": 7, "figures": [{"url": "assets/crop_1_1789069693141.png", "width": 284, "format": "png", "height": 488, "sha256": "52f5d36183d864308c4ceff92213f9eecf3a880cec06a46611a0cbf82d93451a", "assetId": "img:52f5d36183d864308c4ceff92213f9eecf3a880cec06a46611a0cbf82d93451a", "mimeType": "image/jpeg", "elementId": "e000110", "sourceName": "assets/crop_1_1789069693141.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789069693146.png", "width": 107, "format": "png", "height": 579, "sha256": "b25ab961b98beda08d607b9119667bec4bb3663d922b78dfd6b65995f2dc31b3", "assetId": "img:b25ab961b98beda08d607b9119667bec4