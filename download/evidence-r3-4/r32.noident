INSERT INTO public.question_versions VALUES ('212e4f1b-622e-4a39-82ad-feac70859e86', '441686bc-dccf-4435-be6b-96ab0a3b686a', 1, '(a) The table shows the formulae of some positive and negative ions, and the formulae of some compounds containing these ions. (i) Complete the table by giving the formulae of the missing compounds. (ii) Give the name of the compound with the formula $ \mathrm{Z n S O_{4}} $', 14, 3, 1260, NULL, 'SUGGESTED', '07ced82a-b11c-5b09-893f-83ae8349697b', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:40.991157+00');
INSERT INTO public.question_versions VALUES ('b597c484-638c-4b8b-903d-cf8c1beda49b', '783ce18b-d78a-451d-aec0-701a41607abc', 1, 'This is the equation for the decomposition of hydrogen peroxide. $2 \mathrm {H} _ {2} \mathrm {O} _ {2} (\mathrm {a q}) \rightarrow 2 \mathrm {H} _ {2} \mathrm {O} (\mathrm {I}) + \mathrm {O} _ {2} (\mathrm {g})$ The rate of reaction increases when a catalyst of manganese(IV) oxide is added.', 6, 3, 540, NULL, 'SUGGESTED', '07ced82a-b11c-5b09-893f-83ae8349697b', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:40.991516+00');
INSERT INTO public.question_versions VALUES ('6535b8d8-43ac-45ce-982d-4064c02b316e', '4f40bb7d-7df6-4a84-82f7-da9d877633da', 1, 'Diamond and graphite are both forms of the element carbon. Diamond and graphite both have covalent bonds and giant covalent structures. The diagram represents the structure of diamond and the structure of graphite. diamond graphite', 1, 3, 90, NULL, 'SUGGESTED', '07ced82a-b11c-5b09-893f-83ae8349697b', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:40.991967+00');
INSERT INTO public.question_versions VALUES ('83470c8a-97bf-45ec-b269-7be4aa28312a', '1f2e317d-4b58-4d33-9f04-d249cda58cae', 1, 'This question is about the metal tantalum, Ta. Tantalum metal can be produced by heating tantalum chloride $ \mathrm{TaCl_{5}} $ and hydrogen gas in a furnace. The other product of the reaction is hydrogen chloride.', 11, 3, 990, NULL, 'SUGGESTED', '07ced82a-b11c-5b09-893f-83ae8349697b', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:40.992471+00');
INSERT INTO public.question_versions VALUES ('4fbf4753-1fe9-47c7-85aa-012d631db93a', '55fe087e-242a-4453-8153-dd9a6dae0bb3', 1, 'The diagram shows the structure of an atom.', 5, 3, 450, NULL, 'SUGGESTED', 'a49dc9f1-b0d0-5d2e-b50b-68f0d70d05e4', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:41.361512+00');
INSERT INTO public.question_versions VALUES ('7dbd4e03-3c52-416c-82e3-e9e1852c9327', '6f58ec85-9d45-4968-9e78-f6a44ca0b3db', 1, 'Substances can be classified as elements, compounds or mixtures.', 7, 3, 630, NULL, 'SUGGESTED', 'a49dc9f1-b0d0-5d2e-b50b-68f0d70d05e4', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:41.361924+00');
INSERT INTO public.question_versions VALUES ('5ff730b5-79b5-456b-a54b-679c1f922f53', '146c21b7-17c0-40a3-9bac-6b7f2bfc8804', 1, 'Ammonium chloride decomposes in a reversible reaction. The equation for this reaction is $\mathrm {N H} _ {4} \mathrm {C l} (\mathrm {s}) \rightleftharpoons \mathrm {N H} _ {3} (\mathrm {g}) + \mathrm {H C l} (\mathrm {g})$', 7, 3, 630, NULL, 'SUGGESTED', 'a49dc9f1-b0d0-5d2e-b50b-68f0d70d05e4', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:41.363049+00');
INSERT INTO public.question_versions VALUES ('74e7e224-cd26-4888-b50a-3e303227c774', '15d90be3-efd2-4ee5-9be2-6adb68e427f5', 1, 'The percentage by volume of oxygen in air can be found by using the rusting of iron. An excess of wet iron filings is used. At the start of each experiment, the reading on the syringe is recorded and the apparatus is then left for a week so that the reaction is complete. The reading on the syringe is then recorded again. A student sets up this apparatus to measure the volume of oxygen in a sample of air.', 8, 3, 720, NULL, 'SUGGESTED', 'a49dc9f1-b0d0-5d2e-b50b-68f0d70d05e4', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:41.364947+00');
INSERT INTO public.question_versions VALUES ('2f9e7ef0-0201-4399-8157-361d2b8f0898', 'a026ea65-0959-4dff-be79-405c612fb3c4', 1, 'A metal is added to copper(II) sulfate solution. $\mathrm {m e t a l} + \mathrm {c o p p e r} (\mathrm {I I}) \mathrm {s u l f a t e} \rightarrow \mathrm {m e t a l} \mathrm {s u l f a t e} + \mathrm {c o p p e r}$ Displacement reactions are exothermic. The more reactive the metal added, the greater the temperature rise. pour some copper(II) sulfate solution into a boiling tube and record its temperature using a thermometer add some metal to the tube and stir with the thermometer record the maximum temperature of the contents of the tube. He repeats the method using the same amount, in moles, of different metals. A student uses the following method in an experiment to compare the reactivities of different metals:', 8, 3, 720, NULL, 'SUGGESTED', 'a49dc9f1-b0d0-5d2e-b50b-68f0d70d05e4', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:41.36566+00');
INSERT INTO public.question_versions VALUES ('dfd04c76-3cba-4d0f-bf69-f05bf996591e', 'd8dbdb90-6690-4427-b784-2b05c39586dd', 1, 'This question is about the elements in Group 1 of the Periodic Table and their reactions with water.', 9, 3, 810, NULL, 'SUGGESTED', 'a49dc9f1-b0d0-5d2e-b50b-68f0d70d05e4', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:41.366214+00');
INSERT INTO public.question_versions VALUES ('d3859fa4-f494-47aa-bc8d-32a2b9a421c1', '07a72a94-de3f-4f51-9f68-0799db578b30', 1, 'This question is about hydrocarbons.', 13, 3, 1170, NULL, 'SUGGESTED', 'a49dc9f1-b0d0-5d2e-b50b-68f0d70d05e4', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:41.366504+00');
INSERT INTO public.question_versions VALUES ('c24bdded-2b53-4b9c-a404-9bb8310e9f3e', '50621cf5-e5fb-47a6-98da-e05cea703940', 1, 'The copper(II) carbonate in the mineral, malachite, reacts with hydrochloric acid according to this equation. $\mathrm {C u C O} _ {3} (\mathrm {s}) + 2 \mathrm {H C l} (\mathrm {a q}) \rightarrow \mathrm {C u C l} _ {2} (\mathrm {a q}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {g}) + \mathrm {C O} _ {2} (\mathrm {g})$ Some students investigate the effect of changing the concentration of acid on the rate of this reaction. The diagram shows the apparatus they use. This is the method they use: set the balance to zero add an excess of malachite lumps to the conical flask and replace the cotton wool start a timer and record the balance reading after one minute. The experiment is repeated using different concentrations of hydrochloric acid. The mass and number of malachite lumps are kept the same in each experiment.', 5, 3, 450, NULL, 'SUGGESTED', 'a49dc9f1-b0d0-5d2e-b50b-68f0d70d05e4', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:41.366885+00');
INSERT INTO public.question_versions VALUES ('8ebc5d67-5d4d-45ef-bed8-60d4e008be1e', 'f031c5d1-52e7-4932-b51f-911ec7e5880d', 1, 'The flow chart shows how ethene can be obtained industrially from crude oil.', 19, 3, 1710, NULL, 'SUGGESTED', 'a49dc9f1-b0d0-5d2e-b50b-68f0d70d05e4', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:41.368953+00');
INSERT INTO public.question_versions VALUES ('dfff29b8-475d-4a79-aa21-b9a9c1b1a8b9', '4ce35539-f576-4baa-a9e0-34f06843e0e5', 1, 'The box shows some methods that can be used in separating mixtures. From the box, select the best method for each of the separations. You may use each method once, more than once or not at all.', 5, 3, 450, NULL, 'SUGGESTED', '0352c863-3696-5e19-a448-b4c1898c0e8b', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.360512+00');
INSERT INTO public.question_versions VALUES ('7d0d26c9-e092-4e7f-af88-8ad56441fb29', '37a28481-c3dc-4813-940e-29b97e1e3404', 1, 'When aqueous solutions of potassium hydroxide and nitric acid are mixed together, an exothermic reaction occurs. The diagram shows the apparatus used in an experiment to measure the temperature increase. This is the student''s method; use the larger measuring cylinder to add $ 2 5 \mathrm{c m}^{3} $ of aqueous potassium hydroxide to the polystyrene cup record the steady temperature use the smaller measuring cylinder to add $ 5 \mathrm{c m}^{3} $ of dilute nitric acid to the cup, stir the mixture with the thermometer record the highest temperature of the mixture continue adding further $ 5 \mathrm{c m}^{3} $ portions of dilute nitric acid to the cup, stirring and recording the temperature, until a total volume of $ 3 5 \mathrm{c m}^{3} $ has been added.', 12, 3, 1080, NULL, 'SUGGESTED', 'a49dc9f1-b0d0-5d2e-b50b-68f0d70d05e4', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:41.369592+00');
INSERT INTO public.question_versions VALUES ('c7f1f674-9366-4dce-b172-14c39849e409', 'f33368c4-dc22-4dd2-b892-32051dc0a972', 1, 'Many different salts can be prepared from acids.', 17, 3, 1530, NULL, 'SUGGESTED', 'a49dc9f1-b0d0-5d2e-b50b-68f0d70d05e4', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:41.369958+00');
INSERT INTO public.question_versions VALUES ('0ef29f00-cd8e-4471-87b8-3b2ef1021e85', '428dfad0-939d-42be-8f04-01976a8cb984', 1, 'A small piece of potassium is added to water. The list below shows some statements. Only four of these statements describe what happens when potassium reacts with water. Place a cross ( $ \times $ ) in the box next to each of the four correct statements. potassium oxide solution is formed fizzing occurs potassium sinks to the bottom of the water potassium moves around potassium melts bubbles of oxygen gas are produced a lilac flame is seen potassium reacts to form an acidic solution', 4, 3, 360, NULL, 'SUGGESTED', '6398c196-1b3d-58d5-a2eb-ef60f560d52c', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:41.682492+00');
INSERT INTO public.question_versions VALUES ('18baae91-08a7-48a5-8cba-d360576e177c', 'bf559bd2-4a7a-47c6-9c45-57c4f92c519c', 1, 'Choose the name of a substance from the box to answer parts (a) to (e). Each name may be used once, more than once or not at all. ammonia chlorine haematite iron sodium hydroxide Give the name of', 5, 3, 450, NULL, 'SUGGESTED', '6398c196-1b3d-58d5-a2eb-ef60f560d52c', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:41.68319+00');
INSERT INTO public.question_versions VALUES ('9fdce71c-4d88-4b37-b486-86f4355aca6a', '473f7dd5-9eb7-4871-abda-6c7294930769', 1, 'The photograph shows the planet Venus. Although Venus is similar in size to the Earth, it is very different in other ways. The temperature at the surface of Venus is about 470 $ ^{\circ} \mathrm{C} $ . The atmospheric pressure is 90 times that of the Earth. The clouds in the atmosphere of Venus are made up of droplets of sulfuric acid. The table lists some properties of metals that could be used to make a space probe to land on Venus. The probe needs to be launched with enough energy to escape the Earth''s gravity. To make this easier, the mass of the probe needs to be as low as possible. The probe also needs to withstand the conditions on the surface of Venus. Use the information in the table to answer parts (a) to (c).', 6, 3, 540, NULL, 'SUGGESTED', '6398c196-1b3d-58d5-a2eb-ef60f560d52c', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:41.683482+00');
INSERT INTO public.question_versions VALUES ('06ad5256-a122-4104-aba4-3e80a650d924', '7299f4f3-0e3f-4873-a63f-019f676d0bb3', 1, 'Here are some statements about the compound ethene. ethene has the displayed formula ethene is a gas at room temperature ethene burns with a smoky flame ethene is unsaturated ethene is insoluble in water ethene can be prepared from ethanol ethene is used to make the polymer poly(ethene)', 1, 3, 90, NULL, 'SUGGESTED', '6398c196-1b3d-58d5-a2eb-ef60f560d52c', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:41.684834+00');
INSERT INTO public.question_versions VALUES ('8d22f7f8-d2d5-47b4-8263-ce8ac6133705', '08b46ac5-9abe-405f-8863-aeb48a11ca3f', 1, 'When soap is shaken with water, a lather forms. A lather is a collection of small bubbles that form on the surface of the water. Very little soap is needed to form a lather with pure water. Water that needs a much larger quantity of soap to form a lather is called hard water. Water becomes hard when certain compounds are dissolved in it. This is the method she used. Equal amounts of five different compounds were dissolved in equal volumes of pure water in separate test tubes. Soap solution was added to each test tube, one drop at a time. One drop of soap solution has a volume of $ 0. 0 5 \mathrm{c m}^{3}. $ The test tubes were shaken after each addition of soap solution. Soap solution was added drop by drop until a lather formed on shaking. The volume of soap solution needed to form a lather was recorded. The experiment was repeated three times with each compound. Pure water was also tested in the same way. Her results are shown in the table: A student carried out an experiment to find out which compounds make water hard.', 8, 3, 720, NULL, 'SUGGESTED', '6398c196-1b3d-58d5-a2eb-ef60f560d52c', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:41.686877+00');
INSERT INTO public.question_versions VALUES ('140b8483-e42e-442c-977c-9e6abe845532', '39853606-60a7-4ae3-bd32-e7795b292571', 1, 'Diamond and graphite are two naturally-occurring forms of carbon. The diagrams below show the arrangement of the carbon atoms in diamond and in graphite. The black dots ( $ \cdot $ ) represent carbon atoms.', 1, 3, 90, NULL, 'SUGGESTED', '6398c196-1b3d-58d5-a2eb-ef60f560d52c', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:41.690336+00');
INSERT INTO public.question_versions VALUES ('75437896-a74c-48b7-b3cf-65b8ad86142f', '0797353c-53bb-4133-9fc6-5cd1eedbde91', 1, 'Sodium azide $ \mathrm{(N a N_{3})} $ is a stable compound at room temperature but decomposes when heated to $ 3 0 0^{\circ} \mathrm{C} $ . The equation for the decomposition is: $2 \mathrm {N a N} _ {3} (\mathrm {s}) \rightarrow 2 \mathrm {N a} (\mathrm {I}) + 3 \mathrm {N} _ {2} (\mathrm {g})$ Sodium azide is used to produce nitrogen gas to inflate car airbags. If a car is involved in a collision, the sodium azide decomposes. The nitrogen gas is produced very rapidly and the airbag inflates almost immediately.', 9, 3, 810, NULL, 'SUGGESTED', '6398c196-1b3d-58d5-a2eb-ef60f560d52c', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:41.691519+00');
INSERT INTO public.question_versions VALUES ('6fd7b874-6a8f-4fbc-a0cc-91b5dd00d3ee', '566189a5-4125-4df5-a98b-265f812e4714', 1, 'The following verse is about water $ \mathrm{(H_{2}O)} $ and dilute sulfuric acid $ \mathrm{(H_{2}SO_{4})}. $ Johnny was a chemist''s son But Johnny is no more What Johnny thought was $ \mathrm{H}_{2} \mathrm{O} $ $\mathrm {W a s H} _ {2} \mathrm {S O} _ {4}$', 11, 3, 990, NULL, 'SUGGESTED', '6398c196-1b3d-58d5-a2eb-ef60f560d52c', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:41.691893+00');
INSERT INTO public.question_versions VALUES ('7d51d78a-58be-48bd-9d67-ce011a19969f', '2b4accc6-38ca-49a0-9e86-abb922515495', 1, '(a) Complete the table to show the relative mass and relative charge of a proton, a neutron and an electron.', 1, 3, 90, NULL, 'SUGGESTED', 'd5f4942f-e594-5148-a6cf-63b92cb75147', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:41.967113+00');
INSERT INTO public.question_versions VALUES ('41b50040-51f0-497c-98a1-e704c20abfb6', '802f75f2-93fe-4d4e-aa14-c2d62abe9d0a', 1, 'Use the Periodic Table on page 2 to help you answer this question.', 6, 3, 540, NULL, 'SUGGESTED', 'd5f4942f-e594-5148-a6cf-63b92cb75147', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:41.970638+00');
INSERT INTO public.question_versions VALUES ('3f17bd9e-a784-4dd5-8706-e3dbaf883258', '14f5125b-cfff-4b0b-81bb-d94c08874a9e', 1, 'Lead(II) sulfate, $ \mathrm{P b S O_{4}} $ , is an insoluble salt. It can be made as a precipitate from a solution of lead(II) nitrate, $ \mathrm{P b ( N O_{3} )_{2}} $', 8, 3, 720, NULL, 'SUGGESTED', 'd5f4942f-e594-5148-a6cf-63b92cb75147', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:41.972085+00');
INSERT INTO public.question_versions VALUES ('4ffdfa52-a29a-4629-a40a-69eaee1533bd', '286c2968-e364-4047-92cf-5640dc3848ad', 1, 'Part of the pH scale is shown. Some of these experiments involve a pH change. E ammonia gas is dissolved in pure water The table shows the pH at the start and at the end of the five experiments. Complete the table by inserting the appropriate letter in each box. You may use each letter only once. The first one has been done for you.', 4, 3, 360, NULL, 'SUGGESTED', '0352c863-3696-5e19-a448-b4c1898c0e8b', 0.8, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.362877+00');
INSERT INTO public.question_versions VALUES ('b78340c7-16a1-479d-894a-2b2642fa3517', '2d442e82-b583-4084-93ef-257cf5d2f5f5', 1, 'This question is about the manufacture of ethanol by the fermentation of glucose.', 1, 3, 90, NULL, 'SUGGESTED', '3745aeee-bf69-597d-8e80-5683f6dea0b1', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:04:21.292371+00');
INSERT INTO public.question_versions VALUES ('05f393fb-1b21-4df8-91ca-a2a94c07701c', '7634a868-2a90-4025-85d1-cee1f1cd35b0', 1, 'When magnesium is burned in air, it reacts with oxygen, $ \mathrm{O_{2}} $ , to form magnesium oxide, MgO A class of students investigated the relationship between the mass of magnesium burned and the mass of magnesium oxide formed. Each student was given a different mass of clean magnesium to heat. The students used the following method. Weigh a crucible and lid Place the magnesium ribbon in the crucible, replace the lid, and reweigh Heat the crucible as shown in the diagram until the magnesium burns Lift the lid from time to time until there is no sign of further reaction Allow the crucible and lid to cool and reweigh Repeat the heating, cooling and reweighing until two consecutive masses are the same Calculate the mass of magnesium oxide formed', 1, 3, 90, NULL, 'SUGGESTED', 'd5f4942f-e594-5148-a6cf-63b92cb75147', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:41.973359+00');
INSERT INTO public.question_versions VALUES ('b9c7d049-62d7-40a5-9dae-78150ef72af6', '301b40f1-bdb8-44b5-acbe-ff28727b33ca', 1, 'The apparatus shown can be used to electrolyse aqueous sodium chloride in the laboratory.', 1, 3, 90, NULL, 'SUGGESTED', 'd5f4942f-e594-5148-a6cf-63b92cb75147', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:41.97632+00');
INSERT INTO public.question_versions VALUES ('2b5e3b9a-3ee9-42fb-b7ed-099a8f428f37', '53f9d2cf-14e6-415b-8246-5f6db9778f9d', 1, 'Compound X is a blue, crystalline solid. It contains copper(II) ions $ \mathrm{(C u^{2+})} $ , sulfate ions $ \mathrm{(S O_{4}^{2-})} $ and water of crystallisation.', 5, 3, 450, NULL, 'SUGGESTED', 'd5f4942f-e594-5148-a6cf-63b92cb75147', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:41.976677+00');
INSERT INTO public.question_versions VALUES ('608d28f0-bd03-4c03-b811-885f21740fe7', 'a7ca520b-3947-4f0b-8dd9-bb7117b28427', 1, 'The table shows percentage by mass of the fractions obtained from a sample of crude oil and the percentage market demand for these fractions.', 8, 3, 720, NULL, 'SUGGESTED', 'd5f4942f-e594-5148-a6cf-63b92cb75147', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:41.976905+00');
INSERT INTO public.question_versions VALUES ('55c24497-9608-4333-847f-9879a4df9339', 'cbdc8538-5911-4f62-95e8-aa8ba7590802', 1, 'Sulfur dioxide, $ \mathrm{S O_{2}} $ , is used as a preservative in wine. The sulfur dioxide content of a wine can be found by titration. A chemist found that $ 2 5. 0 \mathrm{c m}^{3} $ of a sample of wine reacted with exactly $ 1 5. 0 0 \mathrm{c m}^{3} $ of 0.0010 mol/dm $ ^{3} $ aqueous iodine, $ \mathrm{I}_{2} $ (aq). The equation for the reaction is $\mathrm {S O} _ {2} (\mathrm {a q}) + \mathrm {I} _ {2} (\mathrm {a q}) + 2 \mathrm {H} _ {2} \mathrm {O} (\mathrm {l}) \rightarrow \mathrm {S O} _ {4} ^ {2 -} (\mathrm {a q}) + 2 \mathrm {I} ^ {-} (\mathrm {a q}) + 4 \mathrm {H} ^ {+} (\mathrm {a q})$', 8, 3, 720, NULL, 'SUGGESTED', 'd5f4942f-e594-5148-a6cf-63b92cb75147', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:41.977083+00');
INSERT INTO public.question_versions VALUES ('92580653-b2db-4baa-bc6a-771a9299e49e', '1e08a0b9-2baf-44df-b578-c53699788f70', 1, 'Many chemical reactions occur in the atmosphere.', 8, 3, 720, NULL, 'SUGGESTED', '29fe818b-80ac-54d9-a3b4-2354ce830582', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:42.115525+00');
INSERT INTO public.question_versions VALUES ('16eabe32-a79f-4fd1-afd4-518bf435a1b8', 'dc8c879b-83be-4c07-a03b-e8de6ea149a6', 1, 'Iron and aluminium are two important metals extracted from their ores on a large scale.', 13, 3, 1170, NULL, 'SUGGESTED', '29fe818b-80ac-54d9-a3b4-2354ce830582', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:42.115809+00');
INSERT INTO public.question_versions VALUES ('400fd6a0-529a-4853-ba85-d9d12e694af3', '7c7174aa-6974-44f9-92ff-bbd2d7061212', 1, 'A group of students planned an experiment to find the temperature rise in a neutralisation reaction. This is their method. Use a measuring cylinder to add $ 2 5 \mathrm{c m}^{3} $ of an alkali to a $ 1 0 0 \mathrm{c m}^{3} $ beaker Record the temperature of the alkali Use a burette to add an acid to the alkali in 5.0 $ cm^{3} $ portions Record the temperature of the mixture after adding each portion of acid Stop the experiment when the neutralisation is complete', 19, 3, 1710, NULL, 'SUGGESTED', '29fe818b-80ac-54d9-a3b4-2354ce830582', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:42.116002+00');
INSERT INTO public.question_versions VALUES ('2ca19f87-f2e2-49d0-9d26-8808159988ba', '38514e30-c99e-4b64-bb73-b860ff2e6cb5', 1, 'There are two important ways to manufacture ethanol. Reaction 1 $\mathrm {C} _ {2} \mathrm {H} _ {4} + \mathrm {H} _ {2} \mathrm {O} \rightarrow \mathrm {C} _ {2} \mathrm {H} _ {5} \mathrm {O H}$ Reaction 2 $C _ {6} H _ {1 2} O _ {6} \rightarrow 2 C _ {2} H _ {5} O H + 2 C O _ {2}$', 8, 3, 720, NULL, 'SUGGESTED', '29fe818b-80ac-54d9-a3b4-2354ce830582', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:42.118086+00');
INSERT INTO public.question_versions VALUES ('3c999e8d-00eb-41aa-bb57-ebf6ad5e9d7d', '308df63c-dc69-44b7-a195-b77ecbe0c75b', 1, 'The diagram shows how sodium chloride solution can be electrolysed and the products of electrolysis collected. power supply', 12, 3, 1080, NULL, 'SUGGESTED', '29fe818b-80ac-54d9-a3b4-2354ce830582', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:42.118435+00');
INSERT INTO public.question_versions VALUES ('89a0a6bb-0710-4693-aa18-23bde4a79465', '424fe93e-0f36-4911-9eb9-7f02a6326af1', 1, 'The melting points of three related compounds are $\begin{array}{l l} \mathrm {c a p r i c a c i d} & 3 2 ^ {\circ} \mathrm {C} \\ \mathrm {f o r m i c a c i d} & 8 ^ {\circ} \mathrm {C} \\ \mathrm {p a l m i t i c a c i d} & 6 3 ^ {\circ} \mathrm {C} \end{array}$ The boiling point of all these compounds is above 100 $ ^{\circ} \mathrm{C} $', 4, 3, 360, NULL, 'SUGGESTED', 'c4075b63-51fb-5be3-8ee0-4f8b67fd76e8', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.059718+00');
INSERT INTO public.question_versions VALUES ('8fb3aea8-9986-45dd-8c66-77f3beb9be5c', '7123bb86-3a36-4974-888a-127c58f4e765', 1, 'A student produces this chromatogram for four dyes, A, B, C and D.', 4, 3, 360, NULL, 'SUGGESTED', 'c4075b63-51fb-5be3-8ee0-4f8b67fd76e8', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.061456+00');
INSERT INTO public.question_versions VALUES ('37231b00-16a6-43c1-8d46-4e66de3f86fe', 'ae4d8ca8-41ef-45ed-aac3-94e6e00be3f0', 1, 'The photograph shows an aeroplane that has a rocket motor.', 1, 3, 90, NULL, 'SUGGESTED', 'c4075b63-51fb-5be3-8ee0-4f8b67fd76e8', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.061925+00');
INSERT INTO public.question_versions VALUES ('852cba5b-5284-498a-83ba-1d2320af7ff2', 'd600f30e-73ca-4334-abac-930ed7672ac4', 1, 'An excess of dilute hydrochloric acid was added to a lump of calcium carbonate in a beaker. The mass of the beaker and contents was recorded every 30 seconds. The graph shows the results. Mass of beaker and contents in grams $\mathrm {C a C O} _ {3} (\mathrm {s}) + 2 \mathrm {H C l} (\mathrm {a q}) \rightarrow \mathrm {C a C l} _ {2} (\mathrm {a q}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {I}) + \mathrm {C O} _ {2} (\mathrm {g})$ The equation for the reaction is', 11, 3, 990, NULL, 'SUGGESTED', 'c4075b63-51fb-5be3-8ee0-4f8b67fd76e8', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.062301+00');
INSERT INTO public.question_versions VALUES ('4dc4e4b3-870e-43b7-b341-80627915edbe', '1f4ac661-ae21-4bcc-b3f9-3b8696953444', 1, 'Soluble salts can be made by reacting an acid with a metal hydroxide, a metal oxide, or a metal carbonate. Insoluble salts can be made by using a precipitation reaction.', 12, 3, 1080, NULL, 'SUGGESTED', 'c4075b63-51fb-5be3-8ee0-4f8b67fd76e8', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.062702+00');
INSERT INTO public.question_versions VALUES ('92db095e-62d3-44a7-8c60-5757b909c4ab', 'b0afbfe9-8208-401a-805a-86408f6f122a', 1, 'This is a recipe for making plum wine. Dissolve 1.5 kg of sugar in 5 dm $ ^{3} $ of warm water. Add yeast and 8 kg of plums. Pour the mixture into a flask. Leave the flask for several weeks until the reaction has stopped. Remove the solid yeast and pour the clear liquid into bottles.', 11, 3, 990, NULL, 'SUGGESTED', 'c4075b63-51fb-5be3-8ee0-4f8b67fd76e8', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.063104+00');
INSERT INTO public.question_versions VALUES ('cda9bab4-fc9c-414a-984c-5894473c44a8', '0b1c7a24-d7c6-48f4-97bc-b965ebb01c28', 1, 'A student set up this apparatus to measure the volume of carbon dioxide given off when a sample of a carbonate of a Group 2 metal was reacted with dilute nitric acid. She weighed out some of the carbonate and put it in a conical flask. She then added an excess of dilute nitric acid. After adding the acid she placed the bung and delivery tube into the conical flask. She measured the total volume of gas collected at room temperature and pressure (rtp) in the measuring cylinder. Her results are shown in the table. The equation for the reaction is $\mathrm {X C O} _ {3} (\mathrm {s}) + 2 \mathrm {H N O} _ {3} (\mathrm {a q}) \rightarrow \mathrm {X} \left(\mathrm {N O} _ {3}\right) _ {2} (\mathrm {a q}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {l}) + \mathrm {C O} _ {2} (\mathrm {g})$ where X is the symbol for the Group 2 metal.', 10, 3, 900, NULL, 'SUGGESTED', 'c4075b63-51fb-5be3-8ee0-4f8b67fd76e8', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.063517+00');
INSERT INTO public.question_versions VALUES ('f043c19d-7451-4189-8ffb-a6f3ad827ff7', '59eff084-eb8d-45ef-90ec-0e6aa5c7bae7', 1, 'A student measured the temperature change when 0.5 g of magnesium powder was added to $ 5 0 \mathrm{c m}^{3} $ of copper(II) sulfate solution. She repeated the experiment using 1.0 g, 1.5 g and 2.0 g of magnesium powder. The diagrams of the thermometer show the highest temperature, in $ ^{\circ} \mathrm{C} $ , reached in each of the experiments.', 9, 3, 810, NULL, 'SUGGESTED', '0352c863-3696-5e19-a448-b4c1898c0e8b', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.36322+00');
INSERT INTO public.question_versions VALUES ('8930077a-8e59-40f0-8149-87d97e3ce83f', '2edcf4dc-4197-4118-9dc5-c42d9a0d64c3', 1, '(a) Plastic bags used to store food are made from a polymer. Ethene is the monomer used to make the polymer for some plastic bags. (i) Name the polymer that is made from ethene. (ii) Use a word from the box to complete the sentence about ethene. Ethene is made by breaking down large hydrocarbon molecules into smaller hydrocarbon molecules, using a process called ...', 7, 3, 630, NULL, 'SUGGESTED', '0352c863-3696-5e19-a448-b4c1898c0e8b', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.364124+00');
INSERT INTO public.question_versions VALUES ('67f4317b-7c33-4d9b-9fce-21852979fbd0', 'c730e5f3-38e1-4d22-b28e-829371a2834b', 1, 'This information was taken from a label on a packet containing a pizza.', 7, 3, 630, NULL, 'SUGGESTED', '0352c863-3696-5e19-a448-b4c1898c0e8b', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.364465+00');
INSERT INTO public.question_versions VALUES ('17a85e4d-d51b-4112-876c-16714ebd179a', 'e5e2c25b-df48-4174-9828-1d8364831b66', 1, 'Sodium (Na) and sodium chloride (NaCl) both have lattice structures. Their melting points are shown in the table.', 19, 3, 1710, NULL, 'SUGGESTED', '0352c863-3696-5e19-a448-b4c1898c0e8b', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.364803+00');
INSERT INTO public.question_versions VALUES ('63f6819e-5443-44b2-8c8b-47068a013b73', '2ec68ffe-f02e-4709-83a4-ba83d10e5747', 1, '(a) The table shows some results of the electrolysis of aqueous solutions using inert electrodes. The solutions were electrolysed under the same conditions. Use the information given to complete the table.', 9, 3, 810, NULL, 'SUGGESTED', '0352c863-3696-5e19-a448-b4c1898c0e8b', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.36511+00');
INSERT INTO public.question_versions VALUES ('ee74edf8-7c83-4f70-8974-4ee65ec02c2f', '0a478c59-eae3-4153-ab3f-1360b8d7ec77', 1, 'Use the Periodic Table on page 2 to help you answer this question. Give the name or symbol of', 5, 3, 450, NULL, 'SUGGESTED', '2c4bb314-2c6d-521b-afde-836cb2da220c', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.489943+00');
INSERT INTO public.question_versions VALUES ('d2a73bfc-b8a1-4f10-8ff2-1ca8dd3ba738', '266c51bf-290c-48f9-b305-d9fd294f7e31', 1, '(a) The list shows some techniques used to separate mixtures. E simple distillation Complete the table to show the best method of obtaining each substance from the mixture. In each case, choose one of the letters A, B, C, D or E. Each letter may be used once more than once or not at all. A crystallisation B filtration C fractional distillation D paper chromatography', 7, 3, 630, NULL, 'SUGGESTED', '2c4bb314-2c6d-521b-afde-836cb2da220c', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.490292+00');
