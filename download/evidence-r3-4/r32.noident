crystallisation
distillation', 1, 1, '["e000018", "e000019", "e000020", "e000021", "e000022", "e000024", "e000025", "e000026", "e000027", "e000028", "e000029", "e000030", "e000031", "e000032", "e000034", "e000036", "e000038", "e000041", "e000043", "e000044", "e000045", "e000046", "e000047", "e000048", "e000049", "e000050", "e000051", "e000052"]', 286, NULL, NULL, NULL, '2026-09-13 12:57:41.26597+00');
