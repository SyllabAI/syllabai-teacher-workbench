INSERT INTO public.questions VALUES ('2104c57f-5b69-4d62-812a-6a40ebb1b87b', 'q02-edb9d604', 'STRUCTURED', 'The table shows the names of some substances. It also shows whether each substance is an element or a compound, and the type of bonding in the substance.', 5, 3, 450, NULL, '9d73d71b-a02a-4153-8523-82c89deb68c1', 'PAST_PAPER', true, 1, '2026-09-13 12:59:09.556497+00', 'ed01416c-8269-4c5b-988a-9c007908ea0f');
INSERT INTO public.questions VALUES ('056ef868-94c2-4905-a93f-d6f29a873850', 'q03-edb9d604', 'STRUCTURED', 'The table shows the electronic configurations of four elements.', 10, 3, 900, NULL, '9d73d71b-a02a-4153-8523-82c89deb68c1', 'PAST_PAPER', true, 1, '2026-09-13 12:59:09.556932+00', 'ed01416c-8269-4c5b-988a-9c007908ea0f');
INSERT INTO public.questions VALUES ('7a17c5e2-06f2-42be-9f2a-2e32fd174aa2', 'q06-f37697b2', 'STRUCTURED', 'The diagram shows how hydrogen gas and chlorine gas can be prepared in the laboratory by electrolysis of a concentrated solution of sodium chloride.', 13, 3, 1170, NULL, '1d8c6b3c-b693-4155-8fd3-a287cdc29a1b', 'PAST_PAPER', true, 1, '2026-09-13 13:02:53.423723+00', '065f2ced-0e47-4744-92d5-a46ed2cdd962');
INSERT INTO public.questions VALUES ('e8dfd9a5-0da0-4af8-b891-1b49181adc91', 'q07-f37697b2', 'STRUCTURED', 'A student does a titration to find the concentration of a solution of phosphoric acid. He uses these pieces of apparatus X, Y and Z in his titration. Y Diagrams are not to scale. Z', 12, 3, 1080, NULL, '1d8c6b3c-b693-4155-8fd3-a287cdc29a1b', 'PAST_PAPER', true, 1, '2026-09-13 13:02:53.424087+00', '065f2ced-0e47-4744-92d5-a46ed2cdd962');
INSERT INTO public.questions VALUES ('7cfba505-b8f4-4041-8af6-f061f84d0cea', 'q04-edb9d604', 'STRUCTURED', 'An industrial chemical company has supplies of ethene and ethanol. The company considers using these two processes. process 1 converting ethene to ethanol process 2 converting ethanol to ethene $\mathrm {C} _ {2} \mathrm {H} _ {4} + \mathrm {H} _ {2} \mathrm {O} \rightarrow \mathrm {C} _ {2} \mathrm {H} _ {6} \mathrm {O}$ A chemical equation for process 1 is', 8, 3, 720, NULL, '9d73d71b-a02a-4153-8523-82c89deb68c1', 'PAST_PAPER', true, 1, '2026-09-13 12:59:09.557275+00', 'ed01416c-8269-4c5b-988a-9c007908ea0f');
INSERT INTO public.questions VALUES ('9573c5b0-198b-4885-87f6-be9d6f8d99f3', 'q05-edb9d604', 'STRUCTURED', 'Potassium chloride, KCl, is very similar to sodium chloride, NaCl. They have the same type of crystal structure, and their aqueous solutions can be electrolysed to give similar products.', 11, 3, 990, NULL, '9d73d71b-a02a-4153-8523-82c89deb68c1', 'PAST_PAPER', true, 1, '2026-09-13 12:59:09.558017+00', 'ed01416c-8269-4c5b-988a-9c007908ea0f');
INSERT INTO public.questions VALUES ('9bb2634d-0715-40d3-ae1d-e85c367ab336', 'q06-edb9d604', 'STRUCTURED', 'A student prepares a solution of the soluble salt lithium sulfate, using the neutralisation reaction between sulfuric acid and the alkali lithium hydroxide. To make sure that she obtains a pure solution of the salt, she first carries out a titration to find the volumes of sulfuric acid and lithium hydroxide that react exactly together. She uses this method in the titration. use a pipette to add 25.0 $ cm^{3} $ of dilute sulfuric acid to a conical flask add a few drops of phenolphthalein indicator fill a burette with lithium hydroxide solution add the lithium hydroxide solution from the burette until the indicator just changes colour', 13, 3, 1170, NULL, '9d73d71b-a02a-4153-8523-82c89deb68c1', 'PAST_PAPER', true, 1, '2026-09-13 12:59:09.55861+00', 'ed01416c-8269-4c5b-988a-9c007908ea0f');
INSERT INTO public.questions VALUES ('9fbffcf6-e54e-49bd-988e-68f9c5d8a2fe', 'q07-edb9d604', 'STRUCTURED', 'A student investigates the temperature rise of water in a copper can placed above a spirit burner containing a flammable liquid. The diagram shows the apparatus he uses. This is the student''s method. place 200 g of water in the copper can and record the temperature of the water weigh the spirit burner containing the flammable liquid place the spirit burner underneath the copper can and light the burner after two minutes extinguish the flame and record the maximum temperature of the water reweigh the spirit burner containing the remaining flammable liquid', 6, 3, 540, NULL, '9d73d71b-a02a-4153-8523-82c89deb68c1', 'PAST_PAPER', true, 1, '2026-09-13 12:59:09.55898+00', 'ed01416c-8269-4c5b-988a-9c007908ea0f');
INSERT INTO public.questions VALUES ('9b5a5f92-0b46-4dc6-bad8-513c6b8647a3', 'q01-c64b6fb8', 'STRUCTURED', 'Use the Periodic Table to help you answer this question.', 1, 3, 90, NULL, '914f7ed8-2950-415d-9cbe-6a4c1956defe', 'PAST_PAPER', true, 1, '2026-09-13 13:02:53.717561+00', '17410381-8b62-4842-8361-479033de8ff6');
