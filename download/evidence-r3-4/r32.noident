INSERT INTO public.question_parts VALUES ('01c2fff1-c5eb-448d-9d4e-532704239091', 'faf40857-60c5-44cf-bb1a-eda6c28a83aa', 'e', 'The manufacturer makes a batch of ethanoic acid from methanol and carbon monoxide using this reaction. $\mathrm {C H} _ {3} \mathrm {O H} + \mathrm {C O} \rightarrow \mathrm {C H} _ {3} \mathrm {C O O H}$ He starts with 64kg of methanol. Calculate the maximum mass of ethanoic acid he could obtain. Every effort has been made to contact copyright holders to obtain their permission for the use of copyright material. Pearson Education Ltd. will, if notified, be happy to rectify any errors or omissions and include any such rectifications in future editions.', NULL, 0, 7, '2026-09-13 12:53:11.616219+00');
