INSERT INTO public.question_versions VALUES ('54bdc897-8839-4e08-9a14-f6cc75cc2acc', '717cfa5b-0bfe-45f8-9d6d-494d7c5a702a', 1, 'Iron is a metal that has many uses. One problem with iron is that it can rust when exposed to air.', 6, 3, 540, NULL, 'SUGGESTED', '421db8f1-5e17-57c1-86ab-e1eddcb60bf7', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.128516+00');
INSERT INTO public.question_versions VALUES ('1ec6f345-fd37-47fb-98d7-3b862b220863', '68f79c30-73aa-4ee7-aebc-eedae4b4bacc', 1, '(a) The box shows some methods that can be used to separate mixtures. The table lists some separations. Complete the table by giving the best method for each separation. You may use each method once, more than once or not at all.', 1, 3, 90, NULL, 'SUGGESTED', '421db8f1-5e17-57c1-86ab-e1eddcb60bf7', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.128805+00');
INSERT INTO public.question_versions VALUES ('d8f0bca4-0689-4453-a0ee-9c9d048781c9', '980fc9a6-b0e1-4aa3-b534-e20302bb84e3', 1, 'The Periodic Table consists of elements arranged in order of increasing atomic number.', 5, 3, 450, NULL, 'SUGGESTED', '421db8f1-5e17-57c1-86ab-e1eddcb60bf7', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.129025+00');
INSERT INTO public.question_versions VALUES ('17511467-5e5a-42b7-90b4-69da076fb15d', '70573247-6d03-4999-a906-c5096c855610', 1, 'A student uses this apparatus to investigate the rate of reaction between an excess of magnesium and two different dilute acids, X and Y. This is the method given to the student. place 0.5g of magnesium ribbon into the conical flask use a measuring cylinder to add $ 5 0 \mathrm{c m}^{3} $ of dilute acid X and then replace the bung record the total volume of gas collected every 20 seconds for two minutes repeat the method using $ 5 0 \mathrm{c m}^{3} $ of dilute acid Y instead of dilute acid X in each experiment, keep the temperature the same and the magnesium in excess', 12, 3, 1080, NULL, 'SUGGESTED', '421db8f1-5e17-57c1-86ab-e1eddcb60bf7', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.12925+00');
INSERT INTO public.question_versions VALUES ('67ebb0b0-8c38-44ee-b1ff-f3b12ee492a4', 'eedf78d7-460d-4c8c-8318-f57db8b82e2b', 1, 'Copper and iron are metals. They have the typical properties of metals, including a high melting point and good electrical conductivity.', 15, 3, 1350, NULL, 'SUGGESTED', '421db8f1-5e17-57c1-86ab-e1eddcb60bf7', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.129469+00');
INSERT INTO public.question_versions VALUES ('225362e8-f8aa-489c-8931-9d3afe4ac749', '8aa5dc71-b188-4310-8ce4-649324d840b6', 1, 'The diagram shows how a student attempts to prepare some hydrogen gas.', 6, 3, 540, NULL, 'SUGGESTED', '421db8f1-5e17-57c1-86ab-e1eddcb60bf7', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.129739+00');
INSERT INTO public.question_versions VALUES ('8e1746d1-6081-4f32-a594-7d806845e694', '1f8ffd9b-8fb0-4c61-8995-78c387b98803', 1, 'When iodine reacts with an excess of chlorine at $ - 8 0^{\circ} \mathrm{C} $ , a compound forms. The percentage composition by mass of this compound is $\mathrm {I} = 5 4. 4 \% \quad \mathrm {C I} = 4 5. 6 \%$', 6, 3, 540, NULL, 'SUGGESTED', '421db8f1-5e17-57c1-86ab-e1eddcb60bf7', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.129981+00');
INSERT INTO public.question_versions VALUES ('aaf44c97-c72a-46c8-91c2-177317285589', 'b2efdb0f-3532-4a10-b96e-f3b410a2b929', 1, 'Bromine, chlorine and iodine are halogens in Group 7 of the Periodic Table. The three halogens have similar chemical properties but different reactivities.', 1, 3, 90, NULL, 'SUGGESTED', '421db8f1-5e17-57c1-86ab-e1eddcb60bf7', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.13024+00');
INSERT INTO public.question_versions VALUES ('9c58c97a-4883-4b3d-8872-32fa18ae1571', '45b88cda-4589-48a3-9d94-1578438c6807', 1, 'A student uses this apparatus to find the mass of magnesium oxide that forms when a strip of magnesium ribbon is burned in air. This is the student''s method. weigh an empty crucible and lid place a coiled strip of freshly cleaned magnesium ribbon in the crucible weigh the crucible, lid and ribbon heat the crucible strongly for several minutes, lifting the lid and quickly replacing it several times leave the crucible, lid and contents to cool and then reweigh', 7, 3, 630, NULL, 'SUGGESTED', '421db8f1-5e17-57c1-86ab-e1eddcb60bf7', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.130482+00');
INSERT INTO public.question_versions VALUES ('51af999b-cdc0-45a7-9306-11b6fda6b629', 'b481680c-6bb7-423d-863d-b8471b5bd912', 1, 'The alkanes are a homologous series of hydrocarbons. The cycloalkanes are another homologous series of hydrocarbons, where the carbon atoms are arranged in a ring structure. Cyclopropane is the simplest cycloalkane. It can be represented as The tables give the names and molecular formulae of the first three members of each series.', 1, 3, 90, NULL, 'SUGGESTED', '421db8f1-5e17-57c1-86ab-e1eddcb60bf7', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.1515+00');
INSERT INTO public.question_versions VALUES ('f28a78aa-097b-450b-b410-08f92d67de6e', '05264118-d612-4a75-8595-32d5c1e152ef', 1, 'A student is given a mixture of two solid ionic compounds, A and B. Each solid contains one cation and one anion. Compound A is insoluble in water. Compound B is soluble in water.', 9, 3, 810, NULL, 'SUGGESTED', '421db8f1-5e17-57c1-86ab-e1eddcb60bf7', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.151998+00');
INSERT INTO public.question_versions VALUES ('566f84af-9423-4ae2-b348-7b11864bb05d', '34e99eda-e25a-481f-81a0-3a57ac37fd87', 1, 'This apparatus can be used to find the volume of dilute sulfuric acid needed to neutralise 25.0 $ cm^{3} $ of aqueous sodium hydroxide, NaOH.', 7, 3, 630, NULL, 'SUGGESTED', '421db8f1-5e17-57c1-86ab-e1eddcb60bf7', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.15457+00');
INSERT INTO public.question_versions VALUES ('c5142013-d1e3-42b5-8c9a-c6188f9809e7', 'ecdc436f-c25b-4c0c-b31d-255e6299a276', 1, 'Lithium is an element in Group 1 of the Periodic Table. Lithium is stored in oil to prevent it from coming into contact with air and water.', 10, 3, 900, NULL, 'SUGGESTED', '421db8f1-5e17-57c1-86ab-e1eddcb60bf7', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.15518+00');
INSERT INTO public.question_versions VALUES ('6a08da0d-f082-4025-8b85-84bb714b00b0', '3ef9971c-ad72-4910-b831-10ec413a6d71', 1, 'Hydrobromic acid can be neutralised by adding sodium hydroxide solution. The equation for the reaction is $\mathrm {H B r} + \mathrm {N a O H} \rightarrow \mathrm {N a B r} + \mathrm {H} _ {2} \mathrm {O}$ A solution of hydrobromic acid has a concentration of $ 0.200\mathrm{mol / dm}^{3}. $', 6, 3, 540, NULL, 'SUGGESTED', '421db8f1-5e17-57c1-86ab-e1eddcb60bf7', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.155506+00');
INSERT INTO public.question_versions VALUES ('f12fdcc3-6746-4b2a-8bba-da89ef2004fd', '32799e47-b62d-4c07-8ac9-b9fbf7c52530', 1, 'Use the Periodic Table on page 2 to help you answer this question.', 5, 3, 450, NULL, 'SUGGESTED', '2f82da9d-2256-5899-9b0c-2139ab00285f', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.391762+00');
INSERT INTO public.question_versions VALUES ('10ac4fd0-1c6a-4547-8ace-e4c71a72902e', '55eb2681-3d36-435e-bf64-0bc8b4ed46a3', 1, 'The diagram shows the arrangement of particles in the three states of matter. Each circle represents a particle. X Y Z', 4, 3, 360, NULL, 'SUGGESTED', '2f82da9d-2256-5899-9b0c-2139ab00285f', 0.75, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.392111+00');
INSERT INTO public.question_versions VALUES ('c04c7d53-f409-4370-89d3-075066c3851d', '14a5173e-eeb6-4a87-a452-62d13793b700', 1, 'A student places a few purple crystals at the bottom of a beaker containing some cold water. The crystals start to dissolve. ( a ) State how the appearance of the crystals and the water change as the crystals dissolve. (2) crystals...', 6, 3, 540, NULL, 'SUGGESTED', '2f82da9d-2256-5899-9b0c-2139ab00285f', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.392325+00');
INSERT INTO public.question_versions VALUES ('a755d7f2-eafc-485a-ae43-f43f5930a36b', '3e242268-67aa-41ba-809d-d3dc92ee4f95', 1, 'The maximum mass of a solid that dissolves in 100g of water at a given temperature is called its solubility. The table gives the solubility of potassium nitrate at six different temperatures.', 7, 3, 630, NULL, 'SUGGESTED', '2f82da9d-2256-5899-9b0c-2139ab00285f', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.39254+00');
INSERT INTO public.question_versions VALUES ('618f9ef2-fae4-47a1-afaf-98bc7e8e6ad0', '21710927-afd3-4998-92f2-c85dbf09f858', 1, 'Crude oil is a liquid that contains a mixture of many hydrocarbons. The diagram shows a fractionating column used in the distillation of crude oil. The six fractions obtained are shown. One use for each of four of the fractions is also shown.', 7, 3, 630, NULL, 'SUGGESTED', '2f82da9d-2256-5899-9b0c-2139ab00285f', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.392811+00');
INSERT INTO public.question_versions VALUES ('43b58121-1d7c-4baf-93f4-732a253e2a67', '13924852-ce97-4a51-8e19-61f0abcb1a62', 1, 'This question is about elements in Groups 1 and 7 of the Periodic Table.', 7, 3, 630, NULL, 'SUGGESTED', '2f82da9d-2256-5899-9b0c-2139ab00285f', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.393047+00');
INSERT INTO public.question_versions VALUES ('fa9775f8-437d-43df-aa85-8ac3ccaebac3', '6405225d-e83f-479d-bae7-087399bef1fb', 1, 'Copper pyrites is an ore of copper that contains copper, iron and sulfur.', 9, 3, 810, NULL, 'SUGGESTED', '2f82da9d-2256-5899-9b0c-2139ab00285f', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.393254+00');
INSERT INTO public.question_versions VALUES ('a9c7a942-df05-450c-810e-39dc3972f5cf', 'a6b80491-2623-4737-bb9a-7a49cffce86e', 1, 'In an experiment, a student adds a piece of zinc to some dilute hydrochloric acid in a test tube. The student measures the temperature before adding the zinc. After adding the zinc, he stirs the mixture and measures the highest temperature reached. The diagram shows his results.', 7, 3, 630, NULL, 'SUGGESTED', '2f82da9d-2256-5899-9b0c-2139ab00285f', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.393491+00');
INSERT INTO public.question_versions VALUES ('22e44633-70ce-4ed7-947a-92319886c977', '83072b39-2816-44ec-ae58-b765ddd7c48c', 1, 'The ions present in ionic compounds can be identified using simple tests. some cations (positive ions) can be identified using a flame test some anions (negative ions) can be identified by observing reactions in solutions of the compounds Table 1 shows the flame test colours for four cations. Table 1 Table 2 shows the results of three tests used to identify anions in solution. Use the information in the tables to answer these questions.', 8, 3, 720, NULL, 'SUGGESTED', '2f82da9d-2256-5899-9b0c-2139ab00285f', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.393767+00');
INSERT INTO public.question_versions VALUES ('36796899-418f-478b-9c2c-20e295c91fa0', '2a4d5d3a-27dc-4d5b-aa91-b2c77b1d2f35', 1, 'A student uses this apparatus to investigate the heat energy released when nitric acid is added to potassium hydroxide solution. She uses this method. put $ 2 5. 0 \mathrm{c m}^{3} $ of potassium hydroxide solution into the polystyrene cup measure the temperature of the potassium hydroxide solution add 5.00 $ cm^{3} $ of nitric acid from the burette stir the mixture and measure the highest temperature reached add further 5.00 $ cm^{3} $ samples of nitric acid, stir and measure the highest temperature reached after each addition', 7, 3, 630, NULL, 'SUGGESTED', '2f82da9d-2256-5899-9b0c-2139ab00285f', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.394006+00');
INSERT INTO public.question_versions VALUES ('0fa51730-9bd5-4284-b1ea-54550db9c1c1', 'dfe757d7-f715-4b2b-ab00-5d0369919902', 1, 'This question is about titanium and its compounds.', 1, 3, 90, NULL, 'SUGGESTED', '2f82da9d-2256-5899-9b0c-2139ab00285f', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.394217+00');
INSERT INTO public.question_versions VALUES ('5ad04d8f-3ca4-4337-a4b0-9e7fe49160e4', 'd79d3cd7-db0b-46e6-a531-a7f9c1d47cb7', 1, 'A mixture of carbon monoxide, carbon dioxide and hydrogen is known in industry as synthesis gas. Synthesis gas is converted to methanol, $ \mathrm{C H_{3} O H} $ , by passing it over a heated solid catalyst. The equations for the two reactions are $\begin{array}{l l l l} \mathrm {R e a c t i o n 1} & \mathrm {C O (g)} + 2 \mathrm {H} _ {2} (\mathrm {g}) \rightleftharpoons \mathrm {C H} _ {3} \mathrm {O H} (\mathrm {g}) & \Delta H = - 9 1 \mathrm {k J / m o l} \\ \mathrm {R e a c t i o n 2} & \mathrm {C O} _ {2} (\mathrm {g}) + 3 \mathrm {H} _ {2} (\mathrm {g}) \rightleftharpoons \mathrm {C H} _ {3} \mathrm {O H} (\mathrm {g}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {g}) & \Delta H = - 4 9 \mathrm {k J / m o l} \end{array}$', 1, 3, 90, NULL, 'SUGGESTED', '2f82da9d-2256-5899-9b0c-2139ab00285f', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.394438+00');
INSERT INTO public.question_versions VALUES ('321f77b0-0d00-4ba4-a059-321fa2b22a99', '725e814f-ea47-4208-bdca-f18df26e645e', 1, 'Calcium carbonate decomposes when heated. The equation for the reaction is $\mathrm {C a C O} _ {3} \rightarrow \mathrm {C a O} + \mathrm {C O} _ {2}$', 10, 3, 900, NULL, 'SUGGESTED', '2f82da9d-2256-5899-9b0c-2139ab00285f', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.394723+00');
INSERT INTO public.question_versions VALUES ('9aacadca-07e9-4e70-9b23-d64c28d357d4', '0c0f9553-3103-4000-b89b-0d12c89eb46f', 1, 'The table shows the displayed formulae of six hydrocarbons, Q, R, S, T, U and V.', 6, 3, 540, NULL, 'SUGGESTED', '2f82da9d-2256-5899-9b0c-2139ab00285f', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.394951+00');
INSERT INTO public.question_versions VALUES ('fbeb2561-bfee-4c74-9d2c-2a2e3898bdcb', '1d9d4789-f60c-4d12-a5f1-62d037aaf3fe', 1, 'The flow diagram shows the main stages in an industrial process to manufacture ammonia.', 1, 3, 90, NULL, 'SUGGESTED', '2f82da9d-2256-5899-9b0c-2139ab00285f', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.395191+00');
INSERT INTO public.question_versions VALUES ('9e1c9e44-7d8e-4f7c-8886-5ec72168db01', '3bab7bba-3159-4b1c-8328-11da89bd850d', 1, 'The mineral rozenite contains crystals of hydrated iron(II) sulfate, $ \mathrm{F e S O_{4}. x H_{2} O} $ She uses this apparatus to remove and collect the water of crystallisation from a sample of iron(II) sulfate crystals. She uses this method. weigh empty tube A to find its mass place a sample of hydrated iron(II) sulfate crystals into tube A and reweigh heat tube A allow tube A to cool and reweigh repeat the process until the mass no longer changes Heating until the mass no longer changes is known as heating to constant mass. When iron(II) sulfate crystals are heated gently, they decompose according to this equation. $\mathrm {F e S O} _ {4}. x \mathrm {H} _ {2} \mathrm {O} \rightarrow \mathrm {F e S O} _ {4} + x \mathrm {H} _ {2} \mathrm {O}$ These are the student''s results. A student wants to find the value of x.', 8, 3, 720, NULL, 'SUGGESTED', '2f82da9d-2256-5899-9b0c-2139ab00285f', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.39541+00');
INSERT INTO public.question_versions VALUES ('8e1815e0-bd02-4e5e-a87d-e42279612717', '438e588f-d86c-456b-ab7d-cdcb13533e96', 1, 'Chromatography can be used to separate the substances in a mixture.', 1, 3, 90, NULL, 'SUGGESTED', 'e6282607-c214-5df2-87e6-5622a573e9b3', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.583254+00');
INSERT INTO public.question_versions VALUES ('514eee14-8d5e-439c-bcd0-4f12610d593d', '9ee658a3-03ca-45ba-b6a7-4e02aa499a9c', 1, 'The diagram shows the apparatus used to prepare carbon dioxide in the laboratory.', 11, 3, 990, NULL, 'SUGGESTED', 'e6282607-c214-5df2-87e6-5622a573e9b3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.583495+00');
INSERT INTO public.question_versions VALUES ('06842925-aeb5-4df0-83ed-5ad1b172d753', '6fb2bd08-af1d-4c8d-a782-d9d30aadff46', 1, 'A teacher investigates the reaction between sodium and water. The teacher fills a trough with water. She adds a few drops of litmus solution to the water, and then adds a piece of sodium.', 6, 3, 540, NULL, 'SUGGESTED', 'e6282607-c214-5df2-87e6-5622a573e9b3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.583736+00');
INSERT INTO public.question_versions VALUES ('be123bdd-9b97-429a-988f-d8cd9d023e61', 'c85707eb-25f8-4e68-b852-5995042cd542', 1, 'Use the Periodic Table on page 2 to help you answer this question.', 7, 3, 630, NULL, 'SUGGESTED', 'e6282607-c214-5df2-87e6-5622a573e9b3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.584+00');
INSERT INTO public.question_versions VALUES ('4c71b834-92ca-49a6-b586-389cddeca81d', 'de8424da-6253-48fc-bf10-170009743389', 1, 'A student tries to make a pure, dry sample of hydrated cobalt(II) chloride crystals. He uses dilute hydrochloric acid and solid cobalt(II) oxide. This is the student''s method. Step 1 pour about $ 5 0 \mathrm{c m}^{3} $ of dilute hydrochloric acid into a beaker Step 2 warm the acid using a Bunsen burner Step 3 add a small amount of cobalt(II) oxide and stir the mixture with a glass rod Step 4 add further small amounts of cobalt(II) oxide until it stops reacting Step 5 filter the final mixture and collect the filtrate in an evaporating basin Step 6 leave the filtrate until all of the water has evaporated His sample of cobalt(II) oxide contains a small amount of a solid impurity that dissolves in water, but does not react with the acid.', 12, 3, 1080, NULL, 'SUGGESTED', 'e6282607-c214-5df2-87e6-5622a573e9b3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.584212+00');
INSERT INTO public.question_versions VALUES ('9f2c71a8-a6b6-4ef6-9308-8714d2189c6c', '1cf6381f-4499-44ba-96d3-72b141332936', 1, 'Tests are done on a sample of a solid, X. Solid X contains the ammonium ion, $ \mathrm{N H_{4}^{+}} $ , one other cation and one anion. The table lists details of the tests done on solid X and the observations made for each test.', 5, 3, 450, NULL, 'SUGGESTED', 'e6282607-c214-5df2-87e6-5622a573e9b3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.58441+00');
INSERT INTO public.question_versions VALUES ('66fc9e8e-f943-42ea-939b-ecccefe820ff', '538decdd-ce33-4941-b7db-7a7f1ff7ae0b', 1, 'Poly(chloroethene) is a polymer. It is made from its monomer, chloroethene.', 1, 3, 90, NULL, 'SUGGESTED', '1981e905-d7e8-50c1-9516-a9d91027dbf7', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:40.208912+00');
INSERT INTO public.question_versions VALUES ('295996af-e250-415f-8aea-67961eecb05d', 'e6b0bafb-d929-4caa-81c2-d92630ae0c25', 1, 'Antimony, Sb, is an element in Group 5 of the Periodic Table. The mineral, stibnite, contains antimony sulfide, $ \mathrm{S b_{2} S_{3}} $ Antimony can be obtained from stibnite in a two-stage process. Stage 1 stibnite is roasted in air $\mathrm {S b} _ {2} \mathrm {S} _ {3} + 5 \mathrm {O} _ {2} \rightarrow \mathrm {S b} _ {2} \mathrm {O} _ {4} + 3 \mathrm {S O} _ {2}$ Stage 2 the oxide produced is heated with carbon to form antimony and carbon dioxide (a) (i) State why the sulfur in stage 1 is said to be oxidised. (ii) Complete the equation for the reaction in stage 2. $\mathrm {S b} _ {2} \mathrm {O} _ {4} + \dots \dots \dots \mathrm {C} \rightarrow \dots \dots \dots \mathrm {S b} + \dots \dots \dots \mathrm {C O} _ {2}$', 7, 3, 630, NULL, 'SUGGESTED', 'e6282607-c214-5df2-87e6-5622a573e9b3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.584606+00');
INSERT INTO public.question_versions VALUES ('91351abf-1ac9-475e-9238-e46f444c5897', 'bee8a99d-6e1b-49a3-b387-3babab69de21', 1, 'A student investigates the rate of reaction between zinc and hydrochloric acid, using an excess of zinc powder. She uses this apparatus. The student measures the volume of gas in the syringe every minute for ten minutes. The table shows her results.', 11, 3, 990, NULL, 'SUGGESTED', 'e6282607-c214-5df2-87e6-5622a573e9b3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.584843+00');
INSERT INTO public.question_versions VALUES ('c52e146b-8e10-4966-bfa0-984dc37f7381', 'c16365b8-22e1-4220-839c-979e13cbe362', 1, 'This apparatus is used to test whether magnesium, solid magnesium chloride and an aqueous solution of magnesium chloride conduct electricity. The table shows the results. Explain these results, with reference to the type of particles in each substance.', 6, 3, 540, NULL, 'SUGGESTED', 'e6282607-c214-5df2-87e6-5622a573e9b3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.585033+00');
INSERT INTO public.question_versions VALUES ('6213a511-d3ea-4e41-b4a0-9237c48d7f19', '77cdc0e3-9d43-4d5f-8ddc-65252e3e9021', 1, 'Bromine is a red-brown liquid at room temperature. Liquid bromine forms a brown gas when warmed.', 8, 3, 720, NULL, 'SUGGESTED', 'e6282607-c214-5df2-87e6-5622a573e9b3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.585223+00');
INSERT INTO public.question_versions VALUES ('e153fe42-2c55-4021-83ed-609a9fab92e3', 'c76d5f3b-c615-4e83-8c91-dd1f58dcf224', 1, 'Malachite is an ore of copper containing copper(II) carbonate and several other compounds that are insoluble in water. You are supplied with several pieces of malachite, these chemicals and items of apparatus. Chemicals: dilute sulfuric acid magnesium powder Apparatus: beakers filter funnel and paper pestle and mortar Describe how you would use the chemicals and the apparatus to obtain a sample of copper from the malachite.', 6, 3, 540, NULL, 'SUGGESTED', 'e6282607-c214-5df2-87e6-5622a573e9b3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.585409+00');
INSERT INTO public.question_versions VALUES ('9119dc6f-2429-41c9-951b-652e21aab5a3', '11a8b2a8-bdeb-4542-b068-8ce3ed7b2c84', 1, 'Crude oil is a mixture of hydrocarbons. Fractional distillation of crude oil and cracking of hydrocarbon fractions are two of the processes used in an oil refinery.', 1, 3, 90, NULL, 'SUGGESTED', 'e6282607-c214-5df2-87e6-5622a573e9b3', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.58563+00');
INSERT INTO public.question_versions VALUES ('264db746-a1f9-4a51-a458-87533a17459b', '96d00202-e9e5-45d3-a564-0db33b8dace7', 1, 'A student investigates the reaction between zinc and dilute sulfuric acid. She uses this method. put $ 5 0 \mathrm{c m}^{3} $ of dilute sulfuric acid into a polystyrene cup measure the initial temperature of the acid add 2.0g of zinc to the acid and stir the mixture measure the temperature of the mixture after one minute The student does the experiment three times. For each experiment, she uses the same size pieces of zinc but different concentrations of sulfuric acid. The diagram shows the temperatures for each experiment. Experiment 1 1. 0 mol/dm $ ^{3} $ $ \mathrm{H_{2} S O_{4}} $ temperature after one minute Experiment 3', 10, 3, 900, NULL, 'SUGGESTED', 'e6282607-c214-5df2-87e6-5622a573e9b3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.585876+00');
INSERT INTO public.question_versions VALUES ('2928ad41-d3b5-465c-84b8-8b1874876324', '472ece6c-00f5-4478-a8df-eedbada0c81f', 1, 'Iron deficiency anaemia occurs when the body does not have enough iron(II) ions. Iron deficiency can be overcome by taking iron tablets. weigh an iron tablet dissolve the tablet in an excess of dilute sulfuric acid titrate the solution with potassium permanganate solution, $ \mathrm{K M n O}_{4} $ The table shows her results. A chemist wants to find out the percentage of iron(II) ion $ \mathrm{(F e^{2+})} $ in an iron tablet. She uses this method.', 5, 3, 450, NULL, 'SUGGESTED', 'e6282607-c214-5df2-87e6-5622a573e9b3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.586065+00');
INSERT INTO public.question_versions VALUES ('88f6abc5-b131-485d-8073-5509f119a4b7', '9607d2fa-0ccd-4385-8234-50b5b045dc7b', 1, 'A teacher uses this apparatus to demonstrate the electrolysis of molten zinc chloride. crystals of a shiny, grey solid form at one of the electrodes a pale green substance forms at the other electrode the lamp goes out after the teacher stops heating the zinc chloride A student records these observations.', 8, 3, 720, NULL, 'SUGGESTED', 'e6282607-c214-5df2-87e6-5622a573e9b3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:56.58625+00');
INSERT INTO public.question_versions VALUES ('cf300eaf-85dd-46d6-ae4b-ff8c8d448635', 'bfee685c-ba40-4e34-9965-1a81b108c2f5', 1, 'The three states of matter are solid, liquid and gas.', 1, 3, 90, NULL, 'SUGGESTED', '0c94e0a6-766f-56a3-bb38-ed4990e43cb2', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:39.651909+00');
INSERT INTO public.question_versions VALUES ('885d42ce-189d-4e6b-802f-b41f33199972', '018ad585-425f-4695-940d-93fba33a791e', 1, 'Rock salt is a mixture of the soluble salt, sodium chloride, and some insoluble impurities. The diagram shows the first three stages of a method used to obtain pure sodium chloride from rock salt. Stage 1 rock salt crushed Stage2 crushed rock salt added to water Stage 3', 9, 3, 810, NULL, 'SUGGESTED', '0c94e0a6-766f-56a3-bb38-ed4990e43cb2', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:39.653657+00');
INSERT INTO public.question_versions VALUES ('3d42e1bd-6526-4947-8868-d2d6dc4cead8', '66a376e8-3af5-4e64-82d9-490ea315aebf', 1, 'Crude oil is a mixture of hydrocarbons.', 1, 3, 90, NULL, 'SUGGESTED', '0c94e0a6-766f-56a3-bb38-ed4990e43cb2', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:39.654118+00');
INSERT INTO public.question_versions VALUES ('2e6f8d70-4c6c-4548-8ea1-c55e5cfb1894', '557ba27c-556a-40f4-b2fb-fa5742c80024', 1, '(a) (i) Explain what is meant by the term covalent bonding. (ii) Draw a dot and cross diagram to show the bonding in a molecule of ethene, $ \mathrm{C_{2} H_{4}} $ Show only the outer electrons.', 11, 3, 990, NULL, 'SUGGESTED', '0c94e0a6-766f-56a3-bb38-ed4990e43cb2', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:39.654503+00');
INSERT INTO public.question_versions VALUES ('65909494-dc3f-4fea-886f-3f39d764ece9', '3c0a3f02-c8a8-4543-aea2-44a5fc4c9a97', 1, 'Hot, molten sulfur reacts with oxygen to form sulfur dioxide gas.', 10, 3, 900, NULL, 'SUGGESTED', '0c94e0a6-766f-56a3-bb38-ed4990e43cb2', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:39.654871+00');
INSERT INTO public.question_versions VALUES ('321debd4-fa2d-40da-8045-cd27da6e6dad', 'c2dffa08-e04f-4a43-881b-c55f84d989fd', 1, 'A student investigates the rate of the reaction between magnesium ribbon and dilute hydrochloric acid. The products are magnesium chloride and hydrogen.', 1, 3, 90, NULL, 'SUGGESTED', '0c94e0a6-766f-56a3-bb38-ed4990e43cb2', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:39.655266+00');
INSERT INTO public.question_versions VALUES ('b16c4d2a-7c7b-4e65-bb71-059a57c29c9f', 'e67c9e47-9b8c-47ea-a3bd-e19a1a539064', 1, 'In the Periodic Table, the vertical columns of elements are called groups.', 14, 3, 1260, NULL, 'SUGGESTED', '0c94e0a6-766f-56a3-bb38-ed4990e43cb2', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:39.655623+00');
INSERT INTO public.question_versions VALUES ('ca4b58e6-9604-4be2-86c0-6d8ae33e1bac', 'b491d7a4-1cbc-493c-8a7f-44456cd4453f', 1, 'The table shows information about the effect of adding sodium hydroxide solution to solutions containing zinc ions, calcium ions or aluminium ions.', 15, 3, 1350, NULL, 'SUGGESTED', '0c94e0a6-766f-56a3-bb38-ed4990e43cb2', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:39.656063+00');
INSERT INTO public.question_versions VALUES ('8d3e4c8c-630b-4aff-95a1-beede646087f', '02995f08-920f-4564-8cb3-5ffdc6fe42e7', 1, 'Some metals can be obtained by heating their oxides with carbon.', 12, 3, 1080, NULL, 'SUGGESTED', '0c94e0a6-766f-56a3-bb38-ed4990e43cb2', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:39.656579+00');
INSERT INTO public.question_versions VALUES ('ca276482-b38b-4c33-b7b9-4ec8f3aa78bb', '30f5f1a6-0dbc-474e-a07e-5c5d01215671', 1, 'A student uses this apparatus to investigate the rate of reaction between marble chips and dilute hydrochloric acid.', 13, 3, 1170, NULL, 'SUGGESTED', '1981e905-d7e8-50c1-9516-a9d91027dbf7', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:40.208643+00');
INSERT INTO public.question_versions VALUES ('c5280ac6-9521-4b6d-ac62-4c4cefc69426', '4d4cccc8-b179-4ed0-afba-c7b6dd5e6ee8', 1, 'A student does a titration to find the concentration of a solution of aqueous ammonia. He uses this method. use a pipette to add 25.0 $ cm^{3} $ samples of the solution into a conical flask add a few drops of indicator add sulfuric acid from a burette until the indicator changes colour permanently repeat the titration three more times', 13, 3, 1170, NULL, 'SUGGESTED', '0c94e0a6-766f-56a3-bb38-ed4990e43cb2', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:39.656958+00');
INSERT INTO public.question_versions VALUES ('33284ecd-2cd9-4d68-a716-b4825c6ae45d', 'ed59eaa2-e2db-489e-a04c-4a2961dbb385', 1, 'Potassium permanganate is a purple solid that is soluble in water. start after a short time A crystal of potassium permanganate is placed in a beaker containing water.', 4, 3, 360, NULL, 'SUGGESTED', '04d61f97-b7f6-5a86-bace-1a7e4a6797dd', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:39.969537+00');
INSERT INTO public.question_versions VALUES ('5e46f131-32ef-4906-a5a6-40f01b90a8cf', '89515ee9-23dc-42e9-a2ea-cf8eaebc11b6', 1, 'The diagram shows part of the Periodic Table, with elements represented by the letters L, M, Q, R and T. The letters in the diagram represent elements but are not their chemical symbols.', 4, 3, 360, NULL, 'SUGGESTED', '04d61f97-b7f6-5a86-bace-1a7e4a6797dd', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:39.970935+00');
INSERT INTO public.question_versions VALUES ('190d28ce-0d1c-403c-901f-2da0cdb957d6', '1a846432-9de3-474c-8b56-bd05794028ec', 1, 'A student does these two tests on a solution made from a white solid. flame test add acidified silver nitrate solution The table shows his results.', 6, 3, 540, NULL, 'SUGGESTED', '04d61f97-b7f6-5a86-bace-1a7e4a6797dd', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:39.971616+00');
INSERT INTO public.question_versions VALUES ('73533b44-b751-42bb-8b07-c331b0529559', '4cd7fa49-2bcc-4354-95f4-56312089a7c7', 1, 'A student uses this apparatus to investigate the colours in four different inks, A, B, C and D.', 8, 3, 720, NULL, 'SUGGESTED', '04d61f97-b7f6-5a86-bace-1a7e4a6797dd', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:39.971991+00');
INSERT INTO public.question_versions VALUES ('94414b11-2662-460f-ae5d-6220a1c8350f', 'f45eebe1-12c8-4262-a142-f8ccb422d4d0', 1, 'In 1937 an airship full of hydrogen gas flew from Germany to America.', 5, 3, 450, NULL, 'SUGGESTED', '04d61f97-b7f6-5a86-bace-1a7e4a6797dd', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:39.972298+00');
INSERT INTO public.question_versions VALUES ('f4537e82-cd50-486e-adc0-d8f96174bebb', '98823a78-dd67-464c-8c02-c4ecce5a679e', 1, 'The reactions of metals with water and with dilute sulfuric acid can be used to determine the order of reactivity of the metals. The table shows the reactions of four metals, W, X, Y and Z, with water and with dilute sulfuric acid.', 5, 3, 450, NULL, 'SUGGESTED', '04d61f97-b7f6-5a86-bace-1a7e4a6797dd', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:39.972585+00');
INSERT INTO public.question_versions VALUES ('d58d9e88-4083-404f-8464-fb1cdd51095f', '151bb8c0-4874-4275-bdaa-41586a27994b', 1, 'Diamond, graphite and silicon dioxide all have giant covalent structures. The diagram shows the structures of these three substances. diamond graphite silicon dioxide', 6, 3, 540, NULL, 'SUGGESTED', '04d61f97-b7f6-5a86-bace-1a7e4a6797dd', 0.75, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:39.972896+00');
INSERT INTO public.question_versions VALUES ('b6a99796-7b92-47ad-bb24-49be8d03358d', 'e9bfd57c-2977-4d3c-812e-89b4d295d732', 1, 'Ethene $ \left( \mathrm{C}_{2} \mathrm{H}_{4} \right) $ can be converted into chloroethene $ \left( \mathrm{C}_{2} \mathrm{H}_{3} \mathrm{Cl} \right) $ in a two-stage process.', 6, 3, 540, NULL, 'SUGGESTED', '04d61f97-b7f6-5a86-bace-1a7e4a6797dd', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:39.97315+00');
INSERT INTO public.question_versions VALUES ('edcf90e6-a475-4bb8-9f31-b1dbd8a4ff51', '4023f63e-e7a0-47ba-80fa-a09d393f6b0e', 1, 'Halon 1301 is a compound used in some fire extinguishers. Halon 1301 has the percentage composition by mass of C 8.05% Br 53.69% F 38.26%', 6, 3, 540, NULL, 'SUGGESTED', '04d61f97-b7f6-5a86-bace-1a7e4a6797dd', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:39.973402+00');
INSERT INTO public.question_versions VALUES ('0b322388-89f6-41cb-9b15-2ed6e0ce7601', 'fbc85c66-6a77-4cbc-acee-67e0490f55dc', 1, '(a) There are three isomers with the molecular formula $ \mathrm{C_{5} H_{1 2}} $ One of these isomers is pentane. The displayed formula for pentane is (i) State what is meant by the term isomers. (ii) Draw the displayed formula for another isomer of $ \mathrm{C_{5} H_{1 2}} $', 1, 3, 90, NULL, 'SUGGESTED', '04d61f97-b7f6-5a86-bace-1a7e4a6797dd', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:39.974394+00');
INSERT INTO public.question_versions VALUES ('3b85703c-25a9-470c-8a4e-f8c263d83d46', '5d65faff-edda-4053-89c2-9eaee7f404f7', 1, 'The gas burned in a Bunsen burner is methane. The equation for the complete combustion of methane is $\mathrm {C H} _ {4} (\mathrm {g}) + 2 \mathrm {O} _ {2} (\mathrm {g}) \rightarrow \mathrm {C O} _ {2} (\mathrm {g}) + 2 \mathrm {H} _ {2} \mathrm {O} (\mathrm {g})$', 9, 3, 810, NULL, 'SUGGESTED', '04d61f97-b7f6-5a86-bace-1a7e4a6797dd', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:39.97489+00');
INSERT INTO public.question_versions VALUES ('a44734c7-addd-4e85-bf72-83d57671a33a', '569aadfe-1dab-4979-9b90-e1f0dce45d0f', 1, 'A student uses this apparatus to investigate the temperature change that occurs when ammonium nitrate is dissolved in water. She uses this method. put $ 1 0 0 \mathrm{c m}^{3} $ of water into the polystyrene cup and measure the initial temperature of the water add 8.00 g of ammonium nitrate and stir record the lowest temperature reached by the solution The table shows her results. Initial temperature of water in $ ^{\circ} \mathrm{C} $ 20.0 Lowest temperature of solution in $ ^{\circ} \mathrm{C} $ 14.2', 9, 3, 810, NULL, 'SUGGESTED', '04d61f97-b7f6-5a86-bace-1a7e4a6797dd', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:39.975185+00');
INSERT INTO public.question_versions VALUES ('ff600e14-d77d-4107-b136-9fbac81fce06', 'bfdb0065-9e18-4692-af33-0525818f37d1', 1, 'A student uses this apparatus to investigate the rate of reaction between magnesium and an excess of dilute hydrochloric acid. She uses this method. use a graduated beaker to pour $ 50 \mathrm{c m}^{3} $ of dilute hydrochloric acid of concentration 2.00 mol/dm $ ^{3} $ into the conical flask add a piece of magnesium ribbon of mass 0.086 g to the acid and put the bung into the neck of the flask measure the total volume of gas collected every ten seconds until the reaction stops The table shows the student''s results.', 12, 3, 1080, NULL, 'SUGGESTED', '04d61f97-b7f6-5a86-bace-1a7e4a6797dd', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:39.975464+00');
INSERT INTO public.question_versions VALUES ('6c2f1e81-a5a0-4064-9234-f1f15c9f683f', 'ccee64ad-002d-4a51-a7d0-eb15797743bc', 1, 'A salt can be made by reacting an acid with an insoluble base. The student uses this method. Stage 1 pour $ 5 0 \mathrm{c m}^{3} $ of dilute sulfuric acid into a beaker Stage 2 warm the acid using a Bunsen burner Stage 3 add a small amount of copper(II) oxide to the warm acid and stir the mixture Stage 4 add further amounts of copper(II) oxide until copper(II) oxide is in excess Stage 5 filter the mixture Stage 6 obtain crystals from the filtrate A student has a sample of copper(II) oxide.', 14, 3, 1260, NULL, 'SUGGESTED', '04d61f97-b7f6-5a86-bace-1a7e4a6797dd', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:39.975768+00');
INSERT INTO public.question_versions VALUES ('bb91fe62-dacd-4eca-b55c-aea353a1e21d', 'c2eb24f8-0d37-4b41-9f4a-e55c1e4917e8', 1, 'Hydrated ammonium iron(III) sulfate is a violet solid that has the formula $ \mathrm{(N H_{4})_{2} S O_{4}. F e_{2}(S O_{4})_{3}. x H_{2} O} $ The table shows some tests done on three separate samples of the solid.', 9, 3, 810, NULL, 'SUGGESTED', '04d61f97-b7f6-5a86-bace-1a7e4a6797dd', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:39.976041+00');
INSERT INTO public.question_versions VALUES ('e1b3db74-9244-4bbd-b276-1020e5552f7c', '017c1aec-6d7b-4c0f-865f-566f34ecf401', 1, 'This question is about the three states of matter, solid, liquid and gas.', 6, 3, 540, NULL, 'SUGGESTED', '1981e905-d7e8-50c1-9516-a9d91027dbf7', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:40.207522+00');
INSERT INTO public.question_versions VALUES ('3599a42e-ff89-4964-8a30-64c02fd32054', 'f4dae31b-8214-4618-a186-9a50fd4358dd', 1, 'This question is about some elements in Group 1 of the Periodic Table.', 6, 3, 540, NULL, 'SUGGESTED', '1981e905-d7e8-50c1-9516-a9d91027dbf7', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:40.207897+00');
INSERT INTO public.question_versions VALUES ('a8cbb4e6-9dd7-4a11-94bb-170ab8ad87e0', 'f9a72fc3-d690-4ce2-b1c9-a4c4afe7fc01', 1, 'A student uses paper chromatography to investigate the dyes in five different inks, V, W, X, Y and Z. This is what she uses. a beaker a piece of chromatography paper with a pencil line drawn near the bottom of the paper a solvent inks V, W, X, Y and Z', 15, 3, 1350, NULL, 'SUGGESTED', '1981e905-d7e8-50c1-9516-a9d91027dbf7', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:40.208142+00');
INSERT INTO public.question_versions VALUES ('3fb03be1-2a4f-4f40-a388-ece2f3936427', '0d0642ab-751f-4a26-95b0-c7fd577e91ed', 1, 'This question is about hydrocarbons.', 13, 3, 1170, NULL, 'SUGGESTED', '1981e905-d7e8-50c1-9516-a9d91027dbf7', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:40.208375+00');
INSERT INTO public.question_versions VALUES ('200a2b9e-6202-452f-9dbc-7a8641fc1f31', '2fefc7d1-6bdd-4364-9ae6-838ce3860bca', 1, 'A student makes some magnesium nitrate crystals from magnesium oxide and dilute nitric acid. The equation for the reaction is $\mathrm {M g O (s)} + 2 \mathrm {H N O} _ {3} (\mathrm {a q}) \rightarrow \mathrm {M g} \left(\mathrm {N O} _ {3}\right) _ {2} (\mathrm {a q}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {I})$', 14, 3, 1260, NULL, 'SUGGESTED', '1981e905-d7e8-50c1-9516-a9d91027dbf7', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:40.209149+00');
INSERT INTO public.question_versions VALUES ('7b107edc-ec90-4fbb-aedc-ff65061b344c', '720ff0dd-fff0-4fd6-95e0-5e2a4e2ecdd0', 1, 'A student investigates the neutralisation reaction between sodium hydroxide and nitric acid. This is her method. pour $ 2 0 \mathrm{c m}^{3} $ of sodium hydroxide solution into a polystyrene cup record the temperature of the sodium hydroxide solution add 5 $ cm^{3} $ of dilute nitric acid to the cup stir the mixture and record the highest temperature reached add further $ 5 \mathrm{c m}^{3} $ portions of dilute nitric acid, recording the highest temperature reached each time, until a total of $ 4 0 \mathrm{c m}^{3} $ of acid has been added', 9, 3, 810, NULL, 'SUGGESTED', '1981e905-d7e8-50c1-9516-a9d91027dbf7', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:40.209384+00');
INSERT INTO public.question_versions VALUES ('df582d74-93fe-479f-a9d5-73189ff7c911', 'dafde59b-affd-4998-82bd-a827dabc1914', 1, '(a) Diamond is a naturally-occurring form of carbon. It has a giant molecular structure. Explain, with reference to its structure and bonding, why diamond has a high melting point.', 11, 3, 990, NULL, 'SUGGESTED', '1981e905-d7e8-50c1-9516-a9d91027dbf7', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:40.209633+00');
INSERT INTO public.question_versions VALUES ('96eab5e0-c2c0-4c62-b1d7-62cc487c6c49', 'c7bef576-3d0f-4150-9a74-da9cf7cf847c', 1, 'A student investigates the reaction between zinc and copper(II) sulfate solution. The equation for the reaction is $\mathrm {Z n} + \mathrm {C u S O} _ {4} \rightarrow \mathrm {C u} + \mathrm {Z n S O} _ {4}$ This is his method. add exactly 25.0 $ cm^{3} $ of copper(II) sulfate solution to a polystyrene cup record the temperature of the solution add about 5g of zinc powder (an excess) and stir the mixture record the highest temperature reached', 10, 3, 900, NULL, 'SUGGESTED', '1981e905-d7e8-50c1-9516-a9d91027dbf7', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:40.209892+00');
INSERT INTO public.question_versions VALUES ('510a0545-efc9-4a92-9208-b5fc575b3d1e', '24ed3a16-e7f7-4e33-9e82-c059c4c20625', 1, 'This question is about gases in the atmosphere.', 6, 3, 540, NULL, 'SUGGESTED', 'a88d63cf-a49f-5183-8460-a8d7b67f2b09', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:40.396755+00');
