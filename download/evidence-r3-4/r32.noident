INSERT INTO public.questions VALUES ('1f2e317d-4b58-4d33-9f04-d249cda58cae', 'q12-07ced82a', 'STRUCTURED', 'This question is about the metal tantalum, Ta. Tantalum metal can be produced by heating tantalum chloride $ \mathrm{TaCl_{5}} $ and hydrogen gas in a furnace. The other product of the reaction is hydrogen chloride.', 11, 3, 990, NULL, '724a7bac-3b9a-4ce1-86d0-3a8d3165a4a5', 'PAST_PAPER', true, 1, '2026-09-13 12:57:40.992213+00', '21a01adc-71f6-41a2-9829-7e04de46cc2a');
