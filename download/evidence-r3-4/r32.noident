INSERT INTO public.question_versions VALUES ('10f43bf5-12e9-431c-926d-7e5a5acc8a83', '4d68a13c-0d89-4560-947c-d02fd3ce6c2d', 1, 'The apparatus in the diagram is used to collect the oxygen produced by the decomposition of hydrogen peroxide, $ \mathrm{H_{2}O_{2}} $', 1, 3, 90, NULL, 'SUGGESTED', '6fa6e7ba-8094-5e7d-925e-0674ce769e05', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:41:17.91587+00');
INSERT INTO public.question_versions VALUES ('ca0899df-7cb1-43d1-ab8d-0465f3264365', '61088d7c-f338-44ec-8b45-adae34e906f2', 1, 'The element carbon has three common isotopes. These are carbon-12, carbon-13 and carbon-14.', 8, 3, 720, NULL, 'SUGGESTED', '6fa6e7ba-8094-5e7d-925e-0674ce769e05', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:41:17.91616+00');
INSERT INTO public.question_versions VALUES ('ef31d566-738a-42be-aaec-fbd04c56adde', '5d0b6f4a-cfb8-49f7-bb66-2d245bff7f09', 1, 'Decane is a hydrocarbon found in crude oil. The diagram shows the structure of a decane molecule.', 1, 3, 90, NULL, 'SUGGESTED', '6fa6e7ba-8094-5e7d-925e-0674ce769e05', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:41:17.916437+00');
INSERT INTO public.question_versions VALUES ('313a6210-bbe7-4082-afd1-7b0232a085dd', '8bc5fa65-d6b9-4dab-a300-612c6b8c485b', 1, 'When ammonia gas and hydrogen chloride gas mix, they react together to form a white solid called ammonium chloride. The equation for the reaction is: $\mathrm {N H} _ {3} (\mathrm {g}) + \mathrm {H C l} (\mathrm {g}) \rightarrow \mathrm {N H} _ {4} \mathrm {C l} (\mathrm {s})$ After five minutes, a white ring of solid ammonium chloride formed. A cotton wool pad was soaked in ammonia solution and another was soaked in hydrogen chloride solution. The two pads were then put into opposite ends of a dry glass tube at the same time.', 6, 3, 540, NULL, 'SUGGESTED', '6fa6e7ba-8094-5e7d-925e-0674ce769e05', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:41:17.91673+00');
INSERT INTO public.question_versions VALUES ('e1272b57-1eb2-4d32-8f9c-bb10a07daec5', 'da9fb9e6-c5e9-4b44-b2dc-19374ced90dd', 1, 'When water is added to a mixture of sand and cement, a reaction takes place between silicon dioxide in the sand and calcium oxide in the cement. The reaction produces a salt called calcium silicate. The equation for the reaction is: $\mathrm {S i O} _ {2} + \mathrm {C a O} \rightarrow \mathrm {C a S i O} _ {3}$', 8, 3, 720, NULL, 'SUGGESTED', '6fa6e7ba-8094-5e7d-925e-0674ce769e05', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:41:17.916995+00');
INSERT INTO public.question_versions VALUES ('d983e228-53c3-47dc-8ff0-0e4c6422ba9a', 'fde66226-0408-4d94-9480-f22e54b628a0', 1, 'When sodium is burned in air, one of the products is a pale yellow solid, X.', 1, 3, 90, NULL, 'SUGGESTED', '6fa6e7ba-8094-5e7d-925e-0674ce769e05', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:41:17.917275+00');
INSERT INTO public.question_versions VALUES ('69f0ce0f-eb8e-4ff1-8c30-24db81274d2c', '2de89e5e-09ab-4b9d-b08e-b96ecd3ebecd', 1, 'A student carried out a series of tests on a solid, M, in order to identify the ions that could be present. The table shows her results.', 10, 3, 900, NULL, 'SUGGESTED', '6fa6e7ba-8094-5e7d-925e-0674ce769e05', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:41:17.917526+00');
INSERT INTO public.question_versions VALUES ('07957575-0bf5-4087-9874-8b4311c1fbdd', '5f877ccf-ee6d-4928-9468-ee3da8c1bc1e', 1, 'Lead can be extracted from lead(II) sulfide, PbS, in two stages. Stage 1: Lead(II) sulfide is heated in air. It reacts with oxygen to produce lead(II) oxide and sulfur dioxide. Stage 2: The lead(II) oxide is then heated in a blast furnace with coke.', 11, 3, 990, NULL, 'SUGGESTED', '6fa6e7ba-8094-5e7d-925e-0674ce769e05', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:41:17.921226+00');
INSERT INTO public.question_versions VALUES ('ab92afb2-2fad-4a6c-9d39-e25542bdbb00', '0c58cfea-c3bf-4b41-8e3c-c2f0ae7a17ac', 1, '(a) Crystals of hydrated zinc sulfate, $ \mathrm{Z n S O_{4}. x H_{2} O} $ , contain water of crystallisation. He weighed the empty tube A. He placed a sample of hydrated zinc sulfate crystals in tube A and reweighed it. He heated the tube, allowed it to cool and weighed it again. He repeated this process until two consecutive masses were the same. This is known as ''heating to constant mass''. When hydrated zinc sulfate crystals are heated gently, they decompose according to the following equation: $\mathrm {Z n S O} _ {4}. \mathrm {x H} _ {2} \mathrm {O} \rightarrow \mathrm {Z n S O} _ {4} + \mathrm {x H} _ {2} \mathrm {O}$ The following masses were recorded: $\mathrm {M a s s o f t u b e A} = 1 0. 1 2 \mathrm {g}$ $\mathrm {M a s s o f t u b e A} + \mathrm {Z n S O} _ {4}. \mathrm {x H} _ {2} \mathrm {O} = 1 8. 7 3 \mathrm {g}$ Mass of tube A and $ \mathrm{Z n S O_{4}} $ after heating to constant mass = 14.95 g (i) Calculate the mass of $ \mathrm{Z n S O}_{4} $ formed after heating to constant mass. (ii) Calculate the mass of water collected after heating to constant mass. (iii) The relative formula mass of $ \mathrm{Z n S O_{4}} $ is 161 The relative formula mass of water is 18 Use this information, and your answers to (a)(i) and (a)(ii), to calculate the value of x in the formula $ \mathrm{Z n S O_{4}. x H_{2}O} $ Show your working. A student used the apparatus shown to remove and collect the water of crystallisation from the crystals in order to find the value of x.', 8, 3, 720, NULL, 'SUGGESTED', '6fa6e7ba-8094-5e7d-925e-0674ce769e05', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:41:17.924368+00');
INSERT INTO public.question_versions VALUES ('9028756f-1d09-4c44-88f1-47e8a7a987b2', '800d6a4e-2566-4836-8738-76ee4c8059cf', 1, 'This question is about the element beryllium.', 9, 3, 810, NULL, 'SUGGESTED', '06a1d491-4b40-5421-8a8c-e37da09a1a47', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:24.995236+00');
INSERT INTO public.question_versions VALUES ('fd05f554-0ffb-45ff-8da8-0047980ec518', 'd5474b1d-377a-4076-8037-a74c39f7a12f', 1, 'The halogens are elements in Group 7 of the Periodic Table.', 6, 3, 540, NULL, 'SUGGESTED', '06a1d491-4b40-5421-8a8c-e37da09a1a47', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:24.99679+00');
