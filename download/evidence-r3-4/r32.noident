INSERT INTO public.questions VALUES ('c2d5ecb6-ca1b-44c7-9662-0d88b0eb20bf', 'q08-87d9135e', 'STRUCTURED', 'When lithium is burned in air, the two compounds lithium oxide (Li $ _{2} $ O) and lithium nitride (Li $ _{3} $ N) are formed. Both compounds are ionic and their ions can be represented by dot and cross diagrams. The dot and cross diagram for the ions in lithium oxide is $\left[ \left. \mathrm {O} \right. \right] ^ {2 -}$', 9, 3, 810, NULL, '4f9c3fe1-1c15-4362-b2d0-42c9ec72f3d6', 'PAST_PAPER', true, 1, '2026-09-13 12:52:26.060992+00', 'b641fc84-97bd-45ae-9e7f-bb2ed398ab79');
