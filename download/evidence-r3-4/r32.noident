INSERT INTO public.question_versions VALUES ('7c6dd546-9d3e-4e24-a34c-2e719e5af13e', '9e71ba8d-44bc-4171-80db-cbc5fdcdf176', 1, 'A student uses this apparatus to investigate the rate of reaction between dilute sulfuric acid and an excess of small pieces of zinc. This is the student''s method. Step 1 use 50 $ cm^{3} $ of dilute sulfuric acid Step 2 add approximately 5 g of small zinc pieces to the sulfuric acid Step 3 quickly connect the gas syringe Step 4 record the reading on the gas syringe every 30 seconds until the reaction stops', 13, 3, 1170, NULL, 'SUGGESTED', '07ced82a-b11c-5b09-893f-83ae8349697b', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:57:40.990437+00');
