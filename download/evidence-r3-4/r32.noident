INSERT INTO public.document_chunks VALUES ('00ffbccc-c4ae-4e76-a613-6305e3a00d4a', '0622fc85-70d0-46e1-9c3e-f563d2b9d4bd', 0, 'Please check the examination details below before entering your candidate information
