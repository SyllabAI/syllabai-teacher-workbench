INSERT INTO public.question_parts VALUES ('2b39ab0c-b668-4e49-ace5-cef824ad031a', '3153cfb5-0a73-48ee-b50e-131d1df32390', 'b', 'Which of these substances is a compound? A air B hydrogen C oxygen D water', NULL, 0, 1, '2026-09-13 12:53:55.674163+00');
INSERT INTO public.question_parts VALUES ('fd78d955-51db-4dbf-9bf1-b71ef65ca7ef', '3153cfb5-0a73-48ee-b50e-131d1df32390', 'c', 'Which of these methods is used to obtain water from a mixture containing salt and water? A crystallisation B filtration C simple distillation D titration', NULL, 0, 2, '2026-09-13 12:53:55.674234+00');
INSERT INTO public.question_parts VALUES ('dcdabe0e-f6b4-4517-b063-1416b46e806e', '3153cfb5-0a73-48ee-b50e-131d1df32390', 'd', 'Paper chromatography is used to separate the dyes present in some inks. A sample of ink, P, is spotted on to some chromatography paper. Four known inks, A, B, C and D, are also spotted on to the same paper. The diagram shows how the experiment is set up and the paper at the end of the experiment. at beginning at end', NULL, 0, 3, '2026-09-13 12:53:55.674294+00');
INSERT INTO public.question_parts VALUES ('2c1fe220-b9dc-49aa-af97-7ceb6323413b', '3153cfb5-0a73-48ee-b50e-131d1df32390', 'd-i', 'State why the solvent level should not be above the base line at the start of the experiment.', NULL, 0, 4, '2026-09-13 12:53:55.674354+00');
