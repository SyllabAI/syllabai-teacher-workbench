INSERT INTO public.document_chunks VALUES ('15528aa6-46b3-4317-85f1-9c7d3962d0be', 'ac2aba36-9617-4bd6-9812-9e3e35a87702', 2, '$ ^{*} $ The lanthanoids (atomic numbers 58-71) and the actinoids (atomic numbers 90-103) have been omitted.
The relative atomic masses of copper and chlorine have not been rounded to the nearest whole number.
