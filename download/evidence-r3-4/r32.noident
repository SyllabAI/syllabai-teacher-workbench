INSERT INTO public.questions VALUES ('6405225d-e83f-479d-bae7-087399bef1fb', 'q07-2f82da9d', 'STRUCTURED', 'Copper pyrites is an ore of copper that contains copper, iron and sulfur.', 9, 3, 810, NULL, '4db63338-5d31-45b9-87ca-c5e5ae693ae1', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.393158+00', '5cd177ba-bfaf-4adc-8e89-e65c40880fe3');
INSERT INTO public.questions VALUES ('a6b80491-2623-4737-bb9a-7a49cffce86e', 'q08-2f82da9d', 'STRUCTURED', 'In an experiment, a student adds a piece of zinc to some dilute hydrochloric acid in a test tube. The student measures the temperature before adding the zinc. After adding the zinc, he stirs the mixture and measures the highest temperature reached. The diagram shows his results.', 7, 3, 630, NULL, '4db63338-5d31-45b9-87ca-c5e5ae693ae1', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.393359+00', '5cd177ba-bfaf-4adc-8e89-e65c40880fe3');
INSERT INTO public.questions VALUES ('83072b39-2816-44ec-ae58-b765ddd7c48c', 'q09-2f82da9d', 'STRUCTURED', 'The ions present in ionic compounds can be identified using simple tests. some cations (positive ions) can be identified using a flame test some anions (negative ions) can be identified by observing reactions in solutions of the compounds Table 1 shows the flame test colours for four cations. Table 1 Table 2 shows the results of three tests used to identify anions in solution. Use the information in the tables to answer these questions.', 8, 3, 720, NULL, '4db63338-5d31-45b9-87ca-c5e5ae693ae1', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.393632+00', '5cd177ba-bfaf-4adc-8e89-e65c40880fe3');
INSERT INTO public.questions VALUES ('2a4d5d3a-27dc-4d5b-aa91-b2c77b1d2f35', 'q10-2f82da9d', 'STRUCTURED', 'A student uses this apparatus to investigate the heat energy released when nitric acid is added to potassium hydroxide solution. She uses this method. put $ 2 5. 0 \mathrm{c m}^{3} $ of potassium hydroxide solution into the polystyrene cup measure the temperature of the potassium hydroxide solution add 5.00 $ cm^{3} $ of nitric acid from the burette stir the mixture and measure the highest temperature reached add further 5.00 $ cm^{3} $ samples of nitric acid, stir and measure the highest temperature reached after each addition', 7, 3, 630, NULL, '4db63338-5d31-45b9-87ca-c5e5ae693ae1', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.393892+00', '5cd177ba-bfaf-4adc-8e89-e65c40880fe3');
INSERT INTO public.questions VALUES ('dfe757d7-f715-4b2b-ab00-5d0369919902', 'q11-2f82da9d', 'STRUCTURED', 'This question is about titanium and its compounds.', 1, 3, 90, NULL, '4db63338-5d31-45b9-87ca-c5e5ae693ae1', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.394116+00', '5cd177ba-bfaf-4adc-8e89-e65c40880fe3');
INSERT INTO public.questions VALUES ('d79d3cd7-db0b-46e6-a531-a7f9c1d47cb7', 'q12-2f82da9d', 'STRUCTURED', 'A mixture of carbon monoxide, carbon dioxide and hydrogen is known in industry as synthesis gas. Synthesis gas is converted to methanol, $ \mathrm{C H_{3} O H} $ , by passing it over a heated solid catalyst. The equations for the two reactions are $\begin{array}{l l l l} \mathrm {R e a c t i o n 1} & \mathrm {C O (g)} + 2 \mathrm {H} _ {2} (\mathrm {g}) \rightleftharpoons \mathrm {C H} _ {3} \mathrm {O H} (\mathrm {g}) & \Delta H = - 9 1 \mathrm {k J / m o l} \\ \mathrm {R e a c t i o n 2} & \mathrm {C O} _ {2} (\mathrm {g}) + 3 \mathrm {H} _ {2} (\mathrm {g}) \rightleftharpoons \mathrm {C H} _ {3} \mathrm {O H} (\mathrm {g}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {g}) & \Delta H = - 4 9 \mathrm {k J / m o l} \end{array}$', 1, 3, 90, NULL, '4db63338-5d31-45b9-87ca-c5e5ae693ae1', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.394323+00', '5cd177ba-bfaf-4adc-8e89-e65c40880fe3');
