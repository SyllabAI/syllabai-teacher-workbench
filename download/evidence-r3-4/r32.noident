te", "text": "(b)"}, {"kind": "note", "text": "(the box contains)(2) different substances"}, {"kind": "note", "text": "/elements"}, {"kind": "ignore", "text": "IGNORE type of particle"}, {"kind": "note", "text": "REJECT compounds"}, {"kind": "note", "text": "(c)"}, {"kind": "note", "text": "Any two from:"}, {"kind": "note", "text": "M1 D contains 3 food dyes"}, {"kind": "note", "text": "M2 food colouring D contains A and C"}, {"kind": "note", "text": "M3 food colouring D does not contain B"}, {"kind": "note", "text": "/food colouring D contains another dye(which is not A.B or C)"}, {"kind": "note", "text": "(d)(i)"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "4"}, {"kind": "note", "text": "11"}, {"kind": "note", "text": "1"}, {"kind": "note", "text": "1"}], "answerText": "crystallisation\nsimple distillation\nfiltration\nTotal for question=8", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "3", "marks": 1, "number": 3, "entryId": "ms-77a33728-q3", "guidance": [{"kind": "note", "text": "A(electron)"}, {"kind": "note", "text": "B is not the correct answer because neutrons exist in the nucleus.C is not the correct answer because particle W is not a nucleus.D is not the correct answer because protons exist in the nucleus."}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "C(25)"}, {"kind": "note", "text": "A is not the correct answer as the proton number is 12B is not the correct answer as the number of neutrons is 13D is not the correct answer as the number of protons, neutrons and electrons is not 49"}, {"kind": "note", "text": "(iii)"}, {"kind": "note", "text": "(atoms have the) same number of protons and electrons"}, {"kind": "note", "text": "(iv)"}, {"kind": "note", "text": "B(2+)"}, {"kind": "note", "text": "(b)(i)"}, {"kind": "note", "text": "(both isotopes have) the same number of electrons / the same electron configuration"}, {"kind": "ignore", "text": "IGNORE same number of protons / same number of electrons in the outer shell"}, {"kind": "note", "text": "M1(7.60×6)+(92.4×7)"}, {"kind": "note", "text": "ACCEPT(6×0.076)+(7×0.924)"}, {"kind": "note", "text": "M2692.4÷100OR6.924M36.92"}, {"kind": "allow", "text": "ALLOW ecf if use of 6 and 7 in calculation"}], "answerText": "(a)(i)\nAnswer of 6.92 scores 3\nTotal for question=8", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "4(a)", "marks": 4, "number": 4, "entryId": "ms-77a33728-q4a", "guidance": [{"kind": "note", "text": "Gas"}, {"kind": "note", "text": "nitrogen"}, {"kind": "note", "text": "carbon monoxide"}, {"kind": "note", "text": "helium"}, {"kind": "note", "text": "methane"}, {"kind": "note", "text": "(b)(i)"}, {"kind": "note", "text": "copper(II) oxide/CuO/copper oxide forms"}, {"kind": "note", "text": "REJECT copper(I) oxide"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "the volume of a gas changes with temperature/gas expands when hot/ heated/gas shrinks when cools OWTTE"}, {"kind": "note", "text": "(iii)"}, {"kind": "note", "text": "M1 138-108 OR 30(cm3)M2((30÷138)×100=)21.7"}, {"kind": "allow", "text": "ALLOW minimum 2 significant figures21.7/21.74/22 scores278.3/78.26/78 scores1"}], "answerText": "Information\nthe most abundant gas in air\na toxic gas that is a product of incomplete combustion of hydrocarbons\nan unreactive gas that exists as atoms\na gas produced by the fractional distillation of crude oil", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "6(a)", "marks": 1, "number": 6, "entryId": "ms-77a33728-q6a", "guidance": [{"kind": "note", "text": "(b)"}, {"kind": "note", "text": "M1 a catalyst provides an alternative (reaction) pathway / routeM2 of lower activation energy"}, {"kind": "note", "text": "(c)"}, {"kind": "note", "text": "M1 add hydrogen peroxid