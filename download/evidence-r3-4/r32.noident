7ea6263b73", "mimeType": "image/jpeg", "elementId": "e000023", "sourceName": "assets/crop_1_1789042673801.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789042673806.png", "width": 266, "format": "png", "height": 262, "sha256": "75b12789ccc4e2b00f6e3be91d5f2cc09a852705ebcdcbf0e2eff53205891949", "assetId": "img:75b12789ccc4e2b00f6e3be91d5f2cc09a852705ebcdcbf0e2eff53205891949", "mimeType": "image/jpeg", "elementId": "e000025", "sourceName": "assets/crop_2_1789042673806.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_3_1789042673814.png", "width": 266, "format": "png", "height": 258, "sha256": "8a366769105d272b0c9e34caa1e31c3d5bea81a6f3fee5df607935de54c114d1", "assetId": "img:8a366769105d272b0c9e34caa1e31c3d5bea81a6f3fee5df607935de54c114d1", "mimeType": "image/jpeg", "elementId": "e000027", "sourceName": "assets/crop_3_1789042673814.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The diagram below shows two different atoms of hydrogen. X Y", "label": "b", "marks": null, "partId": "q01-0217e860-pb", "figures": [{"url": "assets/crop_4_1789042673818.png", "width": 200, "format": "png", "height": 208, "sha256": "e215e8acbcd348852ae327b81b51769a10ed50b726a6df1061ae0ba91ee61884", "assetId": "img:e215e8acbcd348852ae327b81b51769a10ed50b726a6df1061ae0ba91ee61884", "mimeType": "image/jpeg", "elementId": "e000030", "sourceName": "assets/crop_4_1789042673818.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_5_1789042673822.png", "width": 198, "format": "png", "height": 209, "sha256": "dc8d757017029c1669e9f305de0cbc34afb40bd9bb39f917aae17bb0330cf008", "assetId": "img:dc8d757017029c1669e9f305de0cbc34afb40bd9bb39f917aae17bb0330cf008", "mimeType": "image/jpeg", "elementId": "e000032", "sourceName": "assets/crop_5_1789042673822.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The particle furthest from the centre of each atom is A an electron B a neutron C a nucleus D a proton", "label": "b-i", "marks": null, "partId": "q01-0217e860-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The particle present in atom Y but not in atom X is A an electron B a neutron C a nucleus D a proton", "label": "b-ii", "marks": null, "partId": "q01-0217e860-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Both atoms are neutral because they have the same number of A electrons and neutrons B electrons and protons C electrons, neutrons and protons D neutrons and protons", "label": "b-iii", "marks": null, "partId": "q01-0217e860-pb-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Different atoms of oxygen can be represented as $ _{8}^{1 6} $ O and $ _{8}^{1 8} $ O Select words or phrases from the box to complete the sentence about these atoms of oxygen. You may use each word or phrase once, more than once or not at all. These atoms of oxygen are called because their ... are the same", "label": "c", "marks": null, "partId": "q01-0217e860-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 1, "figures": [{"url": "assets/crop_1_1789042673801.png", "width": 262, "format": "png", "height": 262, "sha256": "1c0d2d5562ff8c2b5984afff4b7cf780a5e3e45b3b94b0d3ae927e7ea6263b73", "assetId": "img:1c0d2d5562ff8c2b5984afff4b7cf780a5e3e45b3b94b0d3ae927e7ea6263b73", "mimeType": "image/jpeg", "elementId": "e000023", "sourceName": "assets/crop_1_1789042673801.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789042673806.png", "width": 266, "format": "png", "height": 262, "sha256": "75b12789ccc4e2b00f6e3be91d5f2cc09a852705ebcdcbf0e2eff53205891949", "assetId": "img:75b12789ccc4e2b00f6e3be91d5f2cc09a852705ebcdcbf0e2eff53205891949", "mimeType": "image/jpeg", "elementId": "e000025", "sourceName": "assets/crop_2_1789042673806.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_3_1789042673814.png", "width": 266, "format": "png", "height": 258, "sha256": "8a366769105d272b0c9e34caa1e31c3d5bea81a6f3fee5df607935de54c114d1", "assetId": "img:8a366769105d272b0c9e34caa1e31c3d5bea81a6f3fee5df607935de54c114d1", "mimeType": "image/jpeg", "elementId": "e000027", "sourceName": "assets/crop_3_1789042673814.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_4_1789042673818.png", "width": 200, "format": "png", "height": 208, "sha256": "e215e8acbcd348852ae327b81b51769a10ed50b726a6df1061ae0ba91ee61884", "assetId": "img:e215e8acbcd348852ae327b81b51769a10ed50b726a6df1061ae0ba91ee61884", "mimeType": "image/jpeg", "elementId": "e000030", "sourceName": "assets/crop_4_1789042673818.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_5_1789042673822.png", "width": 198, "format": "png", "height": 209, "sha256": "dc8d757017029c1669e9f305de0cbc34afb40bd9bb39f917aae17bb0330cf008", "assetId": "img:dc8d757017029c1669e9f305de0cbc34afb40bd9bb39f917aae17bb0330cf008", "mimeType": "image/jpeg", "elementId": "e000032", "sourceName": "assets/crop_5_1789042673822.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q01-0217e860", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000053"]}, {"mcq": false, "qwc": false, "stem": "This question is about the separation of mixtures.", "marks": 7, "parts": [{"qwc": false, "text": "The table shows some methods used to separate mixtures.", "label": "a", "marks": null, "partId": "q02-0217e860-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Place a tick ( $ \\surd $ ) in one box in each row of the table to show the best method of separation for each mixture.", "label": "a-i", "marks": null, "partId": "q02-0217e860-pa-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Which of the mixtures P, Q, R or S contains an undissolved solid?", "label": "a-ii", "marks": null, "partId": "q02-0217e860-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Pure dry crystals of magnesium nitrate can be obtained from magnesium nitrate solution by crystallisation. These steps describe the method, but the steps are in the wrong order. A allow the solution to cool to room temperature B heat the solution to evaporate some of the water C pour the mixture of crystals and solution through filter paper D put the crystals in a warm place to dry E dip a glass rod into the solution to see if crystals form Write a letter in each box to show the correct order. One has been done for you.", "label": "b", "marks": null, "partId": "q02-0217e860-pb", "figures": [{"url": "assets/crop_1_1789042673844.png", "width": 152, "format": "png", "height": 152, "sha256": "9cb43dff5211e74fab8bf6d3f4dc3772c2971f0e0acb3040620ed7c2ea363e10", "assetId": "img:9cb43dff5211e74fab8bf6d3f4dc3772c2971f0e0acb3040620ed7c2ea363e10", "mimeType": "image/jpeg", "elementId": "e000071", "sourceName": "assets/crop_1_1789042673844.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789042673848.png", "width": 153, "format": "png", "height": 152, "sha256": "62bdedc3e2e4ab17dc7790bfd5f4e2b5c066f681fa2a724dd4ceda95034fb8e7", "assetId": "img:62bdedc3e2e4ab17dc7790bfd5f4e2b5c066f681fa2a724dd4ceda95034fb8e7", "mimeType": "image/jpeg", "elementId": "e000072", "sourceName": "assets/crop_2_1789042673848.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_3_1789042673852.png", "width": 152, "format": "png", "height": 152, "sha256": "2c85645c24cbb318f0c148d91d69adeb88a64cbd2889ff76f954279a4d443353", "assetId": "img:2c85645c24cbb318f0c148d91d69adeb88a64cbd2889ff76f954279a4d443353", "mimeType": "image/jpeg", "elementId": "e000073", "sourceName": "assets/crop_3_1789042673852.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_4_1789042673856.png", "width": 151, "format": "png", "height": 151, "sha256": "74148fd7b26ef5bea456156b042de3dce8e1f0e176e405c4d52f1654f7fc6dce", "assetId": "img:74148fd7b26ef5bea456156b042de3dce8e1f0e176e405c4d52f1654f7fc6dce", "mimeType": "image/jpeg", "elementId": "e000074", "sourceName": "assets/crop_4_1789042673856.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_5_1789042673859.png", "width": 151, "format": "png", "height": 153, "sha256": "a4345532ca98af56f99625a6420e4826393abe734ee8740875d33a1a95084278", "assetId": "img:a4345532ca98af56f99625a6420e4826393abe734ee8740875d33a1a95084278", "mimeType": "image/jpeg", "elementId": "e000075", "sourceName": "assets/crop_5_1789042673859.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}], "number": 2, "figures": [{"url": "assets/crop_1_1789042673844.png", "width": 152, "format": "png", "height": 152, "sha256": "9cb43dff5211e74fab8bf6d3f4dc3772c2971f0e0acb3040620ed7c2ea363e10", "assetId": "img:9cb43dff5211e74fab8bf6d3f4dc3772c2971f0e0acb3040620ed7c2ea363e10", "mimeType": "image/jpeg", "elementId": "e000071", "sourceName": "assets/crop_1_1789042673844.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789042673848.png", "width": 153, "format": "png", "height": 152, "sha256": "62bdedc3e2e4ab17dc7790bfd5f4e2b5c066f681fa2a724dd4ceda95034fb8e7", "assetId": "img:62bdedc3e2e4ab17dc7790bfd5f4e2b5c066f681fa2a724dd4ceda95034fb8e7", "mimeType": "image/jpeg", "elementId": "e000072", "sourceName": "assets/crop_2_1789042673848.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_3_1789042673852.png", "width": 152, "format": "png", "height": 152, "sha256": "2c85645c24cbb318f0c148d91d69adeb88a64cbd2889ff76f954279a4d443353", "assetId": "img:2c85645c24cbb318f0c148d91d69adeb88a64cbd2889ff76f954279a4d443353", "mimeType": "image/jpeg", "elementId": "e000073", "sourceName": "assets/crop_3_1789042673852.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_4_1789042673856.png", "width": 151, "format": "png", "height": 151, "sha256": "74148fd7b26ef5bea456156b042de3dce8e1f0e176e405c4d52f1654f7fc6dce", "assetId": "img:74148fd7b26ef5bea456156b042de3dce8e1f0e176e405c4d52f1654f7fc6dce", "mimeType": "image/jpeg", "elementId": "e000074", "sourceName": "assets/crop_4_1789042673856.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_5_1789042673859.png", "width": 151, "format": "png", "height": 153, "sha256": "a4345532ca98af56f99625a6420e4826393abe734ee8740875d33a1a95084278", "assetId": "img:a4345532ca98af56f99625a6420e4826393abe734ee8740875d33a1a95084278", "mimeType": "image/jpeg", "elementId": "e000075", "sourceName": "assets/crop_5_1789042673859.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q02-0217e860", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000060"]}, {"mcq": false, "qwc": false, "stem": "This question is about tests for some elements and compounds.", "marks": 7, "parts": [{"qwc": false, "text": "What is the test for hydrogen?", "label": "a", "marks": null, "partId": "q03-0217e860-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The diagram shows hydrogen burning in air, and how some of the gases passing through the apparatus are collected and tested. hydrogen burning A colourless liquid collects in the U-shaped tube and the limewater turns cloudy very slowly.", "label": "b", "marks": null, "partId": "q03-0217e860-pb", "figures": [{"url": "assets/crop_1_1789042673867.png", "width": 1664, "format": "png", "height": 637, "sha256": "12ed2f4121ef8662a8631eccdaa97ea880506278c2d21b868819b4b0904b5c4b", "assetId": "img:12ed2f4121ef8662a8631eccdaa97ea880506278c2d21b868819b4b0904b5c4b", "mimeType": "image/jpeg", "elementId": "e000080", "sourceName": "assets/crop_1_1789042673867.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Describe a chemical test to show that the colourless liquid contains water. test.. result", "label": "b-i", "marks": null, "partId": "q03-0217e860-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Describe a physical test to show that the colourless liquid is pure water. test.. result.", "label": "b-ii", "marks": null, "partId": "q03-0217e860-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "A reaction involving carbon dioxide causes the cloudiness in the limewater. Place crosses ( $ \\times $ ) in two boxes to show the correct statements about this reaction. carbon dioxide forms when the hydrogen burns carbon dioxide from the air reacts to cause the cloudiness the cloudiness is caused by the formation of calcium hydroxide the cloudiness is caused by the formation of a white precipitate the reaction in the limewater is an example of oxidation", "label": "b-iii", "marks": null, "partId": "q03-0217e860-pb-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 3, "figures": [{"url": "assets/crop_1_1789042673867.png", "width": 1664, "format": "png", "height": 637, "sha256": "12ed2f4121ef8662a8631eccdaa97ea880506278c2d21b868819b4b0904b5c4b", "assetId": "img:12ed2f4121ef8662a8631eccdaa97ea880506278c2d21b868819b4b0904b5c4b", "mimeType": "image/jpeg", "elementId": "e000080", "sourceName": "assets/crop_1_1789042673867.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q03-0217e860", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "A student draws this diagram to show how he plans to prepare and collect oxygen gas in a laboratory.", "marks": 0, "parts": [{"qwc": false, "text": "The student makes a mistake in the labelling. He also misses out a piece of apparatus.", "label": "a", "marks": null, "partId": "q04-0217e860-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State the mistake in the labelling of the diagram.", "label": "a-i", "marks": null, "partId": "q04-0217e860-pa-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Identify the piece of apparatus missing from the diagram.", "label": "a-ii", "marks": null, "partId": "q04-0217e860-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State why this piece of apparatus is necessary.", "label": "a-iii", "marks": null, "partId": "q04-0217e860-pa-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The student adds the missing piece of apparatus, then collects some oxygen gas. This oxygen gas contains water vapour. Suggest how he could alter the apparatus so that he could collect dry oxygen gas.", "label": "b", "marks": null, "partId": "q04-0217e860-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Balance the equation for the reaction used in this preparation of oxygen. $\\mathrm {H} _ {2} \\mathrm {O} _ {2} \\rightarrow \\mathrm {H} _ {2} \\mathrm {O} + \\mathrm {O} _ {2}$", "label": "c", "marks": null, "partId": "q04-0217e860-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The manganese(IV) oxide acts as a catalyst. What is meant by the term catalyst?", "label": "d", "marks": null, "partId": "q04-0217e860-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The diagram shows the reaction profile for the decomposition of hydrogen peroxide without a catalyst.", "label": "e", "marks": null, "partId": "q04-0217e860-pe", "figures": [{"url": "assets/crop_1_1789042673898.png", "width": 1317, "format": "png", "height": 818, "sha256": "a413e06345e61d0f572cfe379ccccdfd85edf858f6c13a5e37f9da73d10e49e0", "assetId": "img:a413e06345e61d0f572cfe379ccccdfd85edf858f6c13a5e37f9da73d10e49e0", "mimeType": "image/jpeg", "elementId": "e000110", "sourceName": "assets/crop_1_1789042673898.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Label the diagram to show the activation energy $ ( E_{a} ) $ for this reaction.", "label": "e-i", "marks": null, "partId": "q04-0217e860-pe-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "On the diagram, draw a curve to represent the reaction profile for the same reaction when a catalyst is used.", "label": "e-ii", "marks": null, "partId": "q04-0217e860-pe-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 4, "figures": [{"url": "assets/crop_1_1789042673888.png", "width": 1331, "format": "png", "height": 758, "sha256": "87c0e07b39abe48346f4c71ec6bd0e9db2a0c06c67f65c434e440ddb71a3ee5e", "assetId": "img:87c0e07b39abe48346f4c71ec6bd0e9db2a0c06c67f65c434e440ddb71a3ee5e", "mimeType": "image/jpeg", "elementId": "e000098", "sourceName": "assets/crop_1_1789042673888.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_1_1789042673898.png", "width": 1317, "format": "png", "height": 818, "sha256": "a413e06345e61d0f572cfe379ccccdfd85edf858f6c13a5e37f9da73d10e49e0", "assetId": "img:a413e06345e61d0f572cfe379ccccdfd85edf858f6c13a5e37f9da73d10e49e0", "mimeType": "image/jpeg", "elementId": "e000110", "sourceName": "assets/crop_1_1789042673898.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.45, "marksKnown": false, "questionId": "q04-0217e860", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "This question is about aluminium sulfate, a soluble salt with many uses.", "marks": 8, "parts": [{"qwc": false, "text": "One type of aluminium sulfate has the formula $ \\mathrm{A l}_{2} \\left( \\mathrm{S O}_{4} \\right)_{3}.1 6 \\mathrm{H}_{2} \\mathrm{O} (s) $", "label": "a", "marks": null, "partId": "q05-0217e860-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "How many different elements are shown in this formula?", "label": "a-i", "marks": null, "partId": "q05-0217e860-pa-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The $ \\mathrm{H_{2}O} $ in this formula shows that this type of aluminium sulfate is A anhydrous B hydrated C solid D soluble", "label": "a-ii", "marks": null, "partId": "q05-0217e860-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Some types of fire extinguisher use a reaction between aluminium sulfate and sodium hydrogencarbonate. The equation for this reaction is $\\mathrm {A l} _ {2} \\left(\\mathrm {S O} _ {4}\\right) _ {3} + 6 \\mathrm {N a H C O} _ {3} \\rightarrow 2 \\mathrm {A l} (\\mathrm {O H}) _ {3} + 3 \\mathrm {N a} _ {2} \\mathrm {S O} _ {4} + 6 \\mathrm {C O} _ {2}$", "label": "b", "marks": null, "partId": "q05-0217e860-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State the names of the two metal-containing products of this reaction.", "label": "b-i", "marks": null, "partId": "q05-0217e860-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Carbon dioxide is used in some fire extinguishers. Explain why carbon dioxide is effective at extinguishing fires.", "label": "b-ii", "marks": null, "partId": "q05-0217e860-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Gardeners can use aluminium sulfate to alter the pH of soil. The reaction that occurs can be represented as $\\mathrm {A l} _ {2} \\left(\\mathrm {S O} _ {4}\\right) _ {3} (\\mathrm {s}) + 6 \\mathrm {H} _ {2} \\mathrm {O} (\\mathrm {l}) \\rightarrow 2 \\mathrm {A l} (\\mathrm {O H}) _ {3} (\\mathrm {s}) + 3 \\mathrm {H} _ {2} \\mathrm {S O} _ {4} (\\mathrm {a q})$", "label": "c", "marks": null, "partId": "q05-0217e860-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The $ \\mathrm{A l} (\\mathrm{O H})_{3} $ contains $ \\mathrm{O H^{-}} $ ions and the $ \\mathrm{H_{2} S O_{4}} $ contains $ \\mathrm{H^{+}} $ ions. Suggest, with reference to the state symbols, why this reaction makes the soil more acidic.", "label": "c-i", "marks": null, "partId": "q05-0217e860-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The pH of the soil in a garden is 7.5 A gardener adds some aluminium sulfate to the soil to alter its pH. Which is the most likely pH of this soil after the reaction occurs? A 1.5 B 5.5 C 9.5 D 13.5", "label": "c-ii", "marks": null, "partId": "q05-0217e860-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 5, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q05-0217e860", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "A teacher uses this apparatus to show the reaction between ammonia gas and hydrogen chloride gas to form ammonium chloride. cotton wool soaked in concentrated ammonia solution cotton wool soaked in concentrated hydrochloric acid Concentrated ammonia solution gives off ammonia gas. Concentrated hydrochloric acid gives off hydrogen chloride gas. The reaction between the gases can be represented by this equation. $\\mathrm {N H} _ {3} (\\mathrm {g}) + \\mathrm {H C l} (\\mathrm {g}) \\rightarrow \\mathrm {N H} _ {4} \\mathrm {C l} (\\mathrm {s})$ The diagram below shows the apparatus after a few minutes.", "marks": 8, "parts": [{"qwc": false, "text": "Which process occurs when the gas particles move along the tube? A condensation B crystallisation diffusion evaporation", "label": "a", "marks": 1, "partId": "q06-0217e860-pa", "figures": [], "confidence": 0.8, "answerPrompts": []}, {"qwc": false, "text": "Explain how the diagram shows which gas moves more quickly during the experiment.", "label": "b", "marks": null, "partId": "q06-0217e860-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The teacher tests a sample of ammonium chloride solution.", "label": "c", "marks": null, "partId": "q06-0217e860-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "She uses this method to show that the sample contains ammonium ions. add solution X warm the mixture test the gas given off with damp litmus paper Suggest the identity of solution X, the identity of the gas given off and the final colour of the litmus paper. solution X.. gas given off... final colour of litmus paper.", "label": "c-i", "marks": null, "partId": "q06-0217e860-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "She uses this method to show that the sample contains chloride ions. add solution Y see if a white precipitate forms Why does she add dilute nitric acid?", "label": "c-ii", "marks": null, "partId": "q06-0217e860-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Suggest the identities of solution Y and the white precipitate. solution Y... white precipitate", "label": "c-iii", "marks": null, "partId": "q06-0217e860-pc-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 6, "figures": [{"url": "assets/crop_1_1789042673935.png", "width": 870, "format": "png", "height": 212, "sha256": "96224d854a18a8565c5652eaeba396781f0172bff45a133676740e3924faf2e5", "assetId": "img:96224d854a18a8565c5652eaeba396781f0172bff45a133676740e3924faf2e5", "mimeType": "image/jpeg", "elementId": "e000141", "sourceName": "assets/crop_1_1789042673935.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789042673940.png", "width": 868, "format": "png", "height": 256, "sha256": "33bd627dd525fb05111df39c612c53d909bb1ef4e266720c814a8fa5ab625acd", "assetId": "img:33bd627dd525fb05111df39c612c53d909bb1ef4e266720c814a8fa5ab625acd", "mimeType": "image/jpeg", "elementId": "e000147", "sourceName": "assets/crop_2_1789042673940.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q06-0217e860", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "The alkanes are a homologous series of hydrocarbons obtained from the fractions in crude oil.", "marks": 17, "parts": [{"qwc": false, "text": "Describe how crude oil is separated into fractions in industry.", "label": "a", "marks": null, "partId": "q07-0217e860-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State the general formula of the alkanes.", "label": "b", "marks": null, "partId": "q07-0217e860-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State two characteristics, other than having the same general formula, of members of a homologous series.", "label": "b-ii", "marks": null, "partId": "q07-0217e860-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Propane is an alkane used as a fuel. Balance the equation for the complete combustion of propane. $\\mathrm {C} _ {3} \\mathrm {H} _ {8} + \\dots \\dots \\dots \\dots \\mathrm {O} _ {2} \\rightarrow \\dots \\dots \\dots \\dots \\mathrm {C O} _ {2} + \\dots \\dots \\dots \\dots \\mathrm {H} _ {2} \\mathrm {O}$", "label": "c", "marks": null, "partId": "q07-0217e860-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Incomplete combustion of propane leads to the formation of a poisonous gas.", "label": "d", "marks": null, "partId": "q07-0217e860-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Identify this gas.", "label": "d-i", "marks": null, "partId": "q07-0217e860-pd-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain why the gas is poisonous.", "label": "d-ii", "marks": null, "partId": "q07-0217e860-pd-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "During the combustion of propane at high temperatures, gases represented by the formula $ \\mathrm{N O}_{x} $ can form. Which two elements combine to form these gases?", "label": "d-iii", "marks": null, "partId": "q07-0217e860-pd-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The alkane $ \\mathrm{C}_{5} \\mathrm{H}_{1 2} $ has three isomers. The displayed formula of one of these isomers is H Draw the displayed formulae of the other two isomers.", "label": "e", "marks": 2, "partId": "q07-0217e860-pe", "figures": [{"url": "assets/crop_1_1789042673971.png", "width": 426, "format": "png", "height": 475, "sha256": "5d8f1872788168d2b59965945b594be777fec91c5f2503ef1a368cee8f2a77ed", "assetId": "img:5d8f1872788168d2b59965945b594be777fec91c5f2503ef1a368cee8f2a77ed", "mimeType": "image/jpeg", "elementId": "e000186", "sourceName": "assets/crop_1_1789042673971.png", "availability": "available", "formatMismatch": true}], "confidence": 0.8, "answerPrompts": []}, {"qwc": false, "text": "Methane is used in many countries as a fuel in houses. It has no smell, so substances are mixed with it to allow any leaks to be identified. One of these substances is compound X which has this composition by mass. $C = 53.3 \\%, H = 11.1 \\% \\mathrm {a n d} S = 35.6 \\%$", "label": "f", "marks": null, "partId": "q07-0217e860-pf", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Use this information to calculate the empirical formula of X. empirical formula of X.", "label": "f-i", "marks": null, "partId": "q07-0217e860-pf-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The relative formula mass of X is 90 What is the molecular formula of X? molecular formula of X...", "label": "f-ii", "marks": null, "partId": "q07-0217e860-pf-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 7, "figures": [{"url": "assets/crop_1_1789042673971.png", "width": 426, "format": "png", "height": 475, "sha256": "5d8f1872788168d2b59965945b594be777fec91c5f2503ef1a368cee8f2a77ed", "assetId": "img:5d8f1872788168d2b59965945b594be777fec91c5f2503ef1a368cee8f2a77ed", "mimeType": "image/jpeg", "elementId": "e000186", "sourceName": "assets/crop_1_1789042673971.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q07-0217e860", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "Ethane $ \\left( \\mathrm{C}_{2} \\mathrm{H}_{6} \\right) $ is used as a starting material to manufacture addition polymers. It is first cracked to form ethene $ \\left( \\mathrm{C}_{2} \\mathrm{H}_{4} \\right) $", "marks": 10, "parts": [{"qwc": false, "text": "Identify the fuel that also forms in this reaction.", "label": "a", "marks": null, "partId": "q08-0217e860-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Ethane is described as saturated. What feature of an ethane molecule is responsible for this description?", "label": "b", "marks": null, "partId": "q08-0217e860-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Bromine water can be used to show that a hydrocarbon is ethene rather than ethane.", "label": "c", "marks": null, "partId": "q08-0217e860-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Complete the equation to show the displayed formula of the product of the reaction between ethene and bromine. $\\begin{array}{c c c c} \\mathrm {H} & \\mathrm {H} \\\\ | & | \\\\ \\mathrm {C} = \\mathrm {C} & + \\mathrm {B r} - \\mathrm {B r} & \\rightarrow \\\\ | & | \\\\ \\mathrm {H} & \\mathrm {H} \\end{array}$", "label": "c-i", "marks": null, "partId": "q08-0217e860-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Which is the correct statement about this test? A the colour of ethene is brown B the product of the reaction is a white precipitate C the product of the reaction is colourless D the test involves a substitution reaction", "label": "c-ii", "marks": null, "partId": "q08-0217e860-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Alkenes can be polymerised. Part of the structure of poly(ethene) can be represented as This structure shows the atoms coming from two molecules of ethene. Draw part of the structure of poly(propene) that shows the atoms coming from two molecules of propene $ \\mathrm{(C H_{2}=C H-CH_{3})}. $", "label": "d", "marks": null, "partId": "q08-0217e860-pd", "figures": [{"url": "assets/crop_1_1789042673992.png", "width": 304, "format": "png", "height": 218, "sha256": "022ba45cd0946b1c713afb707f3bbbecd13db024ea22eaaf125a6e5135738146", "assetId": "img:022ba45cd0946b1c713afb707f3bbbecd13db024ea22eaaf125a6e5135738146", "mimeType": "image/jpeg", "elementId": "e000212", "sourceName": "assets/crop_1_1789042673992.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The repeat unit of another addition polymer can be represented as Draw the structure of the monomer used to make this polymer.", "label": "e", "marks": null, "partId": "q08-0217e860-pe", "figures": [{"url": "assets/crop_2_1789042673996.png", "width": 177, "format": "png", "height": 212, "sha256": "5c78c9d19964a5507ff2c89a20614b48781a3eb6c11cf4e975dda8df0cd4338e", "assetId": "img:5c78c9d19964a5507ff2c89a20614b48781a3eb6c11cf4e975dda8df0cd4338e", "mimeType": "image/jpeg", "elementId": "e000216", "sourceName": "assets/crop_2_1789042673996.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The disposal of most addition polymers is a problem because they do not biodegrade.", "label": "f", "marks": null, "partId": "q08-0217e860-pf", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "What is meant by the term biodegrade?", "label": "f-i", "marks": null, "partId": "q08-0217e860-pf-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Identify the property that prevents addition polymers from easily biodegrading.", "label": "f-ii", "marks": null, "partId": "q08-0217e860-pf-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 8, "figures": [{"url": "assets/crop_1_1789042673992.png", "width": 304, "format": "png", "height": 218, "sha256": "022ba45cd0946b1c713afb707f3bbbecd13db024ea22eaaf125a6e5135738146", "assetId": "img:022ba45cd0946b1c713afb707f3bbbecd13db024ea22eaaf125a6e5135738146", "mimeType": "image/jpeg", "elementId": "e000212", "sourceName": "assets/crop_1_1789042673992.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789042673996.png", "width": 177, "format": "png", "height": 212, "sha256": "5c78c9d19964a5507ff2c89a20614b48781a3eb6c11cf4e975dda8df0cd4338e", "assetId": "img:5c78c9d19964a5507ff2c89a20614b48781a3eb6c11cf4e975dda8df0cd4338e", "mimeType": "image/jpeg", "elementId": "e000216", "sourceName": "assets/crop_2_1789042673996.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q08-0217e860", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "This question is about elements in Group 1 of the Periodic Table.", "marks": 9, "parts": [{"qwc": false, "text": "Which statement is correct about lithium? A lithium is a non-metal B lithium forms a sulfate with the formula $ \\mathrm{L i S O}_{4} $ C lithium reacts with water to form an alkali D lithium reacts with water to form a white precipitate", "label": "a", "marks": null, "partId": "q09-0217e860-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Lithium and potassium have similar chemical properties because their atoms A have the same number of electrons in the outer shell B have the same number of protons C have two electrons in the first shell D form positive ions", "label": "b", "marks": null, "partId": "q09-0217e860-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Small pieces of lithium and potassium are added to separate large troughs of water. State one observation that would be similar for each element, and one that would be different for each element. similar.. different.", "label": "c", "marks": null, "partId": "q09-0217e860-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Suggest the formula of the compound formed when potassium reacts with oxygen, and when potassium reacts with chlorine. oxygen chlorine", "label": "d", "marks": null, "partId": "q09-0217e860-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Complete the equation for the reaction between rubidium and water by inserting state symbols. $2 \\mathrm {R b} (\\dots \\dots \\dots \\dots \\dots) + 2 \\mathrm {H} _ {2} \\mathrm {O} (\\dots \\dots \\dots \\dots \\dots) \\rightarrow 2 \\mathrm {R b O H} (\\dots \\dots \\dots \\dots \\dots) + \\mathrm {H} _ {2} (\\dots \\dots \\dots \\dots \\dots)$", "label": "e", "marks": null, "partId": "q09-0217e860-pe", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The table shows information about the isotopes in a sample of rubidium. Use information from the table to calculate the relative atomic mass of this sample of rubidium. Give your answer to one decimal place.", "label": "f", "marks": null, "partId": "q09-0217e860-pf", "figures": [], "confidence": 0.55, "answerPrompts": ["relative atomic mass"]}], "number": 9, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q09-0217e860", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000244"]}, {"mcq": false, "qwc": false, "stem": "This question is about the insoluble salt lead(II) bromide.", "marks": 9, "parts": [{"qwc": false, "text": "A student uses the precipitation method to prepare lead(II) bromide. The equation for the reaction she uses is $\\mathrm {P b} \\left(\\mathrm {N O} _ {3}\\right) _ {2} (\\mathrm {a q}) + 2 \\mathrm {N a B r} (\\mathrm {a q}) \\rightarrow \\mathrm {P b B r} _ {2} (\\mathrm {s}) + 2 \\mathrm {N a N O} _ {3} (\\mathrm {a q})$ Describe how she could use solutions of lead(II) nitrate and sodium bromide to obtain a pure, dry sample of lead(II) bromide.", "label": "a", "marks": null, "partId": "q10-0217e860-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The student''s teacher uses this apparatus to electrolyse a pure sample of molten lead(II) bromide. The student records these observations. a small blob of a silvery liquid appears at one electrode a brown substance forms at the other electrode the lamp stops working soon after the teacher stops heating the lead(II) bromide", "label": "b", "marks": null, "partId": "q10-0217e860-pb", "figures": [{"url": "assets/crop_1_1789042674047.png", "width": 789, "format": "png", "height": 658, "sha256": "a159a09c2cfe66ba2f5f5eba4d27db3aaaaae61fea9d0f537b0bd2e044714d1c", "assetId": "img:a159a09c2cfe66ba2f5f5eba4d27db3aaaaae61fea9d0f537b0bd2e044714d1c", "mimeType": "image/jpeg", "elementId": "e000254", "sourceName": "assets/crop_1_1789042674047.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Which is the correct statement about this electrolysis? A the brown substance is bromide B the products are both elements C the silvery liquid forms at the positive electrode D the silvery liquid is molten lead(II) bromide", "label": "b-i", "marks": null, "partId": "q10-0217e860-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The student writes this half-equation to show the reaction in which the brown substance forms. $2 \\mathrm {B r} ^ {-} + 2 \\mathrm {e} ^ {-} \\rightarrow 2 \\mathrm {B r}$ Identify the two mistakes in her half-equation.", "label": "b-ii", "marks": null, "partId": "q10-0217e860-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain why the lamp stops working after the teacher stops heating the lead(II) bromide.", "label": "b-iii", "marks": null, "partId": "q10-0217e860-pb-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 10, "figures": [{"url": "assets/crop_1_1789042674047.png", "width": 789, "format": "png", "height": 658, "sha256": "a159a09c2cfe66ba2f5f5eba4d27db3aaaaae61fea9d0f537b0bd2e044714d1c", "assetId": "img:a159a09c2cfe66ba2f5f5eba4d27db3aaaaae61fea9d0f537b0bd2e044714d1c", "mimeType": "image/jpeg", "elementId": "e000254", "sourceName": "assets/crop_1_1789042674047.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q10-0217e860", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "A student uses the neutralisation method to make a sample of the soluble salt, sodium sulfate. The equation for the reaction he uses is $2 \\mathrm {N a O H} (\\mathrm {a q}) + \\mathrm {H} _ {2} \\mathrm {S O} _ {4} (\\mathrm {a q}) \\rightarrow \\mathrm {N a} _ {2} \\mathrm {S O} _ {4} (\\mathrm {a q}) + 2 \\mathrm {H} _ {2} \\mathrm {O} (\\mathrm {l})$", "marks": 0, "parts": [{"qwc": false, "text": "He does a titration using these steps to find the ratio of the volumes of reactants needed. add 25.0 $ cm^{3} $ solution of dilute sodium hydroxide solution to a conical flask add a few drops of phenolphthalein indicator to the conical flask add dilute sulfuric acid from a burette until the indicator just changes colour repeat the experiment until concordant results are obtained", "label": "a", "marks": null, "partId": "q11-0217e860-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Which piece of apparatus should the student use to add the sodium hydroxide solution?", "label": "a-i", "marks": null, "partId": "q11-0217e860-pa-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "What colour change would the student see when he neutralises the sodium hydroxide solution? colour before neutralisation colour after neutralisation", "label": "a-ii", "marks": null, "partId": "q11-0217e860-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The diagram shows the burette readings in one experiment before and after adding the acid. Use the readings to calculate the volume of acid added, entering all values to the nearest 0.05 $ cm^{3}. $ burette reading after adding acid ... $ \\mathrm{c m^{3}} $ burette reading before adding acid ... $ \\mathrm{c m^{3}} $ volume of acid added ... $ \\mathrm{c m^{3}} $", "label": "b", "marks": null, "partId": "q11-0217e860-pb", "figures": [{"url": "assets/crop_1_1789042674070.png", "width": 154, "format": "png", "height": 632, "sha256": "7080e9882c7a79a3067470801e80daafb1abe7b634f4300a730544052386a5a8", "assetId": "img:7080e9882c7a79a3067470801e80daafb1abe7b634f4300a730544052386a5a8", "mimeType": "image/jpeg", "elementId": "e000282", "sourceName": "assets/crop_1_1789042674070.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789042674074.png", "width": 169, "format": "png", "height": 630, "sha256": "0200473628a698c219b6d9e2033e51f447ea7241ffe0d07f083b3194201c1cdc", "assetId": "img:0200473628a698c219b6d9e2033e51f447ea7241ffe0d07f083b3194201c1cdc", "mimeType": "image/jpeg", "elementId": "e000283", "sourceName": "assets/crop_2_1789042674074.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The student repeats the experiment and records these results. The average (mean) volume of acid added should be calculated using only concordant results (those that differ from each other by $ 0. 2 0 \\mathrm{c m}^{3} $ or less).", "label": "c", "marks": null, "partId": "q11-0217e860-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Identify the concordant results by placing ticks ( $ \\checkmark $ ) in the table where appropriate.", "label": "c-i", "marks": null, "partId": "q11-0217e860-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Use your ticked results to calculate the average volume of acid added.", "label": "c-ii", "marks": null, "partId": "q11-0217e860-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The student uses 200 $ cm^{3} $ of sodium hydroxide solution of concentration 0.300 mol/dm $ ^{3} $ to prepare a sample of sodium sulfate solution.", "label": "d", "marks": null, "partId": "q11-0217e860-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 11, "figures": [{"url": "assets/crop_1_1789042674070.png", "width": 154, "format": "png", "height": 632, "sha256": "7080e9882c7a79a3067470801e80daafb1abe7b634f4300a730544052386a5a8", "assetId": "img:7080e9882c7a79a3067470801e80daafb1abe7b634f4300a730544052386a5a8", "mimeType": "image/jpeg", "elementId": "e000282", "sourceName": "assets/crop_1_1789042674070.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789042674074.png", "width": 169, "format": "png", "height": 630, "sha256": "0200473628a698c219b6d9e2033e51f447ea7241ffe0d07f083b3194201c1cdc", "assetId": "img:0200473628a698c219b6d9e2033e51f447ea7241ffe0d07f083b3194201c1cdc", "mimeType": "image/jpeg", "elementId": "e000283", "sourceName": "assets/crop_2_1789042674074.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.45, "marksKnown": false, "questionId": "q11-0217e860", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000289", "e000294"]}, {"mcq": false, "qwc": false, "stem": "A student investigates the rate of the reaction between marble chips (calcium carbonate) and dilute hydrochloric acid. She is given a bottle containing hydrochloric acid labelled 100% She uses this method to find out how changing the concentration of the acid affects the rate of reaction. add some marble chips to a conical flask pour 50.0 $ cm^{3} $ of dilute hydrochloric acid into the flask place the flask on a balance and start a timer record the time taken for the mass of the flask and contents to decrease by 1.0 g repeat the experiment using different concentrations of hydrochloric acid", "marks": 15, "parts": [{"qwc": false, "text": "Suggest two features of the marble chips that the student should keep the same to ensure that the results are valid (a fair test).", "label": "a", "marks": null, "partId": "q12-0217e860-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Why does the mass of the flask and contents decrease during the experiment?", "label": "b", "marks": null, "partId": "q12-0217e860-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The student should have put some cotton wool in the neck of the conical flask after placing the flask on the balance. How would this improve the accuracy of the results?", "label": "c", "marks": null, "partId": "q12-0217e860-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The graph shows the student''s results for the decrease in the mass of the flask and contents by 1.0 g.", "label": "d", "marks": null, "partId": "q12-0217e860-pd", "figures": [{"url": "assets/crop_1_1789042674111.png", "width": 1125, "format": "png", "height": 1291, "sha256": "7eae5aa4e9186e51b29b4cef34eba673fe6b12790567acf477e194eb97858418", "assetId": "img:7eae5aa4e9186e51b29b4cef34eba673fe6b12790567acf477e194eb97858418", "mimeType": "image/jpeg", "elementId": "e000306", "sourceName": "assets/crop_1_1789042674111.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Use the graph to find the time taken for the loss of 1.0 g of mass from the flask when the concentration of acid is 50%. Show on the graph how you obtained your answer.", "label": "d-i", "marks": null, "partId": "q12-0217e860-pd-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "One of the points on the graph is anomalous. What could have caused this anomalous result? A the concentration of acid was more than 40% B the loss of mass was greater than 1.0 g C the mass of marble chips was more than 10 g D the student started the timer too late", "label": "d-ii", "marks": null, "partId": "q12-0217e860-pd-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The results of each experiment can be used to calculate the rate of reaction using the expression $\\mathrm {r a t e o f r e a c t i o n i n g r a m s p e r s e c o n d} = \\frac {1 . 0 \\mathrm {g}}{\\mathrm {t i m e t o l o s e} 1 . 0 \\mathrm {g i n s e c o n d s}}$ Calculate the rate of reaction when the concentration of acid is 50%. $\\mathrm {r a t e o f r e a c t i o n} =$", "label": "e", "marks": null, "partId": "q12-0217e860-pe", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The student is given a bottle of hydrochloric acid with a concentration different from that used in the previous experiments. She repeats the investigation using different concentrations of hydrochloric acid. She calculates the rate of reaction for each experiment. The table shows her results. Plot these results on the grid and draw a straight line of best fit.", "label": "f", "marks": null, "partId": "q12-0217e860-pf", "figures": [{"url": "assets/crop_1_1789042674125.png", "width": 1082, "format": "png", "height": 936, "sha256": "b97a8149d3d9ee8c575659919d7d5a408ec489a434421229bcfd30231e76249a", "assetId": "img:b97a8149d3d9ee8c575659919d7d5a408ec489a434421229bcfd30231e76249a", "mimeType": "image/jpeg", "elementId": "e000322", "sourceName": "assets/crop_1_1789042674125.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The rate of reaction increases as the concentration of the acid increases. Explain this relationship in terms of particles.", "label": "g", "marks": null, "partId": "q12-0217e860-pg", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 12, "figures": [{"url": "assets/crop_1_1789042674111.png", "width": 1125, "format": "png", "height": 1291, "sha256": "7eae5aa4e9186e51b29b4cef34eba673fe6b12790567acf477e194eb97858418", "assetId": "img:7eae5aa4e9186e51b29b4cef34eba673fe6b12790567acf477e194eb97858418", "mimeType": "image/jpeg", "elementId": "e000306", "sourceName": "assets/crop_1_1789042674111.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_1_1789042674125.png", "width": 1082, "format": "png", "height": 936, "sha256": "b97a8149d3d9ee8c575659919d7d5a408ec489a434421229bcfd30231e76249a", "assetId": "img:b97a8149d3d9ee8c575659919d7d5a408ec489a434421229bcfd30231e76249a", "mimeType": "image/jpeg", "elementId": "e000322", "sourceName": "assets/crop_1_1789042674125.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "mar