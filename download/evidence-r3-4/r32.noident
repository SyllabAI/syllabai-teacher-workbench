INSERT INTO public.document_chunks VALUES ('6c448921-ff57-40aa-8475-61e60ad066e9', '194e7fbc-9cc9-4407-842e-1fb4270e15ca', 6, 'pour some copper(II) sulfate solution into a boiling tube and record its temperature using a thermometer
