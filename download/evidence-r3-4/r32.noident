 "e000023", "e000024", "e000025", "e000026", "e000027", "e000028", "e000029", "e000030", "e000031", "e000033", "e000034", "e000035", "e000036", "e000037", "e000038", "e000039", "e000040", "e000042", "e000043", "e000044", "e000045", "e000047", "e000048", "e000050", "e000051", "e000053", "e000054", "e000055", "e000056", "e000057", "e000058", "e000059", "e000060", "e000061", "e000062", "e000063", "e000064", "e000065", "e000066", "e000067", "e000068", "e000069", "e000070", "e000071", "e000072", "e000073", "e000074", "e000075", "e000076", "e000077", "e000078", "e000079", "e000081", "e000082", "e000083", "e000084", "e000085", "e000086", "e000087", "e000088", "e000089", "e000090", "e000092", "e000094", "e000095", "e000096", "e000097", "e000098", "e000100", "e000101", "e000103", "e000104", "e000105", "e000106", "e000107", "e000108", "e000110", "e000112", "e000113", "e000114", "e000115", "e000116", "e000118", "e000120", "e000122", "e000123", "e000124", "e000127", "e000129", "e000130", "e000131", "e000132", "e000133", "e000134", "e000135", "e000137", "e000138", "e000139", "e000140", "e000141", "e000142", "e000143", "e000144", "e000145", "e000146", "e000147", "e000148", "e000150", "e000151", "e000152", "e000153", "e000154", "e000156", "e000157", "e000158", "e000159", "e000160", "e000161"], "pageNumber": 1}, {"level": 2, "title": "BLANK PAGE", "sectionId": "s005", "elementIds": ["e000163"], "pageNumber": 1}], "equations": [{"text": "\\mathrm {C} _ {6} \\mathrm {H} _ {1 2} \\mathrm {O} _ {6} (\\mathrm {a q}) \\rightarrow 2 \\mathrm {C} _ {2} \\mathrm {H} _ {5} \\mathrm {O H} (\\mathrm {a q}) + 2 \\mathrm {C O} _ {2} (\\mathrm {g})", "latex": "\\mathrm {C} _ {6} \\mathrm {H} _ {1 2} \\mathrm {O} _ {6} (\\mathrm {a q}) \\rightarrow 2 \\mathrm {C} _ {2} \\mathrm {H} _ {5} \\mathrm {O H} (\\mathrm {a q}) + 2 \\mathrm {C O} _ {2} (\\mathrm {g})", "confidence": 1.0, "element_id": "e000111", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 111, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {C} _ {2} \\mathrm {H} _ {5} \\mathrm {O H} + 3 \\mathrm {O} _ {2} \\rightarrow 2 \\mathrm {C O} _ {2} + 3 \\mathrm {H} _ {2} \\mathrm {O}", "latex": "\\mathrm {C} _ {2} \\mathrm {H} _ {5} \\mathrm {O H} + 3 \\mathrm {O} _ {2} \\rightarrow 2 \\mathrm {C O} _ {2} + 3 \\mathrm {H} _ {2} \\mathrm {O}", "confidence": 1.0, "element_id": "e000117", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 117, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {M g C O} _ {3} + 2 \\mathrm {H C l} \\rightarrow \\mathrm {M g C l} _ {2} + \\mathrm {H} _ {2} \\mathrm {O} + \\mathrm {C O} _ {2}", "latex": "\\mathrm {M g C O} _ {3} + 2 \\mathrm {H C l} \\rightarrow \\mathrm {M g C l} _ {2} + \\mathrm {H} _ {2} \\mathrm {O} + \\mathrm {C O} _ {2}", "confidence": 1.0, "element_id": "e000136", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 136, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\begin{array}{c c c} 2 \\mathrm {N O} _ {2} (\\mathrm {g}) & \\rightleftharpoons & \\mathrm {N} _ {2} \\mathrm {O} _ {4} (\\mathrm {g}) \\\\ \\mathrm {b r o w n g a s} & & \\mathrm {c o l o u r l e s s g a s} \\end{array}", "latex": "\\begin{array}{c c c} 2 \\mathrm {N O} _ {2} (\\mathrm {g}) & \\rightleftharpoons & \\mathrm {N} _ {2} \\mathrm {O} _ {4} (\\mathrm {g}) \\\\ \\mathrm {b r o w n g a s} & & \\mathrm {c o l o u r l e s s g a s} \\end{array}", "confidence": 1.0, "element_id": "e000149", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 149, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "pageCount": 1, "documentId": "24df1df1-76c7-51e1-88c7-1ff3dd24bf7e", "provenance": {"engine": "glm-ocr-markdown", "application": "syllabai-parser", "extractedAt": "2026-09-13T12:59:34.953404316Z", "engineVersion": "1.1.0", "schemaVersion": "1.0", "extractionParams": {"pageBoundaries": "none-in-source", "sourceLineCount": 199, "upstreamConverter": "zai-glm-ocr", "entityDecodedLines": 0, "signedUrlFigureRefs": 0, "normalizedHtmlEntities": true}}, "textBlocks": [{"role": "heading", "text": "Instructions", "confidence": 1.0, "element_id": "e000001", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 1, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Use black ink or ball-point pen.", "confidence": 1.0, "element_id": "e000002", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 2, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Fill in the boxes at the top of this page with your name, centre number and candidate number.", "confidence": 1.0, "element_id": "e000003", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 3, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer all questions.", "confidence": 1.0, "element_id": "e000004", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 4, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer the questions in the spaces provided", "confidence": 1.0, "element_id": "e000005", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 5, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "there may be more space than you need.", "confidence": 1.0, "element_id": "e000006", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 6, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Show all the steps in any calculations and state the units.", "confidence": 1.0, "element_id": "e000007", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 7, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Some questions must be answered with a cross in a box. If you change your mind about an answer, put a line through the box and then mark your new answer with a cross.", "confidence": 1.0, "element_id": "e000008", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 8, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Information", "confidence": 1.0, "element_id": "e000009", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 9, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The total mark for this paper is 60.", "confidence": 1.0, "element_id": "e000010", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 10, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The marks for each question are shown in brackets", "confidence": 1.0, "element_id": "e000011", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 11, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "use this as a guide as to how much time to spend on each question.", "confidence": 1.0, "element_id": "e000012", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 12, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Advice", "confidence": 1.0, "element_id": "e000013", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 13, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Read each question carefully before you start to answer it.", "confidence": 1.0, "element_id": "e000014", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 14, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Write your answers neatly and in good English.", "confidence": 1.0, "element_id": "e000015", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 15, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Try to answer every question.", "confidence": 1.0, "element_id": "e000016", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 16, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Check your answers if you have time at the end.", "confidence": 1.0, "element_id": "e000017", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 17, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Turn over", "confidence": 1.0, "element_id": "e000018", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 18, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Answer ALL questions.", "confidence": 1.0, "element_id": "e000020", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 20, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "1 The box contains the names of some substances.", "confidence": 1.0, "element_id": "e000021", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 21, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Choose a substance from the box that best matches each description. Each substance may be used once, more than once or not at all.", "confidence": 1.0, "element_id": "e000023", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 23, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Which substance is a mixture?", "confidence": 1.0, "element_id": "e000024", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 24, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Which substance is a gas that makes a squeaky pop when ignited?", "confidence": 1.0, "element_id": "e000025", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 25, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Which substance is an element that is a green gas at room temperature?", "confidence": 1.0, "element_id": "e000026", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 26, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) Which substance is used to sterilise water?", "confidence": 1.0, "element_id": "e000027", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 27, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(e) Which substance is a metal that can be made by heating its oxide with carbon?", "confidence": 1.0, "element_id": "e000028", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 28, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 1 = 5 marks)", "confidence": 1.0, "element_id": "e000029", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 29, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "2 Oxides can be made by burning elements in air.", "confidence": 1.0, "element_id": "e000030", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 30, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The table gives some information about the oxides of four elements.", "confidence": 1.0, "element_id": "e000031", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 31, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Calcium and magnesium are metals. Carbon and sulfur are non-metals.", "confidence": 1.0, "element_id": "e000033", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 33, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Using only information from the table, state two ways in which the oxides of the metals are similar to each other.", "confidence": 1.0, "element_id": "e000034", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 34, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Using only information from the table, state two ways in which the oxides of the non-metals are similar to each other.", "confidence": 1.0, "element_id": "e000035", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 35, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) A teacher tells his students that when phosphorus burns in air a white solid oxide forms. This oxide is very soluble in water and forms an acidic solution.", "confidence": 1.0, "element_id": "e000036", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 36, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) One student states that phosphorus is a metal.", "confidence": 1.0, "element_id": "e000037", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 37, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Use information from the table to suggest why the student made this statement.", "confidence": 1.0, "element_id": "e000038", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 38, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Another student states that phosphorus is a non-metal. Use information from the table to suggest why the student made this statement.", "confidence": 1.0, "element_id": "e000039", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 39, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) An experiment using this apparatus shows that phosphorus is a non-metal.", "confidence": 1.0, "element_id": "e000040", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 40, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Explain how this experiment shows that phosphorus is a non-metal.", "confidence": 1.0, "element_id": "e000042", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 42, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 2 = 6 marks)", "confidence": 1.0, "element_id": "e000043", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 43, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "3 This question is about the reactivity of metals.", "confidence": 1.0, "element_id": "e000044", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 44, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) This apparatus can be used to compare the reactivities of different metals.", "confidence": 1.0, "element_id": "e000045", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 45, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A metal is heated with the oxide of a different metal.", "confidence": 1.0, "element_id": "e000047", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 47, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The table shows the results of two experiments.", "confidence": 1.0, "element_id": "e000048", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 48, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Explain how these results show the order of reactivity of calcium, tin and titanium.", "confidence": 1.0, "element_id": "e000050", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 50, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The diagram shows a method of making iron.", "confidence": 1.0, "element_id": "e000051", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 51, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) The word equation for the reaction that occurs is", "confidence": 1.0, "element_id": "e000053", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 53, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "aluminium + iron(III) oxide $ \\rightarrow $ aluminium oxide+ iron", "confidence": 1.0, "element_id": "e000054", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 54, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Write a chemical equation for this reaction.", "confidence": 1.0, "element_id": "e000055", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 55, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Explain which substance is oxidised in this reaction.", "confidence": 1.0, "element_id": "e000056", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 56, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Explain why aluminium and iron(III) oxide are used in powdered form rather than large pieces.", "confidence": 1.0, "element_id": "e000057", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 57, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 3 = 8 marks)", "confidence": 1.0, "element_id": "e000058", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 58, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "4 Chemical tests can be used to detect ions in solids and in aqueous solutions.", "confidence": 1.0, "element_id": "e000059", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 59, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) A solid produces a gas when heated with sodium hydroxide solution. Damp red litmus paper is turned blue by the gas.", "confidence": 1.0, "element_id": "e000060", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 60, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Which of these ions is present in the solid?", "confidence": 1.0, "element_id": "e000061", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 61, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A $ \\mathrm{C u}^{2+} $", "confidence": 1.0, "element_id": "e000062", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 62, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B $ \\mathrm{F e}^{2+} $", "confidence": 1.0, "element_id": "e000063", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 63, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C $ \\mathrm{F e}^{3+} $", "confidence": 1.0, "element_id": "e000064", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 64, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "$ \\times $ D $ \\mathrm{N H_{4}^{+}} $", "confidence": 1.0, "element_id": "e000065", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 65, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) When dilute nitric acid is added to an aqueous solution, followed by silver nitrate solution, a yellow precipitate forms.", "confidence": 1.0, "element_id": "e000066", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 66, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Which of these halide ions is present in the aqueous solution?", "confidence": 1.0, "element_id": "e000067", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 67, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A $ \\mathrm{B r}^{-} $", "confidence": 1.0, "element_id": "e000068", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 68, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B $ \\mathrm{C l}^{-} $", "confidence": 1.0, "element_id": "e000069", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 69, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C $ \\mathrm{F}^{-} $", "confidence": 1.0, "element_id": "e000070", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 70, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D $ \\mathrm{I}^{-} $", "confidence": 1.0, "element_id": "e000071", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 71, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) When dilute hydrochloric acid is added to a solid, a gas forms. Which of these ions is present in the solid?", "confidence": 1.0, "element_id": "e000072", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 72, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A carbonate", "confidence": 1.0, "element_id": "e000073", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 73, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B hydroxide", "confidence": 1.0, "element_id": "e000074", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 74, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C nitrate", "confidence": 1.0, "element_id": "e000075", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 75, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D sulfate", "confidence": 1.0, "element_id": "e000076", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 76, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) Sodium hydroxide solution is added separately to three solutions.", "confidence": 1.0, "element_id": "e000077", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 77, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "One solution contains $ \\mathrm{C u}^{2+} $ ions, another contains $ \\mathrm{F e}^{2+} $ ions and the third solution contains $ \\mathrm{F e}^{3+} $ ions.", "confidence": 1.0, "element_id": "e000078", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 78, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Which row shows the correct colours of the precipitates that form?", "confidence": 1.0, "element_id": "e000079", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 79, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Which of these ions is present in the aqueous solution?", "confidence": 1.0, "element_id": "e000081", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 81, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(e) When barium chloride solution is added to an aqueous solution of a compound, a white precipitate forms. When dilute hydrochloric acid is added to the mixture, the precipitate disappears and a colourless solution forms.", "confidence": 1.0, "element_id": "e000082", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 82, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A carbonate", "confidence": 1.0, "element_id": "e000083", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 83, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B chloride", "confidence": 1.0, "element_id": "e000084", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 84, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C nitrate", "confidence": 1.0, "element_id": "e000085", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 85, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D sulfate", "confidence": 1.0, "element_id": "e000086", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 86, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 4 = 5 marks)", "confidence": 1.0, "element_id": "e000087", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 87, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "5 Lithium and carbon both form fluorides.", "confidence": 1.0, "element_id": "e000088", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 88, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Lithium reacts with fluorine to produce the ionic compound lithium fluoride.", "confidence": 1.0, "element_id": "e000089", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 89, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The diagrams show the arrangement of electrons in a lithium atom and in a fluorine atom.", "confidence": 1.0, "element_id": "e000090", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 90, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "lithium atom", "confidence": 1.0, "element_id": "e000092", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 92, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "fluorine atom", "confidence": 1.0, "element_id": "e000094", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 94, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Draw similar diagrams to show the arrangement of the electrons in the ions formed when lithium reacts with fluorine.", "confidence": 1.0, "element_id": "e000095", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 95, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Show all the electrons in each ion.", "confidence": 1.0, "element_id": "e000096", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 96, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Carbon tetrafluoride is a simple molecular compound.", "confidence": 1.0, "element_id": "e000097", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 97, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The displayed formula for a molecule of carbon tetrafluoride is", "confidence": 1.0, "element_id": "e000098", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 98, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Draw a dot and cross diagram to show the arrangement of the electrons in this molecule. Show only the outer electrons.", "confidence": 1.0, "element_id": "e000100", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 100, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) The table shows some properties of lithium fluoride and carbon tetrafluoride.", "confidence": 1.0, "element_id": "e000101", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 101, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Explain these properties of each compound.", "confidence": 1.0, "element_id": "e000103", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 103, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "lithium fluoride.", "confidence": 1.0, "element_id": "e000104", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 104, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "carbon tetrafluoride", "confidence": 1.0, "element_id": "e000105", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 105, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 5 = 8 marks)", "confidence": 1.0, "element_id": "e000106", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 106, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "6 Ethanol can be produced when yeast is added to a glucose solution.", "confidence": 1.0, "element_id": "e000107", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 107, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "This apparatus is used to investigate the reaction.", "confidence": 1.0, "element_id": "e000108", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 108, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) The equation for the reaction is", "confidence": 1.0, "element_id": "e000110", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 110, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) State the purpose of the yeast.", "confidence": 1.0, "element_id": "e000112", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 112, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) State how the appearance of the limewater changes during the reaction.", "confidence": 1.0, "element_id": "e000113", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 113, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) State the temperature at which this reaction is carried out in industry.", "confidence": 1.0, "element_id": "e000114", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 114, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Ethanol can be used as a fuel.", "confidence": 1.0, "element_id": "e000115", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 115, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "This is the equation for the complete combustion of ethanol.", "confidence": 1.0, "element_id": "e000116", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 116, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "These are the displayed formulae for ethanol, oxygen, carbon dioxide and water.", "confidence": 1.0, "element_id": "e000118", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 118, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The table gives some average (mean) bond energies.", "confidence": 1.0, "element_id": "e000120", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 120, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Use this information to calculate the enthalpy change $ (\\Delta H) $ when one mole of ethanol is completely burned.", "confidence": 1.0, "element_id": "e000122", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 122, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Ethanol and methanol can both be used as fuels.", "confidence": 1.0, "element_id": "e000123", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 123, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A student uses this apparatus to find out how much energy is produced when one mole of ethanol and one mole of methanol are burned.", "confidence": 1.0, "element_id": "e000124", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 124, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The table shows some of the student''s results.", "confidence": 1.0, "element_id": "e000127", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 127, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Calculate the energy given out by 1 mol of methanol.", "confidence": 1.0, "element_id": "e000129", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 129, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(2)", "confidence": 1.0, "element_id": "e000130", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 130, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The student uses the same burner and copper can in each experiment. State two other factors that the student should keep the same in each experiment. (2)", "confidence": 1.0, "element_id": "e000131", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 131, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) A data book states that the energy given out when 1 mol of ethanol is burned is 1371 kJ. Suggest two reasons why the student''s value is much less than this.", "confidence": 1.0, "element_id": "e000132", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 132, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 6 = 13 marks)", "confidence": 1.0, "element_id": "e000133", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 133, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "7 Magnesium chloride can be made by reacting excess magnesium carbonate with dilute hydrochloric acid.", "confidence": 1.0, "element_id": "e000134", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 134, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The equation for the reaction is", "confidence": 1.0, "element_id": "e000135", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 135, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) (i) In one experiment, a sample of 0.050 mol of $ \\mathrm{M g C O_{3}} $ is added to 0.080 mol of HCl. Show, by calculation, that the $ \\mathrm{M g C O_{3}} $ is in excess.", "confidence": 1.0, "element_id": "e000137", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 137, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Calculate the maximum volume, in $ cm^{3} $ , of carbon dioxide, measured at room temperature and pressure, that would be obtained when 0.080 mol of HCI react completely with $ MgCO_{3}. $", "confidence": 1.0, "element_id": "e000138", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 138, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "[One mole of any gas occupies 24 000 $ cm^{3} $ at room temperature and pressure.]", "confidence": 1.0, "element_id": "e000139", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 139, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "maximum volume of carbon dioxide =", "confidence": 1.0, "element_id": "e000140", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 140, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) In another experiment 0.050 mol of $ \\mathrm{M g C O_{3}} $ reacts with excess HCl.", "confidence": 1.0, "element_id": "e000141", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 141, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A yield of 5.5 g of $ \\mathrm{M g C l_{2}. 6 H_{2} O} $ is obtained.", "confidence": 1.0, "element_id": "e000142", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 142, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Calculate the percentage yield of $ \\mathrm{M g C l_{2}. 6 H_{2}O} $", "confidence": 1.0, "element_id": "e000143", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 143, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "percentage yield =", "confidence": 1.0, "element_id": "e000144", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 144, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Suggest why the percentage yield is less than 100%.", "confidence": 1.0, "element_id": "e000145", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 145, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 7 = 7 marks)", "confidence": 1.0, "element_id": "e000146", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 146, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "8 When nitrogen dioxide gas $ \\mathrm{(N O_{2})} $ is placed in a sealed flask, it reacts to form dinitrogen tetraoxide gas $ \\mathrm{(N_{2}O_{4})}. $", "confidence": 1.0, "element_id": "e000147", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 147, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The equation for the reaction is", "confidence": 1.0, "element_id": "e000148", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 148, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A sample of pure $ \\mathrm{N O_{2}} $ is placed in a sealed flask at $ 2 5^{\\circ} \\mathrm{C} $ . The flask is left until a dynamic equilibrium is reached.", "confidence": 1.0, "element_id": "e000150", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 150, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) For a reaction that is in dynamic equilibrium, the forward and backward reactions occur at the same time.", "confidence": 1.0, "element_id": "e000151", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 151, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "State two other features of a reaction that is in dynamic equilibrium.", "confidence": 1.0, "element_id": "e000152", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 152, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) At equilibrium there is more $ \\mathrm{N O_{2}} $ than $ \\mathrm{N_{2}O_{4}} $", "confidence": 1.0, "element_id": "e000153", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 153, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The graph shows how the number of moles of $ \\mathrm{N O_{2}} $ in the sealed flask changes with time.", "confidence": 1.0, "element_id": "e000154", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 154, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Draw a cross ( $ \\times $ ) on the graph at the point where the reaction reaches equilibrium.", "confidence": 1.0, "element_id": "e000156", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 156, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Draw a curve on the graph to show how the number of moles of $ \\mathrm{N_{2}O_{4}} $ in the sealed flask changes over the same time period.", "confidence": 1.0, "element_id": "e000157", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 157, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) The sealed flask containing the equilibrium mixture is placed in water at a temperature of $ 5 0^{\\circ} \\mathrm{C} $ . The mixture goes darker in colour.", "confidence": 1.0, "element_id": "e000158", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 158, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Explain what this observation shows about the equilibrium reaction.", "confidence": 1.0, "element_id": "e000159", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 159, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 8 = 8 marks)", "confidence": 1.0, "element_id": "e000160", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 160, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "TOTAL FOR PAPER=60 MARKS", "confidence": 1.0, "element_id": "e000161", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 161, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000162", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 162, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Every effort has been made to contact copyright holders to obtain their permission for the use of copyright material. Pearson Education Ltd. will, if notified, be happy to rectify any errors or omissions and include any such rectifications in future editions.", "confidence": 1.0, "element_id": "e000163", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 163, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "schemaVersion": "1.0"}', NULL, '2026-09-13 12:59:56.167767+00');
INSERT INTO public.documents VALUES ('220b5208-9700-4ed9-bd88-282b734e8caa', '3225cbae-c9a2-569f-8acc-9c1e84a10e55', '1.0', 1, 'MARK_SCHEME', 'corpus/igcse-chemistry-4ch0-2c-2017jan/MS.md', 'MS.md', 'text/markdown', 'f20fe163e6c65d28e4f92c242833ff63b2a412bdfa049a767fd4af3b5e5f9640', 'SHA-256', 1, 32, 31, 11, 'glm-ocr-markdown', '1.1.0', '2026-09-13 12:59:35.004986+00', '{"pages": [{"width": null, "height": null, "pageNumber": 1}], "source": {"uri": "corpus/igcse-chemistry-4ch0-2c-2017jan/MS.md", "checksum": "f20fe163e6c65d28e4f92c242833ff63b2a412bdfa049a767fd4af3b5e5f9640", "fileName": "MS.md", "mimeType": "text/markdown", "checksumAlgorithm": "SHA-256"}, "tables": [{"rows": [["Question number", "Answer", "Notes", "Marks"], ["1(a)", "air", "", "1"], ["(b)", "hydrogen", "ACCEPT H2IGNORE H", ""], ["(c)", "chlorine", "ACCEPT Cl2IGNORE Cl", "1"], ["(d)", "chlorine", "ACCEPT Cl2IGNORE Cl", "1"], ["(e)", "iron", "ACCEPT Fe", "1"], ["", "", "Total", "5"]], "text": "Question number | Answer | Notes | Marks\n1(a) | air |  | 1\n(b) | hydrogen | ACCEPT H2IGNORE H | \n(c) | chlorine | ACCEPT Cl2IGNORE Cl | 1\n(d) | chlorine | ACCEPT Cl2IGNORE Cl | 1\n(e) | iron | ACCEPT Fe | 1\n |  | Total | 5", "row_count": 7, "confidence": 1.0, "element_id": "e000019", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 19, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["2(a)(i)", "(both are) solids\nAND\n(both) form alkaline solutions(in water)\n(both are) gases\nAND\n(both) form acidic solutions(in water)", "ALLOW(both are)slightly soluble", "1"], ["(b)(i)\n(ii)", "the oxide is solid\nthe oxide forms an acidic solution(in water)", "", "1"], ["(c)", "M1 the lamp does not light up\nM2(so this shows that) phosphorus/it does not conduct electricity", "ACCEPT\nreverse arguments", "2"], ["", "", "Total", "6"]], "text": "Question number | Answer | Notes | Marks\n2(a)(i) | (both are) solids\nAND\n(both) form alkaline solutions(in water)\n(both are) gases\nAND\n(both) form acidic solutions(in water) | ALLOW(both are)slightly soluble | 1\n(b)(i)\n(ii) | the oxide is solid\nthe oxide forms an acidic solution(in water) |  | 1\n(c) | M1 the lamp does not light up\nM2(so this shows that) phosphorus/it does not conduct electricity | ACCEPT\nreverse arguments | 2\n |  | Total | 6", "row_count": 5, "confidence": 1.0, "element_id": "e000020", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 20, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["3(a)", "M1 calcium is the most reactive; titanium is the second most reactive; tin is the least reactiveOR calcium most reactiveAND tin least reactiveM2(because) titanium displaces tinM3(and because) titanium does not displace calcium", "ACCEPTCa>Ti>SnACCEPT replacesACCEPT replaces", "3"], ["(b)(i)(ii)(iii)", "2Al+Fe2O3→Al2O3+2FeM1aluminiumM2because it has gained oxygenORbecause it has lost electronsORbecause its oxidation number has increasedORbecause its oxidation number has changed from0to+3M2DEP onM1M1(powders have) larger surface areaM2(therefore) faster reaction", "ACCEPTmultiples and halves2M2DEP onM1ACCEPT reverse argumentsIGNOREreferences to collisions between particles", "12"], ["", "", "Total", "8"]], "text": "Question number | Answer | Notes | Marks\n3(a) | M1 calcium is the most reactive; titanium is the second most reactive; tin is the least reactiveOR calcium most reactiveAND tin least reactiveM2(because) titanium displaces tinM3(and because) titanium does not displace calcium | ACCEPTCa>Ti>SnACCEPT replacesACCEPT replaces | 3\n(b)(i)(ii)(iii) | 2Al+Fe2O3→Al2O3+2FeM1aluminiumM2because it has gained oxygenORbecause it has lost electronsORbecause its oxidation number has increasedORbecause its oxidation number has changed from0to+3M2DEP onM1M1(powders have) larger surface areaM2(therefore) faster reaction | ACCEPTmultiples and halves2M2DEP onM1ACCEPT reverse argumentsIGNOREreferences to collisions between particles | 12\n |  | Total | 8", "row_count": 4, "confidence": 1.0, "element_id": "e000021", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 21, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["4(a)", "D(NH4+)", "", "1"], ["(b)", "D(I-)", "", "1"], ["(c)", "A(carbonate)", "", "1"], ["(d)", "C(blue,green,brown)", "", "1"], ["(e)", "A(carbonate)", "", "1"], ["", "", "Total", "5"]], "text": "Question number | Answer | Notes | Marks\n4(a) | D(NH4+) |  | 1\n(b) | D(I-) |  | 1\n(c) | A(carbonate) |  | 1\n(d) | C(blue,green,brown) |  | 1\n(e) | A(carbonate) |  | 1\n |  | Total | 5", "row_count": 7, "confidence": 1.0, "element_id": "e000022", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 22, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["5(a)", "LiF", "1 mark for each correct ion\nIGNORE charges on ion\nALLOW any combination of dots and crosses\nDiagram showing sharing of electrons scores 0", "2"], ["(b)", "F2C2F2F2", "M1 all four bonding pairs correct, and only 8 electrons shown in outer shell of carbon\nM2 all non-bonding pairs correct\nIGNORE inner shells even if incorrect\nIf rings are drawn then both bonding electrons must be in the overlapping area\nM2 DEP on M1", "2"]], "text": "Question number | Answer | Notes | Marks\n5(a) | LiF | 1 mark for each correct ion\nIGNORE charges on ion\nALLOW any combination of dots and crosses\nDiagram showing sharing of electrons scores 0 | 2\n(b) | F2C2F2F2 | M1 all four bonding pairs correct, and only 8 electrons shown in outer shell of carbon\nM2 all non-bonding pairs correct\nIGNORE inner shells even if incorrect\nIf rings are drawn then both bonding electrons must be in the overlapping area\nM2 DEP on M1 | 2", "row_count": 3, "confidence": 1.0, "element_id": "e000023", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 23, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["(c)", "M1(high melting point of LiF) strong forces(of attraction) between(opositely charged)ions/strong forces(of attraction) betweenLi+andF-", "ACCEPTstrong(ionic)bonding/strong(ionic)bondsACCEPTlarge amount of energy required to overcome the forces between the ions/break(ionic)bondsREJECTany reference to molecules or intermolecular forcesREJECTreference to atoms", "4"], ["M2(good conductivity of LiF) ions are mobile", "ACCEPTions can moveREJECTany reference to electrons are mobile/delocalised electrons", ""], ["M3(low melting point of CF4) weak forces(of attraction) between molecules/weak intermolecular forces(of attraction)", "ACCEPTweak van der Waals forces/weak London forces/weak dispersion forcesACCEPTvery little energy required to overcome the intermolecular forces.ALLOWweak intermolecular bondsREJECTany references to covalent bonds broken", ""], ["M4(poor conductivity of CF4) molecules are not charged/molecules are neutral/no charged particles", "IGNOREno free electrons/all electrons used in bondingIGNOREthere are no ionsALLOWno delocalised/no mobile electrons", ""], ["", "", "Total", "8"]], "text": "Question number | Answer | Notes | Marks\n(c) | M1(high melting point of LiF) strong forces(of attraction) between(opositely charged)ions/strong forces(of attraction) betweenLi+andF- | ACCEPTstrong(ionic)bonding/strong(ionic)bondsACCEPTlarge amount of energy required to overcome the forces between the ions/break(ionic)bondsREJECTany reference to molecules or intermolecular forcesREJECTreference to atoms | 4\nM2(good conductivity of LiF) ions are mobile | ACCEPTions can moveREJECTany reference to electrons are mobile/delocalised electrons | \nM3(low melting point of CF4) weak forces(of attraction) between molecules/weak intermolecular forces(of attraction) | ACCEPTweak van der Waals forces/weak London forces/weak dispersion forcesACCEPTvery little energy required to overcome the intermolecular forces.ALLOWweak intermolecular bondsREJECTany references to covalent bonds broken | \nM4(poor conductivity of CF4) molecules are not charged/molecules are neutral/no charged particles | IGNOREno free electrons/all electrons used in bondingIGNOREthere are no ionsALLOWno delocalised/no mobile electrons | \n |  | Total | 8", "row_count": 6, "confidence": 1.0, "element_id": "e000024", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 24, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["6(a)(i)", "(to provide the)zymase/enzyme (that acts as a catalyst)", "ALLOW(to act as a) catalystALLOWto increase the rate of reactionIGNOREto lower the activation energyIGNOREto start the reactionREJECTto provide(activation) energy", "1"], ["(ii)", "(turns) milky/cloudy/turbid(then clear)ORwhite precipitate/white suspension/white solid(forms then disappears)", "", "1"], ["(iii)", "30℃", "ACCEPTany temperature,or range of temperatures,between25and40℃", "1"]], "text": "Question number | Answer | Notes | Marks\n6(a)(i) | (to provide the)zymase/enzyme (that acts as a catalyst) | ALLOW(to act as a) catalystALLOWto increase the rate of reactionIGNOREto lower the activation energyIGNOREto start the reactionREJECTto provide(activation) energy | 1\n(ii) | (turns) milky/cloudy/turbid(then clear)ORwhite precipitate/white suspension/white solid(forms then disappears) |  | 1\n(iii) | 30℃ | ACCEPTany temperature,or range of temperatures,between25and40℃ | 1", "row_count": 4, "confidence": 1.0, "element_id": "e000025", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 25, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["(b)", "Route 1:\nM1 Σ(bonds broken) =\n348+(5x412)+360+463+(3x496)\nOR\n4719(kJ/mol)\nM2 Σ(bonds made)=(4x743)+(6x463)\nOR\n5750(kJ/mol)\nRoute 2:\nM1 Σ(bonds broken) =\n348+(5x412)+360+(3x496)\nOR\n4256(kJ/mol)\nM2 Σ(bonds made)=(4x743)+(5x463)\nOR\n5287(kJ/mol)\nM3 4719-5750(kJ/mol)/M1-M2\nM4-1031(kJ/mol)\nOR correct evaluation ofM3\nSign required\nACCEPT answers given to three significant figures\nCorrect answer with no working scores4\n+1031(kJ/mol) scores3", "IGNORE negative sign\nIGNORE negative sign", "4"]], "text": "Question number | Answer | Notes | Marks\n(b) | Route 1:\nM1 Σ(bonds broken) =\n348+(5x412)+360+463+(3x496)\nOR\n4719(kJ/mol)\nM2 Σ(bonds made)=(4x743)+(6x463)\nOR\n5750(kJ/mol)\nRoute 2:\nM1 Σ(bonds broken) =\n348+(5x412)+360+(3x496)\nOR\n4256(kJ/mol)\nM2 Σ(bonds made)=(4x743)+(5x463)\nOR\n5287(kJ/mol)\nM3 4719-5750(kJ/mol)/M1-M2\nM4-1031(kJ/mol)\nOR correct evaluation ofM3\nSign required\nACCEPT answers given to three significant figures\nCorrect answer with no working scores4\n+1031(kJ/mol) scores3 | IGNORE negative sign\nIGNORE negative sign | 4", "row_count": 2, "confidence": 1.0, "element_id": "e000026", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 26, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["6(c)(i)", "M132", "", "2"], ["M2(32×15.6)=500(kJ)ORM1×15.6 correctly evaluated", "ACCEPT499/499.2Correct answer with no working scores2", ""], ["(ii)", "M1&M2Any two from:·mass of water/volume of water/amount of water·distance of flame from the can·length of wick", "IGNOREtemperature of water(at start)ALLOWdistance of burner from can", "2"], ["(iii)", "Any two from:M1heat(energy)/thermal ener