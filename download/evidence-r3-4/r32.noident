INSERT INTO public.questions VALUES ('0913d564-674b-4dc2-90d4-f33d6172b1f3', 'q05-9e5d961d', 'STRUCTURED', 'This question is about alkanes and alkenes. ( a ) ( i ) Complete the boxes by giving the missing information about the alkane with the molecular formula $ \mathrm{C_{2} H_{6}} $ (ii) Complete the chemical equation for the complete combustion of the alkane $ \mathrm{C_{2} H_{6}} $ $\dots \dots \mathrm {C} _ {2} \mathrm {H} _ {6} + \dots \dots \mathrm {O} _ {2} \rightarrow \dots \dots \mathrm {C O} _ {2} + \dots \dots \mathrm {H} _ {2} \mathrm {O}$ (iii) Incomplete combustion occurs when the air supply is limited Give the names of two products of incomplete combustion.', 15, 3, 1350, NULL, '1eb653d1-3323-4300-835b-7a5bff6ef258', 'PAST_PAPER', true, 1, '2026-09-13 12:55:24.287592+00', '37f3d597-4cdc-48f5-9a3d-f877478d7901');
INSERT INTO public.questions VALUES ('6c0aab6d-04b5-4d9b-9e3f-a64ad67a4dbd', 'q07-9e5d961d', 'STRUCTURED', 'A student investigates the reaction between magnesium and hydrochloric acid. He uses this method. Step 1 add $ 2 5 \mathrm{c m}^{3} $ of dilute hydrochloric acid to a polystyrene cup Step 2 record the temperature of the acid Step 3 find the mass of a 10cm strip of magnesium ribbon Step 4 add the magnesium ribbon to the hydrochloric acid Step 5 when all the magnesium has reacted, record the highest temperature reached', 9, 3, 810, NULL, '1eb653d1-3323-4300-835b-7a5bff6ef258', 'PAST_PAPER', true, 1, '2026-09-13 12:55:24.291317+00', '37f3d597-4cdc-48f5-9a3d-f877478d7901');
INSERT INTO public.questions VALUES ('730eec88-eb7d-4b74-8d03-b5184740fbd7', 'q08-9e5d961d', 'STRUCTURED', '(a) A scientist finds an unlabelled bottle on a shelf. She thinks the bottle contains a solution of ammonium sulfate, $ \mathrm{(N H_{4})_{2} S O_{4}} $ Describe tests the scientist could do to show that the solution is ammonium sulfate.', 1, 3, 90, NULL, '1eb653d1-3323-4300-835b-7a5bff6ef258', 'PAST_PAPER', true, 1, '2026-09-13 12:55:24.291472+00', '37f3d597-4cdc-48f5-9a3d-f877478d7901');
