INSERT INTO public.questions VALUES ('40000000-0000-0000-0000-000000000003', 'SEED-WCH11-003', 'MCQ_SINGLE', 'A compound contains 40.0% carbon, 6.7% hydrogen and 53.3% oxygen by mass. What is its empirical formula?', 1, 3, 120, 'Deduce', '20000000-0000-0000-0000-000000000013', 'SEED_DEMO', true, 1, '2026-09-13 12:40:01.099907+00', NULL);
