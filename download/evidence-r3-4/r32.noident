INSERT INTO public.document_chunks VALUES ('80a107a1-c2e2-4b76-be1b-e4252f1c8314', '2d6b66e7-a951-416a-9928-b33270df6d43', 4, 'Stage 2: Add the impure copper(II) oxide a little at a time and stir, until it is in excess.
