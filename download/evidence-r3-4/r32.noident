INSERT INTO public.questions VALUES ('aec013a9-b749-4328-8fb8-cd6a75d8bd00', 'q05-8d262f6a', 'STRUCTURED', 'Ethanol can be manufactured by fermentation or by the direct hydration of ethene.', 12, 3, 1080, NULL, '640f38f1-b37e-4771-b161-c2af219bce30', 'PAST_PAPER', true, 1, '2026-09-13 13:00:40.256643+00', 'ad92a325-55f2-4e1f-80bc-789b55bc045d');
