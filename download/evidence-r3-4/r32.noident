INSERT INTO public.questions VALUES ('0b1c7a24-d7c6-48f4-97bc-b965ebb01c28', 'q07-c4075b63', 'STRUCTURED', 'A student set up this apparatus to measure the volume of carbon dioxide given off when a sample of a carbonate of a Group 2 metal was reacted with dilute nitric acid. She weighed out some of the carbonate and put it in a conical flask. She then added an excess of dilute nitric acid. After adding the acid she placed the bung and delivery tube into the conical flask. She measured the total volume of gas collected at room temperature and pressure (rtp) in the measuring cylinder. Her results are shown in the table. The equation for the reaction is $\mathrm {X C O} _ {3} (\mathrm {s}) + 2 \mathrm {H N O} _ {3} (\mathrm {a q}) \rightarrow \mathrm {X} \left(\mathrm {N O} _ {3}\right) _ {2} (\mathrm {a q}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {l}) + \mathrm {C O} _ {2} (\mathrm {g})$ where X is the symbol for the Group 2 metal.', 10, 3, 900, NULL, 'fe86e869-d65f-40ed-8a28-9c17856e9fdf', 'PAST_PAPER', true, 1, '2026-09-13 12:58:26.063328+00', 'f4fe6326-5a81-493b-90c5-eab47ad9fbbf');
