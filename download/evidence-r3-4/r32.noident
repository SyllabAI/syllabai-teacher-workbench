ple of calculation:\nPb O\nM1 86.6÷207 13.4÷16\nM2 0.42 0.84\nM3 (0.42÷0.42=)1 (0.84÷0.42=)2 | 0 marks if division by atomic numbers or calculation upside down ACCEPT alternative methods | 3 exp\n(c)(i) | M1 $Pb_{3}O_{4}(s)+4HNO_{3}(aq)$\nM2 2Pb($NO_{3}$)2(aq)+2H2O | both state symbols required ALLOW upper case letters for state symbols both numbers required | 2 grad", "row_count": 4, "confidence": 1.0, "element_id": "e000041", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 41, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["10(c)(ii)", "description that makes reference to the following three points:", "", "6 exp"], ["", "M1 warm/heat (nitric) acid", "REJECT boil", ""], ["", "M2 add/mix/react (red) lead oxide (and stir)", "IGNORE references to adding excess(red) lead oxide", ""], ["", "M3 filter to obtain lead(II) nitrate solution", "ALLOW to remove lead(IV) oxide/PbO2", ""], ["", "", "ALLOW to remove (unreacted/excess) red lead oxide/Pb3O4", ""], ["", "AND three of the following points:", "", ""], ["", "M4 heat/boil (lead(II) nitrate) solution/filtrate", "If heat to dryness only M4 can be scored", ""], ["", "M5 until crystals form in a cooled sample/on a glass rod OWTTE", "ACCEPT to crystallisation point/to form a saturated solution /until crystals start to form /to remove some of the water", ""], ["", "", "M5 DEP M4", ""], ["", "M6 leave solution to cool / leave solution for more crystals to form", "", ""], ["", "M7(and then) filter off crystals/lead nitrate", "ACCEPT decant off the solution", ""], ["", "", "M7 DEP M6", ""], ["", "", "IGNORE references to washing", ""], ["", "M8 suitable method of drying the crystals eg using filter paper/using paper towel/in a warm oven", "REJECT hot oven or any method of direct heating eg Bunsen", ""], ["", "", "ALLOW leave to dry but not just dry the crystals", ""], ["", "", "No M8 if crystals are washed after drying", ""]], "text": "10(c)(ii) | description that makes reference to the following three points: |  | 6 exp\n | M1 warm/heat (nitric) acid | REJECT boil | \n | M2 add/mix/react (red) lead oxide (and stir) | IGNORE references to adding excess(red) lead oxide | \n | M3 filter to obtain lead(II) nitrate solution | ALLOW to remove lead(IV) oxide/PbO2 | \n |  | ALLOW to remove (unreacted/excess) red lead oxide/Pb3O4 | \n | AND three of the following points: |  | \n | M4 heat/boil (lead(II) nitrate) solution/filtrate | If heat to dryness only M4 can be scored | \n | M5 until crystals form in a cooled sample/on a glass rod OWTTE | ACCEPT to crystallisation point/to form a saturated solution /until crystals start to form /to remove some of the water | \n |  | M5 DEP M4 | \n | M6 leave solution to cool / leave solution for more crystals to form |  | \n | M7(and then) filter off crystals/lead nitrate | ACCEPT decant off the solution | \n |  | M7 DEP M6 | \n |  | IGNORE references to washing | \n | M8 suitable method of drying the crystals eg using filter paper/using paper towel/in a warm oven | REJECT hot oven or any method of direct heating eg Bunsen | \n |  | ALLOW leave to dry but not just dry the crystals | \n |  | No M8 if crystals are washed after drying | ", "row_count": 16, "confidence": 1.0, "element_id": "e000042", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 42, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "figures": [], "version": 1, "sections": [{"level": 2, "title": "Edexcel and BTEC Qualifications", "sectionId": "s001", "elementIds": ["e000006"], "pageNumber": 1}, {"level": 2, "title": "Pearson: helping people progress, everywhere", "sectionId": "s002", "elementIds": ["e000008", "e000009", "e000010", "e000011", "e000012", "e000013", "e000014", "e000015", "e000016", "e000017", "e000019", "e000021", "e000023", "e000026", "e000029", "e000032", "e000035", "e000040", "e000043"], "pageNumber": 1}], "equations": [], "pageCount": 1, "documentId": "d1b85e6b-1de4-5d58-8a20-99909f028cb6", "provenance": {"engine": "glm-ocr-markdown", "application": "syllabai-parser", "extractedAt": "2026-09-13T12:55:03.352351396Z", "engineVersion": "1.1.0", "schemaVersion": "1.0", "extractionParams": {"pageBoundaries": "none-in-source", "sourceLineCount": 58, "upstreamConverter": "zai-glm-ocr", "entityDecodedLines": 1, "signedUrlFigureRefs": 0, "normalizedHtmlEntities": true}}, "textBlocks": [{"role": "paragraph", "text": "PMT", "confidence": 1.0, "element_id": "e000000", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 0, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Pearson Edexcel", "confidence": 1.0, "element_id": "e000001", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 1, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Mark Scheme (Results)", "confidence": 1.0, "element_id": "e000002", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 2, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "November 2020", "confidence": 1.0, "element_id": "e000003", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 3, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Pearson Edexcel International GCSE In Chemistry (4CH1) Paper 1C and Science (Double Award) (4SD0) Paper 1C", "confidence": 1.0, "element_id": "e000004", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 4, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Edexcel and BTEC Qualifications", "confidence": 1.0, "element_id": "e000005", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 5, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Edexcel and BTEC qualifications are awarded by Pearson, the UK''s largest awarding body. We provide a wide range of qualifications including academic, vocational, occupational and specific programmes for employers. For further information visit our qualifications websites at www.edexcel.com or www.btec.co.uk. Alternatively, you can get in touch with us using the details on our contact us page at www.edexcel.com/contactus.", "confidence": 1.0, "element_id": "e000006", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 6, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Pearson: helping people progress, everywhere", "confidence": 1.0, "element_id": "e000007", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 7, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Pearson aspires to be the world''s leading learning company. Our aim is to help everyone progress in their lives through education. We believe in every kind of learning, for all kinds of people, wherever they are in the world. We''ve been involved in education for over 150 years, and by working across 70 countries, in 100 languages, we have built an international reputation for our commitment to high standards and raising achievement through innovation in education. Find out more about how we can help you and your students at: www.pearson.com/uk", "confidence": 1.0, "element_id": "e000008", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 8, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Autumn 2020 Publications Code 4CH1_1C_2011_MS All the material in this publication is copyright $ \\textcircled{c} $ Pearson Education Ltd 2020", "confidence": 1.0, "element_id": "e000009", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 9, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "All candidates must receive the same treatment. Examiners must mark the first candidate in exactly the same way as they mark the last.", "confidence": 1.0, "element_id": "e000010", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 10, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Mark schemes should be applied positively. Candidates must be rewarded for what they have shown they can do rather than penalised for omissions.", "confidence": 1.0, "element_id": "e000011", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 11, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Examiners should mark according to the mark scheme not according to their perception of where the grade boundaries may lie.", "confidence": 1.0, "element_id": "e000012", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 12, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "There is no ceiling on achievement. All marks on the mark scheme should be used appropriately.", "confidence": 1.0, "element_id": "e000013", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 13, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "All the marks on the mark scheme are designed to be awarded. Examiners should always award full marks if deserved, i.e. if the answer matches the mark scheme. Examiners should also be prepared to award zero marks if the candidate''s response is not worthy of credit according to the mark scheme.", "confidence": 1.0, "element_id": "e000014", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 14, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Where some judgement is required,mark schemes will provide the principles by which marks will be awarded and exemplification may be limited.", "confidence": 1.0, "element_id": "e000015", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 15, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "When examiners are in doubt regarding the application of the mark scheme to a candidate''s response, the team leader must be consulted.", "confidence": 1.0, "element_id": "e000016", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 16, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Crossed out work should be marked UNLESS the candidate has replaced it with an alternative response.", "confidence": 1.0, "element_id": "e000017", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 17, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Total for Q1=7 marks", "confidence": 1.0, "element_id": "e000019", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 19, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Total for Q2=6 marks", "confidence": 1.0, "element_id": "e000021", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 21, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Total for Q3=8 marks", "confidence": 1.0, "element_id": "e000023", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 23, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Total for Q4=10", "confidence": 1.0, "element_id": "e000026", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 26, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Total Q5=12", "confidence": 1.0, "element_id": "e000029", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 29, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Total for Q6=14", "confidence": 1.0, "element_id": "e000032", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 32, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Total Q7 =14", "confidence": 1.0, "element_id": "e000035", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 35, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Total Q9 = 12 marks", "confidence": 1.0, "element_id": "e000040", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 40, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Total for Q10=13 marks", "confidence": 1.0, "element_id": "e000043", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 43, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "schemaVersion": "1.0"}', NULL, '2026-09-13 12:55:23.233141+00');
INSERT INTO public.documents VALUES ('733281dd-7569-42af-8c7d-7bd9afbf5a18', '7682f9e7-cd79-5d42-aace-ed86260e1f0e', '1.0', 1, 'QUESTION_PAPER', 'corpus/igcse-chemistry-4ch0-1c-2020junr/QP.md', 'QP.md', 'text/markdown', 'ce65d4fd54ccede16ffc20dc621a2c88f0cd8225fac673043a0410a3b2d65a0f', 'SHA-256', 1, 201, 194, 14, 'glm-ocr-markdown', '1.1.0', '2026-09-13 12:55:04.009354+00', '{"pages": [{"width": null, "height": null, "pageNumber": 1}], "source": {"uri": "corpus/igcse-chemistry-4ch0-1c-2020junr/QP.md", "checksum": "ce65d4fd54ccede16ffc20dc621a2c88f0cd8225fac673043a0410a3b2d65a0f", "fileName": "QP.md", "mimeType": "text/markdown", "checksumAlgorithm": "SHA-256"}, "tables": [{"rows": [["Please check the examination details below before entering your candidate information"], ["Candidate surname", "Other names"], ["Centre Number Candidate Number"], ["Pearson Edexcel International GCSE (9-1)"], ["Thursday 14 May 2020"], ["Morning (Time: 2 hours)", "Paper Reference 4CH1/1CR 4SD0/1CR"], ["Chemistry\nUnit: 4CH1\nScience (Double Award) 4SD0\nPaper: 1CR"], ["You must have:\nCalculator, ruler", "Total Marks"]], "text": "Please check the examination details below before entering your candidate information\nCandidate surname | Other names\nCentre Number Candidate Number\nPearson Edexcel International GCSE (9-1)\nThursday 14 May 2020\nMorning (Time: 2 hours) | Paper Reference 4CH1/1CR 4SD0/1CR\nChemistry\nUnit: 4CH1\nScience (Double Award) 4SD0\nPaper: 1CR\nYou must have:\nCalculator, ruler | Total Marks", "row_count": 8, "confidence": 1.0, "element_id": "e000000", "page_number": 1, "bounding_box": null, "column_count": 1, "element_type": "table", "reading_order": 0, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["7Li lithium3", "9Be beryllium4", "Key", "4He helium2"], ["23Na sodium11", "24Mg magnesium12", "relative atomic massatomic symbolatomic (proton) number", "20Ne neon10"], ["39K potassium19", "40Ca calcium20", "45Sc scandium21", "48Ti ti