INSERT INTO public.question_parts VALUES ('de95c360-55f8-4be4-90b1-e6ef07408032', '4dc4e4b3-870e-43b7-b341-80627915edbe', 'c', 'Lead(II) chloride is an insoluble salt that can be prepared by reacting lead(II) nitrate with sodium chloride. Describe how you would prepare a pure, dry sample of lead(II) chloride starting from solid lead(II) nitrate and solid sodium chloride.', NULL, 0, 2, '2026-09-13 12:58:26.16121+00');
