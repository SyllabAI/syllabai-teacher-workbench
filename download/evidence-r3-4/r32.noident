INSERT INTO public.question_versions VALUES ('baa93980-a9d0-4882-95bc-ed1b8b910f75', 'c15ce991-0732-478c-9a5d-6acd9414552e', 1, 'The diagram shows a Bunsen burner.', 6, 3, 540, NULL, 'SUGGESTED', '8d262f6a-ad65-5742-8487-0ce90a11e77c', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:40.253525+00');
INSERT INTO public.question_versions VALUES ('6be2c841-6ff0-4a9e-be86-8501d518d6bf', '3c6f07ad-28ff-4b99-aad4-0053ae90b253', 1, 'A student uses this apparatus to investigate the burning of four different liquid fuels, W, X, Y and Z. The table shows the student''s results.', 4, 3, 360, NULL, 'SUGGESTED', '8d262f6a-ad65-5742-8487-0ce90a11e77c', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:40.255599+00');
INSERT INTO public.question_versions VALUES ('7c4166b8-9840-4fb8-bc68-dfeb43b86f5a', '7f165594-49d1-4029-9196-625fe09bb8bf', 1, 'A student makes an alkali solution by dissolving a small volume of cleaning liquid in deionised water. He then titrates a sample of this solution with an acid until neutralisation is complete.', 4, 3, 360, NULL, 'SUGGESTED', '8d262f6a-ad65-5742-8487-0ce90a11e77c', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:40.256031+00');
INSERT INTO public.question_versions VALUES ('b5bdc167-d781-435a-9106-720e91c9a674', 'bdecb8be-09cb-4ca6-9eed-0bf5919ce459', 1, 'Bromine, chlorine, fluorine and iodine are elements in Group 7 of the Periodic Table.', 6, 3, 540, NULL, 'SUGGESTED', '8d262f6a-ad65-5742-8487-0ce90a11e77c', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:40.256436+00');
INSERT INTO public.question_versions VALUES ('8ae5f9af-be8e-4653-a75a-938f2999f756', 'aec013a9-b749-4328-8fb8-cd6a75d8bd00', 1, 'Ethanol can be manufactured by fermentation or by the direct hydration of ethene.', 12, 3, 1080, NULL, 'SUGGESTED', '8d262f6a-ad65-5742-8487-0ce90a11e77c', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:40.256834+00');
INSERT INTO public.question_versions VALUES ('0da817be-4f3a-4764-94e4-956d48b6665c', 'efc553a6-08e5-4c24-85c4-2cdb00fc8de4', 1, 'Magnesium carbonate decomposes when heated to form magnesium oxide and carbon dioxide. The equation for the reaction is $\mathrm {M g C O} _ {3} (\mathrm {s}) \rightarrow \mathrm {M g O} (\mathrm {s}) + \mathrm {C O} _ {2} (\mathrm {g})$ Step1 weigh a clean, dry crucible and record the mass Step 2 add some magnesium carbonate Step 3 reweigh the crucible and contents and record the new mass Step 4 heat the crucible and contents for five minutes Step 5 allow the crucible and contents to cool and then reweigh Step 6 repeat steps 4 and 5 until the mass of the crucible and contents does not change The student does the experiment four times. The table shows her results. A student uses this method to investigate the reaction.', 4, 3, 360, NULL, 'SUGGESTED', '8d262f6a-ad65-5742-8487-0ce90a11e77c', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:40.257629+00');
INSERT INTO public.question_versions VALUES ('263d339d-4122-444d-aadd-c06e39b26a37', '4d80d636-b2a3-41c9-914d-9d8c0ca95dfd', 1, 'Acid indigestion is caused by having too much hydrochloric acid in the stomach. The equation for the reaction between magnesium hydroxide and hydrochloric acid is $\mathrm {M g} (\mathrm {O H}) _ {2} (\mathrm {s}) + 2 \mathrm {H C l} (\mathrm {a q}) \rightarrow \mathrm {M g C l} _ {2} (\mathrm {a q}) + 2 \mathrm {H} _ {2} \mathrm {O} (\mathrm {I})$ He uses 0.29g of magnesium hydroxide to neutralise the hydrochloric acid. A student investigates how much magnesium hydroxide is needed to neutralise $ 1 0 0 \mathrm{c m}^{3} $ of hydrochloric acid with a concentration of $ 0. 0 9 6 8 \mathrm{m o l} / \mathrm{d m}^{3}. $', 6, 3, 540, NULL, 'SUGGESTED', '8d262f6a-ad65-5742-8487-0ce90a11e77c', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:40.258019+00');
INSERT INTO public.question_versions VALUES ('a2b88c48-7848-4b07-bf1d-1dc64b1668bf', 'c7f854d0-45e4-46ba-b120-0101da983248', 1, 'The flow chart shows the steps in the manufacture of sulfuric acid.', 10, 3, 900, NULL, 'SUGGESTED', '8d262f6a-ad65-5742-8487-0ce90a11e77c', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:40.258429+00');
INSERT INTO public.question_versions VALUES ('cba624fe-17c6-4829-a551-34ba24a391ac', 'bcf470bc-b7f9-472c-85df-d466b31421a6', 1, 'The diagram shows six pieces of apparatus that are used in the laboratory. E F The table lists the names of four pieces of apparatus. Complete the table by giving a letter, A, B, C, D, E or F, to identify each piece of apparatus listed.', 1, 3, 90, NULL, 'SUGGESTED', '3097a144-271a-522d-ab0e-3ee70ce778f6', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:40.592463+00');
INSERT INTO public.question_versions VALUES ('35f173c5-d20c-4293-9823-50a75b43da83', '46cb2f25-f872-4287-92b3-0e05143a3847', 1, 'Rubidium is an element in Group 1 of the Periodic Table. 85 87 A sample of rubidium contains two isotopes, $ _{37}Rb $ and $ _{37}Rb $ (a) (i) State how the nuclei of the two isotopes are similar. (ii) State how the nuclei of the two isotopes are different. (iii) How many electrons are in the outer shell of a rubidium atom? A 1 B 3 C 9 D 37', 5, 3, 450, NULL, 'SUGGESTED', '3097a144-271a-522d-ab0e-3ee70ce778f6', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:40.592889+00');
INSERT INTO public.question_versions VALUES ('38a21fc7-4183-4058-b9ba-cb7e5407182d', '644efe0d-b5aa-4040-a80a-ace777cd5cd3', 1, 'A student uses this apparatus to investigate the action of heat on sodium hydrogencarbonate $ \mathrm{(N a H C O_{3})}. $ The equation for the reaction is $2 \mathrm {N a H C O} _ {3} (\mathrm {s}) \rightarrow \mathrm {N a} _ {2} \mathrm {C O} _ {3} (\mathrm {s}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {g}) + \mathrm {C O} _ {2} (\mathrm {g})$', 5, 3, 450, NULL, 'SUGGESTED', '3097a144-271a-522d-ab0e-3ee70ce778f6', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:40.593193+00');
INSERT INTO public.question_versions VALUES ('761ccdfa-7e4c-4db6-b4aa-6258d533511b', 'd2ef4fa5-249b-4df0-a81a-e0c6c1360b77', 1, 'Sodium reacts with fluorine to form sodium fluoride. The reaction is very exothermic.', 1, 3, 90, NULL, 'SUGGESTED', '3097a144-271a-522d-ab0e-3ee70ce778f6', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:40.593481+00');
INSERT INTO public.question_versions VALUES ('23931d0c-f4cd-4f72-8752-a1d3575cae7c', '51d82033-bb09-4f77-879b-74855d9fcfc1', 1, 'A student finds the temperature change when a mass of 0.5 g of sodium hydrogencarbonate is added to $ 5 0 \mathrm{c m}^{3} $ of a solution of citric acid. She repeats the experiment using masses of 1.0g, 1.5g and 2.0g of sodium hydrogencarbonate.', 6, 3, 540, NULL, 'SUGGESTED', '3097a144-271a-522d-ab0e-3ee70ce778f6', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:40.593807+00');
INSERT INTO public.question_versions VALUES ('da659175-68b2-4aa3-b6b1-60dfdac776e9', 'c7cdd2b6-57bb-4c38-b428-43d7cb8e8d32', 1, 'Poly(ethene) is an addition polymer made from ethene, $ \mathrm{C_{2} H_{4}} $', 7, 3, 630, NULL, 'SUGGESTED', '3097a144-271a-522d-ab0e-3ee70ce778f6', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:40.594085+00');
INSERT INTO public.question_versions VALUES ('3979f828-8ed9-4581-bc74-55997a0c71af', 'f9e5c33a-3e90-4a69-aefd-4c649adcd8ed', 1, 'Magnesium can be obtained by the electrolysis of magnesium chloride. Solid magnesium chloride is obtained from seawater. The magnesium chloride is melted and then electrolysed. The positive electrode is made of graphite and the negative electrode is made of steel. Magnesium forms at the negative electrode. Chlorine forms at the positive electrode.', 4, 3, 360, NULL, 'SUGGESTED', '3097a144-271a-522d-ab0e-3ee70ce778f6', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:40.594388+00');
INSERT INTO public.question_versions VALUES ('f22f107a-04aa-4043-b6ec-5fc5ec94d3df', '57e542eb-6fa6-4e96-8255-9c39435fc4a9', 1, 'Submarines that spend a long time underwater use sodium peroxide $ \mathrm{(N a_{2} O_{2})} $ to absorb carbon dioxide $ \mathrm{(C O_{2})} $ from the air in the submarine. The equation for the reaction is $2 \mathrm {N a} _ {2} \mathrm {O} _ {2} + 2 \mathrm {C O} _ {2} \rightarrow 2 \mathrm {N a} _ {2} \mathrm {C O} _ {3} + \mathrm {O} _ {2}$', 6, 3, 540, NULL, 'SUGGESTED', '3097a144-271a-522d-ab0e-3ee70ce778f6', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:40.594698+00');
INSERT INTO public.question_versions VALUES ('2557f262-f31c-402d-866d-09adee16ab18', '40c43a50-85a0-49e1-9d85-1d1db70055c0', 1, 'Ethanol $ \left( \mathrm{C}_{2} \mathrm{H}_{5} \mathrm{O H} \right) $ is made in industry by reacting ethene $ \left( \mathrm{C}_{2} \mathrm{H}_{4} \right) $ with steam at a temperature of $ 3 0 0^{\circ} \mathrm{C} $ and a pressure of 70 atm. The percentage yield of ethanol is 43%. The equation for the reaction is $\mathrm {C} _ {2} \mathrm {H} _ {4} (\mathrm {g}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {g}) \rightleftharpoons \mathrm {C} _ {2} \mathrm {H} _ {5} \mathrm {O H} (\mathrm {g}) \quad \Delta H = - 4 5. 3 \mathrm {k J / m o l}$', 9, 3, 810, NULL, 'SUGGESTED', '3097a144-271a-522d-ab0e-3ee70ce778f6', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:40.594996+00');
INSERT INTO public.question_versions VALUES ('a0997405-1f47-421c-8973-8925aea585ff', 'cf283628-a3c9-4a55-afa7-f9e5ade124dd', 1, 'Samarium, Sm, is a metal used to make powerful magnets.', 7, 3, 630, NULL, 'SUGGESTED', '3097a144-271a-522d-ab0e-3ee70ce778f6', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:40.595308+00');
INSERT INTO public.question_versions VALUES ('acb8958d-4274-4673-816b-ba91a7882b79', 'c6938959-6f67-4e97-af48-e0ba9c5d66d9', 1, 'The diagram shows the particles in an atom of an element.', 6, 3, 540, NULL, 'SUGGESTED', '16e341a9-4824-549a-be76-abca668eb91f', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:40.800641+00');
INSERT INTO public.question_versions VALUES ('8b41c6e7-1293-4cbe-bc89-ed26430a04dc', 'b6351359-375f-4a3c-b16e-43913b81061a', 1, 'The table gives some information about the halogens, chlorine, bromine and iodine.', 9, 3, 810, NULL, 'SUGGESTED', '16e341a9-4824-549a-be76-abca668eb91f', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:40.801155+00');
INSERT INTO public.question_versions VALUES ('47d4013c-fcfc-485a-8af4-8d8a6874e423', '87e95a64-52d1-464d-b7e1-5fe536aef6bc', 1, 'Methanol, ethanol, propanol and butanol are alcohols. They are all liquids that evaporate easily when warmed. She uses this method. pour some methanol into an evaporating basin place the evaporating basin on top of a beaker containing hot water measure the time taken for the methanol to evaporate completely repeat the experiment with each of the other alcohols, using the same apparatus A student uses this apparatus to compare the time taken for the four liquids to evaporate.', 9, 3, 810, NULL, 'SUGGESTED', '16e341a9-4824-549a-be76-abca668eb91f', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:40.801476+00');
INSERT INTO public.question_versions VALUES ('9cfbfd24-24e9-47a8-b8f0-971f22ee7270', '17d60e5b-923e-4bd1-80f8-b1a195849356', 1, 'This question is about metals.', 7, 3, 630, NULL, 'SUGGESTED', '16e341a9-4824-549a-be76-abca668eb91f', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:40.801962+00');
INSERT INTO public.question_versions VALUES ('68eee896-bb6a-4388-ae83-2ed96f3c51b2', '4eb72677-d7cb-441f-896b-b18139c2abd9', 1, 'The diagram shows the sub-atomic particles in an atom of an element.', 5, 3, 450, NULL, 'SUGGESTED', '35fdc8b0-ffff-5f0d-a81b-100139963e77', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:03:37.863161+00');
INSERT INTO public.question_versions VALUES ('646e032e-5ec3-49a1-8422-07f382fca71d', 'ab20064a-79f3-4e05-bd28-426d24c39299', 1, 'During the Second World War, engineers developed a rocket-powered aircraft. combustion chamber The aircraft carried these two liquids hydrazine, $ \mathrm{N_{2} H_{4}} $ hydrogen peroxide, $ \mathrm{H_{2}O_{2}} $ When these two liquids mix in the combustion chamber, they evaporate and then react rapidly to form nitrogen gas, $ \mathrm{N}_{2} $ , and steam, $ \mathrm{H}_{2}\mathrm{O} $ The reaction is exothermic. The equation for the reaction is The displayed formulae for the reactants and products are', 1, 3, 90, NULL, 'SUGGESTED', '16e341a9-4824-549a-be76-abca668eb91f', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:40.802296+00');
INSERT INTO public.question_versions VALUES ('2e27eb5e-027c-4ced-bfee-d57dab427980', 'be255feb-af4d-494d-8e9b-dc270330f339', 1, 'Some cars in Brazil use ethanol, $ \mathrm{C_{2} H_{5} O H} $ , as a fuel instead of petrol. The ethanol is made by the fermentation of glucose which is obtained from sugar cane. The sugar is extracted from the sugar cane and then dissolved in water to make a sugar solution.', 1, 3, 90, NULL, 'SUGGESTED', '16e341a9-4824-549a-be76-abca668eb91f', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:40.802632+00');
INSERT INTO public.question_versions VALUES ('7c5fcd9c-3437-44a7-86a2-3d7e8bb65275', '4c7a454e-1d65-47a4-ac58-e73da334d2b7', 1, 'Dinitrogen tetraoxide, $ \mathrm{N_{2}O_{4}} $ , is a colourless gas. Nitrogen dioxide, $ \mathrm{N O}_{2} $ is a brown gas. The two gases can exist together in dynamic equilibrium according to the equation $\mathrm {N} _ {2} \mathrm {O} _ {4} (\mathrm {g}) \rightleftharpoons 2 \mathrm {N O} _ {2} (\mathrm {g})$', 8, 3, 720, NULL, 'SUGGESTED', '16e341a9-4824-549a-be76-abca668eb91f', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:40.803041+00');
INSERT INTO public.question_versions VALUES ('5feeff37-cb24-4b63-be42-2dbedecff913', '5883b104-c535-4847-9042-99fbef5d6f3c', 1, 'The concentration of NaClO(aq) in a solution of bleach is found by reacting it with hydrochloric acid. The equation for the reaction is $\mathrm {N a C l O} (\mathrm {a q}) + 2 \mathrm {H C l} (\mathrm {a q}) \rightarrow \mathrm {N a C l} (\mathrm {a q}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {I}) + \mathrm {C l} _ {2} (\mathrm {g})$ An excess of dilute hydrochloric acid is added to $ 4. 0 0 \mathrm{c m}^{3} $ of bleach solution. $ 6 0. 0 \mathrm{c m}^{3} $ of chlorine gas is produced.', 7, 3, 630, NULL, 'SUGGESTED', '16e341a9-4824-549a-be76-abca668eb91f', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:40.803309+00');
INSERT INTO public.question_versions VALUES ('ca34553c-8cee-4731-930b-b70573912ce9', 'd4f9dda5-c220-4d10-9af2-c6485a35f476', 1, 'This question is about gases in the atmosphere.', 5, 3, 450, NULL, 'SUGGESTED', '628fade2-c759-5a6a-829f-473f8ca0c149', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:40.968341+00');
INSERT INTO public.question_versions VALUES ('62c05f18-467b-4ec5-bdbe-a3e5370840a9', '1a2542b8-1b28-4336-85c1-e3771e2ea297', 1, 'The diagram represents an atom of boron.', 7, 3, 630, NULL, 'SUGGESTED', '628fade2-c759-5a6a-829f-473f8ca0c149', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:40.968736+00');
