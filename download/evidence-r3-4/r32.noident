INSERT INTO public.questions VALUES ('266c51bf-290c-48f9-b305-d9fd294f7e31', 'q02-2c4bb314', 'STRUCTURED', '(a) The list shows some techniques used to separate mixtures. E simple distillation Complete the table to show the best method of obtaining each substance from the mixture. In each case, choose one of the letters A, B, C, D or E. Each letter may be used once more than once or not at all. A crystallisation B filtration C fractional distillation D paper chromatography', 7, 3, 630, NULL, '196ccd06-a551-424e-bf05-e0b035cddc1e', 'PAST_PAPER', true, 1, '2026-09-13 12:58:26.490144+00', '55a1d582-e61d-4ce4-be95-2890b8abc932');
INSERT INTO public.questions VALUES ('3ecf8293-444a-4371-98aa-32b2c15164c6', 'q03-2c4bb314', 'STRUCTURED', 'A student added some pieces of iron to a boiling tube containing dilute hydrochloric acid. She observed fizzing and the formation of a solution, X.', 8, 3, 720, NULL, '196ccd06-a551-424e-bf05-e0b035cddc1e', 'PAST_PAPER', true, 1, '2026-09-13 12:58:26.490441+00', '55a1d582-e61d-4ce4-be95-2890b8abc932');
