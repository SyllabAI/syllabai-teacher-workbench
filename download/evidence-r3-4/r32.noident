INSERT INTO public.question_parts VALUES ('3c4a0788-d892-4203-ae64-62407af41ed4', 'ea1918f3-eb35-470b-bdf2-dfaad81adbba', 'd', 'The teacher uses this apparatus to heat 100g of water. He records the temperature of the water before and after heating. temperature of water before heating = 21.0 $ ^{\circ} \mathrm{C} $ temperature of water after heating = 70.5 $ ^{\circ} \mathrm{C} $', NULL, 0, 9, '2026-09-13 12:56:09.51429+00');
