Id": "img:a308f2d9deb8ef1e0d0fd7f03b0fcdc3263e4069c40285099dbf832446f0c8a0", "mimeType": "image/jpeg", "elementId": "e000075", "sourceName": "assets/crop_8_1789048899719.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_9_1789048899722.png", "width": 110, "format": "png", "height": 109, "sha256": "b766f3a42ee52f920c410a7832897f4191777da7235afad5e7d2202be7e17576", "assetId": "img:b766f3a42ee52f920c410a7832897f4191777da7235afad5e7d2202be7e17576", "mimeType": "image/jpeg", "elementId": "e000077", "sourceName": "assets/crop_9_1789048899722.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_10_1789048899752.png", "width": 107, "format": "png", "height": 101, "sha256": "df212a3d03369cc1406f14537c17a9f51179878d8dc678e917b12c68776b7a27", "assetId": "img:df212a3d03369cc1406f14537c17a9f51179878d8dc678e917b12c68776b7a27", "mimeType": "image/jpeg", "elementId": "e000079", "sourceName": "assets/crop_10_1789048899752.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_11_1789048899760.png", "width": 108, "format": "png", "height": 102, "sha256": "7f3bfabcd39ef42cd76dfe7fd62ee249f133170191382811c80228040d628a7f", "assetId": "img:7f3bfabcd39ef42cd76dfe7fd62ee249f133170191382811c80228040d628a7f", "mimeType": "image/jpeg", "elementId": "e000081", "sourceName": "assets/crop_11_1789048899760.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_12_1789048899764.png", "width": 109, "format": "png", "height": 107, "sha256": "5f7164c41cb4ef6653dafda3922dd4fc4e058d1a16792150198b4554fe5491e5", "assetId": "img:5f7164c41cb4ef6653dafda3922dd4fc4e058d1a16792150198b4554fe5491e5", "mimeType": "image/jpeg", "elementId": "e000083", "sourceName": "assets/crop_12_1789048899764.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q04-f4948ec0", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "A student uses this apparatus to investigate the temperature changes that take place when certain metals are added to dilute sulfuric acid. This is the student''s method: use the five metals aluminium, copper, iron, magnesium and zinc add the same amount of each metal separately to $ 2 5 \\mathrm{c m}^{3} $ of acid in each case the acid is in excess stir the mixture and record the highest temperature reached", "marks": 7, "parts": [{"qwc": false, "text": "Use the diagrams of the thermometer in the table to record the highest temperature reached in each experiment. Record all temperatures to the nearest 0.5 $ ^{\\circ} \\mathrm{C}. $", "label": "a", "marks": 3, "partId": "q05-f4948ec0-pa", "figures": [], "confidence": 0.8, "answerPrompts": []}, {"qwc": false, "text": "In each experiment the initial temperature of the acid is $ 2 5 \\mathrm{^\\circ C} $ Which metal produces the largest temperature rise?", "label": "b", "marks": null, "partId": "q05-f4948ec0-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain the result obtained with copper.", "label": "b-ii", "marks": null, "partId": "q05-f4948ec0-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The same amount of magnesium is added to $ 5 0 \\mathrm{c m}^{3} $ of dilute sulfuric acid. Explain the effect this would have on the temperature change observed.", "label": "c", "marks": null, "partId": "q05-f4948ec0-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 5, "figures": [{"url": "assets/crop_1_1789048899777.png", "width": 843, "format": "png", "height": 476, "sha256": "6e080c8d740de8074ea19fb486aaf4c7b208e8f8ece4c1f512241ea6d4ba5daa", "assetId": "img:6e080c8d740de8074ea19fb486aaf4c7b208e8f8ece4c1f512241ea6d4ba5daa", "mimeType": "image/jpeg", "elementId": "e000091", "sourceName": "assets/crop_1_1789048899777.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q05-f4948ec0", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000100"]}, {"mcq": false, "qwc": false, "stem": "This question is about hydrogen $ \\left( \\mathrm{H}_{2}\\right) $ and water.", "marks": 15, "parts": [{"qwc": false, "text": "Hydrogen is a gas at room temperature. It exists as simple molecules.", "label": "a", "marks": null, "partId": "q06-f4948ec0-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Draw a dot and cross diagram to show the arrangement of the electrons in a hydrogen molecule.", "label": "a-i", "marks": null, "partId": "q06-f4948ec0-pa-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain why hydrogen has a very low boiling point.", "label": "a-ii", "marks": null, "partId": "q06-f4948ec0-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The symbols for the three isotopes of hydrogen are ${ } ^ { 1 } \\mathrm { H } \\quad { } ^ { 2 } \\mathrm { H } \\quad { } ^ { 3 } \\mathrm { H }$", "label": "b", "marks": null, "partId": "q06-f4948ec0-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State what is meant by the term isotopes.", "label": "b-i", "marks": null, "partId": "q06-f4948ec0-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Complete the table to show the number of protons, neutrons and electrons in each of the three isotopes of hydrogen.", "label": "b-ii", "marks": null, "partId": "q06-f4948ec0-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "When hydrogen burns in oxygen, heat energy is transferred to the surroundings.", "label": "c", "marks": null, "partId": "q06-f4948ec0-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State the name given to a reaction in which heat energy is transferred to the surroundings.", "label": "c-i", "marks": null, "partId": "q06-f4948ec0-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Write a chemical equation to represent the reaction that takes place when hydrogen burns in oxygen.", "label": "c-ii", "marks": null, "partId": "q06-f4948ec0-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Describe a chemical test to show that the product is water.", "label": "c-iii", "marks": null, "partId": "q06-f4948ec0-pc-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Describe a physical test to show that the product is pure water.", "label": "c-iv", "marks": null, "partId": "q06-f4948ec0-pc-iv", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 6, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q06-f4948ec0", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000113"]}, {"mcq": false, "qwc": false, "stem": "This question is about the reactions of calcium and some calcium compounds.", "marks": 7, "parts": [{"qwc": false, "text": "Calcium reacts with cold water. The equation for the reaction is $\\mathrm {C a} (\\mathrm {s}) + 2 \\mathrm {H} _ {2} \\mathrm {O} (\\mathrm {l}) \\rightarrow \\mathrm {C a} (\\mathrm {O H}) _ {2} (\\mathrm {a q}) + \\mathrm {H} _ {2} (\\mathrm {g})$", "label": "a", "marks": null, "partId": "q07-f4948ec0-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State two observations that are made when calcium reacts with water.", "label": "a-i", "marks": null, "partId": "q07-f4948ec0-pa-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain a possible value for the pH of the solution formed.", "label": "a-ii", "marks": null, "partId": "q07-f4948ec0-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The diagram shows some reactions involving calcium compounds. Identify solid X, solution Y and solid Z.", "label": "b", "marks": null, "partId": "q07-f4948ec0-pb", "figures": [{"url": "assets/crop_1_1789048899801.png", "width": 1180, "format": "png", "height": 674, "sha256": "bb46d8d7dcdeaa6cd65dee91165aba36ac1b5079d23c3497b8d4346a02fb1a64", "assetId": "img:bb46d8d7dcdeaa6cd65dee91165aba36ac1b5079d23c3497b8d4346a02fb1a64", "mimeType": "image/jpeg", "elementId": "e000126", "sourceName": "assets/crop_1_1789048899801.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}], "number": 7, "figures": [{"url": "assets/crop_1_1789048899801.png", "width": 1180, "format": "png", "height": 674, "sha256": "bb46d8d7dcdeaa6cd65dee91165aba36ac1b5079d23c3497b8d4346a02fb1a64", "assetId": "img:bb46d8d7dcdeaa6cd65dee91165aba36ac1b5079d23c3497b8d4346a02fb1a64", "mimeType": "image/jpeg", "elementId": "e000126", "sourceName": "assets/crop_1_1789048899801.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q07-f4948ec0", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "The apparatus in the diagram is used to heat a sample of hydrated copper(II) sulfate crystals, $ \\mathrm{C u S O_{4}. 5 H_{2} O} $ The equation for the reaction that takes place is $\\mathrm {C u S O} _ {4}. 5 \\mathrm {H} _ {2} \\mathrm {O} (\\mathrm {s}) \\rightarrow \\mathrm {C u S O} _ {4} (\\mathrm {s}) + 5 \\mathrm {H} _ {2} \\mathrm {O} (\\mathrm {l})$ hydrated copper(ll) sulfate", "marks": 0, "parts": [{"qwc": false, "text": "Draw an arrow on the diagram to show where heat is applied.", "label": "a", "marks": null, "partId": "q08-f4948ec0-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "What is the purpose of the ice?", "label": "b", "marks": null, "partId": "q08-f4948ec0-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the maximum mass of water that could be collected when a sample of hydrated copper(II) sulfate of mass 2.50 g is heated. $ [ M_{r} $ of $ \\mathrm{C u S O_{4}. 5 H_{2} O} $ is 250]", "label": "c", "marks": null, "partId": "q08-f4948ec0-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 8, "figures": [{"url": "assets/crop_1_1789048899826.png", "width": 857, "format": "png", "height": 394, "sha256": "5095747a1e05e1a4ae3948c17f48f1e6143f4d3107f844f0d998ed115b4f16ae", "assetId": "img:5095747a1e05e1a4ae3948c17f48f1e6143f4d3107f844f0d998ed115b4f16ae", "mimeType": "image/jpeg", "elementId": "e000132", "sourceName": "assets/crop_1_1789048899826.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.45, "marksKnown": false, "questionId": "q08-f4948ec0", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "A student investigates the reaction of aqueous sodium hydroxide with two different aqueous solutions of hydrochloric acid, solution X and solution Y. She carries out two experiments. Experiment 1 Using a measuring cylinder, she pours 20 $ cm^{3} $ of aqueous sodium hydroxide into a conical flask and records its temperature. Using a burette, she adds 5 $ cm^{3} $ of solution X to the conical flask. She stirs the mixture with the thermometer and records the temperature. She adds further 5 $ cm^{3} $ volumes of solution X and stirs with the thermometer. She records the temperature after each addition of solution X. She stops when a total of $ 4 0 \\mathrm{c m}^{3} $ of solution X has been added. She empties the burette and rinses it first with water and then with solution Y. She then fills the burette with solution Y. She repeats the experiment using solution Y. The table shows the results she obtains in Experiment 1.", "marks": 9, "parts": [{"qwc": false, "text": "Plot the results for Experiment 1 on the grid. Draw a straight line of best fit through the first three points and a second straight line of best fit through the last six points. Make sure that the two straight lines cross. Volume of solution X added in $ cm^{3} $", "label": "a", "marks": null, "partId": "q09-f4948ec0-pa", "figures": [{"url": "assets/crop_1_1789048899845.png", "width": 1473, "format": "png", "height": 1288, "sha256": "061adae77795ad2dab23022bce258ec7a4197a942bc5f2e27e10e5b4c2685954", "assetId": "img:061adae77795ad2dab23022bce258ec7a4197a942bc5f2e27e10e5b4c2685954", "mimeType": "image/jpeg", "elementId": "e000152", "sourceName": "assets/crop_1_1789048899845.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Use the graph to determine the volume of solution X that will produce the maximum temperature rise when added to $ 2 0 \\mathrm{c m}^{3} $ of the aqueous sodium hydroxide. volume of solution X = ... $ \\mathrm{c m}^{3} $", "label": "b", "marks": null, "partId": "q09-f4948ec0-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Use the graph to determine the maximum temperature rise. maximum temperature rise = $ \\mathrm{^{\\circ} C} $", "label": "b-ii", "marks": null, "partId": "q09-f4948ec0-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Why did the student rinse the burette first with water, and then with solution Y, before performing Experiment 2? solution Y", "label": "c", "marks": null, "partId": "q09-f4948ec0-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The maximum temperature rise in Experiment 2 was less than that in Experiment 1. Suggest a reason why.", "label": "d", "marks": null, "partId": "q09-f4948ec0-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 9, "figures": [{"url": "assets/crop_1_1789048899845.png", "width": 1473, "format": "png", "height": 1288, "sha256": "061adae77795ad2dab23022bce258ec7a4197a942bc5f2e27e10e5b4c2685954", "assetId": "img:061adae77795ad2dab23022bce258ec7a4197a942bc5f2e27e10e5b4c2685954", "mimeType": "image/jpeg", "elementId": "e000152", "sourceName": "assets/crop_1_1789048899845.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q09-f4948ec0", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000149"]}, {"mcq": false, "qwc": false, "stem": "This question is about hydrochloric acid.", "marks": 0, "parts": [{"qwc": false, "text": "Dilute hydrochloric acid, HCl(aq), reacts with many metals. A student observes the reaction of dilute hydrochloric acid with four metals, P, Q, R and S. She uses the same amount of metal in each case. The table shows her observations.", "label": "a", "marks": null, "partId": "q10-f4948ec0-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Use the information in the table to place the four metals in order of reactivity. Place the most reactive first. most reactive least reactive", "label": "a-i", "marks": null, "partId": "q10-f4948ec0-pa-i", "figures": [{"url": "assets/crop_1_1789048899865.png", "width": 153, "format": "png", "height": 152, "sha256": "cbc6503729720fe7b27f00db3dc31fb4e4c11cd2d2b1a04456ce268684dab1aa", "assetId": "img:cbc6503729720fe7b27f00db3dc31fb4e4c11cd2d2b1a04456ce268684dab1aa", "mimeType": "image/jpeg", "elementId": "e000170", "sourceName": "assets/crop_1_1789048899865.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789048899869.png", "width": 154, "format": "png", "height": 156, "sha256": "99957fd98b8408dd397566b8a41efcf06d69416c1403b948e8a045d299ae9feb", "assetId": "img:99957fd98b8408dd397566b8a41efcf06d69416c1403b948e8a045d299ae9feb", "mimeType": "image/jpeg", "elementId": "e000171", "sourceName": "assets/crop_2_1789048899869.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_3_1789048899876.png", "width": 157, "format": "png", "height": 156, "sha256": "1fdf94142dda7af131014136942eac4d47f1484ae22587fadf3e2f77d453fb43", "assetId": "img:1fdf94142dda7af131014136942eac4d47f1484ae22587fadf3e2f77d453fb43", "mimeType": "image/jpeg", "elementId": "e000173", "sourceName": "assets/crop_3_1789048899876.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_4_1789048899880.png", "width": 156, "format": "png", "height": 153, "sha256": "3d7c3e69455323d7ae428d575f6f8c5c1fbd77c54ec283ae0618737d5eaa703b", "assetId": "img:3d7c3e69455323d7ae428d575f6f8c5c1fbd77c54ec283ae0618737d5eaa703b", "mimeType": "image/jpeg", "elementId": "e000174", "sourceName": "assets/crop_4_1789048899880.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give the names of the two products formed when magnesium reacts with dilute hydrochloric acid. Product 1 ... Product 2 ...", "label": "a-ii", "marks": null, "partId": "q10-f4948ec0-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Describe a test to show that dilute hydrochloric acid contains chloride ions.", "label": "b", "marks": null, "partId": "q10-f4948ec0-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 10, "figures": [{"url": "assets/crop_1_1789048899865.png", "width": 153, "format": "png", "height": 152, "sha256": "cbc6503729720fe7b27f00db3dc31fb4e4c11cd2d2b1a04456ce268684dab1aa", "assetId": "img:cbc6503729720fe7b27f00db3dc31fb4e4c11cd2d2b1a04456ce268684dab1aa", "mimeType": "image/jpeg", "elementId": "e000170", "sourceName": "assets/crop_1_1789048899865.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789048899869.png", "width": 154, "format": "png", "height": 156, "sha256": "99957fd98b8408dd397566b8a41efcf06d69416c1403b948e8a045d299ae9feb", "assetId": "img:99957fd98b8408dd397566b8a41efcf06d69416c1403b948e8a045d299ae9feb", "mimeType": "image/jpeg", "elementId": "e000171", "sourceName": "assets/crop_2_1789048899869.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_3_1789048899876.png", "width": 157, "format": "png", "height": 156, "sha256": "1fdf94142dda7af131014136942eac4d47f1484ae22587fadf3e2f77d453fb43", "assetId": "img:1fdf94142dda7af131014136942eac4d47f1484ae22587fadf3e2f77d453fb43", "mimeType": "image/jpeg", "elementId": "e000173", "sourceName": "assets/crop_3_1789048899876.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_4_1789048899880.png", "width": 156, "format": "png", "height": 153, "sha256": "3d7c3e69455323d7ae428d575f6f8c5c1fbd77c54ec283ae0618737d5eaa703b", "assetId": "img:3d7c3e69455323d7ae428d575f6f8c5c1fbd77c54ec283ae0618737d5eaa703b", "mimeType": "image/jpeg", "elementId": "e000174", "sourceName": "assets/crop_4_1789048899880.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.45, "marksKnown": false, "questionId": "q10-f4948ec0", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000166"]}, {"mcq": false, "qwc": false, "stem": "The table shows the displayed formulae of four hydrocarbons, W, X, Y and Z.", "marks": 9, "parts": [{"qwc": false, "text": "Give the name of hydrocarbon W.", "label": "a", "marks": null, "partId": "q11-f4948ec0-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give the molecular formula for hydrocarbon X.", "label": "b", "marks": null, "partId": "q11-f4948ec0-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Which of the hydrocarbons belong to the same homologous series of compounds?", "label": "c", "marks": null, "partId": "q11-f4948ec0-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give the empirical formula of hydrocarbon Z.", "label": "d", "marks": null, "partId": "q11-f4948ec0-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Z is an unsaturated hydrocarbon. Explain what is meant by the term unsaturated hydrocarbon. unsaturated hydrocarbon", "label": "e", "marks": null, "partId": "q11-f4948ec0-pe", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The substitution reaction between W and bromine is similar to the reaction between methane and bromine. Suggest the displayed formula for a possible product of the reaction between W and bromine.", "label": "f", "marks": null, "partId": "q11-f4948ec0-pf", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State the condition required for this reaction to take place.", "label": "f-ii", "marks": null, "partId": "q11-f4948ec0-pf-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 11, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q11-f4948ec0", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000180"]}, {"mcq": false, "qwc": false, "stem": "Titanium is a metal that can be extracted from its ore in a three-stage process. stage 1 titanium ore is converted into titanium dioxide, $ \\mathrm{T i O}_{2} $ stage 2 titanium dioxide is then converted into titanium chloride, $ \\mathrm{T i C l}_{4} $ stage 3 titanium chloride is converted into titanium, Ti", "marks": 12, "parts": [{"qwc": false, "text": "A titanium ore contains the composition by mass $\\mathrm {F e} = 3 6. 8 \\% \\quad \\mathrm {T i} = 3 1. 6 \\% \\quad \\mathrm {O} = 3 1. 6 \\%$ Show by calculation that the empirical formula of this ore is $ \\mathrm{F e T i O}_{3} $", "label": "a", "marks": null, "partId": "q12-f4948ec0-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The equation for the conversion of titanium dioxide into titanium chloride is $\\mathrm {T i O} _ {2} + 2 \\mathrm {C l} _ {2} + \\mathrm {C} \\rightarrow \\mathrm {T i C l} _ {4} + \\mathrm {C O} _ {2}$ Explain which element has been oxidised in this reaction. titanium chloride vapour is passed through molten magnesium in an atmosphere of argon the products are allowed to cool to form a solid mixture of titanium and magnesium chloride this mixture is crushed into a powder and then added to water to dissolve the magnesium chloride", "label": "b", "marks": null, "partId": "q12-f4948ec0-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Write a chemical equation for the reaction between titanium chloride and magnesium.", "label": "b-i", "marks": null, "partId": "q12-f4948ec0-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Suggest why this reaction cannot be successfully carried out in an atmosphere of air.", "label": "b-ii", "marks": null, "partId": "q12-f4948ec0-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Suggest why the mixture is crushed into a powder before it is added to water.", "label": "b-iii", "marks": null, "partId": "q12-f4948ec0-pb-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Describe the bonding in titanium metal.", "label": "d", "marks": null, "partId": "q12-f4948ec0-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain why titanium conducts electricity.", "label": "d-ii", "marks": null, "partId": "q12-f4948ec0-pd-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 12, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q12-f4948ec0", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "iodine reacts with chlorine to form iodine monochloride, ICI", "marks": 5, "parts": [{"qwc": false, "text": "Write a chemical equation for this reaction.", "label": "a", "marks": null, "partId": "q13-f4948ec0-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "iodine monochloride reacts reversibly with chlorine to form iodine trichloride. $\\begin{array}{c c c} \\mathrm {I C I} & + & \\mathrm {C l} _ {2} \\rightleftharpoons \\mathrm {I C I} _ {3} \\\\ \\mathrm {d a r k} & & \\mathrm {y e l l o w} \\\\ \\mathrm {b r o w n} & & \\end{array}$ The reaction mixture is allowed to reach a state of dynamic equilibrium.", "label": "b", "marks": null, "partId": "q13-f4948ec0-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "One feature of a reaction that is in dynamic equilibrium is that both the forward reaction and the backward reaction occur simultaneously. Give two other features of a reaction that is in dynamic equilibrium.", "label": "b-i", "marks": null, "partId": "q13-f4948ec0-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "When the equilibrium mixture is heated, it becomes darker brown in colour Explain whether the backward reaction is exothermic or endothermic.", "label": "b-ii", "marks": null, "partId": "q13-f4948ec0-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 13, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q13-f4948ec0", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "Potassium hydrogencarbonate （ $ \\mathrm{KHCO}_{3} $ ）decomposes on heating. Three possible equations for the decomposition are $\\mathrm {e q u a t i o n 1} \\quad 2 \\mathrm {K H C O} _ {3} (\\mathrm {s}) \\rightarrow \\mathrm {K} _ {2} \\mathrm {O} (\\mathrm {s}) + 2 \\mathrm {C O} _ {2} (\\mathrm {g}) + \\mathrm {H} _ {2} \\mathrm {O} (\\mathrm {g})$ equation 2 $ \\mathrm{K H C O}_{3} ( \\mathrm{s} ) \\rightarrow \\mathrm{K O H} ( \\mathrm{s} )+\\mathrm{C O}_{2} ( \\mathrm{g} ) $ $\\mathrm {e q u a t i o n 3} \\quad 2 \\mathrm {K H C O} _ {3} (\\mathrm {s}) \\rightarrow \\mathrm {K} _ {2} \\mathrm {C O} _ {3} (\\mathrm {s}) + \\mathrm {C O} _ {2} (\\mathrm {g}) + \\mathrm {H} _ {2} \\mathrm {O} (\\mathrm {g})$ When 8.00 g of potassium hydrogencarbonate is heated until it is fully decomposed, 5.52 g of solid is formed.", "marks": 4, "parts": [{"qwc": false, "text": "Complete the table by calculating the amount, in moles, of each solid.", "label": "a", "marks": null, "partId": "q14-f4948ec0-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Use the information in the table to explain which equation, 1, 2 or 3, represents the decomposition of potassium hydrogencarbonate.", "label": "b", "marks": null, "partId": "q14-f4948ec0-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 14, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q14-f4948ec0", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000229"]}, {"mcq": false, "qwc": false, "stem": "Butane $ \\left( \\mathrm{C}_{4} \\mathrm{H}_{1 0} \\right) $ is a gas at room temperature and pressure. The equation for the complete combustion of butane is $C _ {4} H _ {1 0} (g) + 6 \\frac {1}{2} O _ {2} (g) \\rightarrow 4 C O _ {2} (g) + 5 H _ {2} O (l)$ Butane is used in an experiment to determine its $ \\Delta H $ of combustion.", "marks": 8, "parts": [{"qwc": false, "text": "State what the symbol $ \\Delta H $ represents.", "label": "a", "marks": null, "partId": "q15-f4948ec0-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The table shows the results of the experiment. Use this equation to calculate the heat produced when 0.725 g of butane is burned in this experiment. heat produced = mass of water $ \\times $ 4.2 $ \\times $ temperature rise of water (in J) (in g) (in $ ^{\\circ} C $)", "label": "b", "marks": null, "partId": "q15-f4948ec0-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "A student uses the value from part (b) to calculate $ \\Delta H $ for the combustion of butane. He calculates it as $ -1580 \\mathrm{kJ} / \\mathrm{mol} $ . He has not made a mistake in his calculation. A data book value is $ -2887 \\mathrm{kJ} / \\mathrm{mol} $ (i) What is the significance of the negative sign for $ \\Delta H? $ (1)", "label": "c", "marks": null, "partId": "q15-f4948ec0-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The student notices that at the end of the experiment the bottom of the beaker is covered in black soot (carbon) Suggest how this soot is formed.", "label": "c-ii", "marks": null, "partId": "q15-f4948ec0-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain how the formation of the soot may account for the difference between the value of $ \\Delta H $ from the experiment and the value of $ \\Delta H $ in the data book.", "label": "c-iii", "marks": null, "partId": "q15-f4948ec0-pc-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Suggest one other reason why the two $ \\Delta H $ values are different.", "label": "c-iv", "marks": null, "partId": "q15-f4948ec0-pc-iv", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 15, "figures": [{"url": "assets/crop_1_1789048899959.png", "width": 882, "format": "png", "height": 620, "sha256": "6276d03e1aeabe8140a95026964e18a44f07c3206f3c614cec81fe70ee6203fa", "assetId": "img:6276d03e1aeabe8140a95026964e18a44f07c3206f3c614cec81fe70ee6203fa", "mimeType": "image/jpeg", "elementId": "e000236", "sourceName": "assets/crop_1_1789048899959.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q15-f4948ec0", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000239"]}, {"mcq": false, "qwc": false, "stem": "The diagram shows the apparatus used to investigate the rate of reaction between calcium carbonate and an excess of dilute hydrochloric acid. The mass of the flask and contents is measured at regular time intervals. The graph shows the results obtained.", "marks": 7, "parts": [{"qwc": false, "text": "What is the purpose of the cotton wool in the neck of the flask?", "label": "a", "marks": 1, "partId": "q16-f4948ec0-pa", "figures": [], "confidence": 0.8, "answerPrompts": []}, {"qwc": false, "text": "Explain why the mass of the flask and contents decreases with time.", "label": "b", "marks": null, "partId": "q16-f4948ec0-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The experiment is repeated using the same mass of identical calcium carbonate lumps the same volume of hydrochloric acid but of a higher concentration Sketch on the graph the curve that would be produced.", "label": "c", "marks": null, "partId": "q16-f4948ec0-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain, using the particle collision theory, how the rate of reaction changes with an increase in concentration of hydrochloric acid. Every effort has been made to contact copyright holders to obtain their permission for the use of copyright material. Pearson Education Ltd. will, if notified, be happy to rectify any errors or omissions and include any such rectifications in future editions.", "label": "c-ii", "marks": null, "partId": "q16-f4948ec0-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 16, "figures": [{"url": "assets/crop_1_1789048899981.png", "width": 1234, "format": "png", "height": 525, "sha256": "0d85dee1b4ba8a4ca53cb97afe8970d7a9d64b8def742de220d37017109591e4", "assetId": "img:0d85dee1b4ba8a4ca53cb97afe8970d7a9d64b8def742de220d37017109591e4", "mimeType": "image/jpeg", "elementId": "e000248", "sourceName": "assets/crop_1_1789048899981.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789048899989.png", "width": 972, "format": "png", "height": 583, "sha256": "67bafd61631a14b7c4c1db1d278b7f0af880c831c763dd628b6df267cebdac8c", "assetId": "img:67bafd61631a14b7c4c1db1d278b7f0af880c831c763dd628b6df267cebdac8c", "mimeType": "image/jpeg", "elementId": "e000251", "sourceName": "assets/crop_2_1789048899989.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q16-f4948ec0", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}], "paperTotal": 120, "schemaVersion": "1.0", "sectionTotals": {}, "questionTotals": {"1": 4, "4": 9, "5": 7, "6": 15, "7": 7, "9": 9, "11": 9, "12": 12, "13": 5, "14": 4, "15": 8, "16": 7}, "reviewRequired": true, "extractionMethod": "glm-ocr-qp-v1", "frontMatterFigures": []}', '{"paper": {"board": "Edexcel", "session": "Summer 2016", "subject": null, "duration": null, "examDate": null, "logNumber": null, "qualification": null, "paperReference": null, "publicationCode": "4CH0_1C_1606_MS", "canonicalDocumentId": "d5191851-8500-5fd7-a4dc-e13a0833cf4a"}, "entries": [{"mcq": false, "qwc": false, "label": "1(a)", "marks": 1, "number": 1, "entryId": "ms-d5191851-q1a", "guidance": [{"kind": "note", "text": "(b)"}, {"kind": "note", "text": "M1(the particles/they) lose(kinetic)energy/have less energy"}, {"kind": "note", "text": "ACCEPT lose potential/heat energy"}, {"kind": "note", "text": "ACCEPT not as many gaps/smaller gaps REJECT refs to density"}, {"kind": "note", "text": "ACCEPT molecules for particles"}, {"kind": "note", "text": "REJECT atoms once only."}], "answerText": "B(condensation)\nM2(the particles/they) move closer together/pack more closely\nM3(the particles/they) do not move as freely/move more slowly/move less randomly\nNB M1,M2andM3can be scored anywhere across the whole answer", "confidence": 0.75, "markP