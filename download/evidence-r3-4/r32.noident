INSERT INTO public.question_versions VALUES ('4a49d380-e660-4f9b-816c-5faa93fb4c4b', '1d915410-548f-483b-ad95-a33bac46aa3e', 1, 'Water is needed for iron to rust.', 11, 3, 990, NULL, 'SUGGESTED', '06a1d491-4b40-5421-8a8c-e37da09a1a47', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:24.997633+00');
INSERT INTO public.question_versions VALUES ('e1f82ad3-8e22-4cd0-80ad-25861d8bb3f5', '36a6b5aa-9494-4c04-808e-ef25aab0d926', 1, 'The table shows the displayed formulae of three unsaturated hydrocarbons.', 14, 3, 1260, NULL, 'SUGGESTED', '06a1d491-4b40-5421-8a8c-e37da09a1a47', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:24.998037+00');
INSERT INTO public.question_versions VALUES ('94580d20-92c8-4d80-9798-2d020b9d1c48', '7d4863b8-cf93-4e9a-893e-e9cd2e144652', 1, 'The reactivity of metals can be studied using displacement reactions. In these reactions, one metal is added to a solution of a salt of a different metal. If a displacement reaction occurs, there is a temperature rise. Pour some metal salt solution into a polystyrene cup supported in a glass beaker and record the temperature of the solution. Add a known mass of a metal and stir. Record the maximum temperature of the mixture. A student used the following method in a series of experiments.', 13, 3, 1170, NULL, 'SUGGESTED', '06a1d491-4b40-5421-8a8c-e37da09a1a47', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:24.99843+00');
INSERT INTO public.question_versions VALUES ('24704be8-cc27-45d9-baa4-e87bad7aae59', 'faea6fb3-f8d1-4201-ad10-30cf990fdba7', 1, 'Most metals are extracted in a blast furnace or by electrolysis.', 17, 3, 1530, NULL, 'SUGGESTED', '06a1d491-4b40-5421-8a8c-e37da09a1a47', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:24.998843+00');
INSERT INTO public.question_versions VALUES ('4825daf2-714e-4acd-8c5e-3b2737943196', '12287e18-957c-4c1c-9894-506c6dc8b545', 1, 'The equation for a reaction that occurs in the manufacture of nitric acid is $4 \mathrm {N H} _ {3} (\mathrm {g}) + 5 \mathrm {O} _ {2} (\mathrm {g}) \rightleftharpoons 4 \mathrm {N O} (\mathrm {g}) + 6 \mathrm {H} _ {2} \mathrm {O} (\mathrm {g}) \quad \Delta H = - 9 0 0 \mathrm {k J / m o l}$', 15, 3, 1350, NULL, 'SUGGESTED', '06a1d491-4b40-5421-8a8c-e37da09a1a47', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:24.999179+00');
INSERT INTO public.question_versions VALUES ('ac4a33cc-e5d8-4526-8261-42ced5928673', '5741ab37-f04c-4dc9-99a5-c662f6c9f841', 1, 'This question is about bromine and some of its compounds.', 16, 3, 1440, NULL, 'SUGGESTED', '06a1d491-4b40-5421-8a8c-e37da09a1a47', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:24.99952+00');
INSERT INTO public.question_versions VALUES ('d17b9563-5647-41df-a5e8-142d21fefdc7', '0abbcc62-e698-4a2c-8bd3-d89f691026d7', 1, 'A teacher discussed with her students whether the boiling points of organic compounds are related to the size of their molecules. The students suggested measuring the boiling points of some organic compounds using this apparatus.', 7, 3, 630, NULL, 'SUGGESTED', '06a1d491-4b40-5421-8a8c-e37da09a1a47', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:24.999871+00');
INSERT INTO public.question_versions VALUES ('1e40b279-ec96-4379-b665-a90722d23bd4', '8449dbbb-f451-4086-8897-e1d3df88d2ba', 1, 'Boron is an element in Group 3 of the Periodic Table. An atom of boron can be represented as $ ^{1 1} _ {5} \mathrm{B} $', 1, 3, 90, NULL, 'SUGGESTED', 'a11a8fbb-b3e3-57ef-bc08-bb0138309d31', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.358151+00');
INSERT INTO public.question_versions VALUES ('77ac2bf5-ca00-4ee1-8354-c0b2dca57e41', '9f9ac4de-7361-4699-ba99-8f73fa2c7784', 1, 'A student used this apparatus to make and collect a sample of hydrogen gas.', 1, 3, 90, NULL, 'SUGGESTED', 'a11a8fbb-b3e3-57ef-bc08-bb0138309d31', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.358533+00');
INSERT INTO public.question_versions VALUES ('308f61c2-c0c2-41f6-a0a8-f886dbc7432d', '66fcbd37-6790-402b-9c18-262058a9009e', 1, 'The halogens are elements in Group 7 of the Periodic Table. The halogens react with metals to form compounds called halides. Table 1 shows information about some halogens and their halides. Table 1', 1, 3, 90, NULL, 'SUGGESTED', 'a11a8fbb-b3e3-57ef-bc08-bb0138309d31', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.359482+00');
INSERT INTO public.question_versions VALUES ('0aa5739a-3ed6-41c0-8d92-fc87ba8e8efa', '652f9d90-12f9-4672-aacb-e87d4cc4f4cf', 1, 'Ethene can be converted into many useful substances.', 6, 3, 540, NULL, 'SUGGESTED', 'a11a8fbb-b3e3-57ef-bc08-bb0138309d31', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.359891+00');
INSERT INTO public.question_versions VALUES ('16f710f8-353d-4d36-b6d8-bb1b747e01f0', 'da1d5215-bedb-443a-93a3-d49f9441c7e1', 1, 'A student was asked to compare the industrial processes used to extract aluminium and iron from their ores.', 17, 3, 1530, NULL, 'SUGGESTED', 'a11a8fbb-b3e3-57ef-bc08-bb0138309d31', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.360295+00');
