INSERT INTO public.question_parts VALUES ('e72e3e87-15ad-45ba-b756-97a4396f51c2', '8bbbc85d-711d-4eed-97ef-5a23f70b7229', 'c', 'Hydrazine was used as the fuel in the first rocket-powered fighter aircraft in World War II. It is now used as a propellant in spacecraft. It slowed the descent of the Phoenix spacecraft as it landed on Mars. The equations for its use as a rocket fuel and as a propellant are shown in the table.', NULL, 0, 3, '2026-09-13 12:53:10.991866+00');
