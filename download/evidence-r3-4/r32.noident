INSERT INTO public.question_parts VALUES ('276f7e53-27e0-47f1-8991-0605d9ff1330', '16eabe32-a79f-4fd1-afd4-518bf435a1b8', 'c', 'Molten iron and another molten substance collect at the bottom of the blast furnace. What is the common name of this other molten substance?', NULL, 0, 8, '2026-09-13 12:57:42.153759+00');
