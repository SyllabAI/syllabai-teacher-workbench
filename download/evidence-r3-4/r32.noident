ber": null}, {"detail": "4(a): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "4(a): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "4(a): bare integer cell \"5\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "5(a): bare integer cell \"2\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: (c)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M2(good conductivity of LiF) ions are mobile", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M3(low melting point of CF4) weak forces(of attraction) between molecules/weak intermolecular forces(of attraction)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M4(poor conductivity of CF4) molecules are not charged/molecules are neutral/no charged particles", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: Total", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "6(a)(i): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "6(a)(i): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: (b)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "6(c)(i): bare integer cell \"2\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "6(c)(i): bare integer cell \"2\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "6(c)(i): bare integer cell \"13\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "7(a)(i): bare integer cell \"2\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "7(a)(i): bare integer cell \"2\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "7(a)(i): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "7(a)(i): bare integer cell \"7\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "8(b)(i): bare integer cell \"3\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "8(c): bare integer cell \"8\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}]', '{"paper": {"board": "Edexcel", "session": "January 2017", "subject": null, "duration": null, "examDate": "Wednesday 18 January 2017 – Afternoon", "logNumber": null, "qualification": null, "paperReference": "4CH0/2C", "publicationCode": null, "canonicalDocumentId": "24df1df1-76c7-51e1-88c7-1ff3dd24bf7e"}, "warnings": ["Q8: incomplete MCQ option set folded into stem"], "questions": [{"mcq": false, "qwc": false, "stem": "The box contains the names of some substances. Choose a substance from the box that best matches each description. Each substance may be used once, more than once or not at all.", "marks": 5, "parts": [{"qwc": false, "text": "Which substance is a mixture?", "label": "a", "marks": null, "partId": "q01-24df1df1-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Which substance is a gas that makes a squeaky pop when ignited?", "label": "b", "marks": null, "partId": "q01-24df1df1-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Which substance is an element that is a green gas at room temperature?", "label": "c", "marks": null, "partId": "q01-24df1df1-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Which substance is used to sterilise water?", "label": "d", "marks": null, "partId": "q01-24df1df1-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Which substance is a metal that can be made by heating its oxide with carbon?", "label": "e", "marks": null, "partId": "q01-24df1df1-pe", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 1, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q01-24df1df1", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000022"]}, {"mcq": false, "qwc": false, "stem": "Oxides can be made by burning elements in air. The table gives some information about the oxides of four elements.", "marks": 6, "parts": [{"qwc": false, "text": "Calcium and magnesium are metals. Carbon and sulfur are non-metals.", "label": "a", "marks": null, "partId": "q02-24df1df1-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Using only information from the table, state two ways in which the oxides of the metals are similar to each other.", "label": "a-i", "marks": null, "partId": "q02-24df1df1-pa-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Using only information from the table, state two ways in which the oxides of the non-metals are similar to each other.", "label": "a-ii", "marks": null, "partId": "q02-24df1df1-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "A teacher tells his students that when phosphorus burns in air a white solid oxide forms. This oxide is very soluble in water and forms an acidic solution.", "label": "b", "marks": null, "partId": "q02-24df1df1-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "One student states that phosphorus is a metal. Use information from the table to suggest why the student made this statement.", "label": "b-i", "marks": null, "partId": "q02-24df1df1-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Another student states that phosphorus is a non-metal. Use information from the table to suggest why the student made this statement.", "label": "b-ii", "marks": null, "partId": "q02-24df1df1-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "An experiment using this apparatus shows that phosphorus is a non-metal. Explain how this experiment shows that phosphorus is a non-metal.", "label": "c", "marks": null, "partId": "q02-24df1df1-pc", "figures": [{"url": "assets/crop_1_1789064028068.png", "width": 1043, "format": "png", "height": 664, "sha256": "ea85d149b056ad46a77ee9b91bcd9d3b01be79e04bb686ff6abb6fc0a1779af7", "assetId": "img:ea85d149b056ad46a77ee9b91bcd9d3b01be79e04bb686ff6abb6fc0a1779af7", "mimeType": "image/jpeg", "elementId": "e000041", "sourceName": "assets/crop_1_1789064028068.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}], "number": 2, "figures": [{"url": "assets/crop_1_1789064028068.png", "width": 1043, "format": "png", "height": 664, "sha256": "ea85d149b056ad46a77ee9b91bcd9d3b01be79e04bb686ff6abb6fc0a1779af7", "assetId": "img:ea85d149b056ad46a77ee9b91bcd9d3b01be79e04bb686ff6abb6fc0a1779af7", "mimeType": "image/jpeg", "elementId": "e000041", "sourceName": "assets/crop_1_1789064028068.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q02-24df1df1", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000032"]}, {"mcq": false, "qwc": false, "stem": "This question is about the reactivity of metals.", "marks": 8, "parts": [{"qwc": false, "text": "This apparatus can be used to compare the reactivities of different metals. A metal is heated with the oxide of a different metal. The table shows the results of two experiments. Explain how these results show the order of reactivity of calcium, tin and titanium.", "label": "a", "marks": null, "partId": "q03-24df1df1-pa", "figures": [{"url": "assets/crop_1_1789064028087.png", "width": 658, "format": "png", "height": 298, "sha256": "f23d76f3f02f63709587e3d36d8d1d23ce5fbe607c221986ccc86bbeae5a5f70", "assetId": "img:f23d76f3f02f63709587e3d36d8d1d23ce5fbe607c221986ccc86bbeae5a5f70", "mimeType": "image/jpeg", "elementId": "e000046", "sourceName": "assets/crop_1_1789064028087.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The diagram shows a method of making iron.", "label": "b", "marks": null, "partId": "q03-24df1df1-pb", "figures": [{"url": "assets/crop_1_1789064028097.png", "width": 831, "format": "png", "height": 357, "sha256": "280d086ea16a74405b0c5cd557f885323de6a28a600632e49839209737e331f3", "assetId": "img:280d086ea16a74405b0c5cd557f885323de6a28a600632e49839209737e331f3", "mimeType": "image/jpeg", "elementId": "e000052", "sourceName": "assets/crop_1_1789064028097.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The word equation for the reaction that occurs is aluminium + iron(III) oxide $ \\rightarrow $ aluminium oxide+ iron Write a chemical equation for this reaction.", "label": "b-i", "marks": null, "partId": "q03-24df1df1-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain which substance is oxidised in this reaction.", "label": "b-ii", "marks": null, "partId": "q03-24df1df1-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain why aluminium and iron(III) oxide are used in powdered form rather than large pieces.", "label": "b-iii", "marks": null, "partId": "q03-24df1df1-pb-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 3, "figures": [{"url": "assets/crop_1_1789064028087.png", "width": 658, "format": "png", "height": 298, "sha256": "f23d76f3f02f63709587e3d36d8d1d23ce5fbe607c221986ccc86bbeae5a5f70", "assetId": "img:f23d76f3f02f63709587e3d36d8d1d23ce5fbe607c221986ccc86bbeae5a5f70", "mimeType": "image/jpeg", "elementId": "e000046", "sourceName": "assets/crop_1_1789064028087.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_1_1789064028097.png", "width": 831, "format": "png", "height": 357, "sha256": "280d086ea16a74405b0c5cd557f885323de6a28a600632e49839209737e331f3", "assetId": "img:280d086ea16a74405b0c5cd557f885323de6a28a600632e49839209737e331f3", "mimeType": "image/jpeg", "elementId": "e000052", "sourceName": "assets/crop_1_1789064028097.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q03-24df1df1", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000049"]}, {"mcq": false, "qwc": false, "stem": "Chemical tests can be used to detect ions in solids and in aqueous solutions.", "marks": 5, "parts": [{"qwc": false, "text": "A solid produces a gas when heated with sodium hydroxide solution. Damp red litmus paper is turned blue by the gas. Which of these ions is present in the solid? A $ \\mathrm{C u}^{2+} $ B $ \\mathrm{F e}^{2+} $ C $ \\mathrm{F e}^{3+} $ $ \\times $ D $ \\mathrm{N H_{4}^{+}} $", "label": "a", "marks": null, "partId": "q04-24df1df1-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "When dilute nitric acid is added to an aqueous solution, followed by silver nitrate solution, a yellow precipitate forms. Which of these halide ions is present in the aqueous solution? A $ \\mathrm{B r}^{-} $ B $ \\mathrm{C l}^{-} $ C $ \\mathrm{F}^{-} $ D $ \\mathrm{I}^{-} $", "label": "b", "marks": null, "partId": "q04-24df1df1-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "When dilute hydrochloric acid is added to a solid, a gas forms. Which of these ions is present in the solid? A carbonate B hydroxide C nitrate D sulfate", "label": "c", "marks": null, "partId": "q04-24df1df1-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Sodium hydroxide solution is added separately to three solutions. One solution contains $ \\mathrm{C u}^{2+} $ ions, another contains $ \\mathrm{F e}^{2+} $ ions and the third solution contains $ \\mathrm{F e}^{3+} $ ions. Which row shows the correct colours of the precipitates that form? Which of these ions is present in the aqueous solution?", "label": "d", "marks": null, "partId": "q04-24df1df1-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "When barium chloride solution is added to an aqueous solution of a compound, a white precipitate forms. When dilute hydrochloric acid is added to the mixture, the precipitate disappears and a colourless solution forms. A carbonate B chloride C nitrate D sulfate", "label": "e", "marks": null, "partId": "q04-24df1df1-pe", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 4, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q04-24df1df1", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000080"]}, {"mcq": false, "qwc": false, "stem": "Lithium and carbon both form fluorides.", "marks": 8, "parts": [{"qwc": false, "text": "Lithium reacts with fluorine to produce the ionic compound lithium fluoride. The diagrams show the arrangement of electrons in a lithium atom and in a fluorine atom. lithium atom fluorine atom Draw similar diagrams to show the arrangement of the electrons in the ions formed when lithium reacts with fluorine. Show all the electrons in each ion.", "label": "a", "marks": null, "partId": "q05-24df1df1-pa", "figures": [{"url": "assets/crop_1_1789064028187.png", "width": 296, "format": "png", "height": 304, "sha256": "c17abb67c38365db369cce1bc0cdd425457e1197616aa6d1ffeb7fc8bef34de8", "assetId": "img:c17abb67c38365db369cce1bc0cdd425457e1197616aa6d1ffeb7fc8bef34de8", "mimeType": "image/jpeg", "elementId": "e000091", "sourceName": "assets/crop_1_1789064028187.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789064028194.png", "width": 312, "format": "png", "height": 315, "sha256": "d8e4a5b95d962d39a063931537394296c029a204772e29546212137bfdf4739e", "assetId": "img:d8e4a5b95d962d39a063931537394296c029a204772e29546212137bfdf4739e", "mimeType": "image/jpeg", "elementId": "e000093", "sourceName": "assets/crop_2_1789064028194.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Carbon tetrafluoride is a simple molecular compound. The displayed formula for a molecule of carbon tetrafluoride is Draw a dot and cross diagram to show the arrangement of the electrons in this molecule. Show only the outer electrons.", "label": "b", "marks": null, "partId": "q05-24df1df1-pb", "figures": [{"url": "assets/crop_3_1789064028200.png", "width": 155, "format": "png", "height": 213, "sha256": "f236b93b84154b1cf07fcd31a1a01af6574f64e960f6046936b9ce6dfca38b78", "assetId": "img:f236b93b84154b1cf07fcd31a1a01af6574f64e960f6046936b9ce6dfca38b78", "mimeType": "image/jpeg", "elementId": "e000099", "sourceName": "assets/crop_3_1789064028200.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The table shows some properties of lithium fluoride and carbon tetrafluoride. Explain these properties of each compound. lithium fluoride. carbon tetrafluoride", "label": "c", "marks": null, "partId": "q05-24df1df1-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 5, "figures": [{"url": "assets/crop_1_1789064028187.png", "width": 296, "format": "png", "height": 304, "sha256": "c17abb67c38365db369cce1bc0cdd425457e1197616aa6d1ffeb7fc8bef34de8", "assetId": "img:c17abb67c38365db369cce1bc0cdd425457e1197616aa6d1ffeb7fc8bef34de8", "mimeType": "image/jpeg", "elementId": "e000091", "sourceName": "assets/crop_1_1789064028187.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789064028194.png", "width": 312, "format": "png", "height": 315, "sha256": "d8e4a5b95d962d39a063931537394296c029a204772e29546212137bfdf4739e", "assetId": "img:d8e4a5b95d962d39a063931537394296c029a204772e29546212137bfdf4739e", "mimeType": "image/jpeg", "elementId": "e000093", "sourceName": "assets/crop_2_1789064028194.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_3_1789064028200.png", "width": 155, "format": "png", "height": 213, "sha256": "f236b93b84154b1cf07fcd31a1a01af6574f64e960f6046936b9ce6dfca38b78", "assetId": "img:f236b93b84154b1cf07fcd31a1a01af6574f64e960f6046936b9ce6dfca38b78", "mimeType": "image/jpeg", "elementId": "e000099", "sourceName": "assets/crop_3_1789064028200.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q05-24df1df1", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000102"]}, {"mcq": false, "qwc": false, "stem": "Ethanol can be produced when yeast is added to a glucose solution. This apparatus is used to investigate the reaction.", "marks": 13, "parts": [{"qwc": false, "text": "The equation for the reaction is $\\mathrm {C} _ {6} \\mathrm {H} _ {1 2} \\mathrm {O} _ {6} (\\mathrm {a q}) \\rightarrow 2 \\mathrm {C} _ {2} \\mathrm {H} _ {5} \\mathrm {O H} (\\mathrm {a q}) + 2 \\mathrm {C O} _ {2} (\\mathrm {g})$", "label": "a", "marks": null, "partId": "q06-24df1df1-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State the purpose of the yeast.", "label": "a-i", "marks": null, "partId": "q06-24df1df1-pa-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State how the appearance of the limewater changes during the reaction.", "label": "a-ii", "marks": null, "partId": "q06-24df1df1-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State the temperature at which this reaction is carried out in industry.", "label": "a-iii", "marks": null, "partId": "q06-24df1df1-pa-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Ethanol can be used as a fuel. This is the equation for the complete combustion of ethanol. $\\mathrm {C} _ {2} \\mathrm {H} _ {5} \\mathrm {O H} + 3 \\mathrm {O} _ {2} \\rightarrow 2 \\mathrm {C O} _ {2} + 3 \\mathrm {H} _ {2} \\mathrm {O}$ These are the displayed formulae for ethanol, oxygen, carbon dioxide and water. The table gives some average (mean) bond energies. Use this information to calculate the enthalpy change $ (\\Delta H) $ when one mole of ethanol is completely burned.", "label": "b", "marks": null, "partId": "q06-24df1df1-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Ethanol and methanol can both be used as fuels. A student uses this apparatus to find out how much energy is produced when one mole of ethanol and one mole of methanol are burned. The table shows some of the student''s results.", "label": "c", "marks": null, "partId": "q06-24df1df1-pc", "figures": [{"url": "assets/crop_1_1789064028232.png", "width": 644, "format": "png", "height": 496, "sha256": "563808254023b259da8691ce24f25abb88a8e2cc039873e89d11baab2345430b", "assetId": "img:563808254023b259da8691ce24f25abb88a8e2cc039873e89d11baab2345430b", "mimeType": "image/jpeg", "elementId": "e000125", "sourceName": "assets/crop_1_1789064028232.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789064028236.png", "width": 713, "format": "png", "height": 259, "sha256": "544aa6afdf594f43f188ad5ab1f211e270829dc32c83528ca5b8157b4501627e", "assetId": "img:544aa6afdf594f43f188ad5ab1f211e270829dc32c83528ca5b8157b4501627e", "mimeType": "image/jpeg", "elementId": "e000126", "sourceName": "assets/crop_2_1789064028236.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the energy given out by 1 mol of methanol.", "label": "c-i", "marks": 2, "partId": "q06-24df1df1-pc-i", "figures": [], "confidence": 0.8, "answerPrompts": []}, {"qwc": false, "text": "The student uses the same burner and copper can in each experiment. State two other factors that the student should keep the same in each experiment. (2)", "label": "c-ii", "marks": null, "partId": "q06-24df1df1-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "A data book states that the energy given out when 1 mol of ethanol is burned is 1371 kJ. Suggest two reasons why the student''s value is much less than this.", "label": "c-iii", "marks": null, "partId": "q06-24df1df1-pc-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 6, "figures": [{"url": "assets/crop_1_1789064028213.png", "width": 1151, "format": "png", "height": 502, "sha256": "ad79afc78db7f1eb2ec0a9549e5e527d7bbe24976b98b8879248bab81f91e0fb", "assetId": "img:ad79afc78db7f1eb2ec0a9549e5e527d7bbe24976b98b8879248bab81f91e0fb", "mimeType": "image/jpeg", "elementId": "e000109", "sourceName": "assets/crop_1_1789064028213.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_1_1789064028232.png", "width": 644, "format": "png", "height": 496, "sha256": "563808254023b259da8691ce24f25abb88a8e2cc039873e89d11baab2345430b", "assetId": "img:563808254023b259da8691ce24f25abb88a8e2cc039873e89d11baab2345430b", "mimeType": "image/jpeg", "elementId": "e000125", "sourceName": "assets/crop_1_1789064028232.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789064028236.png", "width": 713, "format": "png", "height": 259, "sha256": "544aa6afdf594f43f188ad5ab1f211e270829dc32c83528ca5b8157b4501627e", "assetId": "img:544aa6afdf594f43f188ad5ab1f211e270829dc32c83528ca5b8157b4501627e", "mimeType": "image/jpeg", "elementId": "e000126", "sourceName": "assets/crop_2_1789064028236.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q06-24df1df1", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000119", "e000121", "e000128"]}, {"mcq": false, "qwc": false, "stem": "Magnesium chloride can be made by reacting excess magnesium carbonate with dilute hydrochloric acid. The equation for the reaction is $\\mathrm {M g C O} _ {3} + 2 \\mathrm {H C l} \\rightarrow \\mathrm {M g C l} _ {2} + \\mathrm {H} _ {2} \\mathrm {O} + \\mathrm {C O} _ {2}$", "marks": 7, "parts": [{"qwc": false, "text": "In one experiment, a sample of 0.050 mol of $ \\mathrm{M g C O_{3}} $ is added to 0.080 mol of HCl. Show, by calculation, that the $ \\mathrm{M g C O_{3}} $ is in excess.", "label": "a", "marks": null, "partId": "q07-24df1df1-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the maximum volume, in $ cm^{3} $ , of carbon dioxide, measured at room temperature and pressure, that would be obtained when 0.080 mol of HCI react completely with $ MgCO_{3}. $ [One mole of any gas occupies 24 000 $ cm^{3} $ at room temperature and pressure.]", "label": "a-ii", "marks": null, "partId": "q07-24df1df1-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": ["maximum volume of carbon dioxide"]}, {"qwc": false, "text": "In another experiment 0.050 mol of $ \\mathrm{M g C O_{3}} $ reacts with excess HCl. A yield of 5.5 g of $ \\mathrm{M g C l_{2}. 6 H_{2} O} $ is obtained.", "label": "b", "marks": null, "partId": "q07-24df1df1-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the percentage yield of $ \\mathrm{M g C l_{2}. 6 H_{2}O} $", "label": "b-i", "marks": null, "partId": "q07-24df1df1-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": ["percentage yield"]}, {"qwc": false, "text": "Suggest why the percentage yield is less than 100%.", "label": "b-ii", "marks": null, "partId": "q07-24df1df1-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 7, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q07-24df1df1", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "When nitrogen dioxide gas $ \\mathrm{(N O_{2})} $ is placed in a sealed flask, it reacts to form dinitrogen tetraoxide gas $ \\mathrm{(N_{2}O_{4})}. $ The equation for the reaction is $\\begin{array}{c c c} 2 \\mathrm {N O} _ {2} (\\mathrm {g}) & \\rightleftharpoons & \\mathrm {N} _ {2} \\mathrm {O} _ {4} (\\mathrm {g}) \\\\ \\mathrm {b r o w n g a s} & & \\mathrm {c o l o u r l e s s g a s} \\end{array}$ A sample of pure $ \\mathrm{N O_{2}} $ is placed in a sealed flask at $ 2 5^{\\circ} \\mathrm{C} $ . The flask is left until a dynamic equilibrium is reached.", "marks": 8, "parts": [{"qwc": false, "text": "For a reaction that is in dynamic equilibrium, the forward and backward reactions occur at the same time. State two other features of a reaction that is in dynamic equilibrium.", "label": "a", "marks": null, "partId": "q08-24df1df1-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "At equilibrium there is more $ \\mathrm{N O_{2}} $ than $ \\mathrm{N_{2}O_{4}} $ The graph shows how the number of moles of $ \\mathrm{N O_{2}} $ in the sealed flask changes with time.", "label": "b", "marks": null, "partId": "q08-24df1df1-pb", "figures": [{"url": "assets/crop_1_1789064028275.png", "width": 1006, "format": "png", "height": 627, "sha256": "340e06820f1d942f4809ad71971a67634deaf1bfac0a336ba3ef735b9242bbf5", "assetId": "img:340e06820f1d942f4809ad71971a67634deaf1bfac0a336ba3ef735b9242bbf5", "mimeType": "image/jpeg", "elementId": "e000155", "sourceName": "assets/crop_1_1789064028275.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Draw a cross ( $ \\times $ ) on the graph at the point where the reaction reaches equilibrium.", "label": "b-i", "marks": null, "partId": "q08-24df1df1-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Draw a curve on the graph to show how the number of moles of $ \\mathrm{N_{2}O_{4}} $ in the sealed flask changes over the same time period.", "label": "b-ii", "marks": null, "partId": "q08-24df1df1-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The sealed flask containing the equilibrium mixture is placed in water at a temperature of $ 5 0^{\\circ} \\mathrm{C} $ . The mixture goes darker in colour. Explain what this observation shows about the equilibrium reaction. Every effort has been made to contact copyright holders to obtain their permission for the use of copyright material. Pearson Education Ltd. will, if notified, be happy to rectify any errors or omissions and include any such rectifications in future editions.", "label": "c", "marks": null, "partId": "q08-24df1df1-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 8, "figures": [{"url": "assets/crop_1_1789064028275.png", "width": 1006, "format": "png", "height": 627, "sha256": "340e06820f1d942f4809ad71971a67634deaf1bfac0a336ba3ef735b9242bbf5", "assetId": "img:340e06820f1d942f4809ad71971a67634deaf1bfac0a336ba3ef735b9242bbf5", "mimeType": "image/jpeg", "elementId": "e000155", "sourceName": "assets/crop_1_1789064028275.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q08-24df1df1", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}], "paperTotal": 60, "schemaVersion": "1.0", "sectionTotals": {}, "questionTotals": {"1": 5, "2": 6, "3": 8, "4": 5, "5": 8, "6": 13, "7": 7, "8": 8}, "reviewRequired": true, "extractionMethod": "glm-ocr-qp-v1", "frontMatterFigures": []}', '{"paper": {"board": "Edexcel", "session": null, "subject": null, "duration": null, "examDate": null, "logNumber": null, "qualification": null, "paperReference": null, "publicationCode": "4CH0_2C_1701_MS", "canonicalDocumentId": "3225cbae-c9a2-569f-8acc-9c1e84a10e55"}, "entries": [{"mcq": false, "qwc": false, "label": "1(a)", "marks": 1, "number": 1, "entryId": "ms-3225cbae-q1a", "guidance": [{"kind": "note", "text": "(b)"}, {"kind": "note", "text": "hydrogen"}, {"kind": "note", "text": "ACCEPT H2IGNORE H"}, {"kind": "note", "text": "(c)"}, {"kind": "note", "text": "chlorine"}, {"kind": "note", "text": "ACCEPT Cl2IGNORE Cl"}, {"kind": "note", "text": "(d)"}, {"kind": "note", "text": "chlorine"}, {"kind": "note", "text": "ACCEPT Cl2IGNORE Cl"}, {"kind": "note", "text": "(e)"}, {"kind": "note", "text": "iron"}, {"kind": "note", "text": "ACCEPT Fe"}, {"kind": "note", "text": "Total"}], "answerText": "air", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "2(a)(i)", "marks": 1, "number": 2, "entryId": "ms-3225cbae-q2ai", "guidance": [{"kind": "allow", "text": "ALLOW(both are)slightly soluble"}, {"kind": "note", "text": "(b)(i)"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "the oxide is solid"}, {"kind": "note", "text": "the oxide forms an acidic solution(in water)"}, {"kind": "note", "text": "(c)"}, {"kind": "note", "text": "M1 the lamp does not light up"}, {"kind": "note", "text": "M2(so this shows that) phosphorus/it does not conduct electricity"}, {"kind": "note", "text": "ACCEPT"}, {"kind": "note", "text": "reverse arguments"}, {"kind": "note", "text": "Total"}], "answerText": "(both are) solids\nAND\n(both) form alkaline solutions(in water)\n(both are) gases\nAND\n(both) form acidic solutions(in water)", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "3(a)", "marks": 3, "number": 3, "entryId": "ms-3225cbae-q3a", "guidance": [{"kind": "note", "text": "ACCEPTCa>Ti>SnACCEPT replacesACCEPT replaces"}, {"kind": "note", "text": "(b)(i)(ii)(iii)"}, {"kind": "note", "text": "2Al+Fe2O3→Al2O3+2FeM1aluminiumM2because it has gained oxygenORbecause it has lost electronsORbecause its oxidation number has increasedORbecause its oxidation number has changed from0to+3M2DEP onM1M1(powders have) larger surface areaM2(therefore) faster reaction"}, {"kind": "note", "text": "ACCEPTmultiples and halves2M2DEP onM1ACCEPT reverse argumentsIGNOREreferences to collisions between particles"}, {"kind": "note", "text": "Total"}], "answerText": "M1 calcium is the most reactive; titanium is the second most reactive; tin is the least reactiveOR calcium most reactiveAND tin least reactiveM2(because) titanium displaces tinM3(and because) titanium does not displace calcium", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "4(a)", "marks": 1, "number": 4, "entryId": "ms-3225cbae-q4a", "guidance": [{"kind": "note", "text": "(b)"}, {"kind": "note", "text": "D(I-)"}, {"kind": "note", "text": "(c)"}, {"kind": "note", "text": "A(carbonate)"}, {"kind": "note", "text": "(d)"}, {"kind": "note", "text": "C(blue,green,brown)"}, {"kind": "note", "text": "(e)"}, {"kind": "note", "text": "A(carbonate)"}, {"kind": "note", "text": "Total"}], "answerText": "D(NH4+)", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "5(a)", "marks": 2, "number": 5, "entryId": "ms-3225cbae-q5a", "guidance": [{"kind": "note", "text": "1 mark for each correct ion"}, {"kind": "ignore", "text": "IGNORE charges on ion"}, {"kind": "allow", "text": "ALLOW any combination of dots and crosses"}, {"kind": "note", "text": "Diagram showing sharing of electrons scores 0"}, {"kind": "note", "text": "(b)"}, {"kind": "note", "text": "F2C2F2F2"}, {"kind": "note", "text": "M1 all four bonding pairs correct, and only 8 electrons shown in outer shell of carbon"}, {"kind": "note", "text": "M2 all non-bonding pairs correct"}, {"kind": "ignore", "text": "IGNORE inner shells even if incorrect"}, {"kind": "note", "text": "If rings are drawn then both bonding electrons must be in the overlapping area"}, {"kind": "note", "text": "M2 DEP on M1"}], "answerText": "LiF", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "6(a)(i)", "marks": 1, "number": 6, "entryId": "ms-3225cbae-q6ai", "guidance": [{"kind": "allow", "text": "ALLOW(to act as a) catalystALLOWto increase the rate of reactionIGNOREto lower the activation energyIGNOREto start the reactionREJECTto provide(activation) energy"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "(turns) milky/cloudy/turbid(then clear)ORwhite precipitate/white suspension/white solid(forms then disappears)"}, {"kind": "note", "text": "(iii)"}, {"kind": "note", "text": "30℃"}, {"kind": "note", "text": "ACCEPTany temperature,or range of temperatures,between25and40℃"}], "answerText": "(to provide the)zymase/enzyme (that acts as a catalyst)", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "6(c)(i)", "marks": 2, "number": 6, "entryId": "ms-3225cbae-q6ci", "guidance": [{"kind": "note", "text": "M2(32×15.6)=500(kJ)ORM1×15.6 correctly evaluated"}, {"kind": "note", "text": "ACCEPT499/499.2Correct answer with no working scores2"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "M1&M2Any two from:·mass of water/volume of water/amount of water·distance of flame from the can·length of wick"}, {"kind": "ignore", "text": "IGNOREtemperature of water(at start)ALLOWdistance of burner from can"}, {"kind": "note", "text": "(iii)"}, {"kind": "note", "text": "Any two from:M1heat(energy)/thermal energy is lost(to/surroundings)M2incomplete combustion(of the fuel)M3evaporation of water/fuel"}, {"kind": "ignore", "text": "IGNOREjust energy lostIGNOREnot all of the ethanol is burned"}, {"kind": "note", "text": "Total"}], "answerText": "M132", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "7(a)(i)", "marks": 2, "number": 7, "entryId": "ms-3225cbae-q7ai", "guidance": [{"kind": "note", "text": "ACCEPT any method involving correct ratios of moles, egHCl to MgCO3 is 2:10.08 to 0.05 is 2:1.25"}, {"kind": "note", "text": "M20.050>0.040"}, {"kind": "note", "text": "ACCEPT correct calculations involving masses"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "M1n(CO2)=1/2x0.08(0)OR0.04(0)M2vol(CO2)=(0.04(0)x24000)=960(cm3)ORM1×24000 correctly evaluated"}, {"kind": "note", "text": "Correct answer with no working scores21920(cm3) scores1 mark"}, {"kind": "note", "text": "(b)(i)"}, {"kind": "note", "text": "M1Mr(MgCl2.6H2O)=203M2% yield=((5.5÷(203×0.050))×100=54"}, {"kind": "note", "text": "M2CSQ onM1ACCEPT any number of significant figures except one(eg reject50)Calculator value is54.1871921182REJECT answers>100"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "Any one of:some of the crystals remained in the filtrate(after cooling and filtration)the solution was not allowed to cool for long enough(for complete crystallisation)magnesium carbonate is impure"}, {"kind": "ignore", "text": "IGNORE references to side reactionsREJECT not all of the magnesium carbonate reacted"}, {"kind": "note", "text": "Total"}], "answerText": "M10.080 mol of HCl react with 0.040 mol of MgCO3", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "8(a)", "marks": 2, "number": 8, "entryId": "ms-3225cbae-q8a", "guidance": [{"kind": "ignore", "text": "IGNOREforward reaction=backward reaction"}, {"kind": "note", "text": "M2concentrations of reactants/products remain/stay constant"}, {"kind": "note", "text": "ACCEPTamounts/masses for concentrationsACCEPTdo not change for remain constantALLOWcolour remains constantALLOWpressure remains constantIGNOREconcentrations/amounts of reactants and products are the same/are equal"}], "answerText": "M1rate of forward reaction=rate of backward reaction", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "8(b)(i)", "marks": 1, "number": 8, "entryId": "ms-3225cbae-q8bi", "guidance": [{"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "M1 curve starts at 0,0 and has the general shape shown"}, {"kind": "note", "text": "M2 curve becomes horizontal at approximately the same time as the original curve"}, {"kind": "note", "text": "M3 curve finishes below original curve"}, {"kind": "note", "text": "M2 and M3 DEP on M1 or near miss (eg curve does not start at exactly 0,0)"}], "answerText": "Number of moles\nOR\nTime\ncross drawn on either curve just where it becomes horizontal", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "8(c)", "marks": 2, "number": 8, "entryId": "ms-3225cbae-q8c", "guidance": [{"kind": "ignore", "text": "IGNORE references to Le Chatelier''s principle eg an increase in temperature favours the reaction that reduces the temperature"}, {"kind": "note", "text": "OR more NO2 has been produced/more reactants have been produced"}, {"kind": "note", "text": "ACCEPT (forward) reaction is exothermic"}, {"kind": "note", "text": "M2 (therefore) backward reaction is endothermic"}, {"kind": "note", "text": "Total"}], "answerText": "M1 equilibrium has shifted to the left/equilibrium has shifted to the NO2 side/equilibrium has shifted to the reactants side", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}], "icTable": null, "warnings": ["1(a): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "1(a): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "1(a): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "1(a): bare integer cell \"5\" skipped (rubric/rowspan ambiguity)", "2(a)(i): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "2(a)(i): bare integer cell \"2\" skipped (rubric/rowspan ambiguity)", "2(a)(i): bare integer cell \"6\" skipped (rubric/rowspan ambiguity)", "3(a): bare integer cell \"12\" skipped (rubric/rowspan ambiguity)", "3(a): bare integer cell \"8\" skipped (rubric/rowspan ambiguity)", "4(a): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "4(a): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "4(a): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "4(a): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "4(a): bare integer cell \"5\" skipped (rubric/rowspan ambiguity)", "5(a): bare integer cell \"2\" skipped (rubric/rowspan ambiguity)", "orphan row before first entry: (c)", "orphan row before first entry: M2(good conductivity of LiF) ions are mobile", "orphan row before first entry: M3(low melting point of CF4) weak forces(of attraction) between molecules/weak intermolecular forces(of attraction)", "orphan row before first entry: M4(poor conductivity of CF4) molecules are not charged/molecules are neutral/no charged particles", "orphan row before first entry: Total", "6(a)(i): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "6(a)(i): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "orphan row before first entry: (b)", "6(c)(i): bare integer cell \"2\" skipped (rubric/rowspan ambiguity)", "6(c)(i): bare integer cell \"2\" skipped (rubric/rowspan ambiguity)", "6(c)(i): bare integer cell \"13\" skipped (rubric/rowspan ambiguity)", "7(a)(i): bare integer cell \"2\" skipped (rubric/rowspan ambiguity)", "7(a)(i): bare integer cell \"2\" skipped (rubric/rowspan ambiguity)", "7(a)(i): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "7(a)(i): bare integer cell \"7\" skipped (rubric/rowspan ambiguity)", "8(b)(i): bare integer cell \"3\" skipped (rubric/rowspan ambiguity)", "8(c): bare integer cell \"8\" skipped (rubric/rowspan ambiguity)"], "paperTotal": null, "schemaVersion": "1.0", "questionTotals": {}, "reviewRequired": true, "extractionMethod": "glm-ocr-ms-v1"}', '{"findings": [{"msMarks": null, "qpMarks": 5, "severity": "qp-only", "questionNumber": "1"}, {"msMarks": null, "qpMarks": 6, "severity": "qp-only", "questionNumber": "2"}, {"msMarks": null, "qpMarks": 8, "severity": "qp-only", "questionNumber": "3"}, {"msMarks": null, "qpMark