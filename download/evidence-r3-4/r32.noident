INSERT INTO public.question_parts VALUES ('13e50d24-324f-4544-b098-ffffe65f44e7', '17511467-5e5a-42b7-90b4-69da076fb15d', 'c', 'Explain how the curves show which acid has the greater concentration.', NULL, 0, 4, '2026-09-13 12:53:56.169408+00');
