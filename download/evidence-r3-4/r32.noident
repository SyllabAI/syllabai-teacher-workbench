INSERT INTO public.question_parts VALUES ('f104a195-0e93-4d1c-a25b-f0fd060747fa', '68d5cec3-be1a-430a-8799-362cb3089d26', 'a', 'Use the readings to complete the table.', NULL, 0, 0, '2026-09-13 12:59:09.401064+00');
INSERT INTO public.question_parts VALUES ('bbe941df-ea61-4d1a-9e49-dfdff42a968d', '68d5cec3-be1a-430a-8799-362cb3089d26', 'b', 'In a second experiment, using the same mass of water, the student records a temperature increase of $ 4. 9 \mathrm{~} ^ {\circ} \mathrm{C}. $', NULL, 0, 1, '2026-09-13 12:59:09.401096+00');
