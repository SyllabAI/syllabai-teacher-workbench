_ {2} \\mathrm {O} (\\mathrm {I}) + \\mathrm {C O} _ {2} (\\mathrm {g})", "confidence": 1.0, "element_id": "e000064", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 64, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {C} _ {6} \\mathrm {H} _ {1 2} \\mathrm {O} _ {6} (\\mathrm {a q}) \\rightarrow 2 \\mathrm {C} _ {2} \\mathrm {H} _ {5} \\mathrm {O H} (\\mathrm {a q}) + 2 \\mathrm {C O} _ {2} (\\mathrm {g})", "latex": "\\mathrm {C} _ {6} \\mathrm {H} _ {1 2} \\mathrm {O} _ {6} (\\mathrm {a q}) \\rightarrow 2 \\mathrm {C} _ {2} \\mathrm {H} _ {5} \\mathrm {O H} (\\mathrm {a q}) + 2 \\mathrm {C O} _ {2} (\\mathrm {g})", "confidence": 1.0, "element_id": "e000097", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 97, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {X C O} _ {3} (\\mathrm {s}) + 2 \\mathrm {H N O} _ {3} (\\mathrm {a q}) \\rightarrow \\mathrm {X} \\left(\\mathrm {N O} _ {3}\\right) _ {2} (\\mathrm {a q}) + \\mathrm {H} _ {2} \\mathrm {O} (\\mathrm {l}) + \\mathrm {C O} _ {2} (\\mathrm {g})", "latex": "\\mathrm {X C O} _ {3} (\\mathrm {s}) + 2 \\mathrm {H N O} _ {3} (\\mathrm {a q}) \\rightarrow \\mathrm {X} \\left(\\mathrm {N O} _ {3}\\right) _ {2} (\\mathrm {a q}) + \\mathrm {H} _ {2} \\mathrm {O} (\\mathrm {l}) + \\mathrm {C O} _ {2} (\\mathrm {g})", "confidence": 1.0, "element_id": "e000123", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 123, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "pageCount": 1, "documentId": "c4075b63-51fb-5be3-8ee0-4f8b67fd76e8", "provenance": {"engine": "glm-ocr-markdown", "application": "syllabai-parser", "extractedAt": "2026-09-13T12:58:05.294493557Z", "engineVersion": "1.1.0", "schemaVersion": "1.0", "extractionParams": {"pageBoundaries": "none-in-source", "sourceLineCount": 180, "upstreamConverter": "zai-glm-ocr", "entityDecodedLines": 0, "signedUrlFigureRefs": 0, "normalizedHtmlEntities": true}}, "textBlocks": [{"role": "heading", "text": "Instructions", "confidence": 1.0, "element_id": "e000001", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 1, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Use black ink or ball-point pen.", "confidence": 1.0, "element_id": "e000002", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 2, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Fill in the boxes at the top of this page with your name, centre number and candidate number.", "confidence": 1.0, "element_id": "e000003", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 3, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer all questions.", "confidence": 1.0, "element_id": "e000004", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 4, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer the questions in the spaces provided", "confidence": 1.0, "element_id": "e000005", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 5, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "there may be more space than you need.", "confidence": 1.0, "element_id": "e000006", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 6, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Show all the steps in any calculations and state the units.", "confidence": 1.0, "element_id": "e000007", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 7, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Information", "confidence": 1.0, "element_id": "e000008", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 8, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The total mark for this paper is 60.", "confidence": 1.0, "element_id": "e000009", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 9, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The marks for each question are shown in brackets", "confidence": 1.0, "element_id": "e000010", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 10, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "use this as a guide as to how much time to spend on each question.", "confidence": 1.0, "element_id": "e000011", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 11, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Advice", "confidence": 1.0, "element_id": "e000012", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 12, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Read each question carefully before you start to answer it.", "confidence": 1.0, "element_id": "e000013", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 13, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Keep an eye on the time.", "confidence": 1.0, "element_id": "e000014", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 14, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Write your answers neatly and in good English.", "confidence": 1.0, "element_id": "e000015", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 15, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Try to answer every question.", "confidence": 1.0, "element_id": "e000016", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 16, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Check your answers if you have time at the end.", "confidence": 1.0, "element_id": "e000017", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 17, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Answer ALL questions.", "confidence": 1.0, "element_id": "e000019", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 19, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "1 The melting points of three related compounds are", "confidence": 1.0, "element_id": "e000020", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 20, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The boiling point of all these compounds is above 100 $ ^{\\circ} \\mathrm{C} $", "confidence": 1.0, "element_id": "e000022", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 22, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Use the grid to draw a bar chart of the melting points.", "confidence": 1.0, "element_id": "e000023", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 23, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Room temperature has been marked on the grid.", "confidence": 1.0, "element_id": "e000025", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 25, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Use your bar chart to give the physical state of each acid at room temperature.", "confidence": 1.0, "element_id": "e000026", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 26, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 1 = 4 marks)", "confidence": 1.0, "element_id": "e000027", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 27, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "2 A student produces this chromatogram for four dyes, A, B, C and D.", "confidence": 1.0, "element_id": "e000028", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 28, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Put a cross ( $ \\times $ ) in a box to indicate your answer.", "confidence": 1.0, "element_id": "e000030", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 30, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Which one of the dyes contains three colours?", "confidence": 1.0, "element_id": "e000031", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 31, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A", "confidence": 1.0, "element_id": "e000032", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 32, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B", "confidence": 1.0, "element_id": "e000033", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 33, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C", "confidence": 1.0, "element_id": "e000034", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 34, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D", "confidence": 1.0, "element_id": "e000035", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 35, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Which one of the dyes contains one colour only?", "confidence": 1.0, "element_id": "e000036", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 36, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A", "confidence": 1.0, "element_id": "e000037", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 37, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B", "confidence": 1.0, "element_id": "e000038", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 38, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C", "confidence": 1.0, "element_id": "e000039", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 39, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D", "confidence": 1.0, "element_id": "e000040", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 40, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Each dye is made from one or more of the colours blue, red and yellow.", "confidence": 1.0, "element_id": "e000041", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 41, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The student thinks that the result for one dye is incorrect.", "confidence": 1.0, "element_id": "e000042", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 42, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Suggest which result is incorrect. Explain your answer.", "confidence": 1.0, "element_id": "e000043", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 43, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The incorrect result is because ...", "confidence": 1.0, "element_id": "e000044", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 44, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 2 = 4 marks)", "confidence": 1.0, "element_id": "e000045", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 45, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "3 The photograph shows an aeroplane that has a rocket motor.", "confidence": 1.0, "element_id": "e000046", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 46, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) One of the tanks on the aeroplane contains liquid oxygen.", "confidence": 1.0, "element_id": "e000048", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 48, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Complete the diagram to show the arrangement of the particles in a liquid. One particle has been drawn for you.", "confidence": 1.0, "element_id": "e000049", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 49, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Much more oxygen can be stored in the tank when the oxygen is a liquid rather than a gas.", "confidence": 1.0, "element_id": "e000051", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 51, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Give a reason for this in terms of the arrangement of the particles.", "confidence": 1.0, "element_id": "e000052", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 52, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Magnesium burns in oxygen to form magnesium oxide.", "confidence": 1.0, "element_id": "e000053", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 53, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) State two observations that can be made when magnesium burns in oxygen.", "confidence": 1.0, "element_id": "e000055", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 55, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Give the formula of magnesium oxide.", "confidence": 1.0, "element_id": "e000056", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 56, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) A small amount of magnesium oxide is dissolved in water. When universal indicator is added to this solution, the indicator turns blue.", "confidence": 1.0, "element_id": "e000057", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 57, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) What does the observation with the indicator show about magnesium oxide?", "confidence": 1.0, "element_id": "e000058", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 58, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Identify the ion that is responsible for the universal indicator turning blue.", "confidence": 1.0, "element_id": "e000059", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 59, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "4 An excess of dilute hydrochloric acid was added to a lump of calcium carbonate in a beaker. The mass of the beaker and contents was recorded every 30 seconds.", "confidence": 1.0, "element_id": "e000060", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 60, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The graph shows the results.", "confidence": 1.0, "element_id": "e000061", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 61, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Mass of beaker and contents in grams", "confidence": 1.0, "element_id": "e000062", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 62, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The equation for the reaction is", "confidence": 1.0, "element_id": "e000065", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 65, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) State two observations that can be made when dilute hydrochloric acid is added to calcium carbonate.", "confidence": 1.0, "element_id": "e000066", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 66, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Give the test for carbon dioxide gas.", "confidence": 1.0, "element_id": "e000067", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 67, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Describe the relationship between the mass of the beaker and contents, and the time. (1)", "confidence": 1.0, "element_id": "e000068", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 68, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) (i) After how many minutes did the reaction stop?", "confidence": 1.0, "element_id": "e000069", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 69, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) State why the reaction eventually stopped.", "confidence": 1.0, "element_id": "e000070", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 70, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(e) Identify the compounds, other than water, present in the solution in the beaker (i) after two minutes", "confidence": 1.0, "element_id": "e000071", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 71, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) after five minutes", "confidence": 1.0, "element_id": "e000072", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 72, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(f) The experiment was repeated using the same mass of calcium carbonate, but as a powder instead of a single lump.", "confidence": 1.0, "element_id": "e000073", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 73, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "On the graph, sketch the curve you would expect to obtain from this second experiment.", "confidence": 1.0, "element_id": "e000074", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 74, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 4 = 11 marks)", "confidence": 1.0, "element_id": "e000075", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 75, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "5 Soluble salts can be made by reacting an acid with a metal hydroxide, a metal oxide, or a metal carbonate.", "confidence": 1.0, "element_id": "e000076", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 76, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Insoluble salts can be made by using a precipitation reaction.", "confidence": 1.0, "element_id": "e000077", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 77, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Complete the table to show which acid or metal compound is used to make each salt listed.", "confidence": 1.0, "element_id": "e000078", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 78, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "For each metal compound, state whether it would be used as a solid or in aqueous solution.", "confidence": 1.0, "element_id": "e000079", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 79, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) An acid is a source of hydrogen ions, $ \\mathrm{H}^{+} $", "confidence": 1.0, "element_id": "e000081", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 81, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Write an equation to show the ions formed when sulfuric acid is dissolved in water.", "confidence": 1.0, "element_id": "e000082", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 82, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Lead(II) chloride is an insoluble salt that can be prepared by reacting lead(II) nitrate with sodium chloride.", "confidence": 1.0, "element_id": "e000083", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 83, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Describe how you would prepare a pure, dry sample of lead(II) chloride starting from solid lead(II) nitrate and solid sodium chloride.", "confidence": 1.0, "element_id": "e000084", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 84, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 5 = 12 marks)", "confidence": 1.0, "element_id": "e000085", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 85, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "6 This is a recipe for making plum wine.", "confidence": 1.0, "element_id": "e000086", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 86, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Dissolve 1.5 kg of sugar in 5 dm $ ^{3} $ of warm water.", "confidence": 1.0, "element_id": "e000088", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 88, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Add yeast and 8 kg of plums.", "confidence": 1.0, "element_id": "e000089", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 89, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Pour the mixture into a flask.", "confidence": 1.0, "element_id": "e000090", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 90, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Leave the flask for several weeks until the reaction has stopped.", "confidence": 1.0, "element_id": "e000091", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 91, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Remove the solid yeast and pour the clear liquid into bottles.", "confidence": 1.0, "element_id": "e000092", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 92, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Sugar contains sucrose, $ C_{1 2} H_{2 2} O_{1 1} $", "confidence": 1.0, "element_id": "e000094", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 94, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "When yeast is added, water reacts with sucrose to form glucose, $ \\mathrm{C_{6} H_{1 2} O_{6}} $ Write a chemical equation for this reaction.", "confidence": 1.0, "element_id": "e000095", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 95, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The glucose is then converted into ethanol by the yeast", "confidence": 1.0, "element_id": "e000096", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 96, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) How would you know when the reaction has stopped?", "confidence": 1.0, "element_id": "e000098", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 98, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) How could the solid yeast be removed from the mixture?", "confidence": 1.0, "element_id": "e000099", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 99, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Ethanol can be converted into chloroethene, $ \\mathrm{C H_{2}=C H C l} $ , in three stages.", "confidence": 1.0, "element_id": "e000100", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 100, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Stage 1 Ethanol is dehydrated to form ethene, $ \\mathrm{C H_{2}=C H_{2}} $", "confidence": 1.0, "element_id": "e000101", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 101, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Stage 2 Ethene is converted into 1,2-dichloroethane, $ \\mathrm{C H_{2} C I C H_{2} C I} $", "confidence": 1.0, "element_id": "e000102", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 102, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Stage 3 1,2-dichloroethane is converted into chloroethene and hydrogen chloride", "confidence": 1.0, "element_id": "e000103", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 103, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Why is the reaction in Stage 1 described as dehydration?", "confidence": 1.0, "element_id": "e000104", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 104, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Identify the catalyst used in the reaction in Stage 1.", "confidence": 1.0, "element_id": "e000105", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 105, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Suggest the name or formula of the substance used to react with ethene in Stage 2.", "confidence": 1.0, "element_id": "e000106", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 106, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iv) Write a chemical equation for the reaction in Stage 3.", "confidence": 1.0, "element_id": "e000107", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 107, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) Chloroethene can be used to make the polymer poly(chloroethene), also known as PVC.", "confidence": 1.0, "element_id": "e000108", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 108, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The displayed formula for part of the PVC molecule is", "confidence": 1.0, "element_id": "e000109", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 109, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Draw a displayed formula for a chloroethene molecule.", "confidence": 1.0, "element_id": "e000111", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 111, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Describe, in terms of structure and bonding, what happens when chloroethene molecules are converted into poly(chloroethene).", "confidence": 1.0, "element_id": "e000112", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 112, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 6 = 11 marks)", "confidence": 1.0, "element_id": "e000113", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 113, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000114", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 114, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "7 A student set up this apparatus to measure the volume of carbon dioxide given off when a sample of a carbonate of a Group 2 metal was reacted with dilute nitric acid.", "confidence": 1.0, "element_id": "e000115", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 115, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "She weighed out some of the carbonate and put it in a conical flask. She then added an excess of dilute nitric acid.", "confidence": 1.0, "element_id": "e000117", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 117, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "After adding the acid she placed the bung and delivery tube into the conical flask.", "confidence": 1.0, "element_id": "e000118", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 118, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "She measured the total volume of gas collected at room temperature and pressure (rtp) in the measuring cylinder.", "confidence": 1.0, "element_id": "e000119", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 119, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Her results are shown in the table.", "confidence": 1.0, "element_id": "e000120", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 120, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The equation for the reaction is", "confidence": 1.0, "element_id": "e000122", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 122, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "where X is the symbol for the Group 2 metal.", "confidence": 1.0, "element_id": "e000124", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 124, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) (i) Calculate the amount, in moles, of carbon dioxide gas collected. (Assume that one mole of gas has a volume of 24000 $ cm^{3} $ at rtp)", "confidence": 1.0, "element_id": "e000125", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 125, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Amount of carbon dioxide gas collected = mol", "confidence": 1.0, "element_id": "e000126", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 126, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Deduce the amount, in moles, of the carbonate that reacted.", "confidence": 1.0, "element_id": "e000127", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 127, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Amount of carbonate reacted = mol", "confidence": 1.0, "element_id": "e000128", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 128, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Using the mass of the carbonate and your answer to (a)(ii), calculate the relative formula mass $ ( M_{r} ) $ of this carbonate.", "confidence": 1.0, "element_id": "e000129", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 129, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Give your answer to the nearest whole number.", "confidence": 1.0, "element_id": "e000130", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 130, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Relative formula mass = .", "confidence": 1.0, "element_id": "e000131", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 131, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iv) Calculate a value for the relative atomic mass of the Group 2 metal, X, and use the Periodic Table on page 2 to suggest its identity.", "confidence": 1.0, "element_id": "e000132", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 132, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Relative atomic mass of X = ...", "confidence": 1.0, "element_id": "e000133", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 133, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Identity of X=.", "confidence": 1.0, "element_id": "e000134", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 134, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) After the student had completed the experiment she was told that the metal carbonate was calcium carbonate.", "confidence": 1.0, "element_id": "e000135", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 135, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "She calculated that 0.888 g of calcium carbonate would produce $ 2 1 3 \\mathrm{c m}^{3} $ of carbon dioxide.", "confidence": 1.0, "element_id": "e000136", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 136, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "She was certain that she had measured the mass of the metal carbonate correctly.", "confidence": 1.0, "element_id": "e000137", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 137, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Suggest two reasons why the volume of gas she collected was less than $ 2 1 3 \\mathrm{c m}^{3}. $", "confidence": 1.0, "element_id": "e000138", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 138, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 7 = 10 marks)", "confidence": 1.0, "element_id": "e000139", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 139, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(TOTAL FOR PAPER=60 MARKS)", "confidence": 1.0, "element_id": "e000140", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 140, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000141", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 141, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000142", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 142, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "schemaVersion": "1.0"}', NULL, '2026-09-13 12:58:25.902917+00');
