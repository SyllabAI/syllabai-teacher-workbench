INSERT INTO public.document_chunks VALUES ('eb79d214-204c-46ff-a9a7-bb559ec83d25', '1f57c0bc-a6ac-4a44-b5cc-bc488ee6dead', 0, 'Please check the examination details below before entering your candidate information
