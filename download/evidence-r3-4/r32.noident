INSERT INTO public.question_parts VALUES ('a2e347d6-e664-4e33-89ef-429457be5980', '400fd6a0-529a-4853-ba85-d9d12e694af3', 'c', 'One student obtained these results from an experiment in which she added a total of $ 4 0. 0 \mathrm{c m}^{3} $ of hydrochloric acid to $ 2 5 \mathrm{c m}^{3} $ of sodium hydroxide solution.', NULL, 0, 6, '2026-09-13 12:57:42.153837+00');
INSERT INTO public.question_parts VALUES ('2467264c-bac2-4fcf-98b6-9edf07930f4b', '400fd6a0-529a-4853-ba85-d9d12e694af3', 'c-i', 'Plot a graph of these results on the grid below. Draw a straight line of best fit through the first five points and another straight line of best fit through the last four points. Make sure that the two lines cross. Temperature in $ ^{\circ} \mathrm{C} $', NULL, 0, 7, '2026-09-13 12:57:42.153842+00');
