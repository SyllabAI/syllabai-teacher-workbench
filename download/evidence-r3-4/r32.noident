INSERT INTO public.questions VALUES ('e4ba04aa-8731-4759-9955-fe41b82b66cc', 'q02-20626212', 'STRUCTURED', 'A student does a chromatography experiment using ink 1, ink 2, and three known dyes A, B and C. The student uses water as the solvent. The diagram shows the student''s chromatogram.', 7, 3, 630, NULL, '47c0f6dc-81dd-49bc-8a9d-3d75785bf564', 'PAST_PAPER', true, 1, '2026-09-13 12:55:24.074733+00', '24bec6c1-9d53-4c29-914d-1a3bda8ce6ce');
