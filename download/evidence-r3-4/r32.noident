INSERT INTO public.question_parts VALUES ('aa1820da-c235-4f98-b51b-f57f89bd547e', 'a02c8e04-e48e-4469-b411-9a527a540a01', 'b', 'Aluminium cannot be extracted by heating a mixture of carbon and aluminium oxide. Give a reason why heating a mixture of aluminium oxide and carbon does not produce aluminium.', NULL, 0, 3, '2026-09-13 13:01:26.267774+00');
INSERT INTO public.question_parts VALUES ('9d278ccc-4db6-41b9-ab22-000cbe4d66dc', 'a02c8e04-e48e-4469-b411-9a527a540a01', 'c', 'Aluminium is extracted industrially by the electrolysis of molten aluminium oxide $ \mathrm{A l_{2} O_{3}} $ at a temperature of about $ 9 5 0^{\circ} \mathrm{C}。 $ Aluminium metal forms at the negative electrode and oxygen gas forms at the positive electrode. The positive and negative electrodes are made of graphite. The diagram shows the apparatus used.', NULL, 0, 4, '2026-09-13 13:01:26.267798+00');
INSERT INTO public.question_parts VALUES ('31aa5105-6e3b-41ae-96d9-345ae8916bbe', 'a02c8e04-e48e-4469-b411-9a527a540a01', 'c-i', 'Explain how aluminium metal forms at the negative electrode.', NULL, 0, 5, '2026-09-13 13:01:26.267838+00');
