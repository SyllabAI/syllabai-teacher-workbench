INSERT INTO public.question_versions VALUES ('9561465e-65fb-4c6c-b9f7-86642ac63318', '242fd56f-0055-4698-8b0c-80c458e2cd31', 1, 'A teacher asked her students to suggest some experiments that could be done using chemicals found in the home. One student planned an experiment to measure the temperature change when baking soda is added to vinegar. She wrote this plan. pour 100 $ cm^{3} $ of vinegar into a polystyrene cup weigh out five separate 1 g portions of baking soda measure the temperature of the vinegar add 1 g of baking soda to the vinegar and stir record the new temperature add the other portions of baking soda, stirring and recording the temperature after each portion is added The graph shows her results. Mass of baking soda added in grams', 10, 3, 900, NULL, 'SUGGESTED', 'a11a8fbb-b3e3-57ef-bc08-bb0138309d31', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.361021+00');
INSERT INTO public.question_versions VALUES ('b9f97fb4-68b2-4a4d-809a-227a80e6a222', 'd4ab8d6b-4134-4c8e-abde-6f9fad661c6e', 1, 'A group of students investigated the reaction between marble chips (calcium carbonate) and dilute hydrochloric acid. The equation for this reaction is $\mathrm {C a C O} _ {3} (\mathrm {s}) + 2 \mathrm {H C l} (\mathrm {a q}) \rightarrow \mathrm {C a C l} _ {2} (\mathrm {a q}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {l}) + \mathrm {C O} _ {2} (\mathrm {g})$ They wanted to find the effect of changing the concentration of hydrochloric acid on the rate of reaction. The teacher provided a solution that she had labelled 100% hydrochloric acid. The teacher told them to do all their experiments using different concentrations of hydrochloric acid made by diluting the 100% hydrochloric acid by timing how long it took to collect carbon dioxide at room temperature The students used this apparatus.', 14, 3, 1260, NULL, 'SUGGESTED', 'a11a8fbb-b3e3-57ef-bc08-bb0138309d31', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.3613+00');
INSERT INTO public.question_versions VALUES ('7efc1af6-3fd9-4491-8f97-445c14b800cf', 'f8fea82c-771d-42a6-93ac-e6f3b2b70bb0', 1, 'The diagram shows some pieces of apparatus used to measure volumes. He was allowed to use normal laboratory apparatus, including the pieces of apparatus shown in the diagram. He was told to plan an experiment to find the concentration of the sodium hydroxide solution. This is his plan. Step1 Obtain about 150 $ cm^{3} $ of each solution. Step 2 Use a measuring cylinder to add exactly 25.0 $ cm^{3} $ of sodium hydroxide solution to a conical flask. Step 3 Add a few drops of universal indicator to the conical flask. Step 4 Use a burette to add the sulfuric acid to the conical flask until the indicator changes colour. A student was given a large bottle containing sodium hydroxide solution and a supply of dilute sulfuric acid of known concentration.', 14, 3, 1260, NULL, 'SUGGESTED', 'a11a8fbb-b3e3-57ef-bc08-bb0138309d31', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.361582+00');
INSERT INTO public.question_versions VALUES ('bc9fc6f5-894d-4435-9e0e-607bcff3c725', '201157bf-3b73-4139-8072-6c49744ccd5d', 1, 'The Haber process is used to convert nitrogen and hydrogen into ammonia.', 1, 3, 90, NULL, 'SUGGESTED', 'a11a8fbb-b3e3-57ef-bc08-bb0138309d31', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.36246+00');
INSERT INTO public.question_versions VALUES ('176569a7-b98c-4f6c-bbae-bf98b9dc2140', '0cbe74d3-6f77-4f1d-a197-c73f41a728de', 1, 'The properties of substances can be explained in terms of their bonding and structure. Electricity can be transmitted by overhead power lines. This method of transmission requires electrical conductors and insulators.', 9, 3, 810, NULL, 'SUGGESTED', 'a11a8fbb-b3e3-57ef-bc08-bb0138309d31', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.362942+00');
INSERT INTO public.question_versions VALUES ('bce5263d-0341-4b71-93d0-1d750d9a4ffd', '5f0c3cfe-0866-4a3b-94f8-94c67ff9899f', 1, 'Some of the gases used in industry are stored in cylinders.', 8, 3, 720, NULL, 'SUGGESTED', '8efa97d9-9726-5b6c-b846-a0669ef9ada4', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.602281+00');
INSERT INTO public.question_versions VALUES ('b5ef3a42-e491-4459-960d-99e5e9c03eec', '386e2612-368f-423e-a43d-fa99b49b9430', 1, 'Some powdered calcium carbonate was heated strongly in a test tube. The gas given off was bubbled through limewater. The equation for the reaction taking place in the heated tube is $\mathrm {C a C O} _ {3} (\mathrm {s}) \rightarrow \mathrm {C a O} (\mathrm {s}) + \mathrm {C O} _ {2} (\mathrm {g})$', 6, 3, 540, NULL, 'SUGGESTED', '8efa97d9-9726-5b6c-b846-a0669ef9ada4', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.602619+00');
INSERT INTO public.question_versions VALUES ('f16baa2a-95fc-42cc-a020-5c3df5b80ef1', '39938a92-3439-4430-a766-8e3e3abadb1e', 1, 'The table gives information about barium salts.', 12, 3, 1080, NULL, 'SUGGESTED', '8efa97d9-9726-5b6c-b846-a0669ef9ada4', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.602964+00');
INSERT INTO public.question_versions VALUES ('626dba58-8ad7-4fd0-8d44-91f314a66b7f', '080a68f0-8e73-4e3e-84a9-61a503f0a570', 1, 'This question is about the extraction and uses of aluminium.', 10, 3, 900, NULL, 'SUGGESTED', '8efa97d9-9726-5b6c-b846-a0669ef9ada4', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.603203+00');
INSERT INTO public.question_versions VALUES ('bef07aa0-1983-40e6-82c4-a4171ccefc58', '0b6f98d4-53ec-484f-977d-0aa3d1c25fdf', 1, '(a) Explain what is meant by the term isomerism.', 11, 3, 990, NULL, 'SUGGESTED', '8efa97d9-9726-5b6c-b846-a0669ef9ada4', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.603441+00');
INSERT INTO public.question_versions VALUES ('a347a2dc-9843-46e1-be66-8c48d850e51d', '4976197f-1772-4536-9f2e-618b4b09e2f1', 1, 'The table gives information about the first four elements in Group 7 of the Periodic Table.', 16, 3, 1440, NULL, 'SUGGESTED', '8efa97d9-9726-5b6c-b846-a0669ef9ada4', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.603699+00');
INSERT INTO public.question_versions VALUES ('6b136041-1009-4055-b7b8-457d3063ff73', '7ac2a681-b061-4618-b1b8-35b9167119f6', 1, 'Some students investigated the rate of the reaction between marble chips (calcium carbonate) and dilute hydrochloric acid.', 16, 3, 1440, NULL, 'SUGGESTED', '8efa97d9-9726-5b6c-b846-a0669ef9ada4', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.603942+00');
INSERT INTO public.question_versions VALUES ('2e118484-350f-4661-8ba4-175d03ef7f84', 'b44e6bf9-05d5-4cb3-8e73-8352eb148d6f', 1, 'A student was asked by his teacher to perform a flame test on a solid. He used this method. dip the tip of a clean platinum wire into hydrochloric acid and then into the solid adjust the air hole of the Bunsen burner to obtain a non-roaring, non-luminous Bunsen flame place the tip of the platinum wire into the edge of the flame observe the colour in the flame', 8, 3, 720, NULL, 'SUGGESTED', '8efa97d9-9726-5b6c-b846-a0669ef9ada4', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.604165+00');
INSERT INTO public.question_versions VALUES ('c3390427-20b2-4826-9e20-ee345113ca55', '8247e519-baf7-40b1-8aa4-f7a4e4fcca3a', 1, 'The piece of apparatus shown contains 0.010 mol/dm $ ^{3} $ hydrochloric acid.', 1, 3, 90, NULL, 'SUGGESTED', '8efa97d9-9726-5b6c-b846-a0669ef9ada4', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.604379+00');
INSERT INTO public.question_versions VALUES ('5ac53282-e092-43fe-b237-f44d04445530', '96e5f221-0333-4bab-8021-ebf0225fa6a0', 1, 'Ammonia $ \mathrm{(N H_{3})} $ can be made by reacting nitrogen and hydrogen, in the presence of an iron catalyst, according to the equation $\mathrm {N} _ {2} (\mathrm {g}) + 3 \mathrm {H} _ {2} (\mathrm {g}) \rightleftharpoons 2 \mathrm {N H} _ {3} (\mathrm {g}) \quad \Delta H = - 9 2 \mathrm {k J / m o l}$ The reaction is reversible and the reaction mixture can, if left for long enough, reach a position of dynamic equilibrium. The graph shows how the percentage of ammonia at equilibrium depends on the temperature and pressure used. Percentage of ammonia at equilibrium', 15, 3, 1350, NULL, 'SUGGESTED', '8efa97d9-9726-5b6c-b846-a0669ef9ada4', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.604608+00');
INSERT INTO public.question_versions VALUES ('832fdbf7-3475-4394-b241-40fcec90f49f', '9837b683-ea60-4be0-816a-7b1377edbb20', 1, 'A student burned four liquid fuels in order to compare the amount of energy they released, in the form of heat. She used this apparatus. The energy released when each fuel was burned was used to raise the temperature of 100 g of water. For each fuel, the student recorded the mass of fuel burned and the increase in temperature of the water. Her results are shown in the table. The best fuel is the one that releases the most energy.', 9, 3, 810, NULL, 'SUGGESTED', '8efa97d9-9726-5b6c-b846-a0669ef9ada4', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.604866+00');
INSERT INTO public.question_versions VALUES ('83e7c045-6a4c-4afc-9c56-dfd9dac5b997', '707160df-a397-4156-83ce-1811d4df0ad1', 1, 'Rock salt is a mixture of salt and sand. Crystals of pure salt can be obtained from rock salt by using the method below. Use words from the box to complete the sentences. You may use each word once, more than once or not at all. crystals dissolve evaporate filter solution solvent Grind the rock salt into a fine powder. Add the powder to hot water and stir to ... the salt. Filter the mixture. The salt passes through the filter paper leaving behind the sand. Boil the filtrate to ... some of the water. Leave the saturated solution to cool so that ... of salt form. Finally, the cold mixture to separate the crystals from the remaining solution.', 5, 3, 450, NULL, 'SUGGESTED', '0953f0b3-5e2d-5c28-a3bf-d26e5f4abcd3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.783722+00');
INSERT INTO public.question_versions VALUES ('d6e50b07-6cd6-4dfb-9c40-6b8bc008bd6a', '45db4864-ea6c-4257-82e9-a0f9a6c4bcc9', 1, 'The three states of matter are solid, liquid and gas. The diagram shows how the particles are arranged in each of these states.', 7, 3, 630, NULL, 'SUGGESTED', '0953f0b3-5e2d-5c28-a3bf-d26e5f4abcd3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.784907+00');
INSERT INTO public.question_versions VALUES ('aa74108f-9a3f-4488-b729-7aef9a4c6be2', '64ad0312-2860-4d30-b218-e4c6aba639a0', 1, 'Air is a mixture of gases. The table gives the formulae of three gases and their approximate percentage by volume in a sample of dry, unpolluted air.', 9, 3, 810, NULL, 'SUGGESTED', '0953f0b3-5e2d-5c28-a3bf-d26e5f4abcd3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.785919+00');
INSERT INTO public.question_versions VALUES ('5ce85a3a-e913-457d-994a-f71510d97eb2', '927751be-5925-40f9-8372-91a6c2e65929', 1, 'This is a description of how the orange colouring can be extracted from rose petals. crush the petals using a pestle and mortar add the crushed petals to some ethanol in a beaker heat to about $ 6 0^{\circ} \mathrm{C} $ and stir to produce an orange solution separate the orange solution from the petals', 1, 3, 90, NULL, 'SUGGESTED', '0953f0b3-5e2d-5c28-a3bf-d26e5f4abcd3', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.787398+00');
INSERT INTO public.question_versions VALUES ('f1055aa8-c87c-4ca0-a690-89ed18db854a', '14dd8317-cee1-4510-9f95-7cb912e8c095', 1, 'This apparatus can be used to make and collect carbon dioxide. This is done by adding dilute hydrochloric acid to calcium carbonate.', 7, 3, 630, NULL, 'SUGGESTED', '0953f0b3-5e2d-5c28-a3bf-d26e5f4abcd3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.787673+00');
INSERT INTO public.question_versions VALUES ('0b444911-4337-462e-b5ba-b75cbfb822c0', 'd99e37b4-0d42-49d4-8b13-e35094df40f5', 1, 'The table gives some data about the first six members of a homologous series of compounds called the alkanes.', 12, 3, 1080, NULL, 'SUGGESTED', '0953f0b3-5e2d-5c28-a3bf-d26e5f4abcd3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.788726+00');
INSERT INTO public.question_versions VALUES ('716d617a-029a-4c8d-a086-fe527f7661bc', '2c64c6b8-30b2-4258-972a-46121bf7b1e5', 1, 'Distress flares are used to attract attention in an emergency. The flares contain magnesium, which burns with a bright, white flame to form magnesium oxide.', 9, 3, 810, NULL, 'SUGGESTED', '0953f0b3-5e2d-5c28-a3bf-d26e5f4abcd3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.790936+00');
INSERT INTO public.question_versions VALUES ('ab5f727e-5dfa-4615-84bc-afd9ec540eac', 'cb465d4f-b04c-4e6c-9906-99154794fd17', 1, 'The table gives information about the first three elements in Group 1 of the Periodic Table.', 14, 3, 1260, NULL, 'SUGGESTED', '0953f0b3-5e2d-5c28-a3bf-d26e5f4abcd3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.791228+00');
INSERT INTO public.question_versions VALUES ('db45b046-4d93-47ab-a99f-a852591089da', '25ba541f-28f6-4824-8873-7fca9d9b1f4b', 1, '(a) The table shows information about two common addition polymers. Complete the table for these two polymers.', 9, 3, 810, NULL, 'SUGGESTED', '87d9135e-d9af-5b60-b2f3-82bc89ba5a1a', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:26.065662+00');
INSERT INTO public.question_versions VALUES ('c5628796-2f41-46d9-a15c-85bc23638f48', '80a22f9c-83a4-464d-ab77-c8224aa42282', 1, 'A student investigates how temperature affects the rate of reaction between two colourless solutions containing ions. When he mixes the solutions, a reaction takes place between the ions and after a while the mixture suddenly turns blue. He performs the experiment at five different temperatures and on each occasion he measures the time taken for the mixture to turn blue. The table shows his results.', 9, 3, 810, NULL, 'SUGGESTED', '0953f0b3-5e2d-5c28-a3bf-d26e5f4abcd3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.791798+00');
INSERT INTO public.question_versions VALUES ('2bfcf617-7d78-4b94-8ddc-069762a6bd9b', '8f679044-c5c5-4e2a-945e-244c3f227126', 1, 'A student investigates the reaction between dilute hydrochloric acid and marble chips. She uses this method. put 50 $ cm^{3} $ of dilute hydrochloric acid into a polystyrene cup measure the initial temperature of the acid add 5.0 g of marble chips to the acid and stir the mixture measure the temperature of the mixture after 2 minutes She carries out the experiment three times, using different sizes of marble chips each time. The diagram shows the temperatures for each experiment. Experiment 1 large marble chips Experiment 2 medium marble chips Experiment 3 small marble chips', 7, 3, 630, NULL, 'SUGGESTED', '0953f0b3-5e2d-5c28-a3bf-d26e5f4abcd3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.792378+00');
INSERT INTO public.question_versions VALUES ('64e52553-301f-4d62-b615-3e9e25b97f97', '4a7cd912-77f3-4ebb-b83a-356c75300204', 1, 'Titanium is extracted from its main ore, rutile, in a three-stage process. Stage1 Rutile is heated with chlorine and coke (carbon) at a temperature of about $ 9 0 0^{\circ} \mathrm{C} $ $\mathrm {T i O} _ {2} + 2 \mathrm {C l} _ {2} + 2 \mathrm {C} \rightarrow \mathrm {T i C l} _ {4} + 2 \mathrm {C O}$ Stage 2 $ \mathrm{T i C l}_{4} $ is then added to liquid magnesium at a temperature of about $ 8 0 0^{\circ} \mathrm{C} $ in an atmosphere of argon. $\mathrm {T i C l} _ {4} + 2 \mathrm {M g} \rightarrow \mathrm {T i} + 2 \mathrm {M g C l} _ {2}$ During the reaction the temperature rises to about $ 1 1 0 0^{\circ} \mathrm{C} $ Stage 3 The magnesium chloride is removed by distillation from the mixture formed in stage 2, leaving behind pure titanium.', 7, 3, 630, NULL, 'SUGGESTED', '0953f0b3-5e2d-5c28-a3bf-d26e5f4abcd3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.793632+00');
INSERT INTO public.question_versions VALUES ('9b2e013b-5e7c-4305-9d6a-ca49c0248532', '66fd8a5c-65a6-4152-b1f1-e45a59720a14', 1, 'Magnesium reacts with dilute hydrochloric acid. The equation for the reaction is $\mathrm {M g} (\mathrm {s}) + 2 \mathrm {H C l} (\mathrm {a q}) \rightarrow \mathrm {M g C l} _ {2} (\mathrm {a q}) + \mathrm {H} _ {2} (\mathrm {g})$', 6, 3, 540, NULL, 'SUGGESTED', '0953f0b3-5e2d-5c28-a3bf-d26e5f4abcd3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.794505+00');
INSERT INTO public.question_versions VALUES ('1a674c33-90d1-4847-9c62-b6a0ba6fb85d', 'a28823a0-3db9-42a8-b7ab-5bde04e3a8e8', 1, 'The diagram shows the manufacture of ammonia by the Haber process and its conversion into the fertiliser ammonium nitrate.', 9, 3, 810, NULL, 'SUGGESTED', '0953f0b3-5e2d-5c28-a3bf-d26e5f4abcd3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.794813+00');
INSERT INTO public.question_versions VALUES ('4266a1b1-6d2d-4f3e-ac94-8a7dd19d087d', '17b5ab5d-dc23-4019-94a1-b18568bec7fe', 1, 'Carbon monoxide and hydrogen are used in the manufacture of methanol （ $ \mathrm{C H_{3} O H} $ ）. The reaction is reversible and can reach a position of dynamic equilibrium. $\mathrm {C O (g)} + 2 \mathrm {H} _ {2} (\mathrm {g}) \rightleftharpoons \mathrm {C H} _ {3} \mathrm {O H} (\mathrm {g}) \quad \Delta H = - 9 1 \mathrm {k J / m o l}$ The reaction is carried out at a pressure of about 100 atmospheres and a temperature of $ 2 5 0^{\circ} \mathrm{C} $', 14, 3, 1260, NULL, 'SUGGESTED', '0953f0b3-5e2d-5c28-a3bf-d26e5f4abcd3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:25.795694+00');
INSERT INTO public.question_versions VALUES ('60269dda-2d81-4dd0-b7e7-8c1393faada2', '61a51ea0-a4d0-41f2-8871-6d8446073d47', 1, 'The diagram shows some pieces of apparatus that you may find in a laboratory. E F', 1, 3, 90, NULL, 'SUGGESTED', '87d9135e-d9af-5b60-b2f3-82bc89ba5a1a', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:26.059783+00');
