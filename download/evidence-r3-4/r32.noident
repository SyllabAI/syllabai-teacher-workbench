INSERT INTO public.document_chunks VALUES ('4753cb04-26ca-444c-b16b-9dc2f18938b2', '79aa6927-bb6a-4e68-8a0e-08948fead14a', 0, 'Please check the examination details below before entering your candidate information
Candidate surname | Other names
Centre Number | Candidate Number
