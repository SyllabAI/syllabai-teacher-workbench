mathrm {C l} _ {2} + 2 \\mathrm {e} ^ {-}", "latex": "2 \\mathrm {C l} ^ {-} \\rightarrow \\mathrm {C l} _ {2} + 2 \\mathrm {e} ^ {-}", "confidence": 1.0, "element_id": "e000075", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 75, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "2 \\mathrm {H} ^ {+} + 2 \\mathrm {e} ^ {-} \\rightarrow \\mathrm {H} _ {2}", "latex": "2 \\mathrm {H} ^ {+} + 2 \\mathrm {e} ^ {-} \\rightarrow \\mathrm {H} _ {2}", "confidence": 1.0, "element_id": "e000077", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 77, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {C H} _ {3} \\mathrm {O H} +", "latex": "\\mathrm {C H} _ {3} \\mathrm {O H} +", "confidence": 1.0, "element_id": "e000091", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 91, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "2 \\mathrm {H} _ {2} \\mathrm {O} _ {2} \\rightarrow 2 \\mathrm {H} _ {2} \\mathrm {O} + \\mathrm {O} _ {2}", "latex": "2 \\mathrm {H} _ {2} \\mathrm {O} _ {2} \\rightarrow 2 \\mathrm {H} _ {2} \\mathrm {O} + \\mathrm {O} _ {2}", "confidence": 1.0, "element_id": "e000095", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 95, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "2 \\mathrm {H} - \\mathrm {O} - \\mathrm {O} - \\mathrm {H} \\rightarrow 2 \\mathrm {H} - \\mathrm {O} - \\mathrm {H} + \\mathrm {O} = \\mathrm {O} \\quad \\Delta H = - 2 0 4 \\mathrm {k J}", "latex": "2 \\mathrm {H} - \\mathrm {O} - \\mathrm {O} - \\mathrm {H} \\rightarrow 2 \\mathrm {H} - \\mathrm {O} - \\mathrm {H} + \\mathrm {O} = \\mathrm {O} \\quad \\Delta H = - 2 0 4 \\mathrm {k J}", "confidence": 1.0, "element_id": "e000109", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 109, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "2 \\mathrm {K O H} + \\mathrm {H} _ {2} \\mathrm {S O} _ {4} \\rightarrow \\mathrm {K} _ {2} \\mathrm {S O} _ {4} + 2 \\mathrm {H} _ {2} \\mathrm {O}", "latex": "2 \\mathrm {K O H} + \\mathrm {H} _ {2} \\mathrm {S O} _ {4} \\rightarrow \\mathrm {K} _ {2} \\mathrm {S O} _ {4} + 2 \\mathrm {H} _ {2} \\mathrm {O}", "confidence": 1.0, "element_id": "e000132", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 132, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {a m o u n t o f K O H} =", "latex": "\\mathrm {a m o u n t o f K O H} =", "confidence": 1.0, "element_id": "e000134", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 134, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {H} _ {2} \\mathrm {S O} _ {4} =", "latex": "\\mathrm {H} _ {2} \\mathrm {S O} _ {4} =", "confidence": 1.0, "element_id": "e000136", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 136, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {m o l / d m ^ {3}}", "latex": "\\mathrm {m o l / d m ^ {3}}", "confidence": 1.0, "element_id": "e000138", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 138, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {a m o u n t o f h y d r o c a r b o n X =}", "latex": "\\mathrm {a m o u n t o f h y d r o c a r b o n X =}", "confidence": 1.0, "element_id": "e000141", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 141, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {N} _ {2} (\\mathrm {g}) + 3 \\mathrm {H} _ {2} (\\mathrm {g}) \\rightleftharpoons 2 \\mathrm {N H} _ {3} (\\mathrm {g})", "latex": "\\mathrm {N} _ {2} (\\mathrm {g}) + 3 \\mathrm {H} _ {2} (\\mathrm {g}) \\rightleftharpoons 2 \\mathrm {N H} _ {3} (\\mathrm {g})", "confidence": 1.0, "element_id": "e000153", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 153, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "pageCount": 1, "documentId": "a28db1ae-5b9d-5447-a1ea-2f696e12ad99", "provenance": {"engine": "glm-ocr-markdown", "application": "syllabai-parser", "extractedAt": "2026-09-13T13:01:07.316508216Z", "engineVersion": "1.1.0", "schemaVersion": "1.0", "extractionParams": {"pageBoundaries": "none-in-source", "sourceLineCount": 215, "upstreamConverter": "zai-glm-ocr", "entityDecodedLines": 0, "signedUrlFigureRefs": 0, "normalizedHtmlEntities": true}}, "textBlocks": [{"role": "heading", "text": "Instructions", "confidence": 1.0, "element_id": "e000001", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 1, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Use black ink or ball-point pen.", "confidence": 1.0, "element_id": "e000002", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 2, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Fill in the boxes at the top of this page with your name, centre number and candidate number.", "confidence": 1.0, "element_id": "e000003", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 3, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer all questions.", "confidence": 1.0, "element_id": "e000004", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 4, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer the questions in the spaces provided", "confidence": 1.0, "element_id": "e000005", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 5, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "there may be more space than you need.", "confidence": 1.0, "element_id": "e000006", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 6, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Show all the steps in any calculations and state the units.", "confidence": 1.0, "element_id": "e000007", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 7, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Some questions must be answered with a cross in a box . If you change your mind about an answer, put a line through the box and then mark your new answer with a cross.", "confidence": 1.0, "element_id": "e000008", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 8, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Information", "confidence": 1.0, "element_id": "e000009", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 9, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The total mark for this paper is 70.", "confidence": 1.0, "element_id": "e000010", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 10, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The marks for each question are shown in brackets", "confidence": 1.0, "element_id": "e000011", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 11, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "use this as a guide as to how much time to spend on each question.", "confidence": 1.0, "element_id": "e000012", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 12, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Advice", "confidence": 1.0, "element_id": "e000013", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 13, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Read each question carefully before you start to answer it.", "confidence": 1.0, "element_id": "e000014", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 14, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Write your answers neatly and in good English.", "confidence": 1.0, "element_id": "e000015", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 15, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Try to answer every question.", "confidence": 1.0, "element_id": "e000016", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 16, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Check your answers if you have time at the end.", "confidence": 1.0, "element_id": "e000017", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 17, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Turn over", "confidence": 1.0, "element_id": "e000018", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 18, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The lanthanoids (atomic numbers 58-71) and the actinoids (atomic numbers 90-103) have been omitted. The relative atomic masses of copper and chlorine have not been rounded to the nearest whole number.", "confidence": 1.0, "element_id": "e000020", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 20, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Answer ALL questions.", "confidence": 1.0, "element_id": "e000021", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 21, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "1 Substances can exist as solids, liquids or gases.", "confidence": 1.0, "element_id": "e000022", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 22, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) (i) Give the change of state that occurs when a substance melts.", "confidence": 1.0, "element_id": "e000023", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 23, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Complete the word equation for the sublimation of iodine.", "confidence": 1.0, "element_id": "e000024", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 24, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "iodine (s) $ \\rightarrow $ iodine (...)", "confidence": 1.0, "element_id": "e000025", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 25, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The circle in the diagram represents a particle.", "confidence": 1.0, "element_id": "e000026", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 26, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Complete the diagram to show the arrangement of particles in a gas.", "confidence": 1.0, "element_id": "e000027", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 27, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) The table lists some statements about particles.", "confidence": 1.0, "element_id": "e000029", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 29, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Place ticks ( $ \\checkmark $ ) in boxes to show which two statements are correct for water particles.", "confidence": 1.0, "element_id": "e000030", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 30, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "2 This question is about elements in Group 7 and their compounds. The table gives information about some of these elements.", "confidence": 1.0, "element_id": "e000032", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 32, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) (i) Predict the colour of fluorine at room temperature.", "confidence": 1.0, "element_id": "e000034", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 34, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) How many of the elements in the table are liquids at room temperature (20 $ ^{\\circ} \\mathrm{C} $)?", "confidence": 1.0, "element_id": "e000035", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 35, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(1)", "confidence": 1.0, "element_id": "e000036", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 36, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A 0", "confidence": 1.0, "element_id": "e000037", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 37, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B 1", "confidence": 1.0, "element_id": "e000038", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 38, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C 2", "confidence": 1.0, "element_id": "e000039", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 39, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D 3", "confidence": 1.0, "element_id": "e000040", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 40, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) The element astatine is below iodine in Group 7. Predict the formula of a molecule of astatine.", "confidence": 1.0, "element_id": "e000041", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 41, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Sea water contains bromide ions.", "confidence": 1.0, "element_id": "e000042", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 42, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Bromine can be obtained by bubbling chlorine through a sample of sea water.", "confidence": 1.0, "element_id": "e000043", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 43, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The ionic equation for the reaction is", "confidence": 1.0, "element_id": "e000044", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 44, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Explain which species acts as an oxidising agent in this reaction.", "confidence": 1.0, "element_id": "e000046", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 46, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The reaction occurs because chlorine is more reactive than bromine. Bromine is below chlorine in Group 7. Explain the decrease in reactivity from chlorine to bromine.", "confidence": 1.0, "element_id": "e000047", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 47, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Elements in Group 7 react with elements in Group 1 to form ionic compounds. Which pair of ions both have the electronic configuration 2.8.8?", "confidence": 1.0, "element_id": "e000048", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 48, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A $ \\mathrm{L i^{+} a n d C l^{-}} $", "confidence": 1.0, "element_id": "e000049", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 49, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B $ \\mathrm{K^{+} a n d F^{-}} $", "confidence": 1.0, "element_id": "e000050", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 50, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C $ \\mathrm{L i^{+} a n d F^{-}} $", "confidence": 1.0, "element_id": "e000051", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 51, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D $ \\mathrm{K^{+} a n d C l^{-}} $", "confidence": 1.0, "element_id": "e000052", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 52, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 2 = 9 marks)", "confidence": 1.0, "element_id": "e000053", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 53, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "3 (a) Explain why metals conduct electricity but covalent compounds do not conduct electricity.", "confidence": 1.0, "element_id": "e000054", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 54, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Hydrogen chloride, HCl, is a covalent substance.", "confidence": 1.0, "element_id": "e000055", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 55, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "When hydrogen chloride is added to water, a solution of dilute hydrochloric acid is formed.", "confidence": 1.0, "element_id": "e000056", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 56, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "This solution does conduct electricity.", "confidence": 1.0, "element_id": "e000057", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 57, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Name the type of particle in the solution of the dilute hydrochloric acid that allows it to conduct electricity.", "confidence": 1.0, "element_id": "e000058", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 58, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) The teacher uses this apparatus to investigate the electrolysis of a solution of dilute hydrochloric acid.", "confidence": 1.0, "element_id": "e000059", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 59, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The ammeter measures the current.", "confidence": 1.0, "element_id": "e000060", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 60, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The teacher wants to find out if there is a relationship between current and volume of gas collected at each electrode.", "confidence": 1.0, "element_id": "e000062", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 62, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "After 5 minutes she records the volume of gas collected in syringe X and syringe Y.", "confidence": 1.0, "element_id": "e000063", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 63, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "She adjusts the power supply until the current is 0.1 amp.", "confidence": 1.0, "element_id": "e000064", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 64, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The teacher repeats the experiment several times, using a different current each time.", "confidence": 1.0, "element_id": "e000065", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 65, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The table gives the teacher''s results for syringe Y.", "confidence": 1.0, "element_id": "e000066", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 66, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Plot the results for syringe Y.", "confidence": 1.0, "element_id": "e000068", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 68, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Draw a circle around the anomalous result.", "confidence": 1.0, "element_id": "e000069", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 69, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Draw a line of best fit.", "confidence": 1.0, "element_id": "e000070", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 70, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iv) Explain a possible cause of the anomalous result, other than misreading the apparatus.", "confidence": 1.0, "element_id": "e000072", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 72, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(v) Deduce the relationship between current and volume of gas collected in syringe Y.", "confidence": 1.0, "element_id": "e000073", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 73, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) The ionic half-equation for the reaction that produces the gas in syringe X is", "confidence": 1.0, "element_id": "e000074", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 74, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The ionic half-equation for the reaction that produces the gas in syringe Y is", "confidence": 1.0, "element_id": "e000076", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 76, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Suggest how these ionic half-equations show that the volume of chlorine collected in syringe X should be the same as the volume of hydrogen collected in syringe Y.", "confidence": 1.0, "element_id": "e000078", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 78, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Suggest why the volume of chlorine collected in syringe X is always less than the volume of hydrogen collected in syringe Y.", "confidence": 1.0, "element_id": "e000079", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 79, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 3 = 13 marks)", "confidence": 1.0, "element_id": "e000080", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 80, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "4 This question is about alcohols, carboxylic acids and esters.", "confidence": 1.0, "element_id": "e000081", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 81, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) The table gives information about some alcohols.", "confidence": 1.0, "element_id": "e000082", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 82, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Complete the table by giving the missing information.", "confidence": 1.0, "element_id": "e000084", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 84, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Ethanol can be oxidised to ethanoic acid by heating with potassium dichromate(VI) and another reagent.", "confidence": 1.0, "element_id": "e000085", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 85, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Name the other reagent.", "confidence": 1.0, "element_id": "e000086", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 86, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) State the colour change that occurs during this reaction.", "confidence": 1.0, "element_id": "e000087", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 87, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Alcohols react with carboxylic acids to form esters.", "confidence": 1.0, "element_id": "e000088", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 88, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Name the ester that forms when ethanol reacts with ethanoic acid.", "confidence": 1.0, "element_id": "e000089", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 89, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Complete the equation for the reaction between methanol and ethanoic acid.", "confidence": 1.0, "element_id": "e000090", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 90, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 4 = 7 marks)", "confidence": 1.0, "element_id": "e000092", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 92, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "5 Hydrogen peroxide solution decomposes slowly at room temperature to form water and oxygen.", "confidence": 1.0, "element_id": "e000093", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 93, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The equation for the reaction is", "confidence": 1.0, "element_id": "e000094", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 94, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) A catalyst increases the rate of this reaction.", "confidence": 1.0, "element_id": "e000096", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 96, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "State one other property of a catalyst.", "confidence": 1.0, "element_id": "e000097", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 97, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) A student has samples of three solids, X, Y and Z.", "confidence": 1.0, "element_id": "e000098", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 98, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The student uses this apparatus to find out which solids act as catalysts in the decomposition of hydrogen peroxide solution.", "confidence": 1.0, "element_id": "e000099", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 99, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Describe the method that the student should use to find out which solids act as catalysts.", "confidence": 1.0, "element_id": "e000101", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 101, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) The decomposition of hydrogen peroxide solution is exothermic.", "confidence": 1.0, "element_id": "e000102", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 102, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "On the diagram, draw and label the reaction profiles for the reaction", "confidence": 1.0, "element_id": "e000103", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 103, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "without a catalyst", "confidence": 1.0, "element_id": "e000104", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 104, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "with a catalyst", "confidence": 1.0, "element_id": "e000105", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 105, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Progress of the reaction", "confidence": 1.0, "element_id": "e000107", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 107, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) The equation for the reaction can be shown using displayed formulae.", "confidence": 1.0, "element_id": "e000108", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 108, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The table gives the bond energies for two of the bonds.", "confidence": 1.0, "element_id": "e000110", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 110, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Use this information to calculate the total amount of energy needed to break all the bonds in two moles of $ \\mathrm{H_{2}O_{2}} $", "confidence": 1.0, "element_id": "e000112", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 112, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Use this information to calculate the total amount of energy released when all the bonds in two moles of $ \\mathrm{H_{2}O} $ are formed.", "confidence": 1.0, "element_id": "e000113", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 113, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Use the value of $ \\Delta H $ and your answers for (i) and (ii) to calculate the bond energy, in kJ/mol, for the O=O bond.", "confidence": 1.0, "element_id": "e000114", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 114, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "6 A student does a titration using dilute sulfuric acid to find the concentration of a solution of potassium hydroxide.", "confidence": 1.0, "element_id": "e000115", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 115, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The student adds $ 2 5. 0 \\mathrm{c m}^{3} $ of the potassium hydroxide solution to a conical flask. He then adds a few drops of methyl orange indicator.", "confidence": 1.0, "element_id": "e000116", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 116, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The student does the titration four times.", "confidence": 1.0, "element_id": "e000117", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 117, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) (i) Name the piece of apparatus the student should use to add the potassium hydroxide solution.", "confidence": 1.0, "element_id": "e000118", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 118, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) What is the colour of methyl orange in an alkaline solution?", "confidence": 1.0, "element_id": "e000119", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 119, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A blue", "confidence": 1.0, "element_id": "e000120", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 120, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B orange", "confidence": 1.0, "element_id": "e000121", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 121, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "red C", "confidence": 1.0, "element_id": "e000122", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 122, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D yellow", "confidence": 1.0, "element_id": "e000123", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 123, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The table shows the student''s results.", "confidence": 1.0, "element_id": "e000124", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 124, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Concordant results are those within $ 0. 2 0 \\mathrm{c m}^{3} $ of each other.", "confidence": 1.0, "element_id": "e000126", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 126, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Place ticks ( $ \\surd $ ) in the table to show which results are concordant.", "confidence": 1.0, "element_id": "e000127", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 127, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Use the concordant results to calculate the mean (average) volume of acid added.", "confidence": 1.0, "element_id": "e000128", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 128, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) This table shows the student''s results for another titration.", "confidence": 1.0, "element_id": "e000129", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 129, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The equation for the reaction is", "confidence": 1.0, "element_id": "e000131", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 131, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Calculate the amount, in moles, of KOH in $ 2 5. 0 \\mathrm{c m}^{3} $ of the potassium hydroxide solution.", "confidence": 1.0, "element_id": "e000133", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 133, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Calculate the amount, in moles, of $ \\mathrm{H_{2} S O_{4}} $ in $ 2 1. 2 0 \\mathrm{c m}^{3} $ of sulfuric acid.", "confidence": 1.0, "element_id": "e000135", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 135, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Calculate the concentration, in mol/dm $ ^{3} $ , of the sulfuric acid.", "confidence": 1.0, "element_id": "e000137", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 137, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "7 A sample of a gaseous hydrocarbon, X, has a volume of $ 6 0 0 \\mathrm{c m}^{3} $ at room temperature and pressure (rtp).", "confidence": 1.0, "element_id": "e000139", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 139, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Calculate the amount, in moles, of hydrocarbon X in the sample. [molar volume of a gas = 24000 $ cm^{3} $ at rtp]", "confidence": 1.0, "element_id": "e000140", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 140, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The mass of the sample of hydrocarbon X is 1.45 g. Show that the relative molecular mass $ ( M_{r} ) $ of X is 58", "confidence": 1.0, "element_id": "e000142", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 142, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Hydrocarbon X is an alkane.", "confidence": 1.0, "element_id": "e000143", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 143, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Show that the molecular formula of X is $ C_{4} H_{1 0} $", "confidence": 1.0, "element_id": "e000144", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 144, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) Give the displayed formula of the branched-chain isomer of hydrocarbon X.", "confidence": 1.0, "element_id": "e000145", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 145, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000146", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 146, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "8 This question is about ammonia gas, $ \\mathrm{N H_{3}} $", "confidence": 1.0, "element_id": "e000147", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 147, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Ammonia can be prepared in a laboratory from the reaction between ammonium chloride, $ \\mathrm{N H_{4} C l} $ , and sodium hydroxide. The other products of the reaction are sodium chloride and water.", "confidence": 1.0, "element_id": "e000148", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 148, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Give a chemical equation for this reaction.", "confidence": 1.0, "element_id": "e000149", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 149, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Give a test for ammonia gas.", "confidence": 1.0, "element_id": "e000150", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 150, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) In industry, ammonia is produced from nitrogen and hydrogen.", "confidence": 1.0, "element_id": "e000151", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 151, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The equation for this reaction is", "confidence": 1.0, "element_id": "e000152", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 152, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "In a sealed container, the reaction can reach a position of dynamic equilibrium.", "confidence": 1.0, "element_id": "e000154", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 154, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Explain the meaning of the term dynamic equilibrium.", "confidence": 1.0, "element_id": "e000155", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 155, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) The graph shows the percentage yield of ammonia at equilibrium for different temperatures and pressures.", "confidence": 1.0, "element_id": "e000156", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 156, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Percentage yield of ammonia at equilibrium", "confidence": 1.0, "element_id": "e000157", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 157, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Using the graph, explain if the forward reaction is exothermic or endothermic.", "confidence": 1.0, "element_id": "e000159", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 159, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 8 = 7 marks)", "confidence": 1.0, "element_id": "e000160", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 160, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(TOTAL FOR PAPER = 70 MARKS)", "confidence": 1.0, "element_id": "e000161", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 161, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000162", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 162, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000163", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 163, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000164", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 164, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "schemaVersion": "1.0"}', NULL, '2026-09-13 13:01:26.364974+00');
INSERT INTO public.documents VALUES ('bbf213ec-1e31-4e9a-9e0a-9720d19b36f2', '8d9ae32d-e64f-5731-b5c6-b39402e78c85', '1.0', 1, 'MARK_SCHEME', 'corpus/igcse-chemistry-4ch0-2c-2021janr/MS.md', 'MS.md', 'text/markdown', 'fdfa109ccff957a9ad67c4cbb52750d69c03448aeef4693793c5967fee72933f', 'SHA-256', 1, 39, 39, 12, 'glm-ocr-markdown', '1.1.0', '2026-09-13 13:01:07.380389+00', '{"pages": [{"width": null, "height": null, "pageNumber": 1}], "source": {"uri": "corpus/igcse-chemistry-4ch0-2c-2021janr/MS.md", "checksum": "fdfa109ccff957a9ad67c4cbb52750d69c03448aeef4693793c5967fee72933f", "fileName": "MS.md", "mimeType": "text/markdown", "checksumAlgorithm": "SHA-256"}, "tables": [{"rows": [["Question number", "Answer", "Notes", "Marks"], ["1(a)(i)", "(from) solid to liquid", "", "1"], ["(ii)", "iodine(s)→iodine(g)", "", "1"], ["(b)", "(diagram showing) particles well spread out with none touching", "", "1"], ["(c)", "", "", "2"], ["", "Statement", "Tick", "", ""], ["", "the particles only vibrate", "", "", ""], ["", "the particles do not move", "", "", ""], ["", "the particles have no gaps between them", "", "", ""], ["", "the particles move randomly", "√", "", ""], ["", "the particles have more energy than in ice", "√", "", ""], ["", "the particles have a regular arrangement", "", "", ""], ["", "tick in 4th box(1)\ntick in 5th box(1)\nif more than two ticks deduct 1 mark for each incorrect tick", "", ""]], "text": "Question number | Answer | Notes | Marks\n1(a)(i) | (from) solid to liquid |  | 1\n(ii) | iodine(s)→iodine(g) |  | 1\n(b) | (diagram showing) particles well spread out with none touching |  | 1\n(c) |  |  | 2\n | Statement | Tick |  | \n | the particles only vibrate |  |  | \n | the particles do not move |  |  | \n | the particles have no gaps between them |  |  | \n | the particles move randomly | √ |  | \n | the particles have more energy than in ice | √ |  | \n | the particles have a regular arrangement |  |  | \n | tick in 4th box(1)\ntick in 5th box(1)\nif more than two ticks deduct 1 mark for each incorrect tick |  | ", "row_count": 13, "confidence": 1.0, "element_id": "e000018", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 18, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["2(a)(i)", "(pale/light) yellow", "", "1"], ["(ii)", "The correct answer isB1as bromine is the only liquid at room temperature(20℃)", "", "1"], ["", "A0is incorrect because bromine is a liquid at room temperature(20℃)", "", ""], ["", "C2is incorrect because bromine is the only liquid at room temperature(20℃)", "", ""], ["(iii)", "At2", "", "1"], ["(b)(i)", "explanation includingM1oxidising agent ischlorine/Cl2M2because chlorine/Cl2gains electron(s)/is reduced", "ACCEPT because bromide ions/Br-lose electrons/are oxidisedREJECT bromine ionsM2DEP M1correct or missing", ""]], "text": "Question number | Answer | Notes | Marks\n2(a)(i) | (pale/light) yellow |  | 1\n(ii) | The correct answer isB1as bromine is the only liquid at room temperature(20℃) |  | 1\n | A0is incorrect because bromine is a liquid at room temperature(20℃) |  | \n | C2is incorrect because bromine is the only liquid at room temperature(20℃) |  | \n(iii) | At2 |  | 1\n(b)(i) | explanation includingM1oxidising agent ischlorine/Cl2M2because chlorine/Cl2gains electron(s)/is reduced | ACCEPT because bromide ions/Br-lose electrons/are oxidisedREJECT bromine ionsM2DEP M1correct or missing | ", "row_count": 7, "confidence": 1.0, "element_id": "e000020", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 20, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["2(b)(ii)", "explanation containing three of following pointsM1 bromine and chlorine react by gaining electron/forming 1- or negative ionM2 bromine atom larger (than chlorine atom)M3 bromine (atom) has smaller/weaker attraction (from nucleus) for (outer shell) electrons (than chlorine) OWTTEM4 so (bromine has) less tendency to gain electron/form negative ion (so less reactive than chlorine) OWTTE", "ALLOW bromine has larger atomic radiusALLOW bromine outer (electron) shell further from nucleusALLOW bromine atom has more (electron) shells (than chlorine)ALLOW reverse argument for chlorine in M2 M3 M4", "3"], ["(c)", "The correct answer is D K+ and Cl- because both have electronic configuration of 2.8.8A is not correct because Li+ does not have electronic configuration of 2.8.8B is not correct because F- does not have electronic configuration of 2.8.8C is not correct because neither Li+ nor F- have electronic configuration of 2.8.8", "", "1"]], "text": "Question number | Answer | Notes | Marks\n2(b)(ii) | explanation containing three of following pointsM1 bromine and chlorine react by gaining electron/forming 1- or negative ionM2 bromine atom larger (than chlorine atom)M3 bromine (atom) has smaller/weaker attraction (from nucleus) for (outer shell) electrons (than chlorine) OWTTEM4 so (bromine has) less tendency to gain electron/form negative ion (so less reactive than chlorine) OWTTE | ALLOW bromine has larger atomic radiusALLOW bromine outer (electron) shell further from nucleusALLOW bromine atom has more (electron) shells (than chlorine)ALLOW reverse argument for chlorine in M2 M3 M4 | 3\n(c) | The correct answer is D K+ and Cl- because both have electronic configuration of 2.8.8A is not correct because Li+ does not have electronic configuration of 2.8.8B is not correct because F- does not have electronic configuration of 2.8.8C is not correct because neither Li+ nor F- have electronic configuration of 2.8.8 |  | 1", "row_count": 3, "confidence": 1.0, "element_id": "e000021", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 21, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["", "Question number", "Answer", "Notes", "Marks"], ["3", "(a)", "Explanation including the following points:", "", "4"], ["(metals)", "", ""], ["M1 contain delocalised electrons", "IGNORE free electrons/sea of electrons", ""], ["M2 (which) move/flow/are mobile/are free to move (through the metal structure)", "M2 dependent on mention of electrons If any mention of ions/atoms moving cannot score M1 M2", ""], ["and two from (covalent compounds)", "", ""], ["M3 contain neutral molecules / molecules with no overall charge", "ALLOW do not contain ions", ""], ["M4 electrons held (tightly) in covalent bonds (so)", "ALLOW there are no delocalised electrons", ""], ["M5 no electrons free to move (so do not conduct)", "If state ions present cannot score M3 M4 M5", ""], ["(b)", "ion(s)", "ALLOW hydrogen ion/H+ ALLOW chloride ion/Cl-", "1"], ["(c)", "(i)", "all points plotted correctly (within half a small square)", "", "1"], ["(ii)", "point at (0.4,25) circled", "", "1"], ["(iii)", "straight line of best fit through origin drawn with ruler", "", "1"], ["(iv)", "explanation linking", "", "2"], ["", "M1 the volume/reading is less than expected", "", ""], ["", "M2 because the current was less than 0.4A / some gas escaped/ there was a leak", "ALLOW reading taken before 5 minutes", ""], ["", "(v)", "the greater the current the greater the volume (of gas)", "ACCEPT directly proportional ACCEPT positive correlation", "1"]], "text": " | Question number | Answer | Notes | Marks\n3 | (a) | Explanation including the following points: |  | 4\n(metals) |  | \nM1 contain delocalised electrons | IGNORE free electrons/sea of electrons | \nM2 (which) move/flow/are mobile/are free to move (through the metal structure) | M2 dependent on mention of electrons If any mention of ions/atoms moving cannot score M1 M2 | \nand two from (covalent compounds) |  | \nM3 contain neutral molecules / molecules with no overall charge | ALLOW do not contain ions | \nM4 electrons held (tightly) in covalent bonds (so) | ALLOW there are no delocalised electrons | \nM5 no electrons free to move (so do not conduct) | If state ions present cannot score M3 M4 M5 | \n(b) | ion(s) | ALLOW hydrogen ion/H+ ALLOW chloride ion/Cl- | 1\n(c) | (i) | all points plotted correctly (within half a small square) |  | 1\n(ii) | point at (0.4,25) circled |  | 1\n(iii) | straight line of best fit through origin drawn with ruler |  | 1\n(iv) | explanation linking |  | 2\n | M1 the volume/reading is less than expected |  | \n | M2 because the current was less than 0.4A / some gas escaped/ there was a leak | ALLOW reading taken before 5 minutes | \n | (v) | the greater the current the greater the volume (of gas) | ACCEPT directly proportional ACCEPT positive correlation | 1", "row_count": 17, "confidence": 1.0, "element_id": "e000023", "page_number": 1, "bounding_box": null, "column_count": 5, "element_type": "table", "reading_order": 23, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["3(d)(i)", "(transfer of two/same number of electrons produces) one mole of chlorine/Cl2and one mole of hydrogen/H2", "ALLOW same number of moles of chlorine/Cl2and hydrogen/H2ALLOW molecules for moles", "1"], ["(ii)", "chlorine dissolves/soluble in acid/solution", "ALLOW dissolves/soluble in water", "1"]], "text": "Question number | Answer | Notes | Marks\n3(d)(i) | (transfer of two/same number of electrons produces) one mole of chlorine/Cl2and one mole of hydrogen/H2 | ALLOW same number of moles of chlorine/Cl2and hydrogen/H2ALLOW molecules for moles | 1\n(ii) | chlorine dissolves/soluble in acid/solution | ALLOW dissolves/soluble in water | 1", "row_count": 3, "confidence": 1.0, "element_id": "e000024", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 24, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["4(a)", "", "Name", "Structural formula", "Relative formula mass", "ALLOW correct names of isomersIf oxidation number given must be correctALLOWH2SO4IGNORE reference to concentration", "2"], ["methanol", "CH3OH", "32", "1"], ["ethanol", "C2H5OH", "46(1)"], ["butanol(1)", "C4H9OH", "74"], ["(b)(i)", "sulfuric acid", "", "1"], ["(ii)", "from orange to green", "1"], ["(c)(i)", "ethyl ethanoate", "ALLOW as one word", "1"], ["(ii)", "CH3OH+CH3COOH→CH3COOCH3+H2O", "ALLOW displayed formula", "2"], ["M1CH3COOHM2CH3COOCH3"]], "text": "Question number | Answer | Notes | Marks\n4(a) |  | Name | Structural formula | Relative formula mass | ALLOW correct names of isomersIf oxidation number given must be correctALLOWH2SO4IGNORE reference to concentration | 2\nmethanol | CH3OH | 32 | 1\nethanol | C2H5OH | 46(1)\nbutanol(1) | C4H9OH | 74\n(b)(i) | sulfuric acid |  | 1\n(ii) | from orange to green | 1\n(c)(i) | ethyl ethanoate | ALLOW as one word | 1\n(ii) | CH3OH+CH3COOH→CH3COOCH3+H2O | ALLOW displayed formula | 2\nM1CH3COOHM2CH3COOCH3", "row_count": 10, "confidence": 1.0, "element_id": "e000026", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 26, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["5(a)", "a catalyst is chemically unchanged at the end of the reaction", "ALLOW (provides alternative route for reaction of) lower activation energy\nALLOW not used up in reaction", "1"], ["(b)", "description including six of the following points:\nM1 do experiment using hydrogen peroxide solution only/without X/Y/Z\nM2 use known volume of hydrogen peroxide solution OWTTE\nM3 (and) measure time for certain volume of oxygen gas to be collected OR measure volume of gas collected in a certain time period OWTTE\nM4 repeat using same volume of hydrogen peroxide solution\nM5 with known mass/amount of solid X(then Y,then Z)\nM6 measure time for same volume of oxygen gas to be collected OR measure volume of gas collected in same time period(with solid/X/Y/Z present)\nM7 after reaction(remove solid/X/Y/Z by filtration and dry)find mass of solid/X/Y/Z/check if mass unchanged\nM8 reference to reduced time(for certain volume of oxygen gas to be collected)OR increased volume of gas(collected in a certain time period)meansX/Y/Z(possible)catalyst(1)", "ALLOW measure time until no more oxygen produced\nALLOW amount\nALLOW reference to increased rate", "6"]], "text": "Question number | Answer | Notes | Marks\n5(a) | a catalyst is chemically unchanged at the end of the reaction | ALLOW (provides alternative route for reaction of) lower activation energy\nALLOW not used up in reaction | 1\n(b) | description including six of the following points:\nM1 do experiment using hydrogen peroxide solution only/without X/Y/Z\nM2 use known volume of hydrogen peroxide solution OWTTE\nM3 (and) measure time for certain volume of oxygen gas to be collected OR measure volume of gas collected in a certain time period OWTTE\nM4 repeat using same volume of hydrogen peroxide solution\nM5 with known mass/amount of solid X(then Y,then Z)\nM6 measure time for same volume of oxygen gas to be collected OR measure volume of gas collected in same time period(with solid/X/Y/Z present)\nM7 after reaction(remove solid/X/Y/Z by filtration and dry)find mass of solid/X/Y/Z/check if mass unchanged\nM8 reference to reduced time(for certain volume of oxygen gas to be collected)OR increased volume of gas(collected in a certain time period)meansX/Y/Z(possible)catalyst(1) | ALLOW measure time until no more oxygen produced\nALLOW amount\nALLOW reference to increased rate | 6", "row_count": 3, "confidence": 1.0, "element_id": "e000028", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 28, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["5(c)", "M1 labelled profile curve drawn for reaction without catalystM2 labelled profile curve drawn with lower activation energy for reaction with catalyst", "must start from reactants energy level and end at products energy level", "2"], ["(d)(i)", "energy needed=[(4x463)+2(146)]=2144", "Ignore sign", "1"], ["(ii)", "energy released=[(4x463)]=1852", "ignore sign", "1"], ["(iii)", "M1 for showing equation linking between(i),(ii),O=O bond energy and△HM2 correct calculationExample:M1[1852+(O=O)]-2144=204OR(O=O)=2144-1852+204M2(O=O)=496", "Mark CSQ on(i) and(ii)-496 scores 1 mark", ""]], "text": "Question number | Answer | Notes | Marks\n5(c) | M1 labelled profile curve drawn for reaction without catalystM2 labelled profile curve drawn with lower activation energy for reaction with catalyst | must start from reactants energy level and end at products energy level | 2\n(d)(i) | energy needed=[(4x463)+2(146)]=2144 | Ignore sign | 1\n(ii) | energy released=[(4x463)]=1852 | ignore sign | 1\n(iii) | M1 for showing equation linking between(i),(ii),O=O bond energy and△HM2 correct calculationExample:M1[1852+(O=O)]-2144=204OR(O=O)=2144-1852+204M2(O=O)=496 | Mark CSQ on(i) and(ii)-496 scores 1 mark | ", "row_count": 5, "confidence": 1.0, "element_id": "e000029", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 29, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["6(a)(i)", "pipette", "ALLOW graduated pipette", "1"], ["(ii)", "The correct answer isD yellow because methyl orange is yellow in alkaline solutionA is incorrect because methyl orange is not blue in alkaline solutionB is incorrect because methyl orange is not orange in alkaline solutionC is incorrect because methyl orange is not red in alkaline solution", "", "1"], ["(b)(i)", "ticks under titration numbers1,2and4", "", "1"], ["", "1", "2", "3", "4", "", ""], ["", "20.65", "20.60", "20.90", "20.55", "", ""], ["", "√", "√", "", "√", "", ""], ["(ii)", "M1(20.65+20.60+20.55)=3M220.60", "M1 CSQ on results tickedM2 CSQ on correct calculation from M1Answer to M2 must be correct to 2dp20.60 without working scores220.6 with or without working scores1If no ticks then only use of 2 or 3 concordant titres can score M1 and M2 in(ii)If only one tick then M2 can be scored for averaging two or more titre values correctly", "2"]], "text": "Question number | Answer | Notes | Marks\n6(a)(i) | pipette | ALLOW graduated pipette | 1\n(ii) | The correct answer isD yellow because methyl orange is yellow in alkaline solutionA is incorrect because methyl orange is not blue in alkaline solutionB is incorrect because methyl orange is not orange in alkaline solutionC is incorrect because methyl orange is not red in alkaline solution |  | 1\n(b)(i) | ticks under titration numbers1,2and4 |  | 1\n | 1 | 2 | 3 | 4 |  | \n | 20.65 | 20.60 | 20.90 | 20.55 |  | \n | √ | √ |  | √ |  | \n(ii) | M1(20.65+20.60+20.55)=3M220.60 | M1 CSQ on results tickedM2 CSQ on correct calculation from M1Answer to M2 must be correct to 2dp20.60 without working scores220.6 with or without working scores1If no ticks then only use of 2 or 3 concordant titres can score M1 and M2 in(ii)If only one tick then M2 can be scored for averaging two or more titre values correctly | 2", "row_count": 8, "confidence": 1.0, "element_id": "e000031", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 31, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["6(c)(i)", "M1 mol(KOH)=0.0370x251000", "", "2"], ["M2=9.25x10-4/0.000925", "ALLOW any number of sig fig except oneIf no division by 1000 giving answer of0.925 award 1 markcorrect answer with no working scores2", ""], ["M2 from(i) divided by2expected answer4.625x10-4/0.0004625", "ALLOW any number of sig fig except one", "