INSERT INTO public.document_chunks VALUES ('2c222e5b-902e-4fa8-a2b1-8ff960ea7f93', 'ac8055f3-157b-49a8-987d-93d1e8a76016', 10, '(d) The structural formula of chloroethene formed in process 3 is $ \mathrm{C H_{2}=C H C I} $ The polymer formed in process 4 is poly(chloroethene). Draw the displayed formula for the repeat unit of poly(chloroethene).
