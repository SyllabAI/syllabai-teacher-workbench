INSERT INTO public.questions VALUES ('98823a78-dd67-464c-8c02-c4ecce5a679e', 'q06-04d61f97', 'STRUCTURED', 'The reactions of metals with water and with dilute sulfuric acid can be used to determine the order of reactivity of the metals. The table shows the reactions of four metals, W, X, Y and Z, with water and with dilute sulfuric acid.', 5, 3, 450, NULL, '2c556132-d50b-41a4-9055-4463642425fe', 'PAST_PAPER', true, 1, '2026-09-13 12:54:39.972447+00', '7ab57098-d6bb-4b23-a2e7-f0d46c890c45');
