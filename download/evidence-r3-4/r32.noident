INSERT INTO public.question_parts VALUES ('2f30c1c3-fd07-41ab-8667-dff737c0738f', '4adb29d7-ba06-4996-bd13-8434fce101d5', 'a', 'Complete the diagram to show how the molecules of water are arranged in the solid state.', NULL, 0, 0, '2026-09-13 12:53:55.674898+00');
INSERT INTO public.question_parts VALUES ('e11b6390-d645-4d67-911d-f9630e748e1e', '4adb29d7-ba06-4996-bd13-8434fce101d5', 'b', 'Which row of the table correctly describes the arrangement and movement of molecules of water in the solid state? A B D C', NULL, 0, 1, '2026-09-13 12:53:55.674972+00');
