INSERT INTO public.question_parts VALUES ('e5e0e789-c054-4b2e-8e88-95d7b9034947', '2f625240-50a1-4061-9e28-6884516ed4ef', 'c-i', 'Plot these results on the grid. Draw a straight line of best fit through the first four points, and another straight line of best fit through the last three points. Extend both lines so that they cross each other. Temperature in $ ^{\circ} \mathrm{C} $', NULL, 0, 3, '2026-09-13 12:53:12.066484+00');
INSERT INTO public.question_parts VALUES ('23b78081-46a9-4ad2-ab95-7ed90f75cc10', '2f625240-50a1-4061-9e28-6884516ed4ef', 'c-ii', 'For the point where the lines cross, write down $\mathrm {t h e t a m e r a t u r e o f t h e m i x t u r e} = \dots \dots$', NULL, 0, 4, '2026-09-13 12:53:12.066488+00');
INSERT INTO public.question_parts VALUES ('b97c11a3-2b53-4883-a38c-6062ccbb22f2', '2f625240-50a1-4061-9e28-6884516ed4ef', 'd', 'In a similar experiment, using a different acid and alkali, the student records these results. volume of dilute sulfuric acid = 25.0 $ cm^{3} $ volume of aqueous potassium hydroxide = 22.7 $ cm^{3} $ initial temperature of each solution = 18.9 $ ^{\circ} C $ final temperature of mixture = 24.7 $ ^{\circ} C $ Calculate the heat energy change during this reaction using this equation. heat energy change = mass $ \times $ 4.2 $ \times $ temperature change Assume that 1.0 $ cm^{3} $ of each solution has a mass of 1.0 g.', NULL, 0, 5, '2026-09-13 12:53:12.066494+00');
INSERT INTO public.question_parts VALUES ('15eb5a1d-2dea-4b6c-b9eb-c0a58964003f', '3a36d8fa-685b-4379-9769-fb47c55ae6f5', 'a', 'The equation for the reaction is $\mathrm {N a} _ {2} \mathrm {S} _ {2} \mathrm {O} _ {3} (\mathrm {a q}) + 2 \mathrm {H C l} (\mathrm {a q}) \rightarrow 2 \mathrm {N a C l} (\mathrm {a q}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {I}) + \mathrm {S} (\mathrm {s}) + \mathrm {S O} _ {2} (\mathrm {g})$ Before starting her experiments, the student considers the risk to her of sulfur dioxide escaping from the flask. She uses this information. concentration of sodium thiosulfate solution = 0.300 mol/dm $ ^{3} $ volume of sodium thiosulfate solution = 20 $ cm^{3} $ volume of water = 20 $ cm^{3} $ volume of hydrochloric acid = 10 $ cm^{3} $', NULL, 0, 0, '2026-09-13 12:53:12.066499+00');
INSERT INTO public.question_parts VALUES ('e8388e1c-7a56-48fe-989d-744c47654468', '3a36d8fa-685b-4379-9769-fb47c55ae6f5', 'a-i', 'Calculate the mass of sulfur dioxide formed in this experiment. The hydrochloric acid is in excess.', NULL, 0, 1, '2026-09-13 12:53:12.066507+00');
INSERT INTO public.question_parts VALUES ('9a20cf33-238f-4a8a-9877-49ca32e4f64a', '3a36d8fa-685b-4379-9769-fb47c55ae6f5', 'a-ii', 'The solubility of sulfur dioxide at room temperature is $ 1 0 0 \mathrm{~ g / d m^{3}} $ Use this additional information to explain whether any sulfur dioxide gas escapes from the flask.', NULL, 0, 2, '2026-09-13 12:53:12.066512+00');
INSERT INTO public.question_parts VALUES ('0acdb90c-39bd-4a30-8319-6b408f4e4edb', '3a36d8fa-685b-4379-9769-fb47c55ae6f5', 'b', 'At what point in the experiment should the student have started a timer?', NULL, 0, 3, '2026-09-13 12:53:12.066516+00');
INSERT INTO public.question_parts VALUES ('6c62751c-1fda-4ea4-ad26-3cfbe08e0ede', '3a36d8fa-685b-4379-9769-fb47c55ae6f5', 'c', 'She repeats the experiment using the same volumes and concentrations of solutions, but at different temperatures. The graph shows her results.', NULL, 0, 4, '2026-09-13 12:53:12.06652+00');
INSERT INTO public.question_parts VALUES ('5ab292f5-dde4-4edf-9efb-f1ada29baa87', '3a36d8fa-685b-4379-9769-fb47c55ae6f5', 'c-i', 'The result at (14,42) is anomalous. Explain one mistake the student may have made to cause this anomalous result.', NULL, 0, 5, '2026-09-13 12:53:12.066524+00');
INSERT INTO public.question_parts VALUES ('beaae4d6-b118-432c-bcb4-8709b200ca5a', '3a36d8fa-685b-4379-9769-fb47c55ae6f5', 'c-ii', 'Use the graph to find the time taken for the $ \times $ to be no longer seen at $ 3 5 \, \mathrm{^o C} $', NULL, 0, 6, '2026-09-13 12:53:12.066528+00');
INSERT INTO public.question_parts VALUES ('7af2e97a-0e53-4918-84c0-cd88f37d2a02', '3a36d8fa-685b-4379-9769-fb47c55ae6f5', 'd', 'The student repeats the experiments using nitric acid in place of hydrochloric acid. She records the times for the x to no longer be seen, then uses the times to calculate the rate of reaction at each temperature. The graph shows the results she plots.', NULL, 0, 7, '2026-09-13 12:53:12.066533+00');
INSERT INTO public.question_parts VALUES ('2b92bd34-2b31-428a-8dac-ec5252c5dfb9', '3a36d8fa-685b-4379-9769-fb47c55ae6f5', 'd-i', 'Suggest two reasons why the results are least accurate at higher temperatures.', NULL, 2, 8, '2026-09-13 12:53:12.066537+00');
INSERT INTO public.question_parts VALUES ('7eef5191-1bd2-42cc-abc7-491a4589fe98', '3a36d8fa-685b-4379-9769-fb47c55ae6f5', 'd-ii', 'The student wrote this explanation for the shape of the graph. As the temperature increases, the rate of reaction increases. This is because there are more frequent collisions between particles of reactants. Use the particle collision theory to explain another more important reason for the increase in reaction rate.', NULL, 0, 9, '2026-09-13 12:53:12.066555+00');
INSERT INTO public.question_parts VALUES ('db7c92b2-64ad-4f46-9f83-4b17e9f6fa86', '3a36d8fa-685b-4379-9769-fb47c55ae6f5', 'e', 'Another student uses the same reaction to investigate the effect of changing the concentration of the sodium thiosulfate solution on the rate of reaction. Give three variables that the student must control in this investigation to obtain valid results.', NULL, 0, 10, '2026-09-13 12:53:12.066566+00');
INSERT INTO public.question_parts VALUES ('a87dcc5e-5a2f-4f3b-bcd3-b425973fe9d8', '405b143d-79a1-41b0-9f1f-fdffa765fe85', 'a', 'Reaction 1 occurs between steam and methane in natural gas. Balance the equation for this reaction. $\mathrm {C H} _ {4} + \mathrm {H} _ {2} \mathrm {O} \rightarrow \mathrm {C O} + \mathrm {H} _ {2}$', NULL, 0, 0, '2026-09-13 12:53:12.066573+00');
INSERT INTO public.question_parts VALUES ('3f3ab46f-4ad2-472d-8835-4c6fbb191d41', '405b143d-79a1-41b0-9f1f-fdffa765fe85', 'b', 'The equation for reaction 2 is $\mathrm {C O} (\mathrm {g}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {g}) \rightleftharpoons \mathrm {C O} _ {2} (\mathrm {g}) + \mathrm {H} _ {2} (\mathrm {g}) \quad \Delta H = - 4 1 \mathrm {k J / m o l}$', NULL, 0, 1, '2026-09-13 12:53:12.066577+00');
INSERT INTO public.question_parts VALUES ('01ee3144-e357-401b-a9b0-26768c3378fd', '405b143d-79a1-41b0-9f1f-fdffa765fe85', 'b-i', 'Assuming that this reaction reaches equilibrium, explain what happens to the yield of hydrogen if the reaction is carried out at a higher pressure but at the same temperature.', NULL, 0, 2, '2026-09-13 12:53:12.066582+00');
INSERT INTO public.question_parts VALUES ('ef4ede5f-4acc-4140-936a-52be52e607c3', '405b143d-79a1-41b0-9f1f-fdffa765fe85', 'b-ii', 'Assuming that this reaction reaches equilibrium, explain what happens to the yield of hydrogen if the reaction is carried out at a higher temperature but at the same pressure.', NULL, 0, 3, '2026-09-13 12:53:12.066586+00');
INSERT INTO public.question_parts VALUES ('f6fecbab-a9f5-4fea-b425-d85cc0244e4a', '405b143d-79a1-41b0-9f1f-fdffa765fe85', 'c', 'Reaction 2 can be represented on an energy profile.', NULL, 0, 4, '2026-09-13 12:53:12.066589+00');
INSERT INTO public.question_parts VALUES ('f4507e5c-871a-4f13-9e9f-8ac9b98e3b1c', '405b143d-79a1-41b0-9f1f-fdffa765fe85', 'c-i', 'Complete the profile by showing the products of the reaction and the enthalpy change for the reaction.', NULL, 0, 5, '2026-09-13 12:53:12.066594+00');
INSERT INTO public.question_parts VALUES ('fd1bd009-b2a6-45cc-a498-104f7dbfe5bc', '405b143d-79a1-41b0-9f1f-fdffa765fe85', 'c-ii', 'Reaction 2 is carried out using an iron oxide catalyst. State the effect, if any, of using a catalyst on the enthalpy change for the reaction.', NULL, 0, 6, '2026-09-13 12:53:12.066598+00');
INSERT INTO public.question_parts VALUES ('ffa9876e-5364-40f5-95c0-ea84727ba76b', '79ab35aa-af04-4287-a8d0-5153fd66bb42', 'a-i', 'Deduce the order of reactivity of the metals.', NULL, 0, 1, '2026-09-13 12:56:56.599718+00');
INSERT INTO public.question_parts VALUES ('300459c2-e99d-4a14-b341-7e741da19c6e', '405b143d-79a1-41b0-9f1f-fdffa765fe85', 'c-iii', 'Explain how a catalyst increases the rate of a reaction.', NULL, 0, 7, '2026-09-13 12:53:12.066602+00');
INSERT INTO public.question_parts VALUES ('69e938dc-010c-41dd-b29d-92426d2b0722', '405b143d-79a1-41b0-9f1f-fdffa765fe85', 'd', 'The equations for some other reactions used in the manufacture of ammonium nitrate are $\mathrm {r e a c t i o n} 3 \quad \mathrm {N} _ {2} + 3 \mathrm {H} _ {2} \rightleftharpoons 2 \mathrm {N H} _ {3}$ reaction 4 $4 \mathrm {N H} _ {3} + 5 \mathrm {O} _ {2} \rightleftharpoons 4 \mathrm {N O} + 6 \mathrm {H} _ {2} \mathrm {O}$ reaction 5 $2 N O _ {2} \rightleftharpoons N _ {2} O _ {4}$ reaction 6 $\mathrm {N H} _ {3} + \mathrm {H N O} _ {3} \rightarrow \mathrm {N H} _ {4} \mathrm {N O} _ {3}$ Explain which two of these are redox reactions.', NULL, 0, 8, '2026-09-13 12:53:12.066606+00');
INSERT INTO public.question_parts VALUES ('2ee1a303-0195-42b3-9dbb-6483571cd382', '405b143d-79a1-41b0-9f1f-fdffa765fe85', 'e', 'The manufacturer produces a batch of 34 kg of ammonia. Calculate the maximum mass of ammonium nitrate that can be made from this mass of ammonia, using reaction 6 in part (d). Give a unit for your answer.', NULL, 0, 9, '2026-09-13 12:53:12.066609+00');
INSERT INTO public.question_parts VALUES ('663ea330-c26b-4bb7-bade-196d3e43e251', '30abad1d-06a6-4644-a920-b0924993ee16', 'a', 'Three of the fractions obtained from fractional distillation are fuel oil, gasoline and kerosene.', NULL, 0, 0, '2026-09-13 12:53:12.066619+00');
