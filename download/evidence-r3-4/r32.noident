INSERT INTO public.question_parts VALUES ('c978b830-9d90-4fff-85a2-8ffbc7406386', 'b2c53df1-0e90-453e-8630-680143e6572a', 'a', 'The table gives some information about the halogens. Complete the table by predicting the physical state of astatine at room temperature and the colour of astatine.', NULL, 0, 0, '2026-09-13 12:55:23.885102+00');
