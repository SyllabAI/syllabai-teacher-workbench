INSERT INTO public.question_parts VALUES ('645a7998-607d-44a8-a955-852151b5bb41', 'c29220cf-1349-4745-b9ec-724ae93f9038', 'c-ii', 'Give the formula of the ion that caused the flame to be lilac.', NULL, 0, 4, '2026-09-13 12:58:26.498916+00');
INSERT INTO public.question_parts VALUES ('0324df1c-cf7e-4896-828d-462883cf69a0', 'c29220cf-1349-4745-b9ec-724ae93f9038', 'd', 'When the Group 1 elements react with water, each of their atoms loses an electron from its outer shell. For sodium and potassium, these processes can be represented by the equations $\begin{array}{l} \cdot \mathrm {N a} \rightarrow \mathrm {N a} ^ {+} + \mathrm {e} ^ {-} \\ \cdot \mathrm {K} \rightarrow \mathrm {K} ^ {+} + \mathrm {e} ^ {-} \\ \end{array}$ Explain, by referring to the electronic configurations of sodium and potassium, why potassium is more reactive than sodium.', NULL, 0, 5, '2026-09-13 12:58:26.498963+00');
INSERT INTO public.question_parts VALUES ('96418e15-7e1b-4921-90fc-d0db9cd0a8c8', '2f786e0c-d9de-4226-994f-5e74fd055ec5', 'a', 'Place ticks ( $ \surd $ ) in the columns to show which statements apply to each step. You may place a tick in one column, in both columns or in neither column. The first one has been done for you.', NULL, 0, 0, '2026-09-13 12:58:26.499013+00');
