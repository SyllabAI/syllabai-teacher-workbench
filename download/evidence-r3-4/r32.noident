INSERT INTO public.question_parts VALUES ('3b63b6fa-fc00-4d33-a26b-6e62ab886fde', '9fdce71c-4d88-4b37-b486-86f4355aca6a', 'a', 'Which metal in the table could be used to make a probe with the lowest density?', NULL, 0, 0, '2026-09-13 12:57:41.707635+00');
INSERT INTO public.question_parts VALUES ('68c2ea12-7d8c-456e-8113-a68d7da33f2f', '9fdce71c-4d88-4b37-b486-86f4355aca6a', 'a-ii', 'Why would this metal be unsuitable for making a probe to land on Venus?', NULL, 0, 1, '2026-09-13 12:57:41.707658+00');
INSERT INTO public.question_parts VALUES ('ea2ef7db-68a8-4fde-8869-af6848f90f9e', '9fdce71c-4d88-4b37-b486-86f4355aca6a', 'b', 'Very small amounts of lead can be used in electrical circuits. Why would lead not be suitable for use in the electrical circuits of a probe to land on Venus?', NULL, 0, 2, '2026-09-13 12:57:41.707677+00');
INSERT INTO public.question_parts VALUES ('c72fa583-b32f-4ca6-b742-a1fb16384ce8', '9fdce71c-4d88-4b37-b486-86f4355aca6a', 'c', 'Choose a metal from the table that would be the most suitable for making a probe to land on Venus. Give two reasons for your choice. Metal Reasons', NULL, 0, 3, '2026-09-13 12:57:41.70772+00');
INSERT INTO public.question_parts VALUES ('01d90f83-0593-468a-8f8e-6d062cc4150c', '06ad5256-a122-4104-aba4-3e80a650d924', 'a', 'State why ethene is described as unsaturated.', NULL, 0, 0, '2026-09-13 12:57:41.708768+00');
INSERT INTO public.question_parts VALUES ('02226eee-a18c-43ee-9281-ed2df7abc57c', '06ad5256-a122-4104-aba4-3e80a650d924', 'a-ii', 'Describe a chemical test to show that ethene is an alkene. Test Result', NULL, 0, 1, '2026-09-13 12:57:41.708916+00');
INSERT INTO public.question_parts VALUES ('3662953f-6a68-4b1c-8940-9df614999a43', '06ad5256-a122-4104-aba4-3e80a650d924', 'b', 'Complete the following equation that represents the preparation of ethene from ethanol. $\mathrm {C} _ {2} \mathrm {H} _ {5} \mathrm {O H} \rightarrow \mathrm {C} _ {2} \mathrm {H} _ {4} + \dots \dots \dots \dots$', NULL, 0, 2, '2026-09-13 12:57:41.708986+00');
INSERT INTO public.question_parts VALUES ('4a6def17-2e49-4005-9c8b-ddee223b66b8', '06ad5256-a122-4104-aba4-3e80a650d924', 'b-ii', 'What is the name given to this type of reaction?', NULL, 0, 3, '2026-09-13 12:57:41.709027+00');
INSERT INTO public.question_parts VALUES ('bdd9310d-23f3-43af-83dc-4962c7af4bd6', '06ad5256-a122-4104-aba4-3e80a650d924', 'c', 'Complete the equation to show the formation of poly(ethene) from ethene.', NULL, 0, 4, '2026-09-13 12:57:41.710094+00');
INSERT INTO public.question_parts VALUES ('101c0f30-5809-4d64-a559-f23a434e9107', '8d22f7f8-d2d5-47b4-8263-ce8ac6133705', 'a', 'Name two compounds that made the water hard.', NULL, 0, 0, '2026-09-13 12:57:41.710657+00');
INSERT INTO public.question_parts VALUES ('c77e085c-e78f-4a73-bcc0-74feb8d61e0f', '8d22f7f8-d2d5-47b4-8263-ce8ac6133705', 'b', 'Why did the student carry out the experiment three times with each compound?', NULL, 0, 1, '2026-09-13 12:57:41.710755+00');
INSERT INTO public.question_parts VALUES ('9af5d539-b03a-4db6-8c26-77ef49fd7565', '8d22f7f8-d2d5-47b4-8263-ce8ac6133705', 'c', 'Circle the anomalous result in the table.', NULL, 0, 2, '2026-09-13 12:57:41.710799+00');
INSERT INTO public.question_parts VALUES ('66c57bdc-7b85-48d5-83d1-45e4d4706471', '8d22f7f8-d2d5-47b4-8263-ce8ac6133705', 'c-ii', 'What should the student have done after she identified this anomalous result?', NULL, 0, 3, '2026-09-13 12:57:41.711291+00');
INSERT INTO public.question_parts VALUES ('4eea0771-469b-4ff8-b58c-6d3b1c388514', '8d22f7f8-d2d5-47b4-8263-ce8ac6133705', 'd', 'Place a cross ( $ \times $ ) in one box next to the name of the apparatus that the student should use to add the soap solution. beaker burette measuring cylinder pipette', NULL, 0, 4, '2026-09-13 12:57:41.711352+00');
INSERT INTO public.question_parts VALUES ('6fac1661-92da-448b-9976-7adb7a2ceba8', '8d22f7f8-d2d5-47b4-8263-ce8ac6133705', 'e', 'Calculate the average (mean) volume of soap solution needed to form a lather with the magnesium chloride solution. Give your answer to two decimal places. Average (mean) = ... $ cm^{3} $', NULL, 0, 5, '2026-09-13 12:57:41.711409+00');
INSERT INTO public.question_parts VALUES ('bb737ee1-8cb2-4831-869a-6fae259adc6c', '140b8483-e42e-442c-977c-9e6abe845532', 'a', 'Name the type of structure in diamond and explain, in terms of its bonding, why diamond has a high melting point.', NULL, 0, 0, '2026-09-13 12:57:41.711447+00');
INSERT INTO public.question_parts VALUES ('929c5f51-4409-45a3-af26-c742ef955ed8', '140b8483-e42e-442c-977c-9e6abe845532', 'b', 'Explain, in terms of its structure, why graphite can act as a lubricant.', NULL, 0, 1, '2026-09-13 12:57:41.711466+00');
INSERT INTO public.question_parts VALUES ('1a15065d-9658-4f9a-ad50-bad834c498bd', '140b8483-e42e-442c-977c-9e6abe845532', 'c', 'The structure of graphite has one feature in common with that of metals. This feature allows graphite to conduct electricity. Suggest what this feature is and why it allows graphite to conduct electricity.', NULL, 0, 2, '2026-09-13 12:57:41.711485+00');
INSERT INTO public.question_parts VALUES ('0d4245ab-b650-4ac7-a567-b56288420458', '140b8483-e42e-442c-977c-9e6abe845532', 'd', 'In 1985, a new form of carbon was discovered. It was called buckminsterfullerene after the architect Buckminster Fuller, who designed buildings with complex geometric shapes. Buckminsterfullerene $ \left( \mathrm{C}_{60} \right) $ has a simple molecular structure containing 60 carbon atoms per molecule. It looks a little bit like a football. Suggest why buckminsterfullerene has a much lower melting point than diamond.', NULL, 0, 3, '2026-09-13 12:57:41.711502+00');
INSERT INTO public.question_parts VALUES ('587cf752-6fce-40fc-8c27-07d85a64907d', '75437896-a74c-48b7-b3cf-65b8ad86142f', 'a', 'A fully-inflated airbag has a total volume of 108 dm $ ^{3} $ . Calculate the amount of nitrogen, in moles, in a fully-inflated airbag. [You should assume that the volume of one mole of nitrogen inside the airbag is $ 2 4 \mathrm{~ d m}^{3} $]', NULL, 0, 0, '2026-09-13 12:57:41.711522+00');
INSERT INTO public.question_parts VALUES ('50ec0bef-3826-4324-8209-74e7836c2209', '75437896-a74c-48b7-b3cf-65b8ad86142f', 'a-ii', 'Use your answer to (a)(i) to calculate the mass, in grams, of sodium azide required to produce $ 1 0 8 \mathrm{~ d m}^{3} $ of nitrogen.', NULL, 0, 1, '2026-09-13 12:57:41.711538+00');
INSERT INTO public.question_parts VALUES ('6e3c1b14-f2da-4cf2-8600-32d163234e4a', '75437896-a74c-48b7-b3cf-65b8ad86142f', 'b', 'The airbag also contains potassium nitrate. This reacts with sodium formed in the decomposition of sodium azide. The equation for the reaction is: $1 0 \mathrm {N a} (\mathrm {I}) + 2 \mathrm {K N O} _ {3} (\mathrm {s}) \rightarrow \mathrm {K} _ {2} \mathrm {O} (\mathrm {s}) + 5 \mathrm {N a} _ {2} \mathrm {O} (\mathrm {s}) + \mathrm {N} _ {2} (\mathrm {g})$', NULL, 0, 2, '2026-09-13 12:57:41.711571+00');
INSERT INTO public.question_parts VALUES ('f7c9e6d9-0097-4ae4-84d8-be18fba6771d', '75437896-a74c-48b7-b3cf-65b8ad86142f', 'b-i', 'Suggest one reason why the makers of the airbag might want this reaction to occur.', NULL, 0, 3, '2026-09-13 12:57:41.711589+00');
INSERT INTO public.question_parts VALUES ('86b6137e-0291-4940-b223-f86c46cbb985', '75437896-a74c-48b7-b3cf-65b8ad86142f', 'b-ii', 'The airbag also contains silicon dioxide $ \mathrm{(S i O_{2})} $ which reacts with the oxides produced in the reaction above. This forms a glassy solid which seals all the products into the airbag. The glassy solid contains potassium silicate $ \left(\mathrm{K}_{2} \mathrm{S i O}_{3}\right) $ Construct an equation for the formation of potassium silicate from potassium oxide. Include state symbols.', NULL, 0, 4, '2026-09-13 12:57:41.711617+00');
INSERT INTO public.question_parts VALUES ('5be3ac72-d76d-4c00-b8f7-d3ac682fe4d6', '75437896-a74c-48b7-b3cf-65b8ad86142f', 'c', 'Another use of sodium azide is to make lead(II) azide, which can be used as a detonator for explosives. Lead(II) azide has the formula of $ \mathrm{P b} \left( \mathrm{N}_{3} \right)_{2} $ Lead(II) azide can be made by the following reaction: $\mathrm {P b} \left(\mathrm {N O} _ {3}\right) _ {2} (\mathrm {a q}) + 2 \mathrm {N a N} _ {3} (\mathrm {a q}) \rightarrow \mathrm {P b} \left(\mathrm {N} _ {3}\right) _ {2} (\mathrm {s}) + 2 \mathrm {N a N O} _ {3} (\mathrm {a q})$', NULL, 0, 5, '2026-09-13 12:57:41.71165+00');
INSERT INTO public.question_parts VALUES ('53518cfc-0bd7-4f04-af00-2c86b477176f', '75437896-a74c-48b7-b3cf-65b8ad86142f', 'c-i', 'What name is given to this type of reaction?', NULL, 0, 6, '2026-09-13 12:57:41.711666+00');
INSERT INTO public.question_parts VALUES ('da84cc1c-3f1f-47cd-8c4d-4f7ac951c361', '75437896-a74c-48b7-b3cf-65b8ad86142f', 'c-ii', 'What method would you use to remove the lead(II) azide from the final reaction mixture?', NULL, 0, 7, '2026-09-13 12:57:41.711702+00');
INSERT INTO public.question_parts VALUES ('d53380bf-a0e7-4191-ab5a-f4dbf13b882a', '6fd7b874-6a8f-4fbc-a0cc-91b5dd00d3ee', 'a', 'Johnny looked at a beaker containing sulfuric acid and thought that it was water. He then drank the liquid. Suggest why it is possible to mistake sulfuric acid for water.', NULL, 0, 0, '2026-09-13 12:57:41.711725+00');
INSERT INTO public.question_parts VALUES ('c7e87dac-8de8-4867-b490-9651bc5adc75', '6fd7b874-6a8f-4fbc-a0cc-91b5dd00d3ee', 'b', 'Anhydrous copper(II) sulfate changes from white to blue when added to dilute sulfuric acid. Suggest why.', NULL, 0, 1, '2026-09-13 12:57:41.711741+00');
INSERT INTO public.question_parts VALUES ('5f23e4e0-9d52-4d4e-b9da-32c32e6dc5a0', '6fd7b874-6a8f-4fbc-a0cc-91b5dd00d3ee', 'c', 'Sulfuric acid is manufactured by the contact process. One stage of this process involves the reaction of sulfur dioxide with oxygen. $2 \mathrm {S O} _ {2} + \mathrm {O} _ {2} \rightleftharpoons 2 \mathrm {S O} _ {3}$ State the conditions used in this stage of the process. Pressure (in atmospheres) Temperature (in $ ^{\circ} \mathrm{C} $) Catalyst', NULL, 0, 2, '2026-09-13 12:57:41.711759+00');
INSERT INTO public.question_parts VALUES ('1973d62a-c6b2-4274-83d8-9a938dca5470', '6fd7b874-6a8f-4fbc-a0cc-91b5dd00d3ee', 'd', '$ 1 0. 0 \mathrm{c m}^{3} $ of a concentrated solution of sulfuric acid was carefully diluted with water. More water was then added until the final volume of the solution was $ 1. 0 0 \mathrm{d m}^{3} $ $ (1 0 0 0 \mathrm{c m}^{3}). $ In an experiment, a student found that $ 2 5. 0 \mathrm{c m}^{3} $ of the diluted sulfuric acid reacted with $ 3 0. 0 0 \mathrm{c m}^{3} $ of sodium hydroxide solution. The concentration of the sodium hydroxide solution was 0.200 mol/dm $ ^{3}. $ The equation for the reaction is: $2 \mathrm {N a O H} + \mathrm {H} _ {2} \mathrm {S O} _ {4} \rightarrow \mathrm {N a} _ {2} \mathrm {S O} _ {4} + 2 \mathrm {H} _ {2} \mathrm {O}$', NULL, 0, 3, '2026-09-13 12:57:41.711773+00');
INSERT INTO public.question_parts VALUES ('1b2d2d37-9053-406d-9e2f-5d04620ee3b9', '6fd7b874-6a8f-4fbc-a0cc-91b5dd00d3ee', 'd-i', 'Calculate the amount, in moles, of sodium hydroxide in $ 3 0. 0 0 \mathrm{c m}^{3} $ of a solution of concentration 0.200 mol/dm $ ^{3} $ . Amount of sodium hydroxide = mol', NULL, 0, 4, '2026-09-13 12:57:41.711791+00');
INSERT INTO public.question_parts VALUES ('a7711ae6-f575-4f12-b00f-5170ed8874e0', '6fd7b874-6a8f-4fbc-a0cc-91b5dd00d3ee', 'd-ii', 'Using your answer to (d)(i), calculate the amount, in moles, of sulfuric acid in $ 2 5. 0 \mathrm{c m}^{3} $ of the diluted acid. Amount of sulfuric acid in 25.0 $ \mathrm{c m^{3}} $ = ... mol', NULL, 0, 5, '2026-09-13 12:57:41.711809+00');
INSERT INTO public.question_parts VALUES ('20782edb-3e9e-46ce-abb0-ff2b81a951ec', '6fd7b874-6a8f-4fbc-a0cc-91b5dd00d3ee', 'd-iii', 'Using your answer to (d)(ii), calculate the concentration, in mol/dm $ ^{3} $ , of the diluted sulfuric acid. Concentration of the diluted sulfuric acid = ... mol/dm $ ^{3} $', NULL, 0, 6, '2026-09-13 12:57:41.711823+00');
INSERT INTO public.question_parts VALUES ('b76a6e41-c4b7-452b-a26b-ef682a7c3667', '6fd7b874-6a8f-4fbc-a0cc-91b5dd00d3ee', 'd-iv', 'Using your answer to (d) (iii), calculate the concentration, in mol/dm $ ^{3} $ , of the original, concentrated sulfuric acid. Concentration of the original, concentrated acid = ... mol/dm $ ^{3} $', NULL, 0, 7, '2026-09-13 12:57:41.711839+00');
INSERT INTO public.question_parts VALUES ('fb6adf94-7c6e-4445-9fab-2f060d18bd85', '7d51d78a-58be-48bd-9d67-ce011a19969f', 'b', 'The symbol for an atom of one isotope of hydrogen is $ _{1}^{3} \mathrm{H} $', NULL, 0, 0, '2026-09-13 12:57:41.986383+00');
INSERT INTO public.question_parts VALUES ('3a874c28-660d-4864-ab1f-530b9c5ca592', '7d51d78a-58be-48bd-9d67-ce011a19969f', 'b-i', 'State the number of protons, neutrons and electrons present in one atom of this isotope. Number of protons ... Number of neutrons ... Number of electrons ...', NULL, 0, 1, '2026-09-13 12:57:41.98645+00');
INSERT INTO public.question_parts VALUES ('2da4451d-4ded-403f-8c91-63e4ab03fa2a', '7d51d78a-58be-48bd-9d67-ce011a19969f', 'b-ii', 'What is meant by the term isotopes?', NULL, 0, 2, '2026-09-13 12:57:41.98648+00');
INSERT INTO public.question_parts VALUES ('039863c1-183e-4dcc-85fc-114691d1e5d9', '7d51d78a-58be-48bd-9d67-ce011a19969f', 'c', 'Bromine has two naturally-occurring isotopes with mass numbers 79 and 81. A sample of bromine contained the two isotopes in the following proportions: bromine-79=50.7% and bromine-81=49.3% Use this information to calculate the relative atomic mass of bromine. Give your answer to two decimal places.', NULL, 0, 3, '2026-09-13 12:57:41.986492+00');
INSERT INTO public.question_parts VALUES ('a061df91-a85b-4f4a-b98f-42fa7bdffa26', '41b50040-51f0-497c-98a1-e704c20abfb6', 'a', 'Part of the Periodic Table is shown.', NULL, 0, 0, '2026-09-13 12:57:41.986509+00');
