INSERT INTO public.question_parts VALUES ('a9a676b6-0356-4937-93fa-6502a0698dc8', 'b6e3c846-1b22-43b7-809e-4f42a92c7887', 'c', 'The equation for the reaction between copper(II) chloride and silver nitrate is $\mathrm {C u C l} _ {2} (\mathrm {a q}) + 2 \mathrm {A g N O} _ {3} (\mathrm {a q}) \rightarrow 2 \mathrm {A g C l} (\mathrm {s}) + \mathrm {C u} \left(\mathrm {N O} _ {3}\right) _ {2} (\mathrm {a q})$ A student measures $ 2 5. 0 \mathrm{c m}^{3} $ of $ 0. 5 0 0 \mathrm{m o l} / \mathrm{d m}^{3} $ copper(II) chloride solution and reacts it with silver nitrate solution.', NULL, 0, 6, '2026-09-13 13:01:26.268288+00');
INSERT INTO public.question_parts VALUES ('7fe8ac30-59ad-4e2e-855d-40d5dc52f8e7', 'b6e3c846-1b22-43b7-809e-4f42a92c7887', 'c-i', 'Name a piece of apparatus suitable for measuring $ 2 5. 0 \mathrm{c m}^{3} $ of copper(II) chloride solution.', NULL, 0, 7, '2026-09-13 13:01:26.268314+00');
