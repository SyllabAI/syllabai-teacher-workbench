INSERT INTO public.question_parts VALUES ('40af6a6f-9cf4-4ad8-90d5-18277b02d437', 'c29220cf-1349-4745-b9ec-724ae93f9038', 'c', 'In another experiment she added a small piece of potassium to a large trough containing water. This time she observed a lilac flame.', NULL, 0, 2, '2026-09-13 12:58:26.498842+00');
