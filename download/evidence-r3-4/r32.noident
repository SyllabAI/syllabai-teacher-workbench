INSERT INTO public.document_chunks VALUES ('40bf6ee0-df72-40b7-8ad0-f6d67c958cc9', 'af780c72-e434-4ad3-a427-2d60f856f6b3', 9, '7 Some students investigated the rate of the reaction between marble chips (calcium carbonate) and dilute hydrochloric acid.
