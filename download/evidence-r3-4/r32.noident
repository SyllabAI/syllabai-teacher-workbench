INSERT INTO public.question_versions VALUES ('6100b9ad-58ef-4019-9cab-4c6ee8445774', 'd693c52f-bd23-473c-bc8b-53f3b5511181', 1, 'This question is about chemical elements. Use the Periodic Table to help you answer this question.', 7, 3, 630, NULL, 'SUGGESTED', '0f21a459-f60c-59ba-807b-612e0e57b5bd', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:55:23.305697+00');
INSERT INTO public.question_versions VALUES ('6657d151-3ff0-4fde-ba72-d6d801844f1b', '416c3001-3d12-4827-a9e9-baac422b697f', 1, '(a) The boxes list changes that may happen in a laboratory and the names of some changes. Draw one straight line from each change to its correct name.', 6, 3, 540, NULL, 'SUGGESTED', '0f21a459-f60c-59ba-807b-612e0e57b5bd', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:55:23.307489+00');
