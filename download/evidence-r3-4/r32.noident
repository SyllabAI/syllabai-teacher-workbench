INSERT INTO public.question_parts VALUES ('a87b38ff-b362-443f-b22c-efb5584048ec', '7adcfec2-bb16-4aee-bfec-0f5131ab55e2', 'b', 'One compound in the gasoline fraction is the alkane octane $ \left( \mathrm{C}_{8} \mathrm{H}_{1 8} \right) $ and one compound in the kerosene fraction is the alkane dodecane $ \left( \mathrm{C}_{1 2} \mathrm{H}_{2 6} \right) $ These two alkanes are covalently bonded and have simple molecular structures.', NULL, 0, 3, '2026-09-13 13:02:53.487296+00');
