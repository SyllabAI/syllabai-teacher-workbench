thrm {g})", "confidence": 1.0, "element_id": "e000115", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 115, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "1 0 \\mathrm {N a} (\\mathrm {I}) + 2 \\mathrm {K N O} _ {3} (\\mathrm {s}) \\rightarrow \\mathrm {K} _ {2} \\mathrm {O} (\\mathrm {s}) + 5 \\mathrm {N a} _ {2} \\mathrm {O} (\\mathrm {s}) + \\mathrm {N} _ {2} (\\mathrm {g})", "latex": "1 0 \\mathrm {N a} (\\mathrm {I}) + 2 \\mathrm {K N O} _ {3} (\\mathrm {s}) \\rightarrow \\mathrm {K} _ {2} \\mathrm {O} (\\mathrm {s}) + 5 \\mathrm {N a} _ {2} \\mathrm {O} (\\mathrm {s}) + \\mathrm {N} _ {2} (\\mathrm {g})", "confidence": 1.0, "element_id": "e000126", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 126, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {P b} \\left(\\mathrm {N O} _ {3}\\right) _ {2} (\\mathrm {a q}) + 2 \\mathrm {N a N} _ {3} (\\mathrm {a q}) \\rightarrow \\mathrm {P b} \\left(\\mathrm {N} _ {3}\\right) _ {2} (\\mathrm {s}) + 2 \\mathrm {N a N O} _ {3} (\\mathrm {a q})", "latex": "\\mathrm {P b} \\left(\\mathrm {N O} _ {3}\\right) _ {2} (\\mathrm {a q}) + 2 \\mathrm {N a N} _ {3} (\\mathrm {a q}) \\rightarrow \\mathrm {P b} \\left(\\mathrm {N} _ {3}\\right) _ {2} (\\mathrm {s}) + 2 \\mathrm {N a N O} _ {3} (\\mathrm {a q})", "confidence": 1.0, "element_id": "e000133", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 133, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {W a s H} _ {2} \\mathrm {S O} _ {4}", "latex": "\\mathrm {W a s H} _ {2} \\mathrm {S O} _ {4}", "confidence": 1.0, "element_id": "e000141", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 141, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "2 \\mathrm {S O} _ {2} + \\mathrm {O} _ {2} \\