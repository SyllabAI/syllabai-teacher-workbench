INSERT INTO public.question_parts VALUES ('bd97d2cb-e2c2-4fb2-aa2a-8f493236042b', '44c4aa47-d586-4055-9471-89f6a6102168', 'd', 'Two reactions that can occur when hydrocarbon A is burned in air are represented by these equations. Equation for reaction 1 $\mathrm {C H} _ {4} + 2 \mathrm {O} _ {2} \rightarrow \mathrm {C O} _ {2} + 2 \mathrm {H} _ {2} \mathrm {O}$ Equation for reaction 2 $\mathrm {C H} _ {4} + 1 \frac {1}{2} \mathrm {O} _ {2} \rightarrow \mathrm {C O} + 2 \mathrm {H} _ {2} \mathrm {O}$ Explain why a different product is formed in reaction 2 and why this product is dangerous.', NULL, 0, 8, '2026-09-13 12:52:26.080301+00');
INSERT INTO public.question_parts VALUES ('7d8fa935-3fc5-4613-ab53-113c27b85039', '35bf2113-03ca-42e5-8aea-3365df455272', 'a', 'Choose two properties from the list that make iron a suitable metal for saucepans.', NULL, 0, 0, '2026-09-13 12:52:26.080314+00');
INSERT INTO public.question_parts VALUES ('8861da09-8c8a-4ffa-9e2c-fd20b1fa3cff', '35bf2113-03ca-42e5-8aea-3365df455272', 'a-ii', 'Choose two properties from the list that make aluminium a suitable metal for power cables.', NULL, 0, 1, '2026-09-13 12:52:26.08032+00');
INSERT INTO public.question_parts VALUES ('2af7db1b-58fb-4ec9-a641-32dc34b832b2', '35bf2113-03ca-42e5-8aea-3365df455272', 'b', 'Steel is an alloy containing iron. These are three differences between steel and aluminium. steel can rust but aluminium resists corrosion steel has a higher density than aluminium steel is much stronger than aluminium', NULL, 0, 2, '2026-09-13 12:52:26.080328+00');
INSERT INTO public.question_parts VALUES ('bd0cf63b-db07-4e78-aaec-b9801660f36f', '35bf2113-03ca-42e5-8aea-3365df455272', 'b-i', 'Use information from the list to suggest why steel is the better metal for making bridges.', NULL, 0, 3, '2026-09-13 12:52:26.080333+00');
INSERT INTO public.question_parts VALUES ('6387afa3-8c0f-436f-91ae-51a8d731ff6a', '35bf2113-03ca-42e5-8aea-3365df455272', 'b-ii', 'Use information from the list to suggest why aluminium is the better metal for making aircraft bodies.', NULL, 0, 4, '2026-09-13 12:52:26.080338+00');
INSERT INTO public.question_parts VALUES ('7d4dcb0b-c9de-4bb7-ba05-55344a09f5c4', '35bf2113-03ca-42e5-8aea-3365df455272', 'c', 'The reaction between aluminium and iron(III) oxide is known as a thermite reaction. The diagram shows how this thermite reaction can be carried out. The magnesium ribbon is lit to ignite the reaction mixture. The reaction is highly exothermic. The equation for the reaction is $2 \mathrm {A l} + \mathrm {F e} _ {2} \mathrm {O} _ {3} \rightarrow \mathrm {A l} _ {2} \mathrm {O} _ {3} + 2 \mathrm {F e}$', NULL, 0, 5, '2026-09-13 12:52:26.080341+00');
INSERT INTO public.question_parts VALUES ('f305394b-631b-4a58-ab45-fdf05e2de46c', '35bf2113-03ca-42e5-8aea-3365df455272', 'c-i', 'What is meant by the term exothermic?', NULL, 0, 6, '2026-09-13 12:52:26.080346+00');
INSERT INTO public.question_parts VALUES ('66f710d1-0a8d-4f48-af54-4220a274c912', '35bf2113-03ca-42e5-8aea-3365df455272', 'c-ii', 'What does the reaction suggest about the reactivity of aluminium compared to the reactivity of iron? Explain your answer.', NULL, 0, 7, '2026-09-13 12:52:26.080351+00');
INSERT INTO public.question_parts VALUES ('38f2a94e-eecc-4cca-b83c-548399f71cb3', '35bf2113-03ca-42e5-8aea-3365df455272', 'c-iii', 'Which element is oxidised in this thermite reaction? Give a reason for your answer.', NULL, 0, 8, '2026-09-13 12:52:26.080363+00');
INSERT INTO public.question_parts VALUES ('a4a5a0ee-3261-4903-b2bd-591ba16229d8', '35bf2113-03ca-42e5-8aea-3365df455272', 'd', 'This thermite reaction can be used to join together two rails on a railway line. The reaction mixture is ignited and molten iron pours into the mould. The mould is removed and the molten iron solidifies to create a join between the two rails. Explain why the iron produced in the reaction is molten.', NULL, 0, 9, '2026-09-13 12:52:26.080369+00');
INSERT INTO public.question_parts VALUES ('fd80b42e-f130-4e8f-aee6-786ed40cd654', 'd65ca07d-b7a4-444a-9980-3b00277e8ad4', 'a', 'What is meant by the term cracking?', NULL, 0, 0, '2026-09-13 12:52:26.080374+00');
