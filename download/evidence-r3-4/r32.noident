INSERT INTO public.questions VALUES ('242fd56f-0055-4698-8b0c-80c458e2cd31', 'q07-a11a8fbb', 'STRUCTURED', 'A teacher asked her students to suggest some experiments that could be done using chemicals found in the home. One student planned an experiment to measure the temperature change when baking soda is added to vinegar. She wrote this plan. pour 100 $ cm^{3} $ of vinegar into a polystyrene cup weigh out five separate 1 g portions of baking soda measure the temperature of the vinegar add 1 g of baking soda to the vinegar and stir record the new temperature add the other portions of baking soda, stirring and recording the temperature after each portion is added The graph shows her results. Mass of baking soda added in grams', 10, 3, 900, NULL, '031c3e1f-d318-4360-a056-c9a822ded7b3', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.360882+00', '550e50e2-c61c-4b94-89ee-ef83ce9bf901');
INSERT INTO public.questions VALUES ('d4ab8d6b-4134-4c8e-abde-6f9fad661c6e', 'q08-a11a8fbb', 'STRUCTURED', 'A group of students investigated the reaction between marble chips (calcium carbonate) and dilute hydrochloric acid. The equation for this reaction is $\mathrm {C a C O} _ {3} (\mathrm {s}) + 2 \mathrm {H C l} (\mathrm {a q}) \rightarrow \mathrm {C a C l} _ {2} (\mathrm {a q}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {l}) + \mathrm {C O} _ {2} (\mathrm {g})$ They wanted to find the effect of changing the concentration of hydrochloric acid on the rate of reaction. The teacher provided a solution that she had labelled 100% hydrochloric acid. The teacher told them to do all their experiments using different concentrations of hydrochloric acid made by diluting the 100% hydrochloric acid by timing how long it took to collect carbon dioxide at room temperature The students used this apparatus.', 14, 3, 1260, NULL, '031c3e1f-d318-4360-a056-c9a822ded7b3', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.361164+00', '550e50e2-c61c-4b94-89ee-ef83ce9bf901');
INSERT INTO public.questions VALUES ('f8fea82c-771d-42a6-93ac-e6f3b2b70bb0', 'q09-a11a8fbb', 'STRUCTURED', 'The diagram shows some pieces of apparatus used to measure volumes. He was allowed to use normal laboratory apparatus, including the pieces of apparatus shown in the diagram. He was told to plan an experiment to find the concentration of the sodium hydroxide solution. This is his plan. Step1 Obtain about 150 $ cm^{3} $ of each solution. Step 2 Use a measuring cylinder to add exactly 25.0 $ cm^{3} $ of sodium hydroxide solution to a conical flask. Step 3 Add a few drops of universal indicator to the conical flask. Step 4 Use a burette to add the sulfuric acid to the conical flask until the indicator changes colour. A student was given a large bottle containing sodium hydroxide solution and a supply of dilute sulfuric acid of known concentration.', 14, 3, 1260, NULL, '031c3e1f-d318-4360-a056-c9a822ded7b3', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.361434+00', '550e50e2-c61c-4b94-89ee-ef83ce9bf901');
INSERT INTO public.questions VALUES ('201157bf-3b73-4139-8072-6c49744ccd5d', 'q10-a11a8fbb', 'STRUCTURED', 'The Haber process is used to convert nitrogen and hydrogen into ammonia.', 1, 3, 90, NULL, '031c3e1f-d318-4360-a056-c9a822ded7b3', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.362+00', '550e50e2-c61c-4b94-89ee-ef83ce9bf901');
INSERT INTO public.questions VALUES ('0cbe74d3-6f77-4f1d-a197-c73f41a728de', 'q11-a11a8fbb', 'STRUCTURED', 'The properties of substances can be explained in terms of their bonding and structure. Electricity can be transmitted by overhead power lines. This method of transmission requires electrical conductors and insulators.', 9, 3, 810, NULL, '031c3e1f-d318-4360-a056-c9a822ded7b3', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.362765+00', '550e50e2-c61c-4b94-89ee-ef83ce9bf901');
INSERT INTO public.questions VALUES ('5f0c3cfe-0866-4a3b-94f8-94c67ff9899f', 'q01-8efa97d9', 'STRUCTURED', 'Some of the gases used in industry are stored in cylinders.', 8, 3, 720, NULL, 'fc8a088b-112c-4007-982e-6a41b10d5701', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.602078+00', '58ed1fc6-24d7-4ef1-b567-0428dcfaf3e9');
INSERT INTO public.questions VALUES ('ff57b076-9961-4809-862f-50121fe76a74', 'q10-f4948ec0', 'STRUCTURED', 'This question is about hydrochloric acid.', 1, 3, 90, NULL, '8288c504-436a-4116-b70f-81bc971992e1', 'PAST_PAPER', true, 1, '2026-09-13 12:53:11.817406+00', '66566842-554a-4293-82a8-dce2fa8dcd94');
INSERT INTO public.questions VALUES ('9cbd37d6-9aca-44ab-ac53-c0e3f2787192', 'q11-f4948ec0', 'STRUCTURED', 'The table shows the displayed formulae of four hydrocarbons, W, X, Y and Z.', 9, 3, 810, NULL, '8288c504-436a-4116-b70f-81bc971992e1', 'PAST_PAPER', true, 1, '2026-09-13 12:53:11.817597+00', '66566842-554a-4293-82a8-dce2fa8dcd94');
INSERT INTO public.questions VALUES ('63f3bbe3-9fc4-43fa-b983-5aaddf9644c9', 'q12-f4948ec0', 'STRUCTURED', 'Titanium is a metal that can be extracted from its ore in a three-stage process. stage 1 titanium ore is converted into titanium dioxide, $ \mathrm{T i O}_{2} $ stage 2 titanium dioxide is then converted into titanium chloride, $ \mathrm{T i C l}_{4} $ stage 3 titanium chloride is converted into titanium, Ti', 12, 3, 1080, NULL, '8288c504-436a-4116-b70f-81bc971992e1', 'PAST_PAPER', true, 1, '2026-09-13 12:53:11.817799+00', '66566842-554a-4293-82a8-dce2fa8dcd94');
INSERT INTO public.questions VALUES ('0801a54b-5933-438b-a13b-5f7f39d843cb', 'q13-f4948ec0', 'STRUCTURED', 'iodine reacts with chlorine to form iodine monochloride, ICI', 5, 3, 450, NULL, '8288c504-436a-4116-b70f-81bc971992e1', 'PAST_PAPER', true, 1, '2026-09-13 12:53:11.817971+00', '66566842-554a-4293-82a8-dce2fa8dcd94');
INSERT INTO public.questions VALUES ('1b7e80eb-df32-47f4-b28f-005b1b48dc51', 'q14-f4948ec0', 'STRUCTURED', 'Potassium hydrogencarbonate （ $ \mathrm{KHCO}_{3} $ ）decomposes on heating. Three possible equations for the decomposition are $\mathrm {e q u a t i o n 1} \quad 2 \mathrm {K H C O} _ {3} (\mathrm {s}) \rightarrow \mathrm {K} _ {2} \mathrm {O} (\mathrm {s}) + 2 \mathrm {C O} _ {2} (\mathrm {g}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {g})$ equation 2 $ \mathrm{K H C O}_{3} ( \mathrm{s} ) \rightarrow \mathrm{K O H} ( \mathrm{s} )+\mathrm{C O}_{2} ( \mathrm{g} ) $ $\mathrm {e q u a t i o n 3} \quad 2 \mathrm {K H C O} _ {3} (\mathrm {s}) \rightarrow \mathrm {K} _ {2} \mathrm {C O} _ {3} (\mathrm {s}) + \mathrm {C O} _ {2} (\mathrm {g}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {g})$ When 8.00 g of potassium hydrogencarbonate is heated until it is fully decomposed, 5.52 g of solid is formed.', 4, 3, 360, NULL, '8288c504-436a-4116-b70f-81bc971992e1', 'PAST_PAPER', true, 1, '2026-09-13 12:53:11.818155+00', '66566842-554a-4293-82a8-dce2fa8dcd94');
INSERT INTO public.questions VALUES ('9f6f1c90-4fab-44a0-9ecf-9d12bd013929', 'q15-f4948ec0', 'STRUCTURED', 'Butane $ \left( \mathrm{C}_{4} \mathrm{H}_{1 0} \right) $ is a gas at room temperature and pressure. The equation for the complete combustion of butane is $C _ {4} H _ {1 0} (g) + 6 \frac {1}{2} O _ {2} (g) \rightarrow 4 C O _ {2} (g) + 5 H _ {2} O (l)$ Butane is used in an experiment to determine its $ \Delta H $ of combustion.', 8, 3, 720, NULL, '8288c504-436a-4116-b70f-81bc971992e1', 'PAST_PAPER', true, 1, '2026-09-13 12:53:11.818347+00', '66566842-554a-4293-82a8-dce2fa8dcd94');
INSERT INTO public.questions VALUES ('c81f1e00-6cb3-415b-a1b4-c1b387c6d801', 'q16-f4948ec0', 'STRUCTURED', 'The diagram shows the apparatus used to investigate the rate of reaction between calcium carbonate and an excess of dilute hydrochloric acid. The mass of the flask and contents is measured at regular time intervals. The graph shows the results obtained.', 7, 3, 630, NULL, '8288c504-436a-4116-b70f-81bc971992e1', 'PAST_PAPER', true, 1, '2026-09-13 12:53:11.818516+00', '66566842-554a-4293-82a8-dce2fa8dcd94');
INSERT INTO public.questions VALUES ('91d5e3df-deee-4097-b21a-3fc02252f7a4', 'q01-517cf287', 'STRUCTURED', 'Substances can be classified as elements, mixtures or compounds.', 6, 3, 540, NULL, 'f01f60ef-5693-4171-9695-ea236e97ddc3', 'PAST_PAPER', true, 1, '2026-09-13 13:01:25.607361+00', '61f7a985-439f-4e5c-944b-f5a5bb285358');
INSERT INTO public.questions VALUES ('386e2612-368f-423e-a43d-fa99b49b9430', 'q02-8efa97d9', 'STRUCTURED', 'Some powdered calcium carbonate was heated strongly in a test tube. The gas given off was bubbled through limewater. The equation for the reaction taking place in the heated tube is $\mathrm {C a C O} _ {3} (\mathrm {s}) \rightarrow \mathrm {C a O} (\mathrm {s}) + \mathrm {C O} _ {2} (\mathrm {g})$', 6, 3, 540, NULL, 'fc8a088b-112c-4007-982e-6a41b10d5701', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.602466+00', '58ed1fc6-24d7-4ef1-b567-0428dcfaf3e9');
