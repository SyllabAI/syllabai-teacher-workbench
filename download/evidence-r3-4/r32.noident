INSERT INTO public.question_parts VALUES ('e96fec96-f2bd-4c71-aee1-e8032558c8ee', 'f16baa2a-95fc-42cc-a020-5c3df5b80ef1', 'e-iii', 'Suggest a connection between the atomic number and the reactivity of the elements in Group 2.', NULL, 0, 7, '2026-09-13 12:52:25.611157+00');
INSERT INTO public.question_parts VALUES ('671195ff-6244-4f2f-a996-a8d2a8600234', '626dba58-8ad7-4fd0-8d44-91f314a66b7f', 'a', 'Aluminium is extracted from aluminium oxide by electrolysis. What are the electrodes made of? Negative electrode Positive electrode', NULL, 0, 0, '2026-09-13 12:52:25.611182+00');
INSERT INTO public.question_parts VALUES ('41377078-0621-4206-b2cc-3bce5c9f3ede', '626dba58-8ad7-4fd0-8d44-91f314a66b7f', 'b', 'Explain why the operating temperature would need to be very high if pure aluminium oxide were used as the electrolyte.', NULL, 0, 1, '2026-09-13 12:52:25.611201+00');
INSERT INTO public.question_parts VALUES ('f319d06d-3a48-45a2-964c-ffe17e3f268f', '626dba58-8ad7-4fd0-8d44-91f314a66b7f', 'b-ii', 'Describe how the operating temperature is kept low.', NULL, 0, 2, '2026-09-13 12:52:25.611218+00');
INSERT INTO public.question_parts VALUES ('e0b7cd5b-ad76-40aa-90df-a91909d514f3', '626dba58-8ad7-4fd0-8d44-91f314a66b7f', 'c', 'The ionic half-equation for the reaction at the negative electrode is $\mathrm {A l} ^ {3 +} + 3 \mathrm {e} ^ {-} \rightarrow \mathrm {A l}$ What type of reaction is occurring at the negative electrode? Explain your answer.', NULL, 0, 3, '2026-09-13 12:52:25.61124+00');
INSERT INTO public.question_parts VALUES ('4cf7001e-839c-4220-926a-a5177a2b999b', '626dba58-8ad7-4fd0-8d44-91f314a66b7f', 'd', 'The waste gases escaping from the electrolysis cell contain carbon dioxide. Describe how the carbon dioxide is formed.', NULL, 0, 4, '2026-09-13 12:52:25.611254+00');
INSERT INTO public.question_parts VALUES ('7946a1bf-7902-45bf-ad76-1288ce0fd999', '626dba58-8ad7-4fd0-8d44-91f314a66b7f', 'e', 'Aluminium is used to make cans for food and drinks. State two properties of aluminium that make it suitable for this use. You should not refer to cost in your answers.', NULL, 0, 5, '2026-09-13 12:52:25.611275+00');
INSERT INTO public.question_parts VALUES ('924bef24-17fc-4608-a1d5-0368cdb99d14', '2e118484-350f-4661-8ba4-175d03ef7f84', 'a-ii', 'Why is it important to use a non-luminous flame?', NULL, 0, 1, '2026-09-13 12:52:25.612021+00');
INSERT INTO public.question_parts VALUES ('cf0be93c-f108-4b82-adad-9a79bd2339a7', '2e118484-350f-4661-8ba4-175d03ef7f84', 'a-iii', 'What colour would be observed in the flame if the solid contained sodium ions? (1)', NULL, 0, 2, '2026-09-13 12:52:25.612037+00');
INSERT INTO public.question_parts VALUES ('404f97d7-898d-404b-91dd-c28dfb3beb98', 'bef07aa0-1983-40e6-82c4-a4171ccefc58', 'b', 'The displayed formula of heptane $ \left( \mathrm{C}_{7} \mathrm{H}_{1 6} \right) $ is Which one of the displayed formulae below does not represent an isomer of heptane? Place a cross ( $ \times $ ) in the box to indicate your answer.', NULL, 0, 0, '2026-09-13 12:52:25.611301+00');
INSERT INTO public.question_parts VALUES ('bf85a3df-1044-4135-95f3-e5158195a236', 'bef07aa0-1983-40e6-82c4-a4171ccefc58', 'c', 'Heptane belongs to a homologous series of compounds called alkanes. The general formula of the alkanes is $ C_{n} H_{2 n+2} $', NULL, 0, 1, '2026-09-13 12:52:25.61132+00');
INSERT INTO public.question_parts VALUES ('3229b608-efdf-4780-937a-c9fea3e06e17', 'bef07aa0-1983-40e6-82c4-a4171ccefc58', 'c-i', 'Heptene belongs to a homologous series of compounds called alkenes. Give the general formula of the alkenes.', NULL, 0, 2, '2026-09-13 12:52:25.611341+00');
INSERT INTO public.question_parts VALUES ('e5b15396-561a-416e-92bf-c88f7e792b29', 'bef07aa0-1983-40e6-82c4-a4171ccefc58', 'c-ii', 'Complete the following diagram to show the structural formula of heptene $ \mathrm{(C_{7}H_{14})} $ by inserting lines to represent the covalent bonds between the carbon atoms. $\begin{array}{c c c c c c c} H & H & H & H & H & H \\ | & | & | & | & | \\ C & C & C & C & C & C \\ | & & | & | & | \\ H & & H & H & H & H \end{array}$', NULL, 0, 3, '2026-09-13 12:52:25.611357+00');
INSERT INTO public.question_parts VALUES ('e7998c7e-8b88-4003-9697-e4c54932223e', 'bef07aa0-1983-40e6-82c4-a4171ccefc58', 'd', 'When heptene is added to bromine water, and the mixture is shaken, a reaction occurs. State the type of reaction and give the colour of the bromine water before and after the reaction with heptene. Type of reaction. Colour before.. Colour after..', NULL, 0, 4, '2026-09-13 12:52:25.611374+00');
INSERT INTO public.question_parts VALUES ('0e454bd7-df3f-42dc-862d-aefa064c23ff', 'bef07aa0-1983-40e6-82c4-a4171ccefc58', 'e', 'Explain, in terms of the bonds present, why heptane is described as saturated and heptene as unsaturated.', NULL, 0, 5, '2026-09-13 12:52:25.611393+00');
INSERT INTO public.question_parts VALUES ('2e6959fd-c977-43b8-a3c3-48cf9cf49b4b', 'a347a2dc-9843-46e1-be66-8c48d850e51d', 'a', 'Astatine (At) has an atomic number of 85 and is the fifth element in Group 7. It is possible to make predictions about astatine by comparison with the other elements in Group 7.', NULL, 0, 0, '2026-09-13 12:52:25.611417+00');
INSERT INTO public.question_parts VALUES ('c973e6d9-7299-49db-89d8-721f0cc1f2d4', 'a347a2dc-9843-46e1-be66-8c48d850e51d', 'a-i', 'How many electrons does an atom of astatine have in its outer shell?', NULL, 0, 1, '2026-09-13 12:52:25.611435+00');
INSERT INTO public.question_parts VALUES ('6cc79485-1ad8-4ac2-8fbf-7d9704f99bbd', 'a347a2dc-9843-46e1-be66-8c48d850e51d', 'a-ii', 'What physical state and colour would you expect for astatine at $ 2 0^{\circ} \mathrm{C}? $ Physical state Colour.', NULL, 0, 2, '2026-09-13 12:52:25.611454+00');
INSERT INTO public.question_parts VALUES ('cb7c82c9-2680-49a6-8b32-23871160967a', 'a347a2dc-9843-46e1-be66-8c48d850e51d', 'a-iii', 'Predict the formula of the compound formed between astatine and hydrogen. Suggest a name for this compound. Formula Name ...', NULL, 0, 3, '2026-09-13 12:52:25.611471+00');
INSERT INTO public.question_parts VALUES ('3d53fc6c-3626-402c-a3dc-0cf2ab042deb', 'a347a2dc-9843-46e1-be66-8c48d850e51d', 'a-iv', 'Suggest how the reactivity of astatine compares to that of iodine. Explain your answer.', NULL, 0, 4, '2026-09-13 12:52:25.61149+00');
INSERT INTO public.question_parts VALUES ('6c050fb3-344c-4ce9-b11d-647f4d838bd9', 'a347a2dc-9843-46e1-be66-8c48d850e51d', 'b', 'Chlorine gas can be prepared by heating a mixture of concentrated hydrochloric acid and manganese(IV) oxide using this apparatus.', NULL, 0, 5, '2026-09-13 12:52:25.611511+00');
INSERT INTO public.question_parts VALUES ('5c7e89fc-3d26-497e-ae71-98fb9cd2937e', 'a347a2dc-9843-46e1-be66-8c48d850e51d', 'b-i', 'Balance the equation for the reaction. $\mathrm {H C l} (\mathrm {a q}) + \mathrm {M n O} _ {2} (\mathrm {s}) \rightarrow \mathrm {M n C l} _ {2} (\mathrm {a q}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {l}) + \mathrm {C l} _ {2} (\mathrm {g})$', NULL, 0, 6, '2026-09-13 12:52:25.611541+00');
INSERT INTO public.question_parts VALUES ('03183eba-0354-41ce-920e-c5f29479e116', 'a347a2dc-9843-46e1-be66-8c48d850e51d', 'b-ii', 'State what you would observe when a piece of damp litmus paper is placed into the gas jar containing chlorine.', NULL, 0, 7, '2026-09-13 12:52:25.611577+00');
INSERT INTO public.question_parts VALUES ('3b8a2889-d02f-4456-9d55-5d327fe7c972', 'a347a2dc-9843-46e1-be66-8c48d850e51d', 'c', 'Chlorine can be used to obtain bromine $ \left(\mathrm{B r}_{2}\right) $ from sea water. Sea water contains bromide ions, Br $ ^{一} $ The pH of sea water is usually within the range of 7.5 to 8.4 The stages in the extraction of bromine from sea water are Stage1 The pH of the sea water is lowered to about 3.5 Stage 2 An excess of chlorine is bubbled through the sea water Stage 3 The bromine $ \mathrm{(B r_{2})} $ is removed from the mixture and reacted with sulfur dioxide $ \mathrm{(S O_{2})} $ and water. This reaction converts the bromine to hydrogen bromide (HBr) and sulfuric acid $ \mathrm{(H_{2} S O_{4})} $ Stage 4 The hydrogen bromide is reacted with chlorine to form bromine $ \left(\mathrm{B r}_{2}\right) $', NULL, 0, 8, '2026-09-13 12:52:25.611596+00');
INSERT INTO public.question_parts VALUES ('8a2d6bb0-521a-4ee7-949e-22837dee1f29', 'a347a2dc-9843-46e1-be66-8c48d850e51d', 'c-i', 'Suggest a substance that could be added to lower the pH of sea water in Stage 1.', NULL, 0, 9, '2026-09-13 12:52:25.611627+00');
INSERT INTO public.question_parts VALUES ('98d1fb6f-e1b3-495c-989f-69125a27a350', 'a347a2dc-9843-46e1-be66-8c48d850e51d', 'c-ii', 'Why is an excess of chlorine added in Stage 2?', NULL, 0, 10, '2026-09-13 12:52:25.611647+00');
INSERT INTO public.question_parts VALUES ('c52194ab-5059-4be2-8c33-68edd00f6c9c', 'a347a2dc-9843-46e1-be66-8c48d850e51d', 'c-iii', 'Write a chemical equation for the reaction in Stage 3.', NULL, 0, 11, '2026-09-13 12:52:25.611694+00');
INSERT INTO public.question_parts VALUES ('60cb8382-fe55-4738-8687-d5ec5fe2b527', 'a347a2dc-9843-46e1-be66-8c48d850e51d', 'c-iv', 'Write a chemical equation for the reaction in Stage 4.', NULL, 0, 12, '2026-09-13 12:52:25.611715+00');
INSERT INTO public.question_parts VALUES ('54033371-5573-4f73-bbfd-e06005e9f378', 'a347a2dc-9843-46e1-be66-8c48d850e51d', 'd', 'State the colour change observed when bromine is added to an aqueous solution of potassium iodide. Colour of potassium iodide solution at start... Colour of final reaction mixture...', NULL, 0, 13, '2026-09-13 12:52:25.611738+00');
INSERT INTO public.question_parts VALUES ('92b55f57-6c1b-4d3b-b27c-fe188a733dc7', '6b136041-1009-4055-b7b8-457d3063ff73', 'a', 'The equation for the reaction is $\mathrm {C a C O} _ {3} (\dots \dots \dots) + 2 \mathrm {H C l} (\dots \dots \dots) \rightarrow \mathrm {C a C l} _ {2} (\dots \dots \dots) + \mathrm {H} _ {2} \mathrm {O} (\dots \dots \dots) + \mathrm {C O} _ {2} (\dots \dots \dots)$ Insert state symbols after each formula.', NULL, 0, 0, '2026-09-13 12:52:25.611766+00');
INSERT INTO public.question_parts VALUES ('c4e3d694-6759-472e-a89a-092baadcf148', '6b136041-1009-4055-b7b8-457d3063ff73', 'b', 'One of the students used this apparatus.', NULL, 0, 1, '2026-09-13 12:52:25.611791+00');
INSERT INTO public.question_parts VALUES ('60cefe15-8a12-4dc2-97c5-b1f9fd9a6242', '6b136041-1009-4055-b7b8-457d3063ff73', 'b-i', 'What is the purpose of the cotton wool?', NULL, 0, 2, '2026-09-13 12:52:25.611815+00');
INSERT INTO public.question_parts VALUES ('f9983670-745c-410c-a602-dbfa304f05bb', '6b136041-1009-4055-b7b8-457d3063ff73', 'b-ii', 'He recorded the total mass of the conical flask and contents every 30 seconds for several minutes. He plotted the results as a graph of total mass (y-axis) against time. Which of the graphs could represent his results? Put a cross ( $ \times $ ) in a box to indicate your answer.', NULL, 1, 3, '2026-09-13 12:52:25.611832+00');
INSERT INTO public.question_parts VALUES ('ebe8c504-89c2-47bb-8c57-4924d004a3df', '6b136041-1009-4055-b7b8-457d3063ff73', 'c', 'Another student carried out three experiments to investigate the effect of changing the concentration and temperature of hydrochloric acid on the rate of reaction. She kept the number and size of marble chips the same in each experiment. The marble chips were in excess. In each experiment she measured the volume of gas collected at different times, using this apparatus. The graph shows the results of her experiments. Volume of gas collected in $ \mathrm{c m^{3}} $', NULL, 0, 4, '2026-09-13 12:52:25.611854+00');
INSERT INTO public.question_parts VALUES ('8bbb3ed3-90d9-4c45-ab33-e57fdae4a8b3', '6b136041-1009-4055-b7b8-457d3063ff73', 'c-i', 'Experiments A and B represent experiments using the same concentration of hydrochloric acid but at different temperatures. Which letter represents the experiment at the higher temperature? Give a reason for your choice. Reason', NULL, 0, 5, '2026-09-13 12:52:25.611873+00');
INSERT INTO public.question_parts VALUES ('a4f70740-38a6-420e-aef9-58327b0f5acf', '6b136041-1009-4055-b7b8-457d3063ff73', 'c-ii', 'Experiments B and C represent experiments at the same temperatures and using the same volumes of hydrochloric acid. The concentration of hydrochloric acid used in experiment B is 0.20 mol/dm $ ^{3} $ What is the concentration of hydrochloric acid used in experiment C? Explain how you worked out your answer. Concentration Explanation', NULL, 0, 6, '2026-09-13 12:52:25.611891+00');
INSERT INTO public.question_parts VALUES ('2808a487-6cc8-4620-b969-a0839da8be65', '6b136041-1009-4055-b7b8-457d3063ff73', 'd', '', NULL, 0, 7, '2026-09-13 12:52:25.611914+00');
INSERT INTO public.question_parts VALUES ('f19bdd66-e7c7-4036-9f97-918fc65c2626', '6b136041-1009-4055-b7b8-457d3063ff73', 'd-i', 'Plot these results on the grid. Draw a straight line of best fit through the points. Rate of reaction in $ \mathrm{c m^{3} / m i n} $ Concentration of acid in mol/dm $ ^{3} $', NULL, 0, 8, '2026-09-13 12:52:25.61193+00');
INSERT INTO public.question_parts VALUES ('0cfcbe7d-639c-40f1-9d9b-aa71e06d03d9', '6b136041-1009-4055-b7b8-457d3063ff73', 'd-ii', 'Describe the relationship between rate of reaction and concentration of acid shown by the graph.', NULL, 2, 9, '2026-09-13 12:52:25.611948+00');
INSERT INTO public.question_parts VALUES ('9dd15961-67b4-4182-9694-47129203b937', '6b136041-1009-4055-b7b8-457d3063ff73', 'd-iii', 'Explain why increasing the concentration has this effect on the rate of reaction.', NULL, 0, 10, '2026-09-13 12:52:25.611969+00');
INSERT INTO public.question_parts VALUES ('7b296836-6ce4-4e76-ab0c-8ac5b74d23c3', '2e118484-350f-4661-8ba4-175d03ef7f84', 'b', 'Another student was given a pale violet solid. He was told that it contained two cations (positive ions) from this list $\mathrm {L i} ^ {+} \quad \mathrm {C a} ^ {2 +} \quad \mathrm {F e} ^ {2 +} \quad \mathrm {N H} _ {4} ^ {+} \quad \mathrm {F e} ^ {3 +}$ He performed a flame test on the solid. He then dissolved a small sample of the solid in water. A yellow solution was formed. He added sodium hydroxide solution and then warmed the mixture. The table shows his observations.', NULL, 0, 3, '2026-09-13 12:52:25.612055+00');
INSERT INTO public.question_parts VALUES ('200d228e-37cb-477a-a25e-d2eed8a524a6', '2e118484-350f-4661-8ba4-175d03ef7f84', 'b-i', 'The flame test gave no positive result. State the two cations from the list that are not present in the solid.', NULL, 0, 4, '2026-09-13 12:52:25.612076+00');
INSERT INTO public.question_parts VALUES ('7fa268cd-dc96-47f3-a884-49ce3ca75bf6', '2e118484-350f-4661-8ba4-175d03ef7f84', 'b-ii', 'Identify the pungent-smelling gas given off and explain why the red litmus paper must be damp before it is used.', NULL, 0, 5, '2026-09-13 12:52:25.612093+00');
INSERT INTO public.question_parts VALUES ('1164a275-ca3c-4985-ad43-c9dce774e251', '2e118484-350f-4661-8ba4-175d03ef7f84', 'b-iii', 'Identify the two cations present in the pale violet solid.', NULL, 0, 6, '2026-09-13 12:52:25.61211+00');
INSERT INTO public.question_parts VALUES ('88aac761-bb0c-4c45-9537-40e7dfa1e77d', 'c3390427-20b2-4826-9e20-ee345113ca55', 'a', 'Give the name of this piece of apparatus.', NULL, 0, 0, '2026-09-13 12:52:25.612133+00');
INSERT INTO public.question_parts VALUES ('b0e40c0a-e88a-4410-a6b0-f01f1f2ad2f9', 'c3390427-20b2-4826-9e20-ee345113ca55', 'a-ii', 'What volume of hydrochloric acid is in the apparatus?', NULL, 0, 1, '2026-09-13 12:52:25.612155+00');
INSERT INTO public.question_parts VALUES ('633a2ad4-7b2a-4b0a-9989-bb04208e858c', 'c3390427-20b2-4826-9e20-ee345113ca55', 'a-iii', 'Use your answer in (a)(ii) to calculate the amount, in moles, of hydrochloric acid in the apparatus.', NULL, 0, 2, '2026-09-13 12:52:25.612191+00');
INSERT INTO public.question_parts VALUES ('120b8340-85bd-4160-a50e-e8b3f87ced22', 'c3390427-20b2-4826-9e20-ee345113ca55', 'b', 'A student poured a solution containing 0.010 mol of hydrochloric acid into a beaker. He then added 0.0075 mol of zinc powder and collected the hydrogen given off in a gas syringe. The equation for the reaction is $\mathrm {Z n} (\mathrm {s}) + 2 \mathrm {H C l} (\mathrm {a q}) \rightarrow \mathrm {Z n C l} _ {2} (\mathrm {a q}) + \mathrm {H} _ {2} (\mathrm {g})$ Is the zinc or the hydrochloric acid in excess? Explain your answer.', NULL, 0, 3, '2026-09-13 12:52:25.612276+00');
INSERT INTO public.question_parts VALUES ('908ac72d-b7cc-4628-a87e-bec96a84c1c4', 'c3390427-20b2-4826-9e20-ee345113ca55', 'c', 'The student repeated the experiment with 0.0075 mol of magnesium powder with the same total surface area as the zinc. The equation for the reaction is $\mathrm {M g} (\mathrm {s}) + 2 \mathrm {H C l} (\mathrm {a q}) \rightarrow \mathrm {M g C l} _ {2} (\mathrm {a q}) + \mathrm {H} _ {2} (\mathrm {g})$', NULL, 0, 4, '2026-09-13 12:52:25.612367+00');
INSERT INTO public.question_parts VALUES ('f9e7fed6-819e-49a5-860f-407e5ad82c83', 'c3390427-20b2-4826-9e20-ee345113ca55', 'c-i', 'What effect would this change have on the rate at which the hydrogen is given off?', NULL, 0, 5, '2026-09-13 12:52:25.61239+00');
INSERT INTO public.question_parts VALUES ('298c0adc-924c-4284-bffb-a5e92c54c00a', 'c3390427-20b2-4826-9e20-ee345113ca55', 'c-ii', 'What effect would this change have on the volume of hydrogen produced?', NULL, 0, 6, '2026-09-13 12:52:25.612415+00');
INSERT INTO public.question_parts VALUES ('8e4af8b6-f685-48d1-9fdb-a8b1c47492e5', '5ac53282-e092-43fe-b237-f44d04445530', 'a', 'State two features of a reaction mixture that is in dynamic equilibrium.', NULL, 0, 0, '2026-09-13 12:52:25.612442+00');
INSERT INTO public.question_parts VALUES ('4429675f-96c6-49b2-b6de-af408c1b6b64', '5ac53282-e092-43fe-b237-f44d04445530', 'b', 'Use the graph to state the effect on the percentage of ammonia at equilibrium of the following changes an increase in temperature at constant pressure an increase in pressure at constant temperature. Write your answers in the table.', NULL, 0, 1, '2026-09-13 12:52:25.612466+00');
INSERT INTO public.question_parts VALUES ('ba0aba75-41e2-4eef-aef9-a9d65b03b1ba', '5ac53282-e092-43fe-b237-f44d04445530', 'b-ii', 'Explain why these changes have the effects you have given in (b)(i). Increase in temperature. Increase in pressure.', NULL, 0, 2, '2026-09-13 12:52:25.612488+00');
INSERT INTO public.question_parts VALUES ('7fc9b94f-9c7f-4509-8796-30cbfddab89d', '5ac53282-e092-43fe-b237-f44d04445530', 'c', 'The reaction between nitrogen and hydrogen is used to manufacture ammonia in the Haber process. This process operates at a pressure of 200 atmospheres and a temperature of $ 4 5 0^{\circ} \mathrm{C} $ , with an iron catalyst. If the reaction mixture reached a position of equilibrium, the expected yield of ammonia would be about 30%. The actual yield of ammonia obtained in the Haber process is about 15%.', NULL, 0, 3, '2026-09-13 12:52:25.612505+00');
INSERT INTO public.question_parts VALUES ('0c2a66c9-bc1e-4fe2-afea-db46b2052bab', '5ac53282-e092-43fe-b237-f44d04445530', 'c-i', 'Suggest why the actual yield of ammonia is lower than the expected yield.', NULL, 0, 4, '2026-09-13 12:52:25.612529+00');
INSERT INTO public.question_parts VALUES ('39fcf851-0160-4de7-a1f3-28d7727b3a69', '5ac53282-e092-43fe-b237-f44d04445530', 'c-ii', 'How is the ammonia separated from the unreacted nitrogen and hydrogen?', NULL, 0, 5, '2026-09-13 12:52:25.612552+00');
INSERT INTO public.question_parts VALUES ('d68da07a-7139-4832-bd31-3124542c21b9', '5ac53282-e092-43fe-b237-f44d04445530', 'c-iii', 'What happens to the unreacted nitrogen and hydrogen?', NULL, 0, 6, '2026-09-13 12:52:25.612574+00');
INSERT INTO public.question_parts VALUES ('b5a92adc-50c3-4022-a111-6a0f1f455c76', '5ac53282-e092-43fe-b237-f44d04445530', 'd', 'The reaction would be faster if a higher temperature were used. Suggest why a higher temperature is not used in the Haber process.', NULL, 0, 7, '2026-09-13 12:52:25.612611+00');
INSERT INTO public.question_parts VALUES ('868b119b-e63b-40e6-b4cc-ac42ea56c16c', '5ac53282-e092-43fe-b237-f44d04445530', 'e', 'The equation for the formation of ammonia is $\mathrm {N} _ {2} (\mathrm {g}) + 3 \mathrm {H} _ {2} (\mathrm {g}) \rightleftharpoons 2 \mathrm {N H} _ {3} (\mathrm {g})$', NULL, 0, 8, '2026-09-13 12:52:25.61263+00');
