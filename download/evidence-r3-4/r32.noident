INSERT INTO public.question_parts VALUES ('36be1bf7-a22d-4f31-8e31-c8fb04375986', '6a94fe9b-a530-485a-96bd-32e34fd4b324', 'd', 'Hydrogen chloride is dissolved in methylbenzene. When a piece of magnesium ribbon is then added to this solution there is no reaction. When water is added to this mixture and it is shaken, a reaction occurs. Explain the observation in this reaction.', NULL, 0, 3, '2026-09-13 12:53:55.962003+00');
INSERT INTO public.question_parts VALUES ('24058257-b3fc-48d2-9da1-00dd0b88d3d4', '6a94fe9b-a530-485a-96bd-32e34fd4b324', 'e', 'Halogens can take part in displacement reactions with halides. The table gives information about the addition of halogen solutions to halide solutions.', NULL, 0, 4, '2026-09-13 12:53:55.962031+00');
INSERT INTO public.question_parts VALUES ('e7be3f4e-1def-45a1-b351-81a0af436364', '6a94fe9b-a530-485a-96bd-32e34fd4b324', 'e-i', 'Explain which test gives a result that cannot be used to compare the reactivities of halogens.', NULL, 0, 5, '2026-09-13 12:53:55.962292+00');
INSERT INTO public.question_parts VALUES ('f5f0d9db-a018-429f-a18c-ed9dfd60fcde', '6a94fe9b-a530-485a-96bd-32e34fd4b324', 'e-ii', 'Which observation shows that a displacement reaction occurs in test 1? A effervescence is seen B purple fumes appear C the solution becomes darker D a white precipitate forms', NULL, 0, 6, '2026-09-13 12:53:55.962348+00');
INSERT INTO public.question_parts VALUES ('f4a773f6-0f83-4af8-8e6f-09f8a348e92b', '6a94fe9b-a530-485a-96bd-32e34fd4b324', 'f', 'Astatine is an element in Group 7 that could also be involved in displacement reactions. The ionic half-equations for one of these reactions would be $\mathrm {C l} _ {2} + 2 \mathrm {e} ^ {-} \rightarrow 2 \mathrm {C l} ^ {-}$ $2 \mathrm {A t} ^ {-} \rightarrow \mathrm {A t} _ {2} + 2 \mathrm {e} ^ {-}$', NULL, 0, 7, '2026-09-13 12:53:55.962382+00');
INSERT INTO public.question_parts VALUES ('07ec4662-71e2-419b-a0f9-010779de8715', '6a94fe9b-a530-485a-96bd-32e34fd4b324', 'f-i', 'Write an ionic equation for this displacement reaction.', NULL, 0, 8, '2026-09-13 12:53:55.962419+00');
INSERT INTO public.question_parts VALUES ('4e74b332-7d4f-4043-b8ca-293efaea008c', '6a94fe9b-a530-485a-96bd-32e34fd4b324', 'f-ii', 'Explain, with reference to the appropriate species and to electrons, why this reaction is described as a redox reaction.', NULL, 0, 9, '2026-09-13 12:53:55.962453+00');
INSERT INTO public.question_parts VALUES ('3b5e15bb-bd81-4638-90ef-4a71f5235f2f', '69f8ec33-a4aa-4755-a125-3c2210fad634', 'a', 'A student draws this labelled diagram to show the particles in magnesium metal. He makes two mistakes. State the two corrections he should make to his labelled diagram.', NULL, 0, 0, '2026-09-13 12:53:55.962502+00');
INSERT INTO public.question_parts VALUES ('68166961-a392-4af6-841c-49ebc6c03dcb', '69f8ec33-a4aa-4755-a125-3c2210fad634', 'b', 'Explain why magnesium metal is malleable and a good conductor of electricity.', NULL, 0, 1, '2026-09-13 12:53:55.96254+00');
INSERT INTO public.question_parts VALUES ('7f7f7888-2259-4756-8ca8-b894f54906ae', '69f8ec33-a4aa-4755-a125-3c2210fad634', 'c', 'Magnesium is a reactive metal. Its reactivity can be seen in its reactions with oxygen and dilute sulfuric acid. The chemical equations for these reactions are reaction 1 $2 \mathrm {M g} + \mathrm {O} _ {2} \rightarrow 2 \mathrm {M g O}$ reaction 2 $\mathrm {M g} + \mathrm {H} _ {2} \mathrm {S O} _ {4} \rightarrow \mathrm {M g S O} _ {4} + \mathrm {H} _ {2}$', NULL, 0, 2, '2026-09-13 12:53:55.962588+00');
INSERT INTO public.question_parts VALUES ('0a1c6c2b-ea31-4880-a910-ee5696131f88', '69f8ec33-a4aa-4755-a125-3c2210fad634', 'c-i', 'In reaction 1, some magnesium is ignited and then placed in a jar of oxygen gas. State two observations that would be made.', NULL, 0, 3, '2026-09-13 12:53:55.96265+00');
INSERT INTO public.question_parts VALUES ('7a226094-7d78-4eb1-a982-8c81b9ffdd97', '69f8ec33-a4aa-4755-a125-3c2210fad634', 'c-ii', 'Which of these is a correct statement about the gas formed in reaction 2? A it makes a squeaky pop with a lighted splint B it relights a glowing splint D it turns limewater milky C it turns damp blue litmus paper red', NULL, 0, 4, '2026-09-13 12:53:55.962709+00');
INSERT INTO public.question_parts VALUES ('a2b2e19c-8437-47e0-a00b-e208d606b76a', '69f8ec33-a4aa-4755-a125-3c2210fad634', 'd', 'The student used this method to obtain a sample of magnesium sulfate crystals from the solution formed in reaction 2. heat the solution in a beaker for several minutes dip a glass rod into the hot solution for a few seconds and then remove it allow the solution to cool to room temperature filter off the crystals and then dry them', NULL, 0, 5, '2026-09-13 12:53:55.962755+00');
INSERT INTO public.question_parts VALUES ('1d14b23e-712a-4105-8473-0c601cb6570d', '69f8ec33-a4aa-4755-a125-3c2210fad634', 'd-i', 'Why does the student heat the solution?', NULL, 0, 6, '2026-09-13 12:53:55.962789+00');
INSERT INTO public.question_parts VALUES ('213f18c6-c8fd-4ccd-af5a-69cf3e061af3', '69f8ec33-a4aa-4755-a125-3c2210fad634', 'd-ii', 'Explain why the student dips a glass rod into the heated solution.', NULL, 0, 7, '2026-09-13 12:53:55.962821+00');
INSERT INTO public.question_parts VALUES ('e949690b-779d-4501-85de-00aea7d6a449', '69f8ec33-a4aa-4755-a125-3c2210fad634', 'd-iii', 'Give the formulae of the two compounds that pass through the filter paper.', NULL, 0, 8, '2026-09-13 12:53:55.962854+00');
INSERT INTO public.question_parts VALUES ('917a26b3-9915-4305-86df-4d6d08d9cb0c', '69f8ec33-a4aa-4755-a125-3c2210fad634', 'e', 'After drying the crystals, the student weighs them and then heats them until they reach a constant mass. This equation represents the change that occurs during heating. $\mathrm {M g S O} _ {4}. \mathrm {x H} _ {2} \mathrm {O} \rightarrow \mathrm {M g S O} _ {4} + \mathrm {x H} _ {2} \mathrm {O}$ These are the student''s results. mass of dry crystals before heating = 17.2g mass of crystals after heating to a constant mass = 8.3 g Use these results to find the value of x in the formula of $ \mathrm{M g S O_{4}. x H_{2}O} $ $ [M_{r} $ values: $ \mathrm{M g S O_{4}=1 2 0}, $ $ \mathrm{H_{2}O=1 8} $', NULL, 0, 9, '2026-09-13 12:53:55.962882+00');
INSERT INTO public.question_parts VALUES ('5149cb75-f75e-4c75-b4a5-3990f9c860e6', '6d2259d9-b25d-4b84-ae34-d9d3c2910187', 'a', 'The diagram gives information about the reactions of some calcium compounds used to make mortar. Mortar contains calcium hydroxide and is used to join bricks together when building walls. These reactions occur when the calcium hydroxide in mortar is obtained from calcium carbonate. calcium carbonate is strongly heated to form calcium oxide water is added to calcium oxide to form calcium hydroxide', NULL, 0, 0, '2026-09-13 12:53:55.962927+00');
INSERT INTO public.question_parts VALUES ('035b6af0-aaa3-42b7-a82b-5eebf10a0cf6', '6d2259d9-b25d-4b84-ae34-d9d3c2910187', 'a-i', 'The equation for one of these reactions is $\mathrm {C a O} + \mathrm {H} _ {2} \mathrm {O} \rightarrow \mathrm {C a} (\mathrm {O H}) _ {2}$ The calcium hydroxide in mortar reacts with carbon dioxide from the atmosphere to form calcium carbonate. Calculate the mass of water needed to react exactly with 28 kg of calcium oxide.', NULL, 0, 1, '2026-09-13 12:53:55.962962+00');
INSERT INTO public.question_parts VALUES ('bb966b08-4ac9-44f2-ab6e-96ce33868308', '6d2259d9-b25d-4b84-ae34-d9d3c2910187', 'a-ii', 'Explain why the reaction between carbon dioxide and calcium hydroxide can be described as neutralisation.', NULL, 0, 2, '2026-09-13 12:53:55.962993+00');
INSERT INTO public.question_parts VALUES ('daadd21b-6acb-4ec4-9b2d-67048c69b612', '6d2259d9-b25d-4b84-ae34-d9d3c2910187', 'b', 'Calcium carbide is a reactive solid. When water is added to it, a gas (ethyne) is formed. A teacher uses this apparatus to investigate the rate of reaction between calcium carbide and water. This is the teacher''s method. record the temperature of the water in the flask add a known mass of calcium carbide and replace the bung in the flask record the time taken to collect $ 1 0 0 \mathrm{c m}^{3} $ of gas in the syringe The teacher repeats the experiment using the same volume of water and the same mass of calcium carbide, but with the water at different temperatures. The table shows the results for six different temperatures. Plot these results on the grid and draw a curve of best fit.', NULL, 0, 3, '2026-09-13 12:53:55.963031+00');
INSERT INTO public.question_parts VALUES ('741b0b4e-2582-4a00-a3a0-6ebe35011b62', '6d2259d9-b25d-4b84-ae34-d9d3c2910187', 'c', 'The teacher plots this graph to show how the rate of reaction varies with temperature. Rate of reaction in $ cm^{3}/s $ Her graph shows that the rate of reaction is not directly proportional to temperature. There are two reasons why the rate of reaction increases as the temperature increases. One reason is that the water molecules move more quickly and collide more frequently with calcium carbide particles. Explain the other reason for the increase in the rate of reaction. Every effort has been made to contact copyright holders to obtain their permission for the use of copyright material. Pearson Education Ltd. will, if notified, be happy to rectify any errors or omissions and include any such rectifications in future editions.', NULL, 0, 4, '2026-09-13 12:53:55.963059+00');
INSERT INTO public.question_parts VALUES ('0f4e09f0-5bb6-4169-af56-9c1c97910cc6', '4674bf9a-d97a-4fcc-90de-71cf586d4cb1', 'a', 'Which of these is the formula for a molecule of bromine? A 2Br B $ \mathrm{B r^{2}} $ Br2 C D $ \mathrm{B r}_{2} $', NULL, 0, 0, '2026-09-13 12:53:56.168788+00');
INSERT INTO public.question_parts VALUES ('e4ac2290-aea5-4c35-9b61-8e0c95038fbe', 'fa9775f8-437d-43df-aa85-8ac3ccaebac3', 'c-ii', 'State how litmus paper can be used to show that the solution is acidic.', NULL, 0, 6, '2026-09-13 12:53:56.402011+00');
INSERT INTO public.question_parts VALUES ('bbf524a7-e659-4d3e-9fc9-2b12913bc0ed', '4674bf9a-d97a-4fcc-90de-71cf586d4cb1', 'b', 'A small amount of liquid bromine is placed in a gas jar containing air. The jar is then sealed. After two minutes, a brown gas is seen just above the surface of the liquid. After two hours, the whole gas jar is full of the brown gas. after two minutes after two hours', NULL, 0, 1, '2026-09-13 12:53:56.168885+00');
INSERT INTO public.question_parts VALUES ('32e699c4-dd52-411d-85c4-313bb62f4cf5', '4674bf9a-d97a-4fcc-90de-71cf586d4cb1', 'b-i', 'Which of these is the process that causes the brown gas to fill the gas jar? A condensation B diffusion evaporation sublimation', NULL, 0, 2, '2026-09-13 12:53:56.168926+00');
INSERT INTO public.question_parts VALUES ('282612a7-6a69-4f53-9b0e-6444251532fd', '4674bf9a-d97a-4fcc-90de-71cf586d4cb1', 'b-ii', 'Explain, using the particle theory, the observations seen in the gas jar.', NULL, 0, 3, '2026-09-13 12:53:56.168953+00');
