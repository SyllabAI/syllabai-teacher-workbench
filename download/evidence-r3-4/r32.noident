INSERT INTO public.question_parts VALUES ('873c9a60-f33b-49a6-b5d9-668bc8b797a9', 'eeec0bf7-89ec-40e0-8105-2ba04ead08a6', 'd-i', 'Balance the chemical equations for these reactions. $\begin{array}{l} \mathrm {C H} _ {4} + \mathrm {O} _ {2} \rightarrow \mathrm {C O} _ {2} + \mathrm {H} _ {2} \mathrm {O} \\ \mathrm {C} _ {2} \mathrm {H} _ {4} + \mathrm {O} _ {2} \rightarrow \mathrm {C O} + \mathrm {H} _ {2} \mathrm {O} \\ \end{array}$', NULL, 0, 4, '2026-09-13 12:53:55.675462+00');
