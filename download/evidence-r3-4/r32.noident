d0a4b1656a058a162b92c6f5c5d4f7b", "assetId": "img:b7c42e0da40b6a126a3c6523526356fded0a4b1656a058a162b92c6f5c5d4f7b", "mimeType": "image/jpeg", "elementId": "e000079", "sourceName": "assets/crop_1_1789064067510.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789064067515.png", "width": 379, "format": "png", "height": 277, "sha256": "e24d4ac0cbf8c4e5adbb607758e4f914826d3fdc9c2bfbdecaef23a45317104e", "assetId": "img:e24d4ac0cbf8c4e5adbb607758e4f914826d3fdc9c2bfbdecaef23a45317104e", "mimeType": "image/jpeg", "elementId": "e000081", "sourceName": "assets/crop_2_1789064067515.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_3_1789064067519.png", "width": 377, "format": "png", "height": 277, "sha256": "d9d95155ba0bf7bb00ed054214db8d5c9fac9c348e50b4cdf2809be609e39384", "assetId": "img:d9d95155ba0bf7bb00ed054214db8d5c9fac9c348e50b4cdf2809be609e39384", "mimeType": "image/jpeg", "elementId": "e000084", "sourceName": "assets/crop_3_1789064067519.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_4_1789064067524.png", "width": 386, "format": "png", "height": 278, "sha256": "6a55aed5236369fd81ab204a977f95cd6a2d77e62c0fe4e891322319acf7fb36", "assetId": "img:6a55aed5236369fd81ab204a977f95cd6a2d77e62c0fe4e891322319acf7fb36", "mimeType": "image/jpeg", "elementId": "e000086", "sourceName": "assets/crop_4_1789064067524.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_5_1789064067530.png", "width": 330, "format": "png", "height": 273, "sha256": "2fef755f069e496aedd78fa282a53ed0019f1ff35268934e58821631b90d966e", "assetId": "img:2fef755f069e496aedd78fa282a53ed0019f1ff35268934e58821631b90d966e", "mimeType": "image/jpeg", "elementId": "e000088", "sourceName": "assets/crop_5_1789064067530.png", "availability": "available", "formatMismatch": true}], "confidence": 0.8, "answerPrompts": []}, {"qwc": false, "text": "Explain, in terms of its structure and bonding, why sodium fluoride has a high melting point.", "label": "d", "marks": 4, "partId": "q04-3097a144-pd", "figures": [], "confidence": 0.8, "answerPrompts": []}], "number": 4, "figures": [{"url": "assets/crop_1_1789064067471.png", "width": 478, "format": "png", "height": 447, "sha256": "0f1718b29248398f6a05c1d1ff57adddba867b8ee2611036f8a2602a3f631ca5", "assetId": "img:0f1718b29248398f6a05c1d1ff57adddba867b8ee2611036f8a2602a3f631ca5", "mimeType": "image/jpeg", "elementId": "e000067", "sourceName": "assets/crop_1_1789064067471.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789064067481.png", "width": 268, "format": "png", "height": 268, "sha256": "333c26219a1b4666dac52402e83d1c4daa1345ebf3e048ca7c8448dfc01aacf1", "assetId": "img:333c26219a1b4666dac52402e83d1c4daa1345ebf3e048ca7c8448dfc01aacf1", "mimeType": "image/jpeg", "elementId": "e000069", "sourceName": "assets/crop_2_1789064067481.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_3_1789064067486.png", "width": 269, "format": "png", "height": 269, "sha256": "c3b02e5fdd50c0b8ea19671eb6720903d82437cf3a8b7fe5c8acf511345d6888", "assetId": "img:c3b02e5fdd50c0b8ea19671eb6720903d82437cf3a8b7fe5c8acf511345d6888", "mimeType": "image/jpeg", "elementId": "e000071", "sourceName": "assets/crop_3_1789064067486.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_4_1789064067491.png", "width": 270, "format": "png", "height": 269, "sha256": "4f5d744334466b1ab121a0b3f808f711398f8e66c2a47ecc5eb7b62a65fd8732", "assetId": "img:4f5d744334466b1ab121a0b3f808f711398f8e66c2a47ecc5eb7b62a65fd8732", "mimeType": "image/jpeg", "elementId": "e000073", "sourceName": "assets/crop_4_1789064067491.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_5_1789064067496.png", "width": 266, "format": "png", "height": 244, "sha256": "21b5cc872152b563ebe492b3553ba9fca511b86ba844879faf29d6f804b32a09", "assetId": "img:21b5cc872152b563ebe492b3553ba9fca511b86ba844879faf29d6f804b32a09", "mimeType": "image/jpeg", "elementId": "e000075", "sourceName": "assets/crop_5_1789064067496.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_1_1789064067510.png", "width": 377, "format": "png", "height": 295, "sha256": "b7c42e0da40b6a126a3c6523526356fded0a4b1656a058a162b92c6f5c5d4f7b", "assetId": "img:b7c42e0da40b6a126a3c6523526356fded0a4b1656a058a162b92c6f5c5d4f7b", "mimeType": "image/jpeg", "elementId": "e000079", "sourceName": "assets/crop_1_1789064067510.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789064067515.png", "width": 379, "format": "png", "height": 277, "sha256": "e24d4ac0cbf8c4e5adbb607758e4f914826d3fdc9c2bfbdecaef23a45317104e", "assetId": "img:e24d4ac0cbf8c4e5adbb607758e4f914826d3fdc9c2bfbdecaef23a45317104e", "mimeType": "image/jpeg", "elementId": "e000081", "sourceName": "assets/crop_2_1789064067515.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_3_1789064067519.png", "width": 377, "format": "png", "height": 277, "sha256": "d9d95155ba0bf7bb00ed054214db8d5c9fac9c348e50b4cdf2809be609e39384", "assetId": "img:d9d95155ba0bf7bb00ed054214db8d5c9fac9c348e50b4cdf2809be609e39384", "mimeType": "image/jpeg", "elementId": "e000084", "sourceName": "assets/crop_3_1789064067519.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_4_1789064067524.png", "width": 386, "format": "png", "height": 278, "sha256": "6a55aed5236369fd81ab204a977f95cd6a2d77e62c0fe4e891322319acf7fb36", "assetId": "img:6a55aed5236369fd81ab204a977f95cd6a2d77e62c0fe4e891322319acf7fb36", "mimeType": "image/jpeg", "elementId": "e000086", "sourceName": "assets/crop_4_1789064067524.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_5_1789064067530.png", "width": 330, "format": "png", "height": 273, "sha256": "2fef755f069e496aedd78fa282a53ed0019f1ff35268934e58821631b90d966e", "assetId": "img:2fef755f069e496aedd78fa282a53ed0019f1ff35268934e58821631b90d966e", "mimeType": "image/jpeg", "elementId": "e000088", "sourceName": "assets/crop_5_1789064067530.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.45, "marksKnown": false, "questionId": "q04-3097a144", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "A student finds the temperature change when a mass of 0.5 g of sodium hydrogencarbonate is added to $ 5 0 \\mathrm{c m}^{3} $ of a solution of citric acid. She repeats the experiment using masses of 1.0g, 1.5g and 2.0g of sodium hydrogencarbonate.", "marks": 6, "parts": [{"qwc": false, "text": "The diagrams of the thermometer show the lowest temperature reached, in $ ^{\\circ} \\mathrm{C} $ for each experiment. Use the diagrams to complete the table of results.", "label": "a", "marks": 2, "partId": "q05-3097a144-pa", "figures": [{"url": "assets/crop_2_1789064067562.png", "width": 1401, "format": "png", "height": 531, "sha256": "037a3575ac2861051c7c479525c4b90efcad514e60ee0b7b8279e0cfd46d6e71", "assetId": "img:037a3575ac2861051c7c479525c4b90efcad514e60ee0b7b8279e0cfd46d6e71", "mimeType": "image/jpeg", "elementId": "e000096", "sourceName": "assets/crop_2_1789064067562.png", "availability": "available", "formatMismatch": true}], "confidence": 0.8, "answerPrompts": []}, {"qwc": false, "text": "Another student does the experiment. The table shows his results.", "label": "b", "marks": null, "partId": "q05-3097a144-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Plot this student''s results on the grid. Draw a straight line of best fit through the first three points and another straight line of best fit through the last two points. Make sure the two lines cross. Mass of sodium hydrogencarbonate in g", "label": "b-i", "marks": 3, "partId": "q05-3097a144-pb-i", "figures": [{"url": "assets/crop_1_1789064067571.png", "width": 1597, "format": "png", "height": 1166, "sha256": "5cab00e3e028fcf57694ce46b227751f86ddcdb8247c38f3c33a056c6f23704c", "assetId": "img:5cab00e3e028fcf57694ce46b227751f86ddcdb8247c38f3c33a056c6f23704c", "mimeType": "image/jpeg", "elementId": "e000107", "sourceName": "assets/crop_1_1789064067571.png", "availability": "available", "formatMismatch": true}], "confidence": 0.8, "answerPrompts": []}, {"qwc": false, "text": "Use your graph to find the mass of sodium hydrogencarbonate required to produce a decrease in temperature of $ 3^{\\circ} \\mathrm{C}. $ mass = g", "label": "b-ii", "marks": null, "partId": "q05-3097a144-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 5, "figures": [{"url": "assets/crop_1_1789064067556.png", "width": 1024, "format": "png", "height": 528, "sha256": "dc911a3ab62873dcbeae1a951974ca44a7e2c4c8e0de452446d210f33d7d457d", "assetId": "img:dc911a3ab62873dcbeae1a951974ca44a7e2c4c8e0de452446d210f33d7d457d", "mimeType": "image/jpeg", "elementId": "e000094", "sourceName": "assets/crop_1_1789064067556.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789064067562.png", "width": 1401, "format": "png", "height": 531, "sha256": "037a3575ac2861051c7c479525c4b90efcad514e60ee0b7b8279e0cfd46d6e71", "assetId": "img:037a3575ac2861051c7c479525c4b90efcad514e60ee0b7b8279e0cfd46d6e71", "mimeType": "image/jpeg", "elementId": "e000096", "sourceName": "assets/crop_2_1789064067562.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_1_1789064067571.png", "width": 1597, "format": "png", "height": 1166, "sha256": "5cab00e3e028fcf57694ce46b227751f86ddcdb8247c38f3c33a056c6f23704c", "assetId": "img:5cab00e3e028fcf57694ce46b227751f86ddcdb8247c38f3c33a056c6f23704c", "mimeType": "image/jpeg", "elementId": "e000107", "sourceName": "assets/crop_1_1789064067571.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q05-3097a144", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000099", "e000102"]}, {"mcq": false, "qwc": false, "stem": "Poly(ethene) is an addition polymer made from ethene, $ \\mathrm{C_{2} H_{4}} $", "marks": 7, "parts": [{"qwc": false, "text": "Complete the equation to show the formation of poly(ethene) from ethene.", "label": "a", "marks": null, "partId": "q06-3097a144-pa", "figures": [{"url": "assets/crop_1_1789064067584.png", "width": 378, "format": "png", "height": 201, "sha256": "81434442a7aec0e7732e2fa0a606ffd57796887224380f3115d9ff6061151566", "assetId": "img:81434442a7aec0e7732e2fa0a606ffd57796887224380f3115d9ff6061151566", "mimeType": "image/jpeg", "elementId": "e000114", "sourceName": "assets/crop_1_1789064067584.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State why poly(ethene) is described as an addition polymer, not a condensation polymer.", "label": "b", "marks": null, "partId": "q06-3097a144-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Many shopping bags are made of poly(ethene).", "label": "c", "marks": null, "partId": "q06-3097a144-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "One useful property of poly(ethene) is that it is inert so it does not react with food. Explain two other properties of poly(ethene) that make it useful for shopping bags.", "label": "c-i", "marks": null, "partId": "q06-3097a144-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Another property of poly(ethene) is that it is non-biodegradable. Two methods of disposing of poly(ethene) are landfill and burning. Give one problem caused by each method of disposal. landfill. burning", "label": "c-ii", "marks": null, "partId": "q06-3097a144-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 6, "figures": [{"url": "assets/crop_1_1789064067584.png", "width": 378, "format": "png", "height": 201, "sha256": "81434442a7aec0e7732e2fa0a606ffd57796887224380f3115d9ff6061151566", "assetId": "img:81434442a7aec0e7732e2fa0a606ffd57796887224380f3115d9ff6061151566", "mimeType": "image/jpeg", "elementId": "e000114", "sourceName": "assets/crop_1_1789064067584.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q06-3097a144", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "Magnesium can be obtained by the electrolysis of magnesium chloride. Solid magnesium chloride is obtained from seawater. The magnesium chloride is melted and then electrolysed. The positive electrode is made of graphite and the negative electrode is made of steel. Magnesium forms at the negative electrode. Chlorine forms at the positive electrode.", "marks": 4, "parts": [{"qwc": false, "text": "Explain why the magnesium chloride has to be melted before it can be electrolysed.", "label": "a", "marks": null, "partId": "q07-3097a144-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Write an ionic half-equation to represent the formation of magnesium at the negative electrode.", "label": "b", "marks": null, "partId": "q07-3097a144-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Suggest why steel is not used for the positive electrode.", "label": "c", "marks": null, "partId": "q07-3097a144-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 7, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q07-3097a144", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "Submarines that spend a long time underwater use sodium peroxide $ \\mathrm{(N a_{2} O_{2})} $ to absorb carbon dioxide $ \\mathrm{(C O_{2})} $ from the air in the submarine. The equation for the reaction is $2 \\mathrm {N a} _ {2} \\mathrm {O} _ {2} + 2 \\mathrm {C O} _ {2} \\rightarrow 2 \\mathrm {N a} _ {2} \\mathrm {C O} _ {3} + \\mathrm {O} _ {2}$", "marks": 6, "parts": [{"qwc": false, "text": "There are 140 people on the submarine. Each person produces $ 4 8 0 \\mathrm{d m}^{3} $ of carbon dioxide per day.", "label": "a", "marks": null, "partId": "q08-3097a144-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the total amount, in moles, of carbon dioxide produced on the submarine in one day. [assume 1 mol of $ \\mathrm{C O_{2}} $ occupies $ 2 4. 0 \\mathrm{d m}^{3} $] $\\mathrm {C O} _ {2} =$", "label": "a-i", "marks": null, "partId": "q08-3097a144-pa-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the mass, in kilograms, of sodium peroxide required to absorb all of the carbon dioxide produced in the submarine in one day. $ [ M_{r} $ of $ \\mathrm{N a_{2} O_{2}}=7 8. 0 ] $ $\\mathrm {m a s s o f N a} _ {2} \\mathrm {O} _ {2} =$", "label": "a-ii", "marks": null, "partId": "q08-3097a144-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Spaceships use either lithium hydroxide (LiOH) or lithium peroxide $ \\mathrm{(L i_{2} O_{2})} $ to absorb carbon dioxide. Equation 1 The equations for the two reactions are $2 \\mathrm {L i O H} + \\mathrm {C O} _ {2} \\rightarrow \\mathrm {L i} _ {2} \\mathrm {C O} _ {3} + \\mathrm {H} _ {2} \\mathrm {O}$ Equation 2 $2 \\mathrm {L i} _ {2} \\mathrm {O} _ {2} + 2 \\mathrm {C O} _ {2} \\rightarrow 2 \\mathrm {L i} _ {2} \\mathrm {C O} _ {3} + \\mathrm {O} _ {2}$ Using information from the equations, give two reasons why lithium peroxide is more suitable than lithium hydroxide for use on spaceships.", "label": "b", "marks": null, "partId": "q08-3097a144-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 8, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q08-3097a144", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "Ethanol $ \\left( \\mathrm{C}_{2} \\mathrm{H}_{5} \\mathrm{O H} \\right) $ is made in industry by reacting ethene $ \\left( \\mathrm{C}_{2} \\mathrm{H}_{4} \\right) $ with steam at a temperature of $ 3 0 0^{\\circ} \\mathrm{C} $ and a pressure of 70 atm. The percentage yield of ethanol is 43%. The equation for the reaction is $\\mathrm {C} _ {2} \\mathrm {H} _ {4} (\\mathrm {g}) + \\mathrm {H} _ {2} \\mathrm {O} (\\mathrm {g}) \\rightleftharpoons \\mathrm {C} _ {2} \\mathrm {H} _ {5} \\mathrm {O H} (\\mathrm {g}) \\quad \\Delta H = - 4 5. 3 \\mathrm {k J / m o l}$", "marks": 9, "parts": [{"qwc": false, "text": "State what the symbols $ \\rightleftharpoons $ and $ \\Delta H $ represent. $ \\Delta H $", "label": "a", "marks": null, "partId": "q09-3097a144-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Name the catalyst used in this industrial process.", "label": "a-ii", "marks": null, "partId": "q09-3097a144-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Predict the effect on the yield of ethanol if the reaction is carried out at a temperature lower than $ 3 0 0^{\\circ} \\mathrm{C} $ , but at the same pressure of 70 atm. [assume reaction reaches equilibrium] Give a reason for your answer.", "label": "b", "marks": null, "partId": "q09-3097a144-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Predict the effect on the yield of ethanol if the reaction is carried out at a pressure lower than 70 atm, but at the same temperature of $ 3 0 0^{\\circ} \\mathrm{C}. $ [assume reaction reaches equilibrium] Give a reason for your answer.", "label": "b-ii", "marks": null, "partId": "q09-3097a144-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "One method of obtaining ethene is by cracking crude oil fractions. Ethene can also be made by passing ethanol vapour over a hot aluminium oxide catalyst. The equation for the reaction is $\\mathrm {C} _ {2} \\mathrm {H} _ {5} \\mathrm {O H} (\\mathrm {g}) \\rightarrow \\mathrm {C} _ {2} \\mathrm {H} _ {4} (\\mathrm {g}) + \\mathrm {H} _ {2} \\mathrm {O} (\\mathrm {g})$", "label": "c", "marks": null, "partId": "q09-3097a144-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State the type of reaction taking place.", "label": "c-i", "marks": null, "partId": "q09-3097a144-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Suggest why it may be necessary, in the future, to make ethene using this reaction rather than by cracking crude oil fractions.", "label": "c-ii", "marks": null, "partId": "q09-3097a144-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 9, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q09-3097a144", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "Samarium, Sm, is a metal used to make powerful magnets.", "marks": 7, "parts": [{"qwc": false, "text": "Samarium can be obtained by heating its oxide with lanthanum, La. $\\mathrm {S m} _ {2} \\mathrm {O} _ {3} + 2 \\mathrm {L a} \\rightarrow 2 \\mathrm {S m} + \\mathrm {L a} _ {2} \\mathrm {O} _ {3}$ The table shows the melting points of the substances involved in this reaction.", "label": "a", "marks": null, "partId": "q10-3097a144-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The operating temperature for this reaction is $ 1 0 3 0^{\\circ} \\mathrm{C} $ Explain which substance in the table could exist as a liquid at this temperature.", "label": "a-i", "marks": null, "partId": "q10-3097a144-pa-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Samarium oxide neutralises hydrochloric acid to form samarium chloride, $ \\mathrm{S m C l}_{3} $ Write a chemical equation for this reaction.", "label": "a-ii", "marks": null, "partId": "q10-3097a144-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The diagram shows the arrangement of the particles in samarium. Key samarium ion electron Explain why samarium is malleable and is a good conductor of electricity.", "label": "b", "marks": 4, "partId": "q10-3097a144-pb", "figures": [{"url": "assets/crop_1_1789064067625.png", "width": 498, "format": "png", "height": 251, "sha256": "61fff38cdb3e5c4f62fd5027e654c899d3bdaddf9a72bec9558e5ccca403e271", "assetId": "img:61fff38cdb3e5c4f62fd5027e654c899d3bdaddf9a72bec9558e5ccca403e271", "mimeType": "image/jpeg", "elementId": "e000171", "sourceName": "assets/crop_1_1789064067625.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789064067641.png", "width": 67, "format": "png", "height": 65, "sha256": "333689010c12a44ad5a3b5b65412c40a72b297c6dda0821ca65718f21248ee3d", "assetId": "img:333689010c12a44ad5a3b5b65412c40a72b297c6dda0821ca65718f21248ee3d", "mimeType": "image/jpeg", "elementId": "e000173", "sourceName": "assets/crop_2_1789064067641.png", "availability": "available", "formatMismatch": true}], "confidence": 0.8, "answerPrompts": []}], "number": 10, "figures": [{"url": "assets/crop_1_1789064067625.png", "width": 498, "format": "png", "height": 251, "sha256": "61fff38cdb3e5c4f62fd5027e654c899d3bdaddf9a72bec9558e5ccca403e271", "assetId": "img:61fff38cdb3e5c4f62fd5027e654c899d3bdaddf9a72bec9558e5ccca403e271", "mimeType": "image/jpeg", "elementId": "e000171", "sourceName": "assets/crop_1_1789064067625.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789064067641.png", "width": 67, "format": "png", "height": 65, "sha256": "333689010c12a44ad5a3b5b65412c40a7