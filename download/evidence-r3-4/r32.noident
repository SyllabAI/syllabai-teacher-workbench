arning", "questionNumber": null}, {"detail": "8: bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "8: bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "8: bare integer cell \"111\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "8: bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "9: bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "9: bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "9: bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "9: bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "9: bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "9: bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "9: bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "9: bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "10: bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "10: bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "10: bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}]', '{"paper": {"board": "Edexcel", "session": "June 2014", "subject": null, "duration": null, "examDate": "Tuesday 13 May 2014 – Morning", "logNumber": null, "qualification": null, "paperReference": "4CH0/1CR", "publicationCode": null, "canonicalDocumentId": "4ce232bc-1a80-567c-978f-62956eea3195"}, "warnings": ["unclassified heading: THE PERIODIC TABLE", "Q8: incomplete MCQ option set folded into stem"], "questions": [{"mcq": false, "qwc": false, "stem": "The compound with the formula $ \\mathrm{H}_{2} \\mathrm{O} $ can exist in three states of matter. The names of these three states are shown in the boxes. The numbers 1,2,3 and 4 represent changes of state.", "marks": 8, "parts": [{"qwc": false, "text": "The particles of $ \\mathrm{H}_{2} \\mathrm{O} $ are arranged differently in each state.", "label": "a", "marks": null, "partId": "q01-4ce232bc-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "In which state are the particles furthest apart?", "label": "a-i", "marks": null, "partId": "q01-4ce232bc-pa-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "In which state do the particles have the least energy?", "label": "a-ii", "marks": null, "partId": "q01-4ce232bc-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "In which state are the particles arranged in a regular pattern?", "label": "a-iii", "marks": null, "partId": "q01-4ce232bc-pa-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Change of state 1 is called A boiling B condensing C freezing D melting", "label": "b", "marks": null, "partId": "q01-4ce232bc-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Change of state 4 is called A boiling B condensing C freezing D melting", "label": "b-ii", "marks": null, "partId": "q01-4ce232bc-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The term sublimation is also used for a change of state Sublimation is the change of state from A solid to liquid B liquid to gas C gas to liquid D solid to gas", "label": "c", "marks": null, "partId": "q01-4ce232bc-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Heat energy is released when steam changes to water.", "label": "d", "marks": null, "partId": "q01-4ce232bc-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "What term is used to describe this type of energy change?", "label": "d-i", "marks": null, "partId": "q01-4ce232bc-pd-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Write an equation, including state symbols, for the change of state from steam to water.", "label": "d-ii", "marks": null, "partId": "q01-4ce232bc-pd-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 1, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q01-4ce232bc", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "The diagram shows four pieces of apparatus used in the separation of mixtures.", "marks": 14, "parts": [{"qwc": false, "text": "The apparatus labelled P is used for A crystallisation B filtration C fractional distillation D simple distillation", "label": "a", "marks": null, "partId": "q02-4ce232bc-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The apparatus labelled S is used for A crystallisation B filtration C fractional distillation D simple distillation", "label": "a-ii", "marks": null, "partId": "q02-4ce232bc-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Which method of separation should be used to obtain sand from a mixture containing salt, sand and water? A crystallisation B filtration C fractional distillation D simple distillation", "label": "b", "marks": null, "partId": "q02-4ce232bc-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Which method of separation should be used to obtain pure water from a mixture containing salt, sand and water? A crystallisation B filtration C fractional distillation D simple distillation", "label": "b-ii", "marks": null, "partId": "q02-4ce232bc-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Which method of separation should be used to obtain copper(II) sulfate from a mixture containing copper(II) sulfate and water? A crystallisation B filtration C fractional distillation D simple distillation", "label": "b-iii", "marks": null, "partId": "q02-4ce232bc-pb-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Food colourings contain one or more food dyes. A student used paper chromatography to separate the dyes contained in food colourings. She placed spots of three known food colourings (E, F and G) and one unknown food colouring (H) on the chromatography paper. The diagram shows the appearance of the paper before and after her experiment.", "label": "c", "marks": null, "partId": "q02-4ce232bc-pc", "figures": [{"url": "assets/crop_1_1789047663634.png", "width": 456, "format": "png", "height": 998, "sha256": "b3dacfe32ecd6c709f47922e8643c232d18ea90e021a91195ae974d82d22dedc", "assetId": "img:b3dacfe32ecd6c709f47922e8643c232d18ea90e021a91195ae974d82d22dedc", "mimeType": "image/jpeg", "elementId": "e000077", "sourceName": "assets/crop_1_1789047663634.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789047663639.png", "width": 811, "format": "png", "height": 957, "sha256": "290ae57ee3f5894a53538ad68515e6f9c4a882e8672f402ec94ae7bb8effd0d0", "assetId": "img:290ae57ee3f5894a53538ad68515e6f9c4a882e8672f402ec94ae7bb8effd0d0", "mimeType": "image/jpeg", "elementId": "e000078", "sourceName": "assets/crop_2_1789047663639.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Describe how the student should complete the experiment after placing the four spots on the paper.", "label": "c-i", "marks": 3, "partId": "q02-4ce232bc-pc-i", "figures": [], "confidence": 0.8, "answerPrompts": []}, {"qwc": false, "text": "Suggest why food colouring F did not move during the experiment.", "label": "c-ii", "marks": null, "partId": "q02-4ce232bc-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "How many food dyes are there in food colouring E?", "label": "c-iii", "marks": null, "partId": "q02-4ce232bc-pc-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "How many known food dyes are there in food colouring H?", "label": "c-iv", "marks": null, "partId": "q02-4ce232bc-pc-iv", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Dyes are often identified by their $ R_{\\mathrm{f}} $ values. $R _ {\\mathrm {f}} = \\frac {\\mathrm {d i s t a n c e m o v e d b y d y e}}{\\mathrm {d i s t a n c e m o v e d b y s o l v e n t}}$ Record the results for the dye in G and calculate its $ R_{\\mathrm{f}} $ value.", "label": "c-v", "marks": null, "partId": "q02-4ce232bc-pc-v", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 2, "figures": [{"url": "assets/crop_1_1789047663618.png", "width": 1569, "format": "png", "height": 1678, "sha256": "b80d78f52a029975165c6a2750e066517ff7f78a0144f5e7931cbf8f603b96b9", "assetId": "img:b80d78f52a029975165c6a2750e066517ff7f78a0144f5e7931cbf8f603b96b9", "mimeType": "image/jpeg", "elementId": "e000048", "sourceName": "assets/crop_1_1789047663618.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_1_1789047663634.png", "width": 456, "format": "png", "height": 998, "sha256": "b3dacfe32ecd6c709f47922e8643c232d18ea90e021a91195ae974d82d22dedc", "assetId": "img:b3dacfe32ecd6c709f47922e8643c232d18ea90e021a91195ae974d82d22dedc", "mimeType": "image/jpeg", "elementId": "e000077", "sourceName": "assets/crop_1_1789047663634.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789047663639.png", "width": 811, "format": "png", "height": 957, "sha256": "290ae57ee3f5894a53538ad68515e6f9c4a882e8672f402ec94ae7bb8effd0d0", "assetId": "img:290ae57ee3f5894a53538ad68515e6f9c4a882e8672f402ec94ae7bb8effd0d0", "mimeType": "image/jpeg", "elementId": "e000078", "sourceName": "assets/crop_2_1789047663639.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q02-4ce232bc", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000087"]}, {"mcq": false, "qwc": false, "stem": "This question is about ways of preventing iron nails from rusting.", "marks": 0, "parts": [{"qwc": false, "text": "This experiment is set up with three iron nails. tube 1 tube 2 tube 3", "label": "a", "marks": null, "partId": "q03-4ce232bc-pa", "figures": [{"url": "assets/crop_1_1789047663653.png", "width": 356, "format": "png", "height": 578, "sha256": "d8b4e4c216568a8571209a086a3df81fcc353dfdf021d3089158811b6fa4e974", "assetId": "img:d8b4e4c216568a8571209a086a3df81fcc353dfdf021d3089158811b6fa4e974", "mimeType": "image/jpeg", "elementId": "e000091", "sourceName": "assets/crop_1_1789047663653.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789047663659.png", "width": 476, "format": "png", "height": 583, "sha256": "bdb5d4d8644adedcc639a0541e2e62ee274aa0b4aa7953f3d5c2564354e8a52f", "assetId": "img:bdb5d4d8644adedcc639a0541e2e62ee274aa0b4aa7953f3d5c2564354e8a52f", "mimeType": "image/jpeg", "elementId": "e000093", "sourceName": "assets/crop_2_1789047663659.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_3_1789047663663.png", "width": 343, "format": "png", "height": 553, "sha256": "bac3e9aa2fffa0492a203d13e54167f8132f7e27c6a42fe4e34c5c72ab348b19", "assetId": "img:bac3e9aa2fffa0492a203d13e54167f8132f7e27c6a42fe4e34c5c72ab348b19", "mimeType": "image/jpeg", "elementId": "e000095", "sourceName": "assets/crop_3_1789047663663.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "What is the name of the main compound in rust?", "label": "a-i", "marks": 1, "partId": "q03-4ce232bc-pa-i", "figures": [], "confidence": 0.8, "answerPrompts": []}, {"qwc": false, "text": "Why does the nail in tube 1 not rust?", "label": "a-ii", "marks": 1, "partId": "q03-4ce232bc-pa-ii", "figures": [], "confidence": 0.8, "answerPrompts": []}, {"qwc": false, "text": "What is the purpose of the layer of oil in tube 2?", "label": "a-iii", "marks": 1, "partId": "q03-4ce232bc-pa-iii", "figures": [], "confidence": 0.8, "answerPrompts": []}, {"qwc": false, "text": "Zinc can be used to coat iron nails to prevent them from rusting.", "label": "b", "marks": null, "partId": "q03-4ce232bc-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "What is the name of this process?", "label": "b-i", "marks": null, "partId": "q03-4ce232bc-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "If the layer of zinc on the nail is scratched, sacrificial protection prevents the iron from rusting. Explain, with the help of two ionic half-equations, how this type of sacrificial protection works. Use symbols from the box in your equations. You may use each symbol once, more than once or not at all.", "label": "b-ii", "marks": null, "partId": "q03-4ce232bc-pb-ii", "figures": [{"url": "assets/crop_1_1789047663675.png", "width": 1044, "format": "png", "height": 94, "sha256": "a902dc6f860543801b0559049c337494a2c26447b565b3109aa43fd777bde023", "assetId": "img:a902dc6f860543801b0559049c337494a2c26447b565b3109aa43fd777bde023", "mimeType": "image/jpeg", "elementId": "e000108", "sourceName": "assets/crop_1_1789047663675.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Electroplating is another method of rust prevention. This apparatus can be used to electroplate an iron nail.", "label": "c", "marks": null, "partId": "q03-4ce232bc-pc", "figures": [{"url": "assets/crop_1_1789047663685.png", "width": 1059, "format": "png", "height": 600, "sha256": "da396389dc617b30fb5665fe1d5574494271a082c45748431aa070dc1b91db53", "assetId": "img:da396389dc617b30fb5665fe1d5574494271a082c45748431aa070dc1b91db53", "mimeType": "image/jpeg", "elementId": "e000111", "sourceName": "assets/crop_1_1789047663685.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Equation 1 shows the reaction at the copper rod. Equation 1 $\\mathrm {C u} \\rightarrow \\mathrm {C u} ^ {2 +} + 2 \\mathrm {e} ^ {-}$ Name this type of reaction, giving a reason for your answer. type of reaction reason...", "label": "c-i", "marks": null, "partId": "q03-4ce232bc-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Equation 2 shows the reaction at the iron nail. Equation 2 $\\mathrm {C u} ^ {2 +} + 2 \\mathrm {e} ^ {-} \\rightarrow \\mathrm {C u}$ Use equations 1 and 2 to explain why the colour of the copper(II) sulfate solution does not change during the experiment.", "label": "c-ii", "marks": null, "partId": "q03-4ce232bc-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 3, "figures": [{"url": "assets/crop_1_1789047663653.png", "width": 356, "format": "png", "height": 578, "sha256": "d8b4e4c216568a8571209a086a3df81fcc353dfdf021d3089158811b6fa4e974", "assetId": "img:d8b4e4c216568a8571209a086a3df81fcc353dfdf021d3089158811b6fa4e974", "mimeType": "image/jpeg", "elementId": "e000091", "sourceName": "assets/crop_1_1789047663653.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789047663659.png", "width": 476, "format": "png", "height": 583, "sha256": "bdb5d4d8644adedcc639a0541e2e62ee274aa0b4aa7953f3d5c2564354e8a52f", "assetId": "img:bdb5d4d8644adedcc639a0541e2e62ee274aa0b4aa7953f3d5c2564354e8a52f", "mimeType": "image/jpeg", "elementId": "e000093", "sourceName": "assets/crop_2_1789047663659.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_3_1789047663663.png", "width": 343, "format": "png", "height": 553, "sha256": "bac3e9aa2fffa0492a203d13e54167f8132f7e27c6a42fe4e34c5c72ab348b19", "assetId": "img:bac3e9aa2fffa0492a203d13e54167f8132f7e27c6a42fe4e34c5c72ab348b19", "mimeType": "image/jpeg", "elementId": "e000095", "sourceName": "assets/crop_3_1789047663663.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_1_1789047663675.png", "width": 1044, "format": "png", "height": 94, "sha256": "a902dc6f860543801b0559049c337494a2c26447b565b3109aa43fd777bde023", "assetId": "img:a902dc6f860543801b0559049c337494a2c26447b565b3109aa43fd777bde023", "mimeType": "image/jpeg", "elementId": "e000108", "sourceName": "assets/crop_1_1789047663675.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_1_1789047663685.png", "width": 1059, "format": "png", "height": 600, "sha256": "da396389dc617b30fb5665fe1d5574494271a082c45748431aa070dc1b91db53", "assetId": "img:da396389dc617b30fb5665fe1d5574494271a082c45748431aa070dc1b91db53", "mimeType": "image/jpeg", "elementId": "e000111", "sourceName": "assets/crop_1_1789047663685.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.45, "marksKnown": false, "questionId": "q03-4ce232bc", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "This question is about elements in Group 1 of the Periodic Table.", "marks": 7, "parts": [{"qwc": false, "text": "Which statement about lithium is correct? A It is a good electrical conductor and forms an acidic oxide B It is a poor electrical conductor and forms an acidic oxide C It is a good electrical conductor and forms a basic oxide D It is a poor electrical conductor and forms a basic oxide", "label": "a", "marks": null, "partId": "q04-4ce232bc-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "A small piece of sodium is added to a large trough of water.", "label": "b", "marks": null, "partId": "q04-4ce232bc-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State two observations that could be made.", "label": "b-i", "marks": null, "partId": "q04-4ce232bc-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Complete the equation for this reaction by inserting the appropriate state symbols. $2 \\mathrm {N a} (\\mathrm {s}) + 2 \\mathrm {H} _ {2} \\mathrm {O} (\\dots \\dots \\dots \\dots \\dots \\dots) \\rightarrow 2 \\mathrm {N a O H} (\\dots \\dots \\dots \\dots \\dots \\dots) + \\mathrm {H} _ {2} (\\dots \\dots \\dots \\dots \\dots \\dots)$", "label": "b-ii", "marks": null, "partId": "q04-4ce232bc-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Potassium reacts in a similar way to sodium, but is more reactive. State one observation that could be made when a small piece of potassium is added to a large trough of water, but would not be observed with sodium.", "label": "c", "marks": null, "partId": "q04-4ce232bc-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain why elements in Group 1 have similar reactions.", "label": "d", "marks": null, "partId": "q04-4ce232bc-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 4, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q04-4ce232bc", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "This question is about elements in Group 7 of the Periodic Table.", "marks": 10, "parts": [{"qwc": false, "text": "Complete the table to show the physical state at room temperature of fluorine and astatine, and the colour of liquid bromine.", "label": "a", "marks": 2, "partId": "q05-4ce232bc-pa", "figures": [], "confidence": 0.8, "answerPrompts": []}, {"qwc": false, "text": "Chlorine reacts with hydrogen to form hydrogen chloride. A piece of magnesium ribbon is added to hydrogen chloride in three separate experiments under different conditions. The table below shows the observations made under these different conditions.", "label": "b", "marks": null, "partId": "q05-4ce232bc-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Write the formulae of two ions formed in the solution produced in experiment 2. Positive ion... Negative ion...", "label": "b-i", "marks": null, "partId": "q05-4ce232bc-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Identify the gas formed in experiment 2 and give a test for it.", "label": "b-ii", "marks": null, "partId": "q05-4ce232bc-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Silver nitrate solution and dilute nitric acid are added to the solution produced in experiment 2. State what is observed and name the substance responsible for this observation. Explain why dilute nitric acid is added. observation.. substance responsible explanation...", "label": "b-iii", "marks": null, "partId": "q05-4ce232bc-pb-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain why there is no reaction in experiment 3.", "label": "b-iv", "marks": null, "partId": "q05-4ce232bc-pb-iv", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 5, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q05-4ce232bc", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000138", "e000142"]}, {"mcq": false, "qwc": false, "stem": "Crude oil is an important source of organic compounds.", "marks": 0, "parts": [{"qwc": false, "text": "The diagram shows how crude oil is separated into fractions in the oil industry.", "label": "a", "marks": null, "partId": "q06-4ce232bc-pa", "figures": [{"url": "assets/crop_1_1789047663752.png", "width": 1036, "format": "png", "height": 757, "sha256": "bfc23efd00b3f685952455722295daf2c30dbcf5e6aefb5d0ae6c270d1f179de", "assetId": "img:bfc23efd00b3f685952455722295daf2c30dbcf5e6aefb5d0ae6c270d1f179de", "mimeType": "image/jpeg", "elementId": "e000157", "sourceName": "assets/crop_1_1789047663752.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "What happens to the crude oil in A?", "label": "a-i", "marks": null, "partId": "q06-4ce232bc-pa-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Most of the compounds in crude oil are hydrocarbons. What is meant by the term hydrocarbons?", "label": "a-ii", "marks": null, "partId": "q06-4ce232bc-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Compare the hydrocarbons in fractions D and F in terms of boiling point size of molecules viscosity", "label": "a-iii", "marks": null, "partId": "q06-4ce232bc-pa-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Some of the fractions are catalytically cracked. The general equation for some reactions in this process is $\\mathrm {a l k a n e} \\rightarrow \\mathrm {a l k a n e} + \\mathrm {a l k e n e}$", "label": "b", "marks": null, "partId": "q06-4ce232bc-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State two conditions used in catalytic cracking.", "label": "b-i", "marks": null, "partId": "q06-4ce232bc-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "How does the bonding in an alkene molecule differ from the bonding in an alkane molecule?", "label": "b-ii", "marks": null, "partId": "q06-4ce232bc-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The chemical equation for one cracking reaction is $\\mathrm {C} _ {1 6} \\mathrm {H} _ {3 4} \\rightarrow \\mathrm {C} _ {8} \\mathrm {H} _ {1 8} + 2 \\mathrm {C} _ {3} \\mathrm {H} _ {6} + \\mathrm {c o m p o u n d Q}$ Deduce the molecular formula of Q.", "label": "b-iii", "marks": null, "partId": "q06-4ce232bc-pb-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The compound with molecular formula $ \\mathrm{C_{3} H_{6}} $ can be used to make a polymer.", "label": "c", "marks": null, "partId": "q06-4ce232bc-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give the name of the compound $ \\mathrm{C_{3} H_{6}} $", "label": "c-i", "marks": null, "partId": "q06-4ce232bc-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Complete the table of information about this compound.", "label": "c-ii", "marks": null, "partId": "q06-4ce232bc-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Complete this structure to show the part of the polymer formed from two molecules of $ \\mathrm{C_{3} H_{6}} $", "label": "c-iii", "marks": null, "partId": "q06-4ce232bc-pc-iii", "figures": [{"url": "assets/crop_1_1789047663786.png", "width": 591, "format": "png", "height": 47, "sha256": "0d8bea0e3f68d154a78e8269e3c68934082a3cdd2594b2c98a36eafe29a00ce5", "assetId": "img:0d8bea0e3f68d154a78e8269e3c68934082a3cdd2594b2c98a36eafe29a00ce5", "mimeType": "image/jpeg", "elementId": "e000177", "sourceName": "assets/crop_1_1789047663786.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}], "number": 6, "figures": [{"url": "assets/crop_1_1789047663752.png", "width": 1036, "format": "png", "height": 757, "sha256": "bfc23efd00b3f685952455722295daf2c30dbcf5e6aefb5d0ae6c270d1f179de", "assetId": "img:bfc23efd00b3f685952455722295daf2c30dbcf5e6aefb5d0ae6c270d1f179de", "mimeType": "image/jpeg", "elementId": "e000157", "sourceName": "assets/crop_1_1789047663752.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_1_1789047663786.png", "width": 591, "format": "png", "height": 47, "sha256": "0d8bea0e3f68d154a78e8269e3c68934082a3cdd2594b2c98a36eafe29a00ce5", "assetId": "img:0d8bea0e3f68d154a78e8269e3c68934082a3cdd2594b2c98a36eafe29a00ce5", "mimeType": "image/jpeg", "elementId": "e000177", "sourceName": "assets/crop_1_1789047663786.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.45, "marksKnown": false, "questionId": "q06-4ce232bc", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000175"]}, {"mcq": false, "qwc": false, "stem": "Hydrogen peroxide solution decomposes very slowly at room temperature. The equation for this reaction is $2 \\mathrm {H} _ {2} \\mathrm {O} _ {2} \\rightarrow 2 \\mathrm {H} _ {2} \\mathrm {O} + \\mathrm {O} _ {2}$ Very few bubbles can be seen in the solution because of the slow decomposition. The rate of this reaction is greatly increased by adding a catalyst.", "marks": 16, "parts": [{"qwc": false, "text": "A student added a solid to some hydrogen peroxide solution to see if the solid acted as a catalyst. He noticed that a lot of bubbles formed, and that the solid was still present at the end of the reaction. Outline a method to show that the solid acted as a catalyst and not as a reactant.", "label": "a", "marks": null, "partId": "q07-4ce232bc-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The student investigated the effect that changing the concentration of the hydrogen peroxide solution has on the rate of the reaction. He used solid manganese(IV) oxide as the catalyst in each experiment. This is the method he used. pour some hydrogen peroxide solution into a conical flask on a top-pan balance add the catalyst and place some cotton wool loosely in the neck of the flask record the balance reading and start a timer record the balance reading every minute until the mass no longer changes repeat the experiment several times using different concentrations of hydrogen peroxide solution", "label": "b", "marks": null, "partId": "q07-4ce232bc-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State one property of each substance that the student should keep the same in each experiment. hydrogen peroxide solution manganese(IV) oxide.", "label": "b-i", "marks": null, "partId": "q07-4ce232bc-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "What is the purpose of the cotton wool?", "label": "b-ii", "marks": null, "partId": "q07-4ce232bc-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The graph shows the results of one of the student''s experiments. Balance reading in grams", "label": "c", "marks": null, "partId": "q07-4ce232bc-pc", "figures": [{"url": "assets/crop_1_1789047663845.png", "width": 1125, "format": "png", "height": 930, "sha256": "a843873deb774f551a476b262bfcf8d7b39ea69c7fe665e5930dc28b64fd9a66", "assetId": "img:a843873deb774f551a476b262bfcf8d7b39ea69c7fe665e5930dc28b64fd9a66", "mimeType": "image/jpeg", "elementId": "e000200", "sourceName": "assets/crop_1_1789047663845.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Why does the balance reading decrease during the experiment?", "label": "c-i", "marks": null, "partId": "q07-4ce232bc-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "What does the slope of the curve indicate about the reaction?", "label": "c-ii", "marks": null, "partId": "q07-4ce232bc-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "How long does the reaction take to complete?", "label": "c-iii", "marks": null, "partId": "q07-4ce232bc-pc-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The results of some of the student''s other experiments are shown on this graph. Balance reading in grams", "label": "d", "marks": null, "partId": "q07-4ce232bc-pd", "figures": [{"url": "assets/crop_1_1789047663856.png", "width": 1108, "format": "png", "height": 1116, "sha256": "50399160e122f0f7c4e8edaece8b3cf008858c1be52941e4cfe964fceaec31a2", "assetId": "img:50399160e122f0f7c4e8edaece8b3cf008858c1be52941e4cfe964fceaec31a2", "mimeType": "image/jpeg", "elementId": "e000206", "sourceName": "assets/crop_1_1789047663856.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Which one of the experiments, R, S or T, was the fastest?", "label": "d-i", "marks": null, "partId": "q07-4ce232bc-pd-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The concentration of the hydrogen peroxide solution in experiment S was $ 0. 4 0 \\mathrm{m o l} / \\mathrm{d m}^{3}. $ Use the graph to deduce the concentration of the hydrogen peroxide solution in experiment T. State how you deduced your answer.", "label": "d-ii", "marks": null, "partId": "q07-4ce232bc-pd-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Another student repeated the investigation. She recorded the time for the total mass of the beaker and contents to decrease by 0.50 g in each experiment. She then converted the times to relative rates of reaction. The table shows the concentrations she used and the relative rates of reaction she calculated. Plot a graph of these results on the grid. Draw a straight line of best fit through the points. Relative rate of reaction Concentration of hydrogen peroxide in mol/dm $ ^{3} $", "label": "e", "marks": null, "partId": "q07-4ce232bc-pe", "figures": [{"url": "assets/crop_1_1789047663872.png", "width": 1067, "format": "png", "height": 1520, "sha256": "a677fd705b0436993f7b99cadaa07e8ac040568feca1e921de5c6c5f91544605", "assetId": "img:a677fd705b0436993f7b99cadaa07e8ac040568feca1e921de5c6c5f91544605", "mimeType": "image/jpeg", "elementId": "e000217", "sourceName": "assets/crop_1_1789047663872.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain, in terms of particles, why the rate of a reaction increases as the concentration of a reactant increases.", "label": "f", "marks": null, "partId": "q07-4ce232bc-pf", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 7, "figures": [{"url": "assets/crop_1_1789047663845.png", "width": 1125, "format": "png", "height": 930, "sha256": "a843873deb774f551a476b262bfcf8d7b39ea69c7fe665e5930dc28b64fd9a66", "assetId": "img:a843873deb774f551a476b262bfcf8d7b39ea69c7fe665e5930dc28b64fd9a66", "mimeType": "image/jpeg", "elementId": "e000200", "sourceName": "assets/crop_1_1789047663845.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_1_1789047663856.png", "width": 1108, "format": "png", "height": 1116, "sha256": "50399160e122f0f7c4e8edaece8b3cf008858c1be52941e4cfe964fceaec31a2", "assetId": "img:50399160e122f0f7c4e8edaece8b3cf008858c1be52941e4cfe964fceaec31a2", "mimeType": "image/jpeg", "elementId": "e000206", "sourceName": "assets/crop_1_1789047663856.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_1_1789047663872.png", "width": 1067, "format": "png", "height": 1520, "sha256": "a677fd705b0436993f7b99cadaa07e8ac040568feca1e921de5c6c5f91544605", "assetId": "img:a677fd705b0436993f7b99cadaa07e8ac040568feca1e921de5c6c5f91544605", "mimeType": "image/jpeg", "elementId": "e000217", "sourceName": "assets/crop_1_1789047663872.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q07-4ce232bc", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000213"]}, {"mcq": false, "qwc": false, "stem": "(a) The flow chart shows how ammonia is made using the Haber process. (i) State one raw material that is used as the source of (ii) Identify the catalyst and state the pressure, in atmospheres, used in the Haber process. (2) catalyst pressure (iii) Which substances pass from the cooler to the heated catalyst? (iv) When ammonia leaves the cooler it is (iv) When ammonia leaves the co A an aqueous solution B a gas C a liquid D a solid", "marks": 15, "parts": [{"qwc": false, "text": "Hydrazine $ \\left( \\mathrm{N}_{2} \\mathrm{H}_{4} \\right) $ is a useful compound that can be manufactured from ammonia.", "label": "b", "marks": null, "partId": "q08-4ce232bc-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Hydrogen peroxide can be used to convert ammonia to hydrazine. Balance the equation for this reaction. $\\mathrm {N H} _ {3} + \\mathrm {H} _ {2} \\mathrm {O} _ {2} \\rightarrow \\mathrm {N} _ {2} \\mathrm {H} _ {4} + \\mathrm {H} _ {2} \\mathrm {O}$", "label": "b-i", "marks": null, "partId": "q08-4ce232bc-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The bonding in ammonia and hydrazine can be represented by dot and cross diagrams. The diagram for ammonia has been drawn. All the bonds in hydrazine are single bonds. Complete the diagram for hydrazine. Show only the outer electrons.", "label": "b-ii", "marks": null, "partId": "q08-4ce232bc-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Hydrazine was used as the fuel in the first rocket-powered fighter aircraft in World War II. It is now used as a propellant in spacecraft. It slowed the descent of the Phoenix spacecraft as it landed on Mars. The equations for its use as a rocket fuel and as a propellant are shown in the table.", "label": "c", "marks": null, "partId": "q08-4ce232bc-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "How does the information in the table show that both reactions are exothermic?", "label": "c-i", "marks": null, "partId": "q08-4ce232bc-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Why is it not correct to describe hydrazine as a fuel when it is used as a propellant?", "label": "c-ii", "marks": null, "partId": "q08-4ce232bc-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Some spacecraft use MMH, a compound similar to hydrazine, as a propellant. MMH has the composition by mass of 26.1% carbon, 60.9% nitrogen and 13.0% hydrogen.", "label": "d", "marks": null, "partId": "q08-4ce232bc-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the empirical formula of MMH. empirical formula.", "label": "d-i", "marks": null, "partId": "q08-4ce232bc-pd-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The $ M_{r} $ of MMH is 46 What is the molecular formula of MMH?", "label": "d-ii", "marks": null, "partId": "q08-4ce232bc-pd-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 8, "figures": [{"url": "assets/crop_1_1789047663899.png", "width": 1655, "format": "png", "height": 429, "sha256": "d013ef94e594567ec007213a83da467abb8d6eb3d45af4351aa6edad8d557cd2", "assetId": "img:d013ef94e594567ec007213a83da467abb8d6eb3d45af4351aa6edad8d557cd2", "mimeType": "image/jpeg", "elementId": "e000223", "sourceName": "assets/crop_1_1789047663899.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q08-4ce232bc", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000245", "e000248"]}, {"mcq": false, "qwc": false, "stem": "Molybdenum (Mo) is a metal. It is often used to make an alloy with iron. Like iron, it is extracted from its oxide. Unlike iron, it occurs mainly as its sulfide.", "marks": 12, "parts": [{"qwc": false, "text": "Molybdenum sulfide is converted into molybdenum oxide by heating in air. The equation for this reaction is $2 \\mathrm {M o S} _ {2} + 7 \\mathrm {O} _ {2} \\rightarrow 2 \\mathrm {M o O} _ {3} + 4 \\mathrm {S O} _ {2}$", "label": "a", "marks": null, "partId": "q09-4ce232bc-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Why is molybdenum said to be oxidised in this reaction?", "label": "a-i", "marks": null, "partId": "q09-4ce232bc-pa-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The sulfur dioxide formed in the reaction could form acid rain if it escaped into the atmosphere. Write a chemical equation for the formation of an acid from sulfur dioxide.", "label": "a-ii", "marks": null, "partId": "q09-4ce232bc-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The table shows the melting points of molybdenum oxide and sulfur dioxide. The melting point indicates the type of bonding and structure in a compound.", "label": "b", "marks": null, "partId": "q09-4ce232bc-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "What is the type of bonding in a molecule of sulfur dioxide?", "label": "b-i", "marks": null, "partId": "q09-4ce232bc-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain why the melting point of sulfur dioxide is low.", "label": "b-ii", "marks": null, "partId": "q09-4ce232bc-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The melting point of molybdenum oxide suggests that it has ionic bonding. However, it is often represented as a molecular structure. Deduce the molecular formula of molybdenum oxide as shown in this structure.", "label": "b-iii", "marks": null, "partId": "q09-4ce232bc-pb-iii", "figures": [{"url": "assets/crop_1_1789047663923.png", "width": 358, "format": "png", "height": 204, "sha256": "60894a1891766087f51ceced6183469fc1acc6157944472cfd587b769b765803", "assetId": "img:60894a1891766087f51ceced6183469fc1acc6157944472cfd587b769b765803", "mimeType": "image/jpeg", "elementId": "e000271", "sourceName": "assets/crop_1_1789047663923.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The metallic structure of molybdenum gives it some typical properties.", "label": "c", "marks": null, "partId": "q09-4ce232bc-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Describe the metallic structure of molybdenum.", "label": "c-i", "marks": null, "partId": "q09-4ce232bc-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain why molybdenum is a good conductor of electricity.", "label": "c-ii", "marks": null, "partId": "q09-4ce232bc-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain why molybdenum is malleable.", "label": "c-iii", "marks": null, "partId": "q09-4ce232bc-pc-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 9, "figures": [{"url": "assets/crop_1_1789047663923.png", "width": 358, "format": "png", "height": 204, "sha256": "60894a1891766087f51ceced6183469fc1acc6157944472cfd587b769b765803", "assetId": "img:60894a1891766087f51ceced6183469fc1acc6157944472cfd587b769b765803", "mimeType": "image/jpeg", "elementId": "e000271", "sourceName": "assets/crop_1_1789047663923.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q09-4ce232bc", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000265"]}, {"mcq": false, "qwc": false, "stem": "This apparatus can be used to investigate the reduction of metal oxides. The mass of the metal oxide is measured before and after heating it in hydrogen. The results can be used to determine the formula of the oxide.", "marks": 10, "parts": [{"qwc": false, "text": "The hydrogen gas burns as it leaves the tube.", "label": "a", "marks": null, "partId": "q10-4ce232bc-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "What substance is formed when hydrogen burns in air?", "label": "a-i", "marks": null, "partId": "q10-4ce232bc-pa-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Why is it important to relight the flame if it goes out?", "label": "a-ii", "marks": null, "partId": "q10-4ce232bc-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "These are the results for one experiment. Mass of solid before heating = 4.2 g Mass of solid after heating = 3.4 g These results may not be sufficient to find the mass of metal for use in determining the formula of the metal oxide. What further practical steps should be taken to confirm that an accurate value for the mass of metal has been obtained?", "label": "b", "marks": null, "partId": "q10-4ce232bc-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "In an experiment using a different metal oxide, a mass of 2.8 g of metal is obtained from 3.6 g of the metal oxide.", "label": "c", "marks": null, "partId": "q10-4ce232bc-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the mass of oxygen in the sample of the metal oxide.", "label": "c-i", "marks": null, "partId": "q10-4ce232bc-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the amount, in moles, of oxygen atoms in the sample of the metal oxide.", "label": "c-ii", "marks": null, "partId": "q10-4ce232bc-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The formula of the metal oxide is MO, where M is the symbol of the metal. Deduce the amount, in moles, of M in the sample of the metal oxide.", "label": "c-iii", "marks": null, "partId": "q10-4ce232bc-pc-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "What is the relative atomic mass of M?", "label": "c-iv", "marks": null, "partId": "q10-4ce232bc-pc-iv", "figures": [], "confidence": 0.55, "answerPrompts": ["relative atomic mass of M"]}], "number": 10, "figures": [{"url": "assets/crop_1_1789047663938.png", "width": 1455, "format": "png", "height": 447, "sha256": "7597792b39010fe27282ee35b135dab685ff482ef1b1da26f044fc943ed9c827", "assetId": "img:7597792b39010fe27282ee35b135dab685ff482ef1b1da26f044fc943ed9c827", "mimeType": "image/jpeg", "elementId": "e000278", "sourceName": "assets/crop_1_1789047663938.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q10-4ce232bc", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}], "paperTotal": 120, "schemaVersion": "1.0", "sectionTotals": {}, "questionTotals": {"1": 8, "2": 14, "4": 7, "5": 10, "7": 16, "8": 15, "9": 12, "10": 10}, "reviewRequired": true, "extractionMethod": "glm-ocr-qp-v1", "frontMatterFigures": []}', '{"paper": {"board": "Edexcel", "session": "June 2014", "subject": null, "duration": null, "examDate": null, "logNumber": null, "qualification": null, "paperReference": null, "publicationCode": "UG038366", "canonicalDocumentId": "f9b3ad01-e82b-5449-be6d-12a21d9c4188"}, "entries": [{"mcq": false, "qwc": false, "label": "1", "marks": 1, "number": 1, "entryId": "ms-f9b3ad01-q1", "guidance": [{"kind": "note", "text": "i"}, {"kind": "note", "text": "steam"}, {"kind": "note", "text": "Accept gas/vapour"}, {"kind": "note", "text": "ii"}, {"kind": "note", "text": "ice"}, {"kind": "note", "text": "Accept solid"}, {"kind": "note", "text": "iii"}, {"kind": "note", "text": "ice"}, {"kind": "note", "text": "Accept solid"}, {"kind": "note", "text": "b"}, {"kind": "note", "text": "i"}, {"kind": "note", "text": "D(melting)"}, {"kind": "note", "text": "ii"}, {"kind": "note", "text": "B(condensing)"}, {"kind": "note", "text": "c"}, {"kind": "note", "text": "D(solid to gas)"}, {"kind": "note", "text": "d"}, {"kind": "note", "text": "i"}, {"kind": "note", "text": "exothermic"}, {"kind": "note", "text": "ii"}, {"kind": "note", "text": "H2O(g)→H2O(l)"}, {"kind": "note", "text": "Accept multiples and fractions"}], "answerText": "a", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "2", "marks": 1, "number": 2, "entryId": "ms-f9b3ad01-q2", "guidance": [{"kind": "note", "text": "i"}, {"kind": "note", "text": "B(filtration)"}, {"kind": "note", "text": "ii"}, {"kind": "note", "text": "C(fractional distillation)"}, {"kind": "note", "text": "b"}, {"kind": "note", "text": "i"}, {"kind": "note", "text": "B(filtration)"}, {"kind": "note", "text": "ii"}, {"kind": "note", "text": "D(simple distillation)"}, {"kind": "note", "text": "iii"}, {"kind": "note", "text": "A(crystallisation)