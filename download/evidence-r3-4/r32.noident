INSERT INTO public.document_chunks VALUES ('15d9ccf4-2358-4ca9-917a-e1a70cbd4739', '4b79b030-4bef-450e-91a5-76afa24ec24e', 13, '11 The flow diagram shows how a fertiliser is manufactured from raw materials.
