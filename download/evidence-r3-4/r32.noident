INSERT INTO public.questions VALUES ('114f454e-4ca5-4343-95c9-56cd5f6ee1e6', 'q07-52406e2b', 'STRUCTURED', 'The reaction between hydrogen and chlorine is exothermic. This is the equation for the reaction. $\mathrm {H} _ {2} (\mathrm {g}) + \mathrm {C l} _ {2} (\mathrm {g}) \rightarrow 2 \mathrm {H C l} (\mathrm {g}) \quad \Delta H = - 1 8 4 \mathrm {k J}$', 12, 3, 1080, NULL, '8a97535c-ab65-4e7c-9680-2098ecf888c8', 'PAST_PAPER', true, 1, '2026-09-13 13:02:54.078835+00', '6b673149-944d-40fc-81f1-81f73a6fa2b4');
