INSERT INTO public.document_chunks VALUES ('d80f0a27-dbd9-4862-baeb-6d04a4304d6c', '16d31134-6baa-4001-abdf-7957ac2c0ba6', 10, '8 The table gives information about the first three elements in Group 1 of the Periodic Table.
