, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: OH-/HO-", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: d", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M2 because it is further from (the attraction of) nucleus (and therefore less strongly attracted to the nucleus)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: ACCEPT reverse arguments as long as it is clear that lithium is being considered", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: 6 a", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M2 produces oxygen(for breathing)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: b i", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M2n(LiOH)=answer toM1x2OR4.54(54...)(mol)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M3m(LiOH)=(answer toM3x24)=110(g)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: OR", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M148(g)reactswith44(g)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M2x(g)reactswith100(g)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M3x=110(g)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: 6 b ii", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M2 volume of $\\mathrm{CO}_{2}$ answer to M1 $\\times$ 24000", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M3 $= 52000(\\mathrm{cm}^{3})$", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: 7 a", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M2(step 2)magnesium carbonate is insoluble/magnesium carbonate does not form a solution", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M3(step 3)boiling off all the water(will not produce a hydrated salt)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: 7 b i", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M2(before)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M3(volume added)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: b ii", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M2because it includes the air(contained in the tip of the burette)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: c i", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: ii", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: If no results are ticked then M1 can only be awarded if the values from columns 2 and 4 are averaged", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: If only one column ticked then no marks can be awarded in(c)(ii)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M2 26.35(cm3)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: Correct final answer without working scores 2", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: 7 d", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M2", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M3", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}]', '{"paper": {"board": "Edexcel", "session": "June 2016", "subject": null, "duration": null, "examDate": "Wednesday 15 June 2016 – Afternoon", "logNumber": null, "qualification": null, "paperReference": "4CH0/2CR", "publicationCode": null, "canonicalDocumentId": "1a97e8dd-750d-5c9f-966d-c2a08df67fe3"}, "warnings": [], "questions": [{"mcq": false, "qwc": false, "stem": "Hydrated copper(II) sulfate is a soluble blue solid. A large crystal of this solid is placed at the bottom of a beaker of water. The diagram shows the beaker immediately after placing the crystal in it, and after two days. after placing the crystal after two days", "marks": 4, "parts": [{"qwc": false, "text": "After two days, the crystal becomes smaller and the liquid near the bottom of the beaker becomes blue. Which statement explains these observations? A the crystal dissolves B the crystal freezes C the crystal melts D the crystal sublimes", "label": "a", "marks": null, "partId": "q01-1a97e8dd-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "After two weeks, the crystal has disappeared. Which statement best describes the appearance of the liquid in the beaker after two weeks? A it is all blue B it is all brown C only the lower part is blue D only the upper part is blue", "label": "b", "marks": null, "partId": "q01-1a97e8dd-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The formula of the compound in the crystal is $ \\mathrm{C u S O_{4}. 5 H_{2}O} $", "label": "c", "marks": null, "partId": "q01-1a97e8dd-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "How many different elements are shown in the formula?", "label": "c-i", "marks": null, "partId": "q01-1a97e8dd-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "How many atoms are shown in the formula?", "label": "c-ii", "marks": null, "partId": "q01-1a97e8dd-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 1, "figures": [{"url": "assets/crop_1_1789069459637.png", "width": 206, "format": "png", "height": 301, "sha256": "6b91ae6e5fe7046966df9240bd6fb95be238da790b58256e4684081787868c41", "assetId": "img:6b91ae6e5fe7046966df9240bd6fb95be238da790b58256e4684081787868c41", "mimeType": "image/jpeg", "elementId": "e000022", "sourceName": "assets/crop_1_1789069459637.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789069459643.png", "width": 212, "format": "png", "height": 305, "sha256": "176446535d53f78607c3c1d98b7531575901934ba502758381d4b40acf19e08d", "assetId": "img:176446535d53f78607c3c1d98b7531575901934ba502758381d4b40acf19e08d", "mimeType": "image/jpeg", "elementId": "e000024", "sourceName": "assets/crop_2_1789069459643.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q01-1a97e8dd", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "Iron is a metal with many uses. One problem with using iron is that it rusts.", "marks": 8, "parts": [{"qwc": false, "text": "Name two substances needed for iron to rust. (2) ...and...", "label": "a", "marks": null, "partId": "q02-1a97e8dd-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State the name of the main compound present in rust.", "label": "b", "marks": null, "partId": "q02-1a97e8dd-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The table shows three methods used to protect iron from rusting. Choose three of the objects from the box to complete the table. You may choose an object only once. bicycle chain bucket car body car engine food can railway bridge", "label": "c", "marks": null, "partId": "q02-1a97e8dd-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "An iron object is coated with zinc to protect it from rusting. This protection continues even if the zinc coating becomes scratched. Explain how the zinc coating protects iron from rusting.", "label": "d", "marks": null, "partId": "q02-1a97e8dd-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 2, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q02-1a97e8dd", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000050"]}, {"mcq": false, "qwc": false, "stem": "This question is about some gases present in air.", "marks": 9, "parts": [{"qwc": false, "text": "Which is the most common gas in dry air? A argon B carbon dioxide nitrogen D oxygen", "label": "a", "marks": null, "partId": "q03-1a97e8dd-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Which gas makes up about 1 % of dry air? A argon B carbon dioxide nitrogen D oxygen", "label": "b", "marks": null, "partId": "q03-1a97e8dd-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "A piece of copper is heated in air. State the formula and colour of the compound formed. formula. colour..", "label": "c", "marks": null, "partId": "q03-1a97e8dd-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The diagram shows apparatus that can be used to prepare carbon dioxide in the laboratory. A calcium chloride solution", "label": "d", "marks": null, "partId": "q03-1a97e8dd-pd", "figures": [{"url": "assets/crop_1_1789069459708.png", "width": 1317, "format": "png", "height": 967, "sha256": "be905b94059578b3e19ae412b5f78d5708d2d88bb2a93bc64c9c68c4af254bd5", "assetId": "img:be905b94059578b3e19ae412b5f78d5708d2d88bb2a93bc64c9c68c4af254bd5", "mimeType": "image/jpeg", "elementId": "e000070", "sourceName": "assets/crop_1_1789069459708.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The liquid in the tap funnel is B concentrated sulfuric acid C dilute hydrochloric acid D hydrogen peroxide solution", "label": "d-i", "marks": 1, "partId": "q03-1a97e8dd-pd-i", "figures": [], "confidence": 0.8, "answerPrompts": []}, {"qwc": false, "text": "The solid in the conical flask is A calcium carbonate B calcium sulfate C copper(II) oxide D manganese(IV) oxide", "label": "d-ii", "marks": 1, "partId": "q03-1a97e8dd-pd-ii", "figures": [], "confidence": 0.8, "answerPrompts": []}, {"qwc": false, "text": "The diagram shows the gas being collected over water. Suggest another way to collect the gas.", "label": "d-iii", "marks": 1, "partId": "q03-1a97e8dd-pd-iii", "figures": [], "confidence": 0.8, "answerPrompts": []}, {"qwc": false, "text": "Limewater can be used in a test for carbon dioxide.", "label": "e", "marks": null, "partId": "q03-1a97e8dd-pe", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Complete this equation, by inserting state symbols, for the reaction used to test for carbon dioxide. $\\mathrm {C O} _ {2} (\\dots \\dots \\dots \\dots \\dots \\dots) + \\mathrm {C a} (\\mathrm {O H}) _ {2} (\\dots \\dots \\dots \\dots \\dots) \\rightarrow \\mathrm {C a C O} _ {3} (\\dots \\dots \\dots \\dots \\dots) + \\mathrm {H} _ {2} \\mathrm {O} (\\dots \\dots \\dots \\dots \\dots)$", "label": "e-i", "marks": null, "partId": "q03-1a97e8dd-pe-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State the observation made in this test.", "label": "e-ii", "marks": null, "partId": "q03-1a97e8dd-pe-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 3, "figures": [{"url": "assets/crop_1_1789069459708.png", "width": 1317, "format": "png", "height": 967, "sha256": "be905b94059578b3e19ae412b5f78d5708d2d88bb2a93bc64c9c68c4af254bd5", "assetId": "img:be905b94059578b3e19ae412b5f78d5708d2d88bb2a93bc64c9c68c4af254bd5", "mimeType": "image/jpeg", "elementId": "e000070", "sourceName": "assets/crop_1_1789069459708.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q03-1a97e8dd", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "A student investigates electrolysis using this apparatus.", "marks": 6, "parts": [{"qwc": false, "text": "The student electrolyses KCl(aq) and collects samples of any gases formed. Complete the following diagram to show how to assemble the apparatus. Label the diagram to show the potassium chloride solution.", "label": "a", "marks": null, "partId": "q04-1a97e8dd-pa", "figures": [{"url": "assets/crop_2_1789069459734.png", "width": 193, "format": "png", "height": 403, "sha256": "7289d6c4c86fd78fab3e2a2cc2a0a13f3c3d147d6ea6b16b2fff4a55baf48e90", "assetId": "img:7289d6c4c86fd78fab3e2a2cc2a0a13f3c3d147d6ea6b16b2fff4a55baf48e90", "mimeType": "image/jpeg", "elementId": "e000095", "sourceName": "assets/crop_2_1789069459734.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The table shows the half-equation for the reaction at one electrode. Complete the table to show the half-equation for the reaction at the other electrode and the polarity (+ or -) of each electrode.", "label": "b", "marks": null, "partId": "q04-1a97e8dd-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Describe a test to show that the gas collected is hydrogen.", "label": "c", "marks": null, "partId": "q04-1a97e8dd-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 4, "figures": [{"url": "assets/crop_1_1789069459729.png", "width": 1539, "format": "png", "height": 396, "sha256": "4cf799eae61f0ff9cb0d6985f266273d0948ac51e4917321476b03c49fc005b5", "assetId": "img:4cf799eae61f0ff9cb0d6985f266273d0948ac51e4917321476b03c49fc005b5", "mimeType": "image/jpeg", "elementId": "e000092", "sourceName": "assets/crop_1_1789069459729.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789069459734.png", "width": 193, "format": "png", "height": 403, "sha256": "7289d6c4c86fd78fab3e2a2cc2a0a13f3c3d147d6ea6b16b2fff4a55baf48e90", "assetId": "img:7289d6c4c86fd78fab3e2a2cc2a0a13f3c3d147d6ea6b16b2fff4a55baf48e90", "mimeType": "image/jpeg", "elementId": "e000095", "sourceName": "assets/crop_2_1789069459734.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q04-1a97e8dd", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000098"]}, {"mcq": false, "qwc": false, "stem": "Potassium and lithium are Group 1 metals that exist as isotopes.", "marks": 11, "parts": [{"qwc": false, "text": "Complete the table of information about two isotopes of potassium.", "label": "a", "marks": null, "partId": "q05-1a97e8dd-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "A sample of lithium has this percentage composition by mass. $^ {6} \\mathrm {L i} = 7. 4 \\% \\quad^ {7} \\mathrm {L i} = 9 2. 6 \\%$ Use this information to calculate the relative atomic mass of lithium. Give your answer to one decimal place.", "label": "a-ii", "marks": null, "partId": "q05-1a97e8dd-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": ["relative atomic mass of lithium"]}, {"qwc": false, "text": "A reaction occurs when a small piece of potassium is added to water in a trough. State two observations that could be made during the reaction.", "label": "b", "marks": null, "partId": "q05-1a97e8dd-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "A few drops of phenolphthalein are added to the liquid in the trough at the end of the reaction. A colour change occurs.", "label": "c", "marks": null, "partId": "q05-1a97e8dd-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State the final colour of the liquid in the trough.", "label": "c-i", "marks": null, "partId": "q05-1a97e8dd-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give the formula of the ion formed during the reaction that causes this colour change.", "label": "c-ii", "marks": null, "partId": "q05-1a97e8dd-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The electronic configurations of lithium and potassium are Li 2,1 K 2,8,8,1 Explain why potassium is more reactive than lithium.", "label": "d", "marks": null, "partId": "q05-1a97e8dd-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 5, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q05-1a97e8dd", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000103"]}, {"mcq": false, "qwc": false, "stem": "Lithium hydroxide (LiOH) and lithium peroxide $ \\left( \\mathrm{L i}_{2} \\mathrm{O}_{2} \\right) $ have been used in spacecraft to remove the carbon dioxide astronauts breathe out. The equations for the reactions with carbon dioxide are $2 \\mathrm {L i O H} + \\mathrm {C O} _ {2} \\rightarrow \\mathrm {L i} _ {2} \\mathrm {C O} _ {3} + \\mathrm {H} _ {2} \\mathrm {O}$ $2 \\mathrm {L i} _ {2} \\mathrm {O} _ {2} + 2 \\mathrm {C O} _ {2} \\rightarrow 2 \\mathrm {L i} _ {2} \\mathrm {C O} _ {3} + \\mathrm {O} _ {2}$", "marks": 0, "parts": [{"qwc": false, "text": "Explain, with reference to these equations, two advantages of using lithium peroxide rather than lithium hydroxide, to remove carbon dioxide from the air in a spacecraft.", "label": "a", "marks": null, "partId": "q06-1a97e8dd-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the mass of lithium hydroxide needed to react with 100 g of carbon dioxide. $ [ M_{r} $ of $ \\mathrm{L i O H}=2 4 ] $", "label": "b", "marks": null, "partId": "q06-1a97e8dd-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the volume of carbon dioxide, at room temperature and pressure, removed by 100 g of lithium peroxide. [M $ _{r} $ of $ \\mathrm{L i}_{2} \\mathrm{O}_{2}=4 6 $] Assume that one mole of gas has a volume of 24000 $ cm^{3} $ at rtp.", "label": "b-ii", "marks": null, "partId": "q06-1a97e8dd-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 6, "figures": [], "options": [], "section": null, "confidence": 0.45, "marksKnown": false, "questionId": "q06-1a97e8dd", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "This question is about the laboratory preparation of salts.", "marks": 14, "parts": [{"qwc": false, "text": "A student writes this plan for preparing a sample of hydrated magnesium sulfate crystals. step1 Pour about 100 $ cm^{3} $ of dilute nitric acid into a 250 $ cm^{3} $ beaker. step 2 Add a solution of magnesium carbonate to the acid until there is no more effervescence. step 3 Heat the solution until all of the water has boiled off. This plan will not succeed because there is one mistake in each step. Identify the mistake in each of the steps.", "label": "a", "marks": null, "partId": "q07-1a97e8dd-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Another student uses the following plan to prepare a sample of ammonium hydrogenphosphate, formed in this reaction between aqueous ammonia and dilute phosphoric acid $2 \\mathrm {N H} _ {3} (\\mathrm {a q}) + \\mathrm {H} _ {3} \\mathrm {P O} _ {4} (\\mathrm {a q}) \\rightarrow (\\mathrm {N H} _ {4}) _ {2} \\mathrm {H P O} _ {4} (\\mathrm {a q})$ use a pipette to transfer 25.0 $ cm^{3} $ of phosphoric acid to a conical flask add 3 drops of indicator use a burette to add aqueous ammonia until the indicator just changes colour permanently", "label": "b", "marks": null, "partId": "q07-1a97e8dd-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The diagram shows the burette readings in one experiment before and after adding aqueous ammonia. Use the readings to complete the table, entering all values to the nearest 0.05 $ cm^{3}. $", "label": "b-i", "marks": null, "partId": "q07-1a97e8dd-pb-i", "figures": [{"url": "assets/crop_1_1789069459797.png", "width": 150, "format": "png", "height": 540, "sha256": "07ba632038872269db0c12724eb2f689aa100e4bb7b986d2bef6899317b6ac0b", "assetId": "img:07ba632038872269db0c12724eb2f689aa100e4bb7b986d2bef6899317b6ac0b", "mimeType": "image/jpeg", "elementId": "e000136", "sourceName": "assets/crop_1_1789069459797.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789069459806.png", "width": 172, "format": "png", "height": 598, "sha256": "b68d8fc65904696154bfc22ae90bba86ff016ff6e1ad945b7ace55c787fd8d4a", "assetId": "img:b68d8fc65904696154bfc22ae90bba86ff016ff6e1ad945b7ace55c787fd8d4a", "mimeType": "image/jpeg", "elementId": "e000137", "sourceName": "assets/crop_2_1789069459806.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "In another titration, the student made a mistake. After he filled the burette, he noticed that the space between the tap of the burette and the tip contained air. After adding the aqueous ammonia, he noticed that it now contained liquid. Explain how, if at all, this mistake affects the calculated volume of aqueous ammonia added.", "label": "b-ii", "marks": null, "partId": "q07-1a97e8dd-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "He repeats the experiment until he obtains concordant results. The table shows the results. Concordant results are those volumes that differ from each other by 0.20 $ cm^{3} $ or less.", "label": "c", "marks": null, "partId": "q07-1a97e8dd-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Identify the concordant results by placing ticks ( $ \\checkmark $ ) in the table where appropriate.", "label": "c-i", "marks": null, "partId": "q07-1a97e8dd-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Use the concordant results to calculate the average (mean) volume of aqueous ammonia added. average volume of aqueous ammonia = ... $ \\mathrm{c m}^{3} $", "label": "c-ii", "marks": null, "partId": "q07-1a97e8dd-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The student then mixed the volumes of aqueous ammonia and phosphoric acid found in the titration. Describe how to use the method of crystallisation to obtain a pure dry sample of the salt from this mixture. Every effort has been made to contact copyright holders to obtain their permission for the use of copyright material. Pearson Education Ltd. will, if notified, be happy to rectify any errors or omissions and include any such rectifications in future editions.", "label": "d", "marks": null, "partId": "q07-1a97e8dd-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 7, "figures": [{"url": "assets/crop_1_1789069459797.png", "width": 150, "format": "png", "height": 540, "sha256": "07ba632038872269db0c12724eb2f689aa100e4bb7b986d2bef6899317b6ac0b", "assetId": "img:07ba632038872269db0c12724eb2f689aa100e4bb7b986d2bef6899317b6ac0b", "mimeType": "image/jpeg", "elementId": "e000136", "sourceName": "assets/crop_1_1789069459797.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789069459806.png", "width": 172, "format": "png", "height": 598, "sha256": "b68d8fc65904696154bfc22ae90bba86ff016ff6e1ad945b7ace55c787fd8d4a", "assetId": "img:b68d8fc65904696154bfc22ae90bba86ff016ff6e1ad945b7ace55c787fd8d4a", "mimeType": "image/jpeg", "elementId": "e000137", "sourceName": "assets/crop_2_1789069459806.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q07-1a97e8dd", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000139", "e000144"]}], "paperTotal": 60, "schemaVersion": "1.0", "sectionTotals": {}, "questionTotals": {"1": 4, "2": 8, "3": 9, "4": 6, "5": 11, "7": 14}, "reviewRequired": true, "extractionMethod": "glm-ocr-qp-v1", "frontMatterFigures": []}', '{"paper": {"board": "Edexcel", "session": "Summer 2016", "subject": null, "duration": null, "examDate": null, "logNumber": null, "qualification": null, "paperReference": null, "publicationCode": "4CH0_2CR_1606_MS", "canonicalDocumentId": "d677a959-1285-5cd8-afcc-e9f44438314a"}, "entries": [{"mcq": false, "qwc": false, "label": "21", "marks": 1, "number": 21, "entryId": "ms-d677a959-q21", "guidance": [], "answerText": "", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "19", "marks": 41, "number": 19, "entryId": "ms-d677a959-q19", "guidance": [{"kind": "note", "text": "b"}, {"kind": "note", "text": "any two from"}, {"kind": "note", "text": "• effervescence/fizzing/bubbles"}, {"kind": "note", "text": "• potassium moves/darts/floats"}, {"kind": "note", "text": "• potassium leaves white trail"}, {"kind": "note", "text": "• potassium forms into a ball"}, {"kind": "note", "text": "• potassium becomes smaller/disappears"}, {"kind": "note", "text": "• (lilac) flame"}, {"kind": "note", "text": "ACCEPT(hydrogen) gas given off/evolved/formed/producedIGNOREname of gasACCEPTmeltsACCEPTdissolvesIGNOREcolour of flame/explodes"}], "answerText": "41\nM1(6×0.074)+(7×0.926)M2=6.9", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}], "icTable": null, "warnings": ["orphan row before first entry: 1 a\nb", "orphan row before first entry: A", "orphan row before first entry: c i\nii", "orphan row before first entry: 2 a", "orphan row before first entry: M2 water(vapour)/moisture", "orphan row before first entry: b", "orphan row before first entry: c", "orphan row before first entry: M2 (oiling)", "orphan row before first entry: M3 (painting)", "orphan row before first entry: d", "orphan row before first entry: M2 (because) zinc is more reactive than iron/zinc (atoms) lose electrons more readily (than do iron atoms)", "orphan row before first entry: 3 a", "orphan row before first entry: b", "orphan row before first entry: c", "orphan row before first entry: d i\nii\niii", "orphan row before first entry: e i", "orphan row before first entry: e ii", "orphan row before first entry: 4 a", "orphan row before first entry: b", "orphan row before first entry: -(ve)", "orphan row before first entry: +(ve)", "orphan row before first entry: c", "orphan row before first entry: 5 a iii", "orphan row before first entry: 19", "19: bare integer cell \"2\" skipped (rubric/rowspan ambiguity)", "orphan row before first entry: 5 c iii", "orphan row before first entry: OH-/HO-", "orphan row before first entry: d", "orphan row before first entry: M2 because it is further from (the attraction of) nucleus (and therefore less strongly attracted to the nucleus)", "orphan row before first entry: ACCEPT reverse arguments as long as it is clear that lithium is being considered", "orphan row before first entry: 6 a", "orphan row before first entry: M2 produces oxygen(for breathing)", "orphan row before first entry: b i", "orphan row before first entry: M2n(LiOH)=answer toM1x2OR4.54(54...)(mol)", "orphan row before first entry: M3m(LiOH)=(answer toM3x24)=110(g)", "orphan row before first entry: OR", "orphan row before first entry: M148(g)reactswith44(g)", "orphan row before first entry: M2x(g)reactswith100(g)", "orphan row before first entry: M3x=110(g)", "orphan row before first entry: 6 b ii", "orphan row before first entry: M2 volume of $\\mathrm{CO}_{2}$ answer to M1 $\\times$ 24000", "orphan row before first entry: M3 $= 52000(\\mathrm{cm}^{3})$", "orphan row before first entry: 7 a", "orphan row before first entry: M2(step 2)magnesium carbonate is insoluble/magnesium carbonate does not form a solution", "orphan row before first entry: M3(step 3)boiling off all the water(will not produce a hydrated salt)", "orphan row before first entry: 7 b i", "orphan row before first entry: M2(before)", "orphan row before first entry: M3(volume added)", "orphan row before first entry: b ii", "orphan row before first entry: M2because it includes the air(contained in the tip of the burette)", "orphan row before first entry: c i", "orphan row before first entry: ii", "orphan row before first entry: If no results are ticked then M1 can only be awarded if the values from columns 2 and 4 are averaged", "orphan row before first entry: If only one column ticked then no marks can be awarded in(c)(ii)", "orphan row before first entry: M2 26.35(cm3)", "orphan row before first entry: Correct final answer without working scores 2", "orphan row before first entry: 7 d", "orphan row before first entry: M2", "orphan row before first entry: M3"], "paperTotal": null, "schemaVersion": "1.0", "questionTotals": {}, "reviewRequired": true, "extractionMethod": "glm-ocr-ms-v1"}', '{"findings": [{"msMarks": null, "qpMarks": 4, "severity": "qp-only", "questionNumber": "1"}, {"msMarks": null, "qpMarks": 8, "severity": "qp-only", "questionNumber": "2"}, {"msMarks": null, "qpMarks": 9, "severity": "qp-only", "questionNumber": "3"}, {"msMarks": null, "qpMarks": 6, "severity": "qp-only", "questionNumber": "4"}, {"msMarks": null, "qpMarks": 11, "severity": "qp-only", "questionNumber": "5"}, {"msMarks": null, "qpMarks": 14, "severity": "qp-only", "questionNumber": "7"}, {"msMarks": null, "qpMarks": null, "severity": "gap", "questionNumber": "6"}, {"msMarks": null, "qpMarks": null, "severity": "identity-mismatch", "questionNumber": "paper"}], "msPaperTotal": null, "qpPaperTotal": 60, "mismatchCount": 1, "paperTotalConflict": false}', NULL, '2026-09-13 12:59:56.008512