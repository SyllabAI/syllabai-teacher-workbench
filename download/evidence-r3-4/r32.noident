INSERT INTO public.question_versions VALUES ('e07407ce-f7cf-44f1-8940-95c3670251bc', 'b4fc14b2-0c54-45b4-9463-9886230b4e1a', 1, 'Lithium and carbon both form fluorides.', 8, 3, 720, NULL, 'SUGGESTED', '24df1df1-76c7-51e1-88c7-1ff3dd24bf7e', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:56.205163+00');
INSERT INTO public.question_versions VALUES ('36def696-25bd-4b05-9e54-2075a3ddc56e', '70295852-2ba9-4aca-9afa-f79cde94e48e', 1, 'Ethanol can be produced when yeast is added to a glucose solution. This apparatus is used to investigate the reaction.', 13, 3, 1170, NULL, 'SUGGESTED', '24df1df1-76c7-51e1-88c7-1ff3dd24bf7e', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:56.205539+00');
INSERT INTO public.question_versions VALUES ('cd41ddb1-3981-4760-be5a-089e47ef8720', '3531f967-55a4-4310-8f0c-b444e1d1bfd0', 1, 'Magnesium chloride can be made by reacting excess magnesium carbonate with dilute hydrochloric acid. The equation for the reaction is $\mathrm {M g C O} _ {3} + 2 \mathrm {H C l} \rightarrow \mathrm {M g C l} _ {2} + \mathrm {H} _ {2} \mathrm {O} + \mathrm {C O} _ {2}$', 7, 3, 630, NULL, 'SUGGESTED', '24df1df1-76c7-51e1-88c7-1ff3dd24bf7e', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:56.205903+00');
INSERT INTO public.question_versions VALUES ('0ad3c060-b9ec-4edb-8b3d-c09eae0d5d35', 'adab564e-17c3-40ab-acf7-e2795aaa7a14', 1, 'When nitrogen dioxide gas $ \mathrm{(N O_{2})} $ is placed in a sealed flask, it reacts to form dinitrogen tetraoxide gas $ \mathrm{(N_{2}O_{4})}. $ The equation for the reaction is $\begin{array}{c c c} 2 \mathrm {N O} _ {2} (\mathrm {g}) & \rightleftharpoons & \mathrm {N} _ {2} \mathrm {O} _ {4} (\mathrm {g}) \\ \mathrm {b r o w n g a s} & & \mathrm {c o l o u r l e s s g a s} \end{array}$ A sample of pure $ \mathrm{N O_{2}} $ is placed in a sealed flask at $ 2 5^{\circ} \mathrm{C} $ . The flask is left until a dynamic equilibrium is reached.', 8, 3, 720, NULL, 'SUGGESTED', '24df1df1-76c7-51e1-88c7-1ff3dd24bf7e', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:56.2062+00');
INSERT INTO public.question_versions VALUES ('6f7af314-b815-4eba-9e9b-508495aaebc1', '46db404c-25ae-4142-a19d-43362d7cde7b', 1, 'Sodium sulfate is a compound with many uses.', 4, 3, 360, NULL, 'SUGGESTED', '8d0a429e-bbff-5d24-aff9-17ce1f25d16f', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:56.382767+00');
