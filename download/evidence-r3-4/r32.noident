INSERT INTO public.questions VALUES ('84e48d16-f668-4cc2-8215-cecad026b97c', 'q06-35fdc8b0', 'STRUCTURED', 'A student uses this method to do a titration. use a measuring cylinder to obtain $ 2 5 \mathrm{c m}^{3} $ of sodium hydroxide solution transfer the solution to a conical flask add a few drops of universal indicator to the flask fill a burette with dilute sulfuric acid and record the initial burette reading add the acid to the flask, swirling the flask continuously add the acid slowly near the end-point record the final burette reading at the end-point The student repeats the titration until at least two concordant results are obtained.', 12, 3, 1080, NULL, 'fdf0a0a8-ac5a-4ef5-9c2a-65e1ef1047a8', 'PAST_PAPER', true, 1, '2026-09-13 13:03:37.86732+00', '24d55d2f-4250-4616-9d6f-7c4f480e84fa');
INSERT INTO public.questions VALUES ('da1f98b3-b4b5-48af-876e-660686140f59', 'q07-35fdc8b0', 'STRUCTURED', 'In the presence of an iron catalyst, nitrogen reacts with hydrogen to form ammonia. The reaction conditions used are a temperature of $ 4 5 0^{\circ} \mathrm{C} $ and a pressure of 200 atmospheres. This is the equation for the reaction. $\mathrm {N} _ {2} + 3 \mathrm {H} _ {2} \rightleftharpoons 2 \mathrm {N H} _ {3} \quad \Delta H = - 9 2 \mathrm {k J / m o l}$', 15, 3, 1350, NULL, 'fdf0a0a8-ac5a-4ef5-9c2a-65e1ef1047a8', 'PAST_PAPER', true, 1, '2026-09-13 13:03:37.867764+00', '24d55d2f-4250-4616-9d6f-7c4f480e84fa');
INSERT INTO public.questions VALUES ('bcf470bc-b7f9-472c-85df-d466b31421a6', 'q01-3097a144', 'STRUCTURED', 'The diagram shows six pieces of apparatus that are used in the laboratory. E F The table lists the names of four pieces of apparatus. Complete the table by giving a letter, A, B, C, D, E or F, to identify each piece of apparatus listed.', 1, 3, 90, NULL, '9722cc71-0e08-4404-846e-023f3cf30630', 'PAST_PAPER', true, 1, '2026-09-13 13:00:40.592244+00', '97d7a424-25c5-41dd-88bb-63a705fca148');
INSERT INTO public.questions VALUES ('46cb2f25-f872-4287-92b3-0e05143a3847', 'q02-3097a144', 'STRUCTURED', 'Rubidium is an element in Group 1 of the Periodic Table. 85 87 A sample of rubidium contains two isotopes, $ _{37}Rb $ and $ _{37}Rb $ (a) (i) State how the nuclei of the two isotopes are similar. (ii) State how the nuclei of the two isotopes are different. (iii) How many electrons are in the outer shell of a rubidium atom? A 1 B 3 C 9 D 37', 5, 3, 450, NULL, '9722cc71-0e08-4404-846e-023f3cf30630', 'PAST_PAPER', true, 1, '2026-09-13 13:00:40.592695+00', '97d7a424-25c5-41dd-88bb-63a705fca148');
INSERT INTO public.questions VALUES ('644efe0d-b5aa-4040-a80a-ace777cd5cd3', 'q03-3097a144', 'STRUCTURED', 'A student uses this apparatus to investigate the action of heat on sodium hydrogencarbonate $ \mathrm{(N a H C O_{3})}. $ The equation for the reaction is $2 \mathrm {N a H C O} _ {3} (\mathrm {s}) \rightarrow \mathrm {N a} _ {2} \mathrm {C O} _ {3} (\mathrm {s}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {g}) + \mathrm {C O} _ {2} (\mathrm {g})$', 5, 3, 450, NULL, '9722cc71-0e08-4404-846e-023f3cf30630', 'PAST_PAPER', true, 1, '2026-09-13 13:00:40.593058+00', '97d7a424-25c5-41dd-88bb-63a705fca148');
INSERT INTO public.questions VALUES ('d2ef4fa5-249b-4df0-a81a-e0c6c1360b77', 'q04-3097a144', 'STRUCTURED', 'Sodium reacts with fluorine to form sodium fluoride. The reaction is very exothermic.', 1, 3, 90, NULL, '9722cc71-0e08-4404-846e-023f3cf30630', 'PAST_PAPER', true, 1, '2026-09-13 13:00:40.593335+00', '97d7a424-25c5-41dd-88bb-63a705fca148');
INSERT INTO public.questions VALUES ('51d82033-bb09-4f77-879b-74855d9fcfc1', 'q05-3097a144', 'STRUCTURED', 'A student finds the temperature change when a mass of 0.5 g of sodium hydrogencarbonate is added to $ 5 0 \mathrm{c m}^{3} $ of a solution of citric acid. She repeats the experiment using masses of 1.0g, 1.5g and 2.0g of sodium hydrogencarbonate.', 6, 3, 540, NULL, '9722cc71-0e08-4404-846e-023f3cf30630', 'PAST_PAPER', true, 1, '2026-09-13 13:00:40.593645+00', '97d7a424-25c5-41dd-88bb-63a705fca148');
INSERT INTO public.questions VALUES ('f9e5c33a-3e90-4a69-aefd-4c649adcd8ed', 'q07-3097a144', 'STRUCTURED', 'Magnesium can be obtained by the electrolysis of magnesium chloride. Solid magnesium chloride is obtained from seawater. The magnesium chloride is melted and then electrolysed. The positive electrode is made of graphite and the negative electrode is made of steel. Magnesium forms at the negative electrode. Chlorine forms at the positive electrode.', 4, 3, 360, NULL, '9722cc71-0e08-4404-846e-023f3cf30630', 'PAST_PAPER', true, 1, '2026-09-13 13:00:40.594249+00', '97d7a424-25c5-41dd-88bb-63a705fca148');
INSERT INTO public.questions VALUES ('57e542eb-6fa6-4e96-8255-9c39435fc4a9', 'q08-3097a144', 'STRUCTURED', 'Submarines that spend a long time underwater use sodium peroxide $ \mathrm{(N a_{2} O_{2})} $ to absorb carbon dioxide $ \mathrm{(C O_{2})} $ from the air in the submarine. The equation for the reaction is $2 \mathrm {N a} _ {2} \mathrm {O} _ {2} + 2 \mathrm {C O} _ {2} \rightarrow 2 \mathrm {N a} _ {2} \mathrm {C O} _ {3} + \mathrm {O} _ {2}$', 6, 3, 540, NULL, '9722cc71-0e08-4404-846e-023f3cf30630', 'PAST_PAPER', true, 1, '2026-09-13 13:00:40.594535+00', '97d7a424-25c5-41dd-88bb-63a705fca148');
INSERT INTO public.questions VALUES ('40c43a50-85a0-49e1-9d85-1d1db70055c0', 'q09-3097a144', 'STRUCTURED', 'Ethanol $ \left( \mathrm{C}_{2} \mathrm{H}_{5} \mathrm{O H} \right) $ is made in industry by reacting ethene $ \left( \mathrm{C}_{2} \mathrm{H}_{4} \right) $ with steam at a temperature of $ 3 0 0^{\circ} \mathrm{C} $ and a pressure of 70 atm. The percentage yield of ethanol is 43%. The equation for the reaction is $\mathrm {C} _ {2} \mathrm {H} _ {4} (\mathrm {g}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {g}) \rightleftharpoons \mathrm {C} _ {2} \mathrm {H} _ {5} \mathrm {O H} (\mathrm {g}) \quad \Delta H = - 4 5. 3 \mathrm {k J / m o l}$', 9, 3, 810, NULL, '9722cc71-0e08-4404-846e-023f3cf30630', 'PAST_PAPER', true, 1, '2026-09-13 13:00:40.594862+00', '97d7a424-25c5-41dd-88bb-63a705fca148');
INSERT INTO public.questions VALUES ('cf283628-a3c9-4a55-afa7-f9e5ade124dd', 'q10-3097a144', 'STRUCTURED', 'Samarium, Sm, is a metal used to make powerful magnets.', 7, 3, 630, NULL, '9722cc71-0e08-4404-846e-023f3cf30630', 'PAST_PAPER', true, 1, '2026-09-13 13:00:40.59517+00', '97d7a424-25c5-41dd-88bb-63a705fca148');
