INSERT INTO public.question_parts VALUES ('223a2b49-68fa-4db5-aa42-a6e7f304ce8d', 'a260160e-3688-4a44-91c4-4b48ab4496ea', 'b-ii', 'The quantity of heat energy released in experiment 1 is 29200 J. Calculate the molar enthalpy change, in kJ/mol, for the combustion of methane. molar enthalpy change = ... kJ/mol', NULL, 0, 3, '2026-09-13 12:59:09.000385+00');
INSERT INTO public.question_parts VALUES ('9757afdd-31fa-4df8-add9-4a2293c460cb', 'a260160e-3688-4a44-91c4-4b48ab4496ea', 'b-iii', 'The temperature rise in experiment 2 is $ 4 1. 2 \mathrm{~} ^ {\circ} \mathrm{C}. $ Calculate the heat energy change in experiment 2 using the expressio heat energy change = volume of water $ \times $ 4.2 $ \times $ temperature change (in J) (in $ cm^{3} $) (in $ ^{\circ} C $) heat energy change = ... J', NULL, 0, 4, '2026-09-13 12:59:09.000442+00');
INSERT INTO public.question_parts VALUES ('913c3774-717c-4c29-a6cb-f1c6c06d15fc', 'a260160e-3688-4a44-91c4-4b48ab4496ea', 'b-iv', 'The student uses the results from experiment 3 to calculate the molar enthalpy change, in kJ/mol, for the combustion of methane. She compares her value with the value in a data book. Which is the best explanation for the large difference between these two values? B not all of the heat energy is transferred to the water A natural gas contains other gases that release heat energy when burned C some of the water evaporates during the experiment D the student measures the gas by volume instead of by mass', NULL, 0, 5, '2026-09-13 12:59:09.000496+00');
INSERT INTO public.question_parts VALUES ('c13cfb22-9c7f-4cc5-9710-e4668fd593ef', 'a260160e-3688-4a44-91c4-4b48ab4496ea', 'c', 'The student uses a table of average bond energies to calculate another value for the molar enthalpy of combustion of methane. The equation for the combustion can be shown using displayed formulae. $\mathrm {H} - \mathrm {C} - \mathrm {H} + 2 \mathrm {O} = \mathrm {O} \rightarrow \mathrm {O} = \mathrm {C} = \mathrm {O} + 2 \mathrm {H} - \mathrm {O} - \mathrm {H}$', NULL, 0, 6, '2026-09-13 12:59:09.000568+00');
INSERT INTO public.question_parts VALUES ('0db644f3-603f-4da3-b8c4-039ba85f78db', 'a260160e-3688-4a44-91c4-4b48ab4496ea', 'c-i', 'Use values from the table to calculate the energy taken in when the bonds in the reactants are broken. energy taken in = ... kJ', NULL, 0, 7, '2026-09-13 12:59:09.000643+00');
INSERT INTO public.question_parts VALUES ('42e98221-488f-4868-a61e-152991080b80', 'a260160e-3688-4a44-91c4-4b48ab4496ea', 'c-ii', 'Use values from the table to calculate the energy given out when the bonds in the products are formed. energy given out = ... kJ', NULL, 0, 8, '2026-09-13 12:59:09.000699+00');
INSERT INTO public.question_parts VALUES ('5dc9fa8a-b225-4ac4-9768-dc91fc29e478', 'a260160e-3688-4a44-91c4-4b48ab4496ea', 'c-iii', 'Use your answers to (i) and (ii) to calculate the molar enthalpy change for the combustion of methane. molar enthalpy change = kJ/mol', NULL, 0, 9, '2026-09-13 12:59:09.000777+00');
