INSERT INTO public.questions VALUES ('5d7cdae4-83f8-4324-958e-68da477b229a', 'q03-7e261528', 'STRUCTURED', 'This question is about carboxylic acids. Solutions of carboxylic acids react with magnesium metal to form hydrogen gas. This is the student''s method. pour some carboxylic acid solution into a conical flask add some magnesium powder quickly connect the gas syringe and start a timer record the time taken to collect $ 1 0 \mathrm{c m}^{3} $ of hydrogen gas The student repeats the method with three other carboxylic acids. A student uses this apparatus to investigate the time taken to produce $ 1 0 \mathrm{c m}^{3} $ of hydrogen gas from different carboxylic acids.', 1, 3, 90, NULL, 'a655ea63-a7cb-4fca-a68b-bac4ebf8106a', 'PAST_PAPER', true, 1, '2026-09-13 13:01:26.26021+00', 'c7cb58db-7f0b-4f65-84b3-a45244d6e886');
INSERT INTO public.questions VALUES ('b0b9ab98-be6d-4f47-9510-3a3b301aa727', 'q04-7e261528', 'STRUCTURED', 'This question is about sodium and potassium. A trough is filled with water and a few drops of phenolphthalein indicator are added.', 9, 3, 810, NULL, 'a655ea63-a7cb-4fca-a68b-bac4ebf8106a', 'PAST_PAPER', true, 1, '2026-09-13 13:01:26.260453+00', 'c7cb58db-7f0b-4f65-84b3-a45244d6e886');
