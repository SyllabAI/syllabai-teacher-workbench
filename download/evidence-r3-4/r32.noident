INSERT INTO public.document_chunks VALUES ('9c83f049-06e9-49f1-bfb6-ed800b504fad', 'f7a21fde-0f6d-4474-b922-d370b4d8b314', 1, 'Pearson: helping people progress, everywhere Our aim is to help everyone progress in their lives through education. We believe in every kind of learning, for all kinds of people, wherever they are in the world. We''ve been involved in education for over 150 years, and by working across 70 countries, in 100 languages, we have built an international reputation for our commitment to high standards and raising achievement through innovation in education. Find out more about how we can help you and your students at: www.pearson.com/uk
