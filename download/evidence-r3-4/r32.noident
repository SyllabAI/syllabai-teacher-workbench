mber": 7, "entryId": "ms-4faf474b-q7ai", "guidance": [{"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "(otherwise) ethanoic acid will form"}, {"kind": "allow", "text": "ALLOW(otherwise) ethanol will be oxidised or react with oxygen ALLOW fermentation/reaction/respiration needs to be anaerobic ALLOW(otherwise) ethanol would not be formed/CO2和H2O would be formed"}, {"kind": "note", "text": "(iii)"}, {"kind": "note", "text": "M1(reaction is catalysed by) enzymes(in yeast)M2which will denature(above40℃)"}, {"kind": "ignore", "text": "IGNORE yeast unqualifiedALLOW enzymes do not work above40℃"}, {"kind": "note", "text": "(iv)"}, {"kind": "note", "text": "M1 maximum mass of ethanol=8x46=368(g)M255.2x100(=15%)Alternative method:M1 actual yield of ethanol in mol=55.2/46=1.2M21.2x100(=15%)"}, {"kind": "note", "text": "(b)(i)"}, {"kind": "note", "text": "M1 rate of the forwards reaction=the rate of the backwards reactionM2the concentrations of reactants and products remain constant"}, {"kind": "ignore", "text": "IGNORE it is reversible reactionREJECT concentrations of reactants and products are equal or are the same"}, {"kind": "note", "text": "(b)(ii)"}, {"kind": "note", "text": "M1 an increase in temperature shifts the (position of) equilibrium in the endothermic direction(so backwards reaction is endothermic)M2so forward reaction is exothermic"}, {"kind": "ignore", "text": "IGNORE references to LeChatelier''s PrincipleALLOW heating for increase in temperatureM2DEP M1 or near miss"}], "answerText": "CO2", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "7(c)(i)", "marks": 2, "number": 7, "entryId": "ms-4faf474b-q7ci", "guidance": [{"kind": "allow", "text": "ALLOW1markifbothOHbutotherwisecorrect"}, {"kind": "note", "text": "(c)(ii)"}, {"kind": "note", "text": "M1addanamedcarbonateorhydrogencarbonate"}, {"kind": "note", "text": "M2effervescence/bubbles/fizzing"}, {"kind": "note", "t