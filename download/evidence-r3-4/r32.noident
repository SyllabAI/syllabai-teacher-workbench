INSERT INTO public.question_parts VALUES ('b89ea1fc-e0c4-4b05-be20-e7ea460b904c', '1065eb5a-36d5-4ff6-8f45-537463dd9fb2', 'f', 'Catalytic cracking also produces alkenes. $ \mathrm{C}_{1 1} \mathrm{H}_{2 4} $ can undergo cracking to give pentane $ \left( \mathrm{C}_{5} \mathrm{H}_{1 2} \right) $ and two different alkenes. Complete the equation for this cracking reaction. $\mathrm {C} _ {1 1} \mathrm {H} _ {2 4} \rightarrow \mathrm {C} _ {5} \mathrm {H} _ {1 2} +$', NULL, 0, 11, '2026-09-13 13:00:41.179645+00');
