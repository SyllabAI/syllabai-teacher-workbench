INSERT INTO public.question_parts VALUES ('1eddbe09-ac52-4020-af6a-47e0f0efbaa5', '3fb03be1-2a4f-4f40-a388-ece2f3936427', 'b-iii', 'One of the products of incomplete combustion is a poisonous gas. State why this gas is poisonous to humans.', NULL, 0, 4, '2026-09-13 12:54:40.215346+00');
INSERT INTO public.question_parts VALUES ('184c63b4-a1af-49cf-9aa8-5a3fbf303a3c', 'b16c4d2a-7c7b-4e65-bb71-059a57c29c9f', 'd-ii', 'Some methylbenzene is poured into beaker A. Some water is poured into beaker B. Hydrogen chloride gas is dissolved in each liquid. A separate piece of dry blue litmus paper is dipped into each solution. A hydrogen chloride dissolved in methylbenzene B hydrogen chloride dissolved in water Explain what happens to the piece of litmus paper dipped into beaker A the piece of litmus paper dipped into beaker B. beaker A beaker B', NULL, 4, 11, '2026-09-13 12:54:39.716311+00');
INSERT INTO public.question_parts VALUES ('c5bd0e09-c819-4a40-b8c6-d559f6c81fd6', 'ca4b58e6-9604-4be2-86c0-6d8ae33e1bac', 'a', 'A student is provided with a sample of a white solid.', NULL, 0, 0, '2026-09-13 12:54:39.716378+00');
INSERT INTO public.question_parts VALUES ('5c09d929-9651-4630-8e4c-0580dbed77ac', 'ca4b58e6-9604-4be2-86c0-6d8ae33e1bac', 'a-i', 'The student dissolves some of the white solid in water and then adds a few drops of sodium hydroxide solution. A white precipitate forms. She concludes that the sample contains calcium ions. Explain whether the student''s conclusion is valid.', NULL, 0, 1, '2026-09-13 12:54:39.716443+00');
