s": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "6(a)(i)", "marks": 2, "number": 6, "entryId": "ms-4f0f4ff7-q6ai", "guidance": [{"kind": "note", "text": "M1 carbon above iron in reactivity series"}, {"kind": "allow", "text": "ALLOW carbon is more reactive than iron ACCEPT reverse arguments"}, {"kind": "note", "text": "M2 so carbon can remove oxygen from iron(III) oxide"}, {"kind": "allow", "text": "ALLOW carbon can reduce iron(III)oxide ALLOW carbon can displace iron(from iron(III)oxide)"}, {"kind": "note", "text": "(ii) electricity not been discovered OWTTE"}, {"kind": "ignore", "text": "IGNORE electrolysis not discovered"}, {"kind": "note", "text": "(b)(i)"}, {"kind": "note", "text": "explanation including"}, {"kind": "note", "text": "M1 ions"}, {"kind": "note", "text": "If refs to electrons moving then scores 0"}, {"kind": "note", "text": "M2 can move"}, {"kind": "note", "text": "M2 DEP M1"}, {"kind": "note", "text": "(ii) The correct answer is C Na+"}, {"kind": "note", "text": "(iii)"}, {"kind": "note", "text": "A is incorrect because H+ ions not present in molten sodium chloride"}, {"kind": "note", "text": "B is incorrect because Cl- ion is not a cation"}, {"kind": "note", "text": "D is incorrect because OH- ion not present in molten sodium chloride"}, {"kind": "note", "text": "(iv)"}, {"kind": "note", "text": "explanation including"}, {"kind": "note", "text": "M1 water/moisture reacts with sodium"}, {"kind": "note", "text": "M2 to produce hydrogen (which ignites/burns/reacts in oxygen/air causing the small explosions)"}, {"kind": "note", "text": "(iv)"}, {"kind": "note", "text": "M1(anode)2Cl-→Cl2+2e(-)"}, {"kind": "note", "text": "ACCEPT 2Cl-→2e(-)→Cl2"}, {"kind": "note", "text": "M2(cathode)(2)Na++(2)e(-)→(2)Na"}, {"kind": "note", "text": "both half-equations correct but order reversed scores 1"}], "answerText": "explanation including", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "6(c)", "marks": 3, "number": 6, "entryId": "ms-4f0f4ff7-q6c", "guidance": [{"kind": "allow", "text": "ALLOW reverse arguments"}, {"kind": "note", "text": "M1outer electron in potassium (atom) is further away(from nucleus)"}, {"kind": "allow", "text": "ALLOW potassium (atom) has more(electron) shells than lithium (atom)"}, {"kind": "allow", "text": "ALLOW potassium (atom) larger than lithium (atom)"}, {"kind": "allow", "text": "ALLOW potassium has greater atomic radius"}, {"kind": "note", "text": "M2outer electron in potassium (atom) less strongly attracted by nucleus OWTTE"}, {"kind": "note", "text": "M3so(outer) electron more easily lost OWTTE"}], "answerText": "explanation including", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "7(a)", "marks": 1, "number": 7, "entryId": "ms-4f0f4ff7-q7a", "guidance": [{"kind": "note", "text": "(b)"}, {"kind": "note", "text": "M1 litmusM2 blueORM1 methyl orangeM2 yellowORM1 phenolphthaleinM2 pink"}, {"kind": "note", "text": "M2 DEP M1ALLOW purpleALLOW orangeALLOW any other suitable indicator and correct final colour"}, {"kind": "note", "text": "(c)"}, {"kind": "note", "text": "Description including any five from the followingM1 rinse/wash the conical flask (with distilled/deionised water)M2 (repeat titration/experiment) adding sodium hydroxide (from burette) slowly/dropwise (near end point)M3 swirling flaskM4 record initial and final volume burette reading (at end point)/record volume sodium hydroxide added (at end point)M5 repeat until obtain concordant resultsM6 find mean/average (of concordant results)"}, {"kind": "note", "text": "REJECT if rinsed/washed using solutionIGNORE names of indicators and any colour changesALLOW shaking/stirringALLOW reference to subtraction of initial and final readingsALLOW results within 0.2cm3(or less)"}, {"kind": "note", "text": "(d)(i)"}, {"kind"