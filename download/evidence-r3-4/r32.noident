INSERT INTO public.question_parts VALUES ('8bc2c862-892d-4619-b8ec-afcf845b7c18', 'f4164fd4-276a-4c37-a79a-5391843908d7', 'e', 'Catalytic cracking also produces alkenes. Decane $ \left( \mathrm{C}_{1 0} \mathrm{H}_{2 2} \right) $ can undergo cracking to give $ \mathrm{C}_{4} \mathrm{H}_{1 0} $ and two different alkenes. Complete the equation for this cracking process. $\mathrm {C} _ {1 0} \mathrm {H} _ {2 2} \rightarrow \mathrm {C} _ {4} \mathrm {H} _ {1 0} +$', NULL, 0, 6, '2026-09-13 13:02:54.084014+00');
INSERT INTO public.question_parts VALUES ('fb85d3ac-35d1-4fec-857d-b61ce546659f', '03aac6b4-ee75-4736-9420-0b914d0cd1b1', 'a', 'The student wants to find the volume of sulfuric acid needed to neutralise $ 2 5. 0 \mathrm{c m}^{3} $ of the potassium hydroxide solution. Describe how the student should do this titration. Assume that all pieces of apparatus are clean and dry.', NULL, 0, 0, '2026-09-13 13:02:54.084032+00');
INSERT INTO public.question_parts VALUES ('e1491263-8081-46ad-aba3-211657e649d5', '03aac6b4-ee75-4736-9420-0b914d0cd1b1', 'b', 'The student needs $ 1 5. 0 0 \mathrm{c m}^{3} $ of sulfuric acid to neutralise $ 2 5. 0 \mathrm{c m}^{3} $ of the potassium hydroxide solution. This is the equation for the reaction. $2 \mathrm {K O H} + \mathrm {H} _ {2} \mathrm {S O} _ {4} \rightarrow \mathrm {K} _ {2} \mathrm {S O} _ {4} + 2 \mathrm {H} _ {2} \mathrm {O}$', NULL, 0, 1, '2026-09-13 13:02:54.084049+00');
INSERT INTO public.question_parts VALUES ('f7718f9f-e7f3-483c-8d77-56f52e84270d', '03aac6b4-ee75-4736-9420-0b914d0cd1b1', 'b-i', 'Calculate the amount, in moles, of KOH in $ 2 5. 0 \mathrm{c m}^{3} $ of potassium hydroxide solution of concentration $ 0. 2 4 0 \mathrm{m o l} / \mathrm{d m}^{3}. $ $\mathrm {a m o u n t o f K O H} =$', NULL, 0, 2, '2026-09-13 13:02:54.084071+00');
INSERT INTO public.question_parts VALUES ('d0466ca8-c324-4f98-b162-bef68d79bfbe', '03aac6b4-ee75-4736-9420-0b914d0cd1b1', 'b-ii', 'Calculate the amount, in moles, of $ \mathrm{H_{2} S O_{4}} $ in $ 1 5. 0 0 \mathrm{c m}^{3} $ of the sulfuric acid. $\mathrm {a m o u n t o f H _ {2} S O _ {4}} =$', NULL, 0, 3, '2026-09-13 13:02:54.084101+00');
INSERT INTO public.question_parts VALUES ('0df0af1e-e8a5-411f-aaaa-46e7a0412b8c', '03aac6b4-ee75-4736-9420-0b914d0cd1b1', 'b-iii', 'Calculate the concentration, in mol/dm $ ^{3} $ , of the sulfuric acid. $\mathrm {m o l} / \mathrm {d m} ^ {3}$', NULL, 0, 4, '2026-09-13 13:02:54.084125+00');
INSERT INTO public.question_parts VALUES ('1e4c0e30-6796-4ea2-922c-443380373c5c', '6ac047eb-80ed-443d-b954-fa43a0bce7c5', 'a', 'The boxes give some information about a carboxylic acid. Complete the boxes by giving the missing information.', NULL, 0, 0, '2026-09-13 13:02:54.084159+00');
