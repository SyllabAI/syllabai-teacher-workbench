INSERT INTO public.document_chunks VALUES ('e245d586-1678-410e-9901-feec4bf6b446', '7d9c6f8b-cf43-4ec1-a0d4-a800bde0b19e', 15, 'Calculate the mass of water needed to react exactly with 28 kg of calcium oxide.
mass of water =
(ii) Explain why the reaction between carbon dioxide and calcium hydroxide can be described as neutralisation.
(b) Calcium carbide is a reactive solid. When water is added to it, a gas (ethyne) is formed.
A teacher uses this apparatus to investigate the rate of reaction between calcium carbide and water.
This is the teacher''s method.
record the temperature of the water in the flask
add a known mass of calcium carbide and replace the bung in the flask
record the time taken to collect $ 1 0 0 \mathrm{c m}^{3} $ of gas in the syringe
