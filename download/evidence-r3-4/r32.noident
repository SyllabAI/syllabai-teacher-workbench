INSERT INTO public.questions VALUES ('e1f2cc37-05e6-4421-82ef-bd5cec4fe6d1', 'q10-186fa85a', 'STRUCTURED', 'Zinc reacts with dilute hydrochloric acid to form zinc chloride and hydrogen gas. This is the equation for the reaction. $\mathrm {Z n} (\mathrm {s}) + 2 \mathrm {H C l} (\mathrm {a q}) \rightarrow \mathrm {Z n C l} _ {2} (\mathrm {a q}) + \mathrm {H} _ {2} (\mathrm {g})$', 12, 3, 1080, NULL, 'cb56b9ba-1e26-4322-a144-6425cccb9425', 'PAST_PAPER', true, 1, '2026-09-13 12:56:56.226218+00', '888b3c61-7839-4c7d-a15f-31931483b06b');
INSERT INTO public.questions VALUES ('7634a868-2a90-4025-85d1-cee1f1cd35b0', 'q04-d5f4942f', 'STRUCTURED', 'When magnesium is burned in air, it reacts with oxygen, $ \mathrm{O_{2}} $ , to form magnesium oxide, MgO A class of students investigated the relationship between the mass of magnesium burned and the mass of magnesium oxide formed. Each student was given a different mass of clean magnesium to heat. The students used the following method. Weigh a crucible and lid Place the magnesium ribbon in the crucible, replace the lid, and reweigh Heat the crucible as shown in the diagram until the magnesium burns Lift the lid from time to time until there is no sign of further reaction Allow the crucible and lid to cool and reweigh Repeat the heating, cooling and reweighing until two consecutive masses are the same Calculate the mass of magnesium oxide formed', 1, 3, 90, NULL, '9897dec9-c687-4aba-9a88-925fa10240e4', 'PAST_PAPER', true, 1, '2026-09-13 12:57:41.972861+00', '88ae4863-a87c-4050-adc5-8a72c3895798');
INSERT INTO public.questions VALUES ('cbdc8538-5911-4f62-95e8-aa8ba7590802', 'q08-d5f4942f', 'STRUCTURED', 'Sulfur dioxide, $ \mathrm{S O_{2}} $ , is used as a preservative in wine. The sulfur dioxide content of a wine can be found by titration. A chemist found that $ 2 5. 0 \mathrm{c m}^{3} $ of a sample of wine reacted with exactly $ 1 5. 0 0 \mathrm{c m}^{3} $ of 0.0010 mol/dm $ ^{3} $ aqueous iodine, $ \mathrm{I}_{2} $ (aq). The equation for the reaction is $\mathrm {S O} _ {2} (\mathrm {a q}) + \mathrm {I} _ {2} (\mathrm {a q}) + 2 \mathrm {H} _ {2} \mathrm {O} (\mathrm {l}) \rightarrow \mathrm {S O} _ {4} ^ {2 -} (\mathrm {a q}) + 2 \mathrm {I} ^ {-} (\mathrm {a q}) + 4 \mathrm {H} ^ {+} (\mathrm {a q})$', 8, 3, 720, NULL, '9897dec9-c687-4aba-9a88-925fa10240e4', 'PAST_PAPER', true, 1, '2026-09-13 12:57:41.977001+00', '88ae4863-a87c-4050-adc5-8a72c3895798');
