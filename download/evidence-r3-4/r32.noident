INSERT INTO public.document_chunks VALUES ('70ce2546-5c11-4780-a546-e09d087a3b0f', 'ec852bc6-8839-42a6-8aad-7e3ec729395e', 2, 'The lanthanoids (atomic numbers 58-71) and the actinoids (atomic numbers 90-103) have been omitted. The relative atomic masses of copper and chlorine have not been rounded to the nearest whole number.
