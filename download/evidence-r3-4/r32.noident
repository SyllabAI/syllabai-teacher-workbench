INSERT INTO public.question_parts VALUES ('239770e9-d6b1-4be4-9994-4e5f07f5d365', '05f393fb-1b21-4df8-91ca-a2a94c07701c', 'b', 'Show how the mass of magnesium oxide formed can be calculated from the readings obtained.', NULL, 0, 2, '2026-09-13 12:57:41.989892+00');
