INSERT INTO public.question_versions VALUES ('216ab8fe-f923-4dca-b0ce-fcff38e6855e', 'e9bfb5ef-a590-4889-9e6f-ee00584b1405', 1, 'Techniques used in the separation of mixtures include For each separation, select the most suitable technique, A, B, C or D, used to obtain the first named substance from the mixture. Each letter may be used once, more than once or not at all. A crystallisation B filtration C fractional distillation D simple distillation', 4, 3, 360, NULL, 'SUGGESTED', '25ccf10d-e7da-5f97-b268-57aa9afca8e0', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:12.060746+00');
