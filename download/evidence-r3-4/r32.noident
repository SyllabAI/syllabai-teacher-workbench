INSERT INTO public.question_versions VALUES ('d268c382-7cbf-40af-89a6-4cfa10c11327', '2038cdc9-9ba1-484b-8841-761f0c398299', 1, 'The diagram shows two samples of iron, A and B. Sample B is coated with a thin layer of zinc.', 10, 3, 900, NULL, 'SUGGESTED', 'a88d63cf-a49f-5183-8460-a8d7b67f2b09', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:40.3973+00');
