INSERT INTO public.document_chunks VALUES ('ce23e72f-200b-4adb-b4a2-d18a38fa1248', '1f57c0bc-a6ac-4a44-b5cc-bc488ee6dead', 5, 'When heated, some metal carbonates decompose to form a metal oxide and carbon dioxide gas.
(a) A student is given three solid metal carbonates, a timer, some limewater and this apparatus.
Describe a method the student can use to find out which metal carbonate decomposes fastest when heated.
(b) A student is given a solid metal carbonate with the formula $ \mathrm{X C O}_{3} $
X represents the symbol of a Group 2 metal.
A student uses this apparatus to heat a sample of $ \mathrm{X C O_{3}} $ until it all decomposes.
The equation for the decomposition of $ \mathrm{X C O_{3}} $ is
\mathrm {X C O} _ {3} \rightarrow \mathrm {X O} + \mathrm {C O} _ {2}
The student records the mass of $ \mathrm{X C O_{3}} $ and the mass of carbon dioxide that escapes through the cotton wool plug.
These are the student''s results.
mass of $ \mathrm{X C O}_{3}=7. 4 0 \mathrm{~ g} $
mass of $ \mathrm{C O_{2}}=2. 2 0 \mathrm{g} $
(i) Give a reason why the student uses a cotton wool plug.
(ii) Calculate the amount, in mol, of carbon dioxide produced.', 1, 1, '["e000077", "e000078", "e000080", "e000081", "e000082", "e000083", "e000085", "e000086", "e000087", "e000088", "e000089", "e000090", "e000091", "e000092"]', 261, NULL, NULL, NULL, '2026-09-13 12:56:10.394281+00');
