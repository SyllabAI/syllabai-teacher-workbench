INSERT INTO public.question_parts VALUES ('ae751913-e0e5-478b-96f1-16321837cc87', 'fab640db-1fce-43e7-b7df-fbd80ec518bc', 'b-v', 'State why the first line of best fit should pass through the origin.', NULL, 0, 8, '2026-09-13 12:56:56.25617+00');
INSERT INTO public.question_parts VALUES ('3f1e45e8-bc03-47b8-976b-37359f74ebe4', 'fab640db-1fce-43e7-b7df-fbd80ec518bc', 'b-vi', 'Use your graph to determine the volume of lead(II) nitrate solution needed to react completely with $ 1 5. 0 \mathrm{c m}^{3} $ of potassium chloride solution.', NULL, 0, 9, '2026-09-13 12:56:56.256202+00');
