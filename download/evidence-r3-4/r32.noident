INSERT INTO public.question_versions VALUES ('0d12e94e-492d-4895-9be4-1c8557fb385e', '3e734bd2-b3a2-418e-9d7b-8d6706e5140e', 1, 'A small piece of magnesium ribbon is added to dilute sulfuric acid in a test tube. Hydrogen gas is produced.', 4, 3, 360, NULL, 'SUGGESTED', '65fd691d-410e-5536-8ce4-e997fc25beea', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:56.512226+00');
