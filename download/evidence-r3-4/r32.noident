INSERT INTO public.questions VALUES ('99672fe5-cfc4-46bd-8c0f-a8aa55e9fc1d', 'q07-b8d86e00', 'STRUCTURED', 'Rusting occurs when iron is exposed to air and water. During rusting, iron reacts with oxygen from the air to form an oxide. Some students set up this apparatus to measure the volume of oxygen in a sample of air. Each student used an excess of wet iron filings. At the start of the experiment the reading on the syringe was recorded and the apparatus was then left for a week until the reaction was completed. At the end of the experiment the reading on the syringe was recorded again.', 12, 3, 1080, NULL, '7b4b613a-e904-410f-876d-03b6e9dbaafa', 'PAST_PAPER', true, 1, '2026-09-13 12:41:17.304973+00', '69ac6ca6-c5e7-46f4-aa27-d55ad777cc7a');
