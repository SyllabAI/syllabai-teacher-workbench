INSERT INTO public.question_versions VALUES ('e662592d-0306-463a-898e-98b968894b85', '3d6ae778-4baf-48ff-b4e5-47126d6aad45', 1, 'The boxes show the displayed formulae of six organic compounds, P, Q, R, S, T and U.', 1, 3, 90, NULL, 'SUGGESTED', 'a88d63cf-a49f-5183-8460-a8d7b67f2b09', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:40.397796+00');
INSERT INTO public.question_versions VALUES ('a0ede9b4-af19-4d67-ad6d-cf50b57fb7d1', 'db0f2d0e-8b68-431c-975a-4acb20d33cb2', 1, 'A student uses this method to investigate the reaction of dilute hydrochloric acid with zinc. pour some dilute hydrochloric acid into a glass beaker record the initial temperature of the acid add a piece of zinc and stir the mixture record the temperature of the mixture after one minute', 12, 3, 1080, NULL, 'SUGGESTED', 'a88d63cf-a49f-5183-8460-a8d7b67f2b09', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:40.398052+00');
INSERT INTO public.question_versions VALUES ('d94c1c45-35eb-4d00-a671-50bf57759c6d', 'f9cf987d-5bf3-415e-9cb9-a5009fe154bd', 1, 'This question is about some of the halogens and their compounds.', 13, 3, 1170, NULL, 'SUGGESTED', 'a88d63cf-a49f-5183-8460-a8d7b67f2b09', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:40.398281+00');
INSERT INTO public.question_versions VALUES ('2f0f8e72-7bed-489c-b4e5-08dd326dd642', 'f76a1b16-7598-4a41-8514-eec275a38742', 1, '(a) Carbon dioxide changes directly from a solid to a gas without becoming a liquid. (i) Give the name of the change of state from solid to gas. (ii) Describe the test for carbon dioxide gas.', 1, 3, 90, NULL, 'SUGGESTED', 'a88d63cf-a49f-5183-8460-a8d7b67f2b09', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:40.398514+00');
INSERT INTO public.question_versions VALUES ('0b3e634d-f751-4ca9-ad42-02f28fd588e3', '9d7fac14-8d39-448e-b601-5a798929b70c', 1, 'A student uses this apparatus to investigate the heat energy released when a liquid fuel is burned. This is the student''s method. measure the mass of the spirit burner and fuel add 100 $ cm^{3} $ of water to the copper can record the temperature of the water use the spirit burner to heat the water until the temperature rises by $ 3 0^{\circ} \mathrm{C} $ immediately measure the new mass of the spirit burner and fuel', 15, 3, 1350, NULL, 'SUGGESTED', 'a88d63cf-a49f-5183-8460-a8d7b67f2b09', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:40.398845+00');
INSERT INTO public.question_versions VALUES ('cd46c9f3-c2cd-472c-8960-cc1703833354', '0c1e057e-7e4a-4222-9413-a2023a662126', 1, 'Nitric acid $ \left( \mathrm{H N O}_{3} \right) $ is used in the production of fertilisers. Nitric acid is manufactured in three stages. Stage1 ammonia reacts with oxygen in the presence of a platinum catalyst to produce nitrogen monoxide gas, NO, and water. Stage 2 nitrogen monoxide gas reacts with more oxygen to produce nitrogen dioxide gas, $ \mathrm{N O_{2}}. $ Stage 3 nitrogen dioxide gas reacts with water to produce nitric acid and more nitrogen monoxide gas.', 1, 3, 90, NULL, 'SUGGESTED', 'a88d63cf-a49f-5183-8460-a8d7b67f2b09', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:40.399187+00');
INSERT INTO public.question_versions VALUES ('a799fca2-94d7-4ba5-abce-7d034c98b353', 'e314cd18-6f21-4f20-90a1-a1682c61d7c0', 1, 'The diagram shows the particles in the atom of an element. particle Y particle Z', 6, 3, 540, NULL, 'SUGGESTED', '1ed33ec4-b402-59d2-ac10-e808f3b34257', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:40.588419+00');
INSERT INTO public.question_versions VALUES ('3520868b-6b53-48ee-8ff9-220ebec67fda', 'b017a6e5-89fe-4366-849a-af83548861b7', 1, 'This question is about states of matter.', 7, 3, 630, NULL, 'SUGGESTED', '1ed33ec4-b402-59d2-ac10-e808f3b34257', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:40.588719+00');
INSERT INTO public.question_versions VALUES ('6851f3b6-2e4f-4ff5-86d4-e92a4ed0c9ec', 'af6e38b6-c4d8-4fab-a3b8-cfc87173e54b', 1, 'The Group 7 elements are called halogens. Halogens form compounds called halides. Three of the halogens are represented by the formulae $ X_{2}, Y_{2} $ and $ Z_{2} $ Solutions of these halogens are added separately to solutions of sodium halides, NaX, NaY and NaZ. The table shows whether or not a reaction occurs.', 9, 3, 810, NULL, 'SUGGESTED', '1ed33ec4-b402-59d2-ac10-e808f3b34257', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:40.592613+00');
INSERT INTO public.question_versions VALUES ('124ef9d7-a420-4b57-a1e8-f9bb63a9c853', 'cdb001c4-4fd7-43bd-abfb-b53f79acc001', 1, 'This question is about ammonium chloride.', 9, 3, 810, NULL, 'SUGGESTED', '1ed33ec4-b402-59d2-ac10-e808f3b34257', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:40.595033+00');
INSERT INTO public.question_versions VALUES ('9c2262c3-da43-4db1-8c38-e52f73385a23', 'a315a77b-c1fa-44f6-986a-e740a26bf1f6', 1, 'A teacher uses the reaction between phosphorus and oxygen to calculate the percentage of oxygen in air. She uses this apparatus and excess phosphorus. The volume of gas in the tube decreases as the phosphorus reacts with oxygen. The teacher measures the volume of gas in the tube at one-minute intervals. The table shows the teacher''s results.', 1, 3, 90, NULL, 'SUGGESTED', '1ed33ec4-b402-59d2-ac10-e808f3b34257', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:40.596946+00');
INSERT INTO public.question_versions VALUES ('ffcd5b0a-676e-4b28-9155-4c56767da24a', '03527fe8-1f11-4863-84e6-785ff9e42d83', 1, 'The reaction between magnesium and copper(II) sulfate solution is exothermic. This apparatus is used to measure the temperature increase when excess magnesium is added to $ 1 0 0 \mathrm{c m}^{3} $ of copper(II) sulfate solution.', 12, 3, 1080, NULL, 'SUGGESTED', '1ed33ec4-b402-59d2-ac10-e808f3b34257', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:40.59744+00');
INSERT INTO public.question_versions VALUES ('f1ae39f9-7206-405b-a9e6-5b1bb92a4a52', 'e642c9fe-a2bf-43f1-84b6-42be23c2e54b', 1, 'A student investigates the reaction between sodium hydroxide solution and hydrochloric acid. He uses this method. Step 1 add $ 5 0 \mathrm{c m}^{3} $ of dilute hydrochloric acid to a conical flask Step 2 add a $ 5 \mathrm{c m}^{3} $ portion of sodium hydroxide solution to the conical flask Step 3 test the pH of the mixture using both universal indicator paper and a pH meter The student repeats step 2 and step 3 until a total of $ 5 0 \mathrm{c m}^{3} $ of sodium hydroxide solution has been added.', 1, 3, 90, NULL, 'SUGGESTED', '1ed33ec4-b402-59d2-ac10-e808f3b34257', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:40.598376+00');
INSERT INTO public.question_versions VALUES ('eedc2fe0-ad86-4e48-9f34-041c8298ae7e', '1fd4fc45-d70d-4b40-b710-90e407967815', 1, '(a) The diagram shows the arrangement of electrons in an atom of calcium and in an atom of chlorine. Describe, in terms of electrons, what happens when calcium reacts with chlorine to form the ionic compound calcium chloride, $ \mathrm{C a C l}_{2} $', 14, 3, 1260, NULL, 'SUGGESTED', '1ed33ec4-b402-59d2-ac10-e808f3b34257', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:40.600941+00');
