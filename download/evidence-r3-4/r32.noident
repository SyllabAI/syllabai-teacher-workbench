35", "e000037", "e000038", "e000040", "e000041", "e000042", "e000043", "e000044", "e000045", "e000046", "e000047", "e000048", "e000049", "e000050", "e000052", "e000053", "e000054", "e000055", "e000057", "e000058", "e000059", "e000060", "e000061", "e000063", "e000064", "e000065", "e000066", "e000067", "e000068", "e000069", "e000070", "e000071", "e000072", "e000074", "e000075", "e000076", "e000077", "e000078", "e000080", "e000081", "e000082", "e000083", "e000084", "e000086", "e000088", "e000089", "e000090", "e000091", "e000093", "e000094", "e000095", "e000096", "e000097", "e000099", "e000101", "e000102", "e000103"], "pageNumber": 1}, {"level": 2, "title": "BLANK PAGE", "sectionId": "s006", "elementIds": ["e000105", "e000108", "e000109", "e000110", "e000111", "e000112", "e000114", "e000116", "e000117", "e000118", "e000119", "e000121", "e000123", "e000124", "e000126", "e000128", "e000130", "e000131"], "pageNumber": 1}, {"level": 2, "title": "BLANK PAGE", "sectionId": "s007", "elementIds": [], "pageNumber": 1}, {"level": 2, "title": "BLANK PAGE", "sectionId": "s008", "elementIds": [], "pageNumber": 1}, {"level": 2, "title": "BLANK PAGE", "sectionId": "s009", "elementIds": ["e000135"], "pageNumber": 1}], "equations": [{"text": "\\mathrm {C u} ^ {2 +} + 2 \\mathrm {e} ^ {-} \\rightarrow \\mathrm {C u}", "latex": "\\mathrm {C u} ^ {2 +} + 2 \\mathrm {e} ^ {-} \\rightarrow \\mathrm {C u}", "confidence": 1.0, "element_id": "e000073", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 73, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {C} _ {2} \\mathrm {H} _ {4} + \\mathrm {H} _ {2} \\mathrm {O} \\rightarrow \\mathrm {C} _ {2} \\mathrm {H} _ {5} \\mathrm {O H}", "latex": "\\mathrm {C} _ {2} \\mathrm {H} _ {4} + \\mathrm {H} _ {2} \\mathrm {O} \\rightarrow \\mathrm {C} _ {2} \\mathrm {H} _ {5} \\mathrm {O H}", "confidence": 1.0, "element_id": "e000085", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 85, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "C _ {6} H _ {1 2} O _ {6} \\rightarrow 2 C _ {2} H _ {5} O H + 2 C O _ {2}", "latex": "C _ {6} H _ {1 2} O _ {6} \\rightarrow 2 C _ {2} H _ {5} O H + 2 C O _ {2}", "confidence": 1.0, "element_id": "e000087", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 87, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {C H} _ {2} = \\mathrm {C H} - \\mathrm {C H} _ {2} - \\mathrm {C H} _ {3} + \\mathrm {H} _ {2} \\mathrm {O} \\rightarrow \\mathrm {C H} _ {3} - \\mathrm {C H} - \\mathrm {C H} _ {2} - \\mathrm {C H} _ {3}", "latex": "\\mathrm {C H} _ {2} = \\mathrm {C H} - \\mathrm {C H} _ {2} - \\mathrm {C H} _ {3} + \\mathrm {H} _ {2} \\mathrm {O} \\rightarrow \\mathrm {C H} _ {3} - \\mathrm {C H} - \\mathrm {C H} _ {2} - \\mathrm {C H} _ {3}", "confidence": 1.0, "element_id": "e000098", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 98, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "Q = m \\times 4. 2 \\times \\Delta T", "latex": "Q = m \\times 4. 2 \\times \\Delta T", "confidence": 1.0, "element_id": "e000115", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 115, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\Delta H =", "latex": "\\Delta H =", "confidence": 1.0, "element_id": "e000120", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 120, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\begin{array}{c c} \\mathrm {e n e r g y} & \\mathrm {c a r b o n d i o x i d e} \\\\ \\hline \\mathrm {m e t h a n o l} & \\mathrm {c a r b o n d i o x i d e} \\\\ \\end{array}", "latex": "\\begin{array}{c c} \\mathrm {e n e r g y} & \\mathrm {c a r b o n d i o x i d e} \\\\ \\hline \\mathrm {m e t h a n o l} & \\mathrm {c a r b o n d i o x i d e} \\\\ \\end{array}", "confidence": 1.0, "element_id": "e000122", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 122, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {H} - \\mathrm {C} - \\mathrm {O} - \\mathrm {H} + 1. 5 \\mathrm {O} = \\mathrm {O} \\rightarrow \\mathrm {O} = \\mathrm {C} = \\mathrm {O} + 2 \\mathrm {H} - \\mathrm {O} - \\mathrm {H}", "latex": "\\mathrm {H} - \\mathrm {C} - \\mathrm {O} - \\mathrm {H} + 1. 5 \\mathrm {O} = \\mathrm {O} \\rightarrow \\mathrm {O} = \\mathrm {C} = \\mathrm {O} + 2 \\mathrm {H} - \\mathrm {O} - \\mathrm {H}", "confidence": 1.0, "element_id": "e000127", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 127, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\Delta H =", "latex": "\\Delta H =", "confidence": 1.0, "element_id": "e000129", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 129, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "pageCount": 1, "documentId": "8d0a429e-bbff-5d24-aff9-17ce1f25d16f", "provenance": {"engine": "glm-ocr-markdown", "application": "syllabai-parser", "extractedAt": "2026-09-13T12:59:35.612735960Z", "engineVersion": "1.1.0", "schemaVersion": "1.0", "extractionParams": {"pageBoundaries": "none-in-source", "sourceLineCount": 187, "upstreamConverter": "zai-glm-ocr", "entityDecodedLines": 0, "signedUrlFigureRefs": 0, "normalizedHtmlEntities": true}}, "textBlocks": [{"role": "heading", "text": "Instructions", "confidence": 1.0, "element_id": "e000001", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 1, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Use black ink or ball-point pen.", "confidence": 1.0, "element_id": "e000002", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 2, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Fill in the boxes at the top of this page with your name, centre number and candidate number.", "confidence": 1.0, "element_id": "e000003", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 3, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer all questions.", "confidence": 1.0, "element_id": "e000004", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 4, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer the questions in the spaces provided", "confidence": 1.0, "element_id": "e000005", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 5, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "there may be more space than you need.", "confidence": 1.0, "element_id": "e000006", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 6, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Show all the steps in any calculations and state the units.", "confidence": 1.0, "element_id": "e000007", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 7, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Some questions must be answered with a cross in a box. If you change your mind about an answer, put a line through the box and then mark your new answer with a cross.", "confidence": 1.0, "element_id": "e000008", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 8, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Information", "confidence": 1.0, "element_id": "e000009", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 9, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The total mark for this paper is 60.", "confidence": 1.0, "element_id": "e000010", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 10, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The marks for each question are shown in brackets", "confidence": 1.0, "element_id": "e000011", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 11, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "use this as a guide as to how much time to spend on each question.", "confidence": 1.0, "element_id": "e000012", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 12, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Advice", "confidence": 1.0, "element_id": "e000013", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 13, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Read each question carefully before you start to answer it.", "confidence": 1.0, "element_id": "e000014", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 14, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Write your answers neatly and in good English.", "confidence": 1.0, "element_id": "e000015", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 15, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Try to answer every question.", "confidence": 1.0, "element_id": "e000016", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 16, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Check your answers if you have time at the end.", "confidence": 1.0, "element_id": "e000017", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 17, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Turn over", "confidence": 1.0, "element_id": "e000018", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 18, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Answer ALL questions.", "confidence": 1.0, "element_id": "e000020", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 20, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "1 Sodium sulfate is a compound with many uses.", "confidence": 1.0, "element_id": "e000021", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 21, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) The formula of the main compound used as the source of sodium sulfate is $ \\mathrm{N a_{2} S O_{4}. 1 0 H_{2} O} $ How many different elements are shown in this formula?", "confidence": 1.0, "element_id": "e000022", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 22, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A 2", "confidence": 1.0, "element_id": "e000023", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 23, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B 3", "confidence": 1.0, "element_id": "e000024", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 24, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C 4", "confidence": 1.0, "element_id": "e000025", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 25, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D 5", "confidence": 1.0, "element_id": "e000026", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 26, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Sodium sulfate can be made from sodium hydroxide and sulfuric acid.", "confidence": 1.0, "element_id": "e000027", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 27, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Balance the equation for the reaction between sodium hydroxide and sulfuric acid. (1)", "confidence": 1.0, "element_id": "e000028", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 28, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "$ \\mathrm{N a O H}+ \\mathrm{H_{2} S O_{4}} \\rightarrow \\mathrm{N a_{2} S O_{4}}+ \\mathrm{H_{2} O} $", "confidence": 1.0, "element_id": "e000029", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 29, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Sodium hydroxide is manufactured by the electrolysis of brine in the diaphragm cell. Sulfuric acid is manufactured using the contact process. The table contains some statements about these two processes. Place ticks ( $ \\checkmark $ ) in the boxes to show the two correct statements.", "confidence": 1.0, "element_id": "e000030", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 30, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 1 = 4 marks)", "confidence": 1.0, "element_id": "e000032", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 32, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000033", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 33, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "2 The diagram shows the positions of some elements in part of the Periodic Table.", "confidence": 1.0, "element_id": "e000034", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 34, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "He", "confidence": 1.0, "element_id": "e000035", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 35, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) How many periods and groups are shown in this diagram?", "confidence": 1.0, "element_id": "e000037", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 37, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(1)", "confidence": 1.0, "element_id": "e000038", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 38, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) How many elements shown in the diagram are noble gases?", "confidence": 1.0, "element_id": "e000040", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 40, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A 1", "confidence": 1.0, "element_id": "e000041", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 41, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B 2", "confidence": 1.0, "element_id": "e000042", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 42, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C 3", "confidence": 1.0, "element_id": "e000043", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 43, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D 4", "confidence": 1.0, "element_id": "e000044", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 44, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) What is the formula of the compound formed between magnesium and fluorine? (1)", "confidence": 1.0, "element_id": "e000045", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 45, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A MgF", "confidence": 1.0, "element_id": "e000046", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 46, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B $ \\mathrm{M g_{2} F} $", "confidence": 1.0, "element_id": "e000047", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 47, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C $ \\mathrm{M g F_{2}} $", "confidence": 1.0, "element_id": "e000048", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 48, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D $ \\mathrm{M g_{2} F_{2}} $", "confidence": 1.0, "element_id": "e000049", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 49, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) The table shows the percentage composition by mass of a sample of silicon.", "confidence": 1.0, "element_id": "e000050", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 50, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Calculate the relative atomic mass of this sample of silicon. Give your answer to one decimal place.", "confidence": 1.0, "element_id": "e000052", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 52, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "relative atomic mass=", "confidence": 1.0, "element_id": "e000053", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 53, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(e) A molecule of silicon tetrafluoride $ \\mathrm{(S i F_{4})} $ contains covalent bonds. Draw a dot and cross diagram to show the outer electrons in this molecule.", "confidence": 1.0, "element_id": "e000054", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 54, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(f) The table shows the boiling points of some compounds containing silicon. All of these compounds contain covalent bonds.", "confidence": 1.0, "element_id": "e000055", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 55, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "$ \\mathrm{S i F}_{4} $ and $ \\mathrm{S i C l}_{4} $ have simple molecular structures.", "confidence": 1.0, "element_id": "e000057", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 57, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "$ \\mathrm{S i O}_{2} $ has a giant covalent structure.", "confidence": 1.0, "element_id": "e000058", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 58, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Explain why the boiling point of $ \\mathrm{S i C l}_{4} $ is greater than the boiling point of $ \\mathrm{S i F}_{4} $", "confidence": 1.0, "element_id": "e000059", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 59, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Explain why the boiling point of $ \\mathrm{S i O_{2}} $ is very much greater than the boiling point of $ \\mathrm{S i C l_{4}} $", "confidence": 1.0, "element_id": "e000060", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 60, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "3 This apparatus can be used to investigate electrolysis.", "confidence": 1.0, "element_id": "e000061", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 61, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Name the particles that move through the connecting wires to form an electric current.", "confidence": 1.0, "element_id": "e000063", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 63, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The electrodes are made of platinum, which is an inert metal. State what is meant by the term inert.", "confidence": 1.0, "element_id": "e000064", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 64, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Explain why the electrolytic cell containing $ \\mathrm{P b B r}_{2} $ needs to be heated before electrolysis can occur.", "confidence": 1.0, "element_id": "e000065", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 65, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) When NaCl(aq) is electrolysed, two gases form at the positive electrode and one gas forms at the negative electrode.", "confidence": 1.0, "element_id": "e000066", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 66, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The formulae of the species in $ \\mathrm{N a C l} ( \\mathrm{a q} ) $ are $ \\mathrm{N a}^{+}, \\mathrm{C l}^{-}, \\mathrm{H}^{+}, \\mathrm{O H}^{-} $ and $ \\mathrm{H}_{2} \\mathrm{O}. $", "confidence": 1.0, "element_id": "e000067", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 67, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Name the gases formed at each electrode.", "confidence": 1.0, "element_id": "e000068", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 68, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "positive electrode ...", "confidence": 1.0, "element_id": "e000069", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 69, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "negative electrode.", "confidence": 1.0, "element_id": "e000070", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 70, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Give ionic half-equations to show the formation of each gas.", "confidence": 1.0, "element_id": "e000071", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 71, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(e) The ionic half-equation for one of the reactions in the cell containing copper(II) sulfate solution is", "confidence": 1.0, "element_id": "e000072", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 72, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "During the electrolysis, a charge of 0.040 faradays passes through this cell.", "confidence": 1.0, "element_id": "e000074", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 74, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Calculate the mass of copper metal formed.", "confidence": 1.0, "element_id": "e000075", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 75, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 3 = 11 marks)", "confidence": 1.0, "element_id": "e000076", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 76, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "4 Compounds containing C=C double bonds are used to manufacture alcohols such as ethanol and addition polymers such as PVC.", "confidence": 1.0, "element_id": "e000077", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 77, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The table shows the formulae of some compounds containing C=C bonds.", "confidence": 1.0, "element_id": "e000078", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 78, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) (i) Explain which three of these compounds are hydrocarbons.", "confidence": 1.0, "element_id": "e000080", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 80, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Explain which compound is shown as a displayed formula.", "confidence": 1.0, "element_id": "e000081", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 81, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Ethanol can be manufactured from compound A using reaction 1. Ethanol can also be manufactured from glucose using reaction 2.", "confidence": 1.0, "element_id": "e000082", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 82, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The equations for these reactions are", "confidence": 1.0, "element_id": "e000083", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 83, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "reaction 1", "confidence": 1.0, "element_id": "e000084", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 84, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "reaction 2", "confidence": 1.0, "element_id": "e000086", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 86, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Give two advantages of using each reaction to manufacture ethanol.", "confidence": 1.0, "element_id": "e000088", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 88, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "reaction 1.", "confidence": 1.0, "element_id": "e000089", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 89, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "reaction 2.", "confidence": 1.0, "element_id": "e000090", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 90, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Compound C reacts with bromine to form a product with this formula.", "confidence": 1.0, "element_id": "e000091", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 91, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Use this formula to determine the name of compound C.", "confidence": 1.0, "element_id": "e000093", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 93, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) State the colour of the product formed when compound C reacts with bromine.", "confidence": 1.0, "element_id": "e000094", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 94, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) Compound X is an isomer of compound C.", "confidence": 1.0, "element_id": "e000095", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 95, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Explain what is meant by the term isomers.", "confidence": 1.0, "element_id": "e000096", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 96, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The equation for the conversion of compound X to an alcohol is", "confidence": 1.0, "element_id": "e000097", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 97, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Place ticks ( $ \\checkmark $ ) in the boxes to show the two correct descriptions of this reaction.", "confidence": 1.0, "element_id": "e000099", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 99, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(e) Compound D, chloroethene, can be used to manufacture the polymer PVC.", "confidence": 1.0, "element_id": "e000101", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 101, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) State the full name of PVC.", "confidence": 1.0, "element_id": "e000102", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 102, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Write an equation, containing displayed formulae, to represent the reaction that occurs in the manufacture of PVC.", "confidence": 1.0, "element_id": "e000103", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 103, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000104", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 104, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "5 A student uses this apparatus to find the increase in temperature of water when methanol, $ \\mathrm{C H_{3} O H} $ , is burned.", "confidence": 1.0, "element_id": "e000105", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 105, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) There are several reasons why the increase in temperature is less than expected.", "confidence": 1.0, "element_id": "e000108", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 108, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) One reason is the incomplete combustion of methanol to form only carbon monoxide and water.", "confidence": 1.0, "element_id": "e000109", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 109, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Write the chemical equation for this incomplete combustion.", "confidence": 1.0, "element_id": "e000110", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 110, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) State another reason why the increase in temperature is less than expected.", "confidence": 1.0, "element_id": "e000111", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 111, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The student records these results.", "confidence": 1.0, "element_id": "e000112", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 112, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Calculate the heat energy change (Q), in joules, in this experiment using the expression", "confidence": 1.0, "element_id": "e000114", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 114, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "where m is the mass of water in grams and $ \\Delta T $ represents the increase in temperature.", "confidence": 1.0, "element_id": "e000116", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 116, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The relative molecular mass of methanol is 32", "confidence": 1.0, "element_id": "e000117", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 117, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Use this information and your value for Q to calculate the molar enthalpy change, $ \\Delta H $ , for the combustion of methanol.", "confidence": 1.0, "element_id": "e000118", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 118, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Give your answer in kJ/mol.", "confidence": 1.0, "element_id": "e000119", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 119, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) The student draws an energy level diagram for the complete combustion of methanol.", "confidence": 1.0, "element_id": "e000121", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 121, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Identify the two mistakes in his diagram.", "confidence": 1.0, "element_id": "e000123", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 123, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) The student is given this table of average (mean) bond energies.", "confidence": 1.0, "element_id": "e000124", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 124, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The equation for the complete combustion of methanol is", "confidence": 1.0, "element_id": "e000126", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 126, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Use this equation and the information in the table to calculate another value for the molar enthalpy change, $ \\Delta H $ , for the combustion of methanol.", "confidence": 1.0, "element_id": "e000128", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 128, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 5 = 15 marks)", "confidence": 1.0, "element_id": "e000130", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 130, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "TOTAL FOR PAPER = 60 MARKS", "confidence": 1.0, "element_id": "e000131", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 131, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000132", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 132, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000133", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 133, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000134", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 134, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Every effort has been made to contact copyright holders to obtain their permission for the use of copyright material. Pearson Education Ltd. will, if notified, be happy to rectify any errors or omissions and include any such rectifications in future editions.", "confidence": 1.0, "element_id": "e000135", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 135, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "schemaVersion": "1.0"}', NULL, '2026-09-13 12:59:56.317485+00');
INSERT INTO public.documents VALUES ('3a8fec54-4971-4e49-8a5a-fd3794ad3695', '331fb228-f36f-52dc-b6b4-ec65c3085c25', '1.0', 1, 'MARK_SCHEME', 'corpus/igcse-chemistry-4ch0-2c-2017jun/MS.md', 'MS.md', 'text/markdown', 'f004376e7520a90e1e08b01bf6e0fbb9f4b2ce629f27cf5617f498d02ed9e57e', 'SHA-256', 1, 36, 35, 14, 'glm-ocr-markdown', '1.1.0', '2026-09-13 12:59:35.671462+00', '{"pages": [{"width": null, "height": null, "pageNumber": 1}], "source": {"uri": "corpus/igcse-chemistry-4ch0-2c-2017jun/MS.md", "checksum": "f004376e7520a90e1e08b01bf6e0fbb9f4b2ce629f27cf5617f498d02ed9e57e", "fileName": "MS.md", "mimeType": "text/markdown", "checksumAlgorithm": "SHA-256"}, "tables": [{"rows": [["Question number", "Answer", "Notes", "Marks"], ["1(a)", "C(4)\nThe only correct answer is C\nA is not correct because there are 4 elements shown not 2\nB is not correct because there are 4 elements shown not 3\nD is not correct because there are 4 elements shown not 5", "", "1"], ["(b)", "2NaOH+(1)H2SO4→(1)Na2SO4+2H2O", "Accept fractions and multiples", "1"], ["(c)", "brine is a solution of sodium chloride in water", "√", "3 ticks with 2 correct scores 1\n3 ticks with 1 correct scores 0\n4 or 5 ticks scores 0", "2"], ["the temperature used in the contact process is greater than 1000℃", ""], ["an equation for the contact process isSO2+H2O→H2SO4", ""], ["the reactions in the diaphragm cell are displacement reactions", ""], ["the catalyst used in the contact process is vanadium(V) oxide", "√"], ["", "Total", "4"]], "text": "Question number | Answer | Notes | Marks\n1(a) | C(4)\nThe only correct answer is C\nA is not correct because there are 4 elements shown not 2\nB is not correct because there are 4 elements shown not 3\nD is not correct because there are 4 elements shown not 5 |  | 1\n(b) | 2NaOH+(1)H2SO4→(1)Na2SO4+2H2O | Accept fractions and multiples | 1\n(c) | brine is a solution of sodium chloride in water | √ | 3 ticks with 2 correct scores 1\n3 ticks with 1 correct scores 0\n4 or 5 tick