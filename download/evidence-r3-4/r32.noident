INSERT INTO public.questions VALUES ('68d4c496-f850-4ded-9bbb-f787b64ecea2', 'q08-20626212', 'STRUCTURED', '(a) (i) Organic compounds can exist as isomers. Explain what is meant by the term isomers. (ii) Organic compound Q reacts with bromine, without the presence of ultraviolet radiation, to form the compound $ \mathrm{C_{4} H_{8} B r_{2}} $ Draw the displayed formulae of two isomers of Q.', 1, 3, 90, NULL, '47c0f6dc-81dd-49bc-8a9d-3d75785bf564', 'PAST_PAPER', true, 1, '2026-09-13 12:55:24.076564+00', '24bec6c1-9d53-4c29-914d-1a3bda8ce6ce');
