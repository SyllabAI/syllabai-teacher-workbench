INSERT INTO public.question_versions VALUES ('13729337-973b-46a1-bb09-5e0d69f33c8a', '25ef4b3b-9e53-42f1-9bcf-23d7e0f460de', 1, 'This question is about gases in the atmosphere.', 10, 3, 900, NULL, 'SUGGESTED', 'd9f7c281-91c5-5cba-b2e3-49460138d3a7', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:03:38.504419+00');
INSERT INTO public.question_versions VALUES ('31c019a2-1930-4ceb-9de7-85b1b3f0de08', 'a31fdca6-a236-4eb0-b3f1-ca2fe2026369', 1, 'This question is about alcohols. Ethanol can be manufactured using two different methods. hydration of ethene fermentation of glucose This is the equation for hydration. $\mathrm {C} _ {2} \mathrm {H} _ {4} + \mathrm {H} _ {2} \mathrm {O} \rightarrow \mathrm {C} _ {2} \mathrm {H} _ {5} \mathrm {O H}$', 1, 3, 90, NULL, 'SUGGESTED', 'd9f7c281-91c5-5cba-b2e3-49460138d3a7', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:03:38.504668+00');
INSERT INTO public.question_versions VALUES ('c246e691-b7b1-4e86-b26a-4559ea936aa2', '0e386c90-b272-483f-bcba-2440c23bc2e3', 1, 'A student does a titration to find the concentration of potassium hydroxide solution. This is the student''s method. add $ 2 5. 0 \mathrm{c m}^{3} $ of the potassium hydroxide solution to a conical flask add a few drops of methyl orange indicator to the conical flask fill a burette with dilute sulfuric acid and record the initial burette reading place the conical flask on a white tile add the acid from the burette to the mixture in the conical flask, swirling the flask continuously when the indicator changes colour at the end point, record the final burette reading Repeat the titration to obtain concordant results.', 1, 3, 90, NULL, 'SUGGESTED', 'd9f7c281-91c5-5cba-b2e3-49460138d3a7', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:03:38.504941+00');
INSERT INTO public.question_versions VALUES ('98fa232d-d995-4867-bf83-32999082a736', '622fb21d-e467-4b24-a25f-d3b9db4b8f74', 1, 'When copper(II) sulfate solution is electrolysed, copper forms at the negative electrode. A student uses this apparatus to investigate the electrolysis of copper(II) sulfate solution.', 10, 3, 900, NULL, 'SUGGESTED', 'd9f7c281-91c5-5cba-b2e3-49460138d3a7', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:03:38.505188+00');
INSERT INTO public.question_versions VALUES ('649f2fcb-9cc1-47dd-aa8f-b5e327a6d532', 'd08e7d9f-0cf9-4233-9b02-a48a3d83b372', 1, 'Ethanoic acid reacts with methanol to form an ester. The equation shows the displayed formulae for the reactants and products. $\begin{array}{l} \mathrm {H} \mathrm {C} \mathrm {C} \mathrm {O} \mathrm {H} + \mathrm {H} \mathrm {C} \mathrm {O} \mathrm {H} \rightarrow \mathrm {H} \mathrm {C} \mathrm {C} \mathrm {O} \mathrm {C} \mathrm {H} + \mathrm {H} \mathrm {O} \mathrm {H} \\ \mathrm {H} \\ \end{array}$', 6, 3, 540, NULL, 'SUGGESTED', 'd9f7c281-91c5-5cba-b2e3-49460138d3a7', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:03:38.505433+00');
INSERT INTO public.question_versions VALUES ('60a73a20-28d7-42b7-a044-2b7be8f23efc', '171b0598-057d-494f-9679-989f3ad13ff1', 1, 'Methane reacts with steam to form carbon monoxide and hydrogen. This is the equation for the reaction. $\mathrm {C H} _ {4} (\mathrm {g}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {g}) \rightleftharpoons \mathrm {C O} (\mathrm {g}) + 3 \mathrm {H} _ {2} (\mathrm {g}) \quad \Delta H = + 2 0 6 \mathrm {k J / m o l}$', 11, 3, 990, NULL, 'SUGGESTED', 'd9f7c281-91c5-5cba-b2e3-49460138d3a7', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:03:38.505749+00');
INSERT INTO public.question_versions VALUES ('ff0d2a42-a18b-4a98-9532-fb7e6f26a2aa', 'b92f7d5e-f27e-4b41-baa2-87d10cc39eea', 1, '(a) The table lists three subatomic particles. Complete the table by giving the missing information.', 6, 3, 540, NULL, 'SUGGESTED', '8569da15-3df7-50f0-bc3d-cde09e9a533c', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:03:38.671982+00');
INSERT INTO public.question_versions VALUES ('ec808bcc-1ded-4438-8481-a146be64d137', '4c7b1b0d-4abc-464f-b144-63f2c22d9db0', 1, 'The table gives some information about the halogens, fluorine, chlorine, bromine and iodine.', 7, 3, 630, NULL, 'SUGGESTED', '8569da15-3df7-50f0-bc3d-cde09e9a533c', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:03:38.672381+00');
INSERT INTO public.question_versions VALUES ('fdf6b595-f4c4-4b8a-96fe-285f920ead60', 'eb13f83c-68d5-488f-a395-e000849fd4e2', 1, '(a) The box gives the names of some metals. Use words from the box to answer these questions. (i) Identify the metal that burns with a bright white flame. (ii) Explain which metal is most likely to be found in the Earth as an uncombined element.', 6, 3, 540, NULL, 'SUGGESTED', '8569da15-3df7-50f0-bc3d-cde09e9a533c', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:03:38.6727+00');
INSERT INTO public.question_versions VALUES ('a2c53143-5ff5-4d63-8c2e-7d6b5c9f120d', 'cdded9be-1442-447e-ac2a-6707130703e2', 1, '(a) The diagram shows a fractionating column used to separate crude oil into fractions. (i) Give one use for refinery gases and one use for bitumen. refinery gases bitumen (ii) Give a reason why refinery gases rise to the top of the column. (iii) State what must happen to the crude oil before it is pumped into the column.', 9, 3, 810, NULL, 'SUGGESTED', '8569da15-3df7-50f0-bc3d-cde09e9a533c', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:03:38.672943+00');
INSERT INTO public.question_versions VALUES ('3044c1d7-ba2d-4c47-859f-a63f57ea8afb', 'e24f49c9-20cd-4044-91fd-cec45af85f0b', 1, 'This question is about the insoluble salt, lead(II) bromide. Lead(II) bromide can be made by a precipitation reaction. This is the equation for the reaction. $\mathrm {P b} \left(\mathrm {N O} _ {3}\right) _ {2} (\mathrm {a q}) + 2 \mathrm {K B r} (\mathrm {a q}) \rightarrow \mathrm {P b B r} _ {2} (\mathrm {s}) + 2 \mathrm {K N O} _ {3} (\mathrm {a q})$', 1, 3, 90, NULL, 'SUGGESTED', '8569da15-3df7-50f0-bc3d-cde09e9a533c', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:03:38.673183+00');
INSERT INTO public.question_versions VALUES ('88ee9ecc-47d2-4bfb-b053-ae505640d992', '608ac57a-abd0-40d4-bac0-1f5749dd5099', 1, '(a) Describe the forces of attraction in metallic bonding.', 15, 3, 1350, NULL, 'SUGGESTED', '8569da15-3df7-50f0-bc3d-cde09e9a533c', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:03:38.673399+00');
INSERT INTO public.question_versions VALUES ('b63b0db3-dc15-4cb2-8d39-6b72501aa8cc', '3291f8d4-6afa-4272-a303-746a5729215a', 1, 'Methanol is made by the reaction between hydrogen and carbon monoxide. This is the equation for the reaction. $2 \mathrm {H} _ {2} (\mathrm {g}) + \mathrm {C O} (\mathrm {g}) \rightleftharpoons \mathrm {C H} _ {3} \mathrm {O H} (\mathrm {g}) \quad \Delta H = - 1 1 9 \mathrm {k J / m o l}$ A mixture of hydrogen and carbon monoxide is left until dynamic equilibrium is reached.', 14, 3, 1260, NULL, 'SUGGESTED', '8569da15-3df7-50f0-bc3d-cde09e9a533c', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:03:38.673639+00');
INSERT INTO public.question_versions VALUES ('5c97f340-b560-4193-b580-ddf0391ea7ca', 'a39ed85e-9e14-4868-bb56-a51a6797a73f', 1, 'Use the Periodic Table to answer these questions.', 7, 3, 630, NULL, 'SUGGESTED', 'b5287cd4-7ba1-56e4-bddc-fca4d84dea13', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:04:21.017438+00');
INSERT INTO public.question_versions VALUES ('ba556206-92b3-4aad-a079-07a6034bc44a', 'aab2a4ef-255e-4d24-ae78-b1c1f3efa7a7', 1, 'Structures made of iron can rust.', 5, 3, 450, NULL, 'SUGGESTED', 'b5287cd4-7ba1-56e4-bddc-fca4d84dea13', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:04:21.019223+00');
INSERT INTO public.question_versions VALUES ('6b7f5825-3e02-4f55-9b49-1004460eef09', '1896b4c8-62ac-4675-ac29-4be595b061e3', 1, 'The diagram shows the separation of crude oil into fractions.', 11, 3, 990, NULL, 'SUGGESTED', 'b5287cd4-7ba1-56e4-bddc-fca4d84dea13', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:04:21.019618+00');
INSERT INTO public.question_versions VALUES ('466c456f-b695-42dd-9464-ed24970ec799', 'e6c5724e-f2d8-459f-a226-ffd2408354c3', 1, 'The table shows the maximum mass of potassium nitrate $ \mathrm{(K N O_{3})} $ and the maximum mass of sodium nitrate $ \mathrm{(N a N O_{3})} $ that dissolves in $ 2 5 \mathrm{c m}^{3} $ of water at different temperatures.', 10, 3, 900, NULL, 'SUGGESTED', 'b5287cd4-7ba1-56e4-bddc-fca4d84dea13', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:04:21.020006+00');
INSERT INTO public.question_versions VALUES ('3d02bdae-b97b-4dfe-bf90-1025e6e05d1a', 'd879bc58-2bc7-4323-9ea3-6d6d88543961', 1, 'Methanol, $ \mathrm{C H_{3} O H} $ is the first member of the homologous series of alcohols.', 10, 3, 900, NULL, 'SUGGESTED', 'b5287cd4-7ba1-56e4-bddc-fca4d84dea13', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:04:21.020372+00');
INSERT INTO public.question_versions VALUES ('f082fc27-ad49-4dfa-b24f-01647140cce8', '37f82535-3dc2-4fa0-b4f4-be894ae22c35', 1, 'A scientist reacts lead(II) nitrate solution with sodium bromide solution. This is the equation for the reaction. $\mathrm {P b} \left(\mathrm {N O} _ {3}\right) _ {2} (\mathrm {a q}) + 2 \mathrm {N a B r} (\mathrm {a q}) \rightarrow \mathrm {P b B r} _ {2} (\mathrm {s}) + 2 \mathrm {N a N O} _ {3} (\mathrm {a q})$', 14, 3, 1260, NULL, 'SUGGESTED', 'b5287cd4-7ba1-56e4-bddc-fca4d84dea13', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:04:21.020757+00');
INSERT INTO public.question_versions VALUES ('5168da5e-5099-4acb-a67f-84afc4946f1a', 'cdcc92fe-1785-4fe5-8a5e-a08c2a9aeacf', 1, 'This question is about hydrogen chloride (HCI). Hydrogen chloride is a covalent compound.', 13, 3, 1170, NULL, 'SUGGESTED', 'b5287cd4-7ba1-56e4-bddc-fca4d84dea13', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:04:21.021128+00');
INSERT INTO public.question_versions VALUES ('25044101-b232-42ed-9374-dd19c850c5f1', '51ce3c63-01a6-4362-9bc6-90c0ccd8ebe6', 1, 'This question is about sulfur.', 4, 3, 360, NULL, 'SUGGESTED', '3745aeee-bf69-597d-8e80-5683f6dea0b1', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:04:21.290646+00');
INSERT INTO public.question_versions VALUES ('4a69e1f1-cf3e-43a6-8b84-b47860743b88', '36a2dc3a-71b2-45c2-a9de-4382582e1283', 1, '(a) The diagram represents an atom of an element. (i) What is the name of the particle labelled W? (ii) What is the mass number of this atom? A 4 B 5 C 9 D 13', 6, 3, 540, NULL, 'SUGGESTED', '3745aeee-bf69-597d-8e80-5683f6dea0b1', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:04:21.291095+00');
INSERT INTO public.question_versions VALUES ('46469437-7436-4383-881a-987349075103', 'f7d2fc73-cfbb-4317-83e9-38c6909fb8d9', 1, 'This question is about magnesium metal and its compounds.', 1, 3, 90, NULL, 'SUGGESTED', '3745aeee-bf69-597d-8e80-5683f6dea0b1', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:04:21.291417+00');
INSERT INTO public.question_versions VALUES ('8fb91871-4a74-4823-a87a-079d760030ed', 'b9a167eb-64d7-4eae-8c2b-6da3e989075b', 1, 'Sodium sulfate can be prepared by the reaction between sodium hydroxide solution and sodium hydrogensulfate $ \mathrm{(N a H S O_{4})} $ solution. This is the equation for the reaction. $\mathrm {N a O H} (\mathrm {a q}) + \mathrm {N a H S O} _ {4} (\mathrm {a q}) \rightarrow \mathrm {N a} _ {2} \mathrm {S O} _ {4} (\mathrm {a q}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {I})$ Sodium hydrogensulfate solution is acidic. The student does a titration. A student adds $ 2 5. 0 \mathrm{c m}^{3} $ of sodium hydroxide solution to a conical flask and adds two drops of indicator.', 14, 3, 1260, NULL, 'SUGGESTED', '3745aeee-bf69-597d-8e80-5683f6dea0b1', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:04:21.298393+00');
INSERT INTO public.question_versions VALUES ('cb8590e5-d0af-429a-8d30-6fb5590c8acb', 'b1be0beb-9eca-4048-97fc-615009d982a0', 1, 'This question is about electrolysis.', 11, 3, 990, NULL, 'SUGGESTED', '3745aeee-bf69-597d-8e80-5683f6dea0b1', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:04:21.299178+00');
INSERT INTO public.question_versions VALUES ('bfa243fc-e1fb-4265-8f04-c256766cc5f4', 'affe86c5-6438-47ed-8eff-f342f4697229', 1, 'Gaseous ethanol is manufactured by reacting ethene gas with steam. This is the equation for the reaction. $\mathrm {C} _ {2} \mathrm {H} _ {4} (\mathrm {g}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {g}) \rightleftharpoons \mathrm {C} _ {2} \mathrm {H} _ {5} \mathrm {O H} (\mathrm {g})$', 15, 3, 1350, NULL, 'SUGGESTED', '3745aeee-bf69-597d-8e80-5683f6dea0b1', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:04:21.299524+00');
INSERT INTO public.question_versions VALUES ('c11ea30c-7444-4e98-8a8b-7f8a8673cc49', 'd2206395-1841-434a-8fba-6cb5ebb8fe2f', 1, 'The table shows some properties of four substances, P, Q, R and S. Use the information in the table to answer the following questions. You may use each letter once, more than once or not at all. Choose a substance that:', 4, 3, 360, NULL, 'SUGGESTED', '3c53d76f-fd56-5fb4-b3ec-5d9f61260668', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:04:21.508109+00');
INSERT INTO public.question_versions VALUES ('10d11e31-1d37-41a7-b687-c750854ea1fb', '6bf422d6-6030-473a-a44a-543b10cefade', 1, 'This is a method used to measure the solubility of a solid in water: add an excess of solid to some water in a boiling tube and stir measure the temperature of the saturated solution formed weigh an empty evaporating basin pour some of the saturated solution into the evaporating basin weigh the basin and contents heat the evaporating basin to remove all of the water weigh the evaporating basin and remaining solid.', 7, 3, 630, NULL, 'SUGGESTED', '3c53d76f-fd56-5fb4-b3ec-5d9f61260668', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:04:21.510625+00');
INSERT INTO public.question_versions VALUES ('9cbda3ee-c245-47aa-9c6a-10f9b0347e0b', '109efaa8-8c71-4b25-9cb0-41698f4cdf50', 1, 'Astatine, bromine, chlorine, fluorine and iodine are all halogens. They are found in Group 7 of the Periodic Table.', 7, 3, 630, NULL, 'SUGGESTED', '3c53d76f-fd56-5fb4-b3ec-5d9f61260668', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:04:21.512601+00');
INSERT INTO public.question_versions VALUES ('678ec303-5bae-454c-897c-74d146b71313', '88a62dee-24ac-41c3-886b-abc47a8a44a1', 1, 'A technician finds a white solid in an unlabelled beaker. She knows that the solid is one of the following substances: potassium chloride potassium sulfate sodium chloride sodium sulfate. Describe how the technician can use chemical tests to identify the solid in the beaker.', 6, 3, 540, NULL, 'SUGGESTED', '3c53d76f-fd56-5fb4-b3ec-5d9f61260668', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:04:21.514363+00');
INSERT INTO public.question_versions VALUES ('c5791acb-6b1f-43c5-be73-293e943af468', '720a9209-1034-42a4-97ab-08dc7a3fccff', 1, 'Zinc metal is obtained from sulfide ores. The most common ore of zinc is sphalerite, which contains zinc sulfide (ZnS) and a small amount of cadmium sulfide (CdS). The stages involved in the extraction of zinc from sphalerite are: Stage1 Sphalerite is strongly heated in air. $2 \mathrm {Z n S} (\mathrm {s}) + 3 \mathrm {O} _ {2} (\mathrm {g}) \rightarrow 2 \mathrm {Z n O} (\mathrm {s}) + 2 \mathrm {S O} _ {2} (\mathrm {g})$ $2 \mathrm {C d S} (\mathrm {s}) + 3 \mathrm {O} _ {2} (\mathrm {g}) \rightarrow 2 \mathrm {C d O} (\mathrm {s}) + 2 \mathrm {S O} _ {2} (\mathrm {g})$ Stage 2 The mixture of oxides is reacted with sulfuric acid. $\mathrm {Z n O (s)} + \mathrm {H} _ {2} \mathrm {S O} _ {4} (\mathrm {a q}) \rightarrow \mathrm {Z n S O} _ {4} (\mathrm {a q}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {I})$ $\mathrm {C d O (s)} + \mathrm {H} _ {2} \mathrm {S O} _ {4} (\mathrm {a q}) \rightarrow \mathrm {C d S O} _ {4} (\mathrm {a q}) + \mathrm {H} _ {2} \mathrm {O (l)}$ Stage 3 Zinc dust is added to the solution containing zinc sulfate and cadmium sulfate to remove the cadmium ions. $\mathrm {C d} ^ {2 +} (\mathrm {a q}) + \mathrm {Z n} (\mathrm {s}) \rightarrow \mathrm {C d} (\mathrm {s}) + \mathrm {Z n} ^ {2 +} (\mathrm {a q})$ Stage 4 The solid cadmium is filtered off and the pure zinc sulfate solution is electrolysed.', 8, 3, 720, NULL, 'SUGGESTED', '3c53d76f-fd56-5fb4-b3ec-5d9f61260668', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:04:21.51507+00');
INSERT INTO public.question_versions VALUES ('f71dc47e-b1b6-4956-868b-5c109c7ac520', 'bcc5c8f8-8ce2-488d-8097-7afef31cff08', 1, 'The mineral nesquehonite is a form of hydrated magnesium carbonate. The formula, $ \mathrm{M g C O_{3}. x H_{2} O} $ , shows that nesquehonite contains water of crystallisation. When a sample of nesquohonite is heated gently, the water of crystallisation is given off and anhydrous magnesium carbonate is left. Six students are each given a sample of nesquehonite of mass 6.1 g. The students heat their samples for different times. The samples are then allowed to cool before being reweighed. The table shows their results.', 11, 3, 990, NULL, 'SUGGESTED', '3c53d76f-fd56-5fb4-b3ec-5d9f61260668', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:04:21.515472+00');
INSERT INTO public.question_versions VALUES ('2d726862-a4df-4a15-856b-21a906fed8c9', '88044413-80bb-4ae7-8fc8-f5ec3224181f', 1, 'Ammonia is manufactured on a large scale and is used to make fertilisers such as ammonium nitrate $ \mathrm{(N H_{4} N O_{3})}. $', 1, 3, 90, NULL, 'SUGGESTED', '3c53d76f-fd56-5fb4-b3ec-5d9f61260668', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:04:21.515885+00');
INSERT INTO public.question_versions VALUES ('35707b71-d4ea-4116-94bb-74a2d61ab72a', '00a6cc4c-ed10-4298-844f-6aaf910837a7', 1, 'Polymers can be classified as addition polymers or condensation polymers.', 1, 3, 90, NULL, 'SUGGESTED', '3c53d76f-fd56-5fb4-b3ec-5d9f61260668', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:04:21.516798+00');
INSERT INTO public.question_versions VALUES ('4b73f97d-24e7-4d6d-876a-125b889926d3', '68976259-5da6-40e0-a1e5-ab0c1bea7a3b', 1, 'Grapes contain glucose that can be fermented to make ethanol.', 12, 3, 1080, NULL, 'SUGGESTED', '3c53d76f-fd56-5fb4-b3ec-5d9f61260668', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:04:21.517211+00');
