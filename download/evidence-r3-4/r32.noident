INSERT INTO public.questions VALUES ('34d523ea-685f-4488-b720-00b668d52ba9', 'q03-f37697b2', 'STRUCTURED', 'The diagram shows the industrial equipment used to separate crude oil into fractions.', 10, 3, 900, NULL, '1d8c6b3c-b693-4155-8fd3-a287cdc29a1b', 'PAST_PAPER', true, 1, '2026-09-13 13:02:53.42254+00', '065f2ced-0e47-4744-92d5-a46ed2cdd962');
INSERT INTO public.questions VALUES ('b371d02d-4ed6-43bf-8dae-b6fd1d469451', 'q04-f37697b2', 'STRUCTURED', 'A student investigates the solubility of potassium nitrate in water. She measures the masses of potassium nitrate that dissolve in $ 2 5 \mathrm{c m}^{3} $ of water at different temperatures. The table shows the student''s results. One of the results is anomalous.', 1, 3, 90, NULL, '1d8c6b3c-b693-4155-8fd3-a287cdc29a1b', 'PAST_PAPER', true, 1, '2026-09-13 13:02:53.422943+00', '065f2ced-0e47-4744-92d5-a46ed2cdd962');
INSERT INTO public.questions VALUES ('5b7298af-1bb4-4018-a381-593d5f83f299', 'q05-f37697b2', 'STRUCTURED', 'Ethanol, $ \mathrm{C_{2} H_{5} O H} $ is a member of the homologous series of alcohols.', 14, 3, 1260, NULL, '1d8c6b3c-b693-4155-8fd3-a287cdc29a1b', 'PAST_PAPER', true, 1, '2026-09-13 13:02:53.423333+00', '065f2ced-0e47-4744-92d5-a46ed2cdd962');
