INSERT INTO public.question_parts VALUES ('934788bb-ca66-47e9-bada-3f028d660158', '53954a3b-c4e8-4485-908d-ba17dbae58bc', 'c-iii', 'Draw a line of best fit.', NULL, 0, 4, '2026-09-13 13:01:26.45868+00');
INSERT INTO public.question_parts VALUES ('6a8e5105-78d7-4565-8c44-cf4d40fc7374', '53954a3b-c4e8-4485-908d-ba17dbae58bc', 'c-iv', 'Explain a possible cause of the anomalous result, other than misreading the apparatus.', NULL, 0, 5, '2026-09-13 13:01:26.458717+00');
