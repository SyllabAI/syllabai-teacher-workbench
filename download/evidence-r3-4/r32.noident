INSERT INTO public.glm_ocr_bridge_records VALUES ('d08dbdf1-8d10-4220-a7c2-bf12a9e09cb5', 'bc4d84a5-da0e-4532-b04b-b2c79be235ae', 'glm-ocr-v1', '53711967-dc78-5d9b-b1db-f655fd599e2b', 'ed36b1ae-5eef-5a3f-8063-a643f291d15b', '934f93f8-a393-4858-85c2-2c424ad9f6fa', 'f19c5c79-47a0-45d4-a5ff-af07c5029f5a', '39ea89014200c2913012d27a5248aa59e617447dab39a4e2f1af0f0c756e6979', 'c4e2178d9321e32899731a034c90ae089d8c8a7e7b4d3b09a63fc8e9a81f04ce', 'glm-ocr-qp-v1+glm-ocr-ms-v1', 'OK', '[{"detail": "Q1: QP total 3 vs MS total unknown (qp-only)", "source": "RECONCILIATION", "msMarks": null, "qpMarks": 3, "severity": "qp-only", "questionNumber": "1"}, {"detail": "Q2: QP total 4 vs MS total unknown (qp-only)", "source": "RECONCILIATION", "msMarks": null, "qpMarks": 4, "severity": "qp-only", "questionNumber": "2"}, {"detail": "Q3: QP total 10 vs MS total unknown (qp-only)", "source": "RECONCILIATION", "msMarks": null, "qpMarks": 10, "severity": "qp-only", "questionNumber": "3"}, {"detail": "Q5: QP total 5 vs MS total unknown (qp-only)", "source": "RECONCILIATION", "msMarks": null, "qpMarks": 5, "severity": "qp-only", "questionNumber": "5"}, {"detail": "Q6: QP total 7 vs MS total unknown (qp-only)", "source": "RECONCILIATION", "msMarks": null, "qpMarks": 7, "severity": "qp-only", "questionNumber": "6"}, {"detail": "Q8: QP total 5 vs MS total unknown (qp-only)", "source": "RECONCILIATION", "msMarks": null, "qpMarks": 5, "severity": "qp-only", "questionNumber": "8"}, {"detail": "Q9: QP total 5 vs MS total unknown (qp-only)", "source": "RECONCILIATION", "msMarks": null, "qpMarks": 5, "severity": "qp-only", "questionNumber": "9"}, {"detail": "unclassified heading: most reactive", "source": "QP_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "Q9: incomplete MCQ option set folded into stem", "source": "QP_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "1(a): bare integer cell \"1\"