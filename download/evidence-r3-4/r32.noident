INSERT INTO public.question_versions VALUES ('02d97f66-f454-4431-bac2-03b6148a7ab8', 'ee171073-84ba-47d4-8c33-3de294b1e351', 1, 'Chromatography is used to analyse mixtures. She places four known dyes, A, B, C and D, and the green food colouring on chromatography paper. The diagram shows the student''s apparatus at the start of her experiment. A student does a chromatography experiment to analyse the composition of green food colouring in sweets.', 9, 3, 810, NULL, 'SUGGESTED', '517cf287-98ae-553f-9c06-a0b2adeb4644', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:01:25.618246+00');
