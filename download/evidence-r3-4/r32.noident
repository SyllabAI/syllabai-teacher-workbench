INSERT INTO public.question_parts VALUES ('b0bdc4d4-e589-4a5c-a798-e184eaf1c3fd', '3153cfb5-0a73-48ee-b50e-131d1df32390', 'd-iv', 'Dyes have an $ R_{\mathrm{f}} $ value that can be calculated using this expression. $R _ {\mathrm {f}} = \frac {\mathrm {d i s t a n c e m o v e d b y d y e}}{\mathrm {d i s t a n c e m o v e d b y s o l v e n t}}$ Complete the table for the dye in ink A.', NULL, 0, 7, '2026-09-13 12:53:55.674517+00');
INSERT INTO public.question_parts VALUES ('d8e4b9ae-6c26-40fc-965e-0e0d010f1669', '3153cfb5-0a73-48ee-b50e-131d1df32390', 'e', 'The diagram shows an experiment to demonstrate diffusion.', NULL, 0, 8, '2026-09-13 12:53:55.674587+00');
INSERT INTO public.question_parts VALUES ('6e6b081c-bfd9-40fc-85ca-a5509c7166f5', '3153cfb5-0a73-48ee-b50e-131d1df32390', 'e-i', 'The word equation for the reaction that occurs in this experiment is $\mathrm {a m m o n i a} + \mathrm {h y d r o g e n c h l o r i d e} \rightarrow \mathrm {a m m o n i u m c h l o r i d e}$ Complete the chemical equation for this reaction. $\mathrm {N H} _ {3} + \mathrm {H C l} \rightarrow \dots \dots$', NULL, 0, 9, '2026-09-13 12:53:55.67465+00');
