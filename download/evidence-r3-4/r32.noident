INSERT INTO public.question_parts VALUES ('45994cb8-363b-44d3-99cf-c1aa5cff69e9', '2de2f8ed-367a-490b-aaa6-bdc28a53736a', 'c', 'The equation for the reaction between lithium and water is $2 \mathrm {L i} (\mathrm {s}) + 2 \mathrm {H} _ {2} \mathrm {O} (\mathrm {I}) \rightarrow 2 \mathrm {L i O H} (\mathrm {a q}) + \mathrm {H} _ {2} (\mathrm {g})$', NULL, 0, 5, '2026-09-13 13:01:25.704704+00');
INSERT INTO public.question_parts VALUES ('d2c323bf-6135-481e-b225-3c2a4ae01eb0', '2de2f8ed-367a-490b-aaa6-bdc28a53736a', 'c-i', 'A mass of 0.500g of lithium reacts with an excess of water. Calculate the volume, in $ cm^{3} $ , of hydrogen gas produced at rtp. [molar volume of a gas at rtp=24000 $ cm^{3} $] Give your answer to three significant figures.', NULL, 0, 6, '2026-09-13 13:01:25.704752+00');
INSERT INTO public.question_parts VALUES ('33394836-5f8d-4a81-8177-dcc4a256fd55', '2de2f8ed-367a-490b-aaa6-bdc28a53736a', 'c-ii', 'In a reaction between lithium and water, $ 1 5 0 \mathrm{c m}^{3} $ of lithium hydroxide solution is formed. The lithium hydroxide solution is then completely neutralised by $ 2 4. 8 5 \mathrm{c m}^{3} $ of $ 0. 1 0 0 \mathrm{m o l / d m}^{3} $ sulfuric acid. The equation for the neutralisation is $2 \mathrm {L i O H} (\mathrm {a q}) + \mathrm {H} _ {2} \mathrm {S O} _ {4} (\mathrm {a q}) \rightarrow \mathrm {L i} _ {2} \mathrm {S O} _ {4} (\mathrm {a q}) + 2 \mathrm {H} _ {2} \mathrm {O} (\mathrm {I})$ Calculate the concentration, in mol/dm $ ^{3} $ , of the lithium hydroxide solution.', NULL, 0, 7, '2026-09-13 13:01:25.704812+00');
INSERT INTO public.question_parts VALUES ('80d90b0d-fe8b-458b-a34e-8a2517a8e0ab', 'f989b81d-d25f-493c-8714-550555526358', 'a', 'Ethane can be obtained from crude oil. Describe the industrial process used to separate crude oil into fractions.', NULL, 0, 0, '2026-09-13 13:01:25.704889+00');
INSERT INTO public.question_parts VALUES ('ad1b82fc-d632-48c0-a993-5fe5b236d6d9', 'f989b81d-d25f-493c-8714-550555526358', 'b', 'The equation for the reaction between ethene gas and hydrogen gas is $\mathrm {C} _ {2} \mathrm {H} _ {4} + \mathrm {H} _ {2} \rightarrow \mathrm {C} _ {2} \mathrm {H} _ {6}$ The rate of this reaction can be increased by increasing the pressure.', NULL, 0, 1, '2026-09-13 13:01:25.704949+00');
INSERT INTO public.question_parts VALUES ('ae2bb797-3b7a-4576-ab4d-b8eb8bf60b27', 'f989b81d-d25f-493c-8714-550555526358', 'b-i', 'Explain why increasing the pressure increases the rate of this reaction.', NULL, 0, 2, '2026-09-13 13:01:25.705011+00');
INSERT INTO public.question_parts VALUES ('a614e868-710a-4a4a-a81a-028d20aad500', 'f989b81d-d25f-493c-8714-550555526358', 'b-ii', 'The rate of this reaction can also be increased by using a catalyst. Explain how using a catalyst increases the rate of a reaction.', NULL, 0, 3, '2026-09-13 13:01:25.705054+00');
INSERT INTO public.question_parts VALUES ('68ece29d-9f26-4c91-8008-6c2e53506b74', 'f989b81d-d25f-493c-8714-550555526358', 'b-iii', 'Give one other way that the rate of reaction between ethene gas and hydrogen gas can be increased.', NULL, 0, 4, '2026-09-13 13:01:25.705139+00');
