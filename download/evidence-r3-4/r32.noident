INSERT INTO public.question_parts VALUES ('ce1ea5dd-13e0-4338-bff8-79a3f3c937e6', '01d247ed-ae86-40df-be31-3de4cab7f56c', 'd', 'The student repeats the experiment using the same apparatus, but this time he records the volume of oxygen collected at intervals of 20 seconds. The table shows his results for two new solids F and G.', NULL, 0, 5, '2026-09-13 12:53:11.616083+00');
INSERT INTO public.question_parts VALUES ('60e28128-2e9f-4e8e-95a4-6b96d09119d9', '01d247ed-ae86-40df-be31-3de4cab7f56c', 'd-i', 'The grid shows the results plotted for solid F. On the grid, plot the results for solid G. Draw a curve of best fit. Volume of oxygen in $ \mathrm{c m}^{3} $', NULL, 0, 6, '2026-09-13 12:53:11.616092+00');
