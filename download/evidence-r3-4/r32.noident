INSERT INTO public.questions VALUES ('53152472-1d5e-4c4e-b0e9-fd485a091df6', 'q09-9bf32939', 'STRUCTURED', 'A student uses this apparatus to investigate the rate of reaction between marble chips and dilute hydrochloric acid. This is the equation for the reaction.', 11, 3, 990, NULL, '93bd6fb6-102b-432a-9e64-29400ba04b8d', 'PAST_PAPER', true, 1, '2026-09-13 12:56:56.592993+00', '6c02452e-7a29-4403-a392-ff6ebad79e07');
INSERT INTO public.questions VALUES ('5fdb828a-4b58-4cd5-a776-2afa72d32bbe', 'q10-9bf32939', 'STRUCTURED', 'A student investigates the reaction between magnesium and nitric acid. The student uses this method. add $ 4 0 \mathrm{c m}^{3} $ of dilute nitric acid to a glass beaker record the temperature of the acid find the mass of a strip of magnesium ribbon add the magnesium ribbon to the nitric acid when all the magnesium has reacted, record the highest temperature reached', 11, 3, 990, NULL, '93bd6fb6-102b-432a-9e64-29400ba04b8d', 'PAST_PAPER', true, 1, '2026-09-13 12:56:56.593234+00', '6c02452e-7a29-4403-a392-ff6ebad79e07');
INSERT INTO public.questions VALUES ('cb2d74fa-172a-4f3b-ab1d-57ddb985d2c7', 'q06-cb9f6de1', 'STRUCTURED', 'A student wants to prepare sodium chloride crystals from sodium hydroxide solution and dilute hydrochloric acid. He does a titration to find the volume of dilute hydrochloric acid needed to neutralise the sodium hydroxide solution. This is his method. add $ 2 5. 0 \mathrm{c m}^{3} $ of sodium hydroxide solution to a conical flask add a few drops of phenolphthalein indicator to the conical flask titrate the solution with the hydrochloric acid', 13, 3, 1170, NULL, '14bcfc74-9e8e-479d-b84a-cc96313f4bc1', 'PAST_PAPER', true, 1, '2026-09-13 13:01:26.098507+00', '3f5b3d5b-a886-4239-9a40-67027502e6d3');
INSERT INTO public.questions VALUES ('0eddf420-a1b9-4511-a779-9b1e2e5dc066', 'q07-cb9f6de1', 'STRUCTURED', '(a) Ethanol, $ \mathrm{C_{2} H_{5} O H} $ , can be oxidised to produce ethanoic acid, $ \mathrm{C H_{3} C O O H} $ , by heating it with potassium dichromate(VI). (i) Name one other reactant needed for this reaction to occur. (ii) Which colour change occurs during this reaction? orange to colourless A colourless to green B green to orange D orange to green', 16, 3, 1440, NULL, '14bcfc74-9e8e-479d-b84a-cc96313f4bc1', 'PAST_PAPER', true, 1, '2026-09-13 13:01:26.09885+00', '3f5b3d5b-a886-4239-9a40-67027502e6d3');
INSERT INTO public.questions VALUES ('cfa199db-8f1d-4dc1-b5d1-51b72355791a', 'q01-7e261528', 'STRUCTURED', 'The diagram shows an atom of an element.', 5, 3, 450, NULL, 'a655ea63-a7cb-4fca-a68b-bac4ebf8106a', 'PAST_PAPER', true, 1, '2026-09-13 13:01:26.259473+00', 'c7cb58db-7f0b-4f65-84b3-a45244d6e886');
