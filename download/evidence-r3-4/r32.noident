INSERT INTO public.question_parts VALUES ('fcb5ac12-f930-4746-a2f6-9e6dff2cc845', 'ce86bf77-ed13-490a-9d69-e53b058f6bfd', 'a-ii', 'Using only information from the table, state two ways in which the oxides of the non-metals are similar to each other.', NULL, 0, 2, '2026-09-13 12:59:56.215517+00');
INSERT INTO public.question_parts VALUES ('b3ffb3a0-4a42-44f2-b555-54c56953963b', 'ce86bf77-ed13-490a-9d69-e53b058f6bfd', 'b', 'A teacher tells his students that when phosphorus burns in air a white solid oxide forms. This oxide is very soluble in water and forms an acidic solution.', NULL, 0, 3, '2026-09-13 12:59:56.215569+00');
