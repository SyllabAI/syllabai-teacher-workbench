rkdown", "source_engine_version": "1.1.0"}, {"text": "\\text{Total for Question 11 = 12 marks)}", "latex": "\\text{Total for Question 11 = 12 marks)}", "confidence": 1.0, "element_id": "e000241", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 241, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "pageCount": 1, "documentId": "c4484f7b-36c4-5e17-bde2-8286e27a84ab", "provenance": {"engine": "glm-ocr-markdown", "application": "syllabai-parser", "extractedAt": "2026-09-13T12:55:47.104981552Z", "engineVersion": "1.1.0", "schemaVersion": "1.0", "extractionParams": {"pageBoundaries": "none-in-source", "sourceLineCount": 303, "upstreamConverter": "zai-glm-ocr", "entityDecodedLines": 0, "signedUrlFigureRefs": 0, "normalizedHtmlEntities": true}}, "textBlocks": [{"role": "heading", "text": "Instructions", "confidence": 1.0, "element_id": "e000000", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 0, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Use black ink or ball-point pen.", "confidence": 1.0, "element_id": "e000001", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 1, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Fill in the boxes at the top of this page with your name, centre number and candidate number.", "confidence": 1.0, "element_id": "e000002", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 2, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer all questions.", "confidence": 1.0, "element_id": "e000003", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 3, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer the questions in the spaces provided - there may be more space than you need.", "confidence": 1.0, "element_id": "e000004", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 4, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Show all the steps in any calculations and state the units.", "confidence": 1.0, "element_id": "e000005", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 5, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Some questions must be answered with a cross in a box . If you change your mind about an answer, put a line through the box and then mark your new answer with a cross.", "confidence": 1.0, "element_id": "e000006", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 6, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Information", "confidence": 1.0, "element_id": "e000007", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 7, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The total mark for this paper is 110.", "confidence": 1.0, "element_id": "e000008", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 8, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The marks for each question are shown in brackets", "confidence": 1.0, "element_id": "e000009", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 9, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "use this as a guide as to how much time to spend on each question.", "confidence": 1.0, "element_id": "e000010", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 10, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Advice", "confidence": 1.0, "element_id": "e000011", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 11, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Read each question carefully before you start to answer it.", "confidence": 1.0, "element_id": "e000012", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 12, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Write your answers neatly and in good English.", "confidence": 1.0, "element_id": "e000013", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 13, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Try to answer every question.", "confidence": 1.0, "element_id": "e000014", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 14, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Check your answers if you have time at the end.", "confidence": 1.0, "element_id": "e000015", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 15, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Good luck with your examination.", "confidence": 1.0, "element_id": "e000016", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 16, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Turn over", "confidence": 1.0, "element_id": "e000017", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 17, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The lanthanoids (atomic numbers 58-71) and the actinoids (atomic numbers 90-103) have been omitted. The relative atomic masses of copper and chlorine have not been rounded to the nearest whole number.", "confidence": 1.0, "element_id": "e000019", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 19, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Answer ALL questions.", "confidence": 1.0, "element_id": "e000020", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 20, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "1 (a) The diagram shows the particles in four substances, A, B, C and D.", "confidence": 1.0, "element_id": "e000021", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 21, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A", "confidence": 1.0, "element_id": "e000023", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 23, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B", "confidence": 1.0, "element_id": "e000025", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 25, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C", "confidence": 1.0, "element_id": "e000027", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 27, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D", "confidence": 1.0, "element_id": "e000029", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 29, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Which substance contains single atoms of one element?", "confidence": 1.0, "element_id": "e000030", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 30, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A", "confidence": 1.0, "element_id": "e000031", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 31, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B", "confidence": 1.0, "element_id": "e000032", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 32, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C", "confidence": 1.0, "element_id": "e000033", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 33, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D", "confidence": 1.0, "element_id": "e000034", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 34, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(1)", "confidence": 1.0, "element_id": "e000035", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 35, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Which substance is a compound?", "confidence": 1.0, "element_id": "e000036", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 36, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A", "confidence": 1.0, "element_id": "e000037", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 37, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B", "confidence": 1.0, "element_id": "e000038", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 38, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C", "confidence": 1.0, "element_id": "e000039", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 39, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D", "confidence": 1.0, "element_id": "e000040", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 40, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(1)", "confidence": 1.0, "element_id": "e000041", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 41, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Which substance could have the formula $ \\mathrm{H}_{2} $?", "confidence": 1.0, "element_id": "e000042", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 42, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A", "confidence": 1.0, "element_id": "e000043", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 43, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B", "confidence": 1.0, "element_id": "e000044", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 44, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C", "confidence": 1.0, "element_id": "e000045", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 45, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D", "confidence": 1.0, "element_id": "e000046", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 46, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(1)", "confidence": 1.0, "element_id": "e000047", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 47, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The diagram shows the particles in substance E.", "confidence": 1.0, "element_id": "e000048", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 48, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "E", "confidence": 1.0, "element_id": "e000050", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 50, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Give two reasons why substance E is a mixture.", "confidence": 1.0, "element_id": "e000051", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 51, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(2)", "confidence": 1.0, "element_id": "e000052", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 52, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 1 = 5 marks)", "confidence": 1.0, "element_id": "e000053", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 53, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "2 This question is about Group 7 elements and their reactions.", "confidence": 1.0, "element_id": "e000054", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 54, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Fluorine has the smallest atoms in Group 7.", "confidence": 1.0, "element_id": "e000055", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 55, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The diagram shows the electronic configuration of a fluorine atom.", "confidence": 1.0, "element_id": "e000056", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 56, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) State why fluorine has the smallest atoms in Group 7.", "confidence": 1.0, "element_id": "e000058", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 58, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(1)", "confidence": 1.0, "element_id": "e000059", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 59, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Which row gives the correct number of occupied electron shells and the correct number of outer shell electrons in an atom of iodine?", "confidence": 1.0, "element_id": "e000060", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 60, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Use the Periodic Table on page 2 to help you.", "confidence": 1.0, "element_id": "e000061", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 61, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(1)", "confidence": 1.0, "element_id": "e000062", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 62, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) (i) The table gives descriptions of the reactions of some Group 7 elements with iron wool. Complete the table by giving a description of the reaction of fluorine with iron wool.", "confidence": 1.0, "element_id": "e000064", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 64, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) State the relationship between the reactivity of the Group 7 elements and the size of their atoms.", "confidence": 1.0, "element_id": "e000066", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 66, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 2 = 6 marks)", "confidence": 1.0, "element_id": "e000067", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 67, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "3 This question is about the rusting of iron.", "confidence": 1.0, "element_id": "e000068", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 68, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Water is needed for iron to rust.", "confidence": 1.0, "element_id": "e000069", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 69, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Name one other substance needed for iron to rust.", "confidence": 1.0, "element_id": "e000070", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 70, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Give the chemical name for rust.", "confidence": 1.0, "element_id": "e000071", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 71, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The diagram shows two methods used to prevent iron from rusting.", "confidence": 1.0, "element_id": "e000072", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 72, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Method A", "confidence": 1.0, "element_id": "e000074", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 74, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Method B", "confidence": 1.0, "element_id": "e000076", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 76, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Method A will only work if the plastic coating is not damaged.", "confidence": 1.0, "element_id": "e000077", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 77, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Method B will work even when the zinc coating is damaged.", "confidence": 1.0, "element_id": "e000078", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 78, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Explain how method A prevents iron from rusting.", "confidence": 1.0, "element_id": "e000079", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 79, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Give the name of method B.", "confidence": 1.0, "element_id": "e000080", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 80, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Explain how method B prevents iron from rusting even when the zinc coating is damaged.", "confidence": 1.0, "element_id": "e000081", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 81, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 3 = 7 marks)", "confidence": 1.0, "element_id": "e000082", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 82, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "4 (a) The table shows the number of protons, neutrons and electrons in species F, G and H.", "confidence": 1.0, "element_id": "e000083", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 83, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Give the mass number of F.", "confidence": 1.0, "element_id": "e000085", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 85, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Give the electronic configuration of G.", "confidence": 1.0, "element_id": "e000086", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 86, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Explain why F and G are isotopes of the same element. Refer to subatomic particles in your answer.", "confidence": 1.0, "element_id": "e000087", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 87, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iv) Explain why H is a negative ion.", "confidence": 1.0, "element_id": "e000088", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 88, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Refer to subatomic particles and their charges in your answer.", "confidence": 1.0, "element_id": "e000089", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 89, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) A sample of carbon contains atoms of mass number 12 and 13 The table shows the percentages of these atoms in the sample.", "confidence": 1.0, "element_id": "e000090", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 90, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Calculate the relative atomic mass $ ( A_{r} ) $ of this sample of carbon.", "confidence": 1.0, "element_id": "e000092", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 92, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Give your answer to two decimal places.", "confidence": 1.0, "element_id": "e000093", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 93, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 4 = 8 marks)", "confidence": 1.0, "element_id": "e000094", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 94, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "5 Two experiments are done to determine the percentage composition by volume of a mixture of three gases, carbon dioxide, oxygen and argon.", "confidence": 1.0, "element_id": "e000095", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 95, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) In experiment 1, a student bubbles the mixture of gases through limewater. Carbon dioxide reacts with limewater.", "confidence": 1.0, "element_id": "e000096", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 96, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The diagram shows the apparatus the student uses.", "confidence": 1.0, "element_id": "e000097", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 97, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The student pushes the mixture of gases out of syringe A, but no gas bubbles appear in the limewater.", "confidence": 1.0, "element_id": "e000099", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 99, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Give one change the student needs to make to the apparatus for gas bubbles to appear in the limewater.", "confidence": 1.0, "element_id": "e000100", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 100, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) When the apparatus in experiment 1 is set up correctly, the mixture of gases is bubbled gently through the limewater so that all the carbon dioxide is removed.", "confidence": 1.0, "element_id": "e000101", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 101, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The volume of the mixture of gases in syringe A at the start is $ 7 6 \\mathrm{c m}^{3}. $", "confidence": 1.0, "element_id": "e000102", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 102, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The volume of the mixture of gases in syringe B at the end is $ 6 6 \\mathrm{c m}^{3}. $", "confidence": 1.0, "element_id": "e000103", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 103, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Calculate the percentage by volume of carbon dioxide in the mixture of gases in syringe A.", "confidence": 1.0, "element_id": "e000104", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 104, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Give the change in the appearance of the limewater.", "confidence": 1.0, "element_id": "e000105", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 105, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Explain why the gas syringes in experiment 1 cannot be used to find the percentage of carbon dioxide in a typical sample of air.", "confidence": 1.0, "element_id": "e000106", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 106, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) In experiment 2, a teacher pushes the remaining gases over hot copper powder.", "confidence": 1.0, "element_id": "e000107", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 107, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The diagram shows the apparatus the teacher uses.", "confidence": 1.0, "element_id": "e000108", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 108, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The copper powder turns black as it reacts with oxygen.", "confidence": 1.0, "element_id": "e000110", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 110, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Argon is extremely unreactive, so it does not react with copper.", "confidence": 1.0, "element_id": "e000111", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 111, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Name the black substance that forms on the copper powder.", "confidence": 1.0, "element_id": "e000112", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 112, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Suggest why the teacher uses copper powder instead of the same mass of large pieces of copper.", "confidence": 1.0, "element_id": "e000113", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 113, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Explain why argon is extremely unreactive.", "confidence": 1.0, "element_id": "e000114", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 114, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 5 = 10 marks)", "confidence": 1.0, "element_id": "e000115", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 115, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000116", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 116, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "6 This question is about organic compounds.", "confidence": 1.0, "element_id": "e000117", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 117, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) The diagram shows the displayed formulae of five compounds, U, V, W, X and Y.", "confidence": 1.0, "element_id": "e000118", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 118, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Give the letter of the compound that is not a hydrocarbon.", "confidence": 1.0, "element_id": "e000120", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 120, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(1)", "confidence": 1.0, "element_id": "e000121", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 121, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Give the letter of the compound that is a saturated hydrocarbon with the empirical formula $ \\mathrm{C H_{2}} $", "confidence": 1.0, "element_id": "e000122", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 122, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Give the letter of the compound that reacts with bromine in the presence of ultraviolet radiation to form this structure.", "confidence": 1.0, "element_id": "e000123", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 123, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(1)", "confidence": 1.0, "element_id": "e000124", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 124, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iv) Give the letter of the compound that forms an addition polymer with this repeat unit.", "confidence": 1.0, "element_id": "e000126", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 126, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(v) Give the displayed formula of an alkene that is an isomer of compound X.", "confidence": 1.0, "element_id": "e000128", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 128, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(vi) Compounds U and X are members of the same homologous series Members of the same homologous series have the same functional group. Give two other characteristics of compounds in the same homologous series.", "confidence": 1.0, "element_id": "e000129", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 129, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Compound Z contains 38.7% carbon, 9.7% hydrogen and 51.6% oxygen by mass.", "confidence": 1.0, "element_id": "e000130", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 130, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Show by calculation that the empirical formula of compound Z is $ \\mathrm{C H_{3} O} $", "confidence": 1.0, "element_id": "e000131", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 131, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The relative formula mass $ ( M_{\\mathrm{r}}) $ of compound Z is 62 Deduce the molecular formula of compound Z.", "confidence": 1.0, "element_id": "e000132", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 132, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000133", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 133, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "7 This question is about nitrogen and some of its compounds.", "confidence": 1.0, "element_id": "e000134", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 134, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Nitrogen and oxygen do not react together at room temperature.", "confidence": 1.0, "element_id": "e000135", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 135, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "At the high temperatures in a car engine, nitrogen and oxygen react to form nitrogen monoxide, NO", "confidence": 1.0, "element_id": "e000136", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 136, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Give a chemical equation for this reaction.", "confidence": 1.0, "element_id": "e000137", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 137, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Give a reason why this reaction only occurs at high temperatures.", "confidence": 1.0, "element_id": "e000138", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 138, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) State why it is important that oxides of nitrogen are not released into the atmosphere.", "confidence": 1.0, "element_id": "e000139", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 139, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Nitrogen monoxide gas can be removed from car exhaust fumes when it reacts with carbon monoxide gas.", "confidence": 1.0, "element_id": "e000140", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 140, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) The rate of the reaction is increased by passing the gases over a catalyst. Explain how a catalyst increases the rate of a reaction.", "confidence": 1.0, "element_id": "e000141", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 141, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Explain how increasing the pressure of gases increases the rate of reaction.", "confidence": 1.0, "element_id": "e000142", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 142, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Ammonia is a simple molecule with the formula $ \\mathrm{N H}_{3} $", "confidence": 1.0, "element_id": "e000143", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 143, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Complete the diagram to show the outer shell electrons in ammonia.", "confidence": 1.0, "element_id": "e000144", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 144, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The bonds in ammonia are covalent.", "confidence": 1.0, "element_id": "e000146", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 146, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Describe the forces of attraction in a covalent bond.", "confidence": 1.0, "element_id": "e000147", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 147, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Explain why ammonia has a low boiling point.", "confidence": 1.0, "element_id": "e000148", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 148, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 7 = 14 marks)", "confidence": 1.0, "element_id": "e000149", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 149, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000150", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 150, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "8 This question is about barium chloride.", "confidence": 1.0, "element_id": "e000151", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 151, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Barium chloride can be made by reacting barium carbonate with dilute hydrochloric acid. The chemical equation for the reaction is", "confidence": 1.0, "element_id": "e000152", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 152, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Describe a method to produce dry crystals of hydrated barium chloride, starting with barium carbonate powder and dilute hydrochloric acid.", "confidence": 1.0, "element_id": "e000154", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 154, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) A colourless solution contains sodium carbonate and sodium sulfate.", "confidence": 1.0, "element_id": "e000155", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 155, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Describe a test using barium chloride to show that the colourless solution contains sulfate ions.", "confidence": 1.0, "element_id": "e000156", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 156, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 8 = 8 marks)", "confidence": 1.0, "element_id": "e000157", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 157, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "9 A student investigates the reaction between solid hydrated sodium carbonate and dilute hydrochloric acid.", "confidence": 1.0, "element_id": "e000158", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 158, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) She uses this method to investigate the temperature change during the reaction.", "confidence": 1.0, "element_id": "e000159", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 159, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 1 pour $ 2 5. 0 \\mathrm{c m}^{3} $ of dilute hydrochloric acid into a polystyrene cup", "confidence": 1.0, "element_id": "e000160", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 160, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 2 record the temperature of the dilute hydrochloric acid", "confidence": 1.0, "element_id": "e000161", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 161, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 3 add 0.5 g of sodium carbonate and stir the mixture", "confidence": 1.0, "element_id": "e000162", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 162, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 4 record the lowest temperature of the mixture", "confidence": 1.0, "element_id": "e000163", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 163, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 5 add further 0.5g portions of sodium carbonate, one portion at a time, stir the mixture and record the lowest temperature each time", "confidence": 1.0, "element_id": "e000164", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 164, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The table shows the student''s results.", "confidence": 1.0, "element_id": "e000165", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 165, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Plot the student''s results on the grid.", "confidence": 1.0, "element_id": "e000167", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 167, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Draw a curve of best fit, ignoring the anomalous result.", "confidence": 1.0, "element_id": "e000168", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 168, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Explain why it is better to use a polystyrene cup instead of a glass beaker in this experiment.", "confidence": 1.0, "element_id": "e000170", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 170, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iv) Suggest a reason for the anomalous result.", "confidence": 1.0, "element_id": "e000171", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 171, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(v) State how the results show that all the dilute hydrochloric acid has reacted.", "confidence": 1.0, "element_id": "e000172", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 172, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(vi) Use the results of the experiment to explain the type of reaction that occurs when sodium carbonate is added to dilute hydrochloric acid.", "confidence": 1.0, "element_id": "e000173", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 173, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The student does another experiment using the same reaction. The diagram shows the student''s apparatus.", "confidence": 1.0, "element_id": "e000174", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 174, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The mass on the balance decreases as carbon dioxide gas escapes.", "confidence": 1.0, "element_id": "e000176", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 176, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Give a reason for the cotton wool plug in the conical flask.", "confidence": 1.0, "element_id": "e000177", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 177, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The student adds 2.12 g of sodium carbonate to an excess of dilute hydrochloric acid.", "confidence": 1.0, "element_id": "e000178", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 178, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The chemical equation for the reaction is", "confidence": 1.0, "element_id": "e000179", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 179, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Calculate the maximum mass, in g, of carbon dioxide formed in the reaction.", "confidence": 1.0, "element_id": "e000181", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 181, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Suggest why the mass of carbon dioxide produced is less than the calculated maximum mass.", "confidence": 1.0, "element_id": "e000182", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 182, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "10 A teacher uses this apparatus to separate a mixture of ethanol and water.", "confidence": 1.0, "element_id": "e000183", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 183, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) (i) Name this method of separation.", "confidence": 1.0, "element_id": "e000185", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 185, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(1)", "confidence": 1.0, "element_id": "e000186", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 186, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Name the change of state taking place at A.", "confidence": 1.0, "element_id": "e000187", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 187, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Name the change of state taking place at B.", "confidence": 1.0, "element_id": "e000188", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 188, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(1)", "confidence": 1.0, "element_id": "e000189", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 189, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The mixture contains $ 1 5. 5 \\mathrm{c m}^{3} $ of ethanol.", "confidence": 1.0, "element_id": "e000190", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 190, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "1. 0 $ cm^{3} $ of ethanol has a mass of 0.79 g.", "confidence": 1.0, "element_id": "e000191", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 191, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "One mole of ethanol contains $ 6.00\\times10^{23} $ molecules.", "confidence": 1.0, "element_id": "e000192", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 192, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "[M $ _{r} $ of ethanol=46]", "confidence": 1.0, "element_id": "e000193", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 193, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Calculate the amount, in moles, of ethanol in $ 1 5. 5 \\mathrm{c m}^{3} $ of ethanol.", "confidence": 1.0, "element_id": "e000194", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 194, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Calculate the number of molecules of ethanol in $ 1 5. 5 \\mathrm{c m}^{3} $ of ethanol.", "confidence": 1.0, "element_id": "e000195", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 195, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "number of molecules =", "confidence": 1.0, "element_id": "e000196", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 196, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) After five minutes, the teacher collects a sample of colourless liquid in a new beaker.", "confidence": 1.0, "element_id": "e000197", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 197, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Describe a chemical test to show that the colourless liquid contains water.", "confidence": 1.0, "element_id": "e000198", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 198, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Describe a physical test to show if the colourless liquid is pure water.", "confidence": 1.0, "element_id": "e000199", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 199, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) The teacher uses this apparatus to heat 100g of water.", "confidence": 1.0, "element_id": "e000200", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 200, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "He records the temperature of the water before and after heating.", "confidence": 1.0, "element_id": "e000203", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 203, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "temperature of water before heating = 21.0 $ ^{\\circ} \\mathrm{C} $", "confidence": 1.0, "element_id": "e000204", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 204, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "temperature of water after heating = 70.5 $ ^{\\circ} \\mathrm{C} $", "confidence": 1.0, "element_id": "e000205", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 205, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Calculate the heat energy change (Q) in joules.", "confidence": 1.0, "element_id": "e000206", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 206, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "[specific heat capacity of water is 4.2 J/g/ $ ^{\\circ} \\mathrm{C} $]", "confidence": 1.0, "element_id": "e000207", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 207, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(3)", "confidence": 1.0, "element_id": "e000208", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 208, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The student burns 0.0200 mol of ethanol.", "confidence": 1.0, "element_id": "e000209", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 209, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Use this information and your value for $Q$ to calculate the molar enthalpy change ($\\Delta H$), in kJ/mol, for the combustion of ethanol.", "confidence": 1.0, "element_id": "e000210", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 210, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Include a sign in your answer.", "confidence": 1.0, "element_id": "e000211", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 211, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 10 = 15 marks)", "confidence": 1.0, "element_id": "e000213", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 213, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "11 This question is about the reactivity of metals.", "confidence": 1.0, "element_id": "e000214", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 214, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Table 1 shows whether a reaction occurs between a metal and an aqueous solution of a metal sulfate.", "confidence": 1.0, "element_id": "e000215", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 215, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Table 1", "confidence": 1.0, "element_id": "e000217", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 217, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Name the type of reaction that occurs between manganese and chromium sulfate.", "confidence": 1.0, "element_id": "e000218", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 218, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(1)", "confidence": 1.0, "element_id": "e000219", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 219, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Use the information in Table 1 to complete the order of reactivity.", "confidence": 1.0, "element_id": "e000220", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 220, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(1)", "confidence": 1.0, "element_id": "e000221", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 221, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Table 2 shows the colours of four metals and the colours of their metal sulfate solutions.", "confidence": 1.0, "element_id": "e000223", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 223, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Table 2", "confidence": 1.0, "element_id": "e000225", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 225, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "When a metal is added to a metal sulfate solution there may be a colour change on the surface of the metal and in the solution.", "confidence": 1.0, "element_id": "e000226", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 226, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Use the information in Table 2 and your knowledge of the reactivity series to explain any colour changes in these two experiments.", "confidence": 1.0, "element_id": "e000227", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 227, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "copper added to magnesium sulfate solution.", "confidence": 1.0, "element_id": "e000228", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 228, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "zinc added to iron sulfate solution.", "confidence": 1.0, "element_id": "e000229", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 229, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) A different experiment can be used to place metals in order of reactivity. This is the method.", "confidence": 1.0, "element_id": "e000230", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 230, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 1 add 1 g of a metal to $ 2 5 \\mathrm{c m}^{3} $ of dilute sulfuric acid", "confidence": 1.0, "element_id": "e000231", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 231, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 2 measure the volume of gas produced in one minute", "confidence": 1.0, "element_id": "e000232", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 232, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Give two variables that should be controlled in this experiment.", "confidence": 1.0, "element_id": "e000233", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 233, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) A small piece of calcium is added to some dilute sulfuric acid in a beaker.", "confidence": 1.0, "element_id": "e000234", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 234, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "One of the products of the reaction, calcium sulfate, is insoluble in water.", "confidence": 1.0, "element_id": "e000235", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 235, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Suggest why the reaction stops after a short time, even though the beaker still contains calcium and dilute sulfuric acid.", "confidence": 1.0, "element_id": "e000236", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 236, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) 1.00 g of aluminium is added to 0.0600 mol of dilute sulfuric acid.", "confidence": 1.0, "element_id": "e000237", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 237, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The equation for the reaction is", "confidence": 1.0, "element_id": "e000238", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 238, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Show by calculation that the sulfuric acid is in excess.", "confidence": 1.0, "element_id": "e000240", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 240, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000242", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 242, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000243", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 243, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000244", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 244, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "schemaVersion": "1.0"}', NULL, '2026-09-13 12:56:09.10558+00');
INSERT INTO public.documents VALUES ('7b4cbd55-1357-4cbd-82e8-16b9e3902bd1', '224003f3-6662-5f5f-80b7-6236424409e4', '1.0', 1, 'MARK_SCHEME', 'corpus/igcse-chemistry-4ch0-1c-2021nov/MS.md', 'MS.md', 'text/markdown', 'f55a4b5aeea3c3141055bd8f9a341b110a2be1e80e9c19d4662cb1c81ef17981', 'SHA-256', 1, 40, 40, 19, 'glm-ocr-markdown', '1.1.0', '2026-09-13 12:55:47.194376+00', '{"pages": [{"width": null, "height": null, "pageNumber": 1}], "source": {"uri": "corpus/igcse-chemistry-4ch0-1c-2021nov/MS.md", "checksum": "f55a4b5aeea3c3141055bd8f9a341b110a2be1e80e9c19d4662cb1c81ef17981", "fileName": "MS.md", "mimeType": "text/markdown", "checksumAlgorithm": "SHA-256"}, "tables": [{"rows": [["Question number", "Answer", "Notes", "Marks"], ["1(a)(i)", "A\nA is the correct answer because A contains one element and the atoms are not joined to other atoms.\nB is incorrect because B contains molecules of an element.\nC is incorrect because C contains molecules of a compound\nD is incorrect. D contains an element but the atoms are joined together to form a giant covalent structure.", "", "1"], ["(ii)", "C\nC is the correct answer because C contains atoms of two different elements chemically bonded together.\nA is incorrect because A is an element.\nB is incorrect because B is an element.\nD is incorrect because D is an element.", "", "1"], ["(iii)", "B\nB is correct because B shows two atoms of the same element chemically bonded together e.g. H2\nA is incorrect because A contains atoms of an element\nC in incorrect because C contains molecules of a compound with the formula e.g. H2O\nD is incorrect because C contains a giant covalent structure that could have the formula C", "", "1"], ["(b)", "M1 two different elements\nM2 not (chemically) joined / (chemically) bonded together", "ALLOW two different types of/sizes of atom.", "2"], ["", "", "", "5"]], "text": "Question number | Answer | Notes | Marks\n1(a)(i) | A\nA is the correct answer because A contains one element and the atoms are not joined to other atoms.\nB is incorrect because B contains molecules of an element.\nC is incorrect because C contains molecules of a compound\nD is incorrect. D contains an element but the atoms are joined together to form a giant covalent structure. |  | 1\n(ii) | C\nC is the correct answer because C contains atoms of two different elements chemically bonded together.\nA is incorrect because A is an element.\nB is incorrect because B is an element.\nD is incorrect because D is an element. |  | 1\n(iii) | B\nB is correct because B shows two atoms of the same element chemically bonded together e.g. H2\nA is incorrect because A contains atoms of an element\nC in incorrect because C contains molecules of a compound with the formula e.g. H2O\nD is incorrect because C contains a giant covalent structure that could have the formula C |  | 1\n(b) | M1 two different elements\nM2 not (chemically) joined / (chemically) bonded together | ALLOW two different types of/sizes of atom. | 2\n |  |  | 5", "row_count": 6, "confidence": 1.0, "element_id": "e000024", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 24, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["2", "(a)(i)", "fluorine has the fewest number of shells/energy levels", "ALLOW fluorine has the fewest number of electrons", "1"], ["(ii)", "C\nC is the correct answer because iodine is in period 5 therefore has 5 shells and group 7 therefore has 7 electrons in its outer shell.\nA is incorrect because arsenic has 5 shells and 4 electrons in its outer shell.\nB is incorrect because selenium has 4 shells and 6 electrons in its outer shell.\nD is incorrect because the number of shells and number of electrons in the outer shell in iodine have been reversed.", "IGNORE references to protons, neutrons, atomic number and mass number", "1"], ["(b)(i)", "(ii)", "M1 does not need heating", "", "2"], ["M2 reacts very quickly", "must imply quicker reaction than chlorine", ""], ["(ii)", "(ii)", "M1 as the atoms get bigger", "", "2"], ["M2 the reactivity decreases", "ACCEPT reverse argument", ""], ["", "", "", "", "6"]], "text": "Question number | Answer | Notes | Marks\n2 | (a)(i) | fluorine has the fewest number of shells/energy levels | ALLOW fluorine has the fewest number of electrons | 1\n(ii) | C\nC is the correct answer because iodine is in period 5 therefore has 5 shells and group 7 therefore has 7 electrons in its outer shell.\nA is incorrect because arsenic has 5 shells and 4 electrons in its outer shell.\nB is incorrect because selenium has 4 shells and 6 electrons in its outer shell.\nD is incorrect because the number of shells and number of electrons in the outer shell in iodine have been reversed. | IGNORE references to protons, neutrons, atomic number and mass number | 1\n(b)(i) | (ii) | M1 does not need heating |  | 2\nM2 reacts very quickly | must imply quicker reaction than chlorine | \n(ii) | (ii) | M1 as the atoms get bigger |  | 2\nM2 the reactivity decreases | ACCEPT reverse argument | \n |  |  |  | 6", "row_count": 8, "confidence": 1.0, "element_id": "e000025", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 25, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["3", "(a)(i)", "oxygen", "IGNORE air\nACCEPT O2", "1"], ["(ii)", "(hydrated) iron(III) oxide", "ALLOW iron oxide/ferric oxide\nREJECT incorrect oxidation states of iron", "1"], ["(b)(i)", "M1 plastic acts as a barrier\nM2 therefore stops oxygen/water getting to the iron", "ALLOW forms a protective layer\nALLOW air in place of oxygen", "2"], ["(ii)", "(iii)", "galvanising", "ALLOW sacrificial protection\nIGNORE sacrificial method", "1"], ["IGNORE references to rates of reaction\nREJECT references to zinc rusting", "2"], ["M1 zinc is more reactive than iron/higher in the reactivity series than iron\nM2 therefore reacts/oxidises/corrodes in preference to iron"], ["", "", "", "", "7"]], "text": "Question number | Answer | Notes | Marks\n3 | (a)(i) | oxygen | IGNORE air\nACCEPT O2 | 1\n(ii) | (hydrated) iron(III) oxide | ALLOW iron oxide/ferric oxide\nREJECT incorrect oxidation states of iron | 1\n(b)(i) | M1 plastic acts as a barrier\nM2 therefore stops oxygen/water getting to the iron | ALLOW forms a protective layer\nALLOW air in place of oxygen | 2\n(ii) | (iii) | galvanising | ALLOW sacrificial protection\nIGNORE sacrificial method | 1\nIGNORE references to rates of reaction\nREJECT references to zinc rusting | 2\nM1 zinc is more reactive than iron/higher in the reactivity series than iron\nM2 therefore reacts/oxidises/corrodes in preference to iron\n |  |  |  | 7", "row_count": 8, "confidence": 1.0, "element_id": "e000026", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 26, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["4(a)(i)", "14", "", "1"], ["(ii)", "2.5", "REJECT any charge shown\nIGNORE brackets", "1"], ["(iii)", "M1 same number of protons\nM2 different numbers of neutrons", "IGNORE references to numbers of electrons", "2"], ["(iv)", "M1 (three) more electrons than protons\nM2 electrons have a negative charge and protons have a positive charge", "REJECT incorrect numbers of electrons", "2"], ["(b)", "M1(98.930×12)+(1.070×13)÷100\nM212.01", "ALLOW1markfor1201.07ifnotdividedby100aslongasgivento2dp\ncorrectanswerto2decimalplaceswithorwithoutworkingscores2marks.", "2"], ["", "", "", "8"]], "text": "Question number | Answer | Notes | Marks\n4(a)(i) | 14 |  | 1\n(ii) | 2.5 | REJECT any charge shown\nIGNORE brackets | 1\n(iii) | M1 same number of protons\nM2 different numbers of neutrons | IGNORE references to numbers of electrons | 2\n(iv) | M1 (three) more electrons than protons\nM2 electrons have a negative charge and protons have a positive charge | REJECT incorrect numbers of electrons | 2\n(b) | M1(98.930×12)+(1.070×13)÷100\nM212.01 | ALLOW1markfor1201.07ifnotdividedby100aslongasgivento2dp\ncorrectanswerto2decimalplaceswithorwithoutworkingscores2marks. | 2\n |  |  | 8", "row_count": 7, "confidence": 1.0, "element_id": "e000027", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 27, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["5(a)", "Any one from:\nM1 add more limewater (to cover tube on left)\nM2 the glass tube on the left should be longer/in the limewater", "", "1"], ["(b)(i)", "M1 volume of carbon dioxide = 10(cm3)\nM2 10÷76×100=13.2(%)", "correct answer with or without working scores 2 marks.\nACCEPT any number of significant figures except 1\nREJECT incorrect rounding\nALLOW ecf on incorrect volume of carbon dioxide\nALLOW 66/76×100=86.8 for 1 mark", "2"], ["(ii)", "limewater turns (from colourless to) cloudy or milky", "ALLOW white precipitate", "1"], ["(iii)", "M1 the percentage/amount of carbon dioxide in the air is too small\nM2 therefore the reading on the syringe would change by less than 1cm3", "ALLOW there is 0.04% of carbon dioxide in the air\nALLOW the change on the gas syringe would be too small\nALLOW syringe not precise/accurate enough to measure small volume changes", "2"]], "text": "Question number | Answer | Notes | Marks\n5(a) | Any one from:\nM1 add more limewater (to cover tube on left)\nM2 the glass tube on the left should be longer/in the limewater |  | 1\n(b)(i) | M1 volume of carbon dioxide = 10(cm3)\nM2 10÷76×100=13.2(%) | correct answer with or without working scores 2 marks.\nACCEPT any number of significant figures except 1\nREJECT incorrect rounding\nALLOW ecf on incorrect volume of carbon dioxide\nALLOW 66/76×100=86.8 for 1 mark | 2\n(ii) | limewater turns (from colourless to) cloudy or milky | ALLOW white precipitate | 1\n(iii) | M1 the percentage/amount of carbon dioxide in the air is too small\nM2 therefore the reading on the syringe would change by less than 1cm3 | ALLOW there is 0.04% of carbon dioxide in the air\nALLOW the change on the gas syringe would be too small\nALLOW syringe not precise/accurate enough to measure small volume changes | 2", "row_count": 5, "confidence": 1.0, "element_id": "e000028", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 28, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["5(c)(i)", "copper(II) oxide", "ALLOW copper oxide/CuO\nREJECT copper(I) oxide", "1"], ["(ii)", "the powder has a greater surface area(than larger pieces of copper)", "ALLOW the powder reacts more quickly(than larger pieces of copper)", "1"], ["(iii)", "M1argon/it has a full outer shell of electrons\nM2therefore does not lose or gain(or share) electrons", "ALLOW has eight outer shell electrons", "2"], ["", "", "", "10"]], "text": "Question number | Answer | Notes | Marks\n5(c)(i) | copper(II) oxide | ALLOW copper oxide/CuO\nREJECT copper(I) oxide | 1\n(ii) | the powder has a greater surface area(than larger pieces of copper) | ALLOW the powder reacts more quickly(than larger pieces of copper) | 1\n(iii) | M1argon/it has a full outer shell of electrons\nM2therefore does not lose or gain(or share) electrons | ALLOW has eight outer shell electrons | 2\n |  |  | 10", "row_count": 5, "confidence": 1.0, "element_id": "e000029", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 29, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["6", "(a)(i)", "Y", "", "1"], ["", "(ii)", "V", "", "1"], ["", "(iii)", "W", "", "1"], ["", "(iv)", "X", "", "1"], ["", "(v)", "