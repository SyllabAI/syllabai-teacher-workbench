INSERT INTO public.questions VALUES ('21710927-afd3-4998-92f2-c85dbf09f858', 'q05-2f82da9d', 'STRUCTURED', 'Crude oil is a liquid that contains a mixture of many hydrocarbons. The diagram shows a fractionating column used in the distillation of crude oil. The six fractions obtained are shown. One use for each of four of the fractions is also shown.', 7, 3, 630, NULL, '4db63338-5d31-45b9-87ca-c5e5ae693ae1', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.392672+00', '5cd177ba-bfaf-4adc-8e89-e65c40880fe3');
