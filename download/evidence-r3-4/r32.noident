INSERT INTO public.document_chunks VALUES ('501e1669-f73e-4a31-beb4-14f0cced0775', '7370a5be-60c7-4780-a488-5ea4ce8959e8', 6, '(c) Hydrogen is used to manufacture ammonia, $ \mathrm{N H_{3}} $ Hydrogen is reacted with nitrogen using an iron catalyst.
