INSERT INTO public.mark_points VALUES ('15ddef2c-e3ae-4ca4-9f5f-abb4ead2a80b', '61dffc84-bbfe-463f-8869-703e62b839b3', '3eb0f34e-ba8c-4ddb-92b1-187cde26f7d6', '8-c-i', 2, 'M1 calculation of mass of octaneM2 calculation of Mr of C8H18 and CO2M3 link between mass/mol C8H18 and mass/mol CO2M4 calculation of mass CO2 in gM5 calculation of mass CO2 in kgExample calculation:M1 50x700=35000(g)M2 Mr of C8H18=114 and Mr CO2=44M3 114g C8H18 produces(8x44=)352(g)CO2M4 35000g C8H18 produces35000x352114=108070.2(g)CO2M5=108(kg)Alternative method using mol:M1 50x700=35000(g)M2 Mr of C8H18=114 and Mr CO2=44M3 n(C8H18)=35000=307.0175mol114so n(CO2)=8x307.0175=2456.14molM4 mass CO2=2456.14x44=108070.2(g)M5=108(kg)MARK CSQ in both methodscorrect answer without working scores5', 5, '[]', 0.75, '2026-09-13 12:55:24.087465+00');
