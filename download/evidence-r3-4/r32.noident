INSERT INTO public.questions VALUES ('c4246727-5c56-42da-82d4-58b96bb8bef6', 'q06-628fade2', 'STRUCTURED', 'When a bottle of wine is left open for several days, some of the ethanol in the wine turns to ethanoic acid, $ \mathrm{C H_{3} C O O H} $', 1, 3, 90, NULL, '889d380c-6b79-43b0-a540-90649bb87dd0', 'PAST_PAPER', true, 1, '2026-09-13 13:00:40.969901+00', '9143d088-a097-4235-a892-bf1413550fd1');
INSERT INTO public.questions VALUES ('1db9ba1e-90c5-4f8d-bb86-f796c64cf2b5', 'q07-628fade2', 'STRUCTURED', 'Hydrogen gas can be produced by reacting a mixture of methane and steam in the presence of a nickel catalyst. The reaction conditions are a temperature of $ 7 0 0^{\circ} \mathrm{C} $ and a pressure of 5 atmospheres. The equation for the reaction is $\mathrm {C H} _ {4} (\mathrm {g}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {g}) \rightleftharpoons \mathrm {C O} (\mathrm {g}) + 3 \mathrm {H} _ {2} (\mathrm {g}) \quad \Delta H = + 2 0 6 \mathrm {k J / m o l}$', 1, 3, 90, NULL, '889d380c-6b79-43b0-a540-90649bb87dd0', 'PAST_PAPER', true, 1, '2026-09-13 13:00:40.970184+00', '9143d088-a097-4235-a892-bf1413550fd1');
INSERT INTO public.questions VALUES ('ef1101a4-51e7-4391-84e8-3af4a2bdfe79', 'q04-75c7a386', 'STRUCTURED', '(a) Hand sanitiser liquids are used regularly to reduce the spread of infections. Three compounds P, Q and R are often present in these liquids. (i) What type of formula is shown for P? (ii) Compounds P, Q and R are members of the same homologous series. Give two properties of a homologous series. (iii) Name the homologous series that contains compounds P, Q and R. (iv) Give the name of compound Q. A a displayed formula B an empirical formula C a molecular formula D a structural formula', 1, 3, 90, NULL, 'f897717a-9adf-40ee-82c9-9c89f1fa3469', 'PAST_PAPER', true, 1, '2026-09-13 13:03:38.328382+00', '09567021-55e3-41ea-8649-25dfb67ea3de');
INSERT INTO public.questions VALUES ('eab300b3-3b97-4dbb-9d18-f5accfea12ec', 'q05-75c7a386', 'STRUCTURED', 'This question is about the element phosphorus and some of its compounds.', 11, 3, 990, NULL, 'f897717a-9adf-40ee-82c9-9c89f1fa3469', 'PAST_PAPER', true, 1, '2026-09-13 13:03:38.32875+00', '09567021-55e3-41ea-8649-25dfb67ea3de');
INSERT INTO public.questions VALUES ('25b4e2a9-c102-4db6-82d4-3fe0e7467119', 'q06-75c7a386', 'STRUCTURED', 'Iron metal was discovered several thousand years ago. Iron is produced industrially from iron(III) oxide by extraction using carbon. Sodium is a metal in Group 1 of the Periodic Table. Sodium was discovered by Sir Humphrey Davy in 1807. It is produced industrially by the electrolysis of sodium chloride.', 13, 3, 1170, NULL, 'f897717a-9adf-40ee-82c9-9c89f1fa3469', 'PAST_PAPER', true, 1, '2026-09-13 13:03:38.329486+00', '09567021-55e3-41ea-8649-25dfb67ea3de');
INSERT INTO public.questions VALUES ('c5857813-629b-4093-9776-d8cd60eaffbd', 'q07-75c7a386', 'STRUCTURED', 'A student is asked to find the concentration of a solution of nitric acid by doing a titration. The student is provided with sodium hydroxide solution with a concentration of $ 0.350\mathrm{mol/dm}^{3} $ These are the first four steps in the student''s method. use a pipette to add exactly $ 2 5. 0 \mathrm{c m}^{3} $ of the nitric acid solution to a conical flask placed on a white tile add a few drops of indicator to the flask use a burette to add sodium hydroxide solution to the flask until the indicator has changed colour record the volume needed for the indicator to change colour', 1, 3, 90, NULL, 'f897717a-9adf-40ee-82c9-9c89f1fa3469', 'PAST_PAPER', true, 1, '2026-09-13 13:03:38.330097+00', '09567021-55e3-41ea-8649-25dfb67ea3de');
INSERT INTO public.questions VALUES ('aa251f56-5bad-4d0d-879b-5166a90c886b', 'q01-b1b5d37e', 'STRUCTURED', 'This question is about elements, compounds and mixtures.', 5, 3, 450, NULL, '14d6750b-4e1c-4226-af76-5ef736b6517e', 'PAST_PAPER', true, 1, '2026-09-13 13:00:41.168867+00', 'e4771691-73f9-43ec-93d6-3de6cf5f0667');
INSERT INTO public.questions VALUES ('53597174-12ba-49ae-af91-87f98773f0ca', 'q02-b1b5d37e', 'STRUCTURED', 'Crude oil is a mixture of hydrocarbons.', 11, 3, 990, NULL, '14d6750b-4e1c-4226-af76-5ef736b6517e', 'PAST_PAPER', true, 1, '2026-09-13 13:00:41.170106+00', 'e4771691-73f9-43ec-93d6-3de6cf5f0667');
INSERT INTO public.questions VALUES ('7524c49e-78dd-47ae-a00f-b2a220dd5d71', 'q03-b1b5d37e', 'STRUCTURED', 'This question is about copper and its compounds.', 1, 3, 90, NULL, '14d6750b-4e1c-4226-af76-5ef736b6517e', 'PAST_PAPER', true, 1, '2026-09-13 13:00:41.170789+00', 'e4771691-73f9-43ec-93d6-3de6cf5f0667');
INSERT INTO public.questions VALUES ('428aa486-a4a1-46ad-928d-1d889e2455e1', 'q04-b1b5d37e', 'STRUCTURED', 'A student investigates the reaction between sodium hydroxide solution and dilute sulfuric acid. He does a titration to find the concentration of the sulfuric acid. This is his plan for the titration. There are some mistakes and omissions in his plan. rinse a conical flask with the sodium hydroxide solution use a measuring cylinder to measure out $ 2 5 \mathrm{c m}^{3} $ of the sodium hydroxide solution and add it to the conical flask add a few drops of methyl orange indicator to the conical flask rinse a burette with water and then fill it with the sulfuric acid add the acid from the burette to the conical flask until the indicator changes colour at the end-point of the titration record the final burette reading', 9, 3, 810, NULL, '14d6750b-4e1c-4226-af76-5ef736b6517e', 'PAST_PAPER', true, 1, '2026-09-13 13:00:41.171103+00', 'e4771691-73f9-43ec-93d6-3de6cf5f0667');
INSERT INTO public.questions VALUES ('7bd55710-f2a4-4369-9793-afbe77c484d5', 'q05-b1b5d37e', 'STRUCTURED', 'Oxygen can be prepared from hydrogen peroxide using a catalyst.', 1, 3, 90, NULL, '14d6750b-4e1c-4226-af76-5ef736b6517e', 'PAST_PAPER', true, 1, '2026-09-13 13:00:41.171396+00', 'e4771691-73f9-43ec-93d6-3de6cf5f0667');
INSERT INTO public.questions VALUES ('151af226-2b4a-4e70-91ca-79bd0cca3def', 'q06-b1b5d37e', 'STRUCTURED', 'Ethanol, $ \mathrm{C_{2} H_{5} O H} $ , can be manufactured from ethene and steam using a phosphoric acid catalyst. (a) (i) State the temperature and pressure used in this manufacturing process. temperature pressure ... (ii) Draw the displayed formula of ethanol.', 11, 3, 990, NULL, '14d6750b-4e1c-4226-af76-5ef736b6517e', 'PAST_PAPER', true, 1, '2026-09-13 13:00:41.171637+00', 'e4771691-73f9-43ec-93d6-3de6cf5f0667');
INSERT INTO public.questions VALUES ('8ffecc06-a829-4791-9c63-da202ff1daa2', 'q07-b1b5d37e', 'STRUCTURED', 'This question is about some Group 2 elements and their compounds.', 1, 3, 90, NULL, '14d6750b-4e1c-4226-af76-5ef736b6517e', 'PAST_PAPER', true, 1, '2026-09-13 13:00:41.171914+00', 'e4771691-73f9-43ec-93d6-3de6cf5f0667');
INSERT INTO public.questions VALUES ('b718f7ed-c8ff-4723-86f8-b54bdde3e901', 'q08-75c7a386', 'STRUCTURED', 'This question is about reactions involving nitrogen.', 8, 3, 720, NULL, 'f897717a-9adf-40ee-82c9-9c89f1fa3469', 'PAST_PAPER', true, 1, '2026-09-13 13:03:38.352868+00', '09567021-55e3-41ea-8649-25dfb67ea3de');
INSERT INTO public.questions VALUES ('e581f502-2c8e-401c-987d-3375927a9404', 'q01-d9f7c281', 'STRUCTURED', 'Use the Periodic Table to help you answer this question.', 1, 3, 90, NULL, '1eadc1ae-d0f5-405f-9a3c-bbfcb58eeb34', 'PAST_PAPER', true, 1, '2026-09-13 13:03:38.503845+00', '6538f327-91b4-4cfb-beef-f401554e16b6');
