INSERT INTO public.document_chunks VALUES ('68904e8f-a302-4e6a-aef4-8ed9c9aace59', '40143932-806b-41ec-bbde-7d53852f6ab3', 1, 'Pearson aspires to be the world''s leading learning company. Our aim is to help everyone progress in their lives through education. We believe in every kind of learning, for all kinds of people, wherever they are in the world. We''ve been involved in education for over 150 years, and by working across 70 countries, in 100 languages, we have built an international reputation for our commitment to high standards and raising achievement through innovation in education. Find out more about how we can help you and your students at: www.pearson.com/uk
