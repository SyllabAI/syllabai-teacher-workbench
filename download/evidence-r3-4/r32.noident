INSERT INTO public.question_parts VALUES ('e0306ed5-6540-4d82-a542-08476392e108', '79bb5cd2-9bc0-4e64-bf7a-6ca18971bf57', 'c', 'A scientist does an investigation to find out if butadiene would be a good fuel. He burns a sample of butadiene gas and observes that carbon forms as black soot.', NULL, 0, 3, '2026-09-13 13:01:25.914154+00');
