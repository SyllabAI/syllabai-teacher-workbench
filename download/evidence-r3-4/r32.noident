INSERT INTO public.question_versions VALUES ('c5f452cf-a1d8-48d9-805e-e7bd23cf7ef7', '3439b193-de30-4a66-8507-b88b0b40bc4a', 1, 'A student is provided with a solution of dilute sulfuric acid and a solution of sodium hydroxide. The student does a titration using $ 2 5. 0 \mathrm{c m}^{3} $ of the sodium hydroxide solution. She adds the acid from a burette.', 6, 3, 540, NULL, 'SUGGESTED', 'b705ec20-4702-5901-b487-ea523791dec6', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:56.756981+00');
