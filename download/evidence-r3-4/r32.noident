INSERT INTO public.question_parts VALUES ('61c8e335-7d29-4bb0-aaec-ceaf935d2739', 'e6e8c7d7-6170-4575-bdde-275b345f3a00', 'd', 'Suggest the formula of the compound formed when potassium reacts with oxygen, and when potassium reacts with chlorine. oxygen chlorine', NULL, 0, 3, '2026-09-13 12:53:11.380074+00');
INSERT INTO public.question_parts VALUES ('a213ce5b-1fbe-437c-8925-9c2d089fc6ae', 'e6e8c7d7-6170-4575-bdde-275b345f3a00', 'e', 'Complete the equation for the reaction between rubidium and water by inserting state symbols. $2 \mathrm {R b} (\dots \dots \dots \dots \dots) + 2 \mathrm {H} _ {2} \mathrm {O} (\dots \dots \dots \dots \dots) \rightarrow 2 \mathrm {R b O H} (\dots \dots \dots \dots \dots) + \mathrm {H} _ {2} (\dots \dots \dots \dots \dots)$', NULL, 0, 4, '2026-09-13 12:53:11.380091+00');
INSERT INTO public.question_parts VALUES ('bcdfe742-8719-41b8-97b0-5a41825d700e', 'e6e8c7d7-6170-4575-bdde-275b345f3a00', 'f', 'The table shows information about the isotopes in a sample of rubidium. Use information from the table to calculate the relative atomic mass of this sample of rubidium. Give your answer to one decimal place.', NULL, 0, 5, '2026-09-13 12:53:11.380112+00');
INSERT INTO public.question_parts VALUES ('498cb4f2-847e-46c9-9230-82f953bd8609', '475f4235-70d0-473c-8673-3f67bd4a72a2', 'a', 'A student uses the precipitation method to prepare lead(II) bromide. The equation for the reaction she uses is $\mathrm {P b} \left(\mathrm {N O} _ {3}\right) _ {2} (\mathrm {a q}) + 2 \mathrm {N a B r} (\mathrm {a q}) \rightarrow \mathrm {P b B r} _ {2} (\mathrm {s}) + 2 \mathrm {N a N O} _ {3} (\mathrm {a q})$ Describe how she could use solutions of lead(II) nitrate and sodium bromide to obtain a pure, dry sample of lead(II) bromide.', NULL, 0, 0, '2026-09-13 12:53:11.380138+00');
INSERT INTO public.question_parts VALUES ('73e8310d-a76a-449a-836c-a97ccb9569ce', '475f4235-70d0-473c-8673-3f67bd4a72a2', 'b', 'The student''s teacher uses this apparatus to electrolyse a pure sample of molten lead(II) bromide. The student records these observations. a small blob of a silvery liquid appears at one electrode a brown substance forms at the other electrode the lamp stops working soon after the teacher stops heating the lead(II) bromide', NULL, 0, 1, '2026-09-13 12:53:11.380156+00');
INSERT INTO public.question_parts VALUES ('39042b45-9340-4b10-a276-c02a680feb7b', '475f4235-70d0-473c-8673-3f67bd4a72a2', 'b-i', 'Which is the correct statement about this electrolysis? A the brown substance is bromide B the products are both elements C the silvery liquid forms at the positive electrode D the silvery liquid is molten lead(II) bromide', NULL, 0, 2, '2026-09-13 12:53:11.380177+00');
INSERT INTO public.question_parts VALUES ('e2845b9f-fdad-4696-8444-8942b6bac9cf', '475f4235-70d0-473c-8673-3f67bd4a72a2', 'b-ii', 'The student writes this half-equation to show the reaction in which the brown substance forms. $2 \mathrm {B r} ^ {-} + 2 \mathrm {e} ^ {-} \rightarrow 2 \mathrm {B r}$ Identify the two mistakes in her half-equation.', NULL, 0, 3, '2026-09-13 12:53:11.380197+00');
INSERT INTO public.question_parts VALUES ('273653ea-661a-4c10-9bbb-6aca1da0ee88', '475f4235-70d0-473c-8673-3f67bd4a72a2', 'b-iii', 'Explain why the lamp stops working after the teacher stops heating the lead(II) bromide.', NULL, 0, 4, '2026-09-13 12:53:11.380225+00');
INSERT INTO public.question_parts VALUES ('e1583273-6b7f-4e99-8c41-c7bd67cf9c4d', '6aeb7b89-d276-42fe-890a-91dbbbf9f063', 'a', 'He does a titration using these steps to find the ratio of the volumes of reactants needed. add 25.0 $ cm^{3} $ solution of dilute sodium hydroxide solution to a conical flask add a few drops of phenolphthalein indicator to the conical flask add dilute sulfuric acid from a burette until the indicator just changes colour repeat the experiment until concordant results are obtained', NULL, 0, 0, '2026-09-13 12:53:11.380252+00');
