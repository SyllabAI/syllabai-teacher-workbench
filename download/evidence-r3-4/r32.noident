INSERT INTO public.questions VALUES ('4976197f-1772-4536-9f2e-618b4b09e2f1', 'q06-8efa97d9', 'STRUCTURED', 'The table gives information about the first four elements in Group 7 of the Periodic Table.', 16, 3, 1440, NULL, 'fc8a088b-112c-4007-982e-6a41b10d5701', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.603573+00', '58ed1fc6-24d7-4ef1-b567-0428dcfaf3e9');
INSERT INTO public.questions VALUES ('7ac2a681-b061-4618-b1b8-35b9167119f6', 'q07-8efa97d9', 'STRUCTURED', 'Some students investigated the rate of the reaction between marble chips (calcium carbonate) and dilute hydrochloric acid.', 16, 3, 1440, NULL, 'fc8a088b-112c-4007-982e-6a41b10d5701', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.603835+00', '58ed1fc6-24d7-4ef1-b567-0428dcfaf3e9');
INSERT INTO public.questions VALUES ('b44e6bf9-05d5-4cb3-8e73-8352eb148d6f', 'q08-8efa97d9', 'STRUCTURED', 'A student was asked by his teacher to perform a flame test on a solid. He used this method. dip the tip of a clean platinum wire into hydrochloric acid and then into the solid adjust the air hole of the Bunsen burner to obtain a non-roaring, non-luminous Bunsen flame place the tip of the platinum wire into the edge of the flame observe the colour in the flame', 8, 3, 720, NULL, 'fc8a088b-112c-4007-982e-6a41b10d5701', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.604059+00', '58ed1fc6-24d7-4ef1-b567-0428dcfaf3e9');
INSERT INTO public.questions VALUES ('8247e519-baf7-40b1-8aa4-f7a4e4fcca3a', 'q09-8efa97d9', 'STRUCTURED', 'The piece of apparatus shown contains 0.010 mol/dm $ ^{3} $ hydrochloric acid.', 1, 3, 90, NULL, 'fc8a088b-112c-4007-982e-6a41b10d5701', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.604277+00', '58ed1fc6-24d7-4ef1-b567-0428dcfaf3e9');
INSERT INTO public.questions VALUES ('96e5f221-0333-4bab-8021-ebf0225fa6a0', 'q10-8efa97d9', 'STRUCTURED', 'Ammonia $ \mathrm{(N H_{3})} $ can be made by reacting nitrogen and hydrogen, in the presence of an iron catalyst, according to the equation $\mathrm {N} _ {2} (\mathrm {g}) + 3 \mathrm {H} _ {2} (\mathrm {g}) \rightleftharpoons 2 \mathrm {N H} _ {3} (\mathrm {g}) \quad \Delta H = - 9 2 \mathrm {k J / m o l}$ The reaction is reversible and the reaction mixture can, if left for long enough, reach a position of dynamic equilibrium. The graph shows how the percentage of ammonia at equilibrium depends on the temperature and pressure used. Percentage of ammonia at equilibrium', 15, 3, 1350, NULL, 'fc8a088b-112c-4007-982e-6a41b10d5701', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.604492+00', '58ed1fc6-24d7-4ef1-b567-0428dcfaf3e9');
INSERT INTO public.questions VALUES ('9837b683-ea60-4be0-816a-7b1377edbb20', 'q11-8efa97d9', 'STRUCTURED', 'A student burned four liquid fuels in order to compare the amount of energy they released, in the form of heat. She used this apparatus. The energy released when each fuel was burned was used to raise the temperature of 100 g of water. For each fuel, the student recorded the mass of fuel burned and the increase in temperature of the water. Her results are shown in the table. The best fuel is the one that releases the most energy.', 9, 3, 810, NULL, 'fc8a088b-112c-4007-982e-6a41b10d5701', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.604746+00', '58ed1fc6-24d7-4ef1-b567-0428dcfaf3e9');
INSERT INTO public.questions VALUES ('45db4864-ea6c-4257-82e9-a0f9a6c4bcc9', 'q02-0953f0b3', 'STRUCTURED', 'The three states of matter are solid, liquid and gas. The diagram shows how the particles are arranged in each of these states.', 7, 3, 630, NULL, '3781a599-2c36-42ec-87d4-3f62ab3a7ab1', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.784625+00', 'f1aa732a-1202-44be-a791-fb2a652cfdee');
INSERT INTO public.questions VALUES ('64ad0312-2860-4d30-b218-e4c6aba639a0', 'q03-0953f0b3', 'STRUCTURED', 'Air is a mixture of gases. The table gives the formulae of three gases and their approximate percentage by volume in a sample of dry, unpolluted air.', 9, 3, 810, NULL, '3781a599-2c36-42ec-87d4-3f62ab3a7ab1', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.785624+00', 'f1aa732a-1202-44be-a791-fb2a652cfdee');
INSERT INTO public.questions VALUES ('1f5ed671-9fc4-47cb-9932-da6286aefda1', 'q01-c4484f7b', 'STRUCTURED', '(a) The diagram shows the particles in four substances, A, B, C and D. (i) Which substance contains single atoms of one element? (ii) Which substance is a compound? (iii) Which substance could have the formula $ \mathrm{H}_{2} $?', 2, 3, 180, NULL, '8d44f530-89ab-46e0-879e-6093627d9760', 'PAST_PAPER', true, 1, '2026-09-13 12:56:09.301788+00', '7f9970db-c196-4d4d-94d6-4125fa7c164c');
INSERT INTO public.questions VALUES ('401d190e-f499-4b77-8ad8-d1f11aeb70d1', 'q02-c4484f7b', 'STRUCTURED', 'This question is about Group 7 elements and their reactions.', 6, 3, 540, NULL, '8d44f530-89ab-46e0-879e-6093627d9760', 'PAST_PAPER', true, 1, '2026-09-13 12:56:09.317111+00', '7f9970db-c196-4d4d-94d6-4125fa7c164c');
INSERT INTO public.questions VALUES ('73b09017-1ff4-4d08-8684-6769e4feae7d', 'q03-c4484f7b', 'STRUCTURED', 'This question is about the rusting of iron.', 7, 3, 630, NULL, '8d44f530-89ab-46e0-879e-6093627d9760', 'PAST_PAPER', true, 1, '2026-09-13 12:56:09.318485+00', '7f9970db-c196-4d4d-94d6-4125fa7c164c');
INSERT INTO public.questions VALUES ('6533397f-761d-405d-bb03-199a38c1876e', 'q05-c4484f7b', 'STRUCTURED', 'Two experiments are done to determine the percentage composition by volume of a mixture of three gases, carbon dioxide, oxygen and argon.', 10, 3, 900, NULL, '8d44f530-89ab-46e0-879e-6093627d9760', 'PAST_PAPER', true, 1, '2026-09-13 12:56:09.322236+00', '7f9970db-c196-4d4d-94d6-4125fa7c164c');
INSERT INTO public.questions VALUES ('d15f9a50-d555-42b4-bf16-4747814857c1', 'q06-c4484f7b', 'STRUCTURED', 'This question is about organic compounds.', 1, 3, 90, NULL, '8d44f530-89ab-46e0-879e-6093627d9760', 'PAST_PAPER', true, 1, '2026-09-13 12:56:09.325167+00', '7f9970db-c196-4d4d-94d6-4125fa7c164c');
INSERT INTO public.questions VALUES ('b165d3df-0c6a-4c1b-9dd2-736639111b6f', 'q09-1469520f', 'STRUCTURED', 'This question is about substances that contain covalent bonds.', 10, 3, 900, NULL, '8acd9ca3-705e-4f95-a18f-b9756a3bb097', 'PAST_PAPER', true, 1, '2026-09-13 12:56:55.658397+00', '7ee2b7fa-a747-4ba0-97b2-38701421b5b3');
INSERT INTO public.questions VALUES ('d11947e3-334c-4078-ac56-f5efb159734e', 'q10-1469520f', 'STRUCTURED', 'A student uses this apparatus to record the maximum temperature in the reaction between solutions of hydrochloric acid and sodium hydroxide. This is the student''s method. add $ 2 5 \mathrm{c m}^{3} $ of hydrochloric acid to the beaker add $ 2 5 \mathrm{c m}^{3} $ of sodium hydroxide solution to the beaker stir the mixture record the maximum temperature reached', 9, 3, 810, NULL, '8acd9ca3-705e-4f95-a18f-b9756a3bb097', 'PAST_PAPER', true, 1, '2026-09-13 12:56:55.658774+00', '7ee2b7fa-a747-4ba0-97b2-38701421b5b3');
INSERT INTO public.questions VALUES ('040c5ffa-fdb1-410d-ac9c-c9f99ee50c1e', 'q11-1469520f', 'STRUCTURED', 'This question is about the reaction between magnesium and dilute nitric acid.', 1, 3, 90, NULL, '8acd9ca3-705e-4f95-a18f-b9756a3bb097', 'PAST_PAPER', true, 1, '2026-09-13 12:56:55.65915+00', '7ee2b7fa-a747-4ba0-97b2-38701421b5b3');
INSERT INTO public.questions VALUES ('68585c88-81cf-40d0-9457-8e0d751a55ae', 'q12-1469520f', 'STRUCTURED', 'This question is about hydrated compounds. Crystals of hydrated barium chloride $ \mathrm{(B a C I_{2}. x H_{2} O)} $ contain water of crystallisation. This is the student''s method. Step 1 record mass of tube A when empty Step 2 place a sample of hydrated barium chloride crystals in tube A and record new mass Step 3 heat tube A Step 4 allow tube A to cool and record mass Repeat steps 3 and 4 until the mass recorded in step 4 is constant. These are the student''s results. $\mathrm {m a s s o f t u b e A} = 1 0. 5 5 \mathrm {g}$ $\mathrm {m a s s o f t u b e A a n d B a C l} _ {2}. \mathrm {x H} _ {2} \mathrm {O} = 1 6. 6 5 \mathrm {g}$ $\mathrm {f i n a l m a s s o f t u b e A a n d B a C l} _ {2} = 1 5. 7 5 \mathrm {g}$ A student uses this apparatus to remove and collect the water from some crystals.', 13, 3, 1170, NULL, '8acd9ca3-705e-4f95-a18f-b9756a3bb097', 'PAST_PAPER', true, 1, '2026-09-13 12:56:55.659533+00', '7ee2b7fa-a747-4ba0-97b2-38701421b5b3');
INSERT INTO public.questions VALUES ('eec3de4d-70a9-4fa3-91b9-68ed4611c2ff', 'q03-7a09643b', 'STRUCTURED', 'This question is about alkanes.', 15, 3, 1350, NULL, '5ffe85f3-67d9-4ee2-8f0a-65ebd6a3864c', 'PAST_PAPER', true, 1, '2026-09-13 12:56:56.010697+00', '932864e6-ca20-4a3b-814d-6d83d9485dad');
INSERT INTO public.questions VALUES ('6224524e-0a88-48f3-991b-18e39ddf0450', 'q04-1a97e8dd', 'STRUCTURED', 'A student investigates electrolysis using this apparatus.', 6, 3, 540, NULL, '017d63f7-35f8-48c4-9ae9-8ba9f9dfe927', 'PAST_PAPER', true, 1, '2026-09-13 12:59:55.964234+00', 'a431a8e6-721f-4882-bdc5-3e2ba6251300');
INSERT INTO public.questions VALUES ('25744624-34db-40e5-a3db-0dc0a896da96', 'q01-421db8f1', 'STRUCTURED', 'Bromine is an element in Group 7 of the Periodic Table.', 5, 3, 450, NULL, '79944260-15f1-4d9d-bc83-d61c3716963e', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.128011+00', '8c73030d-9403-4b20-9249-dd7626dd23f2');
INSERT INTO public.questions VALUES ('707160df-a397-4156-83ce-1811d4df0ad1', 'q01-0953f0b3', 'STRUCTURED', 'Rock salt is a mixture of salt and sand. Crystals of pure salt can be obtained from rock salt by using the method below. Use words from the box to complete the sentences. You may use each word once, more than once or not at all. crystals dissolve evaporate filter solution solvent Grind the rock salt into a fine powder. Add the powder to hot water and stir to ... the salt. Filter the mixture. The salt passes through the filter paper leaving behind the sand. Boil the filtrate to ... some of the water. Leave the saturated solution to cool so that ... of salt form. Finally, the cold mixture to separate the crystals from the remaining solution.', 5, 3, 450, NULL, '3781a599-2c36-42ec-87d4-3f62ab3a7ab1', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.78348+00', 'f1aa732a-1202-44be-a791-fb2a652cfdee');
INSERT INTO public.questions VALUES ('927751be-5925-40f9-8372-91a6c2e65929', 'q04-0953f0b3', 'STRUCTURED', 'This is a description of how the orange colouring can be extracted from rose petals. crush the petals using a pestle and mortar add the crushed petals to some ethanol in a beaker heat to about $ 6 0^{\circ} \mathrm{C} $ and stir to produce an orange solution separate the orange solution from the petals', 1, 3, 90, NULL, '3781a599-2c36-42ec-87d4-3f62ab3a7ab1', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.787208+00', 'f1aa732a-1202-44be-a791-fb2a652cfdee');
INSERT INTO public.questions VALUES ('14dd8317-cee1-4510-9f95-7cb912e8c095', 'q05-0953f0b3', 'STRUCTURED', 'This apparatus can be used to make and collect carbon dioxide. This is done by adding dilute hydrochloric acid to calcium carbonate.', 7, 3, 630, NULL, '3781a599-2c36-42ec-87d4-3f62ab3a7ab1', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.787541+00', 'f1aa732a-1202-44be-a791-fb2a652cfdee');
INSERT INTO public.questions VALUES ('d99e37b4-0d42-49d4-8b13-e35094df40f5', 'q06-0953f0b3', 'STRUCTURED', 'The table gives some data about the first six members of a homologous series of compounds called the alkanes.', 12, 3, 1080, NULL, '3781a599-2c36-42ec-87d4-3f62ab3a7ab1', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.788219+00', 'f1aa732a-1202-44be-a791-fb2a652cfdee');
INSERT INTO public.questions VALUES ('2c64c6b8-30b2-4258-972a-46121bf7b1e5', 'q07-0953f0b3', 'STRUCTURED', 'Distress flares are used to attract attention in an emergency. The flares contain magnesium, which burns with a bright, white flame to form magnesium oxide.', 9, 3, 810, NULL, '3781a599-2c36-42ec-87d4-3f62ab3a7ab1', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.790666+00', 'f1aa732a-1202-44be-a791-fb2a652cfdee');
INSERT INTO public.questions VALUES ('cb465d4f-b04c-4e6c-9906-99154794fd17', 'q08-0953f0b3', 'STRUCTURED', 'The table gives information about the first three elements in Group 1 of the Periodic Table.', 14, 3, 1260, NULL, '3781a599-2c36-42ec-87d4-3f62ab3a7ab1', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.791097+00', 'f1aa732a-1202-44be-a791-fb2a652cfdee');
INSERT INTO public.questions VALUES ('80a22f9c-83a4-464d-ab77-c8224aa42282', 'q09-0953f0b3', 'STRUCTURED', 'A student investigates how temperature affects the rate of reaction between two colourless solutions containing ions. When he mixes the solutions, a reaction takes place between the ions and after a while the mixture suddenly turns blue. He performs the experiment at five different temperatures and on each occasion he measures the time taken for the mixture to turn blue. The table shows his results.', 9, 3, 810, NULL, '3781a599-2c36-42ec-87d4-3f62ab3a7ab1', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.791357+00', 'f1aa732a-1202-44be-a791-fb2a652cfdee');
INSERT INTO public.questions VALUES ('8f679044-c5c5-4e2a-945e-244c3f227126', 'q10-0953f0b3', 'STRUCTURED', 'A student investigates the reaction between dilute hydrochloric acid and marble chips. She uses this method. put 50 $ cm^{3} $ of dilute hydrochloric acid into a polystyrene cup measure the initial temperature of the acid add 5.0 g of marble chips to the acid and stir the mixture measure the temperature of the mixture after 2 minutes She carries out the experiment three times, using different sizes of marble chips each time. The diagram shows the temperatures for each experiment. Experiment 1 large marble chips Experiment 2 medium marble chips Experiment 3 small marble chips', 7, 3, 630, NULL, '3781a599-2c36-42ec-87d4-3f62ab3a7ab1', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.792188+00', 'f1aa732a-1202-44be-a791-fb2a652cfdee');
INSERT INTO public.questions VALUES ('4a7cd912-77f3-4ebb-b83a-356c75300204', 'q11-0953f0b3', 'STRUCTURED', 'Titanium is extracted from its main ore, rutile, in a three-stage process. Stage1 Rutile is heated with chlorine and coke (carbon) at a temperature of about $ 9 0 0^{\circ} \mathrm{C} $ $\mathrm {T i O} _ {2} + 2 \mathrm {C l} _ {2} + 2 \mathrm {C} \rightarrow \mathrm {T i C l} _ {4} + 2 \mathrm {C O}$ Stage 2 $ \mathrm{T i C l}_{4} $ is then added to liquid magnesium at a temperature of about $ 8 0 0^{\circ} \mathrm{C} $ in an atmosphere of argon. $\mathrm {T i C l} _ {4} + 2 \mathrm {M g} \rightarrow \mathrm {T i} + 2 \mathrm {M g C l} _ {2}$ During the reaction the temperature rises to about $ 1 1 0 0^{\circ} \mathrm{C} $ Stage 3 The magnesium chloride is removed by distillation from the mixture formed in stage 2, leaving behind pure titanium.', 7, 3, 630, NULL, '3781a599-2c36-42ec-87d4-3f62ab3a7ab1', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.79251+00', 'f1aa732a-1202-44be-a791-fb2a652cfdee');
INSERT INTO public.questions VALUES ('66fd8a5c-65a6-4152-b1f1-e45a59720a14', 'q12-0953f0b3', 'STRUCTURED', 'Magnesium reacts with dilute hydrochloric acid. The equation for the reaction is $\mathrm {M g} (\mathrm {s}) + 2 \mathrm {H C l} (\mathrm {a q}) \rightarrow \mathrm {M g C l} _ {2} (\mathrm {a q}) + \mathrm {H} _ {2} (\mathrm {g})$', 6, 3, 540, NULL, '3781a599-2c36-42ec-87d4-3f62ab3a7ab1', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.794327+00', 'f1aa732a-1202-44be-a791-fb2a652cfdee');
INSERT INTO public.questions VALUES ('a28823a0-3db9-42a8-b7ab-5bde04e3a8e8', 'q13-0953f0b3', 'STRUCTURED', 'The diagram shows the manufacture of ammonia by the Haber process and its conversion into the fertiliser ammonium nitrate.', 9, 3, 810, NULL, '3781a599-2c36-42ec-87d4-3f62ab3a7ab1', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.794664+00', 'f1aa732a-1202-44be-a791-fb2a652cfdee');
INSERT INTO public.questions VALUES ('717cfa5b-0bfe-45f8-9d6d-494d7c5a702a', 'q02-421db8f1', 'STRUCTURED', 'Iron is a metal that has many uses. One problem with iron is that it can rust when exposed to air.', 6, 3, 540, NULL, '79944260-15f1-4d9d-bc83-d61c3716963e', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.1284+00', '8c73030d-9403-4b20-9249-dd7626dd23f2');
INSERT INTO public.questions VALUES ('68f79c30-73aa-4ee7-aebc-eedae4b4bacc', 'q03-421db8f1', 'STRUCTURED', '(a) The box shows some methods that can be used to separate mixtures. The table lists some separations. Complete the table by giving the best method for each separation. You may use each method once, more than once or not at all.', 1, 3, 90, NULL, '79944260-15f1-4d9d-bc83-d61c3716963e', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.128675+00', '8c73030d-9403-4b20-9249-dd7626dd23f2');
INSERT INTO public.questions VALUES ('980fc9a6-b0e1-4aa3-b534-e20302bb84e3', 'q04-421db8f1', 'STRUCTURED', 'The Periodic Table consists of elements arranged in order of increasing atomic number.', 5, 3, 450, NULL, '79944260-15f1-4d9d-bc83-d61c3716963e', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.128921+00', '8c73030d-9403-4b20-9249-dd7626dd23f2');
INSERT INTO public.questions VALUES ('05264118-d612-4a75-8595-32d5c1e152ef', 'q12-421db8f1', 'STRUCTURED', 'A student is given a mixture of two solid ionic compounds, A and B. Each solid contains one cation and one anion. Compound A is insoluble in water. Compound B is soluble in water.', 9, 3, 810, NULL, '79944260-15f1-4d9d-bc83-d61c3716963e', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.15184+00', '8c73030d-9403-4b20-9249-dd7626dd23f2');
INSERT INTO public.questions VALUES ('c2dffa08-e04f-4a43-881b-c55f84d989fd', 'q06-0c94e0a6', 'STRUCTURED', 'A student investigates the rate of the reaction between magnesium ribbon and dilute hydrochloric acid. The products are magnesium chloride and hydrogen.', 1, 3, 90, NULL, '6f6dcde5-b0f9-4081-8cad-3751870bcc51', 'PAST_PAPER', true, 1, '2026-09-13 12:54:39.655095+00', 'f3355321-ea12-48e9-af55-484a9b136cdf');
INSERT INTO public.questions VALUES ('e67c9e47-9b8c-47ea-a3bd-e19a1a539064', 'q07-0c94e0a6', 'STRUCTURED', 'In the Periodic Table, the vertical columns of elements are called groups.', 14, 3, 1260, NULL, '6f6dcde5-b0f9-4081-8cad-3751870bcc51', 'PAST_PAPER', true, 1, '2026-09-13 12:54:39.655455+00', 'f3355321-ea12-48e9-af55-484a9b136cdf');
INSERT INTO public.questions VALUES ('b491d7a4-1cbc-493c-8a7f-44456cd4453f', 'q08-0c94e0a6', 'STRUCTURED', 'The table shows information about the effect of adding sodium hydroxide solution to solutions containing zinc ions, calcium ions or aluminium ions.', 15, 3, 1350, NULL, '6f6dcde5-b0f9-4081-8cad-3751870bcc51', 'PAST_PAPER', true, 1, '2026-09-13 12:54:39.655838+00', 'f3355321-ea12-48e9-af55-484a9b136cdf');
INSERT INTO public.questions VALUES ('4d4cccc8-b179-4ed0-afba-c7b6dd5e6ee8', 'q10-0c94e0a6', 'STRUCTURED', 'A student does a titration to find the concentration of a solution of aqueous ammonia. He uses this method. use a pipette to add 25.0 $ cm^{3} $ samples of the solution into a conical flask add a few drops of indicator add sulfuric acid from a burette until the indicator changes colour permanently repeat the titration three more times', 13, 3, 1170, NULL, '6f6dcde5-b0f9-4081-8cad-3751870bcc51', 'PAST_PAPER', true, 1, '2026-09-13 12:54:39.656793+00', 'f3355321-ea12-48e9-af55-484a9b136cdf');
INSERT INTO public.questions VALUES ('17b5ab5d-dc23-4019-94a1-b18568bec7fe', 'q14-0953f0b3', 'STRUCTURED', 'Carbon monoxide and hydrogen are used in the manufacture of methanol （ $ \mathrm{C H_{3} O H} $ ）. The reaction is reversible and can reach a position of dynamic equilibrium. $\mathrm {C O (g)} + 2 \mathrm {H} _ {2} (\mathrm {g}) \rightleftharpoons \mathrm {C H} _ {3} \mathrm {O H} (\mathrm {g}) \quad \Delta H = - 9 1 \mathrm {k J / m o l}$ The reaction is carried out at a pressure of about 100 atmospheres and a temperature of $ 2 5 0^{\circ} \mathrm{C} $', 14, 3, 1260, NULL, '3781a599-2c36-42ec-87d4-3f62ab3a7ab1', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.794948+00', 'f1aa732a-1202-44be-a791-fb2a652cfdee');
INSERT INTO public.questions VALUES ('70573247-6d03-4999-a906-c5096c855610', 'q05-421db8f1', 'STRUCTURED', 'A student uses this apparatus to investigate the rate of reaction between an excess of magnesium and two different dilute acids, X and Y. This is the method given to the student. place 0.5g of magnesium ribbon into the conical flask use a measuring cylinder to add $ 5 0 \mathrm{c m}^{3} $ of dilute acid X and then replace the bung record the total volume of gas collected every 20 seconds for two minutes repeat the method using $ 5 0 \mathrm{c m}^{3} $ of dilute acid Y instead of dilute acid X in each experiment, keep the temperature the same and the magnesium in excess', 12, 3, 1080, NULL, '79944260-15f1-4d9d-bc83-d61c3716963e', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.129138+00', '8c73030d-9403-4b20-9249-dd7626dd23f2');
INSERT INTO public.questions VALUES ('eedf78d7-460d-4c8c-8318-f57db8b82e2b', 'q06-421db8f1', 'STRUCTURED', 'Copper and iron are metals. They have the typical properties of metals, including a high melting point and good electrical conductivity.', 15, 3, 1350, NULL, '79944260-15f1-4d9d-bc83-d61c3716963e', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.129367+00', '8c73030d-9403-4b20-9249-dd7626dd23f2');
INSERT INTO public.questions VALUES ('8aa5dc71-b188-4310-8ce4-649324d840b6', 'q07-421db8f1', 'STRUCTURED', 'The diagram shows how a student attempts to prepare some hydrogen gas.', 6, 3, 540, NULL, '79944260-15f1-4d9d-bc83-d61c3716963e', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.129606+00', '8c73030d-9403-4b20-9249-dd7626dd23f2');
INSERT INTO public.questions VALUES ('1f8ffd9b-8fb0-4c61-8995-78c387b98803', 'q08-421db8f1', 'STRUCTURED', 'When iodine reacts with an excess of chlorine at $ - 8 0^{\circ} \mathrm{C} $ , a compound forms. The percentage composition by mass of this compound is $\mathrm {I} = 5 4. 4 \% \quad \mathrm {C I} = 4 5. 6 \%$', 6, 3, 540, NULL, '79944260-15f1-4d9d-bc83-d61c3716963e', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.129863+00', '8c73030d-9403-4b20-9249-dd7626dd23f2');
INSERT INTO public.questions VALUES ('b2efdb0f-3532-4a10-b96e-f3b410a2b929', 'q09-421db8f1', 'STRUCTURED', 'Bromine, chlorine and iodine are halogens in Group 7 of the Periodic Table. The three halogens have similar chemical properties but different reactivities.', 1, 3, 90, NULL, '79944260-15f1-4d9d-bc83-d61c3716963e', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.130117+00', '8c73030d-9403-4b20-9249-dd7626dd23f2');
INSERT INTO public.questions VALUES ('45b88cda-4589-48a3-9d94-1578438c6807', 'q10-421db8f1', 'STRUCTURED', 'A student uses this apparatus to find the mass of magnesium oxide that forms when a strip of magnesium ribbon is burned in air. This is the student''s method. weigh an empty crucible and lid place a coiled strip of freshly cleaned magnesium ribbon in the crucible weigh the crucible, lid and ribbon heat the crucible strongly for several minutes, lifting the lid and quickly replacing it several times leave the crucible, lid and contents to cool and then reweigh', 7, 3, 630, NULL, '79944260-15f1-4d9d-bc83-d61c3716963e', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.130369+00', '8c73030d-9403-4b20-9249-dd7626dd23f2');
INSERT INTO public.questions VALUES ('b481680c-6bb7-423d-863d-b8471b5bd912', 'q11-421db8f1', 'STRUCTURED', 'The alkanes are a homologous series of hydrocarbons. The cycloalkanes are another homologous series of hydrocarbons, where the carbon atoms are arranged in a ring structure. Cyclopropane is the simplest cycloalkane. It can be represented as The tables give the names and molecular formulae of the first three members of each series.', 1, 3, 90, NULL, '79944260-15f1-4d9d-bc83-d61c3716963e', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.151211+00', '8c73030d-9403-4b20-9249-dd7626dd23f2');
INSERT INTO public.questions VALUES ('34e99eda-e25a-481f-81a0-3a57ac37fd87', 'q13-421db8f1', 'STRUCTURED', 'This apparatus can be used to find the volume of dilute sulfuric acid needed to neutralise 25.0 $ cm^{3} $ of aqueous sodium hydroxide, NaOH.', 7, 3, 630, NULL, '79944260-15f1-4d9d-bc83-d61c3716963e', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.152152+00', '8c73030d-9403-4b20-9249-dd7626dd23f2');
