INSERT INTO public.question_versions VALUES ('7da572d4-dcf3-4d60-9e69-d799859755c3', '784b54f4-abd0-468f-bb13-b52a787edcbc', 1, 'Phosgene $ \left( \mathrm{C O C I}_{2} \right) $ is used in industry to make polymers.', 1, 3, 90, NULL, 'SUGGESTED', '8d262f6a-ad65-5742-8487-0ce90a11e77c', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:40.257214+00');
INSERT INTO public.question_versions VALUES ('b439af0d-d6c5-48b0-beb6-ca20a140dbf2', 'b4e155b7-06d0-4549-8c44-a2ce9ceb54ec', 1, 'Compounds containing C=C double bonds are used to manufacture alcohols such as ethanol and addition polymers such as PVC. The table shows the formulae of some compounds containing C=C bonds.', 1, 3, 90, NULL, 'SUGGESTED', '8d0a429e-bbff-5d24-aff9-17ce1f25d16f', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:56.383895+00');
