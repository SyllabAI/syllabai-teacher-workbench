INSERT INTO public.question_parts VALUES ('a1dd030c-f030-485e-ad45-17e6eec7420c', '0ce31f2b-736b-4285-91d0-7d4883054942', 'b-ii', 'Explain how sodium metal forms at the negative electrode.', NULL, 0, 3, '2026-09-13 13:03:38.158269+00');
INSERT INTO public.question_parts VALUES ('359e03bd-d35d-45f7-aea1-a01f6e50d332', '0ce31f2b-736b-4285-91d0-7d4883054942', 'b-iii', 'Write an ionic half-equation for the formation of chlorine gas at the positive electrode.', NULL, 0, 4, '2026-09-13 13:03:38.158319+00');
INSERT INTO public.question_parts VALUES ('5bcf0056-961b-414c-9f47-b5abb330941e', '0ce31f2b-736b-4285-91d0-7d4883054942', 'b-iv', 'Give a reason why sodium metal does not form in the electrolysis of an aqueous solution of sodium chloride.', NULL, 0, 5, '2026-09-13 13:03:38.158367+00');
INSERT INTO public.question_parts VALUES ('c8c6b0e0-fd6b-4457-b56d-be34a46157ad', '0ce31f2b-736b-4285-91d0-7d4883054942', 'c', 'Copper can be produced by reacting an oxide of copper with methane. The diagram shows the apparatus used. The oxide of copper is heated until the reaction is complete. The table shows the results. Use the results to show that this oxide has the empirical formula CuO [for Cu, $ A_{\mathrm{r}}=6 3. 5 $ for O, $ A_{\mathrm{r}}=1 6 $]', NULL, 3, 6, '2026-09-13 13:03:38.158422+00');
INSERT INTO public.question_parts VALUES ('f159cd0f-1f41-4e75-bd35-f24fdf8099c4', 'c2626813-28d9-4361-b5b2-8c3f5b9d5ba1', 'a', 'Draw a circle around the functional group in ethanoic acid.', NULL, 0, 0, '2026-09-13 13:03:38.158468+00');
INSERT INTO public.question_parts VALUES ('0c4b050a-6b69-4556-8b8b-30a47131c43a', 'c2626813-28d9-4361-b5b2-8c3f5b9d5ba1', 'a-ii', 'Give the displayed formula of ester A.', NULL, 0, 1, '2026-09-13 13:03:38.158515+00');
INSERT INTO public.question_parts VALUES ('c1a5cf22-8216-43c1-a7b9-3af4829a2cf0', 'c2626813-28d9-4361-b5b2-8c3f5b9d5ba1', 'a-iii', 'Name ester A.', NULL, 0, 2, '2026-09-13 13:03:38.158572+00');
INSERT INTO public.question_parts VALUES ('0596e5b6-a68f-4987-9898-ca97bce5f120', 'c2626813-28d9-4361-b5b2-8c3f5b9d5ba1', 'b', 'The reaction mixture is kept in a sealed container until dynamic equilibrium is reached. State what is meant by the term dynamic equilibrium.', NULL, 0, 3, '2026-09-13 13:03:38.15862+00');
INSERT INTO public.question_parts VALUES ('d9c21cac-b758-493d-8e8d-391db909380f', 'c2626813-28d9-4361-b5b2-8c3f5b9d5ba1', 'c', 'During the reaction, the number of moles of ethanoic acid in the reaction mixture decreases, but the number of moles of concentrated sulfuric acid does not change.', NULL, 0, 4, '2026-09-13 13:03:38.158668+00');
INSERT INTO public.question_parts VALUES ('da9bbcf4-9996-481e-ac21-4c909620c21b', 'c2626813-28d9-4361-b5b2-8c3f5b9d5ba1', 'c-i', 'Give a reason why the number of moles of concentrated sulfuric acid does not change.', NULL, 0, 5, '2026-09-13 13:03:38.158716+00');
INSERT INTO public.question_parts VALUES ('1f9469ab-c1cd-4209-bfdd-f1749005b412', 'c2626813-28d9-4361-b5b2-8c3f5b9d5ba1', 'c-ii', 'A student does a titration to find the accurate volume of sodium hydroxide solution needed for complete neutralisation. The student starts by using a pipette to transfer $ 2 5. 0 \mathrm{c m}^{3} $ of the reaction mixture to a conical flask. Describe how the student should complete the titration.', NULL, 0, 6, '2026-09-13 13:03:38.158763+00');
INSERT INTO public.question_parts VALUES ('8400d999-7baa-4d42-bd6d-13e173dd9697', 'c525c306-3775-4836-b711-cba540bbcb43', 'a', 'This is the displayed formula for a molecule of hydrazine. Complete the dot-and-cross diagram for hydrazine.', NULL, 0, 0, '2026-09-13 13:03:38.158823+00');
INSERT INTO public.question_parts VALUES ('d3c368d9-b6d2-4cb6-90a2-e126e3c203ec', 'c525c306-3775-4836-b711-cba540bbcb43', 'b', 'This is the equation for the decomposition of hydrazine. $3 \mathrm {N} _ {2} \mathrm {H} _ {4} (\mathrm {g}) \rightarrow 4 \mathrm {N H} _ {3} (\mathrm {g}) + \mathrm {N} _ {2} (\mathrm {g})$ The equation can be shown using displayed formulae. The table gives the relevant bond energies.', NULL, 0, 1, '2026-09-13 13:03:38.158873+00');
INSERT INTO public.question_parts VALUES ('06c39fbd-598a-40ba-8f24-a23d8e238cef', 'c525c306-3775-4836-b711-cba540bbcb43', 'b-i', 'Use the data in the table to calculate the total energy needed to break all the bonds in the reactants.', NULL, 0, 2, '2026-09-13 13:03:38.158923+00');
INSERT INTO public.question_parts VALUES ('8b2dcc8d-c891-46da-8431-fd40def0d695', 'c525c306-3775-4836-b711-cba540bbcb43', 'b-ii', 'Use the data in the table to calculate the total energy released when all the bonds in the products are made.', NULL, 0, 3, '2026-09-13 13:03:38.158956+00');
INSERT INTO public.question_parts VALUES ('487ebd96-3d54-444d-b3f2-8b87b0cef41d', 'c525c306-3775-4836-b711-cba540bbcb43', 'b-iii', 'Calculate the enthalpy change, $ \Delta H $ , in kJ/mol, for the reaction.', NULL, 0, 4, '2026-09-13 13:03:38.159004+00');
INSERT INTO public.question_parts VALUES ('4f54afef-4148-44b0-8fe0-51047546d4f1', 'c525c306-3775-4836-b711-cba540bbcb43', 'b-iv', 'Explain, in terms of bonds broken and bonds made, why this reaction is exothermic.', NULL, 0, 5, '2026-09-13 13:03:38.159053+00');
INSERT INTO public.question_parts VALUES ('4e716c07-7543-44dc-952a-f42ed5f24cff', 'c525c306-3775-4836-b711-cba540bbcb43', 'c', 'A sample of hydrazine is completely decomposed. This is the equation for the decomposition of hydrazine. $3 \mathrm {N} _ {2} \mathrm {H} _ {4} (\mathrm {g}) \rightarrow 4 \mathrm {N H} _ {3} (\mathrm {g}) + \mathrm {N} _ {2} (\mathrm {g})$ The products of the decomposition are bubbled through $ 1 1 0 0 \mathrm{c m}^{3} $ of water. The ammonia completely dissolves in the water, but nitrogen is insoluble in water. The nitrogen has a volume of $ 1 5 7 0 \mathrm{c m}^{3} $ at room temperature and pressure (rtp). Calculate the concentration, in mol/dm $ ^{3} $ , of the ammonia solution. Give your answer to 3 significant figures. [for a gas at rtp,molar volume = 24000 $ cm^{3} $]', NULL, 0, 6, '2026-09-13 13:03:38.159111+00');
INSERT INTO public.question_parts VALUES ('c4ae785b-f05b-437d-b358-51cd22c1b4da', '7c21322a-4eda-4f6c-ae76-d53d1f84aeed', 'a', 'Give the pH value of a neutral solution.', NULL, 0, 0, '2026-09-13 13:03:38.362875+00');
INSERT INTO public.question_parts VALUES ('935140c4-3d2c-4ea0-bcac-b2f5b3833d0f', '7c21322a-4eda-4f6c-ae76-d53d1f84aeed', 'b', 'Give a pH value of a weakly acidic solution.', NULL, 0, 1, '2026-09-13 13:03:38.362984+00');
INSERT INTO public.question_parts VALUES ('747edfa6-bfc5-434c-8eb1-2bfbc691900f', '7c21322a-4eda-4f6c-ae76-d53d1f84aeed', 'c', 'Give the number of the Group in the Periodic Table that contains the elements that do not readily react.', NULL, 0, 2, '2026-09-13 13:03:38.363023+00');
INSERT INTO public.question_parts VALUES ('70463e76-d236-4baa-8efd-789f98aba974', '7c21322a-4eda-4f6c-ae76-d53d1f84aeed', 'd', 'Give the number of different elements present in glucose, $ \mathrm{C_{6} H_{1 2} O_{6}} $', NULL, 0, 3, '2026-09-13 13:03:38.363057+00');
INSERT INTO public.question_parts VALUES ('bb523df2-8347-4cbb-aa63-a4bdffb47655', '93746156-51b4-4d80-bc65-21bfa9a6283e', 'a', 'State one other factor that affects the solubility.', NULL, 0, 0, '2026-09-13 13:03:38.363101+00');
INSERT INTO public.question_parts VALUES ('bfc2cafc-99b8-4941-95a5-e4c18996f7f3', '93746156-51b4-4d80-bc65-21bfa9a6283e', 'b', 'A student wants to find the solubility of a salt in water. The steps in the student''s method are not in the correct order. Step A gently heat the evaporating basin and solution to remove all the water Step B filter to obtain $ 5 0. 0 \mathrm{c m}^{3} $ of saturated solution Step C record the mass of the evaporating basin and salt solution Step D record the mass of an empty evaporating basin Step E record the mass of the evaporating basin and the dry salt Step F put $ 5 0. 0 \mathrm{c m}^{3} $ of water into a beaker Step G add the salt to the water a little at a time and stir until no more dissolves Step H pour the $ 5 0. 0 \mathrm{c m}^{3} $ of saturated salt solution into the evaporating basin', NULL, 0, 1, '2026-09-13 13:03:38.363152+00');
INSERT INTO public.question_parts VALUES ('155f07db-0536-4c0c-8f9a-450dc54d9394', '93746156-51b4-4d80-bc65-21bfa9a6283e', 'b-i', 'The flowchart shows the correct order of some of the steps. Complete the flowchart by putting the remaining steps in the correct order.', NULL, 2, 2, '2026-09-13 13:03:38.363184+00');
INSERT INTO public.question_parts VALUES ('612a9e86-2d92-428f-93f5-6d11528c3407', '6ec4fcd0-a3b0-4ec0-974b-60f2e0036a60', 'a', 'Calculate the heat energy, in kJ/mol, produced by the fuel. You should assume that the fuel is pure carbon. Give your answer to three significant figures. [for carbon, $ A_{\mathrm{r}}=1 2 $]', NULL, 0, 0, '2026-09-13 13:03:38.363231+00');
INSERT INTO public.question_parts VALUES ('53eef693-e29c-482e-83db-ed107caa606e', '6ec4fcd0-a3b0-4ec0-974b-60f2e0036a60', 'b', 'The fuel actually contains some impurities, including sulfur. There is 600g of sulfur in 20kg of fuel.', NULL, 0, 1, '2026-09-13 13:03:38.363305+00');
INSERT INTO public.question_parts VALUES ('fdf3b586-ce86-4875-a603-7312c14d7849', '6ec4fcd0-a3b0-4ec0-974b-60f2e0036a60', 'b-i', 'Calculate the percentage of sulfur in the fuel.', NULL, 0, 2, '2026-09-13 13:03:38.363347+00');
INSERT INTO public.question_parts VALUES ('091db210-0537-4b22-baf0-14ddf2b698c2', '6ec4fcd0-a3b0-4ec0-974b-60f2e0036a60', 'b-ii', 'When the fuel burns,the 600g of sulfur produces sulfur dioxide gas. $S + O _ {2} \rightarrow S O _ {2}$ Calculate the volume, in $ cm^{3} $ , of sulfur dioxide gas that would be produced at room temperature and pressure (rtp) when the fuel burns. [for a gas, molar volume = 24 dm $ ^{3} $ at rtp]', NULL, 0, 3, '2026-09-13 13:03:38.363384+00');
INSERT INTO public.question_parts VALUES ('3ed885eb-9067-494d-946f-ba1dc9c3b790', '6ec4fcd0-a3b0-4ec0-974b-60f2e0036a60', 'b-iii', 'State the name of the environmental problem caused by sulfur dioxide in the atmosphere.', NULL, 0, 4, '2026-09-13 13:03:38.363414+00');
INSERT INTO public.question_parts VALUES ('05579cf7-2351-41b1-b09c-51a7d02984b1', '69ea7972-11c5-4374-847f-406839bff30d', 'b', 'Diols and dicarboxylic acids react together in polymerisation reactions to form polyesters.', NULL, 0, 0, '2026-09-13 13:03:38.363453+00');
