INSERT INTO public.question_versions VALUES ('2f786e0c-d9de-4226-994f-5e74fd055ec5', 'bedf25fe-2239-489a-b32f-f3eb7b07f8b3', 1, 'Fractional distillation and cracking are important steps in processing crude oil.', 1, 3, 90, NULL, 'SUGGESTED', '2c4bb314-2c6d-521b-afde-836cb2da220c', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.491225+00');
INSERT INTO public.question_versions VALUES ('41617f11-2a6b-4568-9443-30e5fce0c4de', '8decd1d0-ac59-4e58-912c-944e53569fb3', 1, 'Most experiments involving electrolysis use inert electrodes, which do not take part in the reactions. However, in some experiments the electrodes do take part in the reactions. She uses this method. weigh two clean strips of copper use one strip as the positive electrode and the other as the negative electrode after electrolysis wash the strips of copper with ethanol (a liquid that boils at $ 7 8^{\circ} \mathrm{C} $) dry the strips of copper and reweigh them The ionic half-equations for the reactions at the electrodes are Positive electrode $\mathrm {C u} (\mathrm {s}) - 2 \mathrm {e} ^ {-} \rightarrow \mathrm {C u} ^ {2 +} (\mathrm {a q})$ Negative electrode $\mathrm {C u} ^ {2 +} (\mathrm {a q}) + 2 \mathrm {e} ^ {-} \rightarrow \mathrm {C u} (\mathrm {s})$ A student investigates the electrolysis of copper(II) sulfate solution using copper electrodes which do take part in the reaction. She uses this apparatus.', 12, 3, 1080, NULL, 'SUGGESTED', '2c4bb314-2c6d-521b-afde-836cb2da220c', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.491561+00');
INSERT INTO public.question_versions VALUES ('750e988e-595d-4164-a922-e5e7e1fc56fe', 'f9211239-b3a6-4110-a273-e7680b4b2fef', 1, 'The table shows the numbers of particles in two atoms, L and M.', 7, 3, 630, NULL, 'SUGGESTED', '5dd67ecf-62f3-5952-aeba-f9bc11129e72', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.658095+00');
INSERT INTO public.question_versions VALUES ('daa9de13-a211-403c-bc7e-b2e479845ba7', '406faeb7-d10d-4fff-9e18-4d62068e3ea9', 1, 'Bromine, chlorine, fluorine and iodine are elements in Group 7 of the Periodic Table.', 12, 3, 1080, NULL, 'SUGGESTED', '5dd67ecf-62f3-5952-aeba-f9bc11129e72', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.658504+00');
INSERT INTO public.question_versions VALUES ('8e670d21-f866-4801-a2a1-7af304ddf0cb', '572f9bf2-9182-4295-a88b-8be106a5c880', 1, 'Tungsten is a useful metal. It has the chemical symbol W.', 1, 3, 90, NULL, 'SUGGESTED', '5dd67ecf-62f3-5952-aeba-f9bc11129e72', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.658983+00');
INSERT INTO public.question_versions VALUES ('be3bef26-9b3a-4081-bb35-d2bdd259f2df', '7a720d1a-ce55-4a2c-8516-14be4ad57fc0', 1, 'A student investigated the neutralisation of acids by measuring the temperature changes when alkalis were added to acids of known concentrations. He used this apparatus to add different volumes of sodium hydroxide solution to a fixed volume of dilute nitric acid. He used this method. measure the temperature of 25.0 $ cm^{3} $ of the acid in the polystyrene cup add the sodium hydroxide solution in 5.0 $ cm^{3} $ portions until a total of 30.0 $ cm^{3} $ has been added', 18, 3, 1620, NULL, 'SUGGESTED', '5dd67ecf-62f3-5952-aeba-f9bc11129e72', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.659281+00');
INSERT INTO public.question_versions VALUES ('2a336856-8f71-49c1-a210-da72fa44d926', '345e6637-9a2c-49e9-95ca-8f0c7828a346', 1, 'The diagram shows some important conversion processes used in the oil industry.', 13, 3, 1170, NULL, 'SUGGESTED', '5dd67ecf-62f3-5952-aeba-f9bc11129e72', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.659602+00');
INSERT INTO public.question_versions VALUES ('bff31c83-634c-456a-83ab-f4fdd3d2f3d1', 'ca8ab610-3907-42c2-b14b-f4e1f6a7ab2e', 1, 'A student investigates some food colourings, each of which is made up of one or more dyes. She produces a chromatogram using the safe colourings red (SR), blue (SB) and green (SG) and food colourings red (FR), blue (FB) and green (FG). The diagram shows her chromatogram. reference line', 3, 3, 270, NULL, 'SUGGESTED', '3815dec0-d22c-5ce3-a44d-596a7434ed70', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.81964+00');
INSERT INTO public.question_versions VALUES ('3d4280b6-10af-477c-9f31-1cb27a6974d9', 'b0fc8b78-3054-4b35-b2bc-14fa69887d26', 1, 'This apparatus is used to separate a mixture of ethanol (boiling point 78 $ ^{\circ} \mathrm{C} $) and water (boiling point 100 $ ^{\circ} \mathrm{C} $).', 4, 3, 360, NULL, 'SUGGESTED', '3815dec0-d22c-5ce3-a44d-596a7434ed70', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.819993+00');
