INSERT INTO public.question_parts VALUES ('30f5d97c-c670-4748-bedb-cb1649166523', '8649ae28-2c44-4a8c-b836-e36456c9c697', 'e', 'A student mixed together the acid and alkali to form sodium nitrate solution. She used the volumes needed for complete reaction found in the titration. She heated this solution in an evaporating basin to remove some of the water. After cooling the concentrated solution, crystals of sodium nitrate formed. What steps should she now take to obtain dry crystals of sodium nitrate?', NULL, 0, 10, '2026-09-13 12:41:17.399709+00');
INSERT INTO public.question_parts VALUES ('021eb095-9bac-459b-808d-ca93d5b61698', '8649ae28-2c44-4a8c-b836-e36456c9c697', 'f', 'Sodium nitrate decomposes when heated, as shown by the equation $2 \mathrm {N a N O} _ {3} \rightarrow 2 \mathrm {N a N O} _ {2} + \mathrm {O} _ {2}$ A 1.70 g sample of sodium nitrate $ \left( \mathrm{M_{r}}=8 5 \right) $ was completely decomposed to sodium nitrite $ \mathrm{(N a N O_{2})} $ and oxygen. Calculate the mass of sodium nitrite formed. Mass of sodium nitrite = g', NULL, 0, 11, '2026-09-13 12:41:17.399751+00');
INSERT INTO public.question_parts VALUES ('7ac01ae2-8099-4f3e-9bcc-23df3258c75d', '144d3bfd-a94a-4e59-8e32-f35f282247d3', 'a', 'Explain, in terms of the energy changes involved in breaking and making bonds, why this reaction gives out heat.', NULL, 0, 0, '2026-09-13 12:41:17.399811+00');
