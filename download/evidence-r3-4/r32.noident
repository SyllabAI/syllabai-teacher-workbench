INSERT INTO public.question_parts VALUES ('97db3017-1108-421b-a18d-b4477e702ebe', 'd6cc8981-1ea2-42f3-b873-87d0a8eab2d6', 'd-i', 'Calculate the energy change, Q, in joules for this reaction. [mass of $ 1. 0 \mathrm{c m}^{3} $ of mixture $ = 1. 0 \mathrm{g} $] [for the mixture, c=4.2 J/g/ $ ^{\circ} \mathrm{C} $]', NULL, 0, 7, '2026-09-13 12:55:24.086352+00');
