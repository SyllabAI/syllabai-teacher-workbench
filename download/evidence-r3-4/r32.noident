"e000084", "e000086", "e000087", "e000088", "e000089"], "pageNumber": 1}, {"level": 2, "title": "BLANK PAGE", "sectionId": "s007", "elementIds": ["e000091", "e000092", "e000094", "e000095", "e000096", "e000097", "e000098", "e000099", "e000100", "e000101", "e000102", "e000104", "e000105", "e000107", "e000108", "e000110", "e000111", "e000112", "e000113"], "pageNumber": 1}, {"level": 2, "title": "BLANK PAGE", "sectionId": "s008", "elementIds": ["e000115", "e000116", "e000118", "e000119", "e000120", "e000121", "e000122", "e000123", "e000125", "e000126", "e000127", "e000128", "e000129", "e000130", "e000131", "e000132", "e000134", "e000135", "e000136", "e000137", "e000139", "e000141", "e000142", "e000143", "e000144", "e000145", "e000146", "e000148", "e000149", "e000150", "e000151", "e000152"], "pageNumber": 1}, {"level": 2, "title": "BLANK PAGE", "sectionId": "s009", "elementIds": [], "pageNumber": 1}, {"level": 2, "title": "BLANK PAGE", "sectionId": "s010", "elementIds": [], "pageNumber": 1}, {"level": 2, "title": "BLANK PAGE", "sectionId": "s011", "elementIds": [], "pageNumber": 1}], "equations": [{"text": "\\mathrm {M g (s)} + \\mathrm {O} _ {2} (\\mathrm {)} \\rightarrow \\mathrm {M g O} (\\mathrm {})", "latex": "\\mathrm {M g (s)} + \\mathrm {O} _ {2} (\\mathrm {)} \\rightarrow \\mathrm {M g O} (\\mathrm {})", "confidence": 1.0, "element_id": "e000068", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 68, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {M g} (\\mathrm {s}) + 2 \\mathrm {H C l} (\\mathrm {a q}) \\rightarrow \\mathrm {M g C l} _ {2} (\\mathrm {a q}) + \\mathrm {H} _ {2} (\\mathrm {g})", "latex": "\\mathrm {M g} (\\mathrm {s}) + 2 \\mathrm {H C l} (\\mathrm {a q}) \\rightarrow \\mathrm {M g C l} _ {2} (\\mathrm {a q}) + \\mathrm {H} _ {2} (\\mathrm {g})", "confidence": 1.0, "element_id": "e000076", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 76, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {C} _ {6} \\mathrm {H} _ {1 2} \\mathrm {O} _ {6} \\rightarrow 2 \\mathrm {C} _ {2} \\mathrm {H} _ {5} \\mathrm {O H} + 2.", "latex": "\\mathrm {C} _ {6} \\mathrm {H} _ {1 2} \\mathrm {O} _ {6} \\rightarrow 2 \\mathrm {C} _ {2} \\mathrm {H} _ {5} \\mathrm {O H} + 2.", "confidence": 1.0, "element_id": "e000085", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 85, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {N a O H} (\\mathrm {a q}) + \\mathrm {N a H S O} _ {4} (\\mathrm {a q}) \\rightarrow \\mathrm {N a} _ {2} \\mathrm {S O} _ {4} (\\mathrm {a q}) + \\mathrm {H} _ {2} \\mathrm {O} (\\mathrm {I})", "latex": "\\mathrm {N a O H} (\\mathrm {a q}) + \\mathrm {N a H S O} _ {4} (\\mathrm {a q}) \\rightarrow \\mathrm {N a} _ {2} \\mathrm {S O} _ {4} (\\mathrm {a q}) + \\mathrm {H} _ {2} \\mathrm {O} (\\mathrm {I})", "confidence": 1.0, "element_id": "e000093", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 93, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {N a} _ {2} \\mathrm {S O} _ {4}. \\mathrm {x H} _ {2} \\mathrm {O} \\rightarrow \\mathrm {N a} _ {2} \\mathrm {S O} _ {4} + \\mathrm {x H} _ {2} \\mathrm {O}", "latex": "\\mathrm {N a} _ {2} \\mathrm {S O} _ {4}. \\mathrm {x H} _ {2} \\mathrm {O} \\rightarrow \\mathrm {N a} _ {2} \\mathrm {S O} _ {4} + \\mathrm {x H} _ {2} \\mathrm {O}", "confidence": 1.0, "element_id": "e000103", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 103, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {C} _ {2} \\mathrm {H} _ {4} (\\mathrm {g}) + \\mathrm {H} _ {2} \\mathrm {O} (\\mathrm {g}) \\rightleftharpoons \\mathrm {C} _ {2} \\mathrm {H} _ {5} \\mathrm {O H} (\\mathrm {g})", "latex": "\\mathrm {C} _ {2} \\mathrm {H} _ {4} (\\mathrm {g}) + \\mathrm {H} _ {2} \\mathrm {O} (\\mathrm {g}) \\rightleftharpoons \\mathrm {C} _ {2} \\mathrm {H} _ {5} \\mathrm {O H} (\\mathrm {g})", "confidence": 1.0, "element_id": "e000133", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 133, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "pageCount": 1, "documentId": "3745aeee-bf69-597d-8e80-5683f6dea0b1", "provenance": {"engine": "glm-ocr-markdown", "application": "syllabai-parser", "extractedAt": "2026-09-13T13:04:02.168344277Z", "engineVersion": "1.1.0", "schemaVersion": "1.0", "extractionParams": {"pageBoundaries": "none-in-source", "sourceLineCount": 192, "upstreamConverter": "zai-glm-ocr", "entityDecodedLines": 0, "signedUrlFigureRefs": 0, "normalizedHtmlEntities": true}}, "textBlocks": [{"role": "heading", "text": "Instructions", "confidence": 1.0, "element_id": "e000001", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 1, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Use black ink or ball-point pen.", "confidence": 1.0, "element_id": "e000002", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 2, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Fill in the boxes at the top of this page with your name, centre number and candidate number.", "confidence": 1.0, "element_id": "e000003", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 3, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer all questions.", "confidence": 1.0, "element_id": "e000004", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 4, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer the questions in the spaces provided", "confidence": 1.0, "element_id": "e000005", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 5, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "there may be more space than you need.", "confidence": 1.0, "element_id": "e000006", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 6, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Show all the steps in any calculations and state the units.", "confidence": 1.0, "element_id": "e000007", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 7, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Information", "confidence": 1.0, "element_id": "e000008", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 8, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The total mark for this paper is 70.", "confidence": 1.0, "element_id": "e000009", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 9, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The marks for each question are shown in brackets", "confidence": 1.0, "element_id": "e000010", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 10, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "use this as a guide as to how much time to spend on each question.", "confidence": 1.0, "element_id": "e000011", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 11, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Advice", "confidence": 1.0, "element_id": "e000012", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 12, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Read each question carefully before you start to answer it.", "confidence": 1.0, "element_id": "e000013", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 13, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Write your answers neatly and in good English.", "confidence": 1.0, "element_id": "e000014", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 14, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Try to answer every question.", "confidence": 1.0, "element_id": "e000015", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 15, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Check your answers if you have time at the end.", "confidence": 1.0, "element_id": "e000016", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 16, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Turn over", "confidence": 1.0, "element_id": "e000017", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 17, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The lanthanoids (atomic numbers 58-71) and the actinoids (atomic numbers 90-103) have been omitted.", "confidence": 1.0, "element_id": "e000019", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 19, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The relative atomic masses of copper and chlorine have not been rounded to the nearest whole number.", "confidence": 1.0, "element_id": "e000020", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 20, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000021", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 21, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Answer ALL questions.", "confidence": 1.0, "element_id": "e000022", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 22, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Some questions must be answered with a cross in a box. If you change your mind about an answer, put a line through the box and then mark your new answer with a cross.", "confidence": 1.0, "element_id": "e000023", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 23, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "1 This question is about sulfur.", "confidence": 1.0, "element_id": "e000024", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 24, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) The diagram represents the electronic configuration of an atom of sulfur.", "confidence": 1.0, "element_id": "e000025", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 25, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Which period of the Periodic Table contains sulfur?", "confidence": 1.0, "element_id": "e000027", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 27, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A 2", "confidence": 1.0, "element_id": "e000028", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 28, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B 3", "confidence": 1.0, "element_id": "e000029", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 29, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C 4", "confidence": 1.0, "element_id": "e000030", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 30, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D 6", "confidence": 1.0, "element_id": "e000031", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 31, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) What is the charge on a sulfide ion?", "confidence": 1.0, "element_id": "e000032", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 32, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A 1+", "confidence": 1.0, "element_id": "e000033", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 33, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B 2+", "confidence": 1.0, "element_id": "e000034", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 34, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C 1-", "confidence": 1.0, "element_id": "e000035", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 35, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D 2-", "confidence": 1.0, "element_id": "e000036", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 36, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) When a mixture of sulfur and zinc is heated to a high temperature a reaction occurs, forming the compound zinc sulfide, ZnS", "confidence": 1.0, "element_id": "e000037", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 37, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Give a reason why the mixture of sulfur and zinc needs heating before a reaction occurs.", "confidence": 1.0, "element_id": "e000038", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 38, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Calculate the relative formula mass $ ( M_{r} ) $ of zinc sulfide.", "confidence": 1.0, "element_id": "e000039", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 39, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "[for Zn, $ A_{\\mathrm{r}}=6 5 $ for S, $ A_{\\mathrm{r}}=3 2 $", "confidence": 1.0, "element_id": "e000040", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 40, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 1 = 4 marks)", "confidence": 1.0, "element_id": "e000041", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 41, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "2 (a) The diagram represents an atom of an element.", "confidence": 1.0, "element_id": "e000042", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 42, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) What is the name of the particle labelled W?", "confidence": 1.0, "element_id": "e000044", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 44, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A electron", "confidence": 1.0, "element_id": "e000045", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 45, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B ion", "confidence": 1.0, "element_id": "e000046", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 46, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C neutron", "confidence": 1.0, "element_id": "e000047", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 47, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D proton", "confidence": 1.0, "element_id": "e000048", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 48, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) What is the mass number of this atom?", "confidence": 1.0, "element_id": "e000049", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 49, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A 4", "confidence": 1.0, "element_id": "e000050", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 50, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B 5", "confidence": 1.0, "element_id": "e000051", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 51, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C 9", "confidence": 1.0, "element_id": "e000052", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 52, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D 13", "confidence": 1.0, "element_id": "e000053", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 53, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) These are the symbols for the two isotopes of lithium.", "confidence": 1.0, "element_id": "e000054", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 54, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) In terms of sub-atomic particles, give one similarity and one difference between the two isotopes.", "confidence": 1.0, "element_id": "e000055", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 55, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "$ _{3}^{6} \\mathrm{Li} $ $ _{3}^{7} \\mathrm{Li} $", "confidence": 1.0, "element_id": "e000056", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 56, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "similarity", "confidence": 1.0, "element_id": "e000057", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 57, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "difference", "confidence": 1.0, "element_id": "e000058", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 58, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) A sample of lithium contains 7.5% of $ _{3}^{6} $Li and 92.5% of $ _{3}^{7} $Li", "confidence": 1.0, "element_id": "e000059", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 59, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Calculate the relative atomic mass $ ( A_{r} ) $ of this sample of lithium.", "confidence": 1.0, "element_id": "e000060", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 60, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 2 = 6 marks)", "confidence": 1.0, "element_id": "e000061", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 61, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "3 This question is about magnesium metal and its compounds.", "confidence": 1.0, "element_id": "e000062", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 62, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) (i) The diagram represents the structure of magnesium. Complete the diagram by adding the labels.", "confidence": 1.0, "element_id": "e000063", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 63, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Explain why magnesium is malleable.", "confidence": 1.0, "element_id": "e000065", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 65, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Magnesium burns in oxygen gas to form solid magnesium oxide.", "confidence": 1.0, "element_id": "e000066", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 66, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Complete the chemical equation for the reaction by balancing the equation and adding the state symbols.", "confidence": 1.0, "element_id": "e000067", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 67, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Give a reason why magnesium is oxidised in this reaction.", "confidence": 1.0, "element_id": "e000069", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 69, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) A student uses this method to make a solution of magnesium chloride.", "confidence": 1.0, "element_id": "e000070", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 70, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 1 measure $ 2 5 \\mathrm{c m}^{3} $ of dilute hydrochloric acid into a beaker", "confidence": 1.0, "element_id": "e000071", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 71, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 2 add magnesium powder a little at a time", "confidence": 1.0, "element_id": "e000072", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 72, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 3 keep adding magnesium powder until it is in excess", "confidence": 1.0, "element_id": "e000073", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 73, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 4 remove the excess magnesium powder by filtration", "confidence": 1.0, "element_id": "e000074", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 74, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "This is the equation for the reaction.", "confidence": 1.0, "element_id": "e000075", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 75, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Give a reason why the student uses magnesium powder rather than magnesium ribbon.", "confidence": 1.0, "element_id": "e000077", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 77, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Give a reason why the student adds an excess of magnesium in step 3.", "confidence": 1.0, "element_id": "e000078", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 78, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Calculate the minimum mass of magnesium needed to react with $ 2 5. 0 \\mathrm{c m}^{3} $ of $ 2. 0 0 \\mathrm{m o l} / \\mathrm{d m}^{3} $ hydrochloric acid.", "confidence": 1.0, "element_id": "e000079", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 79, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "[for Mg, $ A_{\\mathrm{r}}=2 4 $]", "confidence": 1.0, "element_id": "e000080", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 80, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "4 This question is about the manufacture of ethanol by the fermentation of glucose.", "confidence": 1.0, "element_id": "e000081", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 81, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Fermentation needs to be done in the absence of air. Give two other conditions needed for fermentation.", "confidence": 1.0, "element_id": "e000082", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 82, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Explain why fermentation needs to be done in the absence of air.", "confidence": 1.0, "element_id": "e000083", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 83, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) (i) Complete the equation for fermentation.", "confidence": 1.0, "element_id": "e000084", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 84, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) A mixture containing 500 mol of glucose is fermented.", "confidence": 1.0, "element_id": "e000086", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 86, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A mass of 5750 g of ethanol is obtained.", "confidence": 1.0, "element_id": "e000087", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 87, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Calculate the percentage yield.", "confidence": 1.0, "element_id": "e000088", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 88, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "[for ethanol, $ M_{r}=4 6 $]", "confidence": 1.0, "element_id": "e000089", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 89, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000090", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 90, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "5 Sodium sulfate can be prepared by the reaction between sodium hydroxide solution and sodium hydrogensulfate $ \\mathrm{(N a H S O_{4})} $ solution.", "confidence": 1.0, "element_id": "e000091", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 91, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "This is the equation for the reaction.", "confidence": 1.0, "element_id": "e000092", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 92, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Sodium hydrogensulfate solution is acidic.", "confidence": 1.0, "element_id": "e000094", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 94, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A student adds $ 2 5. 0 \\mathrm{c m}^{3} $ of sodium hydroxide solution to a conical flask and adds two drops of indicator.", "confidence": 1.0, "element_id": "e000095", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 95, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The student does a titration.", "confidence": 1.0, "element_id": "e000096", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 96, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) (i) Name a piece of apparatus that should be used to add $ 2 5. 0 \\mathrm{c m}^{3} $ of sodium hydroxide solution to the conical flask.", "confidence": 1.0, "element_id": "e000097", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 97, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Describe the method the student should use to find the accurate volume of sodium hydrogensulfate solution needed to neutralise the $ 2 5. 0 \\mathrm{c m}^{3} $ of sodium hydroxide solution.", "confidence": 1.0, "element_id": "e000098", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 98, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The student repeats the titration without the indicator and forms a solution of sodium sulfate.", "confidence": 1.0, "element_id": "e000099", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 99, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Describe how the student can obtain pure, dry crystals of hydrated sodium sulfate from the solution.", "confidence": 1.0, "element_id": "e000100", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 100, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Crystals of hydrated sodium sulfate decompose when heated.", "confidence": 1.0, "element_id": "e000101", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 101, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "This is the equation for the decomposition.", "confidence": 1.0, "element_id": "e000102", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 102, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A student uses this apparatus to find the value of x.", "confidence": 1.0, "element_id": "e000104", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 104, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "hydrated sodium sulfate", "confidence": 1.0, "element_id": "e000105", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 105, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The student heats the crystals until the decomposition is complete.", "confidence": 1.0, "element_id": "e000107", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 107, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The table shows the student''s results.", "confidence": 1.0, "element_id": "e000108", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 108, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Use the results to calculate the value of x.", "confidence": 1.0, "element_id": "e000110", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 110, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "[for $ \\mathrm{N a_{2} S O_{4}} $ $ M_{\\mathrm{r}}=1 4 2 $ for $ \\mathrm{H_{2}O}, M_{\\mathrm{r}}=1 8 $", "confidence": 1.0, "element_id": "e000111", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 111, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "value of x=", "confidence": 1.0, "element_id": "e000112", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 112, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 5 = 14 marks)", "confidence": 1.0, "element_id": "e000113", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 113, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000114", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 114, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "6 This question is about electrolysis.", "confidence": 1.0, "element_id": "e000115", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 115, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) This apparatus is used to collect the gases produced when an electric current passes through dilute sulfuric acid.", "confidence": 1.0, "element_id": "e000116", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 116, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Name a suitable material for the inert electrodes.", "confidence": 1.0, "element_id": "e000118", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 118, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Give a test to show that the gas produced at the positive electrode is oxygen.", "confidence": 1.0, "element_id": "e000119", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 119, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Give a test to show that the gas produced at the negative electrode is hydrogen.", "confidence": 1.0, "element_id": "e000120", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 120, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iv) Give an ionic half-equation for the formation of hydrogen at the negative electrode.", "confidence": 1.0, "element_id": "e000121", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 121, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(v) The oxygen gas in the tube has a volume of $ 1 7. 8 \\mathrm{c m}^{3} $ at rtp. Calculate the mass, in grams, of oxygen gas in the tube. Give your answer to 3 significant figures. [for $ O_{2} $ at rtp,molar volume $ = 2 4 0 0 0 \\mathrm{c m}^{3} $]", "confidence": 1.0, "element_id": "e000122", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 122, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) This apparatus is used to electrolyse a concentrated solution of sodium chloride.", "confidence": 1.0, "element_id": "e000123", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 123, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Give a reason why sodium chloride solution conducts electricity.", "confidence": 1.0, "element_id": "e000125", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 125, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The positive ions in the solution are $ \\mathrm{H^{+}} $ and $ \\mathrm{N a^{+}}. $", "confidence": 1.0, "element_id": "e000126", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 126, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Give a reason why hydrogen forms at the negative electrode rather than sodium.", "confidence": 1.0, "element_id": "e000127", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 127, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) A sample of the solution is taken from near the negative electrode. The sample is tested with universal indicator.", "confidence": 1.0, "element_id": "e000128", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 128, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Explain the final colour of the universal indicator.", "confidence": 1.0, "element_id": "e000129", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 129, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 6 = 11 marks)", "confidence": 1.0, "element_id": "e000130", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 130, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "7 Gaseous ethanol is manufactured by reacting ethene gas with steam.", "confidence": 1.0, "element_id": "e000131", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 131, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "This is the equation for the reaction.", "confidence": 1.0, "element_id": "e000132", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 132, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) (i) The pressure on an equilibrium mixture of the three gases is decreased. All the other conditions are kept the same.", "confidence": 1.0, "element_id": "e000134", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 134, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Predict the effect of this change on the yield of ethanol at equilibrium, giving a reason for your answer.", "confidence": 1.0, "element_id": "e000135", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 135, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Predict the effect of adding a catalyst on the yield of ethanol at equilibrium, giving a reason for your answer.", "confidence": 1.0, "element_id": "e000136", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 136, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The equation shows the displayed formulae for the reactants and products.", "confidence": 1.0, "element_id": "e000137", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 137, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The table gives the bond energies.", "confidence": 1.0, "element_id": "e000139", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 139, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Using the data in the table and the equation, show that the enthalpy change, $ \\Delta H $ , is approximately $ -40\\mathrm{kJ}/\\mathrm{mol}. $", "confidence": 1.0, "element_id": "e000141", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 141, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Explain, in terms of bonds broken and bonds made, why this reaction is exothermic.", "confidence": 1.0, "element_id": "e000142", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 142, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Draw an energy level diagram for the reaction between ethene and steam.", "confidence": 1.0, "element_id": "e000143", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 143, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Label the enthalpy change, $ \\Delta H. $", "confidence": 1.0, "element_id": "e000144", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 144, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Energy", "confidence": 1.0, "element_id": "e000145", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 145, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Ethanoic acid reacts with ethanol to form ester A and water.", "confidence": 1.0, "element_id": "e000146", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 146, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "ester A", "confidence": 1.0, "element_id": "e000148", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 148, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Complete the equation by adding the displayed formula of ester A.", "confidence": 1.0, "element_id": "e000149", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 149, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Give the name of ester A.", "confidence": 1.0, "element_id": "e000150", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 150, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 7 = 15 marks)", "confidence": 1.0, "element_id": "e000151", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 151, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "TOTAL FOR PAPER = 70 MARKS", "confidence": 1.0, "element_id": "e000152", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 152, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000153", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 153, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000154", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 154, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000155", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 155, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "schemaVersion": "1.0"}', NULL, '2026-09-13 13:04:21.222451+00');
INSERT INTO public.documents VALUES ('416c739e-45be-4240-8a2e-c3c12c2d0ea0', '42d68e49-2818-5c3b-9237-89b9bb9bfbc1', '1.0', 1, 'MARK_SCHEME', 'corpus/igcse-chemistry-4ch0-2c-2024junr/MS.md', 'MS.md', 'text/markdown', 'c928be1d9da9b25d83cb32a6eb0d46323813be409dd2c13ab4f2013c0f589aeb', 'SHA-256', 1, 34, 34, 11, 'glm-ocr-markdown', '1.1.0', '2026-09-13 13:04:02.219591+00', '{"pages": [{"width": null, "height": null, "pageNumber": 1}], "source": {"uri": "corpus/igcse-chemistry-4ch0-2c-2024junr/MS.md", "checksum": "c928be1d9da9b25d83cb32a6eb0d46323813be409dd2c13ab4f2013c0f589aeb", "fileName": "MS.md", "mimeType": "text/markdown", "checksumAlgorithm": "SHA-256"}, "tables": [{"rows": [["Question number", "Answer", "Notes", "Marks"], ["1", "(a)(i)", "B(3)\nA is not the correct answer because sulfur is not in period2\nC is not the correct answer because sulfur is not in period4\nD is not the correct answer because sulfur is not in period6", "", "1"], ["(ii)", "D(2-)\nA is not the correct answer because the charge on a sulfide ion is not1+\nB is not the correct answer because the charge on a sulfide ion is not2+\nC is not the correct answer because the charge on a sulfide ion is not1-", "", "1"], ["(b)(i)", "(i)", "the reaction has a high activation energy", "ALLOW to give zinc and sulfur enough energy to react\nALLOW speeds reaction up/increases rate of reaction/reacts quicker\nALLOW the reaction is very slow at room temperature\nIGNORE unreactive/does not react\nALLOW gains kinetic energy", "1"], ["(ii)", "97", "IGNORE any units given", "1"], ["Total marks for question1=4"]], "text": "Question number | Answer | Notes | Marks\n1 | (a)(i) | B(3)\nA is not the correct answer because sulfur is not in period2\nC is not the correct answer because sulfur is not in period4\nD is not the correct answer because sulfur is not in period6 |  | 1\n(ii) | D(2-)\nA is not the correct answer because the charge on a sulfide ion is not1+\nB is not the correct answer because the charge on a sulfide ion is not2+\nC is not the correct answer because the charge on a sulfide ion is not1- |  | 1\n(b)(i) | (i) | the reaction has a high activation energy | ALLOW to give zinc and sulfur enough energy to react\nALLOW speeds reaction up/increases rate of reaction/reacts quicker\nALLOW the reaction is very slow at room temperature\nIGNORE unreactive/does not react\nALLOW gains kinetic energy | 1\n(ii) | 97 | IGNORE any units given | 1\nTotal marks for question1=4", "row_count": 6, "confidence": 1.0, "element_id": "e000022", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 22, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["2", "(a)(i)", "C(neutron)\nA is not the correct answer because electrons are not in the nucleus\nB is not the correct answer as ions are not in the nucleus\nD is not the correct answer as protons have a positive charge", "", "1"], ["(ii)", "C(9)\nA is not the correct answer because the proton number=4\nB is not the correct answer as there are 5 neutrons\nD is not the correct answer because 13 is the number of protons+neutrons+electrons", "", "1"], ["(b)(i)", "(ii)", "similarity=number of protons/proton number\ndifference=number of neutrons", "ALLOW number of electrons\nALLOW one has 3 neutrons and the other has 4 neutrons\nIGNORE reference to atomic number and mass numbers", "2"], ["M1((7.5×6)+(92.5×7))÷100\nM26.925/6.93/6.9", "ALLOW 2 or more significant figures\nAnswer 6.925/6.93/6.9 without working scores 2 marks\nAnswer of 7 with correct method scores M1\nAnswer of 7 without working scores 0", "2"], ["Total marks for question 2=6"]], "text": "Question number | Answer | Notes | Marks\n2 | (a)(i) | C(neutron)\nA is not the correct answer because electrons are not in the nucleus\nB is not the correct answer as ions are not in the nucleus\nD is not the correct answer as protons have a positive charge |  | 1\n(ii) | C(9)\nA is not the correct answer because the proton number=4\nB is not the correct answer as there are 5 neutrons\nD is not the correct answer because 13 is the number of protons+neutrons+electrons |  | 1\n(b)(i) | (ii) | similarity=number of protons/proton number\ndifference=number of neutrons | ALLOW number of electrons\nALLOW one has 3 neutrons and the other has 4 neutrons\nIGNORE reference to atomic number and mass numbers | 2\nM1((7.5×6)+(92.5×7))÷100\nM26.925/6.93/6.9 | ALLOW 2 or more significant figures\nAnswer 6.925/6.93/6.9 without working scores 2 marks\nAnswer of 7 with correct method scores M1\nAnswer of 7 without working scores 0 | 2\nTotal marks for question 2=6", "row_count": 6, "confidence": 1.0, "element_id": "e000023", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 23, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["3", "(a)(i)", "M1(positive) ion/cation", "ALLOW atom", "2"], ["M2(delocalised) electron", "", ""], ["M1 layers(of atoms/ions)", "ALLOW particles", "2"], ["(b)(i)", "(i)", "M2(atoms/ions) can slide over one another", "REJECT references to intermolecular forces", ""], ["2Mg(s)+O2(g)→2MgO(s)", "", "2"], ["M1 balancingM2 state symbolsmagnesium gains oxygen", "ALLOW multiples or fractions-O2must also be changed to score.ALLOW magnesium loses electronsIGNORE magnesium reacts with oxygen", "1"], ["(c)(i)", "(i)", "to increase the rate of reaction OWTTE", "", "1"], ["to ensure all the acid has reacted/neutralise the acid OWTTE", "", "1"], ["M1 amount of HCl=(25×2)÷1000 OR 0.050(mol)M2 amount of magnesium=0.050÷2 OR 0.025(mol)M3 0.025×24=0.60g/0.6g", "ALLOW ecf M1÷2ALLOW ecf M2×24Answer of 0.60g without working scores3Answer of 1.20g with working scores2", "3"], ["Total marks for question 3=12"]], "text": "Question number | Answer | Notes | Marks\n3 | (a)(i) | M1(positive) ion/cation | ALLOW atom | 2\nM2(delocalised) electron |  | \nM1 layers(of atoms/ions) | ALLOW particles | 2\n(b)(i) | (i) | M2(atoms/ions) can slide over one another | REJECT references to intermolecular forces | \n2Mg(s)+O2(g)→2MgO(s) |  | 2\nM1 balancingM2 state symbolsmagnesium gains oxygen | ALLOW multiples or fractions-O2must also be changed to score.ALLOW magnesium loses electronsIGNORE magnesium reacts with oxygen | 1\n(c)(i) | (i) | to increase the rate of reaction OWTTE |  | 1\nto ensure all the acid has reacted/neutralise the acid OWTTE |  | 1\nM1 amount of HCl=(25×2)÷1000 OR 0.050(mol)M2 amount of magnesium=0.050÷2 OR 0.025(mol)M3 0.025×24=0.60g/0.6g | ALLOW ecf M1÷2ALLOW ecf M2×24Answer of 0.60g without working scores3Answer of 1.20g with working scores2 | 3\nTotal marks for question 3=12", "row_count": 11, "confidence": 1.0, "element_id": "e000024", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 24, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["4(a)", "M1 30℃", "ALLOW values within the range of 30℃-40℃", "2"], ["M2(enzymes from)yeast", "ALLOWzymaseIGNOREglucose/anaerobic/pressure"], ["(b)", "M1 oxygen in the air would react with ethanol", "ACCEPT ethanol would be oxidised", "2"], ["M2 to form ethanoic acid", "ALLOW to form carboxylic acid ALLOW to form vinegar"], ["OR", ""], ["M1 ethanol would not be formed", ""], ["(c)(i)(ii)", "CO2", "", "1"], ["12.5%", "Answer of 12.5% without working scores 3 marks", "3"], ["M1(theoretical moles of ethanol from glucose)=500x2=1000", ""], ["M2(100% yield)=46000g", "ALLOW ecf from M1"], ["M3(percentage yield)=(5750÷46000)×100=12.5%", "ALLOW ecf from M2"], ["OR", ""], ["M1moles of ethanol from mass=5750/46=125", ""], ["M2theoretical moles of ethanol=500x2=1000", ""], ["", "M3(percentage yield)=125/1000×100=12.5%", "Allow ecf for M3"], ["Total marks for question 4=8"]], "text": "Question number | Answer | Notes | Marks\n4(a) | M1 30℃ | ALLOW values within the range of 30℃-40℃ | 2\nM2(enzymes from)yeast | ALLOWzymaseIGNOREglucose/anaerobic/pressure\n(b) | M1 oxygen in the air would react with ethanol | ACCEPT ethanol would be oxidised | 2\nM2 to form ethanoic acid | ALLOW to form carboxylic acid ALLOW to form vinegar\nOR | \nM1 ethanol would not be formed | \n(c)(i)(ii) | CO2 |  | 1\n12.5% | Answer of 12.5% without working scores 3 marks | 3\nM1(theoretical moles of ethanol from glucose)=500x2=1000 | \nM2(100% yield)=46000g | ALLOW ecf from M1\nM3(percentage yield)=(5750÷46000)×100=12.5% | ALLOW ecf from M2\nOR | \nM1moles of ethanol from mass=5750/46=125 | \nM2theoretical moles of ethanol=500x2=1000 | \n | M3(percentage yield)=125/1000×100=12.5% | Allow ecf for M3\nTotal marks for question 4=8", "row_count": 17, "confidence": 1.0, "element_id": "e000026", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 26, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["5(a)(i)(ii)", "(volumetric) pipette", "ALLOW burette REJECT measuring cylinder", "1"], ["M1 fill a burette (with sodium hydrogensulfate)", "REJECT NaOH in burette for M1", "5"], ["M2 add sodium hydrogensulfate until the indicator changes colour"], ["M3 swirl (the conical flask)"], ["M4 add sodium hydrogensulfate dropwise near to the endpoint/end"], ["M5 repeat until concordant results"], ["(b)", "M1 heat until crystals first start to form/a saturated solution forms/crystallisation point is reached", "ALLOW heat until volume is about half original volume", "4"], ["M2 cool and crystallise/leave to crystallise", "ALLOW filter IGNORE washing with water", ""], ["M3 pour off any excess liquid", "ALLOW leave to dry OR dry using a desiccator OR warm oven OR dry between pieces of filter paper", ""], ["M4 leave in a warm place to dry", "If heated to dryness then MAX 1 MARK", ""]], "text": "Question number | Answer | Notes | Marks\n5(a)(i)(ii) | (volumetric) pipette | ALLOW burette REJECT measuring cylinder | 1\nM1 fill a burette (with sodium hydrogensulfate) | REJECT NaOH in burette for M1 | 5\nM2 add sodium hydrogensulfate until the indicator changes colour\nM3 swirl (the conical flask)\nM4 add sodium hydrogensulfate dropwise near to the endpoint/end\nM5 repeat until concordant results\n(b) | M1 heat until crystals first start to form/a saturated solution forms/crystallisation point is reached | ALLOW heat until volume is about half original volume | 4\nM2 cool and crystallise/leave to crystallise | ALLOW filter IGNORE washing with water | \nM3 pour off any excess liquid | ALLOW leave to dry OR dry using a desiccator OR warm oven OR dry between pieces of filter paper | \nM4 leave in a warm place to dry | If heated to dryness then MAX 1 MARK | ", "row_count": 11, "confidence": 1.0, "element_id": "e000027", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 27, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["(c)", "M1 mass of sodium sulfate = 2.84g", "Answer of 10 without working scores 4", "4"], ["M2 mass of water = 3.6g", "", ""], ["M3 moles of sodium sulfate = 0.02 AND moles of water = 0.20", "", ""], ["M4 x = 10", "Allow ecf for M4 if dividing by the smallest number but only if x is given as a whole number", ""], ["OR", "", ""], ["M1 mass of sodium sulfate = 2.84g", "", ""], ["M2 mass of hydrated salt = 6.44g", "", ""], ["M3 Mr of hydrated salt = 6.44/0.02 = 322", "", ""], ["M4 xH2O = 322-142 = 180 so x = 10", "", ""], ["Total marks for question 5 = 14"]], "text": "(c) | M1 mass of sodium sulfate = 2.84g | Answer of 10 without working scores 4 | 4\nM2 mass of water = 3.6g |  | \nM3 moles of sodium sulfate = 0.02 AND moles of water = 0.20 |  | \nM4 x = 10 | Allow ecf for M4 if dividing by the smallest number but only if x is given as a whole number | \nOR |  | \nM1 mass of sodium sulfate = 2.84g |  | \nM2 mass of hydrated salt = 6.44g |  | \nM3 Mr of hydrated salt = 6.44/0.02 = 322 |  | \nM4 xH2O = 322-142 = 180 so x = 10 |  | \nTotal marks for question 5 = 14", "row_count": 10, "confidence": 1.0, "element_id": "e000028", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 28, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["6(a)(i)", "platinum", "ALLOW silver/gold/graphite", "1"], ["glowing splint relights", "", "1"], ["lit splint(with a squeaky)pop", "", "1"], ["$2H^{+}+2e^{-}\\rightarrow H_{2}$", "", "1"], ["0.0237g", "correct answer(to 3 sig figs)without working scores3", "3"], ["M1(moles of oxygen)17.80÷24000OR0.000742M2Mrof oxygen=32M30.0237g", "ALLOW ecf fromM1andM2answer must be to 3 sig figs forM3", ""], ["(b)(i)", "ions can move/are mobile OWTTE", "", "1"], ["Hydrogen/it is less reactive than sodium ORA", "ALLOW H^{+}ions are more easily reduced/accept electrons more easily than Na^{+}ionsALLOW hydrogen is below sodium in the reactivity series", "1"], ["M1the universal indicator turns blue/purpleM2OH^{-}/hydroxide ions are present in solution", "ALLOW solution is sodium hydroxideALLOW the solution is alkaline", "2"], ["Total marks for question 6=11"]], "text": "Question number | Answer | Notes | Marks\n6(a)(i) | platinum | ALLOW silver/gold/graphite | 1\nglowing splint relights |  | 1\nlit splint(with a squeaky)pop |  | 1\n$2H^{+}+2e^{-}\\rightarrow H_{2}$ |  | 1\n0.0237g | correct answer(to 3 sig figs)without working scores3 | 3\nM1(moles of oxygen)17.80÷24000OR0.000742M2Mrof oxygen=32M30.0237g | ALLOW ecf fromM1andM2answer must be to 3 sig figs forM3 | \n(b)(i) | ions can move/are mobile OWTTE |  | 1\nHydrogen/it is less reactive than sodium ORA | ALLOW H^{+}ions are more easily reduced/accept electrons more easily than Na^{+}ionsALLOW hydrogen is below sodium in the reactivity series | 1\n