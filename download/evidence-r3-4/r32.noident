INSERT INTO public.question_parts VALUES ('dbf37b04-3d7b-4b7c-b510-74c9b0e63bcb', 'cd41ddb1-3981-4760-be5a-089e47ef8720', 'b', 'In another experiment 0.050 mol of $ \mathrm{M g C O_{3}} $ reacts with excess HCl. A yield of 5.5 g of $ \mathrm{M g C l_{2}. 6 H_{2} O} $ is obtained.', NULL, 0, 2, '2026-09-13 12:59:56.217095+00');
INSERT INTO public.question_parts VALUES ('b529b4bd-75af-4590-9d31-83700a3665c1', 'cd41ddb1-3981-4760-be5a-089e47ef8720', 'b-i', 'Calculate the percentage yield of $ \mathrm{M g C l_{2}. 6 H_{2}O} $', NULL, 0, 3, '2026-09-13 12:59:56.217145+00');
INSERT INTO public.question_parts VALUES ('7cf4e16d-0353-44d6-b6c5-730dc432e8e6', 'cd41ddb1-3981-4760-be5a-089e47ef8720', 'b-ii', 'Suggest why the percentage yield is less than 100%.', NULL, 0, 4, '2026-09-13 12:59:56.217179+00');
INSERT INTO public.question_parts VALUES ('ca70493d-735e-4293-98c5-7cd54c8eaea5', '0ad3c060-b9ec-4edb-8b3d-c09eae0d5d35', 'a', 'For a reaction that is in dynamic equilibrium, the forward and backward reactions occur at the same time. State two other features of a reaction that is in dynamic equilibrium.', NULL, 0, 0, '2026-09-13 12:59:56.217271+00');
INSERT INTO public.question_parts VALUES ('92804c19-6fef-4324-853d-22a704ed35e7', '0ad3c060-b9ec-4edb-8b3d-c09eae0d5d35', 'b', 'At equilibrium there is more $ \mathrm{N O_{2}} $ than $ \mathrm{N_{2}O_{4}} $ The graph shows how the number of moles of $ \mathrm{N O_{2}} $ in the sealed flask changes with time.', NULL, 0, 1, '2026-09-13 12:59:56.217321+00');
INSERT INTO public.question_parts VALUES ('18f39768-1086-430f-9774-64f1f3f41abf', '0ad3c060-b9ec-4edb-8b3d-c09eae0d5d35', 'b-i', 'Draw a cross ( $ \times $ ) on the graph at the point where the reaction reaches equilibrium.', NULL, 0, 2, '2026-09-13 12:59:56.21737+00');
INSERT INTO public.question_parts VALUES ('1992cae4-2205-4c0e-9e76-2613dafa183f', '0ad3c060-b9ec-4edb-8b3d-c09eae0d5d35', 'b-ii', 'Draw a curve on the graph to show how the number of moles of $ \mathrm{N_{2}O_{4}} $ in the sealed flask changes over the same time period.', NULL, 0, 3, '2026-09-13 12:59:56.217417+00');
INSERT INTO public.question_parts VALUES ('bd8721ed-acd5-4b33-a9a0-f63f0fbebf03', '0ad3c060-b9ec-4edb-8b3d-c09eae0d5d35', 'c', 'The sealed flask containing the equilibrium mixture is placed in water at a temperature of $ 5 0^{\circ} \mathrm{C} $ . The mixture goes darker in colour. Explain what this observation shows about the equilibrium reaction. Every effort has been made to contact copyright holders to obtain their permission for the use of copyright material. Pearson Education Ltd. will, if notified, be happy to rectify any errors or omissions and include any such rectifications in future editions.', NULL, 0, 4, '2026-09-13 12:59:56.217452+00');
INSERT INTO public.question_parts VALUES ('191a8085-abce-4f64-9cd1-6a446d2429ac', '6f7af314-b815-4eba-9e9b-508495aaebc1', 'a', 'The formula of the main compound used as the source of sodium sulfate is $ \mathrm{N a_{2} S O_{4}. 1 0 H_{2} O} $ How many different elements are shown in this formula? A 2 B 3 C 4 D 5', NULL, 0, 0, '2026-09-13 12:59:56.392452+00');
INSERT INTO public.question_parts VALUES ('2547a4a9-e5cb-4117-bbfc-3408db79766a', '6f7af314-b815-4eba-9e9b-508495aaebc1', 'b', 'Sodium sulfate can be made from sodium hydroxide and sulfuric acid. Balance the equation for the reaction between sodium hydroxide and sulfuric acid. (1) $ \mathrm{N a O H}+ \mathrm{H_{2} S O_{4}} \rightarrow \mathrm{N a_{2} S O_{4}}+ \mathrm{H_{2} O} $', NULL, 0, 1, '2026-09-13 12:59:56.392584+00');
INSERT INTO public.question_parts VALUES ('d5f00494-f7c8-4daf-8de0-1d8a8ea2ac46', '6f7af314-b815-4eba-9e9b-508495aaebc1', 'c', 'Sodium hydroxide is manufactured by the electrolysis of brine in the diaphragm cell. Sulfuric acid is manufactured using the contact process. The table contains some statements about these two processes. Place ticks ( $ \checkmark $ ) in the boxes to show the two correct statements.', NULL, 0, 2, '2026-09-13 12:59:56.392628+00');
INSERT INTO public.question_parts VALUES ('0c13116f-b828-473a-b97c-6d448623e0a4', 'efc6a9a7-adb5-4772-b8ea-99e7f33a4c31', 'a', 'How many periods and groups are shown in this diagram?', NULL, 1, 0, '2026-09-13 12:59:56.392676+00');
INSERT INTO public.question_parts VALUES ('d96be2a5-63dd-4797-8259-4fe3748a2512', 'efc6a9a7-adb5-4772-b8ea-99e7f33a4c31', 'b', 'How many elements shown in the diagram are noble gases? A 1 B 2 C 3 D 4', NULL, 0, 1, '2026-09-13 12:59:56.392735+00');
INSERT INTO public.question_parts VALUES ('f9ff997a-7535-48d2-b7a4-0704158e9ec1', 'efc6a9a7-adb5-4772-b8ea-99e7f33a4c31', 'c', 'What is the formula of the compound formed between magnesium and fluorine? (1) A MgF B $ \mathrm{M g_{2} F} $ C $ \mathrm{M g F_{2}} $ D $ \mathrm{M g_{2} F_{2}} $', NULL, 0, 2, '2026-09-13 12:59:56.392766+00');
INSERT INTO public.question_parts VALUES ('876b30f8-045f-4deb-9866-b7dffcf0acb3', 'efc6a9a7-adb5-4772-b8ea-99e7f33a4c31', 'd', 'The table shows the percentage composition by mass of a sample of silicon. Calculate the relative atomic mass of this sample of silicon. Give your answer to one decimal place.', NULL, 0, 3, '2026-09-13 12:59:56.3928+00');
INSERT INTO public.question_parts VALUES ('ac8f75de-73ba-48db-9942-02c89a7b7f02', 'efc6a9a7-adb5-4772-b8ea-99e7f33a4c31', 'e', 'A molecule of silicon tetrafluoride $ \mathrm{(S i F_{4})} $ contains covalent bonds. Draw a dot and cross diagram to show the outer electrons in this molecule.', NULL, 0, 4, '2026-09-13 12:59:56.392849+00');
INSERT INTO public.question_parts VALUES ('c0dd936c-40fd-4596-b956-93e57145b48b', 'efc6a9a7-adb5-4772-b8ea-99e7f33a4c31', 'f', 'The table shows the boiling points of some compounds containing silicon. All of these compounds contain covalent bonds. $ \mathrm{S i F}_{4} $ and $ \mathrm{S i C l}_{4} $ have simple molecular structures. $ \mathrm{S i O}_{2} $ has a giant covalent structure.', NULL, 0, 5, '2026-09-13 12:59:56.392887+00');
INSERT INTO public.question_parts VALUES ('b597bfba-0260-43f9-bfb2-bec3dc876cc1', 'efc6a9a7-adb5-4772-b8ea-99e7f33a4c31', 'f-i', 'Explain why the boiling point of $ \mathrm{S i C l}_{4} $ is greater than the boiling point of $ \mathrm{S i F}_{4} $', NULL, 0, 6, '2026-09-13 12:59:56.392921+00');
INSERT INTO public.question_parts VALUES ('e0934563-2fb8-4c07-8274-ceb456a18db7', 'efc6a9a7-adb5-4772-b8ea-99e7f33a4c31', 'f-ii', 'Explain why the boiling point of $ \mathrm{S i O_{2}} $ is very much greater than the boiling point of $ \mathrm{S i C l_{4}} $', NULL, 0, 7, '2026-09-13 12:59:56.392955+00');
INSERT INTO public.question_parts VALUES ('12008ad2-7b21-45b8-9929-703fda14729b', '1edeeda0-13e1-4d61-a17d-6798b601d429', 'a', 'Name the particles that move through the connecting wires to form an electric current.', NULL, 0, 0, '2026-09-13 12:59:56.392999+00');
