INSERT INTO public.questions VALUES ('eb13f83c-68d5-488f-a395-e000849fd4e2', 'q03-8569da15', 'STRUCTURED', '(a) The box gives the names of some metals. Use words from the box to answer these questions. (i) Identify the metal that burns with a bright white flame. (ii) Explain which metal is most likely to be found in the Earth as an uncombined element.', 6, 3, 540, NULL, '47804504-39de-4ee1-92a2-a7db8b622911', 'PAST_PAPER', true, 1, '2026-09-13 13:03:38.672526+00', 'a1fe4676-0a3e-4bb5-9ac4-d0910cebf652');
INSERT INTO public.questions VALUES ('3291f8d4-6afa-4272-a303-746a5729215a', 'q07-8569da15', 'STRUCTURED', 'Methanol is made by the reaction between hydrogen and carbon monoxide. This is the equation for the reaction. $2 \mathrm {H} _ {2} (\mathrm {g}) + \mathrm {C O} (\mathrm {g}) \rightleftharpoons \mathrm {C H} _ {3} \mathrm {O H} (\mathrm {g}) \quad \Delta H = - 1 1 9 \mathrm {k J / m o l}$ A mixture of hydrogen and carbon monoxide is left until dynamic equilibrium is reached.', 14, 3, 1260, NULL, '47804504-39de-4ee1-92a2-a7db8b622911', 'PAST_PAPER', true, 1, '2026-09-13 13:03:38.673515+00', 'a1fe4676-0a3e-4bb5-9ac4-d0910cebf652');
INSERT INTO public.questions VALUES ('c15ce991-0732-478c-9a5d-6acd9414552e', 'q01-8d262f6a', 'STRUCTURED', 'The diagram shows a Bunsen burner.', 6, 3, 540, NULL, '640f38f1-b37e-4771-b161-c2af219bce30', 'PAST_PAPER', true, 1, '2026-09-13 13:00:40.223179+00', 'ad92a325-55f2-4e1f-80bc-789b55bc045d');
INSERT INTO public.questions VALUES ('3c6f07ad-28ff-4b99-aad4-0053ae90b253', 'q02-8d262f6a', 'STRUCTURED', 'A student uses this apparatus to investigate the burning of four different liquid fuels, W, X, Y and Z. The table shows the student''s results.', 4, 3, 360, NULL, '640f38f1-b37e-4771-b161-c2af219bce30', 'PAST_PAPER', true, 1, '2026-09-13 13:00:40.255273+00', 'ad92a325-55f2-4e1f-80bc-789b55bc045d');
