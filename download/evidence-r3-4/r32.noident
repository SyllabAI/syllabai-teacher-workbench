a256": "d41d39f34177c97e0eda92fd34e9d1aa5f28f22b3312e14e9be1b5e764252b9a", "assetId": "img:d41d39f34177c97e0eda92fd34e9d1aa5f28f22b3312e14e9be1b5e764252b9a", "mimeType": "image/jpeg", "elementId": "e000040", "sourceName": "assets/crop_1_1789055743358.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain why it is necessary for water to flow continuously in and out of the apparatus.", "label": "b-i", "marks": 2, "partId": "q02-a44a4e4c-pb-i", "figures": [{"url": "assets/crop_3_1789055743367.png", "width": 125, "format": "png", "height": 37, "sha256": "35d18b86725f24a2770c36101ac98d19e3d2497e89f231ad73770d1f430956b7", "assetId": "img:35d18b86725f24a2770c36101ac98d19e3d2497e89f231ad73770d1f430956b7", "mimeType": "image/jpeg", "elementId": "e000043", "sourceName": "assets/crop_3_1789055743367.png", "availability": "available", "formatMismatch": true}], "confidence": 0.8, "answerPrompts": []}, {"qwc": false, "text": "Describe a chemical test to show that the sodium chloride solution contains chloride ions.", "label": "b-ii", "marks": null, "partId": "q02-a44a4e4c-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Describe a physical test to show that the liquid in the conical flask is pure water.", "label": "b-iii", "marks": null, "partId": "q02-a44a4e4c-pb-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 2, "figures": [{"url": "assets/crop_1_1789055743358.png", "width": 1244, "format": "png", "height": 481, "sha256": "d41d39f34177c97e0eda92fd34e9d1aa5f28f22b3312e14e9be1b5e764252b9a", "assetId": "img:d41d39f34177c97e0eda92fd34e9d1aa5f28f22b3312e14e9be1b5e764252b9a", "mimeType": "image/jpeg", "elementId": "e000040", "sourceName": "assets/crop_1_1789055743358.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_3_1789055743367.png", "width": 125, "format": "png", "height": 37, "sha256": "35d18b86725f24a2770c36101ac98d19e3d2497e89f231ad73770d1f430956b7", "assetId": "img:35d18b86725f24a2770c36101ac98d19e3d2497e89f231ad73770d1f430956b7", "mimeType": "image/jpeg", "elementId": "e000043", "sourceName": "assets/crop_3_1789055743367.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q02-a44a4e4c", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000038"]}, {"mcq": false, "qwc": false, "stem": "The diagram shows a chromatogram of the food dyes in four different food colourings, A, B, C and D.", "marks": 9, "parts": [{"qwc": false, "text": "Give the letter of the food colouring that contains three different food dyes.", "label": "a", "marks": null, "partId": "q03-a44a4e4c-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give the letters of the two food colourings that contain the same dye.", "label": "a-ii", "marks": null, "partId": "q03-a44a4e4c-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Using the scale on the diagram, determine the $ R_{\\mathrm{f}} $ value of the dye in food colouring C. $R _ {\\mathrm {f}} =$", "label": "a-iii", "marks": null, "partId": "q03-a44a4e4c-pa-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give a reason why the dye in food colouring D moves the furthest from the start line.", "label": "a-iv", "marks": null, "partId": "q03-a44a4e4c-pa-iv", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Describe how a student could obtain a chromatogram similar to the one shown in the diagram.", "label": "b", "marks": null, "partId": "q03-a44a4e4c-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 3, "figures": [{"url": "assets/crop_1_1789055743387.png", "width": 767, "format": "png", "height": 722, "sha256": "2b38e8f627b459f4f47cf90cd5bdce91d0acc6224a7346fc913d7a232959a7b0", "assetId": "img:2b38e8f627b459f4f47cf90cd5bdce91d0acc6224a7346fc913d7a232959a7b0", "mimeType": "image/jpeg", "elementId": "e000048", "sourceName": "assets/crop_1_1789055743387.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q03-a44a4e4c", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "The diagram shows the positions of some elements in part of the Periodic Table.", "marks": 12, "parts": [{"qwc": false, "text": "Give the symbol of a metal from the diagram.", "label": "a", "marks": null, "partId": "q04-a44a4e4c-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give the symbol of an element from the diagram that forms an acidic oxide.", "label": "a-ii", "marks": null, "partId": "q04-a44a4e4c-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give a similarity in the electron configurations of Al and In.", "label": "b", "marks": null, "partId": "q04-a44a4e4c-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain which element in the diagram is unreactive.", "label": "c", "marks": null, "partId": "q04-a44a4e4c-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "A teacher adds a small piece of sodium to a glass trough containing water and universal indicator. The universal indicator changes colour. The equation for the reaction is $2 \\mathrm {N a} (\\mathrm {s}) + 2 \\mathrm {H} _ {2} \\mathrm {O} (\\mathrm {I}) \\rightarrow 2 \\mathrm {N a O H} (\\mathrm {a q}) + \\mathrm {H} _ {2} (\\mathrm {g})$", "label": "d", "marks": null, "partId": "q04-a44a4e4c-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain the final colour of the universal indicator.", "label": "d-i", "marks": null, "partId": "q04-a44a4e4c-pd-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The teacher repeats the experiment with potassium instead of sodium. Give one similarity and one difference observed with potassium. similarity difference", "label": "d-ii", "marks": null, "partId": "q04-a44a4e4c-pd-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The reaction with sodium produces 0.036 g of hydrogen gas. One mole of hydrogen gas contains $ 6. 0 \\times1 0^{2 3} $ molecules. Calculate the number of molecules of hydrogen gas produced in the reaction with sodium. Give your answer to two significant figures.", "label": "d-iii", "marks": null, "partId": "q04-a44a4e4c-pd-iii", "figures": [], "confidence": 0.55, "answerPrompts": ["number of molecules of hydrogen gas"]}], "number": 4, "figures": [{"url": "assets/crop_1_1789055743402.png", "width": 1624, "format": "png", "height": 372, "sha256": "e5bfa40d39d0bec5a7a4787ad12037e0235560e7937b9b31a6b56a72cbe474d0", "assetId": "img:e5bfa40d39d0bec5a7a4787ad12037e0235560e7937b9b31a6b56a72cbe474d0", "mimeType": "image/jpeg", "elementId": "e000057", "sourceName": "assets/crop_1_1789055743402.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q04-a44a4e4c", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "This question is about metal carbonates. When heated, some metal carbonates decompose to form a metal oxide and carbon dioxide gas.", "marks": 0, "parts": [{"qwc": false, "text": "A student is given three solid metal carbonates, a timer, some limewater and this apparatus. Describe a method the student can use to find out which metal carbonate decomposes fastest when heated.", "label": "a", "marks": null, "partId": "q05-a44a4e4c-pa", "figures": [{"url": "assets/crop_1_1789055743427.png", "width": 1086, "format": "png", "height": 598, "sha256": "542c87476ca2cffa6eb9dc2af1c64bdc3ae609f5d9768738f2918d148d6f416e", "assetId": "img:542c87476ca2cffa6eb9dc2af1c64bdc3ae609f5d9768738f2918d148d6f416e", "mimeType": "image/jpeg", "elementId": "e000079", "sourceName": "assets/crop_1_1789055743427.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "A student is given a solid metal carbonate with the formula $ \\mathrm{X C O}_{3} $ X represents the symbol of a Group 2 metal. A student uses this apparatus to heat a sample of $ \\mathrm{X C O_{3}} $ until it all decomposes. The equation for the decomposition of $ \\mathrm{X C O_{3}} $ is $\\mathrm {X C O} _ {3} \\rightarrow \\mathrm {X O} + \\mathrm {C O} _ {2}$ The student records the mass of $ \\mathrm{X C O_{3}} $ and the mass of carbon dioxide that escapes through the cotton wool plug. These are the student''s results. mass of $ \\mathrm{X C O}_{3}=7. 4 0 \\mathrm{~ g} $ mass of $ \\mathrm{C O_{2}}=2. 2 0 \\mathrm{g} $", "label": "b", "marks": null, "partId": "q05-a44a4e4c-pb", "figures": [{"url": "assets/crop_1_1789055743437.png", "width": 543, "format": "png", "height": 647, "sha256": "08e8afd5f72198c5ac4d8c9556581bfa143fd9201fa4a587efdeff4907b089e3", "assetId": "img:08e8afd5f72198c5ac4d8c9556581bfa143fd9201fa4a587efdeff4907b089e3", "mimeType": "image/jpeg", "elementId": "e000084", "sourceName": "assets/crop_1_1789055743437.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give a reason why the student uses a cotton wool plug.", "label": "b-i", "marks": null, "partId": "q05-a44a4e4c-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the amount, in mol, of carbon dioxide produced.", "label": "b-ii", "marks": null, "partId": "q05-a44a4e4c-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 5, "figures": [{"url": "assets/crop_1_1789055743427.png", "width": 1086, "format": "png", "height": 598, "sha256": "542c87476ca2cffa6eb9dc2af1c64bdc3ae609f5d9768738f2918d148d6f416e", "assetId": "img:542c87476ca2cffa6eb9dc2af1c64bdc3ae609f5d9768738f2918d148d6f416e", "mimeType": "image/jpeg", "elementId": "e000079", "sourceName": "assets/crop_1_1789055743427.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_1_1789055743437.png", "width": 543, "format": "png", "height": 647, "sha256": "08e8afd5f72198c5ac4d8c9556581bfa143fd9201fa4a587efdeff4907b089e3", "assetId": "img:08e8afd5f72198c5ac4d8c9556581bfa143fd9201fa4a587efdeff4907b089e3", "mimeType": "image/jpeg", "elementId": "e000084", "sourceName": "assets/crop_1_1789055743437.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.45, "marksKnown": false, "questionId": "q05-a44a4e4c", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000093"]}, {"mcq": false, "qwc": false, "stem": "Silicon hydride （ $ \\mathrm{S i H_{4}} $ ）and silicon dioxide （ $ \\mathrm{S i O_{2}} $ ）both contain covalent bonds but they have different structures.", "marks": 9, "parts": [{"qwc": false, "text": "Describe the forces of attraction in a covalent bond.", "label": "a", "marks": null, "partId": "q06-a44a4e4c-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Complete the diagram to show the outer shell electrons in a molecule of silicon hydride $ \\mathrm{(S i H_{4})}. $", "label": "b", "marks": null, "partId": "q06-a44a4e4c-pb", "figures": [{"url": "assets/crop_1_1789055743461.png", "width": 662, "format": "png", "height": 644, "sha256": "72acc14ed7a96096beddc5e6207006fe856fa36794711b465c103e1eae37e6b8", "assetId": "img:72acc14ed7a96096beddc5e6207006fe856fa36794711b465c103e1eae37e6b8", "mimeType": "image/jpeg", "elementId": "e000097", "sourceName": "assets/crop_1_1789055743461.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The diagram represents part of the structure of silicon dioxide $ \\mathrm{(S i O_{2})} $", "label": "c", "marks": null, "partId": "q06-a44a4e4c-pc", "figures": [{"url": "assets/crop_2_1789055743466.png", "width": 484, "format": "png", "height": 393, "sha256": "07037ad7506102fafb708decaffbfc8dc0510f51bcfb123c9236cf24cf83f586", "assetId": "img:07037ad7506102fafb708decaffbfc8dc0510f51bcfb123c9236cf24cf83f586", "mimeType": "image/jpeg", "elementId": "e000099", "sourceName": "assets/crop_2_1789055743466.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State how the diagram shows that the atom labelled A is oxygen, not silicon.", "label": "c-i", "marks": null, "partId": "q06-a44a4e4c-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Silicon hydride has a simple molecular structure. Silicon dioxide has the same type of structure as diamond. Explain why silicon dioxide has a much higher melting point than silicon hydride. Refer to structure and bonding in your answer.", "label": "c-ii", "marks": null, "partId": "q06-a44a4e4c-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Silicon hydride reacts with oxygen to form silicon dioxide and water. Write a chemical equation for the reaction between silicon hydride and oxygen.", "label": "d", "marks": null, "partId": "q06-a44a4e4c-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 6, "figures": [{"url": "assets/crop_1_1789055743461.png", "width": 662, "format": "png", "height": 644, "sha256": "72acc14ed7a96096beddc5e6207006fe856fa36794711b465c103e1eae37e6b8", "assetId": "img:72acc14ed7a96096beddc5e6207006fe856fa36794711b465c103e1eae37e6b8", "mimeType": "image/jpeg", "elementId": "e000097", "sourceName": "assets/crop_1_1789055743461.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789055743466.png", "width": 484, "format": "png", "height": 393, "sha256": "07037ad7506102fafb708decaffbfc8dc0510f51bcfb123c9236cf24cf83f586", "assetId": "img:07037ad7506102fafb708decaffbfc8dc0510f51bcfb123c9236cf24cf83f586", "mimeType": "image/jpeg", "elementId": "e000099", "sourceName": "assets/crop_2_1789055743466.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q06-a44a4e4c", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "The diagram shows some important conversion processes used in the oil industry.", "marks": 15, "parts": [{"qwc": false, "text": "Describe how kerosene is produced from crude oil in process 1.", "label": "a", "marks": null, "partId": "q07-a44a4e4c-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "$ C_{1 2} H_{2 6} $ is present in kerosene. In process 2, $ C_{1 2} H_{2 6} $ is cracked to produce two molecules of ethene and one molecule of another hydrocarbon.", "label": "b", "marks": null, "partId": "q07-a44a4e4c-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Complete the equation for the cracking of $ C_{1 2} H_{2 6} $ $\\mathrm {C} _ {1 2} \\mathrm {H} _ {2 6} \\rightarrow 2 \\mathrm {C} _ {2} \\mathrm {H} _ {4} +$", "label": "b-i", "marks": null, "partId": "q07-a44a4e4c-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain why cracking is a useful process in the oil industry.", "label": "b-ii", "marks": null, "partId": "q07-a44a4e4c-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "This is the equation for one of the reactions that may occur during process 3. What is the name of this type of reaction? A addition B combustion decomposition D substitution", "label": "c", "marks": 1, "partId": "q07-a44a4e4c-pc", "figures": [{"url": "assets/crop_1_1789055743493.png", "width": 732, "format": "png", "height": 213, "sha256": "f25b7fa0df35b750df01ffb48ae4c840d902d3bcc13184ae055577a19c93dd95", "assetId": "img:f25b7fa0df35b750df01ffb48ae4c840d902d3bcc13184ae055577a19c93dd95", "mimeType": "image/jpeg", "elementId": "e000117", "sourceName": "assets/crop_1_1789055743493.png", "availability": "available", "formatMismatch": true}], "confidence": 0.8, "answerPrompts": []}, {"qwc": false, "text": "Complete the equation for the polymerisation of chloroethene in process 4.", "label": "d", "marks": null, "partId": "q07-a44a4e4c-pd", "figures": [{"url": "assets/crop_1_1789055743501.png", "width": 882, "format": "png", "height": 243, "sha256": "ad43859fd29fe3efd2edb76fa9a729253cfdf20f63e6910e0c45dfbf41f8940a", "assetId": "img:ad43859fd29fe3efd2edb76fa9a729253cfdf20f63e6910e0c45dfbf41f8940a", "mimeType": "image/jpeg", "elementId": "e000125", "sourceName": "assets/crop_1_1789055743501.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain why the disposal of polymers such as poly(chloroethene) is difficult.", "label": "d-ii", "marks": null, "partId": "q07-a44a4e4c-pd-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 7, "figures": [{"url": "assets/crop_1_1789055743479.png", "width": 441, "format": "png", "height": 1282, "sha256": "5cc814855de18a8606229d859a65189bc89a85ed14042c81788426963b4dfb0b", "assetId": "img:5cc814855de18a8606229d859a65189bc89a85ed14042c81788426963b4dfb0b", "mimeType": "image/jpeg", "elementId": "e000109", "sourceName": "assets/crop_1_1789055743479.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_1_1789055743493.png", "width": 732, "format": "png", "height": 213, "sha256": "f25b7fa0df35b750df01ffb48ae4c840d902d3bcc13184ae055577a19c93dd95", "assetId": "img:f25b7fa0df35b750df01ffb48ae4c840d902d3bcc13184ae055577a19c93dd95", "mimeType": "image/jpeg", "elementId": "e000117", "sourceName": "assets/crop_1_1789055743493.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_1_1789055743501.png", "width": 882, "format": "png", "height": 243, "sha256": "ad43859fd29fe3efd2edb76fa9a729253cfdf20f63e6910e0c45dfbf41f8940a", "assetId": "img:ad43859fd29fe3efd2edb76fa9a729253cfdf20f63e6910e0c45dfbf41f8940a", "mimeType": "image/jpeg", "elementId": "e000125", "sourceName": "assets/crop_1_1789055743501.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q07-a44a4e4c", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "This question is about exothermic reactions.", "marks": 10, "parts": [{"qwc": false, "text": "A student uses this apparatus to measure the temperature increase when an excess of zinc powder is added to copper(II) sulfate solution.", "label": "a", "marks": null, "partId": "q08-a44a4e4c-pa", "figures": [{"url": "assets/crop_1_1789055743511.png", "width": 1149, "format": "png", "height": 463, "sha256": "acccfdf07ac4019d36f42882a93d6cef2a363317145742ec703b49449b1018b3", "assetId": "img:acccfdf07ac4019d36f42882a93d6cef2a363317145742ec703b49449b1018b3", "mimeType": "image/jpeg", "elementId": "e000130", "sourceName": "assets/crop_1_1789055743511.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Complete the word equation for the reaction.", "label": "a-i", "marks": null, "partId": "q08-a44a4e4c-pa-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give a reason why the student uses a polystyrene cup inside a glass beaker.", "label": "a-ii", "marks": null, "partId": "q08-a44a4e4c-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State why zinc reacts with copper(II) sulfate solution.", "label": "a-iii", "marks": null, "partId": "q08-a44a4e4c-pa-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The temperature at the start of the reaction is $ 1 9. 7^{\\circ} \\mathrm{C} $ The temperature at the end of the reaction is $ 4 8. 3^{\\circ} \\mathrm{C} $ Calculate the heat energy change, in joules, for the reaction. [for the mixture, $ c=4. 2 \\mathrm{J / g /}^{\\circ} \\mathrm{C} $]", "label": "a-iv", "marks": null, "partId": "q08-a44a4e4c-pa-iv", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The reaction between zinc and silver nitrate solution is exothermic. A mass of 0.65 g of zinc is added to excess silver nitrate solution. The heat energy change is 800 J. Calculate the molar enthalpy change, $ \\Delta H $ , in kJ/mol. Include a sign in your answer.", "label": "b", "marks": null, "partId": "q08-a44a4e4c-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "This is the ionic equation for the reaction between zinc and silver nitrate solution. $\\mathrm {Z n} (\\mathrm {s}) + 2 \\mathrm {A g} ^ {+} (\\mathrm {a q}) \\rightarrow \\mathrm {Z n} ^ {2 +} (\\mathrm {a q}) + 2 \\mathrm {A g} (\\mathrm {s})$ Explain, in terms of electrons, why this is a redox reaction.", "label": "b-ii", "marks": null, "partId": "q08-a44a4e4c-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 8, "figures": [{"url": "assets/crop_1_1789055743511.png", "width": 1149, "format": "png", "height": 463, "sha256": "acccfdf07ac4019d36f42882a93d6cef2a363317145742ec703b49449b1018b3", "assetId": "img:acccfdf07ac4019d36f42882a93d6cef2a363317145742ec703b49449b1018b3", "mimeType": "image/jpeg", "elementId": "e000130", "sourceName": "assets/crop_1_1789055743511.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q08-a44a4e4c", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "This question is about rates of reaction.", "marks": 10, "parts": [{"qwc": false, "text": "A student uses this method to investigate the rate of reaction between iron(III) nitrate solution and sodium thiosulfate solution. pour $ 5 0 \\mathrm{c m}^{3} $ of iron(III) nitrate solution into a conical flask add one drop of catalyst solution add $ 5 0 \\mathrm{c m}^{3} $ of sodium thiosulfate solution to the conical flask record the time for the mixture to become colourless The student repeats the method using different catalysts and also with no catalyst. The table shows the student''s results.", "label": "a", "marks": null, "partId": "q09-a44a4e4c-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain which is the best catalyst for the reaction.", "label": "a-i", "marks": 2, "partId": "q09-a44a4e4c-pa-i", "figures": [], "confidence": 0.8, "answerPrompts": []}, {"qwc": false, "text": "Explain how a catalyst increases the rate of a reaction.", "label": "a-ii", "marks": 2, "partId": "q09-a44a4e4c-pa-ii", "figures": [], "confidence": 0.8, "answerPrompts": []}, {"qwc": false, "text": "The rate of a reaction can also be altered by changing the temperature or by changing the concentration of solutions.", "label": "b", "marks": null, "partId": "q09-a44a4e4c-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain, using the particle collision theory, how increasing the temperature affects the rate of a reaction.", "label": "b-i", "marks": null, "partId": "q09-a44a4e4c-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain why using a solution of a lower concentration decreases the rate of reaction.", "label": "b-ii", "marks": null, "partId": "q09-a44a4e4c-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 9, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q09-a44a4e4c", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000154"]}, {"mcq": false, "qwc": false, "stem": "A student investigates how the electrical conductivity changes as dilute sulfuric acid is added to barium hydroxide solution. This is the student''s method. Step1 add $ 50.0\\mathrm{cm}^{3} $ of barium hydroxide solution to a beaker Step 2 measure the electrical conductivity of the solution Step 3 add $ 1 0. 0 \\mathrm{c m}^{3} $ of dilute sulfuric acid to the beaker Step 4 stir the mixture Step 5 measure the electrical conductivity of the mixture Step 6 repeat steps 3 to 5 until a total of $ 1 0 0 \\mathrm{c m}^{3} $ of dilute sulfuric acid has been added The table shows the student''s results.", "marks": 10, "parts": [{"qwc": false, "text": "Name a piece of apparatus the student could use to add $ 1 0. 0 \\mathrm{c m}^{3} $ of dilute sulfuric acid to the beaker.", "label": "a", "marks": null, "partId": "q10-a44a4e4c-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Plot the student''s results.", "label": "a-ii", "marks": null, "partId": "q10-a44a4e4c-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Ignoring the anomalous result, draw two lines of best fit, making sure that the two lines cross. Electrical conductivity in arbitrary units", "label": "a-iii", "marks": null, "partId": "q10-a44a4e4c-pa-iii", "figures": [{"url": "assets/crop_1_1789055743547.png", "width": 1090, "format": "png", "height": 1114, "sha256": "d4968d20a458cd60020a832dd59d6b301f9c04ac925c8e2a31ba7b0c08ed53d7", "assetId": "img:d4968d20a458cd60020a832dd59d6b301f9c04ac925c8e2a31ba7b0c08ed53d7", "mimeType": "image/jpeg", "elementId": "e000177", "sourceName": "assets/crop_1_1789055743547.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give the trend shown on the graph for the first $ 5 0 \\mathrm{c m}^{3} $ of acid added.", "label": "a-iv", "marks": null, "partId": "q10-a44a4e4c-pa-iv", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Suggest a mistake the student could have made to cause the anomalous result.", "label": "a-v", "marks": null, "partId": "q10-a44a4e4c-pa-v", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "This is the equation for the reaction. $\\mathrm {B a} (\\mathrm {O H}) _ {2} (\\mathrm {a q}) + \\mathrm {H} _ {2} \\mathrm {S O} _ {4} (\\mathrm {a q}) \\rightarrow \\mathrm {B a S O} _ {4} (\\mathrm {s}) + 2 \\mathrm {H} _ {2} \\mathrm {O} (\\mathrm {I})$", "label": "b", "marks": null, "partId": "q10-a44a4e4c-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "When $ 5 0 \\mathrm{c m}^{3} $ of dilute sulfuric acid have been added, only barium sulfate and water are present in the mixture. Explain why this mixture does not conduct electricity. Refer to the type of bonding in barium sulfate and in water in your answer.", "label": "b-i", "marks": null, "partId": "q10-a44a4e4c-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Name a technique the student could use to separate barium sulfate from the mixture after $ 1 0 0 \\mathrm{c m}^{3} $ of dilute sulfuric acid has been added.", "label": "b-ii", "marks": null, "partId": "q10-a44a4e4c-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 10, "figures": [{"url": "assets/crop_1_1789055743547.png", "width": 1090, "format": "png", "height": 1114, "sha256": "d4968d20a458cd60020a832dd59d6b301f9c04ac925c8e2a31ba7b0c08ed53d7", "assetId": "img:d4968d20a458cd60020a832dd59d6b301f9c04ac925c8e2a31ba7b0c08ed53d7", "mimeType": "image/jpeg", "elementId": "e000177", "sourceName": "assets/crop_1_1789055743547.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q10-a44a4e4c", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000172"]}, {"mcq": false, "qwc": false, "stem": "This question is about the reduction of tungsten oxide, $ \\mathrm{W O}_{3} $", "marks": 0, "parts": [{"qwc": false, "text": "A teacher uses this apparatus to reduce tungsten oxide. This is the teacher''s method. record the mass of a weighing boat add tungsten oxide and record the mass again heat the weighing boat and tungsten oxide strongly for two minutes and then allow to cool record the mass of the weighing boat and its contents", "label": "a", "marks": null, "partId": "q11-a44a4e4c-pa", "figures": [{"url": "assets/crop_1_1789055743566.png", "width": 1336, "format": "png", "height": 416, "sha256": "7645bdfcde90fe44f4c457edc10f610f5d4c64db62f7d216524a776abdfbc708", "assetId": "img:7645bdfcde90fe44f4c457edc10f610f5d4c64db62f7d216524a776abdfbc708", "mimeType": "image/jpeg", "elementId": "e000189", "sourceName": "assets/crop_1_1789055743566.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Complete the equation by adding the state symbols. $\\mathrm {W O} _ {3} (\\dots \\dots \\dots \\dots) + 3 \\mathrm {H} _ {2} (\\dots \\dots \\dots \\dots) \\rightarrow \\mathrm {W} (\\dots \\dots \\dots \\dots) + 3 \\mathrm {H} _ {2} \\mathrm {O} (\\dots \\dots \\dots \\dots)$", "label": "a-i", "marks": null, "partId": "q11-a44a4e4c-pa-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give an addition to the method to check that the tungsten oxide has been completely reduced.", "label": "a-ii", "marks": null, "partId": "q11-a44a4e4c-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The table shows the teacher''s results. Use the teacher''s results to show that the empirical formula of tungsten oxide is $ \\mathrm{W O_{3}} $ [for tungsten, $ A_{\\mathrm{r}}=1 8 4 $ for oxygen, $ A_{\\mathrm{r}}=1 6 $", "label": "a-iii", "marks": null, "partId": "q11-a44a4e4c-pa-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The teacher wears eye protection and a lab coat during the experiment. Give one other safety precaution the teacher should take.", "label": "a-iv", "marks": null, "partId": "q11-a44a4e4c-pa-iv", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "In industry, tungsten oxide is reduced on a large scale using hydrogen. The percentage yield of tungsten is 73.5% This is the equation for the reaction. $\\mathrm {W O} _ {3} + 3 \\mathrm {H} _ {2} \\rightarrow \\mathrm {W} + 3 \\mathrm {H} _ {2} \\mathrm {O}$ Calculate the mass, in tonnes, of tungsten that is produced when 2784 tonnes of tungsten oxide are reacted with an excess of hydrogen. [1 tonne = 1 $ \\times10^{6} $ g] [for tungsten, $ A_{\\mathrm{r}}=1 8 4 $ for oxygen, $ A_{\\mathrm{r}}=1 6 $", "label": "b", "marks": null, "partId": "q11-a44a4e4c-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 11, "figures": [{"url": "assets/crop_1_1789055743566.png", "width": 1336, "format": "png", "height": 416, "sha256": "7645bdfcde90fe44f4c457edc10f610f5d4c64db62f7d216524a776abdfbc708", "assetId": "img:7645bdfcde90fe44f4c457edc10f610f5d4c64db62f7d216524a776abdfbc708", "mimeType": "image/jpeg", "elementId": "e000189", "sourceName": "assets/crop_1_1789055743566.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.45, "marksKnown": false, "questionId": "q11-a44a4e4c", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000199"]}], "paperTotal": 110, "schemaVersion": "1.0", "sectionTotals": {}, "questionTotals": {"1": 6, "2": 8, "3": 9, "4": 12, "6": 9, "7": 15, "8": 10, "9": 10, "10": 10}, "reviewRequired": true, "extractionMethod": "glm-ocr-qp-v1", "frontMatterFigures": []}', '{"paper": {"board": "Edexcel", "session": "Summer 2022", "subject": null, "duration": null, "examDate": null, "logNumber": "P70946A", "qualification": null, "paperReference": null, "publicationCode": "4CH1_1CR_2206_MS", "canonicalDocumentId": "240b0052-eb0f-58a9-9406-5a5e9af6a653"}, "entries": [{"mcq": false, "qwc": false, "label": "1(a)", "marks": 4, "number": 1, "entryId": "ms-240b0052-q1a", "guidance": [{"kind": "note", "text": "1 mark each correct answer"}, {"kind": "note", "text": "(b)"}, {"kind": "note", "text": "Similarity = number of protonsDifference = number of neutrons"}, {"kind": "allow", "text": "ALLOW both isotopes have4 protonsALLOW references to electronsALLOW stated exampleseg one isotope has5 neutrons,the other has6 neutronsIf similarity: same atomic number and difference: different mass numberALLOW1 mark"}], "answerText": "Atomic number of this atom4Mass number of this atom9Period number of this element2Number of electrons in the2+ion formed from this atom2", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "2(a)", "marks": 2, "number": 2, "entryId": "ms-240b0052-q2a", "guidance": [{"kind": "note", "text": "Unit"}, {"kind": "allow", "text": "ALLOW ml"}, {"kind": "allow", "text": "ALLOW words"}, {"kind": "note", "text": "e.g.grams"}, {"kind": "allow", "text": "ALLOW weighing"}, {"kind": "note", "text": "machine"}, {"kind": "allow", "text": "ALLOW kg"}, {"kind": "note", "text": "1 mark each correct row/column"}, {"kind": "note", "text": "Mark horizontally or vertically (whichever benefits the candidate)"}, {"kind": "note", "text": "cm3"}, {"kind": "note", "text": "g OR mg"}, {"kind": "note", "text": "(b)(i)"}, {"kind": "note", "text": "M1 to cool (the water vapour/steam)"}, {"kind": "allow", "text": "ALLOW to keep condenser cool"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "M1 add silver nitrate/AgNO3(solution)"}, {"kind": "ignore", "text": "IGNORE addition of nitric acid but REJECT addition of hydrochloric/sulfuric acid for M1"}, {"kind": "note", "text": "(iii)"}, {"kind": "note", "text": "M1 measure its boiling point"}, {"kind": "allow", "text": "ALLOW boil it"}, {"kind": "note", "text": "M2 (freezing point is) 0℃"}, {"kind": "allow", "text": "ALLOW freeze it"}], "answerText": "Apparatus\n(gas) syringe\n(top pan) balance OR\n(weighing) scales\nM2 so the water vapour/steam condenses\nM2 white precipitate\nM2 (boiling point is) 100℃\nOR\nM1 measure its freezing point", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "3(a)(i)", "marks": 1, "number": 3, "entryId": "ms-240b0052-q3ai", "guidance": [{"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "A and B"}, {"kind": "note", "text": "(iii)"}, {"kind": "note", "text": "M1 2 and 8"}, {"kind": "note", "text": "0.25 without working scores 2"}, {"kind": "allow", "text": "ALLOW M1 for 1.8-2.2 and 8 and ALLOW M2 ECF as long as correctly evaluated to at least 2 SF"}, {"kind": "note", "text": "(Special case if used ruler and then) 1.4-1.7 and 5.9-6.2 used no M1 but ALLOW M2 ECF as long as correctly evaluated to at least 2 SF"}, {"kind": "note", "text": "(iv)"}, {"kind": "note", "text": "the dye is the most soluble (in the solvent/water)"}, {"kind": "note", "text": "(b)"}, {"kind": "note", "text": "Any four from"}, {"kind": "note", "text": "M1 draw start line in pencil"}, {"kind": "note", "text": "M2 use same food colourings/use same solvent/use same (type of chromatography) paper"}, {"kind": "note", "text": "M3 place (spots/samples of) A, B, C, D/food colourings on the start line OWTTE"}, {"kind": "note", "text": "M4 (place paper in beaker) with start line above solvent OWTTE"}, {"kind": "note", "text": "M5 (remove paper/stop experiment) when solvent almost reaches top of paper/when spots stop moving OWTTE"}, {"kind": "note", "text": "M6 mark solvent front (on paper)"}, {"kind": "note", "text": "M7 (remove paper from beaker and) allow to dry"}, {"kind": "allow", "text": "ALLOW water for solvent throughout"}, {"kind": "allow", "text": "ALLOW dye for food colouring throughout"}, {"kind": "ignore", "text": "IGNORE length of paper"}], "answerText": "B", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "4(a)(i)", "marks": 1, "number": 4, "entryId": "ms-240b0052-q4ai", "guidance": [{"kind": "allow", "text": "ALLOW names of elementsApply list principle"}, {"kind": "note", "text": "Any one fromSCl"}, {"kind": "allow", "text": "ALLOW names of elements"}, {"kind": "note", "text": "(b)"}, {"kind": "note", "text": "same number/three electrons in the outer shell"}, {"kind": "allow", "text": "ALLOW valence shell"}, {"kind": "note", "text": "(c)"}, {"kind": "note", "text": "M1 Xe or xenon"}, {"kind": "note", "text": "M2 as it has a full outer shell(of electrons)"}, {"kind": "allow", "text": "ALLOW has eight electrons in outer shellACCEPT does not(easily) gain/lose/share electronsM2 dep on M1"}, {"kind": "note", "text": "(d)(i)"}, {"kind": "note", "text": "M1(universal indicator turns) blue or purple"}, {"kind": "note", "text": "M2 because an alkali is produced"}, {"kind": "note", "text": "ACCEPT OH-/hydroxide ions are producedALLOW sodium hydroxide is a base/a base is produced"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "(similarity) any one from:(both)effervesce melt/turn into a spheremove on surfaceuniversal indicator turns the same colour"}, {"kind": "allow", "text": "ALLOW fizzes/bubbles"}, {"kind": "note", "text": "(difference) any one from:potassium gives a lilac flamepotassium moves fasterpotassium effervesces faster"}, {"kind": "allow", "text": "ALLOW faster/more vigorous reaction for potassiumALLOW reverse arguments for sodium"}, {"kind": "example-calculation", "text": "Example calculation"}, {"kind": "note", "text": "correct answer with no working scores 3 marks"}, {"kind": "note", "text": "M1(moles of hydrogen)0.036÷2OR0.018molM20.018×6.0×1023OR1.08×1022molecu