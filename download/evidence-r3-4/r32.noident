INSERT INTO public.question_parts VALUES ('082cc57a-7d86-482a-b78d-febdadab767a', '3f17bd9e-a784-4dd5-8706-e3dbaf883258', 'a-ii', 'Write a chemical equation for the reaction between lead(II) nitrate and the substance you identified in (a)(i).', NULL, 0, 1, '2026-09-13 12:57:41.989825+00');
