INSERT INTO public.question_parts VALUES ('959c6b18-fbfd-418e-8e8b-121e87564791', 'a44734c7-addd-4e85-bf72-83d57671a33a', 'a', 'Use the results of the experiment to explain what type of reaction is taking place when ammonium nitrate is added to water.', NULL, 2, 0, '2026-09-13 12:54:39.999775+00');
INSERT INTO public.question_parts VALUES ('eb2208bb-6458-4031-8520-3156cb51c67a', 'a44734c7-addd-4e85-bf72-83d57671a33a', 'b', 'Show that the heat energy change, Q, is about 2400 J. [mass of 1.00 $ cm^{3} $ of solution = 1.00 g] [for the solution, c = 4.18 J/g/ $ ^{\circ} C $]', NULL, 0, 1, '2026-09-13 12:54:39.999809+00');
INSERT INTO public.question_parts VALUES ('dca28ad9-f574-4baa-9ad9-c0fd2790655e', 'a44734c7-addd-4e85-bf72-83d57671a33a', 'c', 'Use your answer to part (b) to calculate the enthalpy change, $ \Delta H $ , in kilojoules per mole of ammonium nitrate. [M $ _{r} $ of ammonium nitrate = 80.0] Include a sign in your answer.', NULL, 0, 2, '2026-09-13 12:54:39.999843+00');
INSERT INTO public.question_parts VALUES ('fbabe215-58ac-4e96-bf66-e938a8f5f20c', 'ff600e14-d77d-4107-b136-9fbac81fce06', 'a', 'Plot the student''s results on the grid.', NULL, 0, 0, '2026-09-13 12:54:39.999886+00');
INSERT INTO public.question_parts VALUES ('9ab5b71d-9405-4f21-bfe9-c1a2a2530ec8', 'ff600e14-d77d-4107-b136-9fbac81fce06', 'a-ii', 'Draw a curve of best fit.', NULL, 0, 1, '2026-09-13 12:54:39.999927+00');
INSERT INTO public.question_parts VALUES ('9fcc20ff-d18d-4415-aad2-ffc28e6fe9ad', 'ff600e14-d77d-4107-b136-9fbac81fce06', 'b', 'The student repeats the experiment using 0.043 g of magnesium ribbon $ 5 0 \mathrm{c m}^{3} $ of 2.00 mol/dm $ ^{3} $ hydrochloric acid Draw, on the grid in part (a), the curve you would expect in this experiment. Label this curve Y.', NULL, 0, 2, '2026-09-13 12:54:39.999957+00');
INSERT INTO public.question_parts VALUES ('e7b9902d-b363-428b-9416-2c2c039f9670', 'ff600e14-d77d-4107-b136-9fbac81fce06', 'b-ii', 'The student repeats the experiment again, using 0.086g of magnesium ribbon $ 5 0 \mathrm{c m}^{3} $ of $ 2. 0 0 \mathrm{m o l} / \mathrm{d m}^{3} $ hydrochloric acid a slightly higher temperature than the first experiment Draw, on the grid in part (a), the curve you would expect in this experiment. Label this curve Z.', NULL, 0, 3, '2026-09-13 12:54:39.999992+00');
INSERT INTO public.question_parts VALUES ('139d49f7-efa0-458a-90b3-956e94a4fff1', 'ff600e14-d77d-4107-b136-9fbac81fce06', 'c', 'The expected volume of gas produced in the first experiment is $ 8 6 \mathrm{c m}^{3} $ Suggest why the volume collected is less than the expected volume.', NULL, 0, 4, '2026-09-13 12:54:40.000022+00');
INSERT INTO public.question_parts VALUES ('09fed938-9e66-4010-8027-429c995bee0c', '3fb03be1-2a4f-4f40-a388-ece2f3936427', 'b-iv', '$ C_{5} H_{1 2} $ has three isomers. The displayed formula for one of these isomers is Draw the displayed formulae of the other two isomers.', NULL, 0, 5, '2026-09-13 12:54:40.215369+00');
INSERT INTO public.question_parts VALUES ('b1effc4a-a03d-4af3-9c26-e986b06ecdc2', 'ff600e14-d77d-4107-b136-9fbac81fce06', 'd', 'The student uses a graduated beaker to measure the volume of dilute hydrochloric acid. Explain why it is not necessary to use a measuring cylinder in this experiment.', NULL, 0, 5, '2026-09-13 12:54:40.000054+00');
INSERT INTO public.question_parts VALUES ('0d481500-ac7e-4a7f-8608-7f43265ac118', 'ff600e14-d77d-4107-b136-9fbac81fce06', 'e', 'The ionic equation for the reaction between magnesium and hydrochloric acid is $\mathrm {M g} (\mathrm {s}) + 2 \mathrm {H} ^ {+} (\mathrm {a q}) \rightarrow \mathrm {M g} ^ {2 +} (\mathrm {a q}) + \mathrm {H} _ {2} (\mathrm {g})$ Use the information in this equation, and the particle collision theory, to explain why the rate of reaction decreases during each of the experiments.', NULL, 0, 6, '2026-09-13 12:54:40.000083+00');
INSERT INTO public.question_parts VALUES ('898b08a1-ab46-4154-a34c-2ab566f74d89', '6c2f1e81-a5a0-4064-9234-f1f15c9f683f', 'a', 'State why the acid is warmed in stage 2.', NULL, 0, 0, '2026-09-13 12:54:40.000121+00');
INSERT INTO public.question_parts VALUES ('65bc5af8-6f85-4f67-ab98-de63255c1ed0', '6c2f1e81-a5a0-4064-9234-f1f15c9f683f', 'b', 'State how the student would know that the copper(II) oxide is in excess in stage 4.', NULL, 0, 1, '2026-09-13 12:54:40.000152+00');
INSERT INTO public.question_parts VALUES ('4277dc2d-942b-4f30-8bad-ca411d39ec9e', '6c2f1e81-a5a0-4064-9234-f1f15c9f683f', 'c', 'State why the mixture is filtered in stage 5.', NULL, 0, 2, '2026-09-13 12:54:40.000187+00');
INSERT INTO public.question_parts VALUES ('0629fc9e-4106-4193-b112-a3a1c0d07d28', '6c2f1e81-a5a0-4064-9234-f1f15c9f683f', 'd', 'State the colour of the filtrate obtained in stage 5.', NULL, 0, 3, '2026-09-13 12:54:40.000219+00');
INSERT INTO public.question_parts VALUES ('74c85ae3-c013-43b6-bcbd-0b64b2b1983d', '6c2f1e81-a5a0-4064-9234-f1f15c9f683f', 'e', 'Describe how the student could obtain a pure, dry sample of hydrated copper(II) sulfate crystals from the filtrate in stage 6.', NULL, 0, 4, '2026-09-13 12:54:40.000254+00');
INSERT INTO public.question_parts VALUES ('c22d573f-0aed-4405-aea8-7a5c15efa870', '6c2f1e81-a5a0-4064-9234-f1f15c9f683f', 'f', 'The overall equation for the formation of hydrated copper(II) sulfate crystals from copper(II) oxide is $\mathrm {C u O (s)} + \mathrm {H} _ {2} \mathrm {S O} _ {4} (\mathrm {a q}) + 4 \mathrm {H} _ {2} \mathrm {O} (\mathrm {I}) \rightarrow \mathrm {C u S O} _ {4}. 5 \mathrm {H} _ {2} \mathrm {O} (\mathrm {s})$', NULL, 0, 5, '2026-09-13 12:54:40.000287+00');
INSERT INTO public.question_parts VALUES ('193d11b7-1337-4319-9906-fc6ee6ac214b', '6c2f1e81-a5a0-4064-9234-f1f15c9f683f', 'f-i', 'In an experiment, a student completely reacts 9.54 g copper(II) oxide. Show that the maximum possible mass of $ \mathrm{C u S O_{4}. 5 H_{2} O} $ crystals that can be obtained is about 30 g. $[ M _ {\mathrm {r}} \mathrm {o f C u O} = 7 9. 5 M _ {\mathrm {r}} \mathrm {o f C u S O} _ {4}. 5 \mathrm {H} _ {2} \mathrm {O} = 2 4 9. 5 ]$ Give your answer to an appropriate number of significant figures.', NULL, 0, 6, '2026-09-13 12:54:40.000325+00');
INSERT INTO public.question_parts VALUES ('21e2b1f2-c4da-4cfe-b144-e5e2fc839ed4', '6c2f1e81-a5a0-4064-9234-f1f15c9f683f', 'f-ii', 'In this experiment, the actual yield of $ \mathrm{C u S O_{4}. 5 H_{2} O} $ crystals is 23.92 g. Calculate the percentage yield of $ \mathrm{C u S O_{4}. 5 H_{2}O} $', NULL, 0, 7, '2026-09-13 12:54:40.000359+00');
INSERT INTO public.question_parts VALUES ('9e34fb0f-a930-41ac-93b4-352078ad1faf', 'bb91fe62-dacd-4eca-b55c-aea353a1e21d', 'a', 'Complete the table to show the observation made in each test.', NULL, 0, 0, '2026-09-13 12:54:40.000402+00');
INSERT INTO public.question_parts VALUES ('705c0c71-4faf-4803-8e8f-9f30a77efa66', 'bb91fe62-dacd-4eca-b55c-aea353a1e21d', 'b', 'A student needs to find the value of x in the formula $ \mathrm{(N H_{4})_{2} S O_{4}. F e_{2}(S O_{4})_{3}. x H_{2} O} $ He uses this apparatus. hydrated ammonium iron(III) sulfate The hydrated solid decomposes when heated gently. The equation for the reaction is $\left(\mathrm {N H} _ {4}\right) _ {2} \mathrm {S O} _ {4}. \mathrm {F e} _ {2} \left(\mathrm {S O} _ {4}\right) _ {3}. \mathrm {x H} _ {2} \mathrm {O} \rightarrow \left(\mathrm {N H} _ {4}\right) _ {2} \mathrm {S O} _ {4}. \mathrm {F e} _ {2} \left(\mathrm {S O} _ {4}\right) _ {3} + \mathrm {x H} _ {2} \mathrm {O}$ The table shows the student''s results.', NULL, 0, 1, '2026-09-13 12:54:40.000434+00');
INSERT INTO public.question_parts VALUES ('b5eb50cb-f309-4277-925e-da3cf29f193b', 'bb91fe62-dacd-4eca-b55c-aea353a1e21d', 'b-i', 'Calculate the mass of $ \mathrm{(N H_{4})_{2} S O_{4}. F e_{2}(S O_{4})_{3}} $ produced by heating. $\mathrm {m a s s o f} \left(\mathrm {N H} _ {4}\right) _ {2} \mathrm {S O} _ {4}. \mathrm {F e} _ {2} \left(\mathrm {S O} _ {4}\right) _ {3} =$', NULL, 0, 2, '2026-09-13 12:54:40.000483+00');
INSERT INTO public.question_parts VALUES ('b1b6436a-cd9b-473e-a484-4156167ca4b4', 'bb91fe62-dacd-4eca-b55c-aea353a1e21d', 'b-ii', 'Calculate the mass of water produced. $\mathrm {m a s s o f w a t e r} =$', NULL, 0, 3, '2026-09-13 12:54:40.000521+00');
INSERT INTO public.question_parts VALUES ('68aff8e9-0512-4961-9bdf-1b38c351300c', 'bb91fe62-dacd-4eca-b55c-aea353a1e21d', 'b-iii', 'Calculate the value of x. [ $ M_{\mathrm{r}} $ of $ \mathrm{(N H_{4})_{2} S O_{4}. F e_{2}(S O_{4})_{3}}=5 3 2 $ and $ M_{\mathrm{r}} $ of $ \mathrm{H_{2}O}=1 8 ] $ Give your answer to the nearest whole number.', NULL, 0, 4, '2026-09-13 12:54:40.000564+00');
