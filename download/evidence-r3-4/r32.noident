"qwc": false, "label": "3(c)", "marks": 3, "number": 3, "entryId": "ms-fd84b468-q3c", "guidance": [{"kind": "note", "text": "accept reverse arguments for hydrogen chloride"}], "answerText": "An explanation that makes reference to the following three points:\n• C(1)\n• because ammonia molecules have lower mass or smaller $ M_{r} $ (hence travel faster)(1)\n• and so travel further in the same time(1)", "confidence": 0.75, "markPoints": [{"ecf": false, "text": "An explanation that makes reference to the following three points:\n• C", "marks": 1, "reject": false, "ordinal": 1, "rawText": "An explanation that makes reference to the following three points:\n• C", "anyTwoFrom": false, "dependentOn": [], "alternatives": []}, {"ecf": false, "text": "• because ammonia molecules have lower mass", "marks": 1, "reject": false, "ordinal": 2, "rawText": "• because ammonia molecules have lower mass or smaller $ M_{r} $ (hence travel faster)", "anyTwoFrom": false, "dependentOn": [], "alternatives": ["smaller $ M_{r} $ (hence travel faster)"]}, {"ecf": false, "text": "• and so travel further in the same time", "marks": 1, "reject": false, "ordinal": 3, "rawText": "• and so travel further in the same time", "anyTwoFrom": false, "dependentOn": [], "alternatives": []}], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "4(a)", "marks": 2, "number": 4, "entryId": "ms-fd84b468-q4a", "guidance": [{"kind": "note", "text": "final answer consequential on syringe readings"}], "answerText": "35(1)\n41(1)", "confidence": 0.75, "markPoints": [{"ecf": false, "text": "35", "marks": 1, "reject": false, "ordinal": 1, "rawText": "35", "anyTwoFrom": false, "dependentOn": [], "alternatives": []}, {"ecf": false, "text": "41", "marks": 1, "reject": false, "ordinal": 2, "rawText": "41", "anyTwoFrom": false, "dependentOn": [], "alternatives": []}], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "4(b)", "marks": 3, "nu