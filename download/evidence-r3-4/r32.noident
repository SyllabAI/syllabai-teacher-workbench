INSERT INTO public.question_parts VALUES ('d1e7940e-df44-4b9c-b9cb-d6eaf75f57b6', '4ac5844b-5515-4c51-b260-700048029dc9', 'd', 'Ethene and acetylene can both be used for welding metals. The equations for the reactions of these gases in welding are ethene acetylene $\mathrm {C} _ {2} \mathrm {H} _ {4} + 3 \mathrm {O} _ {2} \rightarrow 2 \mathrm {C O} _ {2} + 2 \mathrm {H} _ {2} \mathrm {O}$ $\mathrm {C} _ {2} \mathrm {H} _ {2} + 2. 5 \mathrm {O} _ {2} \rightarrow 2 \mathrm {C O} _ {2} + \mathrm {H} _ {2} \mathrm {O}$ One problem with using hydrocarbons as fuels is incomplete combustion.', NULL, 0, 4, '2026-09-13 12:59:08.999319+00');
INSERT INTO public.question_parts VALUES ('50ff2062-cb91-47a8-a9d8-59f945afb36c', '4ac5844b-5515-4c51-b260-700048029dc9', 'd-i', 'Incomplete combustion is a bigger problem with ethene than with acetylene. Suggest why.', NULL, 0, 5, '2026-09-13 12:59:08.999383+00');
