INSERT INTO public.question_parts VALUES ('0dac6e39-a730-4bba-a3c2-ad223e5f3d7a', 'd8f0bca4-0689-4453-a0ee-9c9d048781c9', 'a', 'What is meant by the term atomic number? A the number of neutrons in an atom B the number of protons in an atom C the number of protons plus the number of electrons in an atom D the number of protons plus the number of neutrons in an atom', NULL, 1, 0, '2026-09-13 12:53:56.169239+00');
INSERT INTO public.question_parts VALUES ('b4a46dda-751f-49dc-941d-fa58dbac63d8', 'd8f0bca4-0689-4453-a0ee-9c9d048781c9', 'a-ii', 'Elements in the same group of the Periodic Table have similar chemical properties. This is because their atoms contain the same number of A protons B neutrons C electrons in the outer shell D protons and neutrons', NULL, 1, 1, '2026-09-13 12:53:56.169269+00');
