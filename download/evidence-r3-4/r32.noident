INSERT INTO public.questions VALUES ('cf2b2d22-dde6-438c-8ef9-a1932c6ba6e6', 'q05-0f21a459', 'STRUCTURED', '(a) Chlorine, bromine and iodine are elements in the Periodic Table. Explain how the position of these elements in the Periodic Table depends on their electronic configurations.', 12, 3, 1080, NULL, 'a526595a-8f0f-4906-835f-97f365328afd', 'PAST_PAPER', true, 1, '2026-09-13 12:55:23.308845+00', 'a4089424-462f-4389-bf12-de41a9121f31');
INSERT INTO public.questions VALUES ('bae66d66-c50a-41f6-8cb2-8ab815c31620', 'q06-0f21a459', 'STRUCTURED', 'The table shows the molecular formulae of six organic compounds, A, B, C, D, E and F.', 1, 3, 90, NULL, 'a526595a-8f0f-4906-835f-97f365328afd', 'PAST_PAPER', true, 1, '2026-09-13 12:55:23.309272+00', 'a4089424-462f-4389-bf12-de41a9121f31');
INSERT INTO public.questions VALUES ('2022f559-62aa-417a-a346-2151050624eb', 'q07-0f21a459', 'STRUCTURED', 'Dilute hydrochloric acid reacts with a solution of sodium thiosulfate $ \mathrm{(N a_{2} S_{2} O_{3})} $ to form a precipitate. The equation for the reaction is $\mathrm {N a} _ {2} \mathrm {S} _ {2} \mathrm {O} _ {3} (\mathrm {a q}) + 2 \mathrm {H C l} (\mathrm {a q}) \rightarrow 2 \mathrm {N a C l} (\mathrm {a q}) + \mathrm {S} (\mathrm {s}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {I}) + \mathrm {S O} _ {2} (\mathrm {g})$', 1, 3, 90, NULL, 'a526595a-8f0f-4906-835f-97f365328afd', 'PAST_PAPER', true, 1, '2026-09-13 12:55:23.309662+00', 'a4089424-462f-4389-bf12-de41a9121f31');
INSERT INTO public.questions VALUES ('d9fb01b9-d115-445c-986b-64a176780b69', 'q08-0f21a459', 'STRUCTURED', 'A student uses this apparatus to investigate the heat energy change when a salt dissolves in water to form a solution. This is the student''s method. add $ 5 0 \mathrm{c m}^{3} $ of distilled water to a polystyrene cup record the initial temperature of the water add a known mass of solid anhydrous copper(II) sulfate to the polystyrene cup and stir the solution with the thermometer until all the solid has dissolved record the maximum temperature of the copper(II) sulfate solution', 1, 3, 90, NULL, 'a526595a-8f0f-4906-835f-97f365328afd', 'PAST_PAPER', true, 1, '2026-09-13 12:55:23.310033+00', 'a4089424-462f-4389-bf12-de41a9121f31');
INSERT INTO public.questions VALUES ('bebb6764-ccfa-4993-89ef-774fd04f66b9', 'q09-0f21a459', 'STRUCTURED', 'Sodium hydrogencarbonate $ \mathrm{(N a H C O_{3})} $ is also known as baking soda. Baking soda can be used to make cakes increase in size in an oven. This is the equation for the reaction that takes place when baking soda is heated. $2 \mathrm {N a H C O} _ {3} (\mathrm {s}) \rightarrow \mathrm {N a} _ {2} \mathrm {C O} _ {3} (\mathrm {s}) + \mathrm {C O} _ {2} (\mathrm {g}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {g})$', 12, 3, 1080, NULL, 'a526595a-8f0f-4906-835f-97f365328afd', 'PAST_PAPER', true, 1, '2026-09-13 12:55:23.310422+00', 'a4089424-462f-4389-bf12-de41a9121f31');
INSERT INTO public.questions VALUES ('792c0f93-ff99-4491-9a07-bf07f672f760', 'q10-0f21a459', 'STRUCTURED', 'The table gives information about some lead compounds.', 13, 3, 1170, NULL, 'a526595a-8f0f-4906-835f-97f365328afd', 'PAST_PAPER', true, 1, '2026-09-13 12:55:23.310795+00', 'a4089424-462f-4389-bf12-de41a9121f31');
INSERT INTO public.questions VALUES ('428dfad0-939d-42be-8f04-01976a8cb984', 'q01-6398c196', 'STRUCTURED', 'A small piece of potassium is added to water. The list below shows some statements. Only four of these statements describe what happens when potassium reacts with water. Place a cross ( $ \times $ ) in the box next to each of the four correct statements. potassium oxide solution is formed fizzing occurs potassium sinks to the bottom of the water potassium moves around potassium melts bubbles of oxygen gas are produced a lilac flame is seen potassium reacts to form an acidic solution', 4, 3, 360, NULL, 'fc88d2e5-8e14-40b5-847f-2980250bb5ae', 'PAST_PAPER', true, 1, '2026-09-13 12:57:41.681298+00', 'd6424e6f-880f-4711-b130-fcc4569e424c');
INSERT INTO public.questions VALUES ('bf559bd2-4a7a-47c6-9c45-57c4f92c519c', 'q02-6398c196', 'STRUCTURED', 'Choose the name of a substance from the box to answer parts (a) to (e). Each name may be used once, more than once or not at all. ammonia chlorine haematite iron sodium hydroxide Give the name of', 5, 3, 450, NULL, 'fc88d2e5-8e14-40b5-847f-2980250bb5ae', 'PAST_PAPER', true, 1, '2026-09-13 12:57:41.682998+00', 'd6424e6f-880f-4711-b130-fcc4569e424c');
INSERT INTO public.questions VALUES ('7299f4f3-0e3f-4873-a63f-019f676d0bb3', 'q04-6398c196', 'STRUCTURED', 'Here are some statements about the compound ethene. ethene has the displayed formula ethene is a gas at room temperature ethene burns with a smoky flame ethene is unsaturated ethene is insoluble in water ethene can be prepared from ethanol ethene is used to make the polymer poly(ethene)', 1, 3, 90, NULL, 'fc88d2e5-8e14-40b5-847f-2980250bb5ae', 'PAST_PAPER', true, 1, '2026-09-13 12:57:41.684114+00', 'd6424e6f-880f-4711-b130-fcc4569e424c');
INSERT INTO public.questions VALUES ('424fe93e-0f36-4911-9eb9-7f02a6326af1', 'q01-c4075b63', 'STRUCTURED', 'The melting points of three related compounds are $\begin{array}{l l} \mathrm {c a p r i c a c i d} & 3 2 ^ {\circ} \mathrm {C} \\ \mathrm {f o r m i c a c i d} & 8 ^ {\circ} \mathrm {C} \\ \mathrm {p a l m i t i c a c i d} & 6 3 ^ {\circ} \mathrm {C} \end{array}$ The boiling point of all these compounds is above 100 $ ^{\circ} \mathrm{C} $', 4, 3, 360, NULL, 'fe86e869-d65f-40ed-8a28-9c17856e9fdf', 'PAST_PAPER', true, 1, '2026-09-13 12:58:26.052166+00', 'f4fe6326-5a81-493b-90c5-eab47ad9fbbf');
INSERT INTO public.questions VALUES ('7123bb86-3a36-4974-888a-127c58f4e765', 'q02-c4075b63', 'STRUCTURED', 'A student produces this chromatogram for four dyes, A, B, C and D.', 4, 3, 360, NULL, 'fe86e869-d65f-40ed-8a28-9c17856e9fdf', 'PAST_PAPER', true, 1, '2026-09-13 12:58:26.061143+00', 'f4fe6326-5a81-493b-90c5-eab47ad9fbbf');
INSERT INTO public.questions VALUES ('ae4d8ca8-41ef-45ed-aac3-94e6e00be3f0', 'q03-c4075b63', 'STRUCTURED', 'The photograph shows an aeroplane that has a rocket motor.', 1, 3, 90, NULL, 'fe86e869-d65f-40ed-8a28-9c17856e9fdf', 'PAST_PAPER', true, 1, '2026-09-13 12:58:26.061728+00', 'f4fe6326-5a81-493b-90c5-eab47ad9fbbf');
INSERT INTO public.questions VALUES ('d600f30e-73ca-4334-abac-930ed7672ac4', 'q04-c4075b63', 'STRUCTURED', 'An excess of dilute hydrochloric acid was added to a lump of calcium carbonate in a beaker. The mass of the beaker and contents was recorded every 30 seconds. The graph shows the results. Mass of beaker and contents in grams $\mathrm {C a C O} _ {3} (\mathrm {s}) + 2 \mathrm {H C l} (\mathrm {a q}) \rightarrow \mathrm {C a C l} _ {2} (\mathrm {a q}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {I}) + \mathrm {C O} _ {2} (\mathrm {g})$ The equation for the reaction is', 11, 3, 990, NULL, 'fe86e869-d65f-40ed-8a28-9c17856e9fdf', 'PAST_PAPER', true, 1, '2026-09-13 12:58:26.062113+00', 'f4fe6326-5a81-493b-90c5-eab47ad9fbbf');
INSERT INTO public.questions VALUES ('1f4ac661-ae21-4bcc-b3f9-3b8696953444', 'q05-c4075b63', 'STRUCTURED', 'Soluble salts can be made by reacting an acid with a metal hydroxide, a metal oxide, or a metal carbonate. Insoluble salts can be made by using a precipitation reaction.', 12, 3, 1080, NULL, 'fe86e869-d65f-40ed-8a28-9c17856e9fdf', 'PAST_PAPER', true, 1, '2026-09-13 12:58:26.062496+00', 'f4fe6326-5a81-493b-90c5-eab47ad9fbbf');
INSERT INTO public.questions VALUES ('b0afbfe9-8208-401a-805a-86408f6f122a', 'q06-c4075b63', 'STRUCTURED', 'This is a recipe for making plum wine. Dissolve 1.5 kg of sugar in 5 dm $ ^{3} $ of warm water. Add yeast and 8 kg of plums. Pour the mixture into a flask. Leave the flask for several weeks until the reaction has stopped. Remove the solid yeast and pour the clear liquid into bottles.', 11, 3, 990, NULL, 'fe86e869-d65f-40ed-8a28-9c17856e9fdf', 'PAST_PAPER', true, 1, '2026-09-13 12:58:26.062944+00', 'f4fe6326-5a81-493b-90c5-eab47ad9fbbf');
INSERT INTO public.questions VALUES ('dad80531-8c7c-4f9f-8471-509557b4e428', 'q01-7682f9e7', 'STRUCTURED', '(a) The box gives some methods used in the separation of mixtures. chromatography crystallisation evaporation filtration fractional distillation simple distillation Use words from the box to answer these questions. (i) Identify the method used to obtain pure water from sea water. (ii) Identify the method used to separate the dyes in a food colouring. (iii) Identify the method used to obtain ethanol from a mixture of ethanol and water.', 6, 3, 540, NULL, 'c6052352-0263-4d33-b606-b0febf011eeb', 'PAST_PAPER', true, 1, '2026-09-13 12:55:23.678463+00', '0d1e83c1-a893-422f-92ab-cc062f8a44e3');
INSERT INTO public.questions VALUES ('9fcdded0-5e72-42e8-a508-61b429b17987', 'q02-7682f9e7', 'STRUCTURED', 'The diagram shows the positions of some elements in the Periodic Table.', 5, 3, 450, NULL, 'c6052352-0263-4d33-b606-b0febf011eeb', 'PAST_PAPER', true, 1, '2026-09-13 12:55:23.679847+00', '0d1e83c1-a893-422f-92ab-cc062f8a44e3');
