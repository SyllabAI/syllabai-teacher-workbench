INSERT INTO public.document_chunks VALUES ('573c8066-b25a-4ede-9169-487b4f1b269b', '0622fc85-70d0-46e1-9c3e-f563d2b9d4bd', 7, '2 \mathrm {M g} + \mathrm {O} _ {2} \rightarrow 2 \mathrm {M g O}
