INSERT INTO public.document_chunks VALUES ('bf6db1dc-bac2-4f16-9bab-43c56a669eba', 'a0313071-97d3-4d47-95f6-5370381ef558', 5, 'percentage by volume of oxygen in air =
(Total for Question 4 = 10 marks)
5 This question is about alkanes and alkenes.
(a) The alkane $ \mathrm{C}_{5} \mathrm{H}_{1 2} $ has three isomers.
