INSERT INTO public.question_parts VALUES ('5159a610-c52c-4fdf-b05d-9b4a68336688', '2557f262-f31c-402d-866d-09adee16ab18', 'c', 'One method of obtaining ethene is by cracking crude oil fractions. Ethene can also be made by passing ethanol vapour over a hot aluminium oxide catalyst. The equation for the reaction is $\mathrm {C} _ {2} \mathrm {H} _ {5} \mathrm {O H} (\mathrm {g}) \rightarrow \mathrm {C} _ {2} \mathrm {H} _ {4} (\mathrm {g}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {g})$', NULL, 0, 4, '2026-09-13 13:00:40.602523+00');
