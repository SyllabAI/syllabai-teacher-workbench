INSERT INTO public.document_chunks VALUES ('c70735c4-b46b-46c7-8dd2-a39b13452973', '1f57c0bc-a6ac-4a44-b5cc-bc488ee6dead', 13, '(iv) The teacher wears eye protection and a lab coat during the experiment. Give one other safety precaution the teacher should take.
