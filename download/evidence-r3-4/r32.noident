INSERT INTO public.questions VALUES ('78470d42-c64e-4d59-b044-eab35578d719', 'q06-50791a3d', 'STRUCTURED', 'Titanium is an important metal in industry. Titanium dioxide $ \left( \mathrm{T i O}_{2} \right) $ can be converted into titanium metal in two stages. Stage 1 titanium dioxide is converted into titanium(IV) chloride $ \left( \mathrm{T i C l}_{4} \right) $ Stage 2 titanium(IV) chloride is converted into titanium', 9, 3, 810, NULL, '4140a519-e1d5-428c-a674-8e69a1e480d6', 'PAST_PAPER', true, 1, '2026-09-13 13:02:54.190452+00', '76582695-c3c4-44a0-a213-9be719c69d1a');
