INSERT INTO public.question_parts VALUES ('c887b5a0-649b-45ef-aa13-7ac62ecce875', 'd9a7596f-49e2-4115-bb49-900e1d40b8a4', 'c', 'This apparatus in the diagram is used to find the percentage of oxygen in air. The large pile of copper powder is heated, and the air in the syringe is passed several times from one gas syringe to the other. The large pile of copper powder turns black. The remaining gas is allowed to cool and its volume is measured.', NULL, 0, 2, '2026-09-13 12:53:11.867269+00');
