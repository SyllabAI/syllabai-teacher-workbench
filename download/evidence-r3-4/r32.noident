INSERT INTO public.document_chunks VALUES ('2b4f9de6-b463-4a76-b3a3-2f742fce207e', '5489f4e9-2a84-401b-a4f9-8a75d03dbc6f', 1, 'Pearson aspires to be the world''s leading learning company. Our aim is to help everyone progress in their lives through education. We believe in every kind of learning, for all kinds of people, wherever they are in the world. We''ve been involved in education for over 150 years, and by working across 70 countries, in 100 languages, we have built an international reputation for our commitment to high standards and raising achievement through innovation in education. Find out more about how we can help you and your students at: www.pearson.com/uk
