INSERT INTO public.question_parts VALUES ('722e0598-3bdc-4bfa-99a2-dad5870ad928', 'f259f116-99a4-44b6-a71e-ea47e220e765', 'c', 'Describe a test to show that the gas collected is hydrogen.', NULL, 0, 2, '2026-09-13 12:59:56.02491+00');
INSERT INTO public.question_parts VALUES ('cbe29478-9a0e-4798-9387-134743ceb2dc', '7cf54b3a-2ffb-482b-82e5-6461725d3f6b', 'a', 'Complete the table of information about two isotopes of potassium.', NULL, 0, 0, '2026-09-13 12:59:56.024991+00');
INSERT INTO public.question_parts VALUES ('ae7e420f-d7cc-4435-801f-a9a9c37927fd', '7cf54b3a-2ffb-482b-82e5-6461725d3f6b', 'a-ii', 'A sample of lithium has this percentage composition by mass. $^ {6} \mathrm {L i} = 7. 4 \% \quad^ {7} \mathrm {L i} = 9 2. 6 \%$ Use this information to calculate the relative atomic mass of lithium. Give your answer to one decimal place.', NULL, 0, 1, '2026-09-13 12:59:56.025053+00');
INSERT INTO public.question_parts VALUES ('3908ff18-448a-400b-b96c-dd98de368611', '7cf54b3a-2ffb-482b-82e5-6461725d3f6b', 'b', 'A reaction occurs when a small piece of potassium is added to water in a trough. State two observations that could be made during the reaction.', NULL, 0, 2, '2026-09-13 12:59:56.025103+00');
INSERT INTO public.question_parts VALUES ('4b39e4cb-2fb2-42d6-8d5d-c9177a95d90e', '7cf54b3a-2ffb-482b-82e5-6461725d3f6b', 'c', 'A few drops of phenolphthalein are added to the liquid in the trough at the end of the reaction. A colour change occurs.', NULL, 0, 3, '2026-09-13 12:59:56.025166+00');
INSERT INTO public.question_parts VALUES ('709772a5-4eb2-4c25-a92a-6ee3f8954922', '7cf54b3a-2ffb-482b-82e5-6461725d3f6b', 'c-i', 'State the final colour of the liquid in the trough.', NULL, 0, 4, '2026-09-13 12:59:56.025222+00');
INSERT INTO public.question_parts VALUES ('79ea8e29-d64f-41a4-95df-75495b21ba3c', '7cf54b3a-2ffb-482b-82e5-6461725d3f6b', 'c-ii', 'Give the formula of the ion formed during the reaction that causes this colour change.', NULL, 0, 5, '2026-09-13 12:59:56.025278+00');
INSERT INTO public.question_parts VALUES ('33790a1b-73ad-475e-97f9-39a6fd856e95', '7cf54b3a-2ffb-482b-82e5-6461725d3f6b', 'd', 'The electronic configurations of lithium and potassium are Li 2,1 K 2,8,8,1 Explain why potassium is more reactive than lithium.', NULL, 0, 6, '2026-09-13 12:59:56.025333+00');
INSERT INTO public.question_parts VALUES ('b9ce8f44-a735-47fa-9965-39dce20567da', 'a5b6b77b-3994-493a-a654-16a14aa5be3f', 'a', 'Explain, with reference to these equations, two advantages of using lithium peroxide rather than lithium hydroxide, to remove carbon dioxide from the air in a spacecraft.', NULL, 0, 0, '2026-09-13 12:59:56.025393+00');
INSERT INTO public.question_parts VALUES ('54a2211d-8fcc-495a-b414-4f13bc7260e5', 'a5b6b77b-3994-493a-a654-16a14aa5be3f', 'b', 'Calculate the mass of lithium hydroxide needed to react with 100 g of carbon dioxide. $ [ M_{r} $ of $ \mathrm{L i O H}=2 4 ] $', NULL, 0, 1, '2026-09-13 12:59:56.025446+00');
INSERT INTO public.question_parts VALUES ('538a4de2-d1c5-4066-9bfd-d4f020c3b8d8', 'a5b6b77b-3994-493a-a654-16a14aa5be3f', 'b-ii', 'Calculate the volume of carbon dioxide, at room temperature and pressure, removed by 100 g of lithium peroxide. [M $ _{r} $ of $ \mathrm{L i}_{2} \mathrm{O}_{2}=4 6 $] Assume that one mole of gas has a volume of 24000 $ cm^{3} $ at rtp.', NULL, 0, 2, '2026-09-13 12:59:56.025498+00');
INSERT INTO public.question_parts VALUES ('5ae26539-6f2d-47df-956d-26b7df4a72ac', '36a68289-b1c7-4ff4-bcdc-ef3f3b0bb970', 'a', 'A student writes this plan for preparing a sample of hydrated magnesium sulfate crystals. step1 Pour about 100 $ cm^{3} $ of dilute nitric acid into a 250 $ cm^{3} $ beaker. step 2 Add a solution of magnesium carbonate to the acid until there is no more effervescence. step 3 Heat the solution until all of the water has boiled off. This plan will not succeed because there is one mistake in each step. Identify the mistake in each of the steps.', NULL, 0, 0, '2026-09-13 12:59:56.051097+00');
INSERT INTO public.question_parts VALUES ('fee75425-7d3d-446c-98b6-44b55d054d0f', '36a68289-b1c7-4ff4-bcdc-ef3f3b0bb970', 'b', 'Another student uses the following plan to prepare a sample of ammonium hydrogenphosphate, formed in this reaction between aqueous ammonia and dilute phosphoric acid $2 \mathrm {N H} _ {3} (\mathrm {a q}) + \mathrm {H} _ {3} \mathrm {P O} _ {4} (\mathrm {a q}) \rightarrow (\mathrm {N H} _ {4}) _ {2} \mathrm {H P O} _ {4} (\mathrm {a q})$ use a pipette to transfer 25.0 $ cm^{3} $ of phosphoric acid to a conical flask add 3 drops of indicator use a burette to add aqueous ammonia until the indicator just changes colour permanently', NULL, 0, 1, '2026-09-13 12:59:56.051272+00');
INSERT INTO public.question_parts VALUES ('f0f517a4-5ca8-4573-bf07-eeb86cbe4260', '36a68289-b1c7-4ff4-bcdc-ef3f3b0bb970', 'b-i', 'The diagram shows the burette readings in one experiment before and after adding aqueous ammonia. Use the readings to complete the table, entering all values to the nearest 0.05 $ cm^{3}. $', NULL, 0, 2, '2026-09-13 12:59:56.051318+00');
INSERT INTO public.question_parts VALUES ('7b6c5f0f-d33d-4b1b-9aaf-365ec43956ce', '36a68289-b1c7-4ff4-bcdc-ef3f3b0bb970', 'b-ii', 'In another titration, the student made a mistake. After he filled the burette, he noticed that the space between the tap of the burette and the tip contained air. After adding the aqueous ammonia, he noticed that it now contained liquid. Explain how, if at all, this mistake affects the calculated volume of aqueous ammonia added.', NULL, 0, 3, '2026-09-13 12:59:56.051374+00');
INSERT INTO public.question_parts VALUES ('0177e752-32a2-438d-99fe-25df9bb0139b', '36a68289-b1c7-4ff4-bcdc-ef3f3b0bb970', 'c', 'He repeats the experiment until he obtains concordant results. The table shows the results. Concordant results are those volumes that differ from each other by 0.20 $ cm^{3} $ or less.', NULL, 0, 4, '2026-09-13 12:59:56.051442+00');
INSERT INTO public.question_parts VALUES ('0ac20414-5273-4872-b4d2-fc1c859cea02', '36a68289-b1c7-4ff4-bcdc-ef3f3b0bb970', 'c-i', 'Identify the concordant results by placing ticks ( $ \checkmark $ ) in the table where appropriate.', NULL, 0, 5, '2026-09-13 12:59:56.051499+00');
INSERT INTO public.question_parts VALUES ('7a189e95-9124-4e68-85da-b9c2467df70e', '36a68289-b1c7-4ff4-bcdc-ef3f3b0bb970', 'c-ii', 'Use the concordant results to calculate the average (mean) volume of aqueous ammonia added. average volume of aqueous ammonia = ... $ \mathrm{c m}^{3} $', NULL, 0, 6, '2026-09-13 12:59:56.051584+00');
INSERT INTO public.question_parts VALUES ('51ccc572-eead-4d54-a61e-98764fc36176', '36a68289-b1c7-4ff4-bcdc-ef3f3b0bb970', 'd', 'The student then mixed the volumes of aqueous ammonia and phosphoric acid found in the titration. Describe how to use the method of crystallisation to obtain a pure dry sample of the salt from this mixture. Every effort has been made to contact copyright holders to obtain their permission for the use of copyright material. Pearson Education Ltd. will, if notified, be happy to rectify any errors or omissions and include any such rectifications in future editions.', NULL, 0, 7, '2026-09-13 12:59:56.051629+00');
INSERT INTO public.question_parts VALUES ('b85406bd-ef85-4392-bf7b-a1aea4c50cae', 'ad9b508e-f837-4b1e-b0fb-40ae9f5e48c0', 'a', 'Which substance is a mixture?', NULL, 0, 0, '2026-09-13 12:59:56.214855+00');
INSERT INTO public.question_parts VALUES ('ed7a5345-8b66-401a-9f6d-30e73968b67d', 'ad9b508e-f837-4b1e-b0fb-40ae9f5e48c0', 'b', 'Which substance is a gas that makes a squeaky pop when ignited?', NULL, 0, 1, '2026-09-13 12:59:56.214978+00');
INSERT INTO public.question_parts VALUES ('374a2511-10ee-44b6-854b-49f6cde7b53e', 'ad9b508e-f837-4b1e-b0fb-40ae9f5e48c0', 'c', 'Which substance is an element that is a green gas at room temperature?', NULL, 0, 2, '2026-09-13 12:59:56.215041+00');
