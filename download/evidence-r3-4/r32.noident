INSERT INTO public.question_versions VALUES ('595c8645-b7d5-4ef3-a6bd-727c1b9dd6a2', 'a59e5d79-8949-40bf-b621-b575c2ced82e', 1, '(a) Wine can be made from grapes. The grapes are crushed to produce an aqueous solution containing glucose. Yeast is then added to this solution. The solution is kept at a constant temperature for a period of time. The glucose is converted into ethanol. (i) Name the process in which glucose is converted into ethanol. (ii) What is the purpose of the yeast?', 1, 3, 90, NULL, 'SUGGESTED', '53711967-dc78-5d9b-b1db-f655fd599e2b', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:09.204517+00');
INSERT INTO public.question_versions VALUES ('1d3be58a-d9f5-4d59-bda2-dc4410d0c76e', '776970d6-fa64-4ba1-a44c-0b25e6ab8de8', 1, 'A student uses this apparatus to investigate the temperature change that occurs when potassium hydroxide is dissolved in water. She uses this method. pour $ 5 0 \mathrm{c m}^{3} $ of water into the polystyrene cup and measure the temperature of the water add 3g of potassium hydroxide and stir record the highest temperature of the solution', 5, 3, 450, NULL, 'SUGGESTED', '53711967-dc78-5d9b-b1db-f655fd599e2b', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:09.204894+00');
INSERT INTO public.question_versions VALUES ('e033ec6a-0d00-4431-a2f2-415e249028ef', 'a80e1882-5e6e-490a-8b40-7776c5af722e', 1, 'Potassium sulfide is an ionic compound.', 7, 3, 630, NULL, 'SUGGESTED', '53711967-dc78-5d9b-b1db-f655fd599e2b', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:09.207191+00');
INSERT INTO public.question_versions VALUES ('a42e6a5c-ec6f-4bc2-bb57-7742c709841b', 'b6c426f2-5da3-4daf-ba5b-e6052425f74b', 1, 'Sulfuric acid can be manufactured from sulfur in a four-stage process. stage 1 sulfur is burned in air to form sulfur dioxide $S + O _ {2} \rightarrow S O _ {2}$ stage 2 the sulfur dioxide is reacted with more oxygen to form sulfur trioxide $\mathrm {S O} _ {2} + \frac {1}{2} \mathrm {O} _ {2} \rightarrow \mathrm {S O} _ {3}$ stage 3 the sulfur trioxide is absorbed in concentrated sulfuric acid to make oleum $\mathrm {S O} _ {3} + \mathrm {H} _ {2} \mathrm {S O} _ {4} \rightarrow \mathrm {H} _ {2} \mathrm {S} _ {2} \mathrm {O} _ {7}$ stage 4 the oleum is carefully diluted with water to form sulfuric acid', 1, 3, 90, NULL, 'SUGGESTED', '53711967-dc78-5d9b-b1db-f655fd599e2b', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:09.207563+00');
INSERT INTO public.question_versions VALUES ('4ba79493-0c1f-49a7-8ab0-c35a0ddd2409', '6a3b22d1-131f-44ec-8977-712ef7e7b901', 1, 'A student is supplied with aqueous solutions of these substances. bromine chlorine iodine potassium bromide potassium chloride potassium iodide Describe two experiments the student could perform, using some of the solutions, to show the order of reactivity of bromine, chlorine and iodine. Your answer should include the observations that the student would expect to make, and a chemical equation for one of the reactions.', 5, 3, 450, NULL, 'SUGGESTED', '53711967-dc78-5d9b-b1db-f655fd599e2b', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:09.207933+00');
INSERT INTO public.question_versions VALUES ('3ad58a7c-1a28-4703-b0fd-12907bdc8457', '155bcfb5-4e0d-4508-b395-ce56952667f6', 1, 'Nitrogen dioxide $ \left( \mathrm{N O}_{2} \right) $ is a brown gas. Dinitrogen tetraoxide $ \left(\mathrm{N}_{2} \mathrm{O}_{4}\right) $ is a colourless gas. The two gases can exist together in dynamic equilibrium according to the equation $2 \mathrm {N O} _ {2} (\mathrm {g}) \rightleftharpoons \mathrm {N} _ {2} \mathrm {O} _ {4} (\mathrm {g}) \quad \Delta H = - 5 8 \mathrm {k J / m o l}$ A mixture of nitrogen dioxide gas and dinitrogen tetraoxide gas is allowed to reach equilibrium in a sealed container at $ 2 0^{\circ} \mathrm{C} $ . This equilibrium mixture is brown in colour.', 5, 3, 450, NULL, 'SUGGESTED', '53711967-dc78-5d9b-b1db-f655fd599e2b', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:09.208224+00');
INSERT INTO public.question_versions VALUES ('f4afcd7b-a1ac-4fd2-a581-5236436a8319', '20d07066-4751-4519-a8f7-94f3f6322a99', 1, 'The table shows the numbers of protons, neutrons and electrons in some atoms and ions.', 7, 3, 630, NULL, 'SUGGESTED', 'ac266f2c-30fa-54b4-b673-daae0e7717ef', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:09.386272+00');
INSERT INTO public.question_versions VALUES ('4f604c06-2ecf-4009-b14c-3fcd5ab95798', '111dd417-06ce-4a25-b905-678dcab63746', 1, 'The equation for the thermal decomposition of copper(II) carbonate is $\mathrm {C u C O} _ {3} (\mathrm {s}) \rightarrow \mathrm {C u O} (\mathrm {s}) + \mathrm {C O} _ {2} (\mathrm {g})$ She uses this method. weigh the crucible, lid and copper(II) carbonate heat the crucible, lid and contents for 2 minutes allow to cool and then reweigh heat for a second period of 2 minutes allow to cool and then reweigh heat for a third period of 2 minutes allow to cool and then reweigh The table shows the student''s results. A student investigates the decomposition of copper(II) carbonate using this apparatus.', 1, 3, 90, NULL, 'SUGGESTED', 'ac266f2c-30fa-54b4-b673-daae0e7717ef', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:09.386766+00');
INSERT INTO public.question_versions VALUES ('6ec38c59-db30-4d51-ab39-6fa5e92ab366', '0dcaff67-99ac-4ed7-be44-8a55180c25a1', 1, 'This question is about halogens and halides.', 10, 3, 900, NULL, 'SUGGESTED', 'ac266f2c-30fa-54b4-b673-daae0e7717ef', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:09.387126+00');
INSERT INTO public.question_versions VALUES ('66902fe7-0fe2-4fd7-a3b3-7967670ecc5d', '99fd93d2-d944-4dfe-a3ae-4050d58d95a1', 1, 'The scheme shows some reactions involving ethanol.', 10, 3, 900, NULL, 'SUGGESTED', 'ac266f2c-30fa-54b4-b673-daae0e7717ef', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:09.387461+00');
INSERT INTO public.question_versions VALUES ('68d5cec3-be1a-430a-8799-362cb3089d26', '3f61b4d6-c8c0-4940-a14d-93cc95d7504c', 1, 'A student uses this apparatus to measure the temperature change when lithium iodide dissolves in water. He measures the steady temperature of the water before adding the lithium iodide. He then adds the lithium iodide, stirs the mixture until all the solid dissolves and records the maximum temperature reached. The diagram shows the thermometer readings before and after dissolving the lithium iodide.', 1, 3, 90, NULL, 'SUGGESTED', 'ac266f2c-30fa-54b4-b673-daae0e7717ef', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:09.38782+00');
INSERT INTO public.question_versions VALUES ('9d893a1b-db33-4bf0-a722-7403d77c2c9e', 'e6e75c4e-b26c-4186-90e5-580fd87a5afd', 1, 'Magnesium and its compounds have many uses. Magnesium is never found as an element in the Earth''s crust, but its compounds occur naturally in rocks and seawater.', 14, 3, 1260, NULL, 'SUGGESTED', 'ac266f2c-30fa-54b4-b673-daae0e7717ef', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:09.388139+00');
INSERT INTO public.question_versions VALUES ('172a9a9e-ed8e-42ab-91e0-4e8d11b53c0a', '3bdcc7f0-e2ca-4907-ad06-c4a0ebcf7aae', 1, 'The table shows the names of some common pieces of laboratory apparatus used to make measurements.', 7, 3, 630, NULL, 'SUGGESTED', 'edb9d604-b77e-5591-ad47-33e8d60f8048', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:09.556172+00');
INSERT INTO public.question_versions VALUES ('18c2d69f-779d-4733-8cdd-278c460d7867', '2104c57f-5b69-4d62-812a-6a40ebb1b87b', 1, 'The table shows the names of some substances. It also shows whether each substance is an element or a compound, and the type of bonding in the substance.', 5, 3, 450, NULL, 'SUGGESTED', 'edb9d604-b77e-5591-ad47-33e8d60f8048', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:09.556676+00');
INSERT INTO public.question_versions VALUES ('8a4e375c-0319-44b6-86fe-1364e6d79b35', '056ef868-94c2-4905-a93f-d6f29a873850', 1, 'The table shows the electronic configurations of four elements.', 10, 3, 900, NULL, 'SUGGESTED', 'edb9d604-b77e-5591-ad47-33e8d60f8048', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:09.557107+00');
INSERT INTO public.question_versions VALUES ('46855570-2aa8-4da5-8d58-e9d0c13aa53e', '7cfba505-b8f4-4041-8af6-f061f84d0cea', 1, 'An industrial chemical company has supplies of ethene and ethanol. The company considers using these two processes. process 1 converting ethene to ethanol process 2 converting ethanol to ethene $\mathrm {C} _ {2} \mathrm {H} _ {4} + \mathrm {H} _ {2} \mathrm {O} \rightarrow \mathrm {C} _ {2} \mathrm {H} _ {6} \mathrm {O}$ A chemical equation for process 1 is', 8, 3, 720, NULL, 'SUGGESTED', 'edb9d604-b77e-5591-ad47-33e8d60f8048', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:09.557424+00');
INSERT INTO public.question_versions VALUES ('029da954-4ab2-459a-902a-1a016128abba', '9573c5b0-198b-4885-87f6-be9d6f8d99f3', 1, 'Potassium chloride, KCl, is very similar to sodium chloride, NaCl. They have the same type of crystal structure, and their aqueous solutions can be electrolysed to give similar products.', 11, 3, 990, NULL, 'SUGGESTED', 'edb9d604-b77e-5591-ad47-33e8d60f8048', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:09.558356+00');
INSERT INTO public.question_versions VALUES ('a870d3cb-8b08-4eb2-8056-651c897e9560', '9bb2634d-0715-40d3-ae1d-e85c367ab336', 1, 'A student prepares a solution of the soluble salt lithium sulfate, using the neutralisation reaction between sulfuric acid and the alkali lithium hydroxide. To make sure that she obtains a pure solution of the salt, she first carries out a titration to find the volumes of sulfuric acid and lithium hydroxide that react exactly together. She uses this method in the titration. use a pipette to add 25.0 $ cm^{3} $ of dilute sulfuric acid to a conical flask add a few drops of phenolphthalein indicator fill a burette with lithium hydroxide solution add the lithium hydroxide solution from the burette until the indicator just changes colour', 13, 3, 1170, NULL, 'SUGGESTED', 'edb9d604-b77e-5591-ad47-33e8d60f8048', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:09.558802+00');
INSERT INTO public.question_versions VALUES ('ad12a397-a68d-45b6-b5a0-3754b0dbd765', '9fbffcf6-e54e-49bd-988e-68f9c5d8a2fe', 1, 'A student investigates the temperature rise of water in a copper can placed above a spirit burner containing a flammable liquid. The diagram shows the apparatus he uses. This is the student''s method. place 200 g of water in the copper can and record the temperature of the water weigh the spirit burner containing the flammable liquid place the spirit burner underneath the copper can and light the burner after two minutes extinguish the flame and record the maximum temperature of the water reweigh the spirit burner containing the remaining flammable liquid', 6, 3, 540, NULL, 'SUGGESTED', 'edb9d604-b77e-5591-ad47-33e8d60f8048', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:09.559109+00');
INSERT INTO public.question_versions VALUES ('75a67621-4983-4ded-8773-4969d4796a02', '9d3d08ae-32ee-4d19-b4b2-26871183faab', 1, 'The diagram shows the apparatus a student uses to separate a mixture of salt and sand. She adds the mixture to water in a beaker and then carries out the three stages shown. stage 1 stage 2 stage 3', 7, 3, 630, NULL, 'SUGGESTED', '9ef9b0c8-3a05-5e34-977c-7af899b976bc', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:09.684778+00');
INSERT INTO public.question_versions VALUES ('39b0ed09-d8ff-4a7f-b2c3-ebe10df7c5fd', '15e3d293-0042-424d-aef9-bc18fc0b0092', 1, 'The apparatus in the diagram was set up to demonstrate the rusting of iron. after one week after two weeks', 6, 3, 540, NULL, 'SUGGESTED', '9ef9b0c8-3a05-5e34-977c-7af899b976bc', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:09.685128+00');
INSERT INTO public.question_versions VALUES ('f61d7bed-df6c-43ca-afc2-6fa39f2a3d63', 'c7e4d967-3380-4f53-82d9-5d474dacebd6', 1, 'The diagram shows the elements in Period 3 of the Periodic Table.', 1, 3, 90, NULL, 'SUGGESTED', '9ef9b0c8-3a05-5e34-977c-7af899b976bc', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:09.685389+00');
INSERT INTO public.question_versions VALUES ('d21af49d-400c-4cbb-a513-fadc78753e43', '1cf50c89-a5e3-43ab-99b1-38be845a1889', 1, 'But-1-ene is a member of the homologous series of alkenes. The displayed formula of but-1-ene is The saturated compound cyclobutane is an isomer of but-1-ene. The displayed formula of cyclobutane is', 1, 3, 90, NULL, 'SUGGESTED', '9ef9b0c8-3a05-5e34-977c-7af899b976bc', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:09.685971+00');
INSERT INTO public.question_versions VALUES ('61b51e2b-c964-4525-b97f-55f3fc6b553f', '55690fc1-6640-4cd7-9c77-622ced298624', 1, 'This apparatus can be used in a method to find the volume of sulfuric acid required to neutralise a solution of potassium hydroxide (KOH).', 1, 3, 90, NULL, 'SUGGESTED', '9ef9b0c8-3a05-5e34-977c-7af899b976bc', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:09.686241+00');
INSERT INTO public.question_versions VALUES ('ee3caa2f-f8af-4103-8d1a-3f9d5823f2b2', 'b309bb87-c6ce-48f3-8dca-e30cfe6a56fb', 1, 'Crude oil is a complex mixture of organic compounds called hydrocarbons. It is separated into fractions using a fractionating tower.', 1, 3, 90, NULL, 'SUGGESTED', '9ef9b0c8-3a05-5e34-977c-7af899b976bc', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:09.686511+00');
INSERT INTO public.question_versions VALUES ('85935569-07f5-4662-8cb9-2ca4d361e394', 'dd4a1fd1-e0ae-4182-9b6b-f82eb475a4cb', 1, 'This is a recipe for making Irish soda bread. add 170g of wholemeal flour, 170g of plain flour, 10g of salt and 10.5g of bicarbonate of soda (sodium hydrogencarbonate, $ \mathrm{N a H C O_{3}} $ ）to a bowl and stir pour in $ 2 9 0 \mathrm{c m}^{3} $ of buttermilk and stir quickly to form a soft dough form the dough into a round ball and slightly flatten it cut a cross in the top and bake for 30 minutes in an oven at $ 2 0 0^{\circ} \mathrm{C} $ When sodium hydrogencarbonate is heated, it forms carbon dioxide gas. $2 \mathrm {N a H C O} _ {3} \rightarrow \mathrm {N a} _ {2} \mathrm {C O} _ {3} + \mathrm {H} _ {2} \mathrm {O} + \mathrm {C O} _ {2}$', 1, 3, 90, NULL, 'SUGGESTED', '9ef9b0c8-3a05-5e34-977c-7af899b976bc', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:09.687005+00');
INSERT INTO public.question_versions VALUES ('dfb7ed32-9a28-42cb-afb4-259a63bdc942', '4cd60f6e-906a-4346-b430-2890ec21961d', 1, 'Hydrated copper(II) sulfate is a soluble blue solid. A large crystal of this solid is placed at the bottom of a beaker of water. The diagram shows the beaker immediately after placing the crystal in it, and after two days. after placing the crystal after two days', 4, 3, 360, NULL, 'SUGGESTED', '1a97e8dd-750d-5c9f-966d-c2a08df67fe3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:55.961084+00');
INSERT INTO public.question_versions VALUES ('d5dd8e54-6cab-4641-9501-bbc9d9d0aacb', '91dd8681-caab-4ed3-8846-ed2e9f263683', 1, 'Iron is a metal with many uses. One problem with using iron is that it rusts.', 8, 3, 720, NULL, 'SUGGESTED', '1a97e8dd-750d-5c9f-966d-c2a08df67fe3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:55.963153+00');
INSERT INTO public.question_versions VALUES ('be39a93b-b2e3-427d-baa4-4637f552904a', '920cb4ba-c0cf-4986-8df9-291325910bc5', 1, 'This question is about some gases present in air.', 9, 3, 810, NULL, 'SUGGESTED', '1a97e8dd-750d-5c9f-966d-c2a08df67fe3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:55.963989+00');
