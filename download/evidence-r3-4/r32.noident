INSERT INTO public.questions VALUES ('080a68f0-8e73-4e3e-84a9-61a503f0a570', 'q04-8efa97d9', 'STRUCTURED', 'This question is about the extraction and uses of aluminium.', 10, 3, 900, NULL, 'fc8a088b-112c-4007-982e-6a41b10d5701', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.603094+00', '58ed1fc6-24d7-4ef1-b567-0428dcfaf3e9');
