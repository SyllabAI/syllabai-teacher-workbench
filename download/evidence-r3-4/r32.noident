ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "[ \\mathrm {f o r N a} _ {2} \\mathrm {S O} _ {4}, M _ {\\mathrm {r}} = 1 4 2 \\quad \\mathrm {f o r H} _ {2} \\mathrm {O}, M _ {\\mathrm {r}} = 1 8 ]", "latex": "[ \\mathrm {f o r N a} _ {2} \\mathrm {S O} _ {4}, M _ {\\mathrm {r}} = 1 4 2 \\quad \\mathrm {f o r H} _ {2} \\mathrm {O}, M _ {\\mathrm {r}} = 1 8 ]", "confidence": 1.0, "element_id": "e000189", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 189, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {Z n} (\\mathrm {s}) + 2 \\mathrm {H C l} (\\mathrm {a q}) \\rightarrow \\mathrm {Z n C l} _ {2} (\\mathrm {a q}) + \\mathrm {H} _ {2} (\\mathrm {g})", "latex": "\\mathrm {Z n} (\\mathrm {s}) + 2 \\mathrm {H C l} (\\mathrm {a q}) \\rightarrow \\mathrm {Z n C l} _ {2} (\\mathrm {a q}) + \\mathrm {H} _ {2} (\\mathrm {g})", "confidence": 1.0, "element_id": "e000191", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 191, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "pageCount": 1, "documentId": "186fa85a-af96-59d3-9fab-fbb30c4c7467", "provenance": {"engine": "glm-ocr-markdown", "application": "syllabai-parser", "extractedAt": "2026-09-13T12:56:35.909189218Z", "engineVersion": "1.1.0", "schemaVersion": "1.0", "extractionParams": {"pageBoundaries": "none-in-source", "sourceLineCount": 255, "upstreamConverter": "zai-glm-ocr", "entityDecodedLines": 0, "signedUrlFigureRefs": 0, "normalizedHtmlEntities": true}}, "textBlocks": [{"role": "heading", "text": "Instructions", "confidence": 1.0, "element_id": "e000001", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 1, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Use black ink or ball-point pen.", "confidence": 1.0, "element_id": "e000002", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 2, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "If pencil is used for diagrams/sketches/graphs it must be dark (HB or B).", "confidence": 1.0, "element_id": "e000003", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 3, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Fill in the boxes at the top of this page with your name, centre number and candidate number.", "confidence": 1.0, "element_id": "e000004", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 4, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer all questions.", "confidence": 1.0, "element_id": "e000005", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 5, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer the questions in the spaces provided", "confidence": 1.0, "element_id": "e000006", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 6, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "there may be more space than you need.", "confidence": 1.0, "element_id": "e000007", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 7, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Show all the steps in any calculations and state the units.", "confidence": 1.0, "element_id": "e000008", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 8, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Information", "confidence": 1.0, "element_id": "e000009", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 9, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The total mark for this paper is 110.", "confidence": 1.0, "element_id": "e000010", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 10, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The marks for each question are shown in brackets", "confidence": 1.0, "element_id": "e000011", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 11, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "use this as a guide as to how much time to spend on each question.", "confidence": 1.0, "element_id": "e000012", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 12, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Advice", "confidence": 1.0, "element_id": "e000013", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 13, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Read each question carefully before you start to answer it.", "confidence": 1.0, "element_id": "e000014", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 14, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Write your answers neatly and in good English.", "confidence": 1.0, "element_id": "e000015", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 15, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Try to answer every question.", "confidence": 1.0, "element_id": "e000016", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 16, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Check your answers if you have time at the end.", "confidence": 1.0, "element_id": "e000017", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 17, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Turn over", "confidence": 1.0, "element_id": "e000018", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 18, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The lanthanoids (atomic numbers 58-71) and the actinoids (atomic numbers 90-103) have been omitted.", "confidence": 1.0, "element_id": "e000020", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 20, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The relative atomic masses of copper and chlorine have not been rounded to the nearest whole number.", "confidence": 1.0, "element_id": "e000021", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 21, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Answer ALL questions.", "confidence": 1.0, "element_id": "e000022", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 22, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Some questions must be answered with a cross in a box. If you change your mind about an answer, put a line through the box and then mark your new answer with a cross.", "confidence": 1.0, "element_id": "e000023", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 23, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "1 The box gives some methods that are involved in the separation of mixtures.", "confidence": 1.0, "element_id": "e000024", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 24, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "chromatography crystallisation dissolving evaporating filtering fractional distillation simple distillation", "confidence": 1.0, "element_id": "e000025", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 25, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Use words from the box to identify the method involved in each of these separations.", "confidence": 1.0, "element_id": "e000026", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 26, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Give the best method for obtaining gasoline from crude oil.", "confidence": 1.0, "element_id": "e000027", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 27, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Give the best method for separating the dyes in black ink.", "confidence": 1.0, "element_id": "e000028", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 28, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Give the best method for obtaining pure water from seawater.", "confidence": 1.0, "element_id": "e000029", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 29, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) A sample of solid hydrated copper(II) sulfate can be obtained from a mixture of copper(II) oxide and copper(II) sulfate.", "confidence": 1.0, "element_id": "e000030", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 30, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Complete the passage by using words from the box.", "confidence": 1.0, "element_id": "e000031", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 31, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The mixture of copper(II) oxide and copper(II) sulfate can be separated by first the copper(II) sulfate in distilled water.", "confidence": 1.0, "element_id": "e000032", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 32, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The copper(II) oxide is then removed by", "confidence": 1.0, "element_id": "e000033", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 33, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Some of the water from the copper(II) sulfate solution is then removed by", "confidence": 1.0, "element_id": "e000034", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 34, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A pure sample of hydrated copper(II) sulfate is then obtained by", "confidence": 1.0, "element_id": "e000035", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 35, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 1 = 7 marks)", "confidence": 1.0, "element_id": "e000036", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 36, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "2 This question is about the reactions of iron.", "confidence": 1.0, "element_id": "e000037", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 37, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Iron rusts when exposed to water and oxygen.", "confidence": 1.0, "element_id": "e000038", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 38, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Give the chemical name of the compound that forms when iron rusts.", "confidence": 1.0, "element_id": "e000039", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 39, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) What type of reaction occurs when iron rusts?", "confidence": 1.0, "element_id": "e000040", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 40, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A combustion", "confidence": 1.0, "element_id": "e000041", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 41, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B decomposition", "confidence": 1.0, "element_id": "e000042", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 42, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "neutralisation", "confidence": 1.0, "element_id": "e000043", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 43, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "oxidation", "confidence": 1.0, "element_id": "e000044", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 44, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Galvanising is a method used to prevent iron from rusting. Give the name of the metal used to galvanise iron.", "confidence": 1.0, "element_id": "e000045", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 45, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) When iron reacts with dilute sulfuric acid, the products are iron(II) sulfate and hydrogen.", "confidence": 1.0, "element_id": "e000046", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 46, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Give a chemical equation for the reaction between iron and sulfuric acid.", "confidence": 1.0, "element_id": "e000047", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 47, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Give a test for hydrogen.", "confidence": 1.0, "element_id": "e000048", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 48, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) An excess of iron is added to copper(II) sulfate solution.", "confidence": 1.0, "element_id": "e000049", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 49, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Name the type of reaction that occurs.", "confidence": 1.0, "element_id": "e000050", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 50, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) State the appearance of the solid that forms in the reaction.", "confidence": 1.0, "element_id": "e000051", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 51, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) Give the reason why no reaction occurs when iron is added to magnesium sulfate solution.", "confidence": 1.0, "element_id": "e000052", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 52, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 2 = 8 marks)", "confidence": 1.0, "element_id": "e000053", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 53, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "3 The table gives some information about three substances, X, Y and Z.", "confidence": 1.0, "element_id": "e000054", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 54, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Complete the table by giving the missing information.", "confidence": 1.0, "element_id": "e000056", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 56, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Explain why substance X has a low melting point.", "confidence": 1.0, "element_id": "e000057", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 57, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 3 = 6 marks)", "confidence": 1.0, "element_id": "e000058", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 58, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "4 This question is about unsaturated hydrocarbons.", "confidence": 1.0, "element_id": "e000059", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 59, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Ethene $ \\left( \\mathrm{C}_{2} \\mathrm{H}_{4} \\right) $ is a member of the homologous series of alkenes.", "confidence": 1.0, "element_id": "e000060", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 60, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Give two characteristics of a homologous series.", "confidence": 1.0, "element_id": "e000061", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 61, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Draw a dot-and-cross diagram to show the bonding in a molecule of ethene. Show outer electrons only.", "confidence": 1.0, "element_id": "e000062", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 62, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Propene $ \\left( \\mathrm{C}_{3} \\mathrm{H}_{6} \\right) $ is another member of the homologous series of alkenes.", "confidence": 1.0, "element_id": "e000063", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 63, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) State why the empirical formula of all alkenes in this homologous series is $ \\mathrm{C H_{2}} $", "confidence": 1.0, "element_id": "e000064", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 64, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Propene can be polymerised to form poly(propene).", "confidence": 1.0, "element_id": "e000065", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 65, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Draw the displayed formula of propene and the repeat unit of poly(propene).", "confidence": 1.0, "element_id": "e000066", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 66, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(2)", "confidence": 1.0, "element_id": "e000067", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 67, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) This is the structural formula of another hydrocarbon compound.", "confidence": 1.0, "element_id": "e000069", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 69, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Give the molecular formula and the empirical formula of this compound.", "confidence": 1.0, "element_id": "e000071", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 71, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "molecular formula", "confidence": 1.0, "element_id": "e000072", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 72, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "empirical formula", "confidence": 1.0, "element_id": "e000073", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 73, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Explain why this compound is an unsaturated hydrocarbon.", "confidence": 1.0, "element_id": "e000074", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 74, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Describe a test to show that this hydrocarbon is unsaturated.", "confidence": 1.0, "element_id": "e000075", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 75, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 4 = 14 marks)", "confidence": 1.0, "element_id": "e000076", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 76, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "5 This question is about lithium and some of its compounds.", "confidence": 1.0, "element_id": "e000077", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 77, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) A small piece of lithium is added to a trough containing water.", "confidence": 1.0, "element_id": "e000078", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 78, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The lithium floats on the surface of the water and a vigorous reaction occurs.", "confidence": 1.0, "element_id": "e000079", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 79, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Give two other observations when lithium reacts with water.", "confidence": 1.0, "element_id": "e000080", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 80, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) A few drops of methyl orange are added to the solution in the trough Explain the final colour of the solution.", "confidence": 1.0, "element_id": "e000081", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 81, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) An unlabelled bottle containing a white powder is found in a laboratory.", "confidence": 1.0, "element_id": "e000082", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 82, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Describe tests to show that the white powder in the bottle is lithium carbonate.", "confidence": 1.0, "element_id": "e000083", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 83, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "(c) Lithium carbonate has ionic bonding.", "confidence": 1.0, "element_id": "e000084", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 84, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "State what is meant by the term ionic bonding.", "confidence": 1.0, "element_id": "e000085", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 85, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000086", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 86, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "6 When solutions of lead(II) nitrate and potassium chloride are mixed, a precipitate of lead(II) chloride forms.", "confidence": 1.0, "element_id": "e000087", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 87, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) (i) Complete the equation for the reaction by adding the state symbols.", "confidence": 1.0, "element_id": "e000088", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 88, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Give the formula of each ion in lead(II) nitrate.", "confidence": 1.0, "element_id": "e000090", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 90, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "lead ion", "confidence": 1.0, "element_id": "e000091", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 91, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "nitrate ion", "confidence": 1.0, "element_id": "e000092", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 92, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Calculate the relative formula mass $ ( M_{r} ) $ of lead(II) nitrate, $ \\mathrm{P b ( N O_{3} )_{2}} $", "confidence": 1.0, "element_id": "e000093", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 93, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) A student investigates the height of the precipitate formed when lead(II) nitrate solution is added to potassium chloride solution.", "confidence": 1.0, "element_id": "e000094", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 94, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "This is the student''s method.", "confidence": 1.0, "element_id": "e000095", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 95, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 1 pour $ 1 5. 0 \\mathrm{c m}^{3} $ of potassium chloride solution into a boiling tube", "confidence": 1.0, "element_id": "e000096", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 96, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 2 add $ 2. 0 \\mathrm{c m}^{3} $ of lead(II) nitrate solution and allow the precipitate to settle", "confidence": 1.0, "element_id": "e000097", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 97, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 3 measure the height of the precipitate", "confidence": 1.0, "element_id": "e000098", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 98, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Repeat steps 2 and 3 until a total of $ 1 4. 0 \\mathrm{c m}^{3} $ of lead(II) nitrate solution has been added.", "confidence": 1.0, "element_id": "e000099", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 99, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The table shows the student''s results.", "confidence": 1.0, "element_id": "e000100", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 100, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Plot the results on the grid.", "confidence": 1.0, "element_id": "e000102", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 102, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Draw a circle around the anomalous result.", "confidence": 1.0, "element_id": "e000103", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 103, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Draw a line of best fit through the first four points and another line of best fit through the last three points. Make sure that the lines cross.", "confidence": 1.0, "element_id": "e000104", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 104, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Height of precipitate in cm", "confidence": 1.0, "element_id": "e000105", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 105, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Volume of lead(II) nitrate in $ cm^{3} $", "confidence": 1.0, "element_id": "e000107", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 107, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iv) Give two possible mistakes the student could have made to cause the anomalous result.", "confidence": 1.0, "element_id": "e000108", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 108, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(v) State why the first line of best fit should pass through the origin.", "confidence": 1.0, "element_id": "e000109", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 109, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(vi) Use your graph to determine the volume of lead(II) nitrate solution needed to react completely with $ 1 5. 0 \\mathrm{c m}^{3} $ of potassium chloride solution.", "confidence": 1.0, "element_id": "e000110", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 110, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "volume =", "confidence": 1.0, "element_id": "e000111", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 111, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 6 = 12 marks)", "confidence": 1.0, "element_id": "e000112", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 112, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "7 This question is about the three halogens, bromine, chlorine and iodine.", "confidence": 1.0, "element_id": "e000113", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 113, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Give the number of protons and the number of neutrons in an atom of iodine-127 number of protons", "confidence": 1.0, "element_id": "e000114", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 114, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "number of neutrons", "confidence": 1.0, "element_id": "e000115", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 115, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) A sample of bromine contains two isotopes.", "confidence": 1.0, "element_id": "e000116", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 116, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Br-79 with relative abundance 52.8%", "confidence": 1.0, "element_id": "e000117", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 117, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Br-81 with relative abundance 47.2%", "confidence": 1.0, "element_id": "e000118", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 118, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Calculate the relative atomic mass $ ( A_{\\mathrm{r}}) $ of this sample of bromine.", "confidence": 1.0, "element_id": "e000119", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 119, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Give your answer to three significant figures.", "confidence": 1.0, "element_id": "e000120", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 120, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Aluminium reacts with chlorine to form aluminium chloride.", "confidence": 1.0, "element_id": "e000121", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 121, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "This is the equation for the reaction.", "confidence": 1.0, "element_id": "e000122", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 122, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Calculate the minimum mass of chlorine needed to form 26.7 g of aluminium chloride.", "confidence": 1.0, "element_id": "e000124", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 124, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "[for $ \\mathrm{C I_{2}} $ $ M_{\\mathrm{r}}=7 1 $ for $ \\mathrm{A I C I_{3}} $ $ M_{\\mathrm{r}}=1 3 3. 5 $", "confidence": 1.0, "element_id": "e000125", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 125, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) A student mixes the following pairs of solutions.", "confidence": 1.0, "element_id": "e000127", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 127, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Pair 1 bromine solution and potassium chloride solution", "confidence": 1.0, "element_id": "e000128", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 128, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Pair 2 bromine solution and potassium iodide solution", "confidence": 1.0, "element_id": "e000129", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 129, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Explain how the student can use the results of these experiments to show the order of reactivity of the three halogens, bromine, chlorine and iodine.", "confidence": 1.0, "element_id": "e000130", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 130, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Include observations in your answer.", "confidence": 1.0, "element_id": "e000131", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 131, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 7 = 14 marks)", "confidence": 1.0, "element_id": "e000132", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 132, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000133", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 133, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "8 A student uses this apparatus to find the molar enthalpy change $ (\\Delta H) $ of combustion for the liquid fuel, pentanol.", "confidence": 1.0, "element_id": "e000134", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 134, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "This is the student''s method.", "confidence": 1.0, "element_id": "e000137", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 137, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "find the initial mass of the spirit burner and pentanol", "confidence": 1.0, "element_id": "e000138", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 138, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "add 100 $ cm^{3} $ of water to the copper can", "confidence": 1.0, "element_id": "e000139", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 139, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "record the initial temperature of the water", "confidence": 1.0, "element_id": "e000140", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 140, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "light the wick of the spirit burner to heat the water", "confidence": 1.0, "element_id": "e000141", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 141, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "stir the water until the temperature rises by $ 3 5. 0^{\\circ} \\mathrm{C} $", "confidence": 1.0, "element_id": "e000142", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 142, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "extinguish the flame and immediately find the final mass of the spirit burner and pentanol", "confidence": 1.0, "element_id": "e000143", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 143, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) (i) State why the student stirs the water.", "confidence": 1.0, "element_id": "e000144", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 144, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Suggest why it is important that the student immediately finds the final mass of the spirit burner and pentanol.", "confidence": 1.0, "element_id": "e000145", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 145, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The diagram shows the initial temperature of the water.", "confidence": 1.0, "element_id": "e000147", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 147, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Complete the table to show the temperature readings.", "confidence": 1.0, "element_id": "e000149", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 149, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Give both values to the nearest 0.1 $ ^{\\circ} \\mathrm{C}. $", "confidence": 1.0, "element_id": "e000150", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 150, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) (i) Show by calculation that the heat energy (Q) supplied by the pentanol is approximately 15000 J.", "confidence": 1.0, "element_id": "e000152", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 152, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "[for water, c=4.2 J/g/ $ ^{\\circ} \\mathrm{C} $]", "confidence": 1.0, "element_id": "e000153", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 153, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "[for $ 1. 0 \\mathrm{c m}^{3} $ of water, mass = 1.0 g]", "confidence": 1.0, "element_id": "e000154", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 154, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The table gives the initial and final mass readings.", "confidence": 1.0, "element_id": "e000155", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 155, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Use your answer to part (c)(i) and the information in the table to calculate the molar enthalpy change $ \\Delta H $ of combustion, in kJ/mol, for pentanol.", "confidence": 1.0, "element_id": "e000157", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 157, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "[for pentanol, $ M_{\\mathrm{r}}=8 8 $]", "confidence": 1.0, "element_id": "e000158", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 158, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Include a sign in your answer.", "confidence": 1.0, "element_id": "e000159", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 159, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) The formula of pentanol is $ \\mathrm{C_{5} H_{1 1} O H} $", "confidence": 1.0, "element_id": "e000160", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 160, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Write a chemical equation for the complete combustion of pentanol.", "confidence": 1.0, "element_id": "e000161", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 161, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "9 This question is about different hydrated forms of sodium sulfate.", "confidence": 1.0, "element_id": "e000162", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 162, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) A compound has the formula $ \\mathrm{N a_{2} S O_{4}. 7 H_{2} O} $", "confidence": 1.0, "element_id": "e000163", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 163, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) How many different elements are there in the formula $ \\mathrm{N a_{2} S O_{4}. 7 H_{2} O} $?", "confidence": 1.0, "element_id": "e000164", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 164, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A 3", "confidence": 1.0, "element_id": "e000165", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 165, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B 4", "confidence": 1.0, "element_id": "e000166", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 166, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C 5", "confidence": 1.0, "element_id": "e000167", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 167, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D 10", "confidence": 1.0, "element_id": "e000168", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 168, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) What is the total number of atoms in the formula $ \\mathrm{N a_{2} S O_{4}. 7 H_{2} O} $", "confidence": 1.0, "element_id": "e000169", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 169, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A 10", "confidence": 1.0, "element_id": "e000170", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 170, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B 22", "confidence": 1.0, "element_id": "e000171", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 171, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C 27", "confidence": 1.0, "element_id": "e000172", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 172, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D 28", "confidence": 1.0, "element_id": "e000173", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 173, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Another hydrated form of sodium sulfate has the formula $ \\mathrm{N a_{2} S O_{4}. x H_{2} O} $ A student uses this apparatus to find the value of x.", "confidence": 1.0, "element_id": "e000174", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 174, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "hydrated sodium sulfate", "confidence": 1.0, "element_id": "e000175", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 175, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "This is the student''s method.", "confidence": 1.0, "element_id": "e000177", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 177, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "find the mass of an empty tube", "confidence": 1.0, "element_id": "e000178", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 178, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "add solid hydrated sodium sulfate to the tube", "confidence": 1.0, "element_id": "e000179", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 179, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "find the mass of the tube and hydrated sodium sulfate", "confidence": 1.0, "element_id": "e000180", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 180, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "heat the tube for several minutes", "confidence": 1.0, "element_id": "e000181", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 181, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "allow the tube to cool and find the mass of the tube and contents", "confidence": 1.0, "element_id": "e000182", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 182, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Describe what the student should do next to make sure that all the water is removed from the hydrated sodium sulfate.", "confidence": 1.0, "element_id": "e000183", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 183, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Explain the role of the ice in the beaker.", "confidence": 1.0, "element_id": "e000184", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 184, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Describe how the student could prove that the liquid collected is pure water.", "confidence": 1.0, "element_id": "e000185", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 185, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) The table gives the student''s results.", "confidence": 1.0, "element_id": "e000186", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 186, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Use the student''s results to calculate the value of x.", "confidence": 1.0, "element_id": "e000188", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 188, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "10 Zinc reacts with dilute hydrochloric acid to form zinc chloride and hydrogen gas. This is the equation for the reaction.", "confidence": 1.0, "element_id": "e000190", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 190, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) In an experiment, $ 2 0 \\mathrm{c m}^{3} $ of hydrochloric acid containing 0.0036 mol are reacted with 1.3 g of zinc granules at a temperature of $ 3 0^{\\circ} \\mathrm{C}. $", "confidence": 1.0, "element_id": "e000192", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 192, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Show by calculation that the zinc is in excess.", "confidence": 1.0, "element_id": "e000193", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 193, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The volume of hydrogen collected is measured at regular time intervals.", "confidence": 1.0, "element_id": "e000194", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 194, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Curve A shows the results of this experiment.", "confidence": 1.0, "element_id": "e000195", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 195, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Volume of hydrogen in $ \\mathrm{c m}^{3} $", "confidence": 1.0, "element_id": "e000196", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 196, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The experiment is repeated using 1.3 g of zinc powder instead of zinc granules.", "confidence": 1.0, "element_id": "e000198", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 198, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "All other conditions are kept the same.", "confidence": 1.0, "element_id": "e000199", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 199, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "On the grid, draw the curve you would expect to obtain.", "confidence": 1.0, "element_id": "e000200", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 200, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) In the original experiment, $ 2 0 \\mathrm{c m}^{3} $ of hydrochloric acid containing 0.0036 mol were reacted with 1.3 g of zinc granules at a temperature of $ 3 0^{\\circ} \\mathrm{C} $ and curve A was obtained.", "confidence": 1.0, "element_id": "e000201", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 201, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The student does two more experiments and obtains curves B and C.", "confidence": 1.0, "element_id": "e000202", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 202, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Volume of hydrogen in $ \\mathrm{c m}^{3} $", "confidence": 1.0, "element_id": "e000203", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 203, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) In one of these experiments the student repeats the original method but at a temperature of $ 2 0^{\\circ} \\mathrm{C} $", "confidence": 1.0, "element_id": "e000205", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 205, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Explain in terms of particle collision theory why the curve obtained could be curve B.", "confidence": 1.0, "element_id": "e000206", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 206, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) In the other experiment the student repeats the original method but uses $ 2 0 \\mathrm{c m}^{3} $ of hydrochloric acid containing 0.0018 mol.", "confidence": 1.0, "element_id": "e000207", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 207, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Explain why curve C shows the results the student obtained.", "confidence": 1.0, "element_id": "e000208", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 208, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Catalysts can be used to speed up reactions. Describe how a catalyst works.", "confidence": 1.0, "element_id": "e000209", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 209, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 10 = 12 marks)", "confidence": 1.0, "element_id": "e000210", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 210, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "TOTAL FOR PAPER = 110 MARKS", "confidence": 1.0, "element_id": "e000211", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 211, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000212", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 212, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000213", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 213, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000214", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 214, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "schemaVersion": "1.0"}', NULL, '2026-09-13 12:56:56.174638+00');
INSERT INTO public.documents VALUES ('ba8729f2-027e-4c8f-b987-be2c82810a18', '485eb8fc-8e49-56ae-87b9-500322907307', '1.0', 1, 'MARK_SCHEME', 'corpus/igcse-chemistry-4ch0-1c-2023jun/MS.md', 'MS.md', 'text/markdown', 'c75ad4e8b12fb859252c521776ddd3753c0707c8b9ab1643fe3c8662b4b24d4d', 'SHA-256', 1, 36, 36, 16, 'glm-ocr-markdown', '1.1.0', '2026-09-13 12:56:35.972303+00', '{"pages": [{"width": null, "height": null, "pageNumber": 1}], "source": {"uri": "corpus/igcse-chemistry-4ch0-1c-2023jun/MS.md", "checksum": "c75ad4e8b12fb859252c521776ddd3753c0707c8b9ab1643fe3c8662b4b24d4d", "fileName": "MS.md", "mimeType": "text/markdown", "checksumAlgorithm": "SHA-256"}, "tables": [{"rows": [["Question number", "Answer", "Notes", "Marks"], ["1(a)(i)", "fractional distillation", "", "1"], ["(ii)", "chromatography", "", "1"], ["(iii)", "simple distillation", "ACCEPT distillation", "1"], ["(b)", "M1 A mixture of copper(II) oxide and copper(II) sulfate can be separated by first dissolving the copper(II) sulfate in distilled water.M2 The copper(II) oxide is then removed by filteringM3 Some of the water from the copper(II) sulfate solution is then removed by evaporatingM4 A pure sample of hydrated copper(II) sulfate is then obtained by crystallisation", "ACCEPT filtrationACCEPT evaporationACCEPT simple distillationACCEPT crystallising", "4"], ["", "", "", "Total 7"]], "text": "Question number | Answer | Notes | Marks\n1(a)(i) | fractional distillation |  | 1\n(ii) | chromatography |  | 1\n(iii) | simple distillation | ACCEPT distillation | 1\n(b) | M1 A mixture of copper(II) oxide and copper(II) sulfate can be separated by first dissolving the copper(II) sulfate in distilled water.M2 The copper(II) oxide is then removed by filteringM3 Some of the water from the copper(II) sulfate solution is then removed by evaporatingM4 A pure sample of hydrated copper(II) sulfate is then obtained by crystallisation | ACCEPT filtrationACCEPT evaporationACCEPT simple distillationACCEPT crystallising | 4\n |  |  | Total 7", "row_count": 6, "confidence": 1.0, "element_id": "e000022", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 22, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["2(a)(i)(ii)(iii)", "(hydrated) iron(III) oxide/Fe2O3", "IGNORE iron oxide", "1"], ["D oxidation", "REJECT iron(II) oxide", "1"], ["A is incorrect as it is not a combustion reactionB is incorrect as it is not a decomposition reactionC is incorrect as it is not a neutralisation reaction", "ALLOW Zn", "1"], ["zinc", "", "1"], ["(b)(i)(ii)", "Fe+H2SO4→FeSO4+H2", "ALLOW multiples and fractions", "1"], ["(squeaky) pop with lighted splint/lit with a(Bunsen) flame", "IGNORE state symbols even if incorrect", "1"], ["(squeaky) pop with lighted splint/lit with a(Bunsen) flame", "IGNORE just‘burns with a squeaky pop’", "1"], ["(squeaky) pop with lighted splint/lit with a(Bunsen) flame", "REJECT use of glowing splint", ""], ["(c)(i)(ii)", "displacement", "ACCEPT redox/oxidation and reduction", "1"], ["pink-brown/pink(solid)", "ACCEPT pink/brown/orange alone or in combinations eg orange-brown", "1"], ["(squeaky) pop with lighted splint/lit with a(Bunsen) flame", "ALLOW red-brown", ""], ["(squeaky) pop with lighted splint/lit with a(Bunsen) flame", "REJECT red", ""], ["(d)", "iron is less reactive/lower in the reactivity series(than magnesium) ORA", "IGNORE just‘iron is not reactive enough’ with no comparison", "1"], ["", "", "", "Total 8"]], "text": "Question number | Answer | Notes | Marks\n2(a)(i)(ii)(iii) | (hydrated) iron(III) oxide/Fe2O3 | IGNORE iron oxide | 1\nD oxidation | REJECT iron(II) oxide | 1\nA is incorrect as it is not a combustion reactionB is incorrect as it is not a decomposition reactionC is incorrect as it is not a neutralisation reaction | ALLOW Zn | 1\nzinc |  | 1\n(b)(i)(ii) | Fe+H2SO4→FeSO4+H2 | ALLOW multiples and fractions | 1\n(squeaky) pop with lighted splint/lit with a(Bunsen) flame | IGNORE state symbols even if incorrect | 1\n(squeaky) pop with lighted splint/lit with a(Bunsen) flame | IGNORE just‘burns with a squeaky pop’ | 1\n(squeaky) pop with lighted splint/lit with a(Bunsen) flame | REJECT use of glowing splint | \n(c)(i)(ii) | displacement | ACCEPT redox/oxidation and reduction | 1\npink-brown/pink(solid) | ACCEPT pink/brown/orange alone or in combinations eg orange-brown | 1\n(squeaky) pop with lighted splint/lit with a(Bunsen) flame | ALLOW red-brown | \n(squeaky) pop with lighted splint/lit with a(Bunsen) flame | REJECT red | \n(d) | iron is less reactive/lower in the reactivity series(than magnesium) ORA | IGNORE just‘iron is not reactive enough’ with no comparison | 1\n |  |  | Total 8", "row_count": 15, "confidence": 1.0, "element_id": "e000023", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 23, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["3(a)", "Type of bonding", "Type of structure", "", "4"], ["(X) covalent", "simple molecular", "", ""], ["(Y) M1 covalent", "M2 giant(covalent)", "ALLOW giant molecular/giant covalent latticeACCEPT macromolecular", ""], ["(Z) M3 ionic", "M4 giant(ionic)lattice", "ALLOW(ionic)latticeIGNORE‘giant’alone", ""], ["(b)", "An explanation that links the following points", "", "2"], ["M1(X has) weak intermolecular forces/weak forces between molecules", "ALLOW weak intermolecular bonds/weak bonds between moleculesIGNORE less energy", ""], ["M2(so) little energy needed to overcome the forces/separate the molecules/the forces require little energy to break", "REJECT any reference to weak covalent bonds or covalent bonds being broken or ionic bonds for both marks.REJECT intermolecular forces between atoms/bonds for both marks", ""], ["", "", "", "Total 6"]], "text": "Question number | Answer | Notes | Marks\n3(a) | Type of 