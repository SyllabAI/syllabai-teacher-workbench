INSERT INTO public.document_chunks VALUES ('e5d4ef31-6c8f-441e-b603-fab0a49088f6', '6e666887-9049-4e56-a93d-f605300a216a', 1, 'Our aim is to help everyone progress in their lives through education. We believe in every kind of learning, for all kinds of people, wherever they are in the world. We''ve been involved in education for over 150 years, and by working across 70 countries, in 100 languages, we have built an international reputation for our commitment to high standards and raising achievement through innovation in education. Find out more about how we can help you and your students at: www.pearson.com/uk
