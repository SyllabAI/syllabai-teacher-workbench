000152", "e000153"], "pageNumber": 1}, {"level": 2, "title": "(Total for Question 9 = 14 marks)", "sectionId": "s008", "elementIds": ["e000155", "e000157", "e000158", "e000159", "e000160", "e000161", "e000162", "e000163", "e000164", "e000165", "e000166", "e000167", "e000168", "e000169", "e000170", "e000171", "e000172", "e000173", "e000174", "e000175", "e000177", "e000178"], "pageNumber": 1}, {"level": 2, "title": "TOTAL FOR PAPER=110 MARKS", "sectionId": "s009", "elementIds": [], "pageNumber": 1}, {"level": 2, "title": "BLANK PAGE", "sectionId": "s010", "elementIds": [], "pageNumber": 1}, {"level": 2, "title": "BLANK PAGE", "sectionId": "s011", "elementIds": [], "pageNumber": 1}], "equations": [{"text": "\\dots \\dots \\mathrm {C} _ {2} \\mathrm {H} _ {6} + \\dots \\dots \\mathrm {O} _ {2} \\rightarrow \\dots \\dots \\mathrm {C O} _ {2} + \\dots \\dots \\mathrm {H} _ {2} \\mathrm {O}", "latex": "\\dots \\dots \\mathrm {C} _ {2} \\mathrm {H} _ {6} + \\dots \\dots \\mathrm {O} _ {2} \\rightarrow \\dots \\dots \\mathrm {C O} _ {2} + \\dots \\dots \\mathrm {H} _ {2} \\mathrm {O}", "confidence": 1.0, "element_id": "e000070", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 70, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {C a C O} _ {3} + 2 \\mathrm {H C l} \\rightarrow \\mathrm {C a C l} _ {2} + \\mathrm {H} _ {2} \\mathrm {O} + \\mathrm {C O} _ {2}", "latex": "\\mathrm {C a C O} _ {3} + 2 \\mathrm {H C l} \\rightarrow \\mathrm {C a C l} _ {2} + \\mathrm {H} _ {2} \\mathrm {O} + \\mathrm {C O} _ {2}", "confidence": 1.0, "element_id": "e000141", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 141, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {P b} \\left(\\mathrm {N O} _ {3}\\right) _ {2} (\\dots \\dots \\dots) + 2 \\mathrm {H C l} (\\dots \\dots \\dots) \\rightarrow \\mathrm {P b C l} _ {2} (\\dots \\dots \\dots) + 2 \\mathrm {H N O} _ {3} (\\dots \\dots \\dots)", "latex": "\\mathrm {P b} \\left(\\mathrm {N O} _ {3}\\right) _ {2} (\\dots \\dots \\dots) + 2 \\mathrm {H C l} (\\dots \\dots \\dots) \\rightarrow \\mathrm {P b C l} _ {2} (\\dots \\dots \\dots) + 2 \\mathrm {H N O} _ {3} (\\dots \\dots \\dots)", "confidence": 1.0, "element_id": "e000176", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 176, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "pageCount": 1, "documentId": "9e5d961d-751e-584f-af10-6da7d8ddd75f", "provenance": {"engine": "glm-ocr-markdown", "application": "syllabai-parser", "extractedAt": "2026-09-13T12:55:06.133962925Z", "engineVersion": "1.1.0", "schemaVersion": "1.0", "extractionParams": {"pageBoundaries": "none-in-source", "sourceLineCount": 203, "upstreamConverter": "zai-glm-ocr", "entityDecodedLines": 0, "signedUrlFigureRefs": 0, "normalizedHtmlEntities": true}}, "textBlocks": [{"role": "list_item", "text": "Use black ink or ball-point pen.", "confidence": 1.0, "element_id": "e000000", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 0, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Instructions", "confidence": 1.0, "element_id": "e000001", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 1, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Fill in the boxes at the top of this page with your name, centre number and candidate number.", "confidence": 1.0, "element_id": "e000002", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 2, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer all questions.", "confidence": 1.0, "element_id": "e000003", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 3, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer the questions in the spaces provided - there may be more space than you need.", "confidence": 1.0, "element_id": "e000004", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 4, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Show all the steps in any calculations and state the units.", "confidence": 1.0, "element_id": "e000005", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 5, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Some questions must be answered with a cross in a box . If you change your mind about an answer, put a line through the box and then mark your new answer with a cross.", "confidence": 1.0, "element_id": "e000006", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 6, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Information", "confidence": 1.0, "element_id": "e000007", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 7, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The total mark for this paper is 110.", "confidence": 1.0, "element_id": "e000008", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 8, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The marks for each question are shown in brackets", "confidence": 1.0, "element_id": "e000009", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 9, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "use this as a guide as to how much time to spend on each question.", "confidence": 1.0, "element_id": "e000010", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 10, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Advice", "confidence": 1.0, "element_id": "e000011", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 11, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Read each question carefully before you start to answer it.", "confidence": 1.0, "element_id": "e000012", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 12, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Write your answers neatly and in good English.", "confidence": 1.0, "element_id": "e000013", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 13, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Try to answer every question.", "confidence": 1.0, "element_id": "e000014", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 14, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Check your answers if you have time at the end.", "confidence": 1.0, "element_id": "e000015", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 15, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Good luck with your examination.", "confidence": 1.0, "element_id": "e000016", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 16, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Turn over", "confidence": 1.0, "element_id": "e000017", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 17, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The lanthanoids (atomic numbers 58-71) and the actinoids (atomic numbers 90-103) have been omitted. The relative atomic masses of copper and chlorine have not been rounded to the nearest whole number.", "confidence": 1.0, "element_id": "e000019", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 19, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Answer ALL questions.", "confidence": 1.0, "element_id": "e000020", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 20, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "1 The box shows the names of some substances.", "confidence": 1.0, "element_id": "e000021", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 21, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Complete the table by choosing substances from the box that match the description.", "confidence": 1.0, "element_id": "e000023", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 23, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Each substance may be used once, more than once or not at all.", "confidence": 1.0, "element_id": "e000024", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 24, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(5)", "confidence": 1.0, "element_id": "e000025", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 25, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Describe a test for carbon dioxide.", "confidence": 1.0, "element_id": "e000027", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 27, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 1 = 7 marks)", "confidence": 1.0, "element_id": "e000028", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 28, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "2 (a) Table 1 gives some information about three subatomic particles.", "confidence": 1.0, "element_id": "e000029", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 29, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Complete Table 1 by giving the missing information.", "confidence": 1.0, "element_id": "e000030", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 30, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Table 1", "confidence": 1.0, "element_id": "e000032", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 32, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Give the name of the part of the atom containing protons and neutrons.", "confidence": 1.0, "element_id": "e000033", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 33, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Table 2 shows the numbers of protons, neutrons and electrons in the species U, V, W, X, Y and Z.", "confidence": 1.0, "element_id": "e000034", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 34, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Table 2", "confidence": 1.0, "element_id": "e000036", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 36, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Use the information in Table 2 to answer these questions.", "confidence": 1.0, "element_id": "e000037", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 37, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Each species may be used once, more than once or not at all.", "confidence": 1.0, "element_id": "e000038", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 38, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Give the letter of the species that has six electrons in its outer shell.", "confidence": 1.0, "element_id": "e000039", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 39, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Give the mass number of Z.", "confidence": 1.0, "element_id": "e000040", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 40, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Give the letter of the species that is a positive ion.", "confidence": 1.0, "element_id": "e000041", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 41, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iv) Give the letters of the two species that are isotopes of the same element.", "confidence": 1.0, "element_id": "e000042", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 42, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) A sample of neon contains two isotopes, $ ^{20} \\mathrm{N e} $ and $ ^{22} \\mathrm{N e} $ The relative abundances of the two isotopes in the sample are", "confidence": 1.0, "element_id": "e000043", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 43, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "$ ^{20} \\mathrm{Ne} $ 91.2% $ ^{22} \\mathrm{Ne} $ 8.80%", "confidence": 1.0, "element_id": "e000044", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 44, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Calculate the relative atomic mass of this sample of neon. Give your answer to one decimal place.", "confidence": 1.0, "element_id": "e000045", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 45, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "relative atomic mass=", "confidence": 1.0, "element_id": "e000046", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 46, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 2 = 11 marks)", "confidence": 1.0, "element_id": "e000047", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 47, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "3 Some sugar is added to cold water in a beaker. After some time, all the sugar dissolves and spreads throughout the water.", "confidence": 1.0, "element_id": "e000048", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 48, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) (i) Name the process that occurs which causes the sugar to spread throughout the water.", "confidence": 1.0, "element_id": "e000049", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 49, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) State two ways to make the sugar dissolve more quickly.", "confidence": 1.0, "element_id": "e000050", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 50, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Pure water can be obtained from the sugar solution using this apparatus.", "confidence": 1.0, "element_id": "e000051", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 51, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Name the process used to obtain pure water from the sugar solution.", "confidence": 1.0, "element_id": "e000053", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 53, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Explain the purpose of the piece of apparatus labelled X.", "confidence": 1.0, "element_id": "e000054", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 54, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 3 = 6 marks)", "confidence": 1.0, "element_id": "e000055", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 55, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000056", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 56, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "4 A student uses paper chromatography in an experiment to separate the dyes in four different food colourings, E, F, G and H.", "confidence": 1.0, "element_id": "e000057", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 57, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The diagram shows the appearance of the paper before and after the experiment.", "confidence": 1.0, "element_id": "e000058", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 58, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) (i) Describe how the student should complete the experiment after putting a spot of each food colouring on the paper.", "confidence": 1.0, "element_id": "e000060", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 60, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(3)", "confidence": 1.0, "element_id": "e000061", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 61, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Deduce the number of dyes in food colouring H.", "confidence": 1.0, "element_id": "e000062", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 62, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Suggest why food colouring F does not move during the experiment.", "confidence": 1.0, "element_id": "e000063", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 63, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iv) Explain which two food colourings contain the dye that is likely to be the most soluble in the solvent.", "confidence": 1.0, "element_id": "e000064", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 64, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Determine which food colouring contains a dye with $ R_{f} $ value closest to 0.67 Show your working.", "confidence": 1.0, "element_id": "e000065", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 65, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "5 This question is about alkanes and alkenes.", "confidence": 1.0, "element_id": "e000066", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 66, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "( a ) ( i ) Complete the boxes by giving the missing information about the alkane with the molecular formula $ \\mathrm{C_{2} H_{6}} $", "confidence": 1.0, "element_id": "e000067", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 67, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Complete the chemical equation for the complete combustion of the alkane $ \\mathrm{C_{2} H_{6}} $", "confidence": 1.0, "element_id": "e000069", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 69, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Incomplete combustion occurs when the air supply is limited Give the names of two products of incomplete combustion.", "confidence": 1.0, "element_id": "e000071", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 71, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) An alkene with molecular formula $ \\mathrm{C_{4}H_{8}} $ reacts with bromine to form a compound with molecular formula $ \\mathrm{C_{4}H_{8}Br_{2}} $", "confidence": 1.0, "element_id": "e000072", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 72, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) What is the name of this type of reaction?", "confidence": 1.0, "element_id": "e000073", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 73, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A addition", "confidence": 1.0, "element_id": "e000074", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 74, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B decomposition", "confidence": 1.0, "element_id": "e000075", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 75, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "precipitation", "confidence": 1.0, "element_id": "e000076", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 76, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D substitution", "confidence": 1.0, "element_id": "e000077", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 77, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Draw displayed formulae for two different alkenes with the molecular formula $ \\mathrm{C_{4}H_{8}} $", "confidence": 1.0, "element_id": "e000078", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 78, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) State the term used for compounds with the same molecular formula but different structural formulae.", "confidence": 1.0, "element_id": "e000080", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 80, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) The alkene $ \\mathrm{C_{3} H_{6}} $ can be polymerised to form the polymer poly(propene).", "confidence": 1.0, "element_id": "e000081", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 81, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Complete the equation for this polymerisation reaction.", "confidence": 1.0, "element_id": "e000082", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 82, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Two ways of disposing of polymers such as poly(propene) are", "confidence": 1.0, "element_id": "e000084", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 84, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "burying them in landfill sites", "confidence": 1.0, "element_id": "e000085", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 85, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "burning them to release heat energy", "confidence": 1.0, "element_id": "e000086", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 86, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Discuss the environmental problems caused by these two methods of disposal.", "confidence": 1.0, "element_id": "e000087", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 87, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 5 = 15 marks)", "confidence": 1.0, "element_id": "e000088", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 88, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000089", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 89, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "6 This question is about some of the Group 1 elements and their compounds.", "confidence": 1.0, "element_id": "e000090", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 90, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) A teacher adds a small piece of lithium to water in a trough.", "confidence": 1.0, "element_id": "e000091", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 91, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Give three observations that are made when lithium reacts with water.", "confidence": 1.0, "element_id": "e000092", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 92, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) After the reaction has finished, the teacher adds a few drops of universal indicator to the solution in the trough.", "confidence": 1.0, "element_id": "e000093", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 93, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Explain the colour of the universal indicator after it is added to the solution.", "confidence": 1.0, "element_id": "e000094", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 94, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Write a chemical equation for the reaction of lithium with water.", "confidence": 1.0, "element_id": "e000095", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 95, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) A student does a flame test to see if a white solid contains sodium ions. She cleans a platinum wire before using it for the flame test.", "confidence": 1.0, "element_id": "e000096", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 96, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Explain why the student needs to clean the platinum wire.", "confidence": 1.0, "element_id": "e000097", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 97, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Which of these is the colour of the flame if the solid contains sodium ions? (1)", "confidence": 1.0, "element_id": "e000098", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 98, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A green", "confidence": 1.0, "element_id": "e000099", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 99, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B lilac", "confidence": 1.0, "element_id": "e000100", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 100, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C red", "confidence": 1.0, "element_id": "e000101", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 101, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D yellow", "confidence": 1.0, "element_id": "e000102", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 102, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Potassium sulfate $ \\left( \\mathrm{K}_{2} \\mathrm{SO}_{4} \\right) $ is an ionic compound.", "confidence": 1.0, "element_id": "e000103", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 103, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Give the formula of each ion in potassium sulfate.", "confidence": 1.0, "element_id": "e000104", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 104, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "potassium ion sulfate ion", "confidence": 1.0, "element_id": "e000105", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 105, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The melting point of potassium sulfate is $ 1 0 6 9^{\\circ} \\mathrm{C} $.", "confidence": 1.0, "element_id": "e000106", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 106, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Explain why potassium sulfate has a high melting point.", "confidence": 1.0, "element_id": "e000107", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 107, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Refer to structure and bonding in your answer.", "confidence": 1.0, "element_id": "e000108", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 108, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 6 = 15 marks)", "confidence": 1.0, "element_id": "e000109", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 109, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "7 A student investigates the reaction between magnesium and hydrochloric acid. He uses this method.", "confidence": 1.0, "element_id": "e000110", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 110, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 1 add $ 2 5 \\mathrm{c m}^{3} $ of dilute hydrochloric acid to a polystyrene cup", "confidence": 1.0, "element_id": "e000111", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 111, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 2 record the temperature of the acid", "confidence": 1.0, "element_id": "e000112", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 112, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 3 find the mass of a 10cm strip of magnesium ribbon", "confidence": 1.0, "element_id": "e000113", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 113, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 4 add the magnesium ribbon to the hydrochloric acid", "confidence": 1.0, "element_id": "e000114", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 114, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 5 when all the magnesium has reacted, record the highest temperature reached", "confidence": 1.0, "element_id": "e000115", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 115, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Complete the word equation for the reaction.", "confidence": 1.0, "element_id": "e000116", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 116, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The thermometer shows the temperature of the acid at the start of the experiment.", "confidence": 1.0, "element_id": "e000117", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 117, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Complete the table by giving the temperatures to the nearest 0.1 $ ^{\\circ} \\mathrm{C}. $", "confidence": 1.0, "element_id": "e000119", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 119, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(2)", "confidence": 1.0, "element_id": "e000120", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 120, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Show that the heat energy change (Q) for this reaction is about 2200 J.", "confidence": 1.0, "element_id": "e000122", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 122, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "[mass of $ 1. 0 \\mathrm{c m}^{3} $ of solution $ = 1. 0 \\mathrm{g} $ ]", "confidence": 1.0, "element_id": "e000123", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 123, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "[for the solution, $ c=4. 2 \\mathrm{J / g /^{\\circ} C} $]", "confidence": 1.0, "element_id": "e000124", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 124, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) The mass of magnesium used by the student was 0.12 g.", "confidence": 1.0, "element_id": "e000125", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 125, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Calculate the value of the enthalpy change $ (\\Delta H) $ , in kilojoules per mole of magnesium, for the reaction between magnesium and hydrochloric acid.", "confidence": 1.0, "element_id": "e000126", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 126, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Include a sign in your answer.", "confidence": 1.0, "element_id": "e000127", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 127, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 7 = 9 marks)", "confidence": 1.0, "element_id": "e000128", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 128, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "8 (a) A scientist finds an unlabelled bottle on a shelf.", "confidence": 1.0, "element_id": "e000129", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 129, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "She thinks the bottle contains a solution of ammonium sulfate, $ \\mathrm{(N H_{4})_{2} S O_{4}} $", "confidence": 1.0, "element_id": "e000130", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 130, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Describe tests the scientist could do to show that the solution is ammonium sulfate.", "confidence": 1.0, "element_id": "e000131", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 131, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Ammonium sulfate is often used as a fertiliser.", "confidence": 1.0, "element_id": "e000132", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 132, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "It is prepared by reacting ammonia $ \\mathrm{(N H_{3})} $ with sulfuric acid $ \\mathrm{(H_{2} S O_{4})}. $", "confidence": 1.0, "element_id": "e000133", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 133, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Name the type of reaction that occurs between ammonia and sulfuric acid.", "confidence": 1.0, "element_id": "e000134", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 134, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Write a chemical equation for the reaction of ammonia with sulfuric acid.", "confidence": 1.0, "element_id": "e000135", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 135, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Draw a dot-and-cross diagram to show the bonding in a molecule of ammonia. Show outer electrons only.", "confidence": 1.0, "element_id": "e000136", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 136, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000137", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 137, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "9 A student uses this apparatus to investigate the rate of reaction between marble chips and dilute hydrochloric acid.", "confidence": 1.0, "element_id": "e000138", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 138, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The equation for the reaction is", "confidence": 1.0, "element_id": "e000140", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 140, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) During the reaction the mass of the contents of the flask decreases.", "confidence": 1.0, "element_id": "e000142", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 142, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) State why the mass of the contents of the flask decreases.", "confidence": 1.0, "element_id": "e000143", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 143, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) State the purpose of the cotton wool.", "confidence": 1.0, "element_id": "e000144", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 144, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Explain why sulfuric acid is not a suitable acid to use in this investigation.", "confidence": 1.0, "element_id": "e000145", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 145, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The graph shows the student''s results.", "confidence": 1.0, "element_id": "e000146", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 146, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Decrease in mass in g", "confidence": 1.0, "element_id": "e000147", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 147, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) In the investigation the marble chips are in excess. Explain the shape of the graph.", "confidence": 1.0, "element_id": "e000149", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 149, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(4)", "confidence": 1.0, "element_id": "e000150", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 150, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The student repeats the experiment using the same volume of hydrochloric acid but of half the concentration of the original acid. All other conditions are kept the same.", "confidence": 1.0, "element_id": "e000151", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 151, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "On the grid, draw the curve the student would obtain.", "confidence": 1.0, "element_id": "e000152", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 152, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Explain, using particle collision theory, how increasing the temperature affects the rate of a reaction.", "confidence": 1.0, "element_id": "e000153", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 153, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "(Total for Question 9 = 14 marks)", "confidence": 1.0, "element_id": "e000154", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 154, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "10 (a) The diagram shows the apparatus a teacher uses to determine the formula of an oxide of lead.", "confidence": 1.0, "element_id": "e000155", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 155, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "This is the teacher''s method.", "confidence": 1.0, "element_id": "e000157", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 157, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step1 find the mass of the reduction tube", "confidence": 1.0, "element_id": "e000158", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 158, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 2 add some of the lead oxide to the reduction tube", "confidence": 1.0, "element_id": "e000159", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 159, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 3 find the mass of the reduction tube and lead oxide", "confidence": 1.0, "element_id": "e000160", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 160, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 4 pass hydrogen gas over the lead oxide and ignite the hydrogen at the hole", "confidence": 1.0, "element_id": "e000161", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 161, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 5 heat the lead oxide strongly for 10 minutes", "confidence": 1.0, "element_id": "e000162", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 162, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 7 find the new mass of the reduction tube and its contents", "confidence": 1.0, "element_id": "e000163", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 163, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 6 keep passing hydrogen through the reduction tube until the tube and contents are cool", "confidence": 1.0, "element_id": "e000164", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 164, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Give a reason why hydrogen is passed through the reduction tube until the tube and contents are cool.", "confidence": 1.0, "element_id": "e000165", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 165, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Describe what the teacher should do next to make sure all the lead oxide has been reduced to lead.", "confidence": 1.0, "element_id": "e000166", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 166, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The teacher completes the experiment and obtains these results.", "confidence": 1.0, "element_id": "e000167", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 167, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "mass of reduction tube = 23.50 g", "confidence": 1.0, "element_id": "e000168", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 168, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "mass of tube + lead oxide = 28.64 g", "confidence": 1.0, "element_id": "e000169", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 169, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "mass of tube + lead = 28.16 g", "confidence": 1.0, "element_id": "e000170", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 170, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Calculate the mass of lead formed.", "confidence": 1.0, "element_id": "e000171", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 171, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Calculate the mass of oxygen removed from the lead oxide.", "confidence": 1.0, "element_id": "e000172", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 172, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Determine the empirical formula of the lead oxide.", "confidence": 1.0, "element_id": "e000173", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 173, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) The insoluble salt lead(II) chloride $ \\mathrm{(P b C l_{2})} $ can be prepared by reacting a solution of lead(II) nitrate with dilute hydrochloric acid.", "confidence": 1.0, "element_id": "e000174", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 174, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Complete the equation for the reaction by adding the state symbols.", "confidence": 1.0, "element_id": "e000175", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 175, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Show that the maximum mass of lead(II) chloride that can be made from 0.0370 mol of hydrochloric acid is about 5 g.", "confidence": 1.0, "element_id": "e000177", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 177, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "[Mr of PbCl $ _{2} $ =278]", "confidence": 1.0, "element_id": "e000178", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 178, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "TOTAL FOR PAPER=110 MARKS", "confidence": 1.0, "element_id": "e000179", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 179, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000180", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 180, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000181", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 181, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "schemaVersion": "1.0"}', NULL, '2026-09-13 12:55:24.198751+00');
INSERT INTO public.documents VALUES ('8e7cd426-edbf-4186-9107-ded88819afbd', 'b47c576c-31e3-51f4-b21d-b07712b7298b', '1.0', 1, 'MARK_SCHEME', 'corpus/igcse-chemistry-4ch0-1c-2021jun/MS.md', 'MS.md', 'text/markdown', '268af62afb9286bf5563f0bd11e59004c2eae78bdeb56a6a6ef3067cbdd58feb', 'SHA-256', 1, 40, 40, 15, 'glm-ocr-markdown', '1.1.0', '2026-09-13 12:55:06.200503+00', '{"pages": [{"width": null, "height": null, "pageNumber": 1}], "source": {"uri": "corpus/igcse-chemistry-4ch0-1c-2021jun/MS.md", "checksum": "268af62afb9286bf5563f0bd11e59004c2eae78bdeb56a6a6ef3067cbdd58feb", "fileName": "MS.md", "mimeType": "text/markdown", "checksumAlgorithm": "SHA-256"}, "tables": [{"rows": [["Question number", "Answer", "Notes", "Marks"], ["1(a)", "", "ALLOW correct formulae", "5"], ["Information", "Substance"], ["a good conductor of electricity", "copper"], ["an element that has a basic oxide", "copper"], ["a substance used as a fuel", "methane"], ["a major cause of acid rain", "sulfur dioxide"], ["", "a non-metallic element that is a solid at room temperature", "", ""], ["(b)", "A description which refers to the following points\nM1 bubble/add (the gas/carbon dioxide) into limewater\nM2 (limewater) turns cloudy/milky", "ACCEPT calcium hydroxide\nACCEPT white precipitate\nM2 dep on use of limewater/calcium hydroxide in M1", "2\nTotal 7"]], "text": "Question number | Answer | Notes | Marks\n1(a) |  | ALLOW correct formulae | 5\nInformation | Substance\na good conductor of electricity | copper\nan element that has a basic oxide | copper\na substance used as a fuel | methane\na major cause of acid rain | sulfur dioxide\n | a non-metallic element that is a solid at room temperature |  | \n(b) | A description which refers to the following points\nM1 bubble/add (the gas/carbon dioxide) into limewater\nM2 (limewater) turns cloudy/milky | ACCEPT calcium hydroxide\nACCEPT white precipitate\nM2 dep on use of limewater/calcium hydroxide in M1 | 2\nTotal 7", "row_count": 9, "confidence": 1.0