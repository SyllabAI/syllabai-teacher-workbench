INSERT INTO public.question_parts VALUES ('2c1638c5-c234-433a-833b-b5815ee6bd1d', '69ea7972-11c5-4374-847f-406839bff30d', 'b-ii', 'Complete the equation for the polymerisation reaction by giving the displayed formula of the repeat unit of the polymer.', NULL, 0, 2, '2026-09-13 13:03:38.363516+00');
INSERT INTO public.question_parts VALUES ('37c1bfc7-6252-4fb9-a6c1-21dc315022f2', 'eab78a2e-5253-41f0-93a8-5748fca20bff', 'a', 'The atomic number of phosphorus is 15 Give the electronic configuration of an atom of phosphorus.', NULL, 0, 0, '2026-09-13 13:03:38.363583+00');
INSERT INTO public.question_parts VALUES ('a73d83e6-e8b3-4035-b730-9d2a8a21a411', 'eab78a2e-5253-41f0-93a8-5748fca20bff', 'b', 'Calcium phosphide is an ionic compound used in pest control. The formula of a calcium ion is $ \mathrm{C a}^{2+} $ Explain why the formula of calcium phosphide is $ \mathrm{C a}_{3} \mathrm{P}_{2} $', NULL, 0, 1, '2026-09-13 13:03:38.363614+00');
INSERT INTO public.question_parts VALUES ('c7b81e51-d6f0-4de0-99d5-45dfdc1b85a7', 'eab78a2e-5253-41f0-93a8-5748fca20bff', 'c', 'Calcium phosphide can be produced by heating calcium phosphate with carbon.', NULL, 0, 2, '2026-09-13 13:03:38.363648+00');
INSERT INTO public.question_parts VALUES ('dc673c7d-00b7-43b5-9bfe-0429e1031b1f', 'eab78a2e-5253-41f0-93a8-5748fca20bff', 'c-i', 'Complete the equation for the reaction. $\mathrm {C a} _ {3} \left(\mathrm {P O} _ {4}\right) _ {2} + \dots \dots \dots \dots \mathrm {C} \rightarrow \mathrm {C a} _ {3} \mathrm {P} _ {2} + \dots \dots \dots \dots \mathrm {C O}$', NULL, 0, 3, '2026-09-13 13:03:38.363695+00');
INSERT INTO public.question_parts VALUES ('2ea12e5b-a0d9-4c10-8ad9-c1eaa70320f8', 'eab78a2e-5253-41f0-93a8-5748fca20bff', 'c-ii', 'Explain the role of carbon in the reaction.', NULL, 0, 4, '2026-09-13 13:03:38.363731+00');
INSERT INTO public.question_parts VALUES ('0d561b1b-080c-46de-ac21-234322f6cc0e', 'eab78a2e-5253-41f0-93a8-5748fca20bff', 'd', 'Calcium phosphide reacts with water to form calcium hydroxide and phosphine, $ \mathrm{P H_{3}} $ Give a chemical equation for this reaction.', NULL, 0, 5, '2026-09-13 13:03:38.363779+00');
INSERT INTO public.question_parts VALUES ('80f369f4-1c4f-44fc-9607-72018b67b4a8', 'eab78a2e-5253-41f0-93a8-5748fca20bff', 'e', 'Explain why calcium phosphide has a high melting point. You should refer to structure and bonding in your answer.', NULL, 0, 6, '2026-09-13 13:03:38.363809+00');
INSERT INTO public.question_parts VALUES ('6dc144f1-79c1-464c-892d-eb4f0ac69846', '4a0830c2-8338-491c-bddb-cfd73a18e193', 'a', 'Explain, using the reactivity series, why carbon can be used to extract iron from iron(III) oxide.', NULL, 0, 0, '2026-09-13 13:03:38.363848+00');
INSERT INTO public.question_parts VALUES ('bcace087-e8c4-478f-b42c-fe6a11438f5b', '4a0830c2-8338-491c-bddb-cfd73a18e193', 'a-ii', 'Suggest why sodium was not discovered until 1807.', NULL, 0, 1, '2026-09-13 13:03:38.363885+00');
INSERT INTO public.question_parts VALUES ('aa31c4e5-3a14-4285-a289-f3d2c58051a5', '4a0830c2-8338-491c-bddb-cfd73a18e193', 'b', 'The diagram shows a simplified version of the Downs cell, which can be used to produce sodium industrially. The electrolyte is molten sodium chloride.', NULL, 0, 2, '2026-09-13 13:03:38.363919+00');
