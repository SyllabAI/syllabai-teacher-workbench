INSERT INTO public.question_parts VALUES ('5388921c-868c-45ac-8723-b589f5831976', '3c999e8d-00eb-41aa-bb57-ebf6ad5e9d7d', 'a-iii', 'When the concentration of the sodium chloride solution is low, the gas collected in test tube P is mostly oxygen. The formation of this gas can be represented by an ionic half-equation. Balance the equation. $\mathrm {O H} ^ {-} \rightarrow \mathrm {H} _ {2} \mathrm {O} + \mathrm {O} _ {2} + \mathrm {e} ^ {-}$', NULL, 0, 2, '2026-09-13 12:57:42.153965+00');
INSERT INTO public.question_parts VALUES ('69bd75a5-a00e-49aa-a094-edeb9f964aa8', '3c999e8d-00eb-41aa-bb57-ebf6ad5e9d7d', 'b', 'When the concentration of sodium chloride solution is high, the gas that collects in test tube P is mostly chlorine. The equation for its formation is: $2 \mathrm {C l} ^ {-} \rightarrow \mathrm {C l} _ {2} + 2 \mathrm {e} ^ {-}$ In one experiment, the volume of chlorine gas collected was $ 1 8 \mathrm{c m}^{3}. $', NULL, 0, 3, '2026-09-13 12:57:42.153977+00');
INSERT INTO public.question_parts VALUES ('1455f7ee-2714-4687-884e-bdec9bc79819', '3c999e8d-00eb-41aa-bb57-ebf6ad5e9d7d', 'b-i', 'Calculate the amount, in moles, of chlorine gas in $ 1 8 \mathrm{c m}^{3}. $ (The volume of 1 mol of a gas at room temperature and pressure is $ 2 4 0 0 0 \mathrm{c m}^{3} $)', NULL, 0, 4, '2026-09-13 12:57:42.153983+00');
INSERT INTO public.question_parts VALUES ('46de948a-aea3-458d-b740-57265bfe1b21', '3c999e8d-00eb-41aa-bb57-ebf6ad5e9d7d', 'b-ii', 'Calculate the quantity of electricity, in coulombs, needed to produce this volume of chlorine gas. (1 faraday=96500 coulombs)', NULL, 0, 5, '2026-09-13 12:57:42.153989+00');
INSERT INTO public.question_parts VALUES ('c4aeb4d9-d4bf-49a1-9daa-ea429535d576', '3c999e8d-00eb-41aa-bb57-ebf6ad5e9d7d', 'c', 'Chlorine reacts with potassium bromide solution. The equation for this reaction is: $\mathrm {C l} _ {2} (\mathrm {g}) + 2 \mathrm {B r} ^ {-} (\mathrm {a q}) \rightarrow 2 \mathrm {C l} ^ {-} (\mathrm {a q}) + \mathrm {B r} _ {2} (\mathrm {a q})$ This reaction can be described as both a displacement reaction and a redox reaction.', NULL, 0, 6, '2026-09-13 12:57:42.153994+00');
INSERT INTO public.question_parts VALUES ('2db1be12-4d97-416b-8c74-34e682742691', '3c999e8d-00eb-41aa-bb57-ebf6ad5e9d7d', 'c-i', 'Identify the element that is displaced in this reaction.', NULL, 0, 7, '2026-09-13 12:57:42.154006+00');
INSERT INTO public.question_parts VALUES ('244a9525-0e11-4356-b6c6-8918e3f69a23', '3c999e8d-00eb-41aa-bb57-ebf6ad5e9d7d', 'c-ii', 'State the meaning of the term redox. QUESTION 5 CONTINUES ON THE NEXT PAGE', NULL, 0, 8, '2026-09-13 12:57:42.154012+00');
INSERT INTO public.question_parts VALUES ('995dbaa1-b24d-47e1-b311-4ceaac9fc8dc', '3c999e8d-00eb-41aa-bb57-ebf6ad5e9d7d', 'd', 'Chlorine is used in the manufacture of phosphorus pentachloride, $ \mathrm{P C I}_{5} $ The equation for the reaction is: $\mathrm {P C l} _ {3} (\mathrm {g}) + \mathrm {C l} _ {2} (\mathrm {g}) \rightleftharpoons \mathrm {P C l} _ {5} (\mathrm {g}) \quad \Delta H = - 1 2 4 \mathrm {k J / m o l}$', NULL, 0, 9, '2026-09-13 12:57:42.154016+00');
INSERT INTO public.question_parts VALUES ('5fa4b76c-699d-48af-bb49-36d46406a9a2', '3c999e8d-00eb-41aa-bb57-ebf6ad5e9d7d', 'd-i', 'What does the $ \rightleftharpoons $ symbol indicate about this reaction?', NULL, 0, 10, '2026-09-13 12:57:42.154022+00');
INSERT INTO public.question_parts VALUES ('6ae90735-4f65-4d2b-9e44-d107d1ef59da', '3c999e8d-00eb-41aa-bb57-ebf6ad5e9d7d', 'd-ii', 'Predict and explain the effect of increasing the pressure on the equilibrium position of this reaction. Prediction Explanation', NULL, 0, 11, '2026-09-13 12:57:42.154032+00');
