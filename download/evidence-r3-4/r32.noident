_2_1789063836353.png", "format": "png", "confidence": 1.0, "element_id": "e000031", "page_number": 1, "source_name": "assets/crop_2_1789063836353.png", "bounding_box": null, "element_type": "figure", "reading_order": 31, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "version": 1, "sections": [{"level": 2, "title": "Edexcel and BTEC Qualifications", "sectionId": "s001", "elementIds": ["e000004", "e000005", "e000006", "e000007", "e000008"], "pageNumber": 1}, {"level": 2, "title": "Pearson: helping people progress, everywhere", "sectionId": "s002", "elementIds": ["e000010", "e000011", "e000024", "e000025", "e000026", "e000027", "e000028", "e000029", "e000030"], "pageNumber": 1}], "equations": [], "pageCount": 1, "documentId": "60b14f60-96c3-5718-8982-5161a4b9496a", "provenance": {"engine": "glm-ocr-markdown", "application": "syllabai-parser", "extractedAt": "2026-09-13T12:57:21.660935769Z", "engineVersion": "1.1.0", "schemaVersion": "1.0", "extractionParams": {"pageBoundaries": "none-in-source", "sourceLineCount": 89, "upstreamConverter": "zai-glm-ocr", "entityDecodedLines": 1, "signedUrlFigureRefs": 0, "normalizedHtmlEntities": true}}, "textBlocks": [{"role": "paragraph", "text": "Mark Scheme (Results)", "confidence": 1.0, "element_id": "e000000", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 0, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "January 2012", "confidence": 1.0, "element_id": "e000001", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 1, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "International GCSE Chemistry (4CH0) Paper 2C", "confidence": 1.0, "element_id": "e000002", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 2, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Edexcel and BTEC Qualifications", "confidence": 1.0, "element_id": "e000003", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 3, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Edexcel and BTEC qualifications come from Pearson, the world''s leading learning company. We provide a wide range of qualifications including academic, vocational, occupational and specific programmes for employers. For further information, please call our GCE line on 0844 576 0025, our GCSE team on 0844 576 0027, or visit our qualifications website at www.edexcel.com. For information about our BTEC qualifications, please call 0844 576 0026, or visit our website at www.btec.co.uk.", "confidence": 1.0, "element_id": "e000004", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 4, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "If you have any subject specific questions about this specification that require the help of a subject specialist, you may find our Ask The Expert email service helpful.", "confidence": 1.0, "element_id": "e000005", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 5, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Ask The Expert can be accessed online at the following link:", "confidence": 1.0, "element_id": "e000006", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 6, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "http://www.edexcel.com/Aboutus/contact-us/", "confidence": 1.0, "element_id": "e000007", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 7, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Alternatively, you can speak directly to a subject specialist at Pearson about Edexcel qualifications on our dedicated Science telephone line: 0844 576 0037", "confidence": 1.0, "element_id": "e000008", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 8, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Pearson: helping people progress, everywhere", "confidence": 1.0, "element_id": "e000009", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 9, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Our aim is to help everyone progress in their lives through education. We believe in every kind of learning, for all kinds of people, wherever they are in the world. We''ve been involved in education for over 150 years, and by working across 70 countries, in 100 languages, we have built an international reputation for raising achievement through innovation in education. Find out more about how we can help you and your students at: www.pearson.com/uk", "confidence": 1.0, "element_id": "e000010", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 10, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "INTERNATIONAL GCSE CHEMISTRY 4CH0 2C-JANUARY 2012", "confidence": 1.0, "element_id": "e000011", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 11, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "PAPER TOTAL: 60 MARKS", "confidence": 1.0, "element_id": "e000024", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 24, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Further copies of this publication are available from Edexcel Publications, Adamsway, Mansfield, Notts, NG18 4FN", "confidence": 1.0, "element_id": "e000025", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 25, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Telephone 01623 467467", "confidence": 1.0, "element_id": "e000026", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 26, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Fax 01623 450481", "confidence": 1.0, "element_id": "e000027", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 27, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Email publication.orders@edexcel.com", "confidence": 1.0, "element_id": "e000028", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 28, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Order Code xxxxxxxx January 2012", "confidence": 1.0, "element_id": "e000029", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 29, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "For more information on Edexcel qualifications, please visit www.edexcel.com/quals", "confidence": 1.0, "element_id": "e000030", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 30, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "schemaVersion": "1.0"}', NULL, '2026-09-13 12:57:41.89432+00');
