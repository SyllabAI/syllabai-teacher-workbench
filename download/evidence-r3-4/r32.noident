g_level": null, "reading_order": 2, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Chemistry (4CH0) Paper 2CR", "confidence": 1.0, "element_id": "e000003", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 3, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Edexcel and BTEC Qualifications", "confidence": 1.0, "element_id": "e000004", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 4, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Edexcel and BTEC qualifications come from Pearson, the world''s leading learning company. We provide a wide range of qualifications including academic, vocational, occupational and specific programmes for employers. For further information visit our qualifications websites at www.edexcel.com or www.btec.co.uk for our BTEC qualifications. Alternatively, you can get in touch with us using the details on our contact us page at www.edexcel.com/contactus.", "confidence": 1.0, "element_id": "e000005", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 5, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "If you have any subject specific questions about this specification that require the help of a subject specialist, you can speak directly to the subject team at Pearson. Their contact details can be found on this link: www.edexcel.com/teachingservices.", "confidence": 1.0, "element_id": "e000006", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 6, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "You can also use our online Ask the Expert service at www.edexcel.com/ask. You will need an Edexcel username and password to access this service.", "confidence": 1.0, "element_id": "e000007", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 7, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Pearson: helping people progress, everywhere", "confidence": 1.0, "element_id": "e000008", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 8, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Our aim is to help everyone progress in their lives through education. We believe in every kind of learning, for all kinds of people, wherever they are in the world. We''ve been involved in education for over 150 years, and by working across 70 countries, in 100 languages, we have built an international reputation for our commitment to high standards and raising achievement through innovation in education. Find out more about how we can help you and your students at: www.pearson.com/uk", "confidence": 1.0, "element_id": "e000009", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 9, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Summer 2013", "confidence": 1.0, "element_id": "e000010", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 10, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Publications Code UG035550", "confidence": 1.0, "element_id": "e000011", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 11, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "All the material in this publication is copyright", "confidence": 1.0, "element_id": "e000012", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 12, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "$ \\textcircled{c} $ Pearson Education Ltd 2013", "confidence": 1.0, "element_id": "e000013", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 13, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Further copies of this publication are available from Edexcel Publications, Adamsway, Mansfield, Notts, NG18 4FN", "confidence": 1.0, "element_id": "e000024", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 24, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Telephone 01623 467467", "confidence": 1.0, "element_id": "e000025", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 25, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Fax 01623 450481", "confidence": 1.0, "element_id": "e000026", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 26, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Email publication.orders@edexcel.com", "confidence": 1.0, "element_id": "e000027", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 27, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Order Code UG035550 Summer 2013", "confidence": 1.0, "element_id": "e000028", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 28, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "For more information on Edexcel qualifications, please visit our website www.edexcel.com", "confidence": 1.0, "element_id": "e000029", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 29, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Pearson Education Limited. Registered company number 872828 with its registered office at Edinburgh Gate, Harlow, Essex CM20 2JE", "confidence": 1.0, "element_id": "e000030", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 30, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "schemaVersion": "1.0"}', NULL, '2026-09-13 12:58:26.469135+00');
