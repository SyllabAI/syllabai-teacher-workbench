INSERT INTO public.question_parts VALUES ('01ec2f6c-dee4-4d20-bdcf-90a50df56ea5', 'b6e3c846-1b22-43b7-809e-4f42a92c7887', 'b-i', 'Plot the student''s results.', NULL, 0, 2, '2026-09-13 13:01:26.26811+00');
INSERT INTO public.question_parts VALUES ('030f77bc-081d-4061-ad1a-751dda842f6b', 'b6e3c846-1b22-43b7-809e-4f42a92c7887', 'b-ii', 'Draw two straight lines of best fit, ignoring the anomalous result. Volume of silver nitrate added in $ \mathrm{c m}^{3} $', NULL, 0, 3, '2026-09-13 13:01:26.268136+00');
INSERT INTO public.question_parts VALUES ('e819d4a8-247b-4a65-a407-9a7761bc1b55', 'b6e3c846-1b22-43b7-809e-4f42a92c7887', 'b-iii', 'Suggest a mistake the student made to cause the anomalous result.', NULL, 0, 4, '2026-09-13 13:01:26.268164+00');
