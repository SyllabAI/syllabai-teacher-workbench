kind": "note", "text": "(b)"}, {"kind": "note", "text": "any two of the following:"}, {"kind": "allow", "text": "ALLOW mass"}, {"kind": "allow", "text": "ALLOW amount"}, {"kind": "note", "text": "(c)"}, {"kind": "note", "text": "M3(use the same) volume of limewater"}, {"kind": "allow", "text": "ALLOW amount"}, {"kind": "note", "text": "(d)"}, {"kind": "note", "text": "bubbles are air(from tube)/caused by air(expanding on heating)"}, {"kind": "allow", "text": "ALLOW gas in tube expands(on heating)"}, {"kind": "note", "text": "(e)(i)"}, {"kind": "note", "text": "explanation including"}, {"kind": "note", "text": "(e)(i)"}, {"kind": "note", "text": "M1(when limewater turns milky/cloudy it)shows carbon dioxide produced"}, {"kind": "allow", "text": "ALLOW carbon dioxide comes from carbonate(reacting/decomposing)"}, {"kind": "ignore", "text": "IGNORE qualifiers eg light"}, {"kind": "allow", "text": "ALLOW products in either order"}], "answerText": "(a)\nM1(use the same) amount of metal carbonate\nM2(use the same) sized pieces/surface area\nM2 showing metal carbonate has reacted/decomposed\n(ii)CuCO3→CuO+CO2", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "5(f)(i)", "marks": 2, "number": 5, "entryId": "ms-7411fed8-q5fi", "guidance": [{"kind": "allow", "text": "ALLOW the less reactive a metal is"}, {"kind": "note", "text": "M2 the more easily the(metal) carbonate reacts/decomposes"}, {"kind": "allow", "text": "ALLOW the more easily the(metal) carbonate produces carbon dioxide"}, {"kind": "allow", "text": "ALLOW references to the less time the(metal) carbonate takes to react/decompose"}, {"kind": "allow", "text": "ALLOW references to the faster the(metal) carbonate reacts/decomposes"}, {"kind": "note", "text": "ACCEPT reverse arguments"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "repeat (the investigation) using different/other/more(metal) carbonates"}], "answerText": "M1 the lower the metal is(in the reactivity series)", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "6(a)(i)", "marks": 2, "number": 6, "entryId": "ms-7411fed8-q6ai", "guidance": [{"kind": "note", "text": "M1 all symbols and formulae correct"}, {"kind": "note", "text": "M2 correctly balanced"}, {"kind": "note", "text": "M2 DEP M1"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "lighted splint (produces squeaky) pop"}, {"kind": "note", "text": "(b)(i)"}, {"kind": "note", "text": "52(cm3)"}, {"kind": "allow", "text": "ALLOW 51.5-52.5"}, {"kind": "note", "text": "M1 vertical line from 15cm3 acid to graph line"}, {"kind": "allow", "text": "ALLOW extra point drawn at 15cm3"}, {"kind": "note", "text": "M2 volume hydrogen from graph multiplied by 2"}, {"kind": "allow", "text": "ALLOW 68-70"}, {"kind": "note", "text": "OR"}, {"kind": "note", "text": "M1 vertical line from 30cm3 acid to graph line"}, {"kind": "note", "text": "M2 volume hydrogen from graph"}, {"kind": "allow", "text": "ALLOW extra point drawn at 30cm3"}, {"kind": "allow", "text": "ALLOW 68-70"}, {"kind": "note", "text": "(c)"}, {"kind": "note", "text": "explanation linking"}, {"kind": "note", "text": "M1 more (acid) particles/(hydrogen) ions/H+ in same volume"}, {"kind": "note", "text": "REJECT molecules once only"}, {"kind": "allow", "text": "ALLOW particles are closer together"}, {"kind": "note", "text": "M2 more (successful) collisions per second/unit time"}, {"kind": "note", "text": "ACCEPT more frequent collisions"}, {"kind": "ignore", "text": "IGNORE more chance/probability of collision"}, {"kind": "note", "text": "M3 rate increases"}, {"kind": "allow", "text": "ALLOW reaction is faster/speeds up"}, {"kind": "note", "text": "MAX 1 if refer to particles moving faster/having more energy"}], "answerText": "Zn+2HCl→ZnCl2+H2", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label r