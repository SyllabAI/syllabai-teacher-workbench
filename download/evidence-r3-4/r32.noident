INSERT INTO public.question_parts VALUES ('715a566a-435d-4ca0-9f4b-3744b7338f76', 'b9c7d049-62d7-40a5-9dae-78150ef72af6', 'c', 'The equation for the reaction taking place at the positive electrode is: $2 \mathrm {C l} ^ {-} (\mathrm {a q}) \rightarrow \mathrm {C l} _ {2} (\mathrm {g}) + 2 \mathrm {e} ^ {-}$ Ten faradays (10 F) of electricity were passed through an aqueous solution of sodium chloride.', NULL, 0, 4, '2026-09-13 12:57:41.990019+00');
INSERT INTO public.question_parts VALUES ('723dff5d-4385-4b03-b901-61b8cccbf3e1', 'b9c7d049-62d7-40a5-9dae-78150ef72af6', 'c-i', 'Calculate the amount, in moles, of chlorine formed.', NULL, 0, 5, '2026-09-13 12:57:41.990025+00');
