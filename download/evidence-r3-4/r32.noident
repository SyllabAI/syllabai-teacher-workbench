INSERT INTO public.question_versions VALUES ('4a0830c2-8338-491c-bddb-cfd73a18e193', '25b4e2a9-c102-4db6-82d4-3fe0e7467119', 1, 'Iron metal was discovered several thousand years ago. Iron is produced industrially from iron(III) oxide by extraction using carbon. Sodium is a metal in Group 1 of the Periodic Table. Sodium was discovered by Sir Humphrey Davy in 1807. It is produced industrially by the electrolysis of sodium chloride.', 13, 3, 1170, NULL, 'SUGGESTED', '75c7a386-54b6-54d3-a2ba-47635a55fcdc', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:03:38.329876+00');
INSERT INTO public.question_versions VALUES ('0a91a926-a7e8-4eee-910d-777656e3467e', 'c5857813-629b-4093-9776-d8cd60eaffbd', 1, 'A student is asked to find the concentration of a solution of nitric acid by doing a titration. The student is provided with sodium hydroxide solution with a concentration of $ 0.350\mathrm{mol/dm}^{3} $ These are the first four steps in the student''s method. use a pipette to add exactly $ 2 5. 0 \mathrm{c m}^{3} $ of the nitric acid solution to a conical flask placed on a white tile add a few drops of indicator to the flask use a burette to add sodium hydroxide solution to the flask until the indicator has changed colour record the volume needed for the indicator to change colour', 1, 3, 90, NULL, 'SUGGESTED', '75c7a386-54b6-54d3-a2ba-47635a55fcdc', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:03:38.330312+00');
