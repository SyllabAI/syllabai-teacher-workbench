INSERT INTO public.question_parts VALUES ('f89b3bc9-505d-4d39-bb84-e500700dd8fc', '7c68a6b3-63cb-4b61-beda-0b82b9767821', 'b-ii', 'The symbol for an atom of one isotope of magnesium is $ _{12}^{26} \mathrm{M g} $ Give the number of protons, neutrons and electrons in one atom of this isotope. number of protons number of neutrons number of electrons', NULL, 0, 2, '2026-09-13 12:56:09.828269+00');
INSERT INTO public.question_parts VALUES ('80b0918a-9569-48b8-beae-ab031da25dba', '7c68a6b3-63cb-4b61-beda-0b82b9767821', 'b-iii', 'A sample of magnesium contains these percentages of the three isotopes. $\mathrm {M g} - 2 4 = 7 9. 0 0 \% \quad \mathrm {M g} - 2 5 = 1 0. 0 0 \% \quad \mathrm {M g} - 2 6 = 1 1. 0 0 \%$ Use this information to show that the relative atomic mass of magnesium is 24.32', NULL, 0, 3, '2026-09-13 12:56:09.828287+00');
INSERT INTO public.question_parts VALUES ('4d4cd75d-6883-417f-b308-5c08a22dd26b', '7c68a6b3-63cb-4b61-beda-0b82b9767821', 'b-iv', 'One mole of magnesium has a mass of 24.32 g. There are $ 6.022\times10^{23} $ atoms in one mole. Calculate the mass, in grams, of one atom of magnesium. Give your answer to 4 significant figures.', NULL, 0, 4, '2026-09-13 12:56:09.828306+00');
INSERT INTO public.question_parts VALUES ('3e071a5b-4fc2-40d5-a95e-33f05e1c468b', '7c68a6b3-63cb-4b61-beda-0b82b9767821', 'c', 'The equation for the reaction between magnesium and oxygen is $2 \mathrm {M g} + \mathrm {O} _ {2} \rightarrow 2 \mathrm {M g O}$ Determine the maximum amount, in moles, of magnesium oxide that can be produced from 0.50 mol of magnesium and 0.20 mol of oxygen.', NULL, 0, 5, '2026-09-13 12:56:09.828328+00');
