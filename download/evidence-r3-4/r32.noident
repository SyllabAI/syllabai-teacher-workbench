INSERT INTO public.question_versions VALUES ('701dd825-8f0d-46d4-a3e9-968e68fb496e', '428aa486-a4a1-46ad-928d-1d889e2455e1', 1, 'A student investigates the reaction between sodium hydroxide solution and dilute sulfuric acid. He does a titration to find the concentration of the sulfuric acid. This is his plan for the titration. There are some mistakes and omissions in his plan. rinse a conical flask with the sodium hydroxide solution use a measuring cylinder to measure out $ 2 5 \mathrm{c m}^{3} $ of the sodium hydroxide solution and add it to the conical flask add a few drops of methyl orange indicator to the conical flask rinse a burette with water and then fill it with the sulfuric acid add the acid from the burette to the conical flask until the indicator changes colour at the end-point of the titration record the final burette reading', 9, 3, 810, NULL, 'SUGGESTED', 'b1b5d37e-d4c9-53bb-853c-ff85f12faff9', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:41.171259+00');
INSERT INTO public.question_versions VALUES ('113ecac5-b09e-4cf4-b103-fa4b6ffe317c', '7bd55710-f2a4-4369-9793-afbe77c484d5', 1, 'Oxygen can be prepared from hydrogen peroxide using a catalyst.', 1, 3, 90, NULL, 'SUGGESTED', 'b1b5d37e-d4c9-53bb-853c-ff85f12faff9', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:41.171507+00');
INSERT INTO public.question_versions VALUES ('44bdc487-77f2-4f46-a009-c7f1aa55bced', '151af226-2b4a-4e70-91ca-79bd0cca3def', 1, 'Ethanol, $ \mathrm{C_{2} H_{5} O H} $ , can be manufactured from ethene and steam using a phosphoric acid catalyst. (a) (i) State the temperature and pressure used in this manufacturing process. temperature pressure ... (ii) Draw the displayed formula of ethanol.', 11, 3, 990, NULL, 'SUGGESTED', 'b1b5d37e-d4c9-53bb-853c-ff85f12faff9', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:00:41.171794+00');
