nd": "note", "text": "F57.5819"}, {"kind": "note", "text": "M2"}, {"kind": "note", "text": "3.033.03"}, {"kind": "note", "text": "6.063.03"}, {"kind": "note", "text": "3.033.03"}, {"kind": "note", "text": "OR"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "·divide relative molecular mass by empirical formula mass"}, {"kind": "note", "text": "·correct molecular formula"}, {"kind": "note", "text": "ACCEPT symbols in any order"}, {"kind": "note", "text": "correct answer without working scores 2 marks."}, {"kind": "note", "text": "2CH2F scores 1"}, {"kind": "note", "text": "M1"}, {"kind": "note", "text": "6612+2+19"}, {"kind": "note", "text": "OR"}, {"kind": "note", "text": "6633"}, {"kind": "note", "text": "M2"}, {"kind": "note", "text": "C2H4F2"}, {"kind": "note", "text": "Total 14"}], "answerText": "·Divide percentages by relative atomic masses\n·Divide results by smallest value to obtain ratio\nExample calculation\nExample calculation", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "6(d)(i)", "marks": 1, "number": 6, "entryId": "ms-e00b7ce5-q6di", "guidance": [{"kind": "ignore", "text": "IGNORE copper is unreactive ALLOW copper is less reactive than hydrogen"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "Any value between1.5and5.0℃inclusive"}, {"kind": "note", "text": "(iii)"}, {"kind": "note", "text": "most reactive magnesium zinc iron tin copper"}, {"kind": "note", "text": "ACCEPT symbols"}, {"kind": "note", "text": "Total12"}], "answerText": "no reaction(occurred between copper and hydrochloric acid)", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "7(a)(i)", "marks": 1, "number": 7, "entryId": "ms-e00b7ce5-q7ai", "guidance": [{"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "A is incorrect as astatine is a solid"}, {"kind": "note", "text": "(iii)"}, {"kind": "note", "text": "D is incorrect as iodine is a solid"}, {"kind": "note", "text": "D is incorrect as iodine is more reactive than astatine"}], "answerText": "B bromine\nC is incorrect as chlorine is a gas\nC chlorine (as it is pale green)\nA is incorrect as astatine is black\nB is incorrect as bromine is brown\nC is incorrect as iodine is dark grey\nA astatine\nB is incorrect as bromine is more reactive than astatine\nC is incorrect as chlorine is more reactive than astatine", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "7(c)", "marks": null, "number": 7, "entryId": "ms-e00b7ce5-q7c", "guidance": [{"kind": "note", "text": "Test for cation"}, {"kind": "note", "text": "M1 add sodium hydroxide(solution)"}, {"kind": "allow", "text": "ALLOW ammonia solution"}, {"kind": "note", "text": "M2 if blue precipitate forms solution containscopper(II) ion(s)/containsCu2+/is a coppercompound"}, {"kind": "ignore", "text": "IGNORE qualifiersREJECT other colours"}, {"kind": "note", "text": "M3 if green precipitate forms solution containsiron(II) ion(s)/containsFe2+/is an iron compound"}, {"kind": "ignore", "text": "IGNORE qualifiersREJECT other colours"}, {"kind": "note", "text": "If no reagent orincorrect reagent butcorrectM2 and M3score1"}, {"kind": "allow", "text": "ALLOWM1 flame test ordescription of flame test"}, {"kind": "note", "text": "M2 if blue-green(flame)solution containscopper(II) ion(s)/containsCu2+/is a coppercompound"}, {"kind": "note", "text": "No M3 for this test"}, {"kind": "allow", "text": "ALLOWM1 addition of suitablemetal aboveCu inreactivity series"}, {"kind": "note", "text": "M2 brown/pink/pink-brown solid forms"}, {"kind": "note", "text": "No M3 for this test"}], "answerText": "A description that makes reference to the following6 points", "confidence": 0.5, "markPoints": [], "correctOption": null, "marksCellSource": null}, {"mcq": false, "qwc": false, "label": "8", "mar