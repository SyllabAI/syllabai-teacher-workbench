INSERT INTO public.question_versions VALUES ('69ea7972-11c5-4374-847f-406839bff30d', 'ef1101a4-51e7-4391-84e8-3af4a2bdfe79', 1, '(a) Hand sanitiser liquids are used regularly to reduce the spread of infections. Three compounds P, Q and R are often present in these liquids. (i) What type of formula is shown for P? (ii) Compounds P, Q and R are members of the same homologous series. Give two properties of a homologous series. (iii) Name the homologous series that contains compounds P, Q and R. (iv) Give the name of compound Q. A a displayed formula B an empirical formula C a molecular formula D a structural formula', 1, 3, 90, NULL, 'SUGGESTED', '75c7a386-54b6-54d3-a2ba-47635a55fcdc', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:03:38.328562+00');
