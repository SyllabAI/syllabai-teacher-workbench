INSERT INTO public.question_parts VALUES ('55bdabdc-237e-44f4-ba06-f0323d6be734', '2ca19f87-f2e2-49d0-9d26-8808159988ba', 'a-iii', 'In both reactions it is important to control the temperature State why the temperature in reaction 2 is kept below $ 3 5 \, \mathrm{^ \circ C} $', NULL, 0, 2, '2026-09-13 12:57:42.153933+00');
