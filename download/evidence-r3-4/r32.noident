INSERT INTO public.questions VALUES ('30f5f1a6-0dbc-474e-a07e-5c5d01215671', 'q05-1981e905', 'STRUCTURED', 'A student uses this apparatus to investigate the rate of reaction between marble chips and dilute hydrochloric acid.', 13, 3, 1170, NULL, '0cbb32cc-ec04-4baa-8b95-586db52d3a72', 'PAST_PAPER', true, 1, '2026-09-13 12:54:40.208502+00', '1146ef37-90e1-44c4-9db9-cc8ca8280a4d');
INSERT INTO public.questions VALUES ('538decdd-ce33-4941-b7db-7a7f1ff7ae0b', 'q06-1981e905', 'STRUCTURED', 'Poly(chloroethene) is a polymer. It is made from its monomer, chloroethene.', 1, 3, 90, NULL, '0cbb32cc-ec04-4baa-8b95-586db52d3a72', 'PAST_PAPER', true, 1, '2026-09-13 12:54:40.208797+00', '1146ef37-90e1-44c4-9db9-cc8ca8280a4d');
INSERT INTO public.questions VALUES ('2fefc7d1-6bdd-4364-9ae6-838ce3860bca', 'q07-1981e905', 'STRUCTURED', 'A student makes some magnesium nitrate crystals from magnesium oxide and dilute nitric acid. The equation for the reaction is $\mathrm {M g O (s)} + 2 \mathrm {H N O} _ {3} (\mathrm {a q}) \rightarrow \mathrm {M g} \left(\mathrm {N O} _ {3}\right) _ {2} (\mathrm {a q}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {I})$', 14, 3, 1260, NULL, '0cbb32cc-ec04-4baa-8b95-586db52d3a72', 'PAST_PAPER', true, 1, '2026-09-13 12:54:40.209036+00', '1146ef37-90e1-44c4-9db9-cc8ca8280a4d');
INSERT INTO public.questions VALUES ('720ff0dd-fff0-4fd6-95e0-5e2a4e2ecdd0', 'q08-1981e905', 'STRUCTURED', 'A student investigates the neutralisation reaction between sodium hydroxide and nitric acid. This is her method. pour $ 2 0 \mathrm{c m}^{3} $ of sodium hydroxide solution into a polystyrene cup record the temperature of the sodium hydroxide solution add 5 $ cm^{3} $ of dilute nitric acid to the cup stir the mixture and record the highest temperature reached add further $ 5 \mathrm{c m}^{3} $ portions of dilute nitric acid, recording the highest temperature reached each time, until a total of $ 4 0 \mathrm{c m}^{3} $ of acid has been added', 9, 3, 810, NULL, '0cbb32cc-ec04-4baa-8b95-586db52d3a72', 'PAST_PAPER', true, 1, '2026-09-13 12:54:40.209271+00', '1146ef37-90e1-44c4-9db9-cc8ca8280a4d');
INSERT INTO public.questions VALUES ('dafde59b-affd-4998-82bd-a827dabc1914', 'q09-1981e905', 'STRUCTURED', '(a) Diamond is a naturally-occurring form of carbon. It has a giant molecular structure. Explain, with reference to its structure and bonding, why diamond has a high melting point.', 11, 3, 990, NULL, '0cbb32cc-ec04-4baa-8b95-586db52d3a72', 'PAST_PAPER', true, 1, '2026-09-13 12:54:40.209501+00', '1146ef37-90e1-44c4-9db9-cc8ca8280a4d');
INSERT INTO public.questions VALUES ('c7bef576-3d0f-4150-9a74-da9cf7cf847c', 'q10-1981e905', 'STRUCTURED', 'A student investigates the reaction between zinc and copper(II) sulfate solution. The equation for the reaction is $\mathrm {Z n} + \mathrm {C u S O} _ {4} \rightarrow \mathrm {C u} + \mathrm {Z n S O} _ {4}$ This is his method. add exactly 25.0 $ cm^{3} $ of copper(II) sulfate solution to a polystyrene cup record the temperature of the solution add about 5g of zinc powder (an excess) and stir the mixture record the highest temperature reached', 10, 3, 900, NULL, '0cbb32cc-ec04-4baa-8b95-586db52d3a72', 'PAST_PAPER', true, 1, '2026-09-13 12:54:40.209776+00', '1146ef37-90e1-44c4-9db9-cc8ca8280a4d');
