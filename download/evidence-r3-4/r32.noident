INSERT INTO public.question_parts VALUES ('d07f84e1-4ff0-4f00-a536-3eb267416be8', '53954a3b-c4e8-4485-908d-ba17dbae58bc', 'd', 'The ionic half-equation for the reaction that produces the gas in syringe X is $2 \mathrm {C l} ^ {-} \rightarrow \mathrm {C l} _ {2} + 2 \mathrm {e} ^ {-}$ The ionic half-equation for the reaction that produces the gas in syringe Y is $2 \mathrm {H} ^ {+} + 2 \mathrm {e} ^ {-} \rightarrow \mathrm {H} _ {2}$', NULL, 0, 7, '2026-09-13 13:01:26.458739+00');
INSERT INTO public.question_parts VALUES ('1278a0d0-2f3f-4edf-bb98-d456f199e1ee', '53954a3b-c4e8-4485-908d-ba17dbae58bc', 'd-i', 'Suggest how these ionic half-equations show that the volume of chlorine collected in syringe X should be the same as the volume of hydrogen collected in syringe Y.', NULL, 0, 8, '2026-09-13 13:01:26.458758+00');
