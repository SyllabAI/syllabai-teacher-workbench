INSERT INTO public.question_parts VALUES ('38fbc10e-6cbf-4bfa-a53f-288342730b52', '3fb03be1-2a4f-4f40-a388-ece2f3936427', 'c-ii', 'State the meaning of the term unsaturated.', NULL, 0, 8, '2026-09-13 12:54:40.215453+00');
INSERT INTO public.question_parts VALUES ('fff006a6-5a22-437e-827b-d2c7af914350', '3fb03be1-2a4f-4f40-a388-ece2f3936427', 'c-iii', 'Describe a test to show that a hydrocarbon is unsaturated.', NULL, 0, 9, '2026-09-13 12:54:40.215478+00');
INSERT INTO public.question_parts VALUES ('9e7fcac0-0a49-42c4-97f1-6fdf3c7ba663', 'ca276482-b38b-4c33-b7b9-4ec8f3aa78bb', 'a', 'During the reaction, the reading on the balance decreases because mass is lost from the flask.', NULL, 0, 0, '2026-09-13 12:54:40.215507+00');
