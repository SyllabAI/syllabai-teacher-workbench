INSERT INTO public.question_parts VALUES ('79c49a48-9e2c-458a-af22-c099c1556844', 'f7daa34f-a5b9-467f-8a94-4594929fe36a', 'a-ii', 'Use the graph to find the boiling point of the alkane with 7 carbon atoms in its molecule. Show on the graph how you obtain your answer.', NULL, 0, 2, '2026-09-13 12:55:23.885559+00');
INSERT INTO public.question_parts VALUES ('747498f0-1ada-4b27-90c3-040177f385bd', 'f7daa34f-a5b9-467f-8a94-4594929fe36a', 'a-iii', 'Explain the trend shown by the graph.', NULL, 0, 3, '2026-09-13 12:55:23.885588+00');
INSERT INTO public.question_parts VALUES ('0fc446f0-1b8f-4251-b028-185ee0ae26f4', 'f7daa34f-a5b9-467f-8a94-4594929fe36a', 'b', 'The diagram represents two isomers with the formula $ \mathrm{C}_{5} \mathrm{H}_{1 2} $ H Explain why these compounds are isomers.', NULL, 2, 4, '2026-09-13 12:55:23.885612+00');
INSERT INTO public.question_parts VALUES ('58757126-391d-4f63-82a9-601d5585f2f7', 'f7daa34f-a5b9-467f-8a94-4594929fe36a', 'c', 'An alkane contains 82.8% carbon and 17.2% hydrogen by mass. Show by calculation that the empirical formula of this alkane is $ C_{2} H_{5} $', NULL, 0, 5, '2026-09-13 12:55:23.885635+00');
INSERT INTO public.question_parts VALUES ('5a356013-b5e4-405f-a25f-d8c78e19165e', 'f7daa34f-a5b9-467f-8a94-4594929fe36a', 'c-ii', 'Deduce the molecular formula of this alkane.', NULL, 0, 6, '2026-09-13 12:55:23.885658+00');
INSERT INTO public.question_parts VALUES ('e2ea06c1-bb5b-4bb8-b3e2-d75d65437102', 'f7daa34f-a5b9-467f-8a94-4594929fe36a', 'd', 'The equation for the complete combustion of one mole of an alkane can be represented by $\mathrm {a l k a n e} + \mathrm {Z O} _ {2} \rightarrow \mathrm {X C O} _ {2} + \mathrm {Y H} _ {2} \mathrm {O}$ Complete combustion of one mole of the alkane produces 308 g of carbon dioxide and 144 g of water. X, Y and Z are the numbers used to balance the equation. Calculate the values of X, Y and Z. [M $ _{r} $ of $ CO_{2}=4 4 $ , M $ _{r} $ of $ H_{2}O=1 8 $ ]', NULL, 0, 7, '2026-09-13 12:55:23.885695+00');
INSERT INTO public.question_parts VALUES ('8a7c4749-1724-4ce0-bfa7-b8c692656083', '86dc4773-b5bd-4b26-b9d4-5194be7e9c0c', 'a', 'Hydrogen peroxide decomposes to form water and oxygen. The equation for the reaction is $2 \mathrm {H} _ {2} \mathrm {O} _ {2} \rightarrow 2 \mathrm {H} _ {2} \mathrm {O} + \mathrm {O} _ {2}$ 25. 0 $ cm^{3} $ of hydrogen peroxide solution are poured into a conical flask and 1.00 g of solid manganese(IV) oxide is added. Bubbles of oxygen gas are formed.', NULL, 0, 0, '2026-09-13 12:55:23.885731+00');
INSERT INTO public.question_parts VALUES ('3f41f135-d3d7-4762-a353-6ecded7aafdf', '86dc4773-b5bd-4b26-b9d4-5194be7e9c0c', 'a-i', 'Give the test for oxygen gas.', NULL, 0, 1, '2026-09-13 12:55:23.885761+00');
INSERT INTO public.question_parts VALUES ('328bed98-f267-456e-8273-4ecc8ac4e2ee', '86dc4773-b5bd-4b26-b9d4-5194be7e9c0c', 'a-ii', 'Describe a method to show that solid manganese(IV) oxide is a catalyst in this reaction and not a reactant.', NULL, 0, 2, '2026-09-13 12:55:23.885784+00');
INSERT INTO public.question_parts VALUES ('a6b9377f-e3b7-46d8-be0d-32b3697d4314', '86dc4773-b5bd-4b26-b9d4-5194be7e9c0c', 'b', 'A student uses this apparatus to investigate the rate of the reaction between zinc and an excess of dilute hydrochloric acid. This is the student''s method. pour $ 5 0 \mathrm{c m}^{3} $ of dilute hydrochloric acid into a conical flask add about 1.2g of zinc lumps record the volume of hydrogen gas collected every 30s until no more hydrogen is collected The graph shows the student''s results.', NULL, 0, 3, '2026-09-13 12:55:23.88581+00');
INSERT INTO public.question_parts VALUES ('39b805e0-d85f-4969-99e6-0cfcdb3fb17f', '86dc4773-b5bd-4b26-b9d4-5194be7e9c0c', 'b-i', 'Calculate the mean (average) rate of reaction, in $ cm^{3}/s $ , in the first 120 s. $\mathrm {c m} ^ {3} / \mathrm {s}$', NULL, 0, 4, '2026-09-13 12:55:23.885836+00');
INSERT INTO public.question_parts VALUES ('aaa41a63-9d07-4dc7-9925-5b676673c08c', '86dc4773-b5bd-4b26-b9d4-5194be7e9c0c', 'b-ii', 'The equation for the reaction between zinc and hydrochloric acid is $\mathrm {Z n} (\mathrm {s}) + 2 \mathrm {H C l} (\mathrm {a q}) \rightarrow \mathrm {Z n C l} _ {2} (\mathrm {a q}) + \mathrm {H} _ {2} (\mathrm {g})$ Use this equation and the particle collision theory to explain why the rate of reaction is greatest at the start of the reaction.', NULL, 0, 5, '2026-09-13 12:55:23.885864+00');
INSERT INTO public.question_parts VALUES ('3d6b1428-8911-41b7-8a9e-38889890615a', '86dc4773-b5bd-4b26-b9d4-5194be7e9c0c', 'b-iii', 'The student repeats the experiment at a higher temperature but keeps all other conditions the same. On the grid, draw the curve you would expect to see in this experiment. Question continues on next page', NULL, 0, 6, '2026-09-13 12:55:23.885888+00');
INSERT INTO public.question_parts VALUES ('e3765b16-26df-445f-971a-ed350e65ff39', '86dc4773-b5bd-4b26-b9d4-5194be7e9c0c', 'b-iv', 'Explain why the rate of reaction is greater if the same mass of zinc powder is used instead of zinc lumps. All other conditions are kept the same.', NULL, 0, 7, '2026-09-13 12:55:23.885911+00');
INSERT INTO public.question_parts VALUES ('1866260f-6ad7-4206-b826-38f1cf561278', '86dc4773-b5bd-4b26-b9d4-5194be7e9c0c', 'c', 'In another experiment, the student adds 0.55 g of zinc to a solution containing $ 2. 5 0 \times1 0^{-2} $ moles of hydrochloric acid. Use the equation to show that hydrochloric acid is in excess. $\mathrm {Z n} (\mathrm {s}) + 2 \mathrm {H C l} (\mathrm {a q}) \rightarrow \mathrm {Z n C l} _ {2} (\mathrm {a q}) + \mathrm {H} _ {2} (\mathrm {g})$ [ $ A_{\mathrm{r}} $ of Zn=65] $(\mathrm {T o t a l f o r Q u e s t i o n 1 1 = 1 5 m a r k s})$ $\mathrm {T O T A L F O R P A P E R} = 1 1 0 \mathrm {M A R K S}$', NULL, 0, 8, '2026-09-13 12:55:23.885934+00');
