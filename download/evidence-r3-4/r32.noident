INSERT INTO public.question_parts VALUES ('645c8b6a-d503-4d21-abad-c474d0897528', '92580653-b2db-4baa-bc6a-771a9299e49e', 'b-iii', 'State two problems caused by acid rain.', NULL, 0, 7, '2026-09-13 12:57:42.153661+00');
INSERT INTO public.question_parts VALUES ('d008b75e-432e-4c56-98eb-66efdc5e703c', '3f17bd9e-a784-4dd5-8706-e3dbaf883258', 'b', 'A solution of lead(II) nitrate can be made by reacting solid lead(II) carbonate with dilute nitric acid. The equation for this reaction is: $\mathrm {P b C O} _ {3} (\mathrm {s}) + 2 \mathrm {H N O} _ {3} (\mathrm {a q}) \rightarrow \mathrm {P b} (\mathrm {N O} _ {3}) _ {2} (\mathrm {a q}) + \mathrm {C O} _ {2} (\mathrm {g}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {l})$ State two observations you would make when dilute nitric acid is added to solid lead(II) carbonate.', NULL, 0, 3, '2026-09-13 12:57:41.989845+00');
INSERT INTO public.question_parts VALUES ('03ecb31d-b575-4138-841a-00a90e4ecda4', '05f393fb-1b21-4df8-91ca-a2a94c07701c', 'a', 'Why is it necessary to lift the lid from time to time while heating?', NULL, 0, 0, '2026-09-13 12:57:41.989858+00');
