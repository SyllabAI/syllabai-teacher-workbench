INSERT INTO public.questions VALUES ('9366e4d3-4ed3-4c29-b876-121174310194', 'q05-afe3708e', 'STRUCTURED', 'Hydrogen peroxide solution decomposes to give water and oxygen gas. The equation for this reaction is $2 \mathrm {H} _ {2} \mathrm {O} _ {2} (\mathrm {a q}) \rightarrow 2 \mathrm {H} _ {2} \mathrm {O} (\mathrm {I}) + \mathrm {O} _ {2} (\mathrm {g})$', 8, 3, 720, NULL, '256c77b5-e400-4296-8bf5-3c897ec4f247', 'PAST_PAPER', true, 1, '2026-09-13 13:02:53.905167+00', 'c639e7c5-4f02-40c6-8854-5737b423aa3e');
