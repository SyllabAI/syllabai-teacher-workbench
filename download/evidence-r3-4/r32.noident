INSERT INTO public.document_chunks VALUES ('0527886e-5c37-4543-a3a6-7c632846135f', 'b6d8d758-8554-461a-aca3-8739e1561567', 2, 'How does this information support the fact that a sample of neon contains more $ ^{20} $Ne than $ ^{22} $Ne?
