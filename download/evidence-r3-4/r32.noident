": 5, "confidence": 1.0, "element_id": "e000031", "page_number": 1, "bounding_box": null, "column_count": 2, "element_type": "table", "reading_order": 31, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Li", "", "B", "", "N", "", "F", ""], ["", "Mg", "", "Si", "", "S", "", "Ar"]], "text": "Li |  | B |  | N |  | F | \n | Mg |  | Si |  | S |  | Ar", "row_count": 2, "confidence": 1.0, "element_id": "e000036", "page_number": 1, "bounding_box": null, "column_count": 8, "element_type": "table", "reading_order": 36, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["", "Periods", "Groups"], ["A", "2", "4"], ["B", "3", "4"], ["C", "2", "8"], ["D", "3", "8"]], "text": " | Periods | Groups\nA | 2 | 4\nB | 3 | 4\nC | 2 | 8\nD | 3 | 8", "row_count": 5, "confidence": 1.0, "element_id": "e000039", "page_number": 1, "bounding_box": null, "column_count": 3, "element_type": "table", "reading_order": 39, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Isotope", "$^{28}$Si", "$^{29}$Si", "$^{30}$Si"], ["Percentage(%)", "92.2", "4.70", "3.10"]], "text": "Isotope | $^{28}$Si | $^{29}$Si | $^{30}$Si\nPercentage(%) | 92.2 | 4.70 | 3.10", "row_count": 2, "confidence": 1.0, "element_id": "e000051", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 51, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Compound", "Boiling point in℃"], ["$SiF_{4}$", "-86"], ["$SiCl_{4}$", "58"], ["$SiO_{2}$", "2950"]], "text": "Compound | Boiling point in℃\n$SiF_{4}$ | -86\n$SiCl_{4}$ | 58\n$SiO_{2}$ | 2950", "row_count": 4, "confidence": 1.0, "element_id": "e000056", "page_number": 1, "bounding_box": null, "column_count": 2, "element_type": "table", "reading_order": 56, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["A\nCH2=CH2", "B\nH H H\nH-C=C-C-H\nH"], ["C\nC4H8", "D\nC2H3Cl"]], "tex