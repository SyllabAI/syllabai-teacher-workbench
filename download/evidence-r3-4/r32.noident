detail": "orphan row before first entry: i", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: ii", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: iii", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: 11 d", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M2", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: in reaction 3, there is gain of hydrogen", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: in reaction 4, there is gain of oxygen", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: e", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M2 $M_{\\mathrm{r}}(\\mathrm{NH}_{4}\\mathrm{NO}_{3})=80$", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M3 mass $(\\mathrm{NH}_{4}\\mathrm{NO}_{3})=80\\times2000=160000\\mathrm{g}/160\\mathrm{kg}$", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: OR", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M1 $M_{\\mathrm{r}}(\\mathrm{NH}_{4}\\mathrm{NO}_{3})=80$", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M2 (so)17(kg $\\mathrm{NH}_{3}$)gives80(kg $\\mathrm{NH}_{4}\\mathrm{NO}_{3}$)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M3 (so)34(kg $\\mathrm{NH}_{3}$)gives $\\frac{80}{17}\\times34=160\\mathrm{kg}$ /160000g", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: 12 a i", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: fuel oil", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: gasoline", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: b i", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M1 for correct formula-C4H8", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M2 for correct coefficient-2", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: iii", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M2", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M3", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: c", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: M2", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "orphan row before first entry: 12 d", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}]', '{"paper": {"board": "Edexcel", "session": "June 2016", "subject": null, "duration": null, "examDate": "Thursday 19 May 2016 – Morning", "logNumber": null, "qualification": null, "paperReference": "4CH0/1CR", "publicationCode": null, "canonicalDocumentId": "25ccf10d-e7da-5f97-b268-57aa9afca8e0"}, "warnings": ["unclassified heading: Key", "Q3: incomplete MCQ option set folded into stem", "Q7: incomplete MCQ option set folded into stem", "Q10: incomplete MCQ option set folded into stem"], "questions": [{"mcq": false, "qwc": false, "stem": "The Periodic Table is shown on page 2.", "marks": 0, "parts": [{"qwc": false, "text": "In the Periodic Table, which number increases from 3 to 10 in Period 2?", "label": "a", "marks": null, "partId": "q01-25ccf10d-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "In the Periodic Table, which number increases from 9 to 226 in Group 2?", "label": "b", "marks": null, "partId": "q01-25ccf10d-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "An atom of boron contains protons, neutrons and electrons Use words from the box to complete the sentences. Your may use each word once, more than once or not at all. protons neutrons electrons", "label": "c", "marks": null, "partId": "q01-25ccf10d-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The particles with the smallest mass are ... .", "label": "c-i", "marks": null, "partId": "q01-25ccf10d-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The particles with a negative charge are ...", "label": "c-ii", "marks": null, "partId": "q01-25ccf10d-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The two types of particle in the nucleus of a boron atom", "label": "c-iii", "marks": null, "partId": "q01-25ccf10d-pc-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "In a boron atom there are equal numbers of", "label": "c-iv", "marks": null, "partId": "q01-25ccf10d-pc-iv", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The element boron has isotopes. These isotopes have different numbers of ...", "label": "c-v", "marks": null, "partId": "q01-25ccf10d-pc-v", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 1, "figures": [], "options": [], "section": null, "confidence": 0.45, "marksKnown": false, "questionId": "q01-25ccf10d", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "In chemistry, the state symbols (s), (l), (g) and (aq) are often used.", "marks": 6, "parts": [{"qwc": false, "text": "The table shows some changes of state. Complete the table to show the state symbol before and after the change.", "label": "a", "marks": null, "partId": "q02-25ccf10d-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Some marble chips are added to a solution of hydrochloric acid. Complete the equation for the reaction that occurs by writing the appropriate state symbol after each formula. $\\mathrm {C a C O} _ {3} (\\dots \\dots$", "label": "b", "marks": null, "partId": "q02-25ccf10d-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Which state symbol is used most often for the elements of the Periodic Table at room temperature?", "label": "c", "marks": null, "partId": "q02-25ccf10d-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 2, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q02-25ccf10d", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000036"]}, {"mcq": false, "qwc": false, "stem": "Techniques used in the separation of mixtures include For each separation, select the most suitable technique, A, B, C or D, used to obtain the first named substance from the mixture. Each letter may be used once, more than once or not at all. A crystallisation B filtration C fractional distillation D simple distillation", "marks": 4, "parts": [{"qwc": false, "text": "Pure water from sea water", "label": "a", "marks": null, "partId": "q03-25ccf10d-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Ethanol from a mixture of ethanol and water", "label": "b", "marks": null, "partId": "q03-25ccf10d-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calcium carbonate from a mixture of calcium carbonate and water", "label": "c", "marks": null, "partId": "q03-25ccf10d-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "$ \\mathrm{C u S O}_{4}.5 \\mathrm{H}_{2} \\mathrm{O} (s) $ from $ \\mathrm{C u S O}_{4} $ (aq)", "label": "d", "marks": null, "partId": "q03-25ccf10d-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 3, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q03-25ccf10d", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "The table gives information about some of the elements in Group 7 of the Periodic Table.", "marks": 8, "parts": [{"qwc": false, "text": "What is the colour of chlorine at room temperature? A black B blue C green D orange", "label": "a", "marks": null, "partId": "q04-25ccf10d-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The trend in the boiling points for these elements is similar to the trend in their melting points. Predict a value for the boiling point of iodine.", "label": "b", "marks": null, "partId": "q04-25ccf10d-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Astatine is another element in Group 7. Predict its colour and physical state at room temperature. colour physical state", "label": "c", "marks": null, "partId": "q04-25ccf10d-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The elements in Group 7 have similar chemical reactions because they have the same number of A electrons B electron shells C outer electrons D protons", "label": "d", "marks": null, "partId": "q04-25ccf10d-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "A student wrote these statements about the reactions of the Group 7 elements. The reactivity of the elements decreases down the group. The elements form ions with a single positive charge. The formula of an astatine molecule is $ \\mathrm{A t}_{2} $ The equation for the reaction between chlorine and potassium bromide solution is $ \\mathrm{C l_{2}+2 N a B r\\rightarrow 2 N a C l+B r_{2}} $ In the reaction between bromine and potassium iodide, bromine acts as a reducing agent. Three of the statements contain one incorrect word. Complete the table to show each incorrect word and the correct word that should be used to replace it.", "label": "e", "marks": null, "partId": "q04-25ccf10d-pe", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 4, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q04-25ccf10d", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000055", "e000080"]}, {"mcq": false, "qwc": false, "stem": "A student investigates the pigments found in some vegetables and fruit. She obtains some coloured vegetable and fruit extracts from carrots, tomatoes and sweet potatoes. She places a spot of each extract on chromatography paper, along with spots of the three pigments beta-carotene, chlorophyll and lycopene. Her teacher provides a solvent containing volatile, flammable organic compounds for the experiment. The diagram shows the apparatus at the start of the experiment. Key to vegetable and fruit extracts and pigments $V 1 = c a r r o t s V 2 = t o m a t o e s V 3 = s w e e t p o t a t o e s$ $\\mathrm {P 1} = \\mathrm {b e t a - c a r o t e n e} \\quad \\mathrm {P 2} = \\mathrm {c h l o r o p h y l l} \\quad \\mathrm {P 3} = \\mathrm {l y c o p e n e}$", "marks": 9, "parts": [{"qwc": false, "text": "Explain why it is important for the solvent level to be below the spots.", "label": "a", "marks": null, "partId": "q05-25ccf10d-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State two potential problems that are prevented by fitting the tank with a lid.", "label": "a-ii", "marks": null, "partId": "q05-25ccf10d-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The diagram shows the chromatogram at the end of the experiment. Key to vegetable and fruit extracts and pigments $V 1 = c a r r o t s \\quad V 2 = t o m a t o e s \\quad V 3 = s w e e t p o t a t o e s$ $\\mathrm {P 1} = \\mathrm {b e t a - c a r o t e n e} \\quad \\mathrm {P 2} = \\mathrm {c h l o r o p h y l l} \\quad \\mathrm {P 3} = \\mathrm {l y c o p e n e}$ Which three of the statements A, B, C, D and E are supported by the chromatogram? Place a cross in three boxes to indicate your choice. A Chlorophyll is not present in carrots, sweet potatoes or tomatoes. B Beta-carotene is present in carrots but not present in tomatoes. C Both beta-carotene and lycopene are present in sweet potatoes. D Lycopene is present in tomatoes but not present in carrots. E Both carrots and tomatoes contain a pigment other than beta-carotene, chlorophyll and lycopene.", "label": "b", "marks": null, "partId": "q05-25ccf10d-pb", "figures": [{"url": "assets/crop_1_1789048663683.png", "width": 1199, "format": "png", "height": 735, "sha256": "0248f4b5ffe798691204c86ffb6b9849f3a23846b1812fcfd9e1859b9066d3cd", "assetId": "img:0248f4b5ffe798691204c86ffb6b9849f3a23846b1812fcfd9e1859b9066d3cd", "mimeType": "image/jpeg", "elementId": "e000093", "sourceName": "assets/crop_1_1789048663683.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789048663687.png", "width": 82, "format": "png", "height": 412, "sha256": "166c76e3870d90606b6ca00f93e51b1617c3e1370e78e59b3f6c06a168f8f8ba", "assetId": "img:166c76e3870d90606b6ca00f93e51b1617c3e1370e78e59b3f6c06a168f8f8ba", "mimeType": "image/jpeg", "elementId": "e000104", "sourceName": "assets/crop_2_1789048663687.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "One of the pigments present in the vegetable extracts is not shown in the chromatogram. It appears as a very faint spot 1.3 cm above the starting line. Calculate its $ R_{\\mathrm{f}} $ value using the expression $R _ {\\mathrm {f}} = \\frac {\\mathrm {d i s t a n c e t r a v e l l e d b y p i g m e n t}}{\\mathrm {d i s t a n c e t r a v e l l e d b y s o l v e n t}}$ $R _ {\\mathrm {f}} =$", "label": "c", "marks": null, "partId": "q05-25ccf10d-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Suggest a reason why there is a spot on the starting line in the chromatogram for sweet potatoes.", "label": "d", "marks": null, "partId": "q05-25ccf10d-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 5, "figures": [{"url": "assets/crop_1_1789048663676.png", "width": 1199, "format": "png", "height": 745, "sha256": "dd280de443f4c4ca992af9834f6665a9be402ec9897985e5253d1fddcd0b3f2c", "assetId": "img:dd280de443f4c4ca992af9834f6665a9be402ec9897985e5253d1fddcd0b3f2c", "mimeType": "image/jpeg", "elementId": "e000086", "sourceName": "assets/crop_1_1789048663676.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_1_1789048663683.png", "width": 1199, "format": "png", "height": 735, "sha256": "0248f4b5ffe798691204c86ffb6b9849f3a23846b1812fcfd9e1859b9066d3cd", "assetId": "img:0248f4b5ffe798691204c86ffb6b9849f3a23846b1812fcfd9e1859b9066d3cd", "mimeType": "image/jpeg", "elementId": "e000093", "sourceName": "assets/crop_1_1789048663683.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789048663687.png", "width": 82, "format": "png", "height": 412, "sha256": "166c76e3870d90606b6ca00f93e51b1617c3e1370e78e59b3f6c06a168f8f8ba", "assetId": "img:166c76e3870d90606b6ca00f93e51b1617c3e1370e78e59b3f6c06a168f8f8ba", "mimeType": "image/jpeg", "elementId": "e000104", "sourceName": "assets/crop_2_1789048663687.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q05-25ccf10d", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "Hydrogen chloride is formed in the reaction between hydrogen and chlorine. The equation for the reaction is $\\mathrm {H} _ {2} + \\mathrm {C l} _ {2} \\rightarrow 2 \\mathrm {H C l}$", "marks": 10, "parts": [{"qwc": false, "text": "Each molecule in this equation contains the same type of bonding. Name this type of bonding.", "label": "a", "marks": null, "partId": "q06-25ccf10d-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The bonding in a hydrogen molecule is strong. Explain why the boiling point of hydrogen is low.", "label": "b", "marks": null, "partId": "q06-25ccf10d-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain how the two atoms in a chlorine molecule are held together.", "label": "c", "marks": null, "partId": "q06-25ccf10d-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Draw a dot and cross diagram to show the bonding in a hydrogen chloride molecule. Show only the outer electrons in each atom.", "label": "d", "marks": null, "partId": "q06-25ccf10d-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Hydrogen chloride gas dissolves in water to form solution A. Hydrogen chloride gas dissolves in methylbenzene to form solution B. A teacher adds a piece of magnesium ribbon to each solution. Explain why she observes effervescence with solution A but not with solution B.", "label": "e", "marks": null, "partId": "q06-25ccf10d-pe", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 6, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q06-25ccf10d", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "The table shows the displayed formulae of some organic compounds. A B C D E F", "marks": 12, "parts": [{"qwc": false, "text": "Explain why all of these compounds are described as hydrocarbons.", "label": "a", "marks": null, "partId": "q07-25ccf10d-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Why are B and E described as unsaturated?", "label": "b", "marks": null, "partId": "q07-25ccf10d-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Which letter represents the first member of the homologous series of alkanes?", "label": "c", "marks": null, "partId": "q07-25ccf10d-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Which letters represent compounds that have the empirical formula $ \\mathrm{C H_{2}}? $", "label": "d", "marks": null, "partId": "q07-25ccf10d-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Compound F has the same general formula as an alkene. Why does F not decolourise bromine water?", "label": "e", "marks": null, "partId": "q07-25ccf10d-pe", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "One of the compounds in the table reacts with bromine to form G, a compound with the composition by mass C=22.2% , H=3.7% , Br=74.1%", "label": "f", "marks": null, "partId": "q07-25ccf10d-pf", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Show, by calculation, that the empirical formula of G is $ \\mathrm{C_{2} H_{4} B r} $", "label": "f-i", "marks": null, "partId": "q07-25ccf10d-pf-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The relative formula mass of G is 216 Deduce the molecular formula of G.", "label": "f-ii", "marks": null, "partId": "q07-25ccf10d-pf-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 7, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q07-25ccf10d", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000125"]}, {"mcq": false, "qwc": false, "stem": "Neodymium is a metal used in powerful magnets.", "marks": 8, "parts": [{"qwc": false, "text": "One stage in the extraction of neodymium from its ore is to heat neodymium fluoride with calcium. The table shows the melting points of the substances in this stage of the extraction.", "label": "a", "marks": null, "partId": "q08-25ccf10d-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Balance the equation for this reaction.", "label": "a-i", "marks": null, "partId": "q08-25ccf10d-pa-i", "figures": [{"url": "assets/crop_1_1789048663718.png", "width": 1098, "format": "png", "height": 58, "sha256": "476c443d95389fb4120ceaaaa976858afc6670fbcf194b950892c172d9990316", "assetId": "img:476c443d95389fb4120ceaaaa976858afc6670fbcf194b950892c172d9990316", "mimeType": "image/jpeg", "elementId": "e000140", "sourceName": "assets/crop_1_1789048663718.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "At one point in this extraction, the temperature of the reaction mixture is $ 1 1 0 0 \\mathrm{~} ^ {\\circ} \\mathrm{C} $ Which two substances are solids at this temperature? and", "label": "a-ii", "marks": null, "partId": "q08-25ccf10d-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Suggest the most likely type of bonding present in neodymium fluoride.", "label": "a-iii", "marks": null, "partId": "q08-25ccf10d-pa-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Neodymium reacts with oxygen to form neodymium oxide. Suggest the formula of neodymium oxide.", "label": "a-iv", "marks": null, "partId": "q08-25ccf10d-pa-iv", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The diagram shows the particles in neodymium neodymium ion electron Explain, with reference to the diagram, why neodymium is malleable and a good conductor of electricity.", "label": "b", "marks": null, "partId": "q08-25ccf10d-pb", "figures": [{"url": "assets/crop_1_1789048663736.png", "width": 523, "format": "png", "height": 269, "sha256": "fa226d01f857dfe6f9f665dd61e2afd8fa2ec8bfa558624ba5315c3ad48fa7d4", "assetId": "img:fa226d01f857dfe6f9f665dd61e2afd8fa2ec8bfa558624ba5315c3ad48fa7d4", "mimeType": "image/jpeg", "elementId": "e000146", "sourceName": "assets/crop_1_1789048663736.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}], "number": 8, "figures": [{"url": "assets/crop_1_1789048663718.png", "width": 1098, "format": "png", "height": 58, "sha256": "476c443d95389fb4120ceaaaa976858afc6670fbcf194b950892c172d9990316", "assetId": "img:476c443d95389fb4120ceaaaa976858afc6670fbcf194b950892c172d9990316", "mimeType": "image/jpeg", "elementId": "e000140", "sourceName": "assets/crop_1_1789048663718.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_1_1789048663736.png", "width": 523, "format": "png", "height": 269, "sha256": "fa226d01f857dfe6f9f665dd61e2afd8fa2ec8bfa558624ba5315c3ad48fa7d4", "assetId": "img:fa226d01f857dfe6f9f665dd61e2afd8fa2ec8bfa558624ba5315c3ad48fa7d4", "mimeType": "image/jpeg", "elementId": "e000146", "sourceName": "assets/crop_1_1789048663736.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q08-25ccf10d", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000138"]}, {"mcq": false, "qwc": false, "stem": "A student investigates the reactions between acids and alkalis. He uses this apparatus to measure the temperature change in the reaction between dilute hydrochloric acid (HCl) and aqueous sodium hydroxide (NaOH). This is his method. add 25 $ cm^{3} $ of dilute hydrochloric acid to the polystyrene cup and record the steady temperature add some aqueous sodium hydroxide and stir the mixture record the maximum temperature of the mixture The student repeats the experiment using different volumes of aqueous sodium hydroxide.", "marks": 0, "parts": [{"qwc": false, "text": "What is the advantage of using a polystyrene cup rather than a glass beaker?", "label": "a", "marks": null, "partId": "q09-25ccf10d-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "These are the thermometer readings from one experiment. Use these readings to complete the table.", "label": "b", "marks": null, "partId": "q09-25ccf10d-pb", "figures": [{"url": "assets/crop_1_1789048663773.png", "width": 315, "format": "png", "height": 794, "sha256": "b8bc7599b0be90406f90c758a8671e8e610e4eeee808c65fcc8f72eeff937560", "assetId": "img:b8bc7599b0be90406f90c758a8671e8e610e4eeee808c65fcc8f72eeff937560", "mimeType": "image/jpeg", "elementId": "e000161", "sourceName": "assets/crop_1_1789048663773.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789048663776.png", "width": 293, "format": "png", "height": 784, "sha256": "74fa3781ab8097ddd97519e9e35975b132417b3e938fafea6b5e1b23f265ad9d", "assetId": "img:74fa3781ab8097ddd97519e9e35975b132417b3e938fafea6b5e1b23f265ad9d", "mimeType": "image/jpeg", "elementId": "e000162", "sourceName": "assets/crop_2_1789048663776.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The table shows the results of some experiments. The initial temperature of both solutions in all the experiments is $ 1 7. 6 \\, \\mathrm{^ {\\circ} C} $", "label": "c", "marks": null, "partId": "q09-25ccf10d-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Plot these results on the grid. Draw a straight line of best fit through the first four points, and another straight line of best fit through the last three points. Extend both lines so that they cross each other. Temperature in $ ^{\\circ} \\mathrm{C} $", "label": "c-i", "marks": null, "partId": "q09-25ccf10d-pc-i", "figures": [{"url": "assets/crop_1_1789048663784.png", "width": 1288, "format": "png", "height": 1094, "sha256": "7226f7adfd785f90eaea93a53429b50a65b0f78271bc05d7db0914cfaaa8734e", "assetId": "img:7226f7adfd785f90eaea93a53429b50a65b0f78271bc05d7db0914cfaaa8734e", "mimeType": "image/jpeg", "elementId": "e000170", "sourceName": "assets/crop_1_1789048663784.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "For the point where the lines cross, write down $\\mathrm {t h e t a m e r a t u r e o f t h e m i x t u r e} = \\dots \\dots$", "label": "c-ii", "marks": null, "partId": "q09-25ccf10d-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "In a similar experiment, using a different acid and alkali, the student records these results. volume of dilute sulfuric acid = 25.0 $ cm^{3} $ volume of aqueous potassium hydroxide = 22.7 $ cm^{3} $ initial temperature of each solution = 18.9 $ ^{\\circ} C $ final temperature of mixture = 24.7 $ ^{\\circ} C $ Calculate the heat energy change during this reaction using this equation. heat energy change = mass $ \\times $ 4.2 $ \\times $ temperature change Assume that 1.0 $ cm^{3} $ of each solution has a mass of 1.0 g.", "label": "d", "marks": null, "partId": "q09-25ccf10d-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 9, "figures": [{"url": "assets/crop_1_1789048663755.png", "width": 461, "format": "png", "height": 446, "sha256": "9be4d76ad59e05c5831bd4a8cfa4a1bd42926c6bf1cbe721ec058ec8bb451ef5", "assetId": "img:9be4d76ad59e05c5831bd4a8cfa4a1bd42926c6bf1cbe721ec058ec8bb451ef5", "mimeType": "image/jpeg", "elementId": "e000153", "sourceName": "assets/crop_1_1789048663755.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_1_1789048663773.png", "width": 315, "format": "png", "height": 794, "sha256": "b8bc7599b0be90406f90c758a8671e8e610e4eeee808c65fcc8f72eeff937560", "assetId": "img:b8bc7599b0be90406f90c758a8671e8e610e4eeee808c65fcc8f72eeff937560", "mimeType": "image/jpeg", "elementId": "e000161", "sourceName": "assets/crop_1_1789048663773.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789048663776.png", "width": 293, "format": "png", "height": 784, "sha256": "74fa3781ab8097ddd97519e9e35975b132417b3e938fafea6b5e1b23f265ad9d", "assetId": "img:74fa3781ab8097ddd97519e9e35975b132417b3e938fafea6b5e1b23f265ad9d", "mimeType": "image/jpeg", "elementId": "e000162", "sourceName": "assets/crop_2_1789048663776.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_1_1789048663784.png", "width": 1288, "format": "png", "height": 1094, "sha256": "7226f7adfd785f90eaea93a53429b50a65b0f78271bc05d7db0914cfaaa8734e", "assetId": "img:7226f7adfd785f90eaea93a53429b50a65b0f78271bc05d7db0914cfaaa8734e", "mimeType": "image/jpeg", "elementId": "e000170", "sourceName": "assets/crop_1_1789048663784.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.45, "marksKnown": false, "questionId": "q09-25ccf10d", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000164", "e000167"]}, {"mcq": false, "qwc": false, "stem": "Sodium thiosulfate solution and dilute hydrochloric acid react together slowly to form a precipitate of sulfur. This precipitate eventually makes the mixture go cloudy. place 20 $ cm^{3} $ of sodium thiosulfate solution and $ 20 cm^{3} $ of water in a conical flask add 10 $ cm^{3} $ of dilute hydrochloric acid to the flask place the flask on a piece of paper marked with a black X time how long it takes before the X can no longer be seen A student uses this method.", "marks": 15, "parts": [{"qwc": false, "text": "The equation for the reaction is $\\mathrm {N a} _ {2} \\mathrm {S} _ {2} \\mathrm {O} _ {3} (\\mathrm {a q}) + 2 \\mathrm {H C l} (\\mathrm {a q}) \\rightarrow 2 \\mathrm {N a C l} (\\mathrm {a q}) + \\mathrm {H} _ {2} \\mathrm {O} (\\mathrm {I}) + \\mathrm {S} (\\mathrm {s}) + \\mathrm {S O} _ {2} (\\mathrm {g})$ Before starting her experiments, the student considers the risk to her of sulfur dioxide escaping from the flask. She uses this information. concentration of sodium thiosulfate solution = 0.300 mol/dm $ ^{3} $ volume of sodium thiosulfate solution = 20 $ cm^{3} $ volume of water = 20 $ cm^{3} $ volume of hydrochloric acid = 10 $ cm^{3} $", "label": "a", "marks": null, "partId": "q10-25ccf10d-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the mass of sulfur dioxide formed in this experiment. The hydrochloric acid is in excess.", "label": "a-i", "marks": null, "partId": "q10-25ccf10d-pa-i", "figures": [], "confidence": 0.55, "answerPrompts": ["mass of sulfur dioxide formed"]}, {"qwc": false, "text": "The solubility of sulfur dioxide at room temperature is $ 1 0 0 \\mathrm{~ g / d m^{3}} $ Use this additional information to explain whether any sulfur dioxide gas escapes from the flask.", "label": "a-ii", "marks": null, "partId": "q10-25ccf10d-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "At what point in the experiment should the student have started a timer?", "label": "b", "marks": null, "partId": "q10-25ccf10d-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "She repeats the experiment using the same volumes and concentrations of solutions, but at different temperatures. The graph shows her results.", "label": "c", "marks": null, "partId": "q10-25ccf10d-pc", "figures": [{"url": "assets/crop_1_1789048663810.png", "width": 1274, "format": "png", "height": 750, "sha256": "3d6eefbcddf61921cd48aca08f30fe5799f41a2dbe0e9be57d1705937f52b356", "assetId": "img:3d6eefbcddf61921cd48aca08f30fe5799f41a2dbe0e9be57d1705937f52b356", "mimeType": "image/jpeg", "elementId": "e000201", "sourceName": "assets/crop_1_1789048663810.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The result at (14,42) is anomalous. Explain one mistake the student may have made to cause this anomalous result.", "label": "c-i", "marks": null, "partId": "q10-25ccf10d-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Use the graph to find the time taken for the $ \\times $ to be no longer seen at $ 3 5 \\, \\mathrm{^o C} $", "label": "c-ii", "marks": null, "partId": "q10-25ccf10d-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The student repeats the experiments using nitric acid in place of hydrochloric acid. She records the times for the x to no longer be seen, then uses the times to calculate the rate of reaction at each temperature. The graph shows the results she plots.", "label": "d", "marks": null, "partId": "q10-25ccf10d-pd", "figures": [{"url": "assets/crop_1_1789048663832.png", "width": 1408, "format": "png", "height": 910, "sha256": "3e32a6411b0936d3a85f7013fe24037549c5249d4f95ac93886d9ecba6296cdc", "assetId": "img:3e32a6411b0936d3a85f7013fe24037549c5249d4f95ac93886d9ecba6296cdc", "mimeType": "image/jpeg", "elementId": "e000206", "sourceName": "assets/crop_1_1789048663832.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Suggest two reasons why the results are least accurate at higher temperatures.", "label": "d-i", "marks": 2, "partId": "q10-25ccf10d-pd-i", "figures": [], "confidence": 0.8, "answerPrompts": []}, {"qwc": false, "text": "The student wrote this explanation for the shape of the graph. As the temperature increases, the rate of reaction increases. This is because there are more frequent collisions between particles of reactants. Use the particle collision theory to explain another more important reason for the increase in reaction rate.", "label": "d-ii", "marks": null, "partId": "q10-25ccf10d-pd-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Another student uses the same reaction to investigate the effect of changing the concentration of the sodium thiosulfate solution on the rate of reaction. Give three variables that the student must control in this investigation to obtain valid results.", "label": "e", "marks": null, "partId": "q10-25ccf10d-pe", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 10, "figures": [{"url": "assets/crop_1_1789048663798.png", "width": 329, "format": "png", "height": 111, "sha256": "94a2c4cbf41e2514c3225269152c9a1505858c4ac2f22eb5610821e58f89166f", "assetId": "img:94a2c4cbf41e2514c3225269152c9a1505858c4ac2f22eb5610821e58f89166f", "mimeType": "image/jpeg", "elementId": "e000187", "sourceName": "assets/crop_1_1789048663798.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789048663801.png", "width": 1129, "format": "png", "height": 417, "sha256": "b29a6b078e55fd03a4853a4439dcf977c2400f221f6c6b2ef55ffca353cbee90", "assetId": "img:b29a6b078e55fd03a4853a4439dcf977c2400f221f6c6b2ef55ffca353cbee90", "mimeType": "image/jpeg", "elementId": "e000188", "sourceName": "assets/crop_2_1789048663801.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_1_1789048663810.png", "width": 1274, "format": "png", "height": 750, "sha256": "3d6eefbcddf61921cd48aca08f30fe5799f41a2dbe0e9be57d1705937f52b356", "assetId": "img:3d6eefbcddf61921cd48aca08f30fe5799f41a2dbe0e9be57d1705937f52b356", "mimeType": "image/jpeg", "elementId": "e000201", "sourceName": "assets/crop_1_1789048663810.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_1_1789048663832.png", "width": 1408, "format": "png", "height": 910, "sha256": "3e32a6411b0936d3a85f7013fe24037549c5249d4f95ac93886d9ecba6296cdc", "assetId": "img:3e32a6411b0936d3a85f7013fe24037549c5249d4f95ac93886d9ecba6296cdc", "mimeType": "image/jpeg", "elementId": "e000206", "sourceName": "assets/crop_1_1789048663832.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q10-25ccf10d", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "The flow diagram shows how a fertiliser is manufactured from raw materials. The hydrogen needed is formed in two reactions.", "marks": 0, "parts": [{"qwc": false, "text": "Reaction 1 occurs between steam and methane in natural gas. Balance the equation for this reaction. $\\mathrm {C H} _ {4} + \\mathrm {H} _ {2} \\mathrm {O} \\rightarrow \\mathrm {C O} + \\mathrm {H} _ {2}$", "label": "a", "marks": null, "partId": "q11-25ccf10d-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The equation for reaction 2 is $\\mathrm {C O} (\\mathrm {g}) + \\mathrm {H} _ {2} \\mathrm {O} (\\mathrm {g}) \\rightleftharpoons \\mathrm {C O} _ {2} (\\mathrm {g}) + \\mathrm {H} _ {2} (\\mathrm {g}) \\quad \\Delta H = - 4 1 \\mathrm {k J / m o l}$", "label": "b", "marks": null, "partId": "q11-25ccf10d-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Assuming that this reaction reaches equilibrium, explain what happens to the yield of hydrogen if the reaction is carried out at a higher pressure but at the same temperature.", "label": "b-i", "marks": null, "partId": "q11-25ccf10d-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Assuming that this reaction reaches equilibrium, explain what happens to the yield of hydrogen if the reaction is carried out at a higher temperature but at the same pressure.", "label": "b-ii", "marks": null, "partId": "q11-25ccf10d-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Reaction 2 can be represented on an energy profile.", "label": "c", "marks": null, "partId": "q11-25ccf10d-pc", "figures": [{"url": "assets/crop_1_1789048663866.png", "width": 703, "format": "png", "height": 548, "sha256": "926af54b27081e5f72befb7659c76c83ab4122e3a5d03164d31c674928731db4", "assetId": "img:926af54b27081e5f72befb7659c76c83ab4122e3a5d03164d31c674928731db4", "mimeType": "image/jpeg", "elementId": "e000226", "sourceName": "assets/crop_1_1789048663866.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Complete the profile by showing the products of the reaction and the enthalpy change for the reaction.", "label": "c-i", "marks": null, "partId": "q11-25ccf10d-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Reaction 2 is carried out using an iron oxide catalyst. State the effect, if any, of using a catalyst on the enthalpy change for the reaction.", "label": "c-ii", "marks": null, "partId": "q11-25ccf10d-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain how a catalyst increases the rate of a reaction.", "label": "c-iii", "marks": null, "partId": "q11-25ccf10d-pc-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The equations for some other reactions used in the manufacture of ammonium nitrate are $\\mathrm {r e a c t i o n} 3 \\quad \\mathrm {N} _ {2} + 3 \\mathrm {H} _ {2} \\rightleftharpoons 2 \\mathrm {N H} _ {3}$ reaction 4 $4 \\mathrm {N H} _ {3} + 5 \\mathrm {O} _ {2} \\rightleftharpoons 4 \\mathrm {N O} + 6 \\mathrm {H} _ {2} \\mathrm {O}$ reaction 5 $2 N O _ {2} \\rightleftharpoons N _ {2} O _ {4}$ reaction 6 $\\mathrm {N H} _ {3} + \\mathrm {H N O} _ {3} \\rightarrow \\mathrm {N H} _ {4} \\mathrm {N O} _ {3}$ Explain which two of these are redox reactions.", "label": "d", "marks": null, "partId": "q11-25ccf10d-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The manufacturer produces a batch of 34 kg of ammonia. Calculate the maximum mass of ammonium nitrate that can be made from this mass of ammonia, using reaction 6 in part (d). Give a unit for your answer.", "label": "e", "marks": null, "partId": "q11-25ccf10d-pe", "figures": [], "confidence": 0.55, "answerPrompts": ["maximum mass of ammonium nitrate"]}], "number": 11, "figures": [{"url": "assets/crop_1_1789048663848.png", "width": 1680, "format": "png", "height": 220, "sha256": "27f581f7a800f3885bb7df9950b9c7ca483dade84ab5cc1d9f0165900f36a382", "assetId": "img:27f581f7a800f3885bb7df9950b9c7ca483dade84ab5cc1d9f0165900f36a382", "mimeType": "image/jpeg", "elementId": "e000216", "sourceName": "assets/crop_1_1789048663848.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_1_1789048663866.png", "width": 703, "format": "png", "height": 548, "sha256": "926af54b27081e5f72befb7659c76c83ab4122e3a5d03164d31c674928731db4", "assetId": "img:926af54b27081e5f72befb7659c76c83ab4122e3a5d03164d31c674928731db4", "mimeType": "image/jpeg", "elementId": "e000226", "sourceName": "assets/crop_1_1789048663866.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.45, "marksKnown": false, "questionId": "q11-25ccf10d", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "The production of polymers from crude oil involves several processes, including fractional distillation cracking purification polymerisation", "marks": 13, "parts": [{"qwc": false, "text": "Three of the fractions obtained from fractional distillation are fuel oil, gasoline and kerosene.", "label": "a", "marks": null, "partId": "q12-25ccf10d-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Identify which of these fractions has the darkest colour.", "label": "a-i", "marks": null, "partId": "q12-25ccf10d-pa-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Identify which of these fractions has the highest boiling point.", "label": "a-ii", "marks": null, "partId": "q12-25ccf10d-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Identify which of these fractions contains molecules with the fewest carbon atoms.", "label": "a-iii", "marks": null, "partId": "q12-25ccf10d-pa-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Cracking involves heating some of the fractions to about $ 6 5 0 \\, \\mathrm{^ \\circ C} $", "label": "b", "marks": null, "partId": "q12-25ccf10d-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Name a catalyst used in industry for cracking.", "label": "b-i", "marks": null, "partId": "q12-25ccf10d-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "One reaction that occurs in cracking involves the conversion of one molecule of hexadecane into one molecule of octane and two molecules of an alkene. Complete the equation for this reaction. $\\mathrm {C} _ {1 6} \\mathrm {H} _ {3 4} \\rightarrow \\mathrm {C} _ {8} \\mathrm {H} _ {1 8} +$", "label": "b-ii", "marks": null, "partId": "q12-25ccf10d-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give three reasons why cracking is carried out.", "label": "b-iii", "marks": null, "partId": "q12-25ccf10d-pb-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "One of the compounds sometimes present in crude oil has the formula $ \\mathrm{C_{6} H_{1 2} S} $ Explain why it is important to remove this compound from a fuel.", "label": "c", "marks": null, "partId": "q12-25ccf10d-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "One compound obtained from crude oil is used as a monomer in polymerisation. It has the displayed formula Complete the following structure to show a part of the polymer formed from this monomer. Every effort has been made to contact copyright holders to obtain their permission for the use of copyright material. Pearson Education Ltd. will, if notified, be happy to rectify any errors or omissions and include any such rectifications in future editions.", "label": "d", "marks": null, "partId": "q12-25ccf10d-pd", "figures": [{"url": "assets/crop_1_1789048663893.png", "width": 299, "format": "png", "height": 214, "sha256": "318f51f4d4b4367b685801a8549a407d2fad1ad29289971b17cbb3c02e26a8aa", "assetId": "img:318f51f4d4b4367b685801a8549a407d2fad1ad29289971b17cbb3c02e26a8aa", "mimeType": "image/jpeg", "elementId": "e000261", "sourceName": "assets/crop_1_1789048663893.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789048663897.png", "width": 458, "format": "png", "height": 65, "sha256": "39f34d17201c2992972a2c634fa4dd3c79a0c91ebc38151b53a3e19458aee23e", "assetId": "img:39f34d17201c2992972a2c634fa4dd3c79a0c91ebc38151b53a3e19458aee23e", "mimeType": "image/jpeg", "elementId": "e000263", "sourceName": "assets/crop_2_1789048663897.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}], "number": 12, "figures": [{"url": "assets/crop_1_1789048663893.png", "width": 299, "format": "png", "height": 214, "sha256": "318f51f4d4b4367b685801a8549a407d2fad1ad29289971b17cbb3c02e26a8aa", "assetId": "img:318f51f4d4b4367b685801a8549a407d2fad1ad29289971b17cbb3c02e26a8aa", "mimeType": "image/jpeg", "elementId": "e000261", "sourceName": "assets/crop_1_1789048663893.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789048663897.png", "width": 458, "format": "png", "height": 65, "sha256": "39f34d17201c2992972a2c634fa4dd3c79a0c91ebc38151b53a3e19458aee23e", "assetId": "img:39f34d17201c2992972a2c634fa4dd3c79a0c91ebc38151b53a3e19458aee23e", "mimeType": "image/jpeg", "elementId": "e000263", "sourceName": "assets/crop_2_1789048663897.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q12-25ccf10d", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}], "paperTotal": 120, "schemaVersion": "1.0", "sectionTotals": {}, "questionTotals": {"2": 6, "3": 4, "4": 8, "5": 9, "6": 10, "7": 12, "8": 8, "10": 15, "12": 13}, "reviewRequired": true, "extractionMethod": "glm-ocr-qp-v1", "frontMatterFigures": [{"url": "assets/crop_1_1789048663633.png", "width": 191, "format": "png", "height": 181, "sha256": "aafa01710d487f585333c53eda147ade62ee1da5a3968893fea6d827fe8c49a2", "assetId": "img:aafa01710d487f585333c53eda147ade62ee1da5a3968893fea6d827fe8c49a2", "mimeType": "image/jpeg", "elementId": "e000020", "sourceName": "assets/crop_1_1789048663633.png", "availability": "available", "formatMismatch": true}]}', '{"paper": {"board": "Edexcel", "session": "Summer 2016", "subject": null, "duration": null, "examDate": null, "logNumber": null, "qualification": null, "paperReference": null, "publicationCode": "4CH0_1CR_1606_MS", "canonicalDocumentId": "3cec3480-8c58-56a8-b201-962dbc43a647"}, "entries": [], "icTable": null, "warnings": ["orphan row before first entry: 1 a", "orphan row before first entry: b", "orphan row before first entry: c iii iv v", "orphan row before first entry: electrons", "orphan row before first entry: protons AND neutrons", "orphan row before first entry: protons AND electrons", "orphan row before first entry: neutrons", "orphan row before first entry: 2 a", "orphan row before first entry: Water boils in a kettle", "orphan row before first entry: Ethene is converted to poly(ethene)", "orphan row before first entry: Crystals of iodine sublime on heating", "orphan row before first entry: b", "orphan row before first entry: c", "orphan row before first entry: 3 a", "orphan row before first entry: b", "orphan row before first entry: c", "orphan row before first entry: d", "orphan row before first entry: 4 a", "orphan row before first entry: b", "orphan row before first entry: c", "orphan row before first entry: d", "orphan row before first entry: e", "orphan row before first entry: positive", "orphan row before first entry: potassium", "orphan row before first entry: reducing", "orphan row before first entry: 5 a i", "orphan row before first entry: ii", "orphan row before first entry: M2 risk of fire", "orphan row before first entry: M3 fumes may be toxic/poisonous", "orphan row before first entry: b", "orphan row before first entry: M2 cross in box C(both beta-carotene and lycopene are present in sweet potatoes)", "orphan row before first entry: M3 cross in box E(Both carrots and tomatoes contain a pigment other than beta-carotene, chlorophyll and lycopene)", "orphan row before first entry: c", "orphan row before first entry: M2correct evaluation of $ R_{f} $ value1.3/6.0=0.22", "orphan row before first entry: d", "orphan row before first entry: 6 a", "orphan row before first entry: b", "orphan row before first entry: M2 (therefore) little (thermal/heat) energy required to overcome the forces / separate the molecules", "orphan row before first entry: M1 (strong) attraction between bonding/shared pair of electrons", "orphan row before first entry: M2 (and) nuclei of (both atoms)\nOR\nM1 bonding/shared pair of electrons\nM2 (strongly) attracted to nuclei (of both atoms)", "orphan row before first entry: Do not award M2 if reference to only one nucleus", "orphan row before first entry: d", "orphan row before first entry: e", "orphan row before first entry: M2", "orphan row before first entry: M3", "orphan row before first entry: 7a", "orphan row before first entry: M2only", "orphan row before first entry: b", "orphan row before first entry: c", "orphan row before first entry: d", "orphan row before first entry: e", "orphan row before first entry: 7 f i", "orphan row before first entry: If division upside down or division by one or more atomic numbers, then 0/3", "orphan row before first entry: M2 for obtaining ratio", "orphan row before first entry: Accept any number of sig figs except one Allow 0.92", "orphan row before first entry: M3 for whole number ratio", "orphan row before first entry: M3 DEP on M2", "orphan row before first entry: allow alternative method:", "orphan row before first entry: M1 calculation of MrC2H4Br=108", "orphan row before first entry: M2 expression for % of each element eg C:24/108x100", "orphan row before first entry: M3 evaluation to show these equal 22.2%,3.7%,74.1%", "orphan row before first entry: ii", "orphan row before first entry: M2(216÷108=2)(so molecular formula is)C4H8Br2", "orphan row before first entry: 8 a i", "orphan row before first entry: ii", "orphan row before first entry: iii", "orphan row before first entry: iv", "orphan row before first entry: b", "orphan row before first entry: M2slide/slip(over each other)", "orphan row before first entry: M2 DEP on mention ofEITHERlayers or equivalentOR mention of ions or equivalent", "orphan row before first entry: Do not award M2 ifmolecules/protons/electrons/nuclei in place of ions etc", "orphan row before first entry: If reference to ionic bonding/covalent bonding/molecules/intermolecular forces, no marks", "orphan row before first entry: M3delocalised electrons OR sea of electrons", "orphan row before first entry: M4(can) flow/travel/move(through structure)/are mobile(when voltage/pd is applied)", "orphan row before first entry: 9a", "orphan row before first entry: b", "orphan row before first entry: M2(before)15.9(0)", "orphan row before first entry: M33.5(0)", "orphan row before first entry: c i", "orphan row before first entry: ii", "orphan row before first entry: M2 (volume)", "orphan row before first entry: 9 d", "orphan row before first entry: M2 temperature change=5.8(℃)", "orphan row before first entry: M3(47.7×4.2×5.8=)1200(J)", "orphan row before first entry: Reject1161.9", "orphan row before first entry: M3CQonM1andM2answercorrecttotwoormoresigfig", "orphan row before first entry: Correctfinalanswerwithorwithoutworkingscores3marksAcceptanswerinkJifunitincludedIgnoresign", "orphan row before first entry: 10 a i", "orphan row before first entry: M2 Mr of $\\mathrm{SO}_{2}=32+(2\\times16)$ OR 64", "orphan row before first entry: M3 mass of $\\mathrm{SO}_{2}=(0.006\\times64)=0.38(\\mathrm{g})$", "orphan row before first entry: M1 mass of $\\mathrm{SO}_{2}$ in 1 dm3 $=\\underline{0.38(4)\\times1000}50=7.6(8)(\\mathrm{g})$", "orphan row before first entry: ii", "orphan row before first entry: OR", "orphan row before first entry: M1 volume of solvent is $50\\mathrm{cm}^{3}$ which would dissolve(100/20)=5(g)M2 0.384(g) is less than 5(g) so no $\\mathrm{SO}_{2}$ would escape", "orphan row before first entry: b", "orphan row before first entry: c i", "orphan row before first entry: OR", "orphan row before first entry: thermometer (scale) read incorrectly / timer re