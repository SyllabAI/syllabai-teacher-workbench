6db4e554a2a60071826784af36f444ac52cc87cd55d6cb196f4", "mimeType": "image/jpeg", "elementId": "e000024", "sourceName": "assets/crop_2_1789047920071.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_3_1789047920088.png", "width": 225, "format": "png", "height": 312, "sha256": "bd876bf28983600eca1d2f73c89566440466acbac123c29e56b31489950a88f6", "assetId": "img:bd876bf28983600eca1d2f73c89566440466acbac123c29e56b31489950a88f6", "mimeType": "image/jpeg", "elementId": "e000026", "sourceName": "assets/crop_3_1789047920088.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_4_1789047920095.png", "width": 88, "format": "png", "height": 316, "sha256": "4f5759081c68e24a64523b17de14df7ee6a318a214d73aea82148f75c3cd6d57", "assetId": "img:4f5759081c68e24a64523b17de14df7ee6a318a214d73aea82148f75c3cd6d57", "mimeType": "image/jpeg", "elementId": "e000028", "sourceName": "assets/crop_4_1789047920095.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_5_1789047920100.png", "width": 58, "format": "png", "height": 328, "sha256": "b3a5572e09679c8cb4b65ce60751587575d7b1ba84612e9ddd2a45d7a0e34a22", "assetId": "img:b3a5572e09679c8cb4b65ce60751587575d7b1ba84612e9ddd2a45d7a0e34a22", "mimeType": "image/jpeg", "elementId": "e000030", "sourceName": "assets/crop_5_1789047920100.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_6_1789047920104.png", "width": 213, "format": "png", "height": 294, "sha256": "87a08b5c08d7cf321785a9daa548d82ad856bd444792f54785b5c98b5d58ab8b", "assetId": "img:87a08b5c08d7cf321785a9daa548d82ad856bd444792f54785b5c98b5d58ab8b", "mimeType": "image/jpeg", "elementId": "e000032", "sourceName": "assets/crop_6_1789047920104.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.45, "marksKnown": false, "questionId": "q01-87d9135e", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000036"]}, {"mcq": false, "qwc": false, "stem": "Crude oil is a mixture of substances.", "marks": 3, "parts": [{"qwc": false, "text": "Which word best describes the main substances in crude oil? A bases B carbohydrates C elements D hydrocarbons", "label": "a", "marks": null, "partId": "q02-87d9135e-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "This apparatus can be used to separate the substances present in a sample of crude oil into several fractions. These sentences describe the steps in the method for separating the substances into fractions, but the steps are in the wrong order. R Connect a delivery tube to the boiling tube. S Pour crude oil into a boiling tube. T Collect each fraction in a different test tube. U Fit a thermometer into the boiling tube. V Heat the crude oil gently at first, then more strongly. Put a letter in each box to show the correct order. One has been done for you.", "label": "b", "marks": null, "partId": "q02-87d9135e-pb", "figures": [{"url": "assets/crop_1_1789047920113.png", "width": 438, "format": "png", "height": 786, "sha256": "23b9108700453b17d5e1e78bf805ee7152ca6efa0e78d1a972f4817d46da45cb", "assetId": "img:23b9108700453b17d5e1e78bf805ee7152ca6efa0e78d1a972f4817d46da45cb", "mimeType": "image/jpeg", "elementId": "e000045", "sourceName": "assets/crop_1_1789047920113.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789047920118.png", "width": 1099, "format": "png", "height": 157, "sha256": "fd79688116216992034528ebccc9c6abdac0ed1c91e58e6f474a13552425fec0", "assetId": "img:fd79688116216992034528ebccc9c6abdac0ed1c91e58e6f474a13552425fec0", "mimeType": "image/jpeg", "elementId": "e000053", "sourceName": "assets/crop_2_1789047920118.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}], "number": 2, "figures": [{"url": "assets/crop_1_1789047920113.png", "width": 438, "format": "png", "height": 786, "sha256": "23b9108700453b17d5e1e78bf805ee7152ca6efa0e78d1a972f4817d46da45cb", "assetId": "img:23b9108700453b17d5e1e78bf805ee7152ca6efa0e78d1a972f4817d46da45cb", "mimeType": "image/jpeg", "elementId": "e000045", "sourceName": "assets/crop_1_1789047920113.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789047920118.png", "width": 1099, "format": "png", "height": 157, "sha256": "fd79688116216992034528ebccc9c6abdac0ed1c91e58e6f474a13552425fec0", "assetId": "img:fd79688116216992034528ebccc9c6abdac0ed1c91e58e6f474a13552425fec0", "mimeType": "image/jpeg", "elementId": "e000053", "sourceName": "assets/crop_2_1789047920118.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q02-87d9135e", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "The diagram shows the electronic configuration of an atom of element X.", "marks": 7, "parts": [{"qwc": false, "text": "How many protons does the nucleus of the atom contain?", "label": "a", "marks": null, "partId": "q03-87d9135e-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Which group of the Periodic Table contains element X? Give a reason for your choice.", "label": "a-ii", "marks": null, "partId": "q03-87d9135e-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give the formula of the ion formed by element X in its compounds.", "label": "a-iii", "marks": null, "partId": "q03-87d9135e-pa-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Element X has three isotopes. The table gives the mass number of each isotope and its percentage abundance in a sample of element X. Calculate the relative atomic mass $ \\left( A_{\\mathrm{r}} \\right) $ of element X. Give your answer to one decimal place.", "label": "b", "marks": null, "partId": "q03-87d9135e-pb", "figures": [], "confidence": 0.55, "answerPrompts": ["relative atomic mass of X"]}], "number": 3, "figures": [{"url": "assets/crop_1_1789047920127.png", "width": 1112, "format": "png", "height": 695, "sha256": "a5869b4f00d8aba1af868d727e3168e0ef4ea2f1f1bc2bacb459eac33599a437", "assetId": "img:a5869b4f00d8aba1af868d727e3168e0ef4ea2f1f1bc2bacb459eac33599a437", "mimeType": "image/jpeg", "elementId": "e000056", "sourceName": "assets/crop_1_1789047920127.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q03-87d9135e", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000062"]}, {"mcq": false, "qwc": false, "stem": "The diagram shows how hydrated copper(II) sulfate crystals can be made by reacting copper(II) oxide with dilute sulfuric acid. filter the mixture from stage 2 stage 4 heat the solution from stage 3 until a hot, saturated solution forms allow the solution to cool so that hydrated copper(II) sulfate crystals form", "marks": 6, "parts": [{"qwc": false, "text": "Why is the sulfuric acid heated in stage 1?", "label": "a", "marks": null, "partId": "q04-87d9135e-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "How would you know when the copper(II) oxide is in excess in stage 2?", "label": "b", "marks": null, "partId": "q04-87d9135e-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Why is the mixture filtered in stage 3?", "label": "c", "marks": null, "partId": "q04-87d9135e-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Why do crystals form when the hot saturated solution is cooled in stage 5?", "label": "d", "marks": null, "partId": "q04-87d9135e-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State the colour of the crystals formed in stage 5.", "label": "e", "marks": null, "partId": "q04-87d9135e-pe", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The crystals are removed by filtration and then dried. Suggest a suitable method of drying the crystals.", "label": "f", "marks": null, "partId": "q04-87d9135e-pf", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 4, "figures": [{"url": "assets/crop_1_1789047920143.png", "width": 800, "format": "png", "height": 292, "sha256": "e16b5f0f198c343310315519f3edc98566af2f2c6e1322d1d558fbfb07999dbf", "assetId": "img:e16b5f0f198c343310315519f3edc98566af2f2c6e1322d1d558fbfb07999dbf", "mimeType": "image/jpeg", "elementId": "e000068", "sourceName": "assets/crop_1_1789047920143.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789047920151.png", "width": 829, "format": "png", "height": 439, "sha256": "b5608b93bc4238467f6b209256273189a952df5f41988100e971fb1c608a5c11", "assetId": "img:b5608b93bc4238467f6b209256273189a952df5f41988100e971fb1c608a5c11", "mimeType": "image/jpeg", "elementId": "e000069", "sourceName": "assets/crop_2_1789047920151.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_3_1789047920159.png", "width": 139, "format": "png", "height": 253, "sha256": "7981cbd96750a65cf979508d25e51bd019967a3a3475693c600f8c22744d0c68", "assetId": "img:7981cbd96750a65cf979508d25e51bd019967a3a3475693c600f8c22744d0c68", "mimeType": "image/jpeg", "elementId": "e000070", "sourceName": "assets/crop_3_1789047920159.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_4_1789047920164.png", "width": 173, "format": "png", "height": 213, "sha256": "44d4c5d0671b11796e44f529beadb978c5731c3a17cfb1bc20583e27f025fa6b", "assetId": "img:44d4c5d0671b11796e44f529beadb978c5731c3a17cfb1bc20583e27f025fa6b", "mimeType": "image/jpeg", "elementId": "e000073", "sourceName": "assets/crop_4_1789047920164.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_5_1789047920168.png", "width": 141, "format": "png", "height": 63, "sha256": "79e301b62a23b78824f00c7e0b5ca13c1ff8b7ab86d4b64844fe1f6daf8551bb", "assetId": "img:79e301b62a23b78824f00c7e0b5ca13c1ff8b7ab86d4b64844fe1f6daf8551bb", "mimeType": "image/jpeg", "elementId": "e000075", "sourceName": "assets/crop_5_1789047920168.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q04-87d9135e", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "The table shows some properties of four substances A,B,C and D. A -101 -35 no no B 1063 2970 yes yes C 801 1413 no yes D 3550 4830 no no", "marks": 11, "parts": [{"qwc": false, "text": "Use the information in the table to identify the substance that", "label": "a", "marks": null, "partId": "q05-87d9135e-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "is a metal A B C D", "label": "a-i", "marks": null, "partId": "q05-87d9135e-pa-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "could be diamond A B C D", "label": "a-ii", "marks": null, "partId": "q05-87d9135e-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "is a gas at $ 2 0^{\\circ} \\mathrm{C} $ A B C D", "label": "a-iii", "marks": null, "partId": "q05-87d9135e-pa-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "contains oppositely charged ions A B C D", "label": "a-iv", "marks": null, "partId": "q05-87d9135e-pa-iv", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Some of the substances in the table are compounds. What is meant by the term compound?", "label": "b", "marks": null, "partId": "q05-87d9135e-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The electronic configurations of atoms of sodium and chlorine are Na 2.8.1 Cl 2.8.7 Describe the changes in the electronic configurations of sodium and chlorine when these atoms form sodium chloride.", "label": "c", "marks": null, "partId": "q05-87d9135e-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the relative formula mass of sodium chloride (NaCl). Use the Periodic Table on page 2 to help you.", "label": "c-ii", "marks": null, "partId": "q05-87d9135e-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": ["relative formula mass"]}], "number": 5, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q05-87d9135e", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000085"]}, {"mcq": false, "qwc": false, "stem": "A total volume of 50 $ cm^{3} $ of hydrochloric acid is added gradually to $ 50 cm^{3} $ of sodium hydroxide solution containing some universal indicator. The graph shows how the pH of the solution changes as the acid is added.", "marks": 0, "parts": [{"qwc": false, "text": "Use the graph to answer these questions.", "label": "a", "marks": null, "partId": "q06-87d9135e-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "What is the pH of the sodium hydroxide solution before any acid is added?", "label": "a-i", "marks": null, "partId": "q06-87d9135e-pa-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "What is the pH of the solution after 40 $ cm^{3} $ of acid is added?", "label": "a-ii", "marks": null, "partId": "q06-87d9135e-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "What volume of acid is needed to completely neutralise the sodium hydroxide?", "label": "a-iii", "marks": null, "partId": "q06-87d9135e-pa-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The table shows the colour of universal indicator at different pH values. Complete the table below to show the colour of the solution when the volume of hydrochloric acid added is 20 $ cm^{3} $ and when the volume added is 35 $ cm^{3}. $", "label": "b", "marks": null, "partId": "q06-87d9135e-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Write a chemical equation for the reaction between sodium hydroxide and hydrochloric acid.", "label": "c", "marks": null, "partId": "q06-87d9135e-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 6, "figures": [{"url": "assets/crop_1_1789047920238.png", "width": 1112, "format": "png", "height": 1490, "sha256": "d138125adbc1df954ab6290197be5f31958789cbd5922fdc29d2aee56d66cd8a", "assetId": "img:d138125adbc1df954ab6290197be5f31958789cbd5922fdc29d2aee56d66cd8a", "mimeType": "image/jpeg", "elementId": "e000105", "sourceName": "assets/crop_1_1789047920238.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.45, "marksKnown": false, "questionId": "q06-87d9135e", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000111", "e000113"]}, {"mcq": false, "qwc": false, "stem": "The diagram shows some of the reactions of magnesium.", "marks": 0, "parts": [{"qwc": false, "text": "Complete the table to give the identity of substances F,G and H.", "label": "a", "marks": null, "partId": "q07-87d9135e-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Write a chemical equation for the reaction between magnesium and steam.", "label": "b", "marks": null, "partId": "q07-87d9135e-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 7, "figures": [{"url": "assets/crop_1_1789047920262.png", "width": 1665, "format": "png", "height": 1090, "sha256": "395c4af7a320c84905f797c1d50681c54c694e6bb2ea93b1a141df27ab4366de", "assetId": "img:395c4af7a320c84905f797c1d50681c54c694e6bb2ea93b1a141df27ab4366de", "mimeType": "image/jpeg", "elementId": "e000116", "sourceName": "assets/crop_1_1789047920262.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.45, "marksKnown": false, "questionId": "q07-87d9135e", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000118"]}, {"mcq": false, "qwc": false, "stem": "When lithium is burned in air, the two compounds lithium oxide (Li $ _{2} $ O) and lithium nitride (Li $ _{3} $ N) are formed. Both compounds are ionic and their ions can be represented by dot and cross diagrams. The dot and cross diagram for the ions in lithium oxide is $\\left[ \\left. \\mathrm {O} \\right. \\right] ^ {2 -}$", "marks": 9, "parts": [{"qwc": false, "text": "Draw a dot and cross diagram for the ions in lithium nitride.", "label": "a", "marks": null, "partId": "q08-87d9135e-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The chemical equation for the reaction between lithium and oxygen is $4 \\mathrm {L i} + \\mathrm {O} _ {2} \\rightarrow 2 \\mathrm {L i} _ {2} \\mathrm {O}$ Write a chemical equation for the reaction between lithium and nitrogen.", "label": "b", "marks": null, "partId": "q08-87d9135e-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Lithium nitride reacts violently with water to form a solution of lithium hydroxide and ammonia gas. Complete the following equation by inserting the appropriate state symbols. $\\mathrm {L i} _ {3} \\mathrm {N} (\\mathrm {s}) + 3 \\mathrm {H} _ {2} \\mathrm {O} (\\dots \\dots \\dots \\dots \\dots) \\rightarrow 3 \\mathrm {L i O H} (\\dots \\dots \\dots \\dots \\dots) + \\mathrm {N H} _ {3} (\\dots \\dots \\dots \\dots \\dots)$", "label": "c", "marks": null, "partId": "q08-87d9135e-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Suggest a value for the pH of the solution formed. Give a reason for your answer. pH... reason.", "label": "c-ii", "marks": null, "partId": "q08-87d9135e-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Solid lithium nitride conducts electricity and is used in batteries. Why would you expect solid lithium nitride not to conduct electricity?", "label": "d", "marks": null, "partId": "q08-87d9135e-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 8, "figures": [{"url": "assets/crop_1_1789047920278.png", "width": 245, "format": "png", "height": 260, "sha256": "ca77e2489da3b6ccbf7bd3a9d896b68a23ea6fa806886830f03a1b6bdf6e13d7", "assetId": "img:ca77e2489da3b6ccbf7bd3a9d896b68a23ea6fa806886830f03a1b6bdf6e13d7", "mimeType": "image/jpeg", "elementId": "e000124", "sourceName": "assets/crop_1_1789047920278.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q08-87d9135e", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "The diagram shows the displayed formulae of five hydrocarbons A, B, C, D and E. E", "marks": 11, "parts": [{"qwc": false, "text": "Give the letter of a hydrocarbon to answer these questions. You may use each letter once, more than once or not at all.", "label": "a", "marks": null, "partId": "q09-87d9135e-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Which hydrocarbon is the main component of natural gas?", "label": "a-i", "marks": null, "partId": "q09-87d9135e-pa-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Which other hydrocarbon is produced, together with D, when pentane $ \\left( \\mathrm{C}_{5} \\mathrm{H}_{1 2} \\right) $ is cracked?", "label": "a-ii", "marks": null, "partId": "q09-87d9135e-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Which hydrocarbon can undergo an addition reaction with hydrogen to form B?", "label": "a-iii", "marks": null, "partId": "q09-87d9135e-pa-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give the molecular formula and the empirical formula of E. molecular formula empirical formula", "label": "b", "marks": null, "partId": "q09-87d9135e-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Hydrocarbons A, B, D and E all belong to the same homologous series.", "label": "c", "marks": null, "partId": "q09-87d9135e-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give the name and the general formula of this homologous series. name. general formula", "label": "c-i", "marks": null, "partId": "q09-87d9135e-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Draw the displayed formula of an isomer of E.", "label": "c-ii", "marks": null, "partId": "q09-87d9135e-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Two reactions that can occur when hydrocarbon A is burned in air are represented by these equations. Equation for reaction 1 $\\mathrm {C H} _ {4} + 2 \\mathrm {O} _ {2} \\rightarrow \\mathrm {C O} _ {2} + 2 \\mathrm {H} _ {2} \\mathrm {O}$ Equation for reaction 2 $\\mathrm {C H} _ {4} + 1 \\frac {1}{2} \\mathrm {O} _ {2} \\rightarrow \\mathrm {C O} + 2 \\mathrm {H} _ {2} \\mathrm {O}$ Explain why a different product is formed in reaction 2 and why this product is dangerous.", "label": "d", "marks": null, "partId": "q09-87d9135e-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 9, "figures": [{"url": "assets/crop_1_1789047920293.png", "width": 172, "format": "png", "height": 220, "sha256": "3f9c6b65098b57946e0618a859c1d0fbd98880a56161751fa3727ecc1afc14f2", "assetId": "img:3f9c6b65098b57946e0618a859c1d0fbd98880a56161751fa3727ecc1afc14f2", "mimeType": "image/jpeg", "elementId": "e000138", "sourceName": "assets/crop_1_1789047920293.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789047920297.png", "width": 234, "format": "png", "height": 224, "sha256": "7e29076bdcba991ea4938eeec442c09cb6665ed7b0c62fab4a16fdc8ac9c6d9e", "assetId": "img:7e29076bdcba991ea4938eeec442c09cb6665ed7b0c62fab4a16fdc8ac9c6d9e", "mimeType": "image/jpeg", "elementId": "e000139", "sourceName": "assets/crop_2_1789047920297.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_3_1789047920301.png", "width": 222, "format": "png", "height": 200, "sha256": "1006f1aa5340033b77025900b3d2a177e33157dce55a9bad481d5adb22023c6b", "assetId": "img:1006f1aa5340033b77025900b3d2a177e33157dce55a9bad481d5adb22023c6b", "mimeType": "image/jpeg", "elementId": "e000142", "sourceName": "assets/crop_3_1789047920301.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_4_1789047920305.png", "width": 294, "format": "png", "height": 224, "sha256": "5a0786f9f6af27313a445423634e445f573c7125b5ea3f891f0bf9082b485e64", "assetId": "img:5a0786f9f6af27313a445423634e445f573c7125b5ea3f891f0bf9082b485e64", "mimeType": "image/jpeg", "elementId": "e000144", "sourceName": "assets/crop_4_1789047920305.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_5_1789047920309.png", "width": 360, "format": "png", "height": 224, "sha256": "9c124978c7351c583b86fb341aef369c29a594b129ebf2f34b3395c291f61da5", "assetId": "img:9c124978c7351c583b86fb341aef369c29a594b129ebf2f34b3395c291f61da5", "mimeType": "image/jpeg", "elementId": "e000146", "sourceName": "assets/crop_5_1789047920309.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q09-87d9135e", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "Aluminium and iron have some similar properties. Both metals are malleable are ductile (can be drawn into a wire) are good conductors of electricity are good conductors of heat have a high melting point", "marks": 12, "parts": [{"qwc": false, "text": "Choose two properties from the list that make iron a suitable metal for saucepans.", "label": "a", "marks": null, "partId": "q10-87d9135e-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Choose two properties from the list that make aluminium a suitable metal for power cables.", "label": "a-ii", "marks": null, "partId": "q10-87d9135e-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Steel is an alloy containing iron. These are three differences between steel and aluminium. steel can rust but aluminium resists corrosion steel has a higher density than aluminium steel is much stronger than aluminium", "label": "b", "marks": null, "partId": "q10-87d9135e-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Use information from the list to suggest why steel is the better metal for making bridges.", "label": "b-i", "marks": null, "partId": "q10-87d9135e-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Use information from the list to suggest why aluminium is the better metal for making aircraft bodies.", "label": "b-ii", "marks": null, "partId": "q10-87d9135e-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The reaction between aluminium and iron(III) oxide is known as a thermite reaction. The diagram shows how this thermite reaction can be carried out. The magnesium ribbon is lit to ignite the reaction mixture. The reaction is highly exothermic. The equation for the reaction is $2 \\mathrm {A l} + \\mathrm {F e} _ {2} \\mathrm {O} _ {3} \\rightarrow \\mathrm {A l} _ {2} \\mathrm {O} _ {3} + 2 \\mathrm {F e}$", "label": "c", "marks": null, "partId": "q10-87d9135e-pc", "figures": [{"url": "assets/crop_1_1789047920337.png", "width": 960, "format": "png", "height": 396, "sha256": "a8fc621544ac541fb3ef32cd9812fb84b19e78243a046f405947e16e530167eb", "assetId": "img:a8fc621544ac541fb3ef32cd9812fb84b19e78243a046f405947e16e530167eb", "mimeType": "image/jpeg", "elementId": "e000186", "sourceName": "assets/crop_1_1789047920337.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "What is meant by the term exothermic?", "label": "c-i", "marks": null, "partId": "q10-87d9135e-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "What does the reaction suggest about the reactivity of aluminium compared to the reactivity of iron? Explain your answer.", "label": "c-ii", "marks": null, "partId": "q10-87d9135e-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Which element is oxidised in this thermite reaction? Give a reason for your answer.", "label": "c-iii", "marks": null, "partId": "q10-87d9135e-pc-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "This thermite reaction can be used to join together two rails on a railway line. The reaction mixture is ignited and molten iron pours into the mould. The mould is removed and the molten iron solidifies to create a join between the two rails. Explain why the iron produced in the reaction is molten.", "label": "d", "marks": null, "partId": "q10-87d9135e-pd", "figures": [{"url": "assets/crop_1_1789047920371.png", "width": 1064, "format": "png", "height": 403, "sha256": "426f4964796a67d10a7a0343207f2a29b4c59e1c299fc10ab511f2684e017948", "assetId": "img:426f4964796a67d10a7a0343207f2a29b4c59e1c299fc10ab511f2684e017948", "mimeType": "image/jpeg", "elementId": "e000197", "sourceName": "assets/crop_1_1789047920371.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}], "number": 10, "figures": [{"url": "assets/crop_1_1789047920337.png", "width": 960, "format": "png", "height": 396, "sha256": "a8fc621544ac541fb3ef32cd9812fb84b19e78243a046f405947e16e530167eb", "assetId": "img:a8fc621544ac541fb3ef32cd9812fb84b19e78243a046f405947e16e530167eb", "mimeType": "image/jpeg", "elementId": "e000186", "sourceName": "assets/crop_1_1789047920337.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_1_1789047920371.png", "width": 1064, "format": "png", "height": 403, "sha256": "426f4964796a67d10a7a0343207f2a29b4c59e1c299fc10ab511f2684e017948", "assetId": "img:426f4964796a67d10a7a0343207f2a29b4c59e1c299fc10ab511f2684e017948", "mimeType": "image/jpeg", "elementId": "e000197", "sourceName": "assets/crop_1_1789047920371.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q10-87d9135e", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "This apparatus can be used to obtain ethene by cracking a liquid alkane.", "marks": 5, "parts": [{"qwc": false, "text": "What is meant by the term cracking?", "label": "a", "marks": null, "partId": "q11-87d9135e-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give a chemical test to show that the gas collected is unsaturated.", "label": "b", "marks": null, "partId": "q11-87d9135e-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Cracking is also carried out in industry. Give the name of the catalyst and the temperature used in the catalytic cracking of hydrocarbons. catalyst... temperature", "label": "c", "marks": null, "partId": "q11-87d9135e-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 11, "figures": [{"url": "assets/crop_1_1789047920396.png", "width": 1428, "format": "png", "height": 740, "sha256": "f4b2366a344e3f70a71b714c4bff397f6d68e62f3ef30bea0217b988e92ff5ac", "assetId": "img:f4b2366a344e3f70a71b714c4bff397f6d68e62f3ef30bea0217b988e92ff5ac", "mimeType": "image/jpeg", "elementId": "e000202", "sourceName": "assets/crop_1_1789047920396.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q11-87d9135e", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "A sample of a chlorofluorocarbon (CFC) contains 0.24 g of carbon, 0.38 g of fluorine and 1.42 g of chlorine.", "marks": 0, "parts": [{"qwc": false, "text": "Show, by calculation, that the empirical formula of the CFC is $ \\mathrm{C F C} \\mathrm{I}_{2} $", "label": "a", "marks": null, "partId": "q12-87d9135e-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The relative formula mass of the CFC is 204. Deduce the molecular formula of the CFC. molecular formula", "label": "a-ii", "marks": null, "partId": "q12-87d9135e-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The displayed formula of another CFC is Draw a dot and cross diagram of this CFC. Show only the outer electrons.", "label": "b", "marks": null, "partId": "q12-87d9135e-pb", "figures": [{"url": "assets/crop_1_1789047920407.png", "width": 174, "format": "png", "height": 219, "sha256": "a8ec5f836543e45c3ce477739c7151eb0d5b9d20ad56f30a84de2ba7035c6244", "assetId": "img:a8ec5f836543e45c3ce477739c7151eb0d5b9d20ad56f30a84de2ba7035c6244", "mimeType": "image/jpeg", "elementId": "e000215", "sourceName": "assets/crop_1_1789047920407.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}], "number": 12, "figures": [{"url": "assets/crop_1_1789047920407.png", "width": 174, "format": "png", "height": 219, "sha256": "a8ec5f836543e45c3ce477739c7151eb0d5b9d20ad56f30a84de2ba7035c6244", "assetId": "img:a8ec5f836543e45c3ce477739c7151eb0d5b9d20ad56f30a84de2ba7035c6244", "mimeType": "image/jpeg", "elementId": "e000215", "sourceName": "assets/crop_1_1789047920407.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.45, "marksKnown": false, "questionId": "q12-87d9135e", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "The diagram shows three different forms of carbon. diamond structure graphite structure fullerene molecule", "marks": 9, "parts": [{"qwc": false, "text": "Name the type of bond that exists between the carbon atoms in all three structures.", "label": "a", "marks": null, "partId": "q13-87d9135e-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain why diamond has a very high melting point.", "label": "b", "marks": null, "partId": "q13-87d9135e-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Fullerene has a simple molecular structure Explain why it has a low melting point.", "label": "b-ii", "marks": null, "partId": "q13-87d9135e-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "There are two theories used to explain why graphite can act as a solid lubricant. Theory A The forces of attraction between the layers are weak allowing the layers to slide over one another. Theory B Gas molecules are trapped between the layers allowing the layers to slide over one another. The table shows the ability of graphite to act as a lubricant in different locations. Suggest which theory is supported by the evidence in the table. Give a reason for your choice.", "label": "c", "marks": null, "partId": "q13-87d9135e-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Graphite and diamond can be changed from one form to the other according to the equation $\\mathrm {C} (\\mathrm {g r a p h i t e}) \\rightleftharpoons \\mathrm {C} (\\mathrm {d i a m o n d}) \\quad \\Delta H = + 1. 9 \\mathrm {k J / m o l}$ Would a low or a high temperature favour the conversion of graphite into diamond? Give a reason for your choice.", "label": "d", "marks": null, "partId": "q13-87d9135e-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 13, "figures": [{"url": "assets/crop_1_1789047920417.png", "width": 404, "format": "png", "height": 387, "sha256": "a65a9433eadb38480bd3430110ca223f85a4bf4a3771d4a8f4bb3a1ac42d7893", "assetId": "img:a65a9433eadb38480bd3430110ca223f85a4bf4a3771d4a8f4bb3a1ac42d7893", "mimeType": "image/jpeg", "elementId": "e000218", "sourceName": "assets/crop_1_1789047920417.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789047920422.png", "width": 436, "format": "png", "height": 310, "sha256": "dbc4c564ef1308f2772fa157c7c5fb13fb229327974b139c9d3c203042b80f04", "assetId": "img:dbc4c564ef1308f2772fa157c7c5fb13fb229327974b139c9d3c203042b80f04", "mimeType": "image/jpeg", "elementId": "e000220", "sourceName": "assets/crop_2_1789047920422.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_3_1789047920434.png", "width": 409, "format": "png", "height": 395, "sha256": "c47d1fb79729fcd7696c72bf77ca5f6dc2d458a982dac00a33d3218368a68ba7", "assetId": "img:c47d1fb79729fcd7696c72bf77ca5f6dc2d458a982dac00a33d3218368a68ba7", "mimeType": "image/jpeg", "elementId": "e000222", "sourceName": "assets/crop_3_1789047920434.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q13-87d9135e", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000231"]}, {"mcq": false, "qwc": false, "stem": "(a) The table shows information about two common addition polymers. Complete the table for these two polymers.", "marks": 9, "parts": [{"qwc": false, "text": "State two changes that occur in the formation of an addition polymer from its monomer.", "label": "b", "marks": null, "partId": "q14-87d9135e-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Addition polymers such as poly(ethene) are very difficult to dispose of because they do not biodegrade easily.", "label": "c", "marks": null, "partId": "q14-87d9135e-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State a reason why addition polymers do not biodegrade easily.", "label": "c-i", "marks": null, "partId": "q14-87d9135e-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Burning and landfill (burying in the ground) are two methods used to dispose of addition polymers. Suggest a problem with each method of disposal. burning. landfill.", "label": "c-ii", "marks": null, "partId": "q14-87d9135e-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 14, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q14-87d9135e", "answerPrompts": ["(4)"], "numberingStyle": "space", "tableElementIds": ["e000240"]}, {"mcq": false, "qwc": false, "stem": "(a) A student made a solution of sodium hydroxide by dissolving 10.0 g of solid sodium hydroxide in distilled water to make $ 2 5 0 \\mathrm{c m}^{3} $ of solution. (i) Calculate the amount, in moles, of NaOH in 10.0 g of sodium hydroxide. (ii) Calculate the concentration, in mol/dm $ ^{3} $ , of this solution of sodium hydroxide.", "marks": 0, "parts": [{"qwc": false, "text": "The student uses the sodium hydroxide solution to find the concentration of a solution of hydrochloric acid. He uses this method use a pipette to put 25.0 $ cm^{3} $ of the sodium hydroxide solution into a conical flask add a few drops of methyl orange indicator to the solution gradually add the hydrochloric acid from a burette until the solution in the flask just changes colour The diagram shows his burette readings. Complete the table, giving all values to the nearest 0.05 $ cm^{3}. $", "label": "b", "marks": null, "partId": "q15-87d9135e-pb", "figures": [{"url": "assets/crop_1_1789047920505.png", "width": 149, "format": "png", "height": 513, "sha256": "b62f4eadbd48351ae8f7a853e14519070e2420fb857ec8dfa24ce43628b68150", "assetId": "img:b62f4eadbd48351ae8f7a853e14519070e2420fb857ec8dfa24ce43628b68150", "mimeType": "image/jpeg", "elementId": "e000258", "sourceName": "assets/crop_1_1789047920505.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789047920509.png", "width": 144, "format": "png", "height": 491, "sha256": "139df72ece52bd374b104ac2d7e0ec066967283ea427b49a9e529c6bcb76b338", "assetId": "img:139df72ece52bd374b104ac2d7e0ec066967283ea427b49a9e529c6bcb76b338", "mimeType": "image/jpeg", "elementId": "e000259", "sourceName": "assets/crop_2_1789047920509.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State the colour of the methyl orange at the start and at the end of the experiment.", "label": "b-ii", "marks": null, "partId": "q15-87d9135e-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Why is a burette used instead of a pipette for adding the acid? QUESTION 15 CONTINUES ON NEXT PAGE", "label": "b-iii", "marks": null, "partId": "q15-87d9135e-pb-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Sodium hydroxide reacts with carbon dioxide. The equation for this reaction is $2 \\mathrm {N a O H} + \\mathrm {C O} _ {2} \\rightarrow \\mathrm {N a} _ {2} \\mathrm {C O} _ {3} + \\mathrm {H} _ {2} \\mathrm {O}$ A solution of sodium hydroxide of concentration 2.00 mol/dm $ ^{3} $ is used.", "label": "c", "marks": null, "partId": "q15-87d9135e-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the amount, in moles, of sodium hydroxide in $ 2 0 0 \\mathrm{c m}^{3} $ of this solution.", "label": "c-i", "marks": null, "partId": "q15-87d9135e-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Deduce the maximum mass, in grams, of carbon dioxide that can react with this solution of sodium hydroxide.", "label": "c-ii", "marks": null, "partId": "q15-87d9135e-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 15, "figures": [{"url": "assets/crop_1_1789047920505.png", "width": 149, "format": "png", "height": 513, "sha256": "b62f4eadbd48351ae8f7a853e14519070e2420fb857ec8dfa24ce43628b68150", "assetId": "img:b62f4eadbd48351ae8f7a853e14519070e2420fb857ec8dfa24ce43628b68150", "mimeType": "image/jpeg", "elementId": "e000258", "sourceName": "assets/crop_1_1789047920505.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789047920509.png", "width": 144, "format": "png", "height": 491, "sha256": "139df72ece52bd374b104ac2d7e0ec066967283ea427b49a9e529c6bcb76b338", "assetId": "img:139df72ece52bd374b104ac2d7e0ec066967283ea427b49a9e529c6bcb76b338", "mimeType": "image/jpeg", "elementId": "e000259", "sourceName": "assets/crop_2_1789047920509.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.45, "marksKnown": false, "questionId": "q15-87d9135e", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000261"]}], "paperTotal": 120, "schemaVersion": "1.0", "sectionTotals": {}, "questionTotals": {"2": 3, "3": 7, "4": 6, "5": 11, "8": 9, "9": 11, "10": 12, "11": 5, "13": 9, "14": 9}, "reviewRequired": true, "extractionMethod": "glm-ocr-qp-v1", "frontMatterFigures": []}', '{"paper": {"board": "Edexcel", "session": "June 2014", "subject": null, "duration": null, "examDate": null, "logNumber": null, "qualification": null, "paperReference": null, "publicationCode": "UG038368", "canonicalDocumentId": "2f4affa8-3e24-50db-b0a2-25f265b1a519"}, "entries": [{"mcq": false, "qwc": false, "label": "1(a)", "marks": 1, "number": 1, "entryId": "ms-2f4affa8-q1a", "guidance": [{"kind": "note", "text": "teat pipette/dropping pipette"}, {"kind": "note", "text": "D-test tube/boiling tube"}, {"kind": "note", "text": "E-pipette"}, {"kind": "note", "text": "F-beaker"}, {"kind": "note", "text": "(b)"}, {"kind": "note", "text": "M1-A"}, {"kind": "note", "text": "M2-E"}], "answerText": "B-(filter) funnel", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "2(a)(i)", "marks": 1, "number": 2, "entryId": "ms-2f4affa8-q2ai", "guidance": [{"kind": "note", "text": "(b)"}, {"kind": "note", "text": "SURVT"}, {"kind": "note", "text": "First mark for S in box1 AND R in box3"}, {"kind": "note", "text": "Second mark for V in box4 AND T in box5"}], "answerText": "D-hydrocarbons", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "4(a)", "marks": 1, "number": 4, "entryId": "ms-2f4affa8-q4a", "guidance": [{"kind": "note", "text": "to overcome the activation energy/to provide activation energy(for the reaction)"}, {"kind": "note", "text": "Answers referring to copper instead of copper(II) oxide"}, {"kind": "note", "text": "(b)"}, {"kind": "note", "text": "it stops disappearingORthere is a(black) suspension/solid/copper(II) oxideORthe mixture/it turns cloudy/blackIGNORE crystals"}, {"kind": "note", "text": "stops dissolvingprecipitate/ppt"}, {"kind": "note", "text": "any colour other than black"}, {"kind": "note", "text": "(c)"}, {"kind": "note", "text": "to remove(unreacted/excess) copper(II) oxideIGNORE references to impurities/crystals"}, {"kind": "note", "text": "to remove(unreacted/excess)solidto obtain a solution(of copper(II)sulfate)"}, {"kind": "note", "text": "to separate copper(II) oxide from sulfuric acid"}, {"kind": "note", "text": "(d)"}, {"kind": "note", "text": "copper(II)sulfate/the crystals are less soluble in cold water(than in hot water)OR solubility decreases with temperatureIGNORE reference to water evaporating"}, {"kind": "note", "text": "reverse argumentions join together(to form a lattice)ionic lattice forms"}, {"kind": "note", "text": "references to freezing"}], "answerText": "to increase the rate/speed(o