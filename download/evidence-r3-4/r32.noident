INSERT INTO public.questions VALUES ('3ef9971c-ad72-4910-b831-10ec413a6d71', 'q15-421db8f1', 'STRUCTURED', 'Hydrobromic acid can be neutralised by adding sodium hydroxide solution. The equation for the reaction is $\mathrm {H B r} + \mathrm {N a O H} \rightarrow \mathrm {N a B r} + \mathrm {H} _ {2} \mathrm {O}$ A solution of hydrobromic acid has a concentration of $ 0.200\mathrm{mol / dm}^{3}. $', 6, 3, 540, NULL, '79944260-15f1-4d9d-bc83-d61c3716963e', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.15537+00', '8c73030d-9403-4b20-9249-dd7626dd23f2');
