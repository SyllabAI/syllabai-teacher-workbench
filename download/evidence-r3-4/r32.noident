GE", "sectionId": "s007", "elementIds": [], "pageNumber": 1}, {"level": 2, "title": "BLANK PAGE", "sectionId": "s008", "elementIds": [], "pageNumber": 1}, {"level": 2, "title": "BLANK PAGE", "sectionId": "s009", "elementIds": [], "pageNumber": 1}], "equations": [{"text": "S + O _ {2} \\rightarrow S O _ {2}", "latex": "S + O _ {2} \\rightarrow S O _ {2}", "confidence": 1.0, "element_id": "e000054", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 54, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {C a} _ {3} \\left(\\mathrm {P O} _ {4}\\right) _ {2} + \\dots \\dots \\dots \\dots \\mathrm {C} \\rightarrow \\mathrm {C a} _ {3} \\mathrm {P} _ {2} + \\dots \\dots \\dots \\dots \\mathrm {C O}", "latex": "\\mathrm {C a} _ {3} \\left(\\mathrm {P O} _ {4}\\right) _ {2} + \\dots \\dots \\dots \\dots \\mathrm {C} \\rightarrow \\mathrm {C a} _ {3} \\mathrm {P} _ {2} + \\dots \\dots \\dots \\dots \\mathrm {C O}", "confidence": 1.0, "element_id": "e000082", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 82, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {H N O} _ {3} + \\mathrm {N a O H} \\rightarrow \\mathrm {N a N O} _ {3} + \\mathrm {H} _ {2} \\mathrm {O}", "latex": "\\mathrm {H N O} _ {3} + \\mathrm {N a O H} \\rightarrow \\mathrm {N a N O} _ {3} + \\mathrm {H} _ {2} \\mathrm {O}", "confidence": 1.0, "element_id": "e000126", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 126, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {a m o u n t o f N a O H} =", "latex": "\\mathrm {a m o u n t o f N a O H} =", "confidence": 1.0, "element_id": "e000128", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 128, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {a m o u n t o f H N O} _ {3} =", "latex": "\\mathrm {a m o u n t o f H N O} _ {3} =", "confidence": 1.0, "element_id": "e000130", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 130, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {m o l / d m ^ {3}}", "latex": "\\mathrm {m o l / d m ^ {3}}", "confidence": 1.0, "element_id": "e000132", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 132, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {N} _ {2} + \\mathrm {O} _ {2} \\rightarrow 2 \\mathrm {N O} \\quad \\Delta H = + 1 8 1 \\mathrm {k J}", "latex": "\\mathrm {N} _ {2} + \\mathrm {O} _ {2} \\rightarrow 2 \\mathrm {N O} \\quad \\Delta H = + 1 8 1 \\mathrm {k J}", "confidence": 1.0, "element_id": "e000137", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 137, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {N} \\equiv \\mathrm {N} + 3 \\mathrm {H} - \\mathrm {H} \\rightarrow 2 \\mathrm {H} - \\mathrm {N} - \\mathrm {H}", "latex": "\\mathrm {N} \\equiv \\mathrm {N} + 3 \\mathrm {H} - \\mathrm {H} \\rightarrow 2 \\mathrm {H} - \\mathrm {N} - \\mathrm {H}", "confidence": 1.0, "element_id": "e000140", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 140, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\Delta H =", "latex": "\\Delta H =", "confidence": 1.0, "element_id": "e000148", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 148, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "pageCount": 1, "documentId": "75c7a386-54b6-54d3-a2ba-47635a55fcdc", "provenance": {"engine": "glm-ocr-markdown", "application": "syllabai-parser", "extractedAt": "2026-09-13T13:03:18.299013305Z", "engineVersion": "1.1.0", "schemaVersion": "1.0", "extractionParams": {"pageBoundaries": "none-in-source", "sourceLineCount": 205, "upstreamConverter": "zai-glm-ocr", "entityDecodedLines": 0, "signedUrlFigureRefs": 0, "normalizedHtmlEntities": true}}, "textBlocks": [{"role": "heading", "text": "Instructions", "confidence": 1.0, "element_id": "e000001", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 1, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Use black ink or ball-point pen.", "confidence": 1.0, "element_id": "e000002", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 2, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "If pencil is used for diagrams/sketches/graphs it must be dark (HB or B).", "confidence": 1.0, "element_id": "e000003", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 3, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Fill in the boxes at the top of this page with your name, centre number and candidate number.", "confidence": 1.0, "element_id": "e000004", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 4, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer all questions.", "confidence": 1.0, "element_id": "e000005", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 5, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer the questions in the spaces provided", "confidence": 1.0, "element_id": "e000006", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 6, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "there may be more space than you need.", "confidence": 1.0, "element_id": "e000007", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 7, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Show all the steps in any calculations and state the units.", "confidence": 1.0, "element_id": "e000008", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 8, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Information", "confidence": 1.0, "element_id": "e000009", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 9, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The total mark for this paper is 70.", "confidence": 1.0, "element_id": "e000010", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 10, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The marks for each question are shown in brackets", "confidence": 1.0, "element_id": "e000011", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 11, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "use this as a guide as to how much time to spend on each question.", "confidence": 1.0, "element_id": "e000012", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 12, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Advice", "confidence": 1.0, "element_id": "e000013", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 13, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Read each question carefully before you start to answer it.", "confidence": 1.0, "element_id": "e000014", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 14, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Write your answers neatly and in good English.", "confidence": 1.0, "element_id": "e000015", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 15, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Try to answer every question.", "confidence": 1.0, "element_id": "e000016", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 16, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Check your answers if you have time at the end.", "confidence": 1.0, "element_id": "e000017", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 17, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Turn over", "confidence": 1.0, "element_id": "e000018", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 18, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The lanthanoids (atomic numbers 58-71) and the actinoids (atomic numbers 90-103) have been omitted.", "confidence": 1.0, "element_id": "e000020", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 20, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The relative atomic masses of copper and chlorine have not been rounded to the nearest whole number.", "confidence": 1.0, "element_id": "e000021", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 21, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Answer ALL questions.", "confidence": 1.0, "element_id": "e000022", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 22, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Some questions must be answered with a cross in a box. If you change your mind about an answer, put a line through the box and then mark your new answer with a cross.", "confidence": 1.0, "element_id": "e000023", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 23, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "1 In this question the answer to each part is a number.", "confidence": 1.0, "element_id": "e000024", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 24, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Give the pH value of a neutral solution.", "confidence": 1.0, "element_id": "e000025", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 25, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Give a pH value of a weakly acidic solution.", "confidence": 1.0, "element_id": "e000026", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 26, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Give the number of the Group in the Periodic Table that contains the elements that do not readily react.", "confidence": 1.0, "element_id": "e000027", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 27, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) Give the number of different elements present in glucose, $ \\mathrm{C_{6} H_{1 2} O_{6}} $", "confidence": 1.0, "element_id": "e000028", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 28, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 1 = 4 marks)", "confidence": 1.0, "element_id": "e000029", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 29, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "2 The solubility of a solid depends on the solvent used.", "confidence": 1.0, "element_id": "e000030", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 30, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) State one other factor that affects the solubility.", "confidence": 1.0, "element_id": "e000031", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 31, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) A student wants to find the solubility of a salt in water.", "confidence": 1.0, "element_id": "e000032", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 32, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The steps in the student''s method are not in the correct order.", "confidence": 1.0, "element_id": "e000033", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 33, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step A gently heat the evaporating basin and solution to remove all the water", "confidence": 1.0, "element_id": "e000034", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 34, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step B filter to obtain $ 5 0. 0 \\mathrm{c m}^{3} $ of saturated solution", "confidence": 1.0, "element_id": "e000035", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 35, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step C record the mass of the evaporating basin and salt solution", "confidence": 1.0, "element_id": "e000036", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 36, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step D record the mass of an empty evaporating basin", "confidence": 1.0, "element_id": "e000037", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 37, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step E record the mass of the evaporating basin and the dry salt", "confidence": 1.0, "element_id": "e000038", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 38, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step F put $ 5 0. 0 \\mathrm{c m}^{3} $ of water into a beaker", "confidence": 1.0, "element_id": "e000039", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 39, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step G add the salt to the water a little at a time and stir until no more dissolves Step H pour the $ 5 0. 0 \\mathrm{c m}^{3} $ of saturated salt solution into the evaporating basin", "confidence": 1.0, "element_id": "e000040", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 40, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) The flowchart shows the correct order of some of the steps. Complete the flowchart by putting the remaining steps in the correct order.", "confidence": 1.0, "element_id": "e000041", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 41, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(2)", "confidence": 1.0, "element_id": "e000042", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 42, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "3 When 10.0kg of a solid fuel is burned,the heat energy produced is $ 3. 2 8 \\times1 0^{5} $ kJ.", "confidence": 1.0, "element_id": "e000045", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 45, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Calculate the heat energy, in kJ/mol, produced by the fuel.", "confidence": 1.0, "element_id": "e000046", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 46, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "You should assume that the fuel is pure carbon.", "confidence": 1.0, "element_id": "e000047", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 47, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Give your answer to three significant figures.", "confidence": 1.0, "element_id": "e000048", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 48, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "[for carbon, $ A_{\\mathrm{r}}=1 2 $]", "confidence": 1.0, "element_id": "e000049", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 49, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The fuel actually contains some impurities, including sulfur.", "confidence": 1.0, "element_id": "e000050", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 50, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "There is 600g of sulfur in 20kg of fuel.", "confidence": 1.0, "element_id": "e000051", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 51, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Calculate the percentage of sulfur in the fuel.", "confidence": 1.0, "element_id": "e000052", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 52, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) When the fuel burns,the 600g of sulfur produces sulfur dioxide gas.", "confidence": 1.0, "element_id": "e000053", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 53, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Calculate the volume, in $ cm^{3} $ , of sulfur dioxide gas that would be produced at room temperature and pressure (rtp) when the fuel burns.", "confidence": 1.0, "element_id": "e000055", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 55, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "[for a gas, molar volume = 24 dm $ ^{3} $ at rtp]", "confidence": 1.0, "element_id": "e000056", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 56, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "volume of sulfur dioxide =", "confidence": 1.0, "element_id": "e000057", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 57, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) State the name of the environmental problem caused by sulfur dioxide in the atmosphere.", "confidence": 1.0, "element_id": "e000058", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 58, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 3 = 9 marks)", "confidence": 1.0, "element_id": "e000059", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 59, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "4 (a) Hand sanitiser liquids are used regularly to reduce the spread of infections.", "confidence": 1.0, "element_id": "e000060", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 60, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Three compounds P, Q and R are often present in these liquids.", "confidence": 1.0, "element_id": "e000061", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 61, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) What type of formula is shown for P?", "confidence": 1.0, "element_id": "e000063", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 63, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A a displayed formula", "confidence": 1.0, "element_id": "e000064", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 64, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B an empirical formula", "confidence": 1.0, "element_id": "e000065", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 65, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C a molecular formula", "confidence": 1.0, "element_id": "e000066", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 66, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D a structural formula", "confidence": 1.0, "element_id": "e000067", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 67, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Compounds P, Q and R are members of the same homologous series. Give two properties of a homologous series.", "confidence": 1.0, "element_id": "e000068", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 68, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Name the homologous series that contains compounds P, Q and R.", "confidence": 1.0, "element_id": "e000069", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 69, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iv) Give the name of compound Q.", "confidence": 1.0, "element_id": "e000070", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 70, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Diols and dicarboxylic acids react together in polymerisation reactions to form polyesters.", "confidence": 1.0, "element_id": "e000071", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 71, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Explain the name given to the type of polymerisation that occurs in these reactions.", "confidence": 1.0, "element_id": "e000072", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 72, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Complete the equation for the polymerisation reaction by giving the displayed formula of the repeat unit of the polymer.", "confidence": 1.0, "element_id": "e000073", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 73, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "5 This question is about the element phosphorus and some of its compounds.", "confidence": 1.0, "element_id": "e000075", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 75, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) The atomic number of phosphorus is 15 Give the electronic configuration of an atom of phosphorus.", "confidence": 1.0, "element_id": "e000076", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 76, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Calcium phosphide is an ionic compound used in pest control.", "confidence": 1.0, "element_id": "e000077", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 77, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The formula of a calcium ion is $ \\mathrm{C a}^{2+} $", "confidence": 1.0, "element_id": "e000078", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 78, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Explain why the formula of calcium phosphide is $ \\mathrm{C a}_{3} \\mathrm{P}_{2} $", "confidence": 1.0, "element_id": "e000079", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 79, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Calcium phosphide can be produced by heating calcium phosphate with carbon.", "confidence": 1.0, "element_id": "e000080", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 80, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Complete the equation for the reaction.", "confidence": 1.0, "element_id": "e000081", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 81, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Explain the role of carbon in the reaction.", "confidence": 1.0, "element_id": "e000083", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 83, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) Calcium phosphide reacts with water to form calcium hydroxide and phosphine, $ \\mathrm{P H_{3}} $", "confidence": 1.0, "element_id": "e000084", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 84, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Give a chemical equation for this reaction.", "confidence": 1.0, "element_id": "e000085", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 85, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(e) Explain why calcium phosphide has a high melting point. You should refer to structure and bonding in your answer.", "confidence": 1.0, "element_id": "e000086", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 86, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 5 = 11 marks)", "confidence": 1.0, "element_id": "e000087", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 87, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "6 Iron metal was discovered several thousand years ago. Iron is produced industrially from iron(III) oxide by extraction using carbon.", "confidence": 1.0, "element_id": "e000088", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 88, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Sodium is a metal in Group 1 of the Periodic Table. Sodium was discovered by Sir Humphrey Davy in 1807. It is produced industrially by the electrolysis of sodium chloride.", "confidence": 1.0, "element_id": "e000089", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 89, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) (i) Explain, using the reactivity series, why carbon can be used to extract iron from iron(III) oxide.", "confidence": 1.0, "element_id": "e000090", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 90, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Suggest why sodium was not discovered until 1807.", "confidence": 1.0, "element_id": "e000091", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 91, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The diagram shows a simplified version of the Downs cell, which can be used to produce sodium industrially. The electrolyte is molten sodium chloride.", "confidence": 1.0, "element_id": "e000092", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 92, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Explain why the molten electrolyte conducts electricity.", "confidence": 1.0, "element_id": "e000094", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 94, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) What is the formula of the cation in the electrolyte?", "confidence": 1.0, "element_id": "e000095", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 95, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A $ \\mathrm{H^{+}} $", "confidence": 1.0, "element_id": "e000096", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 96, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B $ \\mathrm{Cl^{-}} $", "confidence": 1.0, "element_id": "e000097", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 97, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C $ \\mathrm{Na^{+}} $", "confidence": 1.0, "element_id": "e000098", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 98, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D $ \\mathrm{OH^{-}} $", "confidence": 1.0, "element_id": "e000099", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 99, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) During the production of sodium, small explosions can be heard.", "confidence": 1.0, "element_id": "e000100", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 100, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Explain why using sodium chloride that is not completely dry could cause these small explosions.", "confidence": 1.0, "element_id": "e000101", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 101, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iv) Give ionic half-equations for the reactions at the anode and cathode.", "confidence": 1.0, "element_id": "e000102", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 102, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "anode ...", "confidence": 1.0, "element_id": "e000103", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 103, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "cathode", "confidence": 1.0, "element_id": "e000104", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 104, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Explain why the reactivity of metals in Group 1 increases from lithium to potassium.", "confidence": 1.0, "element_id": "e000105", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 105, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 6 = 13 marks)", "confidence": 1.0, "element_id": "e000106", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 106, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000107", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 107, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "7 A student is asked to find the concentration of a solution of nitric acid by doing a titration.", "confidence": 1.0, "element_id": "e000108", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 108, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The student is provided with sodium hydroxide solution with a concentration of $ 0.350\\mathrm{mol/dm}^{3} $", "confidence": 1.0, "element_id": "e000109", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 109, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "These are the first four steps in the student''s method.", "confidence": 1.0, "element_id": "e000110", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 110, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "use a pipette to add exactly $ 2 5. 0 \\mathrm{c m}^{3} $ of the nitric acid solution to a conical flask placed on a white tile", "confidence": 1.0, "element_id": "e000111", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 111, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "add a few drops of indicator to the flask", "confidence": 1.0, "element_id": "e000112", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 112, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "use a burette to add sodium hydroxide solution to the flask until the indicator has changed colour", "confidence": 1.0, "element_id": "e000113", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 113, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "record the volume needed for the indicator to change colour", "confidence": 1.0, "element_id": "e000114", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 114, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Give the reason for using the white tile.", "confidence": 1.0, "element_id": "e000115", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 115, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Universal indicator is not a suitable indicator to use in a titration.", "confidence": 1.0, "element_id": "e000116", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 116, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Complete the table to show the name of a suitable indicator and its final colour in this titration.", "confidence": 1.0, "element_id": "e000117", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 117, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) The student wants to obtain an accurate value for the volume of sodium hydroxide solution needed to neutralise the $ 2 5. 0 \\mathrm{c m}^{3} $ of nitric acid.", "confidence": 1.0, "element_id": "e000119", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 119, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Describe all the further steps the student should take.", "confidence": 1.0, "element_id": "e000120", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 120, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) This is a summary of the student''s results.", "confidence": 1.0, "element_id": "e000121", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 121, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "volume of $ \\mathrm{H N O}_{3} $ used $ = 2 5. 0 \\mathrm{c m}^{3} $", "confidence": 1.0, "element_id": "e000122", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 122, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "concentration of NaOH solution = 0.350 mol/dm $ ^{3} $", "confidence": 1.0, "element_id": "e000123", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 123, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "volume of NaOH solution needed for neutralisation $ = 1 8. 8 0 \\mathrm{c m}^{3} $", "confidence": 1.0, "element_id": "e000124", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 124, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The equation for the reaction is", "confidence": 1.0, "element_id": "e000125", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 125, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Calculate the amount, in moles, of NaOH that reacts.", "confidence": 1.0, "element_id": "e000127", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 127, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Determine the amount, in moles, of $ \\mathrm{H N O_{3}} $ that reacts.", "confidence": 1.0, "element_id": "e000129", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 129, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Calculate the concentration, in mol/dm $ ^{3} $ , of the $ \\mathrm{H N O}_{3} $", "confidence": 1.0, "element_id": "e000131", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 131, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000133", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 133, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "8 This question is about reactions involving nitrogen.", "confidence": 1.0, "element_id": "e000134", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 134, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) In a car engine, nitrogen reacts with oxygen to form nitrogen monoxide.", "confidence": 1.0, "element_id": "e000135", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 135, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The equation for the reaction is", "confidence": 1.0, "element_id": "e000136", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 136, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Draw a labelled reaction profile diagram showing $ \\Delta H $ and the activation energy for the reaction.", "confidence": 1.0, "element_id": "e000138", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 138, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) In the Haber process, nitrogen reacts with hydrogen to form ammonia. This equation represents the reaction.", "confidence": 1.0, "element_id": "e000139", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 139, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The table gives values of some bond energies.", "confidence": 1.0, "element_id": "e000141", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 141, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Calculate the total amount of energy, in kJ, needed to break the bonds in the reactants.", "confidence": 1.0, "element_id": "e000143", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 143, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "energy needed=", "confidence": 1.0, "element_id": "e000144", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 144, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Calculate the total amount of energy, in kJ, released in forming the bonds in the product.", "confidence": 1.0, "element_id": "e000145", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 145, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Calculate the enthalpy change, $ \\Delta H $ , for the reaction.", "confidence": 1.0, "element_id": "e000146", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 146, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "You should include a sign in your answer.", "confidence": 1.0, "element_id": "e000147", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 147, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 8 = 8 marks)", "confidence": 1.0, "element_id": "e000149", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 149, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "TOTAL FOR PAPER = 70 MARKS", "confidence": 1.0, "element_id": "e000150", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 150, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000151", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 151, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000152", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 152, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000153", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 153, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "schemaVersion": "1.0"}', NULL, '2026-09-13 13:03:38.264924+00');
