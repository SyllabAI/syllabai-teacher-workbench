INSERT INTO public.question_versions VALUES ('ecde1821-0a39-40ac-a2f2-761dd196c383', 'a4d134c8-b530-47ec-8852-c199f5206af6', 1, 'The thermite reaction is used on railways to produce molten iron for joining rails together. The diagram shows how this is done. The equation for this thermite reaction is $2 \mathrm {A l} + \mathrm {F e} _ {2} \mathrm {O} _ {3} \rightarrow \mathrm {A l} _ {2} \mathrm {O} _ {3} + 2 \mathrm {F e}$', 5, 3, 450, NULL, 'SUGGESTED', '7a337178-d58f-5b51-8355-63df0327ca7c', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:08.920487+00');
INSERT INTO public.question_versions VALUES ('4ac5844b-5515-4c51-b260-700048029dc9', '6902788f-9cd3-47f6-a654-94722d42e9c5', 1, '(a) Ethanol can be manufactured by two different processes. Process 1 sucrose $ \xrightarrow[]{stage1} $ glucose $ \xrightarrow[]{stage2} $ ethanol Process 2 ethene $ \longrightarrow $ ethanol (i) What is the general name for compounds such as sucrose and glucose? (ii) What type of reaction occurs in stage 2? (iii) What is the catalyst used in stage 2? (iv) What type of reaction occurs in process 2?', 14, 3, 1260, NULL, 'SUGGESTED', '7a337178-d58f-5b51-8355-63df0327ca7c', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:08.920955+00');
