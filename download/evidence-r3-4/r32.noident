INSERT INTO public.question_parts VALUES ('515fe98c-f2c3-4bc4-b7c4-31de8b9fc08c', '28cc5af8-8595-4b15-842d-e528a5cb2c61', 'c', 'The student titrates $ 2 5. 0 \mathrm{c m}^{3} $ of phosphoric acid with a solution of sodium hydroxide (NaOH). Table 1 shows the student''s results. Table 1 Concordant results are those within $ 0. 2 0 \mathrm{c m}^{3} $ of each other.', NULL, 0, 2, '2026-09-13 13:02:53.489325+00');
INSERT INTO public.question_parts VALUES ('426d0a2b-c790-4c2d-8284-1e0b6f7f854e', '28cc5af8-8595-4b15-842d-e528a5cb2c61', 'c-i', 'Add ticks ( $ \surd $ ) to table 1 to show the concordant results.', NULL, 0, 3, '2026-09-13 13:02:53.489371+00');
INSERT INTO public.question_parts VALUES ('8db7a423-5f0a-4eef-9aeb-4063aad92719', '28cc5af8-8595-4b15-842d-e528a5cb2c61', 'c-ii', 'Use your ticked results to calculate the mean (average) volume of NaOH added.', NULL, 0, 4, '2026-09-13 13:02:53.489424+00');
INSERT INTO public.question_parts VALUES ('8fbd0bde-ba0b-4cc8-84dd-4d265dce7f46', '28cc5af8-8595-4b15-842d-e528a5cb2c61', 'd', 'Table 2 shows the titration results of another student. The equation for the reaction is $3 \mathrm {N a O H} + \mathrm {H} _ {3} \mathrm {P O} _ {4} \rightarrow \mathrm {N a} _ {3} \mathrm {P O} _ {4} + 3 \mathrm {H} _ {2} \mathrm {O}$', NULL, 0, 5, '2026-09-13 13:02:53.489483+00');
