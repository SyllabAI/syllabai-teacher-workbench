INSERT INTO public.questions VALUES ('fe374eb5-0a9e-454f-bf1f-002d3367a1e9', 'q09-14c22354', 'STRUCTURED', 'Propane is a hydrocarbon with the formula $ \mathrm{C_{3} H_{8}} $ (a) State why propane is a hydrocarbon.', 12, 3, 1080, NULL, '808245de-72c2-47aa-ae09-dc6ab470ae1d', 'PAST_PAPER', true, 1, '2026-09-13 12:55:23.870425+00', '99ff3ebe-625b-4541-923f-dbfc9dee5c8e');
