INSERT INTO public.question_parts VALUES ('3e9a5e56-3f08-4228-9c82-e12ffb33ee8d', '6ac047eb-80ed-443d-b954-fa43a0bce7c5', 'c-ii', 'An ester has the structural formula $ \mathrm{C H_{3} C H_{2} C O O C H_{3}} $ Which of these is the name of this ester? A ethyl methanoate B methyl ethanoate C methyl propanoate D propyl methanoate', NULL, 0, 6, '2026-09-13 13:02:54.084265+00');
INSERT INTO public.question_parts VALUES ('5a0c8e27-1e97-4b57-8f6f-f75e270ad357', 'fd60cc9c-2d8c-42b3-8306-a959a87e39c0', 'a', 'In stage 1, sulfur is burned in oxygen to form sulfur dioxide gas. $\mathrm {S} (\mathrm {s}) + \mathrm {O} _ {2} (\mathrm {g}) \rightarrow \mathrm {S O} _ {2} (\mathrm {g})$', NULL, 0, 0, '2026-09-13 13:02:54.084305+00');
INSERT INTO public.question_parts VALUES ('6b8258fb-bde4-4301-8cd6-d7b512038941', 'fd60cc9c-2d8c-42b3-8306-a959a87e39c0', 'a-i', 'State one environmental problem caused by the release of sulfur dioxide into the atmosphere.', NULL, 0, 1, '2026-09-13 13:02:54.08433+00');
INSERT INTO public.question_parts VALUES ('c1ebd1d2-2096-4aac-ae41-072c7f295742', 'fd60cc9c-2d8c-42b3-8306-a959a87e39c0', 'a-ii', 'A mass of 6.4 tonnes of sulfur is burned to produce sulfur dioxide gas. Calculate the maximum volume, in $ \mathrm{d m}^{3} $ , of sulfur dioxide gas that can be produced at rtp. [molar volume of sulfur dioxide gas at rtp=24 dm $ ^{3} $] [1 tonne=10 $ ^{6} $ g] Give your answer in standard form.', NULL, 0, 2, '2026-09-13 13:02:54.08435+00');
INSERT INTO public.question_parts VALUES ('c59239f1-44b3-442a-8178-013091f57b9b', 'fd60cc9c-2d8c-42b3-8306-a959a87e39c0', 'b', 'In stage 2, sulfur dioxide is reacted with oxygen to form sulfur trioxide gas. $2 \mathrm {S O} _ {2} (\mathrm {g}) + \mathrm {O} _ {2} (\mathrm {g}) \rightleftharpoons 2 \mathrm {S O} _ {3} (\mathrm {g})$ The yield of sulfur trioxide is approximately 98%.', NULL, 0, 3, '2026-09-13 13:02:54.084364+00');
INSERT INTO public.question_parts VALUES ('780cc8a6-373b-479b-93ef-5243dd7b0ea5', 'fd60cc9c-2d8c-42b3-8306-a959a87e39c0', 'b-i', 'A catalyst is used in this reaction. Explain how a catalyst increases the rate of a reaction.', NULL, 0, 4, '2026-09-13 13:02:54.084379+00');
INSERT INTO public.question_parts VALUES ('bdc592da-4410-484a-b9ae-de6e6120efbb', 'fd60cc9c-2d8c-42b3-8306-a959a87e39c0', 'b-ii', 'The temperature is kept constant. Give a reason why increasing the pressure would increase the yield of sulfur trioxide.', NULL, 0, 5, '2026-09-13 13:02:54.084395+00');
