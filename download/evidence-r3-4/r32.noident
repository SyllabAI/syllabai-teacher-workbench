INSERT INTO public.question_versions VALUES ('afaf5832-b773-4147-9079-8ee0fdb7194a', '63f3bbe3-9fc4-43fa-b983-5aaddf9644c9', 1, 'Titanium is a metal that can be extracted from its ore in a three-stage process. stage 1 titanium ore is converted into titanium dioxide, $ \mathrm{T i O}_{2} $ stage 2 titanium dioxide is then converted into titanium chloride, $ \mathrm{T i C l}_{4} $ stage 3 titanium chloride is converted into titanium, Ti', 12, 3, 1080, NULL, 'SUGGESTED', 'f4948ec0-cbe0-5f7e-982e-278246156fda', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:11.817882+00');
INSERT INTO public.question_versions VALUES ('52f86b57-5991-4181-a710-9d69ca9a075b', '0801a54b-5933-438b-a13b-5f7f39d843cb', 1, 'iodine reacts with chlorine to form iodine monochloride, ICI', 5, 3, 450, NULL, 'SUGGESTED', 'f4948ec0-cbe0-5f7e-982e-278246156fda', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:11.818052+00');
INSERT INTO public.question_versions VALUES ('7e1ca4b2-28dd-4dae-b5e5-0bbb3d22a006', '1b7e80eb-df32-47f4-b28f-005b1b48dc51', 1, 'Potassium hydrogencarbonate （ $ \mathrm{KHCO}_{3} $ ）decomposes on heating. Three possible equations for the decomposition are $\mathrm {e q u a t i o n 1} \quad 2 \mathrm {K H C O} _ {3} (\mathrm {s}) \rightarrow \mathrm {K} _ {2} \mathrm {O} (\mathrm {s}) + 2 \mathrm {C O} _ {2} (\mathrm {g}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {g})$ equation 2 $ \mathrm{K H C O}_{3} ( \mathrm{s} ) \rightarrow \mathrm{K O H} ( \mathrm{s} )+\mathrm{C O}_{2} ( \mathrm{g} ) $ $\mathrm {e q u a t i o n 3} \quad 2 \mathrm {K H C O} _ {3} (\mathrm {s}) \rightarrow \mathrm {K} _ {2} \mathrm {C O} _ {3} (\mathrm {s}) + \mathrm {C O} _ {2} (\mathrm {g}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {g})$ When 8.00 g of potassium hydrogencarbonate is heated until it is fully decomposed, 5.52 g of solid is formed.', 4, 3, 360, NULL, 'SUGGESTED', 'f4948ec0-cbe0-5f7e-982e-278246156fda', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:11.818257+00');
INSERT INTO public.question_versions VALUES ('ac662adb-e649-4bce-a616-b2f66ce82c19', '9f6f1c90-4fab-44a0-9ecf-9d12bd013929', 1, 'Butane $ \left( \mathrm{C}_{4} \mathrm{H}_{1 0} \right) $ is a gas at room temperature and pressure. The equation for the complete combustion of butane is $C _ {4} H _ {1 0} (g) + 6 \frac {1}{2} O _ {2} (g) \rightarrow 4 C O _ {2} (g) + 5 H _ {2} O (l)$ Butane is used in an experiment to determine its $ \Delta H $ of combustion.', 8, 3, 720, NULL, 'SUGGESTED', 'f4948ec0-cbe0-5f7e-982e-278246156fda', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:11.818428+00');
INSERT INTO public.question_versions VALUES ('dd261341-5d35-49e4-917c-d96e48267a1c', 'c81f1e00-6cb3-415b-a1b4-c1b387c6d801', 1, 'The diagram shows the apparatus used to investigate the rate of reaction between calcium carbonate and an excess of dilute hydrochloric acid. The mass of the flask and contents is measured at regular time intervals. The graph shows the results obtained.', 7, 3, 630, NULL, 'SUGGESTED', 'f4948ec0-cbe0-5f7e-982e-278246156fda', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:11.81862+00');
