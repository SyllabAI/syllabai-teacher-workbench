INSERT INTO public.question_parts VALUES ('9867a12a-edf8-4932-bff2-2ca19c8ed212', '76a3ef70-9e08-466c-961d-c90d14110a2c', 'b', 'Table 2 shows the colours of four metals and the colours of their metal sulfate solutions. Table 2 When a metal is added to a metal sulfate solution there may be a colour change on the surface of the metal and in the solution. Use the information in Table 2 and your knowledge of the reactivity series to explain any colour changes in these two experiments. copper added to magnesium sulfate solution. zinc added to iron sulfate solution.', NULL, 0, 3, '2026-09-13 12:56:09.515623+00');
INSERT INTO public.question_parts VALUES ('def75171-0d97-4da4-9efc-329ec3048f38', '76a3ef70-9e08-466c-961d-c90d14110a2c', 'c', 'A different experiment can be used to place metals in order of reactivity. This is the method. Step 1 add 1 g of a metal to $ 2 5 \mathrm{c m}^{3} $ of dilute sulfuric acid Step 2 measure the volume of gas produced in one minute', NULL, 0, 4, '2026-09-13 12:56:09.515709+00');
INSERT INTO public.question_parts VALUES ('160e39d0-d879-4946-94b9-d8603433bf8d', '76a3ef70-9e08-466c-961d-c90d14110a2c', 'c-i', 'Give two variables that should be controlled in this experiment.', NULL, 0, 5, '2026-09-13 12:56:09.515753+00');
INSERT INTO public.question_parts VALUES ('e05a050f-9f56-4515-9ecf-bb6f881d93fd', '76a3ef70-9e08-466c-961d-c90d14110a2c', 'c-ii', 'A small piece of calcium is added to some dilute sulfuric acid in a beaker. One of the products of the reaction, calcium sulfate, is insoluble in water. Suggest why the reaction stops after a short time, even though the beaker still contains calcium and dilute sulfuric acid.', NULL, 0, 6, '2026-09-13 12:56:09.515793+00');
INSERT INTO public.question_parts VALUES ('ca62bbc1-79d5-4332-a886-a8d2b00a86e7', '76a3ef70-9e08-466c-961d-c90d14110a2c', 'd', '1.00 g of aluminium is added to 0.0600 mol of dilute sulfuric acid. The equation for the reaction is $2 \mathrm {A l} (\mathrm {s}) + 3 \mathrm {H} _ {2} \mathrm {S O} _ {4} (\mathrm {a q}) \rightarrow \mathrm {A l} _ {2} \left(\mathrm {S O} _ {4}\right) _ {3} (\mathrm {a q}) + 3 \mathrm {H} _ {2} (\mathrm {g})$ Show by calculation that the sulfuric acid is in excess. $\text{Total for Question 11 = 12 marks)}$', NULL, 0, 7, '2026-09-13 12:56:09.515829+00');
INSERT INTO public.question_parts VALUES ('3cc3c00c-7471-4792-9f90-0083ac352f77', '7ec04404-38e8-4f8e-ad46-32e3acdbec05', 'a', 'The box gives some methods used to separate mixtures. chromatography crystallisation fractional distillation simple distillation Choose methods from the box to answer the following questions. Each method may be used once, more than once or not at all.', NULL, 0, 0, '2026-09-13 12:56:09.821626+00');
