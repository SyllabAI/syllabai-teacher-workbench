INSERT INTO public.question_parts VALUES ('15346c6b-c371-4feb-b157-5ad94534df77', '66fc9e8e-f943-42ea-939b-ecccefe820ff', 'b-iii', 'State the meaning of the term exothermic.', NULL, 0, 4, '2026-09-13 12:54:40.215824+00');
