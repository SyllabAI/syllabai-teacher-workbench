INSERT INTO public.question_parts VALUES ('7faff586-8fe9-4309-8e45-1ceb9488b71e', '5f77af34-6181-400c-a251-dab415310d81', 'd', 'Propane can be produced by cracking. An equation for cracking is $\mathrm {C} _ {1 3} \mathrm {H} _ {2 8} \rightarrow \mathrm {C} _ {3} \mathrm {H} _ {8} + 2 \mathrm {C} _ {3} \mathrm {H} _ {6} + 2 \mathrm {C} _ {2} \mathrm {H} _ {4}$ Explain why cracking is an important process in the oil industry.', NULL, 0, 3, '2026-09-13 12:55:23.885387+00');
INSERT INTO public.question_parts VALUES ('3518b684-3077-4130-92c5-92857739ea6c', '5f77af34-6181-400c-a251-dab415310d81', 'e', 'Propane reacts with bromine in the presence of ultraviolet radiation.', NULL, 0, 4, '2026-09-13 12:55:23.885414+00');
INSERT INTO public.question_parts VALUES ('035d4c38-28dd-422a-bfed-e9a0c9ba724f', '5f77af34-6181-400c-a251-dab415310d81', 'e-i', 'Complete the equation for this reaction. $\mathrm {C} _ {3} \mathrm {H} _ {8} + \mathrm {B r} _ {2} \rightarrow$', NULL, 0, 5, '2026-09-13 12:55:23.885438+00');
INSERT INTO public.question_parts VALUES ('165b9202-d214-433b-97c6-833a4bb40aae', '5f77af34-6181-400c-a251-dab415310d81', 'e-ii', 'Give the name of this type of reaction.', NULL, 0, 6, '2026-09-13 12:55:23.885465+00');
INSERT INTO public.question_parts VALUES ('64739a89-b6bd-4d95-9cc0-c6e5015d2b9a', '92a0e892-2ae3-4f1d-9013-dde9895a4f17', 'b', 'Some iron objects are coated with a layer of zinc to prevent rusting.', NULL, 0, 4, '2026-09-13 12:56:09.824757+00');
