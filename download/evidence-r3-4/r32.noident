INSERT INTO public.question_parts VALUES ('9cdc5a8e-2738-45ba-b8c2-f6d66c2fa9b0', 'ca276482-b38b-4c33-b7b9-4ec8f3aa78bb', 'd-ii', 'Explain, using the particle collision theory, how increasing the temperature would affect the rate of this reaction.', NULL, 0, 7, '2026-09-13 12:54:40.215677+00');
INSERT INTO public.question_parts VALUES ('5f9edad5-bc5f-461d-a1df-b5fa3b17b196', '66fc9e8e-f943-42ea-939b-ecccefe820ff', 'a', 'Chloroethene has the percentage composition by mass $C = 38.4 \% H = 4.8 \% C I = 56.8 \%$ Show, by calculation, that the empirical formula of chloroethene is $ \mathrm{C_{2} H_{3} C l} $', NULL, 0, 0, '2026-09-13 12:54:40.215723+00');
INSERT INTO public.question_parts VALUES ('a3411a88-0f1a-4a36-a4c3-999a3fd30b18', '66fc9e8e-f943-42ea-939b-ecccefe820ff', 'b', 'The molecular formula of chloroethene is also $ \mathrm{C_{2} H_{3} C l} $ Chloroethene can be prepared by a two-stage process. In stage 1, ethene reacts with chlorine in the presence of an iron(III) chloride catalyst to form dichloroethane. The reaction is exothermic. $\mathrm {C} _ {2} \mathrm {H} _ {4} + \mathrm {C l} _ {2} \rightarrow \mathrm {C} _ {2} \mathrm {H} _ {4} \mathrm {C l} _ {2}$', NULL, 0, 1, '2026-09-13 12:54:40.215748+00');
INSERT INTO public.question_parts VALUES ('b88f10c4-4be2-4766-ba5a-f05896500cc6', '66fc9e8e-f943-42ea-939b-ecccefe820ff', 'b-i', 'Give the formula of iron(III) chloride.', NULL, 0, 2, '2026-09-13 12:54:40.215768+00');
