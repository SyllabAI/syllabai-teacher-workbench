INSERT INTO public.question_parts VALUES ('91c0ff3c-0d33-4686-ac11-5f9943ea08ae', 'a870d3cb-8b08-4eb2-8056-651c897e9560', 'c-ii', 'Calculate the amount, in moles, of LiOH in the $ 2 2. 8 5 \mathrm{c m}^{3} $ of lithium hydroxide solution. $\mathrm {a m o u n t o f L i O H} =$', NULL, 0, 6, '2026-09-13 12:59:09.568164+00');
INSERT INTO public.question_parts VALUES ('0117d201-7015-4dfe-9663-2c51fa941067', 'a870d3cb-8b08-4eb2-8056-651c897e9560', 'c-iii', 'Calculate the concentration, in mol/dm $ ^{3} $ , of LiOH in the lithium hydroxide solution. $\mathrm {c o n c e n t r a t i o n o f L i O H} =$', NULL, 0, 7, '2026-09-13 12:59:09.568204+00');
INSERT INTO public.question_parts VALUES ('dff4cd14-8a1e-4d92-ace5-9d7092d13cae', 'a870d3cb-8b08-4eb2-8056-651c897e9560', 'd', 'To prepare the solution of lithium sulfate, the student mixes together the volumes of acid and alkali obtained from the titration results. She then tests a sample of the lithium sulfate solution formed by adding a few drops of barium chloride solution.', NULL, 0, 8, '2026-09-13 12:59:09.568244+00');
