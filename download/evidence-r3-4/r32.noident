INSERT INTO public.question_versions VALUES ('b31ae021-afbf-4b00-9336-b77670e56cea', '32f52062-c899-48fd-b690-4f62e48aff81', 1, 'Chromium is a shiny metal that has many uses. Most chromium is extracted from the ore chromite, $ \mathrm{F e C r_{2} O_{4}} $', 12, 3, 1080, NULL, 'SUGGESTED', 'b705ec20-4702-5901-b487-ea523791dec6', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:56.757525+00');
INSERT INTO public.question_versions VALUES ('c093f2f3-e89f-4010-9310-18b45e33c1e0', 'c908a85a-c860-4fff-8912-a787af7cf8ea', 1, 'Lithium fluoride, LiF, and magnesium oxide, MgO, are ionic compounds.', 8, 3, 720, NULL, 'SUGGESTED', 'b705ec20-4702-5901-b487-ea523791dec6', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:56.757865+00');
