INSERT INTO public.questions VALUES ('0e9c9862-5ab3-427d-90ca-944d682527f9', 'q01-a6e3bced', 'STRUCTURED', 'This question is about acids, alkalis and indicators.', 7, 3, 630, NULL, '8fe08646-c263-451f-ab4d-58527ff8c2f7', 'PAST_PAPER', true, 1, '2026-09-13 12:56:10.077881+00', 'd18aa783-f86e-4c45-a20e-041e19b4835b');
INSERT INTO public.questions VALUES ('e8b82131-07ac-41c8-93dc-d1ec906b2025', 'q10-25ccf10d', 'STRUCTURED', 'Sodium thiosulfate solution and dilute hydrochloric acid react together slowly to form a precipitate of sulfur. This precipitate eventually makes the mixture go cloudy. place 20 $ cm^{3} $ of sodium thiosulfate solution and $ 20 cm^{3} $ of water in a conical flask add 10 $ cm^{3} $ of dilute hydrochloric acid to the flask place the flask on a piece of paper marked with a black X time how long it takes before the X can no longer be seen A student uses this method.', 15, 3, 1350, NULL, '42b8db1a-b341-41d1-a8b4-d57a8b7ec131', 'PAST_PAPER', true, 1, '2026-09-13 12:53:12.061975+00', 'deb67747-807b-4b4a-b1e8-ab33de7b8960');
INSERT INTO public.questions VALUES ('dbd07b1f-e243-4365-a520-eb1a736674d3', 'q11-25ccf10d', 'STRUCTURED', 'The flow diagram shows how a fertiliser is manufactured from raw materials. The hydrogen needed is formed in two reactions.', 1, 3, 90, NULL, '42b8db1a-b341-41d1-a8b4-d57a8b7ec131', 'PAST_PAPER', true, 1, '2026-09-13 12:53:12.062113+00', 'deb67747-807b-4b4a-b1e8-ab33de7b8960');
INSERT INTO public.questions VALUES ('77c12c46-ea39-4cf5-b3c5-64b54c0f3a4e', 'q12-25ccf10d', 'STRUCTURED', 'The production of polymers from crude oil involves several processes, including fractional distillation cracking purification polymerisation', 13, 3, 1170, NULL, '42b8db1a-b341-41d1-a8b4-d57a8b7ec131', 'PAST_PAPER', true, 1, '2026-09-13 12:53:12.062261+00', 'deb67747-807b-4b4a-b1e8-ab33de7b8960');
INSERT INTO public.questions VALUES ('de8424da-6253-48fc-bf10-170009743389', 'q05-e6282607', 'STRUCTURED', 'A student tries to make a pure, dry sample of hydrated cobalt(II) chloride crystals. He uses dilute hydrochloric acid and solid cobalt(II) oxide. This is the student''s method. Step 1 pour about $ 5 0 \mathrm{c m}^{3} $ of dilute hydrochloric acid into a beaker Step 2 warm the acid using a Bunsen burner Step 3 add a small amount of cobalt(II) oxide and stir the mixture with a glass rod Step 4 add further small amounts of cobalt(II) oxide until it stops reacting Step 5 filter the final mixture and collect the filtrate in an evaporating basin Step 6 leave the filtrate until all of the water has evaporated His sample of cobalt(II) oxide contains a small amount of a solid impurity that dissolves in water, but does not react with the acid.', 12, 3, 1080, NULL, 'b898d07f-7b4e-45c7-b845-f801183fcb5b', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.584118+00', '4a4f3085-fab1-4815-8f67-8be0556e0fe5');
INSERT INTO public.questions VALUES ('1cf6381f-4499-44ba-96d3-72b141332936', 'q06-e6282607', 'STRUCTURED', 'Tests are done on a sample of a solid, X. Solid X contains the ammonium ion, $ \mathrm{N H_{4}^{+}} $ , one other cation and one anion. The table lists details of the tests done on solid X and the observations made for each test.', 5, 3, 450, NULL, 'b898d07f-7b4e-45c7-b845-f801183fcb5b', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.584322+00', '4a4f3085-fab1-4815-8f67-8be0556e0fe5');
INSERT INTO public.questions VALUES ('e6b0bafb-d929-4caa-81c2-d92630ae0c25', 'q07-e6282607', 'STRUCTURED', 'Antimony, Sb, is an element in Group 5 of the Periodic Table. The mineral, stibnite, contains antimony sulfide, $ \mathrm{S b_{2} S_{3}} $ Antimony can be obtained from stibnite in a two-stage process. Stage 1 stibnite is roasted in air $\mathrm {S b} _ {2} \mathrm {S} _ {3} + 5 \mathrm {O} _ {2} \rightarrow \mathrm {S b} _ {2} \mathrm {O} _ {4} + 3 \mathrm {S O} _ {2}$ Stage 2 the oxide produced is heated with carbon to form antimony and carbon dioxide (a) (i) State why the sulfur in stage 1 is said to be oxidised. (ii) Complete the equation for the reaction in stage 2. $\mathrm {S b} _ {2} \mathrm {O} _ {4} + \dots \dots \dots \mathrm {C} \rightarrow \dots \dots \dots \mathrm {S b} + \dots \dots \dots \mathrm {C O} _ {2}$', 7, 3, 630, NULL, 'b898d07f-7b4e-45c7-b845-f801183fcb5b', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.5845+00', '4a4f3085-fab1-4815-8f67-8be0556e0fe5');
INSERT INTO public.questions VALUES ('bee8a99d-6e1b-49a3-b387-3babab69de21', 'q08-e6282607', 'STRUCTURED', 'A student investigates the rate of reaction between zinc and hydrochloric acid, using an excess of zinc powder. She uses this apparatus. The student measures the volume of gas in the syringe every minute for ten minutes. The table shows her results.', 11, 3, 990, NULL, 'b898d07f-7b4e-45c7-b845-f801183fcb5b', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.584719+00', '4a4f3085-fab1-4815-8f67-8be0556e0fe5');
INSERT INTO public.questions VALUES ('77cdc0e3-9d43-4d5f-8ddc-65252e3e9021', 'q10-e6282607', 'STRUCTURED', 'Bromine is a red-brown liquid at room temperature. Liquid bromine forms a brown gas when warmed.', 8, 3, 720, NULL, 'b898d07f-7b4e-45c7-b845-f801183fcb5b', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.585126+00', '4a4f3085-fab1-4815-8f67-8be0556e0fe5');
INSERT INTO public.questions VALUES ('c76d5f3b-c615-4e83-8c91-dd1f58dcf224', 'q11-e6282607', 'STRUCTURED', 'Malachite is an ore of copper containing copper(II) carbonate and several other compounds that are insoluble in water. You are supplied with several pieces of malachite, these chemicals and items of apparatus. Chemicals: dilute sulfuric acid magnesium powder Apparatus: beakers filter funnel and paper pestle and mortar Describe how you would use the chemicals and the apparatus to obtain a sample of copper from the malachite.', 6, 3, 540, NULL, 'b898d07f-7b4e-45c7-b845-f801183fcb5b', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.585315+00', '4a4f3085-fab1-4815-8f67-8be0556e0fe5');
INSERT INTO public.questions VALUES ('11a8b2a8-bdeb-4542-b068-8ce3ed7b2c84', 'q12-e6282607', 'STRUCTURED', 'Crude oil is a mixture of hydrocarbons. Fractional distillation of crude oil and cracking of hydrocarbon fractions are two of the processes used in an oil refinery.', 1, 3, 90, NULL, 'b898d07f-7b4e-45c7-b845-f801183fcb5b', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.585517+00', '4a4f3085-fab1-4815-8f67-8be0556e0fe5');
INSERT INTO public.questions VALUES ('96d00202-e9e5-45d3-a564-0db33b8dace7', 'q13-e6282607', 'STRUCTURED', 'A student investigates the reaction between zinc and dilute sulfuric acid. She uses this method. put $ 5 0 \mathrm{c m}^{3} $ of dilute sulfuric acid into a polystyrene cup measure the initial temperature of the acid add 2.0g of zinc to the acid and stir the mixture measure the temperature of the mixture after one minute The student does the experiment three times. For each experiment, she uses the same size pieces of zinc but different concentrations of sulfuric acid. The diagram shows the temperatures for each experiment. Experiment 1 1. 0 mol/dm $ ^{3} $ $ \mathrm{H_{2} S O_{4}} $ temperature after one minute Experiment 3', 10, 3, 900, NULL, 'b898d07f-7b4e-45c7-b845-f801183fcb5b', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.585758+00', '4a4f3085-fab1-4815-8f67-8be0556e0fe5');
INSERT INTO public.questions VALUES ('472ece6c-00f5-4478-a8df-eedbada0c81f', 'q14-e6282607', 'STRUCTURED', 'Iron deficiency anaemia occurs when the body does not have enough iron(II) ions. Iron deficiency can be overcome by taking iron tablets. weigh an iron tablet dissolve the tablet in an excess of dilute sulfuric acid titrate the solution with potassium permanganate solution, $ \mathrm{K M n O}_{4} $ The table shows her results. A chemist wants to find out the percentage of iron(II) ion $ \mathrm{(F e^{2+})} $ in an iron tablet. She uses this method.', 5, 3, 450, NULL, 'b898d07f-7b4e-45c7-b845-f801183fcb5b', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.585977+00', '4a4f3085-fab1-4815-8f67-8be0556e0fe5');
INSERT INTO public.questions VALUES ('9607d2fa-0ccd-4385-8234-50b5b045dc7b', 'q15-e6282607', 'STRUCTURED', 'A teacher uses this apparatus to demonstrate the electrolysis of molten zinc chloride. crystals of a shiny, grey solid form at one of the electrodes a pale green substance forms at the other electrode the lamp goes out after the teacher stops heating the zinc chloride A student records these observations.', 8, 3, 720, NULL, 'b898d07f-7b4e-45c7-b845-f801183fcb5b', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.586164+00', '4a4f3085-fab1-4815-8f67-8be0556e0fe5');
