INSERT INTO public.document_chunks VALUES ('ae5696f3-bd02-445e-991b-ff3b15ae4ef0', '26fab0d6-60dc-4c23-88c5-7a18e3885cad', 5, '| Cu2+ | Fe2+ | Fe3+
