INSERT INTO public.question_parts VALUES ('eb2ff1fb-eb2e-45fb-a20c-cb6556df7473', '8a4e375c-0319-44b6-86fe-1364e6d79b35', 'c-iii', 'In the reaction between calcium and chlorine, both oxidation and reduction occur. Which row shows the element that is oxidised and the element that acts as the reducing agent in this reaction?', NULL, 0, 5, '2026-09-13 12:59:09.567221+00');
INSERT INTO public.question_parts VALUES ('860bfc32-9d6a-414d-a3de-c1c36004b360', '8a4e375c-0319-44b6-86fe-1364e6d79b35', 'd', 'A student uses a flame test to distinguish between separate samples of calcium chloride and potassium chloride. This is the student''s method. There is one mistake in step 1 and one mistake in step 3. step 1 dip a platinum wire into some concentrated sodium hydroxide solution step 2 dip the platinum wire into the sample step 3 place the wire and sample into a luminous Bunsen flame step 4 record the colour of the flame Describe a correct method for step 1 and step 3. step 1. step 3.', NULL, 0, 6, '2026-09-13 12:59:09.56725+00');
