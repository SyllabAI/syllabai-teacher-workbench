INSERT INTO public.question_versions VALUES ('69c89ff7-17a6-4ead-943c-637ba3fb3417', '5d4af283-4a3b-4784-8e7b-8204ffc6c833', 1, 'A student investigates the pigments found in some vegetables and fruit. She obtains some coloured vegetable and fruit extracts from carrots, tomatoes and sweet potatoes. She places a spot of each extract on chromatography paper, along with spots of the three pigments beta-carotene, chlorophyll and lycopene. Her teacher provides a solvent containing volatile, flammable organic compounds for the experiment. The diagram shows the apparatus at the start of the experiment. Key to vegetable and fruit extracts and pigments $V 1 = c a r r o t s V 2 = t o m a t o e s V 3 = s w e e t p o t a t o e s$ $\mathrm {P 1} = \mathrm {b e t a - c a r o t e n e} \quad \mathrm {P 2} = \mathrm {c h l o r o p h y l l} \quad \mathrm {P 3} = \mathrm {l y c o p e n e}$', 9, 3, 810, NULL, 'SUGGESTED', '25ccf10d-e7da-5f97-b268-57aa9afca8e0', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:12.061256+00');
