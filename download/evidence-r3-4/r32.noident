INSERT INTO public.question_parts VALUES ('0cc0590b-6855-4735-9e29-487924be1298', '6ec38c59-db30-4d51-ab39-6fa5e92ab366', 'c-vi', 'The ionic equation for another reaction is $\mathrm {B r} _ {2} + 2 \mathrm {I} ^ {-} \rightarrow 2 \mathrm {B r} ^ {-} + \mathrm {I} _ {2}$ Explain which species is oxidised in this reaction.', NULL, 0, 8, '2026-09-13 12:59:09.400577+00');
INSERT INTO public.question_parts VALUES ('d08620a4-295f-4e9d-83db-d2446c86aad9', '66902fe7-0fe2-4fd7-a3b3-7967670ecc5d', 'a', 'Two conditions used in reaction 1 are a temperature of about 30 $ ^{\circ} \mathrm{C} $ the use of water as a solvent for the glucose State the name of the catalyst used in this reaction.', NULL, 0, 0, '2026-09-13 12:59:09.400622+00');
INSERT INTO public.question_parts VALUES ('d59bdb1e-49a6-40dc-9bc8-088d950d0f45', '66902fe7-0fe2-4fd7-a3b3-7967670ecc5d', 'a-ii', 'Complete the equation for reaction 1. $\mathrm {C} _ {6} \mathrm {H} _ {1 2} \mathrm {O} _ {6} \rightarrow 2 \mathrm {C} _ {2} \mathrm {H} _ {5} \mathrm {O H} + \dots \dots$', NULL, 0, 1, '2026-09-13 12:59:09.400671+00');
INSERT INTO public.question_parts VALUES ('7c46a2a5-90ed-4853-a344-5aa309d84939', '66902fe7-0fe2-4fd7-a3b3-7967670ecc5d', 'b', 'Ethanol can also be manufactured by reaction 3, which uses steam, a catalyst of phosphoric acid and a pressure of about 65 atm. State the temperature used in reaction 3.', NULL, 0, 2, '2026-09-13 12:59:09.400736+00');
