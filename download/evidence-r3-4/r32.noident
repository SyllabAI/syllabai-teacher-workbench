INSERT INTO public.questions VALUES ('af6e38b6-c4d8-4fab-a3b8-cfc87173e54b', 'q03-1ed33ec4', 'STRUCTURED', 'The Group 7 elements are called halogens. Halogens form compounds called halides. Three of the halogens are represented by the formulae $ X_{2}, Y_{2} $ and $ Z_{2} $ Solutions of these halogens are added separately to solutions of sodium halides, NaX, NaY and NaZ. The table shows whether or not a reaction occurs.', 9, 3, 810, NULL, 'c3696011-542c-426d-afb5-9f285d5adbd6', 'PAST_PAPER', true, 1, '2026-09-13 12:54:40.592071+00', 'd4f753da-c2cc-47f2-a5f5-657f1ce18801');
INSERT INTO public.questions VALUES ('a315a77b-c1fa-44f6-986a-e740a26bf1f6', 'q05-1ed33ec4', 'STRUCTURED', 'A teacher uses the reaction between phosphorus and oxygen to calculate the percentage of oxygen in air. She uses this apparatus and excess phosphorus. The volume of gas in the tube decreases as the phosphorus reacts with oxygen. The teacher measures the volume of gas in the tube at one-minute intervals. The table shows the teacher''s results.', 1, 3, 90, NULL, 'c3696011-542c-426d-afb5-9f285d5adbd6', 'PAST_PAPER', true, 1, '2026-09-13 12:54:40.596606+00', 'd4f753da-c2cc-47f2-a5f5-657f1ce18801');
INSERT INTO public.questions VALUES ('03527fe8-1f11-4863-84e6-785ff9e42d83', 'q06-1ed33ec4', 'STRUCTURED', 'The reaction between magnesium and copper(II) sulfate solution is exothermic. This apparatus is used to measure the temperature increase when excess magnesium is added to $ 1 0 0 \mathrm{c m}^{3} $ of copper(II) sulfate solution.', 12, 3, 1080, NULL, 'c3696011-542c-426d-afb5-9f285d5adbd6', 'PAST_PAPER', true, 1, '2026-09-13 12:54:40.597303+00', 'd4f753da-c2cc-47f2-a5f5-657f1ce18801');
INSERT INTO public.questions VALUES ('e642c9fe-a2bf-43f1-84b6-42be23c2e54b', 'q07-1ed33ec4', 'STRUCTURED', 'A student investigates the reaction between sodium hydroxide solution and hydrochloric acid. He uses this method. Step 1 add $ 5 0 \mathrm{c m}^{3} $ of dilute hydrochloric acid to a conical flask Step 2 add a $ 5 \mathrm{c m}^{3} $ portion of sodium hydroxide solution to the conical flask Step 3 test the pH of the mixture using both universal indicator paper and a pH meter The student repeats step 2 and step 3 until a total of $ 5 0 \mathrm{c m}^{3} $ of sodium hydroxide solution has been added.', 1, 3, 90, NULL, 'c3696011-542c-426d-afb5-9f285d5adbd6', 'PAST_PAPER', true, 1, '2026-09-13 12:54:40.59756+00', 'd4f753da-c2cc-47f2-a5f5-657f1ce18801');
INSERT INTO public.questions VALUES ('1fd4fc45-d70d-4b40-b710-90e407967815', 'q08-1ed33ec4', 'STRUCTURED', '(a) The diagram shows the arrangement of electrons in an atom of calcium and in an atom of chlorine. Describe, in terms of electrons, what happens when calcium reacts with chlorine to form the ionic compound calcium chloride, $ \mathrm{C a C l}_{2} $', 14, 3, 1260, NULL, 'c3696011-542c-426d-afb5-9f285d5adbd6', 'PAST_PAPER', true, 1, '2026-09-13 12:54:40.598925+00', 'd4f753da-c2cc-47f2-a5f5-657f1ce18801');
