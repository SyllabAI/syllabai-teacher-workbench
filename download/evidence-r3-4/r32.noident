INSERT INTO public.document_chunks VALUES ('bed41702-7b0a-4b61-94d2-5cd87ef97fc4', '5b9817b7-9922-4821-a500-5d3cf02d1155', 5, '(ii) A mixture containing 500 mol of glucose is fermented.
