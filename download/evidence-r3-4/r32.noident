INSERT INTO public.document_chunks VALUES ('07ff85a8-48a1-4b33-bc3f-c2c8af316aa3', 'ac8055f3-157b-49a8-987d-93d1e8a76016', 7, 'temperature after adding alkali ... $ ^{\circ} \mathrm{C} $
