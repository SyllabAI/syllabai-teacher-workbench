INSERT INTO public.question_parts VALUES ('770c846a-30f0-4614-9514-637fc00e26a3', '65ef8ad3-ee0b-410d-8a8a-a6959b4ce926', 'b-iii', 'Gas particles travel at high speeds. Give a reason why the white ring of ammonium chloride takes several minutes to form.', NULL, 0, 4, '2026-09-13 12:56:09.826331+00');
INSERT INTO public.question_parts VALUES ('0635805e-04f1-4509-9a91-942ac8cd8d80', '65ef8ad3-ee0b-410d-8a8a-a6959b4ce926', 'b-iv', 'Concentrated ammonia solution and concentrated hydrochloric acid are corrosive. Give one safety precaution the teacher should take.', NULL, 0, 5, '2026-09-13 12:56:09.826355+00');
