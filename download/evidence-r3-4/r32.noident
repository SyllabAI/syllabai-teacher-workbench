INSERT INTO public.question_parts VALUES ('ff1e2746-9471-4994-97aa-26ff42f4cbad', '67ebb0b0-8c38-44ee-b1ff-f3b12ee492a4', 'c-ii', 'The most common method of extracting iron is by the reduction of iron(III) oxide in a blast furnace. The diagram shows a blast furnace. Write a chemical equation to show how carbon monoxide forms in the blast furnace. (1)', NULL, 0, 6, '2026-09-13 12:53:56.169666+00');
