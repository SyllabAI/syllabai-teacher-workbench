, "e000066", "e000067", "e000068", "e000069", "e000070", "e000071", "e000072", "e000073", "e000074", "e000075", "e000076", "e000077", "e000078", "e000079", "e000080", "e000081", "e000083", "e000085", "e000086", "e000087", "e000088", "e000089", "e000090", "e000091", "e000093", "e000094", "e000095", "e000097", "e000098", "e000099", "e000100", "e000101", "e000102", "e000103", "e000104"], "pageNumber": 1}, {"level": 2, "title": "Heat energy change =", "sectionId": "s005", "elementIds": ["e000106", "e000107", "e000109", "e000110", "e000111", "e000112", "e000113", "e000115", "e000117", "e000118", "e000119", "e000120", "e000121", "e000122", "e000123", "e000124", "e000125", "e000126", "e000127", "e000129", "e000130", "e000131", "e000132", "e000133", "e000134", "e000136", "e000138", "e000139", "e000140", "e000141", "e000142", "e000143", "e000145", "e000146", "e000147", "e000148", "e000149", "e000151", "e000152", "e000153", "e000154", "e000155", "e000156"], "pageNumber": 1}], "equations": [{"text": "\\mathrm {c a r b o n d i o x i d e} + \\mathrm {w a t e r} \\rightarrow \\mathrm {c a r b o n i c a c i d}", "latex": "\\mathrm {c a r b o n d i o x i d e} + \\mathrm {w a t e r} \\rightarrow \\mathrm {c a r b o n i c a c i d}", "confidence": 1.0, "element_id": "e000035", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 35, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "2 \\mathrm {A l} _ {2} \\mathrm {O} _ {3} \\rightarrow 4 \\mathrm {A l} + 3 \\mathrm {O} _ {2}", "latex": "2 \\mathrm {A l} _ {2} \\mathrm {O} _ {3} \\rightarrow 4 \\mathrm {A l} + 3 \\mathrm {O} _ {2}", "confidence": 1.0, "element_id": "e000064", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 64, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {A m o u n t} =", "latex": "\\mathrm {A m o u n t} =", "confidence": 1.0, "element_id": "e000108", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 108, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {C} _ {2} \\mathrm {H} _ {4} + \\mathrm {H} _ {2} \\mathrm {O} \\rightarrow \\mathrm {C} _ {2} \\mathrm {H} _ {5} \\mathrm {O H}", "latex": "\\mathrm {C} _ {2} \\mathrm {H} _ {4} + \\mathrm {H} _ {2} \\mathrm {O} \\rightarrow \\mathrm {C} _ {2} \\mathrm {H} _ {5} \\mathrm {O H}", "confidence": 1.0, "element_id": "e000114", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 114, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "C _ {6} H _ {1 2} O _ {6} \\rightarrow 2 C _ {2} H _ {5} O H + 2 C O _ {2}", "latex": "C _ {6} H _ {1 2} O _ {6} \\rightarrow 2 C _ {2} H _ {5} O H + 2 C O _ {2}", "confidence": 1.0, "element_id": "e000116", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 116, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {O H} ^ {-} \\rightarrow \\mathrm {H} _ {2} \\mathrm {O} + \\mathrm {O} _ {2} + \\mathrm {e} ^ {-}", "latex": "\\mathrm {O H} ^ {-} \\rightarrow \\mathrm {H} _ {2} \\mathrm {O} + \\mathrm {O} _ {2} + \\mathrm {e} ^ {-}", "confidence": 1.0, "element_id": "e000135", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 135, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "2 \\mathrm {C l} ^ {-} \\rightarrow \\mathrm {C l} _ {2} + 2 \\mathrm {e} ^ {-}", "latex": "2 \\mathrm {C l} ^ {-} \\rightarrow \\mathrm {C l} _ {2} + 2 \\mathrm {e} ^ {-}", "confidence": 1.0, "element_id": "e000137", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 137, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {C l} _ {2} (\\mathrm {g}) + 2 \\mathrm {B r} ^ {-} (\\mathrm {a q}) \\rightarrow 2 \\mathrm {C l} ^ {-} (\\mathrm {a q}) + \\mathrm {B r} _ {2} (\\mathrm {a q})", "latex": "\\mathrm {C l} _ {2} (\\mathrm {g}) + 2 \\mathrm {B r} ^ {-} (\\mathrm {a q}) \\rightarrow 2 \\mathrm {C l} ^ {-} (\\mathrm {a q}) + \\mathrm {B r} _ {2} (\\mathrm {a q})", "confidence": 1.0, "element_id": "e000144", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 144, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {P C l} _ {3} (\\mathrm {g}) + \\mathrm {C l} _ {2} (\\mathrm {g}) \\rightleftharpoons \\mathrm {P C l} _ {5} (\\mathrm {g}) \\quad \\Delta H = - 1 2 4 \\mathrm {k J / m o l}", "latex": "\\mathrm {P C l} _ {3} (\\mathrm {g}) + \\mathrm {C l} _ {2} (\\mathrm {g}) \\rightleftharpoons \\mathrm {P C l} _ {5} (\\mathrm {g}) \\quad \\Delta H = - 1 2 4 \\mathrm {k J / m o l}", "confidence": 1.0, "element_id": "e000150", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 150, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "pageCount": 1, "documentId": "29fe818b-80ac-54d9-a3b4-2354ce830582", "provenance": {"engine": "glm-ocr-markdown", "application": "syllabai-parser", "extractedAt": "2026-09-13T12:57:22.345339710Z", "engineVersion": "1.1.0", "schemaVersion": "1.0", "extractionParams": {"pageBoundaries": "none-in-source", "sourceLineCount": 208, "upstreamConverter": "zai-glm-ocr", "entityDecodedLines": 0, "signedUrlFigureRefs": 0, "normalizedHtmlEntities": true}}, "textBlocks": [{"role": "heading", "text": "Instructions", "confidence": 1.0, "element_id": "e000001", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 1, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Use black ink or ball-point pen.", "confidence": 1.0, "element_id": "e000002", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 2, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Fill in the boxes at the top of this page with your name, centre number and candidate number.", "confidence": 1.0, "element_id": "e000003", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 3, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer all questions.", "confidence": 1.0, "element_id": "e000004", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 4, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer the questions in the spaces provided", "confidence": 1.0, "element_id": "e000005", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 5, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "there may be more space than you need.", "confidence": 1.0, "element_id": "e000006", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 6, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Show all the steps in any calculations and state the units.", "confidence": 1.0, "element_id": "e000007", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 7, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Information", "confidence": 1.0, "element_id": "e000008", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 8, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The total mark for this paper is 60.", "confidence": 1.0, "element_id": "e000009", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 9, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The marks for each question are shown in brackets", "confidence": 1.0, "element_id": "e000010", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 10, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "use this as a guide as to how much time to spend on each question.", "confidence": 1.0, "element_id": "e000011", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 11, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Advice", "confidence": 1.0, "element_id": "e000012", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 12, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Read each question carefully before you start to answer it.", "confidence": 1.0, "element_id": "e000013", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 13, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Keep an eye on the time.", "confidence": 1.0, "element_id": "e000014", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 14, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Write your answers neatly and in good English.", "confidence": 1.0, "element_id": "e000015", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 15, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Try to answer every question.", "confidence": 1.0, "element_id": "e000016", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 16, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Check your answers if you have time at the end.", "confidence": 1.0, "element_id": "e000017", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 17, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Answer ALL questions.", "confidence": 1.0, "element_id": "e000019", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 19, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "1 Many chemical reactions occur in the atmosphere.", "confidence": 1.0, "element_id": "e000020", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 20, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) The pie chart shows the relative amounts of some gases in air.", "confidence": 1.0, "element_id": "e000021", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 21, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Label the pie chart with the name of the gas that makes up most of the air.", "confidence": 1.0, "element_id": "e000023", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 23, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) What is the approximate percentage of oxygen in air? Place a cross ( $ \\bigcirc $ ) in one box.", "confidence": 1.0, "element_id": "e000024", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 24, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "1", "confidence": 1.0, "element_id": "e000025", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 25, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "20", "confidence": 1.0, "element_id": "e000026", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 26, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "25", "confidence": 1.0, "element_id": "e000027", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 27, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "78", "confidence": 1.0, "element_id": "e000028", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 28, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Use words from the box to complete the sentences about some of the other gases in air.", "confidence": 1.0, "element_id": "e000029", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 29, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Each word may be used once, more than once or not at all.", "confidence": 1.0, "element_id": "e000030", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 30, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "One of the gases in air is argon. It is called a noble gas because it is very ... .", "confidence": 1.0, "element_id": "e000032", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 32, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The percentage of ... vapour in air varies with the weather.", "confidence": 1.0, "element_id": "e000033", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 33, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Rain water is naturally slightly acidic because carbon dioxide dissolves in it. The word equation for the reaction that occurs is:", "confidence": 1.0, "element_id": "e000034", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 34, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Acid rain is more acidic because pollutant gases in the atmosphere also dissolve in water.", "confidence": 1.0, "element_id": "e000036", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 36, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Identify the acid formed when sulfur dioxide reacts with water.", "confidence": 1.0, "element_id": "e000037", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 37, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Identify another pollutant gas that forms acid rain.", "confidence": 1.0, "element_id": "e000038", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 38, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) State two problems caused by acid rain.", "confidence": 1.0, "element_id": "e000039", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 39, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 1 = 8 marks)", "confidence": 1.0, "element_id": "e000040", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 40, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "2 Iron and aluminium are two important metals extracted from their ores on a large scale.", "confidence": 1.0, "element_id": "e000041", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 41, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) In the extraction of iron, three different raw materials are put into the top of a blast furnace.", "confidence": 1.0, "element_id": "e000042", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 42, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Name the main compound present in the following raw materials.", "confidence": 1.0, "element_id": "e000043", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 43, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Haematite", "confidence": 1.0, "element_id": "e000044", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 44, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Limestone", "confidence": 1.0, "element_id": "e000045", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 45, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The following equations represent reactions in the blast furnace.", "confidence": 1.0, "element_id": "e000046", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 46, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A $ \\mathrm{C+O_{2}\\rightarrow CO_{2}} $", "confidence": 1.0, "element_id": "e000047", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 47, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B $ \\mathrm{CaCO_{3}\\rightarrow CaO+CO_{2}} $", "confidence": 1.0, "element_id": "e000048", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 48, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C $ \\mathrm{C+CO_{2}\\rightarrow 2CO} $", "confidence": 1.0, "element_id": "e000049", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 49, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D $ \\mathrm{Fe_{2}O_{3}+3CO\\rightarrow 2Fe+3CO_{2}} $", "confidence": 1.0, "element_id": "e000050", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 50, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "E $ \\mathrm{CaO+SiO_{2}\\rightarrow CaSiO_{3}} $", "confidence": 1.0, "element_id": "e000051", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 51, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Choose from the letters A,B,C,D or E to answer parts (i) - (iv). Each letter may be used once, more than once or not at all.", "confidence": 1.0, "element_id": "e000052", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 52, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) A reaction that is used to produce heat ...", "confidence": 1.0, "element_id": "e000053", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 53, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) A neutralisation reaction", "confidence": 1.0, "element_id": "e000054", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 54, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) A decomposition reaction", "confidence": 1.0, "element_id": "e000055", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 55, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iv) A reaction that forms a reducing agent", "confidence": 1.0, "element_id": "e000056", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 56, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Molten iron and another molten substance collect at the bottom of the blast furnace. What is the common name of this other molten substance?", "confidence": 1.0, "element_id": "e000057", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 57, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) Aluminium is extracted from its ore by electrolysis. This is a more expensive process than using a blast furnace.", "confidence": 1.0, "element_id": "e000058", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 58, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Why is a different method used for aluminium?", "confidence": 1.0, "element_id": "e000059", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 59, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) State the major reason for the high cost of extracting aluminium.", "confidence": 1.0, "element_id": "e000060", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 60, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(e) Coke used in the blast furnace contains carbon. Carbon is also used in the extraction of aluminium, but for a different purpose.", "confidence": 1.0, "element_id": "e000061", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 61, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "What is this purpose?", "confidence": 1.0, "element_id": "e000062", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 62, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(f) The extraction of aluminium can be represented by the chemical equation:", "confidence": 1.0, "element_id": "e000063", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 63, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Write the two ionic half-equations that can also be used to represent this extraction.", "confidence": 1.0, "element_id": "e000065", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 65, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Half-equation 1.", "confidence": 1.0, "element_id": "e000066", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 66, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Half-equation 2.", "confidence": 1.0, "element_id": "e000067", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 67, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 2 = 13 marks)", "confidence": 1.0, "element_id": "e000068", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 68, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "3 A group of students planned an experiment to find the temperature rise in a neutralisation reaction. This is their method.", "confidence": 1.0, "element_id": "e000069", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 69, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Use a measuring cylinder to add $ 2 5 \\mathrm{c m}^{3} $ of an alkali to a $ 1 0 0 \\mathrm{c m}^{3} $ beaker", "confidence": 1.0, "element_id": "e000070", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 70, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Record the temperature of the alkali", "confidence": 1.0, "element_id": "e000071", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 71, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Use a burette to add an acid to the alkali in 5.0 $ cm^{3} $ portions", "confidence": 1.0, "element_id": "e000072", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 72, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Record the temperature of the mixture after adding each portion of acid", "confidence": 1.0, "element_id": "e000073", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 73, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Stop the experiment when the neutralisation is complete", "confidence": 1.0, "element_id": "e000074", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 74, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) The teacher asked the students about their method.", "confidence": 1.0, "element_id": "e000075", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 75, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Suggest an answer to each of her questions.", "confidence": 1.0, "element_id": "e000076", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 76, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Why would it be better to use a pipette instead of a measuring cylinder?", "confidence": 1.0, "element_id": "e000077", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 77, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) It would be better if a polystyrene cup were used instead of a beaker. What property of polystyrene makes this an improvement?", "confidence": 1.0, "element_id": "e000078", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 78, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) What extra step should there be between adding each portion of acid and measuring the temperature?", "confidence": 1.0, "element_id": "e000079", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 79, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iv) How would you know when the neutralisation was complete?", "confidence": 1.0, "element_id": "e000080", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 80, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The diagrams show the readings on the thermometer before and after one of the students added a portion of acid.", "confidence": 1.0, "element_id": "e000081", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 81, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "before adding acid", "confidence": 1.0, "element_id": "e000083", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 83, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "after adding acid", "confidence": 1.0, "element_id": "e000085", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 85, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Write down the thermometer readings and calculate the temperature change.", "confidence": 1.0, "element_id": "e000086", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 86, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(3)", "confidence": 1.0, "element_id": "e000087", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 87, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Temperature before adding acid ... $ ^{\\circ} \\mathrm{C} $", "confidence": 1.0, "element_id": "e000088", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 88, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Temperature after adding acid ... $ ^{\\circ} \\mathrm{C} $", "confidence": 1.0, "element_id": "e000089", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 89, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Temperature change ... $ ^{\\circ} \\mathrm{C} $", "confidence": 1.0, "element_id": "e000090", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 90, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) One student obtained these results from an experiment in which she added a total of $ 4 0. 0 \\mathrm{c m}^{3} $ of hydrochloric acid to $ 2 5 \\mathrm{c m}^{3} $ of sodium hydroxide solution.", "confidence": 1.0, "element_id": "e000091", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 91, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Plot a graph of these results on the grid below.", "confidence": 1.0, "element_id": "e000093", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 93, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Draw a straight line of best fit through the first five points and another straight line of best fit through the last four points. Make sure that the two lines cross.", "confidence": 1.0, "element_id": "e000094", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 94, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Temperature in $ ^{\\circ} \\mathrm{C} $", "confidence": 1.0, "element_id": "e000095", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 95, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The point where the lines cross indicates the volume of acid needed to exactly neutralise the alkali, and also the maximum temperature reached.", "confidence": 1.0, "element_id": "e000097", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 97, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Use your graph to record these values.", "confidence": 1.0, "element_id": "e000098", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 98, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Volume of acid", "confidence": 1.0, "element_id": "e000099", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 99, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Maximum temperature ... $ ^{\\circ} \\mathrm{C} $", "confidence": 1.0, "element_id": "e000100", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 100, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) A second student used the same method and found that $ 3 0. 0 \\mathrm{c m}^{3} $ of acid were needed to neutralise $ 2 5 \\mathrm{c m}^{3} $ of alkali.", "confidence": 1.0, "element_id": "e000101", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 101, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "He obtained a temperature rise of 5.5 $ ^{\\circ} \\mathrm{C} $ in his experiment.", "confidence": 1.0, "element_id": "e000102", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 102, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Calculate the heat energy change in this experiment using the expression:", "confidence": 1.0, "element_id": "e000103", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 103, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "heat energy change = total volume of mixture $ \\times $4.2 $ \\times $temperature change", "confidence": 1.0, "element_id": "e000104", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 104, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Heat energy change =", "confidence": 1.0, "element_id": "e000105", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 105, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(e) A third student calculated that the heat energy change in her experiment was 1800 J. This heat energy was released by the neutralisation of $ 2 5 \\mathrm{c m}^{3} $ of 1.50 mol/dm $ ^{3} $ sodium hydroxide solution.", "confidence": 1.0, "element_id": "e000106", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 106, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Calculate the amount, in moles, of sodium hydroxide neutralised.", "confidence": 1.0, "element_id": "e000107", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 107, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Calculate the molar enthalpy change, in kJ/mol, for the neutralisation of sodium hydroxide.", "confidence": 1.0, "element_id": "e000109", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 109, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Molar enthalpy change =", "confidence": 1.0, "element_id": "e000110", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 110, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 3 = 19 marks)", "confidence": 1.0, "element_id": "e000111", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 111, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "4 There are two important ways to manufacture ethanol.", "confidence": 1.0, "element_id": "e000112", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 112, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Reaction 1", "confidence": 1.0, "element_id": "e000113", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 113, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Reaction 2", "confidence": 1.0, "element_id": "e000115", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 115, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) (i) Identify one raw material that could be used as the source of $ C_{6} H_{1 2} O_{6} $", "confidence": 1.0, "element_id": "e000117", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 117, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Reaction 2 uses a catalyst called zymase, which is present in yeast. Identify the catalyst used in reaction 1.", "confidence": 1.0, "element_id": "e000118", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 118, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) In both reactions it is important to control the temperature State why the temperature in reaction 2 is kept below $ 3 5 \\, \\mathrm{^ \\circ C} $", "confidence": 1.0, "element_id": "e000119", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 119, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) A manufacturing company plans to build a factory to produce ethanol on a large scale. The factory will be near an oilfield. The ethanol will be used as a solvent for perfume.", "confidence": 1.0, "element_id": "e000120", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 120, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Suggest why the company should use reaction 1 rather than reaction 2.", "confidence": 1.0, "element_id": "e000121", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 121, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) In the future, it may be necessary to convert the ethanol (produced by reaction 2) into ethene.", "confidence": 1.0, "element_id": "e000122", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 122, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Write the equation for this reaction and state the type of reaction that occurs.", "confidence": 1.0, "element_id": "e000123", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 123, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Equation", "confidence": 1.0, "element_id": "e000124", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 124, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Type of reaction", "confidence": 1.0, "element_id": "e000125", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 125, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 4 = 8 marks)", "confidence": 1.0, "element_id": "e000126", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 126, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "5 The diagram shows how sodium chloride solution can be electrolysed and the products of electrolysis collected.", "confidence": 1.0, "element_id": "e000127", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 127, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "power supply", "confidence": 1.0, "element_id": "e000129", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 129, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) (i) Draw an arrow on the diagram to show the direction of electron flow at point X.", "confidence": 1.0, "element_id": "e000130", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 130, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The diagram shows one of the gases being collected in test tube Q.", "confidence": 1.0, "element_id": "e000131", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 131, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Identify this gas.", "confidence": 1.0, "element_id": "e000132", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 132, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) When the concentration of the sodium chloride solution is low, the gas collected in test tube P is mostly oxygen. The formation of this gas can be represented by an ionic half-equation.", "confidence": 1.0, "element_id": "e000133", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 133, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Balance the equation.", "confidence": 1.0, "element_id": "e000134", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 134, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) When the concentration of sodium chloride solution is high, the gas that collects in test tube P is mostly chlorine. The equation for its formation is:", "confidence": 1.0, "element_id": "e000136", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 136, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "In one experiment, the volume of chlorine gas collected was $ 1 8 \\mathrm{c m}^{3}. $", "confidence": 1.0, "element_id": "e000138", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 138, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Calculate the amount, in moles, of chlorine gas in $ 1 8 \\mathrm{c m}^{3}. $", "confidence": 1.0, "element_id": "e000139", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 139, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(The volume of 1 mol of a gas at room temperature and pressure is $ 2 4 0 0 0 \\mathrm{c m}^{3} $)", "confidence": 1.0, "element_id": "e000140", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 140, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Calculate the quantity of electricity, in coulombs, needed to produce this volume of chlorine gas.", "confidence": 1.0, "element_id": "e000141", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 141, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(1 faraday=96500 coulombs)", "confidence": 1.0, "element_id": "e000142", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 142, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Chlorine reacts with potassium bromide solution. The equation for this reaction is:", "confidence": 1.0, "element_id": "e000143", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 143, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "This reaction can be described as both a displacement reaction and a redox reaction.", "confidence": 1.0, "element_id": "e000145", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 145, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Identify the element that is displaced in this reaction.", "confidence": 1.0, "element_id": "e000146", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 146, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) State the meaning of the term redox.", "confidence": 1.0, "element_id": "e000147", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 147, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "QUESTION 5 CONTINUES ON THE NEXT PAGE", "confidence": 1.0, "element_id": "e000148", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 148, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) Chlorine is used in the manufacture of phosphorus pentachloride, $ \\mathrm{P C I}_{5} $ The equation for the reaction is:", "confidence": 1.0, "element_id": "e000149", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 149, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) What does the $ \\rightleftharpoons $ symbol indicate about this reaction?", "confidence": 1.0, "element_id": "e000151", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 151, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Predict and explain the effect of increasing the pressure on the equilibrium position of this reaction.", "confidence": 1.0, "element_id": "e000152", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 152, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Prediction", "confidence": 1.0, "element_id": "e000153", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 153, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Explanation", "confidence": 1.0, "element_id": "e000154", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 154, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 5 = 12 marks)", "confidence": 1.0, "element_id": "e000155", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 155, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(TOTAL FOR PAPER=60 MARKS)", "confidence": 1.0, "element_id": "e000156", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 156, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "schemaVersion": "1.0"}', NULL, '2026-09-13 12:57:42.081566+00');
INSERT INTO public.documents VALUES ('44f8c192-bc5c-42b8-8c70-8d3012ad322f', '4d55c014-9a05-516b-8f8a-db536d8e2686', '1.0', 1, 'MARK_SCHEME', 'corpus/igcse-chemistry-4ch0-2c-2012jun/MS.md', 'MS.md', 'text/markdown', '250fb27db938ae78eeb03224bfdf0bf94822ac9b912c3aca8803bedebc270adf', 'SHA-256', 1, 33, 32, 14, 'glm-ocr-markdown', '1.1.0', '2026-09-13 12:57:22.400646+00', '{"pages": [{"width": null, "height": null, "pageNumber": 1}], "source": {"uri": "corpus/igcse-chemistry-4ch0-2c-2012jun/MS.md", "checksum": "250fb27db938ae78eeb03224bfdf0bf94822ac9b912c3aca8803bedebc270adf", "fileName": "MS.md", "mimeType": "text/markdown", "checksumAlgorithm": "SHA-256"}, "tables": [{"rows": [["Question number", "", "Answer", "Notes", "Marks"], ["", "", "", "", "", "", ""], ["1", "a", "(i)", "M1", "nitrogen", "", "1"], ["", "", "", "", "", "", ""], ["", "", "(ii)", "M1", "cross in 2nd box(20)", "", "1"], ["", "", "", "", "", "", ""], ["", "", "(iii)", "M1", "unreactive", "", "1"], ["", "", "", "M2", "water", "", "1"], ["", "", "", "", "", "", ""], ["", "b", "(i)", "M1", "sulfurous acid/H2SO3", "Accept sulfuric(IV) acidAccept ph spellingsIf name and formula given,both must be correct", "1"], ["", "", "", "", "", "", ""], ["", "", "(ii)", "M1", "nitrogen oxide(s)/nitrogen dioxide/NO2/NOx", "Ignore nitrogen monoxide/nitrous oxide and other acidic gases,eg carbon dioxide,sulfur trioxide,hydrogen chloride", "1"], ["", "", "", "", "", "", ""]], "text": "Question number |  | Answer | Notes | Marks\n |  |  |  |  |  | \n1 | a | (i) | M1 | nitrogen |  | 1\n |  |  |  |  |  | \n |  | (ii) | M1 | cross in 2nd box(20) |  | 1\n |  |  |  |  |  | \n |  | (iii) | M1 | unreactive |  | 1\n |  |  | M2 | water |  | 1\n |  |  |  |  |  | \n | b | (i) | M1 | sulfurous acid/H2SO3 | Accept sulfuric(IV) acidAccept ph spellingsIf name and formula given,both must be correct | 1\n |  |  |  |  |  | \n |  | (ii) | M1 | nitrogen oxide(s)/nitrogen dioxide/NO2/NOx | Ignore nitrogen monoxide/nitrous oxide and other acidic gases,eg carbon dioxide,sulfur trioxide,hydrogen chloride | 1\n |  |  |  |  |  | ", "row_count": 13, "confidence": 1.0, "element_id": "e000013", "page_number": 1, "bounding_box": null, "column_count": 5, "element_type": "table", "reading_order": 13, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "", "Answer", "Notes", "Marks"], ["1", "b", "(iii)", "M1", "iron/steel/metal corrodes/rusts/reacts", "Ignore physical process such as erosion/weathering/wearing away/dissolving\nIgnore burns/burning", "2"], ["", "", "", "M2", "limestone/marble reacts/corrodes/is eaten away\nNOT just buildings", "Ignore rusts or physical process such as erosion/weathering/wearing away/dissolving\nIgnore burns/burning"], ["", "", "", "M3", "plants/trees/vegetation/crops/named example adversely affected in specific way, eg dies/stunted growth/harmed/damaged", "Ignore deforestation\nIgnore leaching minerals"], ["", "", "", "M4", "fish/aquatic animals/pond life/marine life/named example affected in specific way, eg dies/stunted growth/harmed/damaged", "Ignore references to just animals"], ["", "", "", "", "", "Accept destroys as an adverse effect for all marks", ""], ["", "", "", "", "", "Any two for 1 each", ""], ["", "", "", "", "", "Total 8 marks"]], "text": "Question number |  | Answer | Notes | Marks\n1 | b | (iii) | M1 | iron/steel/metal corrodes/rusts/reacts | Ignore physical process such as erosion/weathering/wearing away/dissolving\nIgnore burns/burning | 2\n |  |  | M2 | limestone/marble reacts/corrodes/is eaten away\nNOT just buildings | Ignore rusts or physical process such as erosion/weathering/wearing away/dissolving\nIgnore burns/burning\n |  |  | M3 | plants/trees/vegetation/crops/named example adversely affected in specific way, eg dies/stunted growth/harmed/damaged | Ignore deforestation\nIgnore leaching minerals\n |  |  | M4 | fish/aquatic animals/pond life/marine life/named example affected in specific way, eg dies/stunted growth/harmed/damaged | Ignore references to just animals\n |  |  |  |  | Accept destroys as an adverse effect for all marks | \n |  |  |  |  | Any two for 1 each | \n |  |  |  |  | Total 8 marks", "row_count": 8, "confidence": 1.0, "element_id": "e000014", "page_number": 1, "bounding_box": null, "column_count": 5, "element_type": "table", "reading_order": 14, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "", "Answer", "Notes", "Marks"], ["", "", "", "", "", "", ""], ["2", "a", "(i)", "M1", "Iron(III) oxide", "Accept Iron oxide/ferric oxideIgnore formula whether right or wrong", "1"], ["", "", "", "", "", "", ""], ["", "", "(ii)", "M1", "calcium carbonate", "Ignore formula whether right or wrong", "1"], ["", "", "", "", "", "", ""], ["", "b", "(i)", "M1", "A", "", "1"], ["", "", "", "", "", "", ""], ["", "", "(ii)", "M1", "E", "", "1"], ["", "", "", "", "", "", ""], ["", "", "(iii)", "M1", "B", "", "1"], ["", "", "", "", "", "", ""], ["", "", "(iv)", "M1", "C", "", "1"], ["", "c", "", "M1", "slag", "Accept calcium silicateIgnore formula", "1"], ["", "", "", "", "", "", ""], ["", "d", "(i)", "M1", "aluminium/it is more reactive than iron/carbonORabove iron/carbon in reactivity seriesORcannot be reduced by/does not react with carbon(monoxide)ORcannot be displaced by carbon", "Comparison with iron or carbon must be stated or implied, eg not just aluminium is (very/too) reactiveAccept reverse argument for iron", "1"], ["", "", "", "", "", "", ""], ["", "", "(ii)", "M1", "(cost of) electricity", "Accept keeping electrolyte moltenAccept high currentIgnore energyIgnore references to electrode replacement", "1"]], "text": "Question number |  | Answer | Notes | Marks\n |  |  |  |  |  | \n2 | a | (i) | M1 | Iron(III) oxide | Accept Iron oxide/ferric oxideIgnore formula whether right or wrong | 1\n |  |  |  |  |  | \n |  | (ii) | M1 | calcium carbonate | Ignore formula whether right or wrong | 1\n |  |  |  |  |  | \n | b | (i) | M1 | A |  | 1\n |  |  |  |  |  | \n |  | (ii) | M1 | E |  | 1\n |  |  |  |  |  | \n |  | (iii) | M1 | B |  | 1\n |  |  |  |  |  | \n |  | (iv) | M1 | C |  | 1\n | c |  | M1 | slag | Accept calcium silicateIgnore formula | 1\n |  |  |  |  |  | \n | d | (i) | M1 | aluminium/it is more reactive than iron/carbonORabove iron/carbon in reactivity seriesORcannot be reduced by/does not react with carbon(monoxide)ORcannot be displaced by carbon | Comparison with iron or carbon must be stated or implied, eg not just aluminium is (very/too) reactiveAccept reverse argument for iron | 1\n |  |  |  |  |  | \n |  | (ii) | M1 | (cost of) electricity | Accept keeping electrolyte moltenAccept high currentIgnore energyIgnore references to electrode replacement | 1", "row_count": 18, "confidence": 1.0, "element_id": "e000015", "page_number": 1, "bounding_box": null, "column_count": 5, "element_type": "table", "reading_order": 15, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "", "Answer", "Notes", "Marks"], ["2", "e", "", "M1", "electrode(s)/to conduct electricity", "Accept cathode/anode", "1"], ["", "", "", "", "", "", ""], ["", "f", "", "M1", "Al3++3e→Al", "M1 for both aluminium formulae on correct sides of equationM2 for both oxygen formulae on correct sides of equationM3 for balancing both equations even if one or both reversed", "3"], ["", "", "", "M2", "2O2-→O2+4e/2O2-4e→O2"], ["", "", "", "M3", ""], ["", "", "", "", "Accept in either order"], ["", "", "", "", "", "Total 13 marks"]], "text": "Question number |  | Answer | Notes | Marks\n2 | e |  | M1 | electrode(s)/to conduct electricity | Accept cathode/anode | 1\n |  |  |  |  |  | \n | f |  | M1 | Al3++3e→Al | M1 for both aluminium formulae on correct sides of equationM2 for both oxygen formulae on correct sides of equationM3 for balancing both equations even if one or both reversed | 3\n |  |  | M2 | 2O2-→O2+4e/2O2-4e→O2\n |  |  | M3 | \n |  |  |  | Accept in