INSERT INTO public.question_versions VALUES ('9727a399-112d-4ed3-bbd1-9766384cfc1b', '52180e80-98e5-44fc-82b6-94d8314052e6', 1, '(a) The diagram shows the apparatus a teacher uses to determine the formula of an oxide of lead. This is the teacher''s method. Step1 find the mass of the reduction tube Step 2 add some of the lead oxide to the reduction tube Step 3 find the mass of the reduction tube and lead oxide Step 4 pass hydrogen gas over the lead oxide and ignite the hydrogen at the hole Step 5 heat the lead oxide strongly for 10 minutes Step 7 find the new mass of the reduction tube and its contents Step 6 keep passing hydrogen through the reduction tube until the tube and contents are cool (i) Give a reason why hydrogen is passed through the reduction tube until the tube and contents are cool. (ii) Describe what the teacher should do next to make sure all the lead oxide has been reduced to lead.', 1, 3, 90, NULL, 'SUGGESTED', '9e5d961d-751e-584f-af10-6da7d8ddd75f', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:55:24.291912+00');
