INSERT INTO public.questions VALUES ('7e0d261e-b17b-4c93-9c84-4cb26e1958e2', 'q08-f4948ec0', 'STRUCTURED', 'The apparatus in the diagram is used to heat a sample of hydrated copper(II) sulfate crystals, $ \mathrm{C u S O_{4}. 5 H_{2} O} $ The equation for the reaction that takes place is $\mathrm {C u S O} _ {4}. 5 \mathrm {H} _ {2} \mathrm {O} (\mathrm {s}) \rightarrow \mathrm {C u S O} _ {4} (\mathrm {s}) + 5 \mathrm {H} _ {2} \mathrm {O} (\mathrm {l})$ hydrated copper(ll) sulfate', 1, 3, 90, NULL, '8288c504-436a-4116-b70f-81bc971992e1', 'PAST_PAPER', true, 1, '2026-09-13 12:53:11.817045+00', '66566842-554a-4293-82a8-dce2fa8dcd94');
INSERT INTO public.questions VALUES ('04115bd5-d24d-4be6-ae0c-60048a2df44d', 'q09-f4948ec0', 'STRUCTURED', 'A student investigates the reaction of aqueous sodium hydroxide with two different aqueous solutions of hydrochloric acid, solution X and solution Y. She carries out two experiments. Experiment 1 Using a measuring cylinder, she pours 20 $ cm^{3} $ of aqueous sodium hydroxide into a conical flask and records its temperature. Using a burette, she adds 5 $ cm^{3} $ of solution X to the conical flask. She stirs the mixture with the thermometer and records the temperature. She adds further 5 $ cm^{3} $ volumes of solution X and stirs with the thermometer. She records the temperature after each addition of solution X. She stops when a total of $ 4 0 \mathrm{c m}^{3} $ of solution X has been added. She empties the burette and rinses it first with water and then with solution Y. She then fills the burette with solution Y. She repeats the experiment using solution Y. The table shows the results she obtains in Experiment 1.', 9, 3, 810, NULL, '8288c504-436a-4116-b70f-81bc971992e1', 'PAST_PAPER', true, 1, '2026-09-13 12:53:11.817222+00', '66566842-554a-4293-82a8-dce2fa8dcd94');
