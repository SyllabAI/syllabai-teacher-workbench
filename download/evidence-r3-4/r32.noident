INSERT INTO public.document_chunks VALUES ('04e4a014-fdb3-434d-a176-358d466f9241', '0622fc85-70d0-46e1-9c3e-f563d2b9d4bd', 2, 'The lanthanoids (atomic numbers 58-71) and the actinoids (atomic numbers 90-103) have been omitted.
