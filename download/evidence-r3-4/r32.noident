INSERT INTO public.document_chunks VALUES ('4d499cad-a099-4739-b968-a85e88431eee', 'ac8055f3-157b-49a8-987d-93d1e8a76016', 8, 'C The volume of acid used was $ 5 0. 0 \mathrm{c m}^{3} $ instead of $ 2 5. 0 \mathrm{c m}^{3} $
