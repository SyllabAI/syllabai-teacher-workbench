INSERT INTO public.question_parts VALUES ('8b46040f-5d85-4351-a549-94def7140e14', '4adb29d7-ba06-4996-bd13-8434fce101d5', 'd', 'Give the word used to describe the change of state represented by this equation. $\mathrm {H} _ {2} \mathrm {O} (\mathrm {s}) \rightarrow \mathrm {H} _ {2} \mathrm {O} (\mathrm {g})$', NULL, 0, 3, '2026-09-13 12:53:55.675088+00');
