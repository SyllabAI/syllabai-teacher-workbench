INSERT INTO public.question_parts VALUES ('d7328c46-509c-4fc5-9927-a613dcbd8b95', '8649ae28-2c44-4a8c-b836-e36456c9c697', 'd-i', 'Identify the concordant results by placing ticks ( $ \surd $ ) in the table as shown.', NULL, 0, 8, '2026-09-13 12:41:17.399615+00');
