INSERT INTO public.question_parts VALUES ('9ffff9ab-e9c4-45b1-9eb9-a6c8efe4484f', '68d5cec3-be1a-430a-8799-362cb3089d26', 'c-ii', 'The temperature change in this experiment shows that dissolving lithium iodide in water to form lithium iodide solution is an exothermic process. Complete the energy level diagram to show the position of the lithium iodide solution. Label the diagram to show $ \Delta H $ , the molar enthalpy change.', NULL, 0, 6, '2026-09-13 12:59:09.401323+00');
INSERT INTO public.question_parts VALUES ('13c93cd9-83c2-4944-b938-b19c68c9fb8b', '9d893a1b-db33-4bf0-a722-7403d77c2c9e', 'a', 'Suggest why magnesium is not found as an element in the Earth''s crust.', NULL, 0, 0, '2026-09-13 12:59:09.401381+00');
INSERT INTO public.question_parts VALUES ('4618b642-2e17-4e94-8a76-0d497ebdd271', '9d893a1b-db33-4bf0-a722-7403d77c2c9e', 'b', 'Magnesium can be extracted from seawater by a multi-stage process. stage1 calcium hydroxide reacts with magnesium chloride in seawater to form a precipitate of magnesium hydroxide stage 2 the magnesium hydroxide is filtered off and converted into magnesium chloride solution by reacting it with hydrochloric acid stage 3 the magnesium chloride solution is converted into solid magnesium chloride stage 4 the solid magnesium chloride is melted and electrolysed', NULL, 0, 1, '2026-09-13 12:59:09.40145+00');
INSERT INTO public.question_parts VALUES ('9cd04fbb-4cb3-434a-9f40-9637cb807467', '9d893a1b-db33-4bf0-a722-7403d77c2c9e', 'b-i', 'Which stage involves a neutralisation reaction? A stage 1 B stage 2 C stage 3 D stage 4', NULL, 0, 2, '2026-09-13 12:59:09.401504+00');
INSERT INTO public.question_parts VALUES ('7ac5064d-2413-4117-98a9-45927af343a6', '9d893a1b-db33-4bf0-a722-7403d77c2c9e', 'b-ii', 'Suggest the name of the other product formed in stage 1.', NULL, 0, 3, '2026-09-13 12:59:09.401553+00');
