INSERT INTO public.question_versions VALUES ('fb0e3ea7-8161-463e-b9d0-ef0ecaa2ec75', 'c2d5ecb6-ca1b-44c7-9662-0d88b0eb20bf', 1, 'When lithium is burned in air, the two compounds lithium oxide (Li $ _{2} $ O) and lithium nitride (Li $ _{3} $ N) are formed. Both compounds are ionic and their ions can be represented by dot and cross diagrams. The dot and cross diagram for the ions in lithium oxide is $\left[ \left. \mathrm {O} \right. \right] ^ {2 -}$', 9, 3, 810, NULL, 'SUGGESTED', '87d9135e-d9af-5b60-b2f3-82bc89ba5a1a', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:52:26.061064+00');
