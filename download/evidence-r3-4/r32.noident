INSERT INTO public.question_parts VALUES ('baa7ff43-b364-44ab-8972-f90e20006c99', '113ecac5-b09e-4cf4-b103-fa4b6ffe317c', 'c', 'The equation for the preparation of oxygen from hydrogen peroxide is $2 \mathrm {H} _ {2} \mathrm {O} _ {2} \rightarrow 2 \mathrm {H} _ {2} \mathrm {O} + \mathrm {O} _ {2}$ This equation can also be written using displayed formulae to show all the covalent bonds in the molecules. $2 H - O - O - H \rightarrow 2 H - O - H + O = O$ The table gives the bond energies for these bonds.', NULL, 0, 2, '2026-09-13 13:00:41.179949+00');
INSERT INTO public.question_parts VALUES ('ad0f1a4f-bd9b-4467-9704-e9937af9497d', '113ecac5-b09e-4cf4-b103-fa4b6ffe317c', 'c-i', 'Use the values in the table to calculate the enthalpy change, $ \Delta H $ , for the reaction. Include a sign in your answer.', NULL, 0, 3, '2026-09-13 13:00:41.179975+00');
