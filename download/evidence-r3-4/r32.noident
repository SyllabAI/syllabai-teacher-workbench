INSERT INTO public.questions VALUES ('36a6b5aa-9494-4c04-808e-ef25aab0d926', 'q05-06a1d491', 'STRUCTURED', 'The table shows the displayed formulae of three unsaturated hydrocarbons.', 14, 3, 1260, NULL, '28ca36dd-381a-4265-9157-a6ac03a313f7', 'PAST_PAPER', true, 1, '2026-09-13 12:52:24.997869+00', 'fc401417-2892-49d8-9f02-160a9222e7bb');
INSERT INTO public.questions VALUES ('7d4863b8-cf93-4e9a-893e-e9cd2e144652', 'q06-06a1d491', 'STRUCTURED', 'The reactivity of metals can be studied using displacement reactions. In these reactions, one metal is added to a solution of a salt of a different metal. If a displacement reaction occurs, there is a temperature rise. Pour some metal salt solution into a polystyrene cup supported in a glass beaker and record the temperature of the solution. Add a known mass of a metal and stir. Record the maximum temperature of the mixture. A student used the following method in a series of experiments.', 13, 3, 1170, NULL, '28ca36dd-381a-4265-9157-a6ac03a313f7', 'PAST_PAPER', true, 1, '2026-09-13 12:52:24.998248+00', 'fc401417-2892-49d8-9f02-160a9222e7bb');
INSERT INTO public.questions VALUES ('faea6fb3-f8d1-4201-ad10-30cf990fdba7', 'q07-06a1d491', 'STRUCTURED', 'Most metals are extracted in a blast furnace or by electrolysis.', 17, 3, 1530, NULL, '28ca36dd-381a-4265-9157-a6ac03a313f7', 'PAST_PAPER', true, 1, '2026-09-13 12:52:24.998646+00', 'fc401417-2892-49d8-9f02-160a9222e7bb');
INSERT INTO public.questions VALUES ('5741ab37-f04c-4dc9-99a5-c662f6c9f841', 'q09-06a1d491', 'STRUCTURED', 'This question is about bromine and some of its compounds.', 16, 3, 1440, NULL, '28ca36dd-381a-4265-9157-a6ac03a313f7', 'PAST_PAPER', true, 1, '2026-09-13 12:52:24.999354+00', 'fc401417-2892-49d8-9f02-160a9222e7bb');
INSERT INTO public.questions VALUES ('8449dbbb-f451-4086-8897-e1d3df88d2ba', 'q01-a11a8fbb', 'STRUCTURED', 'Boron is an element in Group 3 of the Periodic Table. An atom of boron can be represented as $ ^{1 1} _ {5} \mathrm{B} $', 1, 3, 90, NULL, '031c3e1f-d318-4360-a056-c9a822ded7b3', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.35796+00', '550e50e2-c61c-4b94-89ee-ef83ce9bf901');
INSERT INTO public.questions VALUES ('9f9ac4de-7361-4699-ba99-8f73fa2c7784', 'q02-a11a8fbb', 'STRUCTURED', 'A student used this apparatus to make and collect a sample of hydrogen gas.', 1, 3, 90, NULL, '031c3e1f-d318-4360-a056-c9a822ded7b3', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.358376+00', '550e50e2-c61c-4b94-89ee-ef83ce9bf901');
INSERT INTO public.questions VALUES ('66fcbd37-6790-402b-9c18-262058a9009e', 'q03-a11a8fbb', 'STRUCTURED', 'The halogens are elements in Group 7 of the Periodic Table. The halogens react with metals to form compounds called halides. Table 1 shows information about some halogens and their halides. Table 1', 1, 3, 90, NULL, '031c3e1f-d318-4360-a056-c9a822ded7b3', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.35914+00', '550e50e2-c61c-4b94-89ee-ef83ce9bf901');
INSERT INTO public.questions VALUES ('652f9d90-12f9-4672-aacb-e87d4cc4f4cf', 'q04-a11a8fbb', 'STRUCTURED', 'Ethene can be converted into many useful substances.', 6, 3, 540, NULL, '031c3e1f-d318-4360-a056-c9a822ded7b3', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.359715+00', '550e50e2-c61c-4b94-89ee-ef83ce9bf901');
INSERT INTO public.questions VALUES ('da1d5215-bedb-443a-93a3-d49f9441c7e1', 'q05-a11a8fbb', 'STRUCTURED', 'A student was asked to compare the industrial processes used to extract aluminium and iron from their ores.', 17, 3, 1530, NULL, '031c3e1f-d318-4360-a056-c9a822ded7b3', 'PAST_PAPER', true, 1, '2026-09-13 12:52:25.360107+00', '550e50e2-c61c-4b94-89ee-ef83ce9bf901');
INSERT INTO public.questions VALUES ('03377ddd-40a4-4cf7-8013-8a4eacb949a6', 'q06-a11a8fbb', 'STRUCTURED', 'The table shows the structures of six organic compounds, A to F. A H
