INSERT INTO public.question_parts VALUES ('a9d7c139-444c-4897-886c-5d19942b484f', 'b2c53df1-0e90-453e-8630-680143e6572a', 'c', 'A student investigates the reactivity of some halogens. She uses these solutions of halogens and their halides. bromine, chlorine and iodine sodium bromide, sodium chloride and sodium iodide She adds each halogen solution to each halide solution. The table shows her results.', NULL, 0, 4, '2026-09-13 12:55:23.885206+00');
INSERT INTO public.question_parts VALUES ('6d76fcd8-bc72-4cbe-af48-5446456d807a', 'b2c53df1-0e90-453e-8630-680143e6572a', 'c-i', 'Explain how these results show the order of reactivity of bromine, chlorine and iodine.', NULL, 0, 5, '2026-09-13 12:55:23.885227+00');
