INSERT INTO public.question_parts VALUES ('07a4df3b-967d-4139-9567-e9209981ed7f', 'fd096122-7c40-4c90-9f57-da351b2b96ef', 'c-i', 'Explain how oxides of nitrogen form in a car engine.', NULL, 0, 3, '2026-09-13 13:01:26.268459+00');
