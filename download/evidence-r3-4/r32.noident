INSERT INTO public.document_chunks VALUES ('e3d53edb-9a77-4c9f-a1e1-3f55b1898ca6', '22e9cb56-a04c-4852-a4c0-2b1ca8bbb735', 0, 'Please check the examination details below before entering your candidate information
