INSERT INTO public.question_versions VALUES ('1dd710c9-48de-4120-b1c5-5f2f76326a18', 'f7a1af5b-6e31-441a-9bd8-9e8b6f77707a', 1, 'This question is about carbon and its compounds.', 11, 3, 990, NULL, 'SUGGESTED', '1ed33ec4-b402-59d2-ac10-e808f3b34257', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:54:40.601624+00');
