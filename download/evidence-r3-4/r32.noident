INSERT INTO public.document_chunks VALUES ('0a669882-f0a2-4351-a977-f706841a43e1', 'fdf23b6a-b7ba-4aaf-98f7-95cced05f9d9', 6, '7 Magnesium can be obtained by the electrolysis of magnesium chloride. Solid magnesium chloride is obtained from seawater.
