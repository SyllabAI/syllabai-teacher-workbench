INSERT INTO public.question_parts VALUES ('b365df18-f0a5-4caf-8291-0702e305dfd6', '7c2d4014-6411-40c3-8c69-b0bf2935ad18', 'b', 'Sea water contains bromide ions. Bromine can be obtained by bubbling chlorine through a sample of sea water. The ionic equation for the reaction is $\mathrm {C l} _ {2} (\mathrm {g}) + 2 \mathrm {B r} ^ {-} (\mathrm {a q}) \rightarrow 2 \mathrm {C l} ^ {-} (\mathrm {a q}) + \mathrm {B r} _ {2} (\mathrm {a q})$', NULL, 0, 3, '2026-09-13 13:01:26.458559+00');
