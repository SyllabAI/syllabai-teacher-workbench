INSERT INTO public.questions VALUES ('fbc85c66-6a77-4cbc-acee-67e0490f55dc', 'q10-04d61f97', 'STRUCTURED', '(a) There are three isomers with the molecular formula $ \mathrm{C_{5} H_{1 2}} $ One of these isomers is pentane. The displayed formula for pentane is (i) State what is meant by the term isomers. (ii) Draw the displayed formula for another isomer of $ \mathrm{C_{5} H_{1 2}} $', 1, 3, 90, NULL, '2c556132-d50b-41a4-9055-4463642425fe', 'PAST_PAPER', true, 1, '2026-09-13 12:54:39.973818+00', '7ab57098-d6bb-4b23-a2e7-f0d46c890c45');
INSERT INTO public.questions VALUES ('5d65faff-edda-4053-89c2-9eaee7f404f7', 'q11-04d61f97', 'STRUCTURED', 'The gas burned in a Bunsen burner is methane. The equation for the complete combustion of methane is $\mathrm {C H} _ {4} (\mathrm {g}) + 2 \mathrm {O} _ {2} (\mathrm {g}) \rightarrow \mathrm {C O} _ {2} (\mathrm {g}) + 2 \mathrm {H} _ {2} \mathrm {O} (\mathrm {g})$', 9, 3, 810, NULL, '2c556132-d50b-41a4-9055-4463642425fe', 'PAST_PAPER', true, 1, '2026-09-13 12:54:39.97471+00', '7ab57098-d6bb-4b23-a2e7-f0d46c890c45');
INSERT INTO public.questions VALUES ('569aadfe-1dab-4979-9b90-e1f0dce45d0f', 'q12-04d61f97', 'STRUCTURED', 'A student uses this apparatus to investigate the temperature change that occurs when ammonium nitrate is dissolved in water. She uses this method. put $ 1 0 0 \mathrm{c m}^{3} $ of water into the polystyrene cup and measure the initial temperature of the water add 8.00 g of ammonium nitrate and stir record the lowest temperature reached by the solution The table shows her results. Initial temperature of water in $ ^{\circ} \mathrm{C} $ 20.0 Lowest temperature of solution in $ ^{\circ} \mathrm{C} $ 14.2', 9, 3, 810, NULL, '2c556132-d50b-41a4-9055-4463642425fe', 'PAST_PAPER', true, 1, '2026-09-13 12:54:39.975056+00', '7ab57098-d6bb-4b23-a2e7-f0d46c890c45');
INSERT INTO public.questions VALUES ('bfdb0065-9e18-4692-af33-0525818f37d1', 'q13-04d61f97', 'STRUCTURED', 'A student uses this apparatus to investigate the rate of reaction between magnesium and an excess of dilute hydrochloric acid. She uses this method. use a graduated beaker to pour $ 50 \mathrm{c m}^{3} $ of dilute hydrochloric acid of concentration 2.00 mol/dm $ ^{3} $ into the conical flask add a piece of magnesium ribbon of mass 0.086 g to the acid and put the bung into the neck of the flask measure the total volume of gas collected every ten seconds until the reaction stops The table shows the student''s results.', 12, 3, 1080, NULL, '2c556132-d50b-41a4-9055-4463642425fe', 'PAST_PAPER', true, 1, '2026-09-13 12:54:39.975323+00', '7ab57098-d6bb-4b23-a2e7-f0d46c890c45');
INSERT INTO public.questions VALUES ('ccee64ad-002d-4a51-a7d0-eb15797743bc', 'q14-04d61f97', 'STRUCTURED', 'A salt can be made by reacting an acid with an insoluble base. The student uses this method. Stage 1 pour $ 5 0 \mathrm{c m}^{3} $ of dilute sulfuric acid into a beaker Stage 2 warm the acid using a Bunsen burner Stage 3 add a small amount of copper(II) oxide to the warm acid and stir the mixture Stage 4 add further amounts of copper(II) oxide until copper(II) oxide is in excess Stage 5 filter the mixture Stage 6 obtain crystals from the filtrate A student has a sample of copper(II) oxide.', 14, 3, 1260, NULL, '2c556132-d50b-41a4-9055-4463642425fe', 'PAST_PAPER', true, 1, '2026-09-13 12:54:39.975614+00', '7ab57098-d6bb-4b23-a2e7-f0d46c890c45');
INSERT INTO public.questions VALUES ('c2eb24f8-0d37-4b41-9f4a-e55c1e4917e8', 'q15-04d61f97', 'STRUCTURED', 'Hydrated ammonium iron(III) sulfate is a violet solid that has the formula $ \mathrm{(N H_{4})_{2} S O_{4}. F e_{2}(S O_{4})_{3}. x H_{2} O} $ The table shows some tests done on three separate samples of the solid.', 9, 3, 810, NULL, '2c556132-d50b-41a4-9055-4463642425fe', 'PAST_PAPER', true, 1, '2026-09-13 12:54:39.975915+00', '7ab57098-d6bb-4b23-a2e7-f0d46c890c45');
INSERT INTO public.questions VALUES ('5eb0c189-5d82-429f-97f4-ef5af12af6dd', 'q05-a6e3bced', 'STRUCTURED', 'This is a question about metals and their compounds.', 14, 3, 1260, NULL, '8fe08646-c263-451f-ab4d-58527ff8c2f7', 'PAST_PAPER', true, 1, '2026-09-13 12:56:10.079026+00', 'd18aa783-f86e-4c45-a20e-041e19b4835b');
INSERT INTO public.questions VALUES ('6c90baa4-25fd-453e-a8d2-d868021ebbb3', 'q06-a6e3bced', 'STRUCTURED', 'Ocimene is an organic compound that gives some plants their particular smell. The molecular formula of ocimene is $ C_{1 0} H_{1 6} $', 13, 3, 1170, NULL, '8fe08646-c263-451f-ab4d-58527ff8c2f7', 'PAST_PAPER', true, 1, '2026-09-13 12:56:10.079246+00', 'd18aa783-f86e-4c45-a20e-041e19b4835b');
INSERT INTO public.questions VALUES ('1a2b881a-655c-4894-bad7-133cae6cf5c5', 'q07-a6e3bced', 'STRUCTURED', '(a) Explain the meaning of the term thermal decomposition.', 1, 3, 90, NULL, '8fe08646-c263-451f-ab4d-58527ff8c2f7', 'PAST_PAPER', true, 1, '2026-09-13 12:56:10.079472+00', 'd18aa783-f86e-4c45-a20e-041e19b4835b');
INSERT INTO public.questions VALUES ('d36406cd-ecd4-4ce0-a920-928685c131a6', 'q08-a6e3bced', 'STRUCTURED', 'A student uses this apparatus in an experiment to study the rate of the reaction between zinc and dilute sulfuric acid. This is the student''s method. add a few zinc granules to a conical flask on a balance add $ 1 0 0 \mathrm{c m}^{3} $ of dilute sulfuric acid to the flask, start a timer and immediately record the mass of the flask and contents record the mass of the flask and contents every minute until the mass remains constant The mass of the flask and contents decreases because hydrogen gas is produced and leaves the flask. The student uses the mass readings to calculate the total mass of hydrogen produced.', 1, 3, 90, NULL, '8fe08646-c263-451f-ab4d-58527ff8c2f7', 'PAST_PAPER', true, 1, '2026-09-13 12:56:10.079729+00', 'd18aa783-f86e-4c45-a20e-041e19b4835b');
INSERT INTO public.questions VALUES ('edf05338-454a-4e66-a198-5613e2a74e31', 'q09-a6e3bced', 'STRUCTURED', 'A student is given a mixture of two white solid compounds, and a colourless solution containing the same two compounds. The student is told that one of the compounds is a halide and that the other compound is a carbonate.', 8, 3, 720, NULL, '8fe08646-c263-451f-ab4d-58527ff8c2f7', 'PAST_PAPER', true, 1, '2026-09-13 12:56:10.079962+00', 'd18aa783-f86e-4c45-a20e-041e19b4835b');
INSERT INTO public.questions VALUES ('5b388ebf-1749-464f-939f-ba3429351193', 'q10-a6e3bced', 'STRUCTURED', '(a) A student is given a pure sample of sodium carbonate crystals and is told that the formula of the crystals is $ \mathrm{N a_{2} C O_{3}. x H_{2} O} $ State what $ x\mathrm{H}_{2}\mathrm{O} $ in the formula shows about the sodium carbonate crystals.', 10, 3, 900, NULL, '8fe08646-c263-451f-ab4d-58527ff8c2f7', 'PAST_PAPER', true, 1, '2026-09-13 12:56:10.080216+00', 'd18aa783-f86e-4c45-a20e-041e19b4835b');
INSERT INTO public.questions VALUES ('47dc7954-b7e9-4eb0-986d-6d5326ff98a1', 'q11-a6e3bced', 'STRUCTURED', 'A student investigates the temperature change during the reaction between zinc metal and copper(II) sulfate solution. The student considers two different methods. Method 1', 16, 3, 1440, NULL, '8fe08646-c263-451f-ab4d-58527ff8c2f7', 'PAST_PAPER', true, 1, '2026-09-13 12:56:10.080444+00', 'd18aa783-f86e-4c45-a20e-041e19b4835b');
