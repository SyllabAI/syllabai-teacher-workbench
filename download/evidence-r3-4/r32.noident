INSERT INTO public.questions VALUES ('7813e9dd-1dfe-4fea-8429-1786516725e3', 'q04-9ef9b0c8', 'STRUCTURED', 'Crystals of copper(II) nitrate, $ \mathrm{C u} \left( \mathrm{N O}_{3} \right)_{2} $ , can be prepared by reacting solid copper(II) oxide, CuO, with dilute nitric acid.', 5, 3, 450, NULL, 'e87d0375-5ffb-4d0f-bd64-9430050e99e6', 'PAST_PAPER', true, 1, '2026-09-13 12:59:09.685523+00', 'f5cb6ce6-5ea5-4887-9ce1-0e79a7a13bb8');
INSERT INTO public.questions VALUES ('1cf50c89-a5e3-43ab-99b1-38be845a1889', 'q05-9ef9b0c8', 'STRUCTURED', 'But-1-ene is a member of the homologous series of alkenes. The displayed formula of but-1-ene is The saturated compound cyclobutane is an isomer of but-1-ene. The displayed formula of cyclobutane is', 1, 3, 90, NULL, 'e87d0375-5ffb-4d0f-bd64-9430050e99e6', 'PAST_PAPER', true, 1, '2026-09-13 12:59:09.685839+00', 'f5cb6ce6-5ea5-4887-9ce1-0e79a7a13bb8');
INSERT INTO public.questions VALUES ('55690fc1-6640-4cd7-9c77-622ced298624', 'q06-9ef9b0c8', 'STRUCTURED', 'This apparatus can be used in a method to find the volume of sulfuric acid required to neutralise a solution of potassium hydroxide (KOH).', 1, 3, 90, NULL, 'e87d0375-5ffb-4d0f-bd64-9430050e99e6', 'PAST_PAPER', true, 1, '2026-09-13 12:59:09.686107+00', 'f5cb6ce6-5ea5-4887-9ce1-0e79a7a13bb8');
INSERT INTO public.questions VALUES ('b309bb87-c6ce-48f3-8dca-e30cfe6a56fb', 'q07-9ef9b0c8', 'STRUCTURED', 'Crude oil is a complex mixture of organic compounds called hydrocarbons. It is separated into fractions using a fractionating tower.', 1, 3, 90, NULL, 'e87d0375-5ffb-4d0f-bd64-9430050e99e6', 'PAST_PAPER', true, 1, '2026-09-13 12:59:09.686363+00', 'f5cb6ce6-5ea5-4887-9ce1-0e79a7a13bb8');
INSERT INTO public.questions VALUES ('dd4a1fd1-e0ae-4182-9b6b-f82eb475a4cb', 'q08-9ef9b0c8', 'STRUCTURED', 'This is a recipe for making Irish soda bread. add 170g of wholemeal flour, 170g of plain flour, 10g of salt and 10.5g of bicarbonate of soda (sodium hydrogencarbonate, $ \mathrm{N a H C O_{3}} $ ）to a bowl and stir pour in $ 2 9 0 \mathrm{c m}^{3} $ of buttermilk and stir quickly to form a soft dough form the dough into a round ball and slightly flatten it cut a cross in the top and bake for 30 minutes in an oven at $ 2 0 0^{\circ} \mathrm{C} $ When sodium hydrogencarbonate is heated, it forms carbon dioxide gas. $2 \mathrm {N a H C O} _ {3} \rightarrow \mathrm {N a} _ {2} \mathrm {C O} _ {3} + \mathrm {H} _ {2} \mathrm {O} + \mathrm {C O} _ {2}$', 1, 3, 90, NULL, 'e87d0375-5ffb-4d0f-bd64-9430050e99e6', 'PAST_PAPER', true, 1, '2026-09-13 12:59:09.686799+00', 'f5cb6ce6-5ea5-4887-9ce1-0e79a7a13bb8');
INSERT INTO public.questions VALUES ('4cd60f6e-906a-4346-b430-2890ec21961d', 'q01-1a97e8dd', 'STRUCTURED', 'Hydrated copper(II) sulfate is a soluble blue solid. A large crystal of this solid is placed at the bottom of a beaker of water. The diagram shows the beaker immediately after placing the crystal in it, and after two days. after placing the crystal after two days', 4, 3, 360, NULL, '017d63f7-35f8-48c4-9ae9-8ba9f9dfe927', 'PAST_PAPER', true, 1, '2026-09-13 12:59:55.952261+00', 'a431a8e6-721f-4882-bdc5-3e2ba6251300');
INSERT INTO public.questions VALUES ('91dd8681-caab-4ed3-8846-ed2e9f263683', 'q02-1a97e8dd', 'STRUCTURED', 'Iron is a metal with many uses. One problem with using iron is that it rusts.', 8, 3, 720, NULL, '017d63f7-35f8-48c4-9ae9-8ba9f9dfe927', 'PAST_PAPER', true, 1, '2026-09-13 12:59:55.96276+00', 'a431a8e6-721f-4882-bdc5-3e2ba6251300');
