INSERT INTO public.document_chunks VALUES ('215c1886-0dd6-4dc8-baeb-b3d869f24696', '0622fc85-70d0-46e1-9c3e-f563d2b9d4bd', 9, '9 A student uses the reaction between zinc powder and dilute nitric acid to prepare some zinc nitrate crystals.
(a) (i) Complete the equation for the reaction by adding the state symbols.
\mathrm {Z n} (\dots \dots \dots \dots) + 2 \mathrm {H N O} _ {3} (\dots \dots \dots \dots) \rightarrow \mathrm {Z n} (\mathrm {N O} _ {3}) _ {2} (\dots \dots \dots \dots) + \mathrm {H} _ {2} (\dots \dots \dots \dots)
