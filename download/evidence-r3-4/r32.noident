INSERT INTO public.question_parts VALUES ('63beb1eb-1ea7-4824-bd90-f5518c087048', 'b5bdc167-d781-435a-9106-720e91c9a674', 'd', 'Bromine reacts with hydrogen to form hydrogen bromide. The equation for the reaction is $\mathrm {H} _ {2} (\mathrm {g}) + \mathrm {B r} _ {2} (\mathrm {g}) \rightarrow 2 \mathrm {H B r} (\mathrm {g})$ The table shows some average bond energies. Use the values in the table to calculate the enthalpy change for the reaction between hydrogen and bromine.', NULL, 0, 3, '2026-09-13 13:00:40.380247+00');
