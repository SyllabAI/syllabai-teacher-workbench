ne": "glm-ocr-markdown", "application": "syllabai-parser", "extractedAt": "2026-09-13T12:52:04.786355019Z", "engineVersion": "1.1.0", "schemaVersion": "1.0", "extractionParams": {"pageBoundaries": "none-in-source", "sourceLineCount": 391, "upstreamConverter": "zai-glm-ocr", "entityDecodedLines": 0, "signedUrlFigureRefs": 0, "normalizedHtmlEntities": true}}, "textBlocks": [{"role": "heading", "text": "Instructions", "confidence": 1.0, "element_id": "e000001", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 1, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Use black ink or ball-point pen.", "confidence": 1.0, "element_id": "e000002", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 2, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Fill in the boxes at the top of this page with your name, centre number and candidate number.", "confidence": 1.0, "element_id": "e000003", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 3, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer all questions.", "confidence": 1.0, "element_id": "e000004", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 4, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer the questions in the spaces provided", "confidence": 1.0, "element_id": "e000005", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 5, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "there may be more space than you need.", "confidence": 1.0, "element_id": "e000006", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 6, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Show all the steps in any calculations and state the units.", "confidence": 1.0, "element_id": "e000007", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 7, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Some questions must be answered with a cross in a box. If you change your mind about an answer, put a line through the box and then mark your new answer with a cross.", "confidence": 1.0, "element_id": "e000008", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 8, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Information", "confidence": 1.0, "element_id": "e000009", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 9, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The total mark for this paper is 120.", "confidence": 1.0, "element_id": "e000010", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 10, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The marks for each question are shown in brackets", "confidence": 1.0, "element_id": "e000011", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 11, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "use this as a guide as to how much time to spend on each question.", "confidence": 1.0, "element_id": "e000012", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 12, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Advice", "confidence": 1.0, "element_id": "e000013", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 13, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Read each question carefully before you start to answer it.", "confidence": 1.0, "element_id": "e000014", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 14, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Keep an eye on the time.", "confidence": 1.0, "element_id": "e000015", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 15, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Write your answers neatly and in good English.", "confidence": 1.0, "element_id": "e000016", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 16, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Try to answer every question.", "confidence": 1.0, "element_id": "e000017", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 17, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Check your answers if you have time at the end.", "confidence": 1.0, "element_id": "e000018", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 18, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "THE PERIODIC TABLE", "confidence": 1.0, "element_id": "e000019", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 19, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000021", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 21, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Answer ALL questions.", "confidence": 1.0, "element_id": "e000022", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 22, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "1 Boron is an element in Group 3 of the Periodic Table.", "confidence": 1.0, "element_id": "e000023", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 23, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "An atom of boron can be represented as $ ^{1 1} _ {5} \\mathrm{B} $", "confidence": 1.0, "element_id": "e000024", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 24, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Use numbers from the box to complete the sentences about this atom of boron.", "confidence": 1.0, "element_id": "e000025", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 25, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Each number may be used once, more than once or not at all.", "confidence": 1.0, "element_id": "e000027", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 27, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) The atomic number of boron is ...", "confidence": 1.0, "element_id": "e000028", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 28, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The mass number of boron is ...", "confidence": 1.0, "element_id": "e000029", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 29, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) This atom of boron contains ... protons.", "confidence": 1.0, "element_id": "e000030", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 30, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iv) This atom of boron contains neutrons.", "confidence": 1.0, "element_id": "e000031", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 31, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(v) This atom of boron contains ... electrons.", "confidence": 1.0, "element_id": "e000032", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 32, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Aluminium is another element in Group 3 of the Periodic Table.", "confidence": 1.0, "element_id": "e000033", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 33, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Select a word or phrase from the box to complete each sentence about an atom of aluminium.", "confidence": 1.0, "element_id": "e000034", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 34, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Each word or phrase may be used once, more than once or not at all.", "confidence": 1.0, "element_id": "e000036", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 36, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Compared to an atom of boron, an atom of aluminium has protons.", "confidence": 1.0, "element_id": "e000037", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 37, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Compared to an atom of boron, an atom of aluminium has ... neutrons.", "confidence": 1.0, "element_id": "e000038", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 38, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Compared to an atom of boron, an atom of aluminium has electrons in its outer shell.", "confidence": 1.0, "element_id": "e000039", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 39, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) The electronic configuration of aluminium is", "confidence": 1.0, "element_id": "e000040", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 40, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "2 A student used this apparatus to make and collect a sample of hydrogen gas.", "confidence": 1.0, "element_id": "e000041", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 41, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) The reaction in the flask can be shown by this word equation.", "confidence": 1.0, "element_id": "e000043", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 43, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "metal + acid $ \\rightarrow $ salt + hydrogen", "confidence": 1.0, "element_id": "e000044", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 44, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) The name of the salt formed in the student''s experiment is", "confidence": 1.0, "element_id": "e000045", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 45, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A zinc sulfate", "confidence": 1.0, "element_id": "e000046", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 46, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B zinc sulfide", "confidence": 1.0, "element_id": "e000047", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 47, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "zinc sulfite", "confidence": 1.0, "element_id": "e000048", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 48, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D zinc sulfur", "confidence": 1.0, "element_id": "e000049", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 49, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The student could have used other metals in this experiment.", "confidence": 1.0, "element_id": "e000050", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 50, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Place crosses ( $ \\times $ ) in two boxes to show the names of two other metals that could be safely used to make hydrogen.", "confidence": 1.0, "element_id": "e000051", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 51, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A copper", "confidence": 1.0, "element_id": "e000052", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 52, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B iron", "confidence": 1.0, "element_id": "e000053", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 53, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C magnesium", "confidence": 1.0, "element_id": "e000054", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 54, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D potassium", "confidence": 1.0, "element_id": "e000055", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 55, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "E silver", "confidence": 1.0, "element_id": "e000056", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 56, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Describe a test to show that the gas collected is hydrogen.", "confidence": 1.0, "element_id": "e000057", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 57, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Water is formed when hydrogen combines with oxygen. Balance the equation for this reaction.", "confidence": 1.0, "element_id": "e000058", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 58, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) Equation 1 represents a reaction using cobalt(II) chloride that can be used to show a liquid contains water.", "confidence": 1.0, "element_id": "e000060", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 60, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Equation 1", "confidence": 1.0, "element_id": "e000061", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 61, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "In this reaction there is a colour change from blue to pink.", "confidence": 1.0, "element_id": "e000063", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 63, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Which word describes both cobalt compounds in equation 1?", "confidence": 1.0, "element_id": "e000064", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 64, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A anhydrous", "confidence": 1.0, "element_id": "e000065", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 65, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B aqueous", "confidence": 1.0, "element_id": "e000066", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 66, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C hydrated", "confidence": 1.0, "element_id": "e000067", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 67, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D saturated", "confidence": 1.0, "element_id": "e000068", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 68, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) When the product in equation 1 is gently heated, another reaction occurs. Equation 2 represents this reaction.", "confidence": 1.0, "element_id": "e000069", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 69, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Equation 2", "confidence": 1.0, "element_id": "e000070", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 70, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "What do equations 1 and 2 suggest about the reactions?", "confidence": 1.0, "element_id": "e000072", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 72, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "3 The halogens are elements in Group 7 of the Periodic Table. The halogens react with metals to form compounds called halides. Table 1 shows information about some halogens and their halides.", "confidence": 1.0, "element_id": "e000073", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 73, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Table 1", "confidence": 1.0, "element_id": "e000075", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 75, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) (i) Predict the physical state of fluorine at room temperature.", "confidence": 1.0, "element_id": "e000076", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 76, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Predict how the colour of astatine at room temperature compares with the colour of iodine.", "confidence": 1.0, "element_id": "e000077", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 77, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Each of the halides in table 1 was dissolved in water to form a solution. A sample of each of the halogens was then added to some of the halide solutions. Table 2 shows the results.", "confidence": 1.0, "element_id": "e000078", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 78, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Table 2", "confidence": 1.0, "element_id": "e000080", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 80, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Suggest why there is no reason to add chlorine to lithium chloride solution.", "confidence": 1.0, "element_id": "e000081", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 81, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Why was there no reaction when iodine was added to sodium bromide solution?", "confidence": 1.0, "element_id": "e000082", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 82, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Name the substance with the brown colour that formed when chlorine was added to potassium iodide solution.", "confidence": 1.0, "element_id": "e000083", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 83, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iv) The reaction between bromine and potassium iodide solution is a displacement reaction.", "confidence": 1.0, "element_id": "e000084", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 84, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "What is the correct description of this reaction?", "confidence": 1.0, "element_id": "e000085", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 85, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A bromide displaces iodide", "confidence": 1.0, "element_id": "e000086", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 86, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B bromine displaces iodide", "confidence": 1.0, "element_id": "e000087", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 87, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C bromide displaces iodine", "confidence": 1.0, "element_id": "e000088", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 88, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D bromine displaces iodine", "confidence": 1.0, "element_id": "e000089", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 89, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(v) Complete the chemical equation for the reaction between chlorine and potassium bromide solution.", "confidence": 1.0, "element_id": "e000090", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 90, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "4 Ethene can be converted into many useful substances.", "confidence": 1.0, "element_id": "e000092", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 92, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Draw a dot and cross diagram to show the covalent bonding in a molecule of ethene. Only the outer electrons in each atom need to be shown.", "confidence": 1.0, "element_id": "e000093", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 93, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Compound X is made from ethene and is used in cars to prevent the engine coolant from freezing in cold weather.", "confidence": 1.0, "element_id": "e000094", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 94, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Compound X contains 38.7% carbon, 9.7% hydrogen and 51.6% oxygen by mass. Calculate the empirical formula of X.", "confidence": 1.0, "element_id": "e000095", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 95, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Empirical formula", "confidence": 1.0, "element_id": "e000096", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 96, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The relative formula mass $ ( M_{r} ) $ of X is 62 What is the molecular formula of X?", "confidence": 1.0, "element_id": "e000097", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 97, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 4 = 6 marks)", "confidence": 1.0, "element_id": "e000098", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 98, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "5 A student was asked to compare the industrial processes used to extract aluminium and iron from their ores.", "confidence": 1.0, "element_id": "e000099", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 99, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) (i) Name the main ore used as the source of iron.", "confidence": 1.0, "element_id": "e000100", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 100, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Aluminium is extracted from purified aluminium oxide. What is the formula of aluminium oxide?", "confidence": 1.0, "element_id": "e000101", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 101, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) One solid element is used in the extraction of both metals. Identify this element and state its purpose in the extraction of aluminium.", "confidence": 1.0, "element_id": "e000102", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 102, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Element", "confidence": 1.0, "element_id": "e000103", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 103, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iv) One gaseous element takes part in a reaction needed in the extraction of iron. Identify this element and state its purpose in the extraction of iron.", "confidence": 1.0, "element_id": "e000104", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 104, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Element", "confidence": 1.0, "element_id": "e000105", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 105, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Purpose", "confidence": 1.0, "element_id": "e000106", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 106, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The student wrote this statement:", "confidence": 1.0, "element_id": "e000107", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 107, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The extractions of aluminium and iron both involve reduction and oxidation reactions.", "confidence": 1.0, "element_id": "e000108", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 108, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) What name is given to a reaction that involves both reduction and oxidation?", "confidence": 1.0, "element_id": "e000109", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 109, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Why does this equation represent a reduction reaction?", "confidence": 1.0, "element_id": "e000110", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 110, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) The equation for a reaction that occurs in some extractions of iron is", "confidence": 1.0, "element_id": "e000112", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 112, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Identify the substance oxidised in this reaction, giving a reason for your choice.", "confidence": 1.0, "element_id": "e000114", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 114, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Substance oxidised", "confidence": 1.0, "element_id": "e000115", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 115, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Reason", "confidence": 1.0, "element_id": "e000116", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 116, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Both extractions occur at a high temperature. Neither extraction uses a catalyst.", "confidence": 1.0, "element_id": "e000117", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 117, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) What is meant by the term catalyst?", "confidence": 1.0, "element_id": "e000118", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 118, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) State one reason why cryolite is used in the extraction of aluminium.", "confidence": 1.0, "element_id": "e000119", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 119, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) Several equations can be written for the reactions occurring in the extractions.", "confidence": 1.0, "element_id": "e000120", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 120, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Write the chemical equation for the reaction between iron(III) oxide $ \\mathrm{(F e_{2} O_{3})} $ and carbon monoxide (CO).", "confidence": 1.0, "element_id": "e000121", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 121, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) This equation represents a reaction used to remove impurities in the extraction of iron.", "confidence": 1.0, "element_id": "e000122", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 122, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "State the type of reaction occurring in this equation.", "confidence": 1.0, "element_id": "e000124", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 124, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Complete the table by giving the common name for calcium silicate.", "confidence": 1.0, "element_id": "e000125", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 125, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 5 = 17 marks)", "confidence": 1.0, "element_id": "e000127", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 127, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "6 The table shows the structures of six organic compounds, A to F.", "confidence": 1.0, "element_id": "e000128", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 128, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) The letter of the compound in the table that is not shown as a displayed formula is.", "confidence": 1.0, "element_id": "e000130", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 130, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) (i) State what is meant by the term hydrocarbon, and give the letter of one compound in the table that is not a hydrocarbon.", "confidence": 1.0, "element_id": "e000131", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 131, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Hydrocarbon", "confidence": 1.0, "element_id": "e000132", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 132, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Letter", "confidence": 1.0, "element_id": "e000133", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 133, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) State what is meant by the term unsaturated, and give the letter of one compound in the table that is unsaturated.", "confidence": 1.0, "element_id": "e000134", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 134, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Unsaturated", "confidence": 1.0, "element_id": "e000135", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 135, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Letter", "confidence": 1.0, "element_id": "e000136", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 136, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) State what is meant by the term isomers, and give the letters of two compounds in the table that are isomers of each other.", "confidence": 1.0, "element_id": "e000137", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 137, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Isomers", "confidence": 1.0, "element_id": "e000138", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 138, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Letters", "confidence": 1.0, "element_id": "e000139", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 139, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Some of the compounds in the table are members of the same homologous series.", "confidence": 1.0, "element_id": "e000140", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 140, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) One feature of a homologous series is that adjacent members have formulae that differ by $ \\mathrm{C H_{2}} $", "confidence": 1.0, "element_id": "e000141", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 141, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "State two other features of members of the same homologous series.", "confidence": 1.0, "element_id": "e000142", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 142, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Give the letters of two adjacent members of the same homologous series shown in the table.", "confidence": 1.0, "element_id": "e000143", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 143, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Letters", "confidence": 1.0, "element_id": "e000144", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 144, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) (i) Compound G has the molecular formula $ \\mathrm{C_{2} H_{4} Br_{2}} $", "confidence": 1.0, "element_id": "e000145", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 145, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "It can be made from a compound in the table by a reaction that does not need UV light.", "confidence": 1.0, "element_id": "e000146", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 146, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Draw the displayed formula of compound G.", "confidence": 1.0, "element_id": "e000147", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 147, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Compound H reacts with bromine to form one of the compounds in the table. The reaction needs UV light.", "confidence": 1.0, "element_id": "e000148", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 148, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Draw the displayed formula of compound H.", "confidence": 1.0, "element_id": "e000149", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 149, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "7 A teacher asked her students to suggest some experiments that could be done using chemicals found in the home. One student planned an experiment to measure the temperature change when baking soda is added to vinegar.", "confidence": 1.0, "element_id": "e000150", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 150, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "She wrote this plan.", "confidence": 1.0, "element_id": "e000151", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 151, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "pour 100 $ cm^{3} $ of vinegar into a polystyrene cup", "confidence": 1.0, "element_id": "e000152", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 152, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "weigh out five separate 1 g portions of baking soda", "confidence": 1.0, "element_id": "e000153", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 153, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "measure the temperature of the vinegar", "confidence": 1.0, "element_id": "e000154", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 154, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "add 1 g of baking soda to the vinegar and stir", "confidence": 1.0, "element_id": "e000155", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 155, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "record the new temperature", "confidence": 1.0, "element_id": "e000156", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 156, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "add the other portions of baking soda, stirring and recording the temperature after each portion is added", "confidence": 1.0, "element_id": "e000157", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 157, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The graph shows her results.", "confidence": 1.0, "element_id": "e000158", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 158, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Mass of baking soda added in grams", "confidence": 1.0, "element_id": "e000160", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 160, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) The student said that the reaction in her experiment was not complete. How does the graph support her statement?", "confidence": 1.0, "element_id": "e000161", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 161, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The student used a polystyrene cup rather than a glass beaker. Why is it better to use a polystyrene cup?", "confidence": 1.0, "element_id": "e000162", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 162, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Vinegar contains ethanoic acid. Baking soda contains sodium hydrogencarbonate. The student found this equation for the reaction:", "confidence": 1.0, "element_id": "e000163", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 163, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) There is no colour change during this reaction.", "confidence": 1.0, "element_id": "e000165", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 165, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Suggest one observation, other than the change in temperature, that could be made during the reaction.", "confidence": 1.0, "element_id": "e000166", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 166, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The compound $ \\mathrm{C H_{3} C O O H} $ is an acid and the compound $ \\mathrm{C H_{3} C O O N a} $ is a salt. The graph shows that the temperature goes down during the reaction. Use this information to state the two types of reaction occurring.", "confidence": 1.0, "element_id": "e000167", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 167, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) (i) Complete the energy level diagram by showing the products of the reaction.", "confidence": 1.0, "element_id": "e000168", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 168, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Label the diagram to show the energy change, $ \\Delta H $ , for the reaction.", "confidence": 1.0, "element_id": "e000170", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 170, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(e) The student repeated the experiment using the same method with a different sample of vinegar. She recorded these results.", "confidence": 1.0, "element_id": "e000171", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 171, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Calculate the heat energy change in this experiment using the expression heat energy change = volume of vinegar $ \\times4.2\\times $ temperature change", "confidence": 1.0, "element_id": "e000176", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 176, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Heat energy change =", "confidence": 1.0, "element_id": "e000177", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 177, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The student wanted to calculate the amount, in moles, of ethanoic acid in the vinegar.", "confidence": 1.0, "element_id": "e000178", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 178, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Apart from the volume of vinegar, what other information would she need to be able to calculate the amount of ethanoic acid?", "confidence": 1.0, "element_id": "e000179", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 179, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 7 = 10 marks)", "confidence": 1.0, "element_id": "e000180", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 180, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000181", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 181, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "8 A group of students investigated the reaction between marble chips (calcium carbonate) and dilute hydrochloric acid.", "confidence": 1.0, "element_id": "e000182", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 182, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The equation for this reaction is", "confidence": 1.0, "element_id": "e000183", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 183, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "They wanted to find the effect of changing the concentration of hydrochloric acid on the rate of reaction. The teacher provided a solution that she had labelled 100% hydrochloric acid.", "confidence": 1.0, "element_id": "e000185", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 185, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The teacher told them to do all their experiments", "confidence": 1.0, "element_id": "e000186", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 186, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "using different concentrations of hydrochloric acid made by diluting the 100% hydrochloric acid", "confidence": 1.0, "element_id": "e000187", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 187, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "by timing how long it took to collect carbon dioxide", "confidence": 1.0, "element_id": "e000188", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 188, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "at room temperature", "confidence": 1.0, "element_id": "e000189", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 189, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The students used this apparatus.", "confidence": 1.0, "element_id": "e000190", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 190, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) The students tried to keep the amount of calcium carbonate constant by using the same number of marble chips in each experiment.", "confidence": 1.0, "element_id": "e000192", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 192, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "State two other properties of the marble chips that should be the same in each experiment.", "confidence": 1.0, "element_id": "e000193", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 193, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The table shows how some of the students wrote down their results.", "confidence": 1.0, "element_id": "e000194", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 194, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The teacher said that she could only use the results from student 1 because the other students had not recorded enough information.", "confidence": 1.0, "element_id": "e000196", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 196, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Identify the piece of information that each student failed to record.", "confidence": 1.0, "element_id": "e000197", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 197, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Student 2", "confidence": 1.0, "element_id": "e000198", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 198, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Student 3", "confidence": 1.0, "element_id": "e000199", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 199, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Student 4", "confidence": 1.0, "element_id": "e000200", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 200, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Student 5", "confidence": 1.0, "element_id": "e000201", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 201, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) The students repeated the experiment to make sure that it was a fair test. They used a different supply of hydrochloric acid. They all measured the time to collect $ 1 0 0 \\mathrm{c m}^{3} $ of carbon dioxide and calculated the rate of each reaction.", "confidence": 1.0, "element_id": "e000202", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 202, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Their results are shown in the table.", "confidence": 1.0, "element_id": "e000203", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 203, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Plot these results on the grid and draw a straight line of best fit.", "confidence": 1.0, "element_id": "e000205", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 205, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Rate of reaction in $ \\mathrm{c m^{3}/s} $", "confidence": 1.0, "element_id": "e000206", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 206, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) One of the points is anomalous. Circle this point on the graph.", "confidence": 1.0, "element_id": "e000208", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 208, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Suggest two errors in the experiment that could have caused this anomalous result.", "confidence": 1.0, "element_id": "e000209", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 209, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iv) Use your graph to estimate the rate of reaction using an acid concentration of 50%. Show on your graph how you obtained your answer.", "confidence": 1.0, "element_id": "e000210", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 210, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 8 = 14 marks)", "confidence": 1.0, "element_id": "e000211", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 211, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "9 The diagram shows some pieces of apparatus used to measure volumes.", "confidence": 1.0, "element_id": "e000212", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 212, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A student was given a large bottle containing sodium hydroxide solution and a supply of dilute sulfuric acid of known concentration.", "confidence": 1.0, "element_id": "e000214", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 214, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "He was allowed to use normal laboratory apparatus, including the pieces of apparatus shown in the diagram.", "confidence": 1.0, "element_id": "e000215", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 215, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "He was told to plan an experiment to find the concentration of the sodium hydroxide solution. This is his plan.", "confidence": 1.0, "element_id": "e000216", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 216, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step1 Obtain about 150 $ cm^{3} $ of each solution.", "confidence": 1.0, "element_id": "e000217", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 217, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 2 Use a measuring cylinder to add exactly 25.0 $ cm^{3} $ of sodium hydroxide solution to a conical flask.", "confidence": 1.0, "element_id": "e000218", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 218, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 3 Add a few drops of universal indicator to the conical flask.", "confidence": 1.0, "element_id": "e000219", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 219, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Step 4 Use a burette to add the sulfuric acid to the conical flask until the indicator changes colour.", "confidence": 1.0, "element_id": "e000220", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 220, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) (i) Give the name of the most suitable piece of apparatus in the diagram that should be used in Step 1.", "confidence": 1.0, "element_id": "e000221", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 221, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Give the name of the piece of apparatus in the diagram that should be used instead of a measuring cylinder in Step 2.", "confidence": 1.0, "element_id": "e000222", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 222, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) State why universal indicator is not a good choice for this experiment and suggest an indicator that would be more suitable.", "confidence": 1.0, "element_id": "e000223", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 223, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iv) Why is a pipette not suitable for adding the acid in Step 4?", "confidence": 1.0, "element_id": "e000224", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 224, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The diagram shows the burette readings in one experiment before and after adding the acid.", "confidence": 1.0, "element_id": "e000225", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 225, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Use the readings to complete the table, entering all values to the nearest 0.05 $ cm^{3}. $", "confidence": 1.0, "element_id": "e000228", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 228, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) The student repeated the experiment using a different concentration of sodium hydroxide solution and recorded these results.", "confidence": 1.0, "element_id": "e000230", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 230, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The volumes of acid added during these titrations are not all the same. The average (mean) volume of acid should be calculated using only concordant results.", "confidence": 1.0, "element_id": "e000232", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 232, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Concordant results are those volumes that differ from each other by 0.20 $ cm^{3} $ or less.", "confidence": 1.0, "element_id": "e000233", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 233, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Identify the concordant results by placing ticks ( $ \\checkmark $ ) in the table where appropriate.", "confidence": 1.0, "element_id": "e000234", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 234, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Use your ticked results to calculate the average (mean) volume of acid added.", "confidence": 1.0, "element_id": "e000235", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 235, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Average (mean) volume of acid =", "confidence": 1.0, "element_id": "e000236", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 236, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) The student used the same method to find the concentration of a solution of potassium hydroxide. The equation for the reaction is", "confidence": 1.0, "element_id": "e000237", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 237, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "These are his results.", "confidence": 1.0, "element_id": "e000239", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 239, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "He used these results to calculate the concentration of the potassium hydroxide solution.", "confidence": 1.0, "element_id": "e000241", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 241, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "There is one mistake in each step of the calculation. What correction should the student make in each step?", "confidence": 1.0, "element_id": "e000245", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 245, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Step 1", "confidence": 1.0, "element_id": "e000246", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 246, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Step 2", "confidence": 1.0, "element_id": "e000247", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 247, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 9 = 14 marks)", "confidence": 1.0, "element_id": "e000248", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 248, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "10 The Haber process is used to convert nitrogen and hydrogen into ammonia.", "confidence": 1.0, "element_id": "e000249", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 249, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Which raw material is the source of the nitrogen?", "confidence": 1.0, "element_id": "e000250", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 250, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The hydrogen for this process is obtained using reactions 1 and 2", "confidence": 1.0, "element_id": "e000251", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 251, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Reaction 1", "confidence": 1.0, "element_id": "e000252", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 252, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Reaction 2", "confidence": 1.0, "element_id": "e000253", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 253, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Predict what will happen to the equilibrium position in reaction 1 when the pressure is increased. Give a reason for your prediction.", "confidence": 1.0, "element_id": "e000255", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 255, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Prediction", "confidence": 1.0, "element_id": "e000256", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 256, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Reason", "confidence": 1.0, "element_id": "e000257", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 257, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Predict what will happen to the equilibrium position in reaction 2 when the temperature is increased. Give a reason for your prediction.", "confidence": 1.0, "element_id": "e000258", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 258, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Prediction", "confidence": 1.0, "element_id": "e000259", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 259, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Reason", "confidence": 1.0, "element_id": "e000260", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 260, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Predict what will happen to the rate of reaction 1 when the pressure and temperature are increased.", "confidence": 1.0, "element_id": "e000261", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 261, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Effect of increased pressure", "confidence": 1.0, "element_id": "e000262", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 262, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Effect of increased temperature.", "confidence": 1.0, "element_id": "e000263", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 263, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) Some of the ammonia from the Haber process is made into fertilisers such as ammonium nitrate.", "confidence": 1.0, "element_id": "e000264", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 264, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The equation for the formation of ammonium nitrate is", "confidence": 1.0, "element_id": "e000265", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 265, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A manufacturer makes a batch of 40 kg of ammonium nitrate.", "confidence": 1.0, "element_id": "e000267", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 267, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Calculate the amount, in moles, of $ \\mathrm{N H_{4} N O_{3}} $ in 40 kg of ammonium nitrate.", "confidence": 1.0, "element_id": "e000268", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 268, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Deduce the amount, in moles, of ammonia needed to make this amount of ammonium nitrate.", "confidence": 1.0, "element_id": "e000270", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 270, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Amount of ammonia.", "confidence": 1.0, "element_id": "e000271", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 271, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Calculate the mass, in kg, of ammonia needed.", "confidence": 1.0, "element_id": "e000272", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 272, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(e) The manufacturer also produces fertilisers that are labelled NPK.", "confidence": 1.0, "element_id": "e000273", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 273, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Suggest the names of two elements, other than nitrogen, that are likely to be present in NPK fertilisers.", "confidence": 1.0, "element_id": "e000274", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 274, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "11 The properties of substances can be explained in terms of their bonding and structure. Electricity can be transmitted by overhead power lines. This method of transmission requires electrical conductors and insulators.", "confidence": 1.0, "element_id": "e000275", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 275, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Aluminium is used for the overhead lines because it is a good conductor of electricity and is ductile (can be pulled into a wire).", "confidence": 1.0, "element_id": "e000276", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 276, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "This diagram can be used to represent the structure of aluminium.", "confidence": 1.0, "element_id": "e000277", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 277, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "aluminium atom", "confidence": 1.0, "element_id": "e000279", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 279, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Explain why aluminium is a good conductor of electricity.", "confidence": 1.0, "element_id": "e000280", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 280, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Suggest why aluminium is ductile.", "confidence": 1.0, "element_id": "e000281", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 281, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The main substance that acts as an insulator in this method of transmission of electricity is air, which is mostly nitrogen.", "confidence": 1.0, "element_id": "e000282", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 282, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The power lines are supported by solid insulators. Most solid insulators are manufactured using silica.", "confidence": 1.0, "element_id": "e000283", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 283, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The diagram shows the structures of nitrogen and silica.", "confidence": 1.0, "element_id": "e000284", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 284, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Nitrogen", "confidence": 1.0, "element_id": "e000286", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 286, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Silica", "confidence": 1.0, "element_id": "e000288", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 288, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Explain, in terms of bonding and structure, why nitrogen is a gas at room temperature but silica is a solid with a high melting point.", "confidence": 1.0, "element_id": "e000289", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 289, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Nitrogen", "confidence": 1.0, "element_id": "e000290", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 290, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Silica", "confidence": 1.0, "element_id": "e000291", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 291, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 11 = 9 marks)", "confidence": 1.0, "element_id": "e000292", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 292, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "TOTAL FOR PAPER = 120 MARKS", "confidence": 1.0, "element_id": "e000293", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 293, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000294", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 294, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "schemaVersion": "1.0"}', NULL, '2026-09-13 12:52:25.277951+00');
INSERT INTO public.documents VALUES ('ae5eee3e-d8f5-4df2-93c8-691401b7be1c', '78d61e9f-767a-5e86-b1a0-e92f53f3f814', '1.0', 1, 'MARK_SCHEME', 'corpus/igcse-chemistry-4ch0-1c-2013jun/MS.md', 'MS.md', 'text/markdown', '0ec62ea71773ab8e28bad1c9ac79e9e6fee4752e60fd96c4b2110c5c79110de3', 'SHA-256', 1, 54, 54, 23, 'glm-ocr-markdown', '1.1.0', '2026-09-13 12:52:04.859935+00', '{"pages": [{"width": null, "height": null, "pageNumber": 1}], "source": {"uri": "corpus/igcse-chemistry-4ch0-1c-2013jun/MS.md", "checksum": "0ec62ea71773ab8e28bad1c9ac79e9e6fee4752e60fd96c4b2110c5c79110de3", "fileName": "MS.md", "mimeType": "text/markdown", "checksumAlgorithm": "SHA-256"}, "tables": [{"rows": [["Question number", "Answer", "Notes", "Marks"], ["1(a)i", "5", "", "1"], ["ii", "11", "", "1"], ["iii", "5", "", "1"], ["iv", "6", "", "1"], ["v", "5", "", "1"], ["1(b)i", "more", "", "1"], ["ii", "more", "", "1"], ["iii", "the same number of", "", "1"], ["1(c)", "cross in box D(2.8.3)", "", "1"], ["", "", "Total", "9"]], "text": "Question number | Answer | Notes | Marks\n1(a)i | 5 |  | 1\nii | 11 |  | 1\niii | 5 |  | 1\niv | 6 |  | 1\nv | 5 |  | 1\n1(b)i | more |  | 1\nii | more |  | 1\niii | the same number of |  | 1\n1(c) | cross in box D(2.8.3) |  | 1\n |  | Total | 9", "row_count": 11, "confidence": 1.0, "element_id": "e000018", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 18, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["2(a)i", "cross in box A(zinc sulfate)", "", "1"], ["ii", "cross in box B(iron)\ncross in box C(magnesium)", "Apply list principle-3 crosses=max14 or 5 crosses=0 marks", "1\n1"], ["2(b)", "burns with a pop/squeak\nOR\nuse burning/lit splint/flame to see if pop/squeak", "Must be reference to test and result\nReference to splint/match with no indication of flame is not enough\nReject reference to glowing splint\nIgnore flame extingui