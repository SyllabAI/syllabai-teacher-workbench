INSERT INTO public.question_versions VALUES ('d7d2af23-6f47-4eac-b297-5a472931ad01', '7813e9dd-1dfe-4fea-8429-1786516725e3', 1, 'Crystals of copper(II) nitrate, $ \mathrm{C u} \left( \mathrm{N O}_{3} \right)_{2} $ , can be prepared by reacting solid copper(II) oxide, CuO, with dilute nitric acid.', 5, 3, 450, NULL, 'SUGGESTED', '9ef9b0c8-3a05-5e34-977c-7af899b976bc', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:09.685676+00');
INSERT INTO public.question_versions VALUES ('8fbfffee-6204-41f8-9216-da5425271da3', '9f76be2f-68b7-422b-a44b-159d44a90b8e', 1, 'A student investigates the rate of reaction between sodium thiosulfate and hydrochloric acid at $ 2 5^{\circ} \mathrm{C} $ The equation for the reaction is $\mathrm {N a} _ {2} \mathrm {S} _ {2} \mathrm {O} _ {3} (\mathrm {a q}) + 2 \mathrm {H C l} (\mathrm {a q}) \rightarrow 2 \mathrm {N a C l} (\mathrm {a q}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {I}) + \mathrm {S O} _ {2} (\mathrm {g}) + \mathrm {S} (\mathrm {s})$ She uses this method. pour 50 $ cm^{3} $ of sodium thiosulfate solution into a conical flask place the conical flask on top of a sheet of paper with a cross drawn on it add 10 $ cm^{3} $ of hydrochloric acid and start the timer stop the timer when the cross can no longer be seen and record the time taken The student repeats the experiment five times with different volumes of sodium thiosulfate solution. She adds water as necessary to keep the total volume of reaction mixture constant.', 10, 3, 900, NULL, 'SUGGESTED', '3815dec0-d22c-5ce3-a44d-596a7434ed70', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.820497+00');
INSERT INTO public.question_versions VALUES ('fa7100c6-9806-46ee-8ee1-36e323bd748b', '59db1a54-d5b2-4283-8484-cf897f78030b', 1, 'The diagram shows the diaphragm cell used in the electrolysis of concentrated sodium chloride solution, NaCl(aq).', 8, 3, 720, NULL, 'SUGGESTED', '3815dec0-d22c-5ce3-a44d-596a7434ed70', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.820794+00');
INSERT INTO public.question_versions VALUES ('a2515691-25e0-4724-91d7-b3b29ab76c10', '5ea86b47-6f00-408a-9dde-c742b03501c3', 1, 'Solid X contains two cations (positive ions) and one anion (negative ion). One of the cations is $ \mathrm{F e}^{3+} $', 6, 3, 540, NULL, 'SUGGESTED', '3815dec0-d22c-5ce3-a44d-596a7434ed70', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.821065+00');
INSERT INTO public.question_versions VALUES ('d607cffb-932a-4290-98cf-866cdd87d900', '0f3bac04-f89e-4d5d-b671-fd2da8b8be9b', 1, '(a) The first two members of the homologous series of alcohols are methanol and ethanol. (i) Give two characteristics of the compounds in a homologous series. (ii) The displayed formula for methanol is Suggest a displayed formula for ethanol, $ \mathrm{C H_{3} C H_{2} O H} $', 1, 3, 90, NULL, 'SUGGESTED', '3815dec0-d22c-5ce3-a44d-596a7434ed70', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.821317+00');
INSERT INTO public.question_versions VALUES ('216c7721-9495-49dd-a2ea-b41fe9f8d8bf', '9ab98ecf-8be7-471b-a993-613b53cd0511', 1, 'The hydrogen needed for the manufacture of ammonia is made by a process called steam reforming. In this process, a mixture of methane and steam is passed over a nickel catalyst. The equation for the reaction is $\mathrm {C H} _ {4} (\mathrm {g}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {g}) \rightleftharpoons \mathrm {C O} (\mathrm {g}) + 3 \mathrm {H} _ {2} (\mathrm {g}) \quad \Delta H = + 2 1 0 \mathrm {k J / m o l}$', 9, 3, 810, NULL, 'SUGGESTED', '3815dec0-d22c-5ce3-a44d-596a7434ed70', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:58:26.821572+00');
INSERT INTO public.question_versions VALUES ('85f6bcac-9297-4de3-aa3b-b4a4396c9061', '129aa4e7-9218-4aea-9578-41e3e5d1cfcc', 1, 'Neon is an element with atomic number 10.', 10, 3, 900, NULL, 'SUGGESTED', '7a337178-d58f-5b51-8355-63df0327ca7c', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:08.918323+00');
