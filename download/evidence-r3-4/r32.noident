INSERT INTO public.document_chunks VALUES ('1d0443eb-8f08-4a1a-8b27-3df87a4fb7c3', 'd56a00ba-cad0-4e32-b9fe-92b8c95c7e6b', 8, '(a) Describe how crude oil is separated into fractions in industry.
