INSERT INTO public.question_parts VALUES ('5b5b4f88-a921-4ee4-ba93-ec2b44444211', '65ef8ad3-ee0b-410d-8a8a-a6959b4ce926', 'a', 'The box gives words relating to changes of state. Complete the table by giving the correct word from the box for each change of state.', NULL, 0, 0, '2026-09-13 12:56:09.826145+00');
INSERT INTO public.question_parts VALUES ('f847e699-95b4-4e34-b71e-763234a1a922', '65ef8ad3-ee0b-410d-8a8a-a6959b4ce926', 'b', 'When ammonia gas and hydrogen chloride gas mix, they react together to form a white solid called ammonium chloride. The equation for the reaction is $\mathrm {N H} _ {3} (\mathrm {g}) + \mathrm {H C l} (\mathrm {g}) \rightarrow \mathrm {N H} _ {4} \mathrm {C l} (\mathrm {s})$ A teacher soaks a piece of cotton wool in concentrated ammonia solution and another piece of cotton wool in concentrated hydrochloric acid. The teacher places the two pieces of cotton wool at opposite ends of a glass tube at the same time. After several minutes, a white ring of solid ammonium chloride forms.', NULL, 0, 1, '2026-09-13 12:56:09.826259+00');
INSERT INTO public.question_parts VALUES ('1fc47c14-6b6c-4d7f-93d2-01454a011a9f', '65ef8ad3-ee0b-410d-8a8a-a6959b4ce926', 'b-i', 'State the name given to the spreading out of gas particles.', NULL, 0, 2, '2026-09-13 12:56:09.826287+00');
