INSERT INTO public.document_chunks VALUES ('94b8f7d2-f8c5-445b-ae39-effaafc26cae', 'fcec2a83-9bae-4330-a5c0-d79447d82053', 8, '(c) The student wants to obtain an accurate value for the volume of sodium hydroxide solution needed to neutralise the $ 2 5. 0 \mathrm{c m}^{3} $ of nitric acid.
Describe all the further steps the student should take.
(d) This is a summary of the student''s results.
volume of $ \mathrm{H N O}_{3} $ used $ = 2 5. 0 \mathrm{c m}^{3} $
concentration of NaOH solution = 0.350 mol/dm $ ^{3} $
volume of NaOH solution needed for neutralisation $ = 1 8. 8 0 \mathrm{c m}^{3} $
The equation for the reaction is
\mathrm {H N O} _ {3} + \mathrm {N a O H} \rightarrow \mathrm {N a N O} _ {3} + \mathrm {H} _ {2} \mathrm {O}
