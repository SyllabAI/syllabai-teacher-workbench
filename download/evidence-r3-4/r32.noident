INSERT INTO public.questions VALUES ('a4d134c8-b530-47ec-8852-c199f5206af6', 'q03-7a337178', 'STRUCTURED', 'The thermite reaction is used on railways to produce molten iron for joining rails together. The diagram shows how this is done. The equation for this thermite reaction is $2 \mathrm {A l} + \mathrm {F e} _ {2} \mathrm {O} _ {3} \rightarrow \mathrm {A l} _ {2} \mathrm {O} _ {3} + 2 \mathrm {F e}$', 5, 3, 450, NULL, '1038adbd-db72-44c1-8afe-8817cead9704', 'PAST_PAPER', true, 1, '2026-09-13 12:59:08.920323+00', '55c2a084-3f93-4655-903b-e68b1394ad62');
INSERT INTO public.questions VALUES ('6902788f-9cd3-47f6-a654-94722d42e9c5', 'q04-7a337178', 'STRUCTURED', '(a) Ethanol can be manufactured by two different processes. Process 1 sucrose $ \xrightarrow[]{stage1} $ glucose $ \xrightarrow[]{stage2} $ ethanol Process 2 ethene $ \longrightarrow $ ethanol (i) What is the general name for compounds such as sucrose and glucose? (ii) What type of reaction occurs in stage 2? (iii) What is the catalyst used in stage 2? (iv) What type of reaction occurs in process 2?', 14, 3, 1260, NULL, '1038adbd-db72-44c1-8afe-8817cead9704', 'PAST_PAPER', true, 1, '2026-09-13 12:59:08.920762+00', '55c2a084-3f93-4655-903b-e68b1394ad62');
INSERT INTO public.questions VALUES ('61adb8f4-a049-4f04-9b6f-a206299ebc24', 'q05-7a337178', 'STRUCTURED', 'Solutions of lead(II) nitrate and sodium sulfate react together to form the insoluble salt lead(II) sulfate.', 9, 3, 810, NULL, '1038adbd-db72-44c1-8afe-8817cead9704', 'PAST_PAPER', true, 1, '2026-09-13 12:59:08.921147+00', '55c2a084-3f93-4655-903b-e68b1394ad62');
