2 \mathrm {A l} + \mathrm {F e} _ {2} \mathrm {O} _ {3} \rightarrow \mathrm {A l} _ {2} \mathrm {O} _ {3} + 2 \mathrm {F e}
(a) What does this reaction show about the reactivity of iron compared to the reactivity of aluminium?
(b) Why is this reaction described as displacement?', 1, 1, '["e000061", "e000062", "e000063", "e000064", "e000065", "e000066", "e000067", "e000068", "e000069", "e000070", "e000071", "e000072", "e000073", "e000074", "e000076", "e000077", "e000078", "e000079"]', 286, NULL, NULL, NULL, '2026-09-13 12:59:08.762339+00');
INSERT INTO public.document_chunks VALUES ('ca90a3ab-a689-449c-9401-0c5ba66d0d1f', 'b6d8d758-8554-461a-aca3-8739e1561567', 4, '(c) State two reasons why the term oxidation applies to aluminium in this reaction.
