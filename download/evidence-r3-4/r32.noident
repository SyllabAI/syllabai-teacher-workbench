INSERT INTO public.document_chunks VALUES ('655a6a3c-8750-4493-a4e9-f8e20d085b4c', 'ac7d3f42-25a4-4e89-b271-70f0a5971083', 3, '$ ^{*} $ The lanthanoids (atomic numbers 58-71) and the actinoids (atomic numbers 90-103) have been omitted.
