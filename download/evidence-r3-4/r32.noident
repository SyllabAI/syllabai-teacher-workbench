INSERT INTO public.questions VALUES ('d189891b-02cd-4df1-9394-36c2c333c7f7', 'q02-25ccf10d', 'STRUCTURED', 'In chemistry, the state symbols (s), (l), (g) and (aq) are often used.', 6, 3, 540, NULL, '42b8db1a-b341-41d1-a8b4-d57a8b7ec131', 'PAST_PAPER', true, 1, '2026-09-13 12:53:12.060367+00', 'deb67747-807b-4b4a-b1e8-ab33de7b8960');
INSERT INTO public.questions VALUES ('e9bfb5ef-a590-4889-9e6f-ee00584b1405', 'q03-25ccf10d', 'STRUCTURED', 'Techniques used in the separation of mixtures include For each separation, select the most suitable technique, A, B, C or D, used to obtain the first named substance from the mixture. Each letter may be used once, more than once or not at all. A crystallisation B filtration C fractional distillation D simple distillation', 4, 3, 360, NULL, '42b8db1a-b341-41d1-a8b4-d57a8b7ec131', 'PAST_PAPER', true, 1, '2026-09-13 12:53:12.060575+00', 'deb67747-807b-4b4a-b1e8-ab33de7b8960');
INSERT INTO public.questions VALUES ('234f1d2d-e4f3-4613-b477-3990315a8eed', 'q04-25ccf10d', 'STRUCTURED', 'The table gives information about some of the elements in Group 7 of the Periodic Table.', 8, 3, 720, NULL, '42b8db1a-b341-41d1-a8b4-d57a8b7ec131', 'PAST_PAPER', true, 1, '2026-09-13 12:53:12.060924+00', 'deb67747-807b-4b4a-b1e8-ab33de7b8960');
INSERT INTO public.questions VALUES ('5d4af283-4a3b-4784-8e7b-8204ffc6c833', 'q05-25ccf10d', 'STRUCTURED', 'A student investigates the pigments found in some vegetables and fruit. She obtains some coloured vegetable and fruit extracts from carrots, tomatoes and sweet potatoes. She places a spot of each extract on chromatography paper, along with spots of the three pigments beta-carotene, chlorophyll and lycopene. Her teacher provides a solvent containing volatile, flammable organic compounds for the experiment. The diagram shows the apparatus at the start of the experiment. Key to vegetable and fruit extracts and pigments $V 1 = c a r r o t s V 2 = t o m a t o e s V 3 = s w e e t p o t a t o e s$ $\mathrm {P 1} = \mathrm {b e t a - c a r o t e n e} \quad \mathrm {P 2} = \mathrm {c h l o r o p h y l l} \quad \mathrm {P 3} = \mathrm {l y c o p e n e}$', 9, 3, 810, NULL, '42b8db1a-b341-41d1-a8b4-d57a8b7ec131', 'PAST_PAPER', true, 1, '2026-09-13 12:53:12.061181+00', 'deb67747-807b-4b4a-b1e8-ab33de7b8960');
INSERT INTO public.questions VALUES ('2371c62c-0cc6-42ae-aa84-feed8c7f8035', 'q06-25ccf10d', 'STRUCTURED', 'Hydrogen chloride is formed in the reaction between hydrogen and chlorine. The equation for the reaction is $\mathrm {H} _ {2} + \mathrm {C l} _ {2} \rightarrow 2 \mathrm {H C l}$', 10, 3, 900, NULL, '42b8db1a-b341-41d1-a8b4-d57a8b7ec131', 'PAST_PAPER', true, 1, '2026-09-13 12:53:12.061342+00', 'deb67747-807b-4b4a-b1e8-ab33de7b8960');
INSERT INTO public.questions VALUES ('4c09f419-3b01-43f2-ba1b-408ff4c29f97', 'q07-25ccf10d', 'STRUCTURED', 'The table shows the displayed formulae of some organic compounds. A B C D E F', 12, 3, 1080, NULL, '42b8db1a-b341-41d1-a8b4-d57a8b7ec131', 'PAST_PAPER', true, 1, '2026-09-13 12:53:12.061505+00', 'deb67747-807b-4b4a-b1e8-ab33de7b8960');
INSERT INTO public.questions VALUES ('a6e06a36-5205-4db0-b1bd-2a074da753c2', 'q08-25ccf10d', 'STRUCTURED', 'Neodymium is a metal used in powerful magnets.', 8, 3, 720, NULL, '42b8db1a-b341-41d1-a8b4-d57a8b7ec131', 'PAST_PAPER', true, 1, '2026-09-13 12:53:12.061657+00', 'deb67747-807b-4b4a-b1e8-ab33de7b8960');
INSERT INTO public.questions VALUES ('96ea5f90-3732-45c6-b107-4273219e5f94', 'q09-25ccf10d', 'STRUCTURED', 'A student investigates the reactions between acids and alkalis. He uses this apparatus to measure the temperature change in the reaction between dilute hydrochloric acid (HCl) and aqueous sodium hydroxide (NaOH). This is his method. add 25 $ cm^{3} $ of dilute hydrochloric acid to the polystyrene cup and record the steady temperature add some aqueous sodium hydroxide and stir the mixture record the maximum temperature of the mixture The student repeats the experiment using different volumes of aqueous sodium hydroxide.', 1, 3, 90, NULL, '42b8db1a-b341-41d1-a8b4-d57a8b7ec131', 'PAST_PAPER', true, 1, '2026-09-13 12:53:12.061818+00', 'deb67747-807b-4b4a-b1e8-ab33de7b8960');
INSERT INTO public.questions VALUES ('d8dbdb90-6690-4427-b784-2b05c39586dd', 'q06-a49dc9f1', 'STRUCTURED', 'This question is about the elements in Group 1 of the Periodic Table and their reactions with water.', 9, 3, 810, NULL, '95d60c7a-9a8f-4486-b159-dc7243c0d730', 'PAST_PAPER', true, 1, '2026-09-13 12:57:41.365993+00', 'cb84aa22-667b-4710-938f-1b7852781d8a');
