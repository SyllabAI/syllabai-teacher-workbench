INSERT INTO public.question_parts VALUES ('d325bdf2-4981-4e70-b1cc-1554cccf72f0', 'fab640db-1fce-43e7-b7df-fbd80ec518bc', 'b-iii', 'Draw a line of best fit through the first four points and another line of best fit through the last three points. Make sure that the lines cross. Height of precipitate in cm Volume of lead(II) nitrate in $ cm^{3} $', NULL, 0, 6, '2026-09-13 12:56:56.256087+00');
