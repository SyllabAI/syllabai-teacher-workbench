INSERT INTO public.question_parts VALUES ('86286343-67db-496d-8e79-d12727b7d28e', '2f786e0c-d9de-4226-994f-5e74fd055ec5', 'b', 'The formula $ \mathrm{C H_{3} C H_{2} C H_{2} C H_{2} C H_{3}} $ represents one of the compounds in crude oil.', NULL, 0, 1, '2026-09-13 12:58:26.499051+00');
INSERT INTO public.question_parts VALUES ('dfa564eb-9283-4c10-a1a0-46d21f3bdb14', '92db095e-62d3-44a7-8c60-5757b909c4ab', 'c', 'Ethanol can be converted into chloroethene, $ \mathrm{C H_{2}=C H C l} $ , in three stages. Stage 1 Ethanol is dehydrated to form ethene, $ \mathrm{C H_{2}=C H_{2}} $ Stage 2 Ethene is converted into 1,2-dichloroethane, $ \mathrm{C H_{2} C I C H_{2} C I} $ Stage 3 1,2-dichloroethane is converted into chloroethene and hydrogen chloride', NULL, 0, 4, '2026-09-13 12:58:26.162115+00');
INSERT INTO public.question_parts VALUES ('3fe9b8dd-5be7-4e69-bce6-99531cc99810', '92db095e-62d3-44a7-8c60-5757b909c4ab', 'c-i', 'Why is the reaction in Stage 1 described as dehydration?', NULL, 0, 5, '2026-09-13 12:58:26.162158+00');
INSERT INTO public.question_parts VALUES ('c1c84b43-3f40-4038-929a-2722c8405756', '92db095e-62d3-44a7-8c60-5757b909c4ab', 'c-ii', 'Identify the catalyst used in the reaction in Stage 1.', NULL, 0, 6, '2026-09-13 12:58:26.162344+00');
