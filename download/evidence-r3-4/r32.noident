-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["(c)(i)", "M1 2x14÷80 OR 0.35", "correct answer without working scores2", "2"], ["M2(0.35x100=)35(%)", "ALLOW1markfor17/17.5/18(%)", ""], ["(ii)", "An answer that links any4points:", "", "4"], ["M1(NH3)higher%ofNOR((NH4)2SO4)lower%ofN", "", ""], ["M2(NH4)2SO4easytouse(tosoil)/easyfortheplantstoabsorb/lesswastageOR(NH3)difficulttouse(tosoil)/difficultfortheplantstoabsorb/morewastage/hastobe dissolved(inwater)first", "", ""], ["M3(NH4)2SO4pHclosetothatof(rain)water/willnotalterthepH(ofthesoil/water)", "REJECTNH3hasapHclosetorainwater", ""], ["M4NH3willcause(thesoil/water)tobecomealkaline/willraisethepH(ofthesoil/water)/neutralise(thewater/soil)maystuntgrowthofplants/maydamage/killplants", "REJECTammoniacausethesoil/watertobecomeacidic", ""], ["M5NH3andor(NH4)2SO4solublesorunoff/wastageoffertiliser/waterpollution/eutrophication/leaching", "", ""], ["", "", "", "Total14"]], "text": "(c)(i) | M1 2x14÷80 OR 0.35 | correct answer without working scores2 | 2\nM2(0.35x100=)35(%) | ALLOW1markfor17/17.5/18(%) | \n(ii) | An answer that links any4points: |  | 4\nM1(NH3)higher%ofNOR((NH4)2SO4)lower%ofN |  | \nM2(NH4)2SO4easytouse(tosoil)/easyfortheplantstoabsorb/lesswastageOR(NH3)difficulttouse(tosoil)/difficultfortheplantstoabsorb/morewastage/hastobe dissolved(inwater)first |  | \nM3(NH4)2SO4pHclosetothatof(rain)water/willnotalterthepH(ofthesoil/water) | REJECTNH3hasapHclosetorainwater | \nM4NH3willcause(thesoil/water)tobecomealkaline/willraisethepH(ofthesoil/water)/neutralise(thewater/soil)maystuntgrowthofplants/maydamage/killplants | REJECTammoniacausethesoil/watertobecomeacidic | \nM5NH3andor(NH4)2SO4solublesorunoff/wastageoffertiliser/waterpollution/eutrophication/leaching |  | \n |  |  | Total14", "row_count": 9, "confidence": 1.0, "element_id": "e000039", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 39, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "figures": [], "version": 1, "sections": [{"level": 2, "title": "Edexcel and BTEC Qualifications", "sectionId": "s001", "elementIds": ["e000007"], "pageNumber": 1}, {"level": 2, "title": "Pearson: helping people progress, everywhere", "sectionId": "s002", "elementIds": ["e000009", "e000010", "e000011", "e000012", "e000013", "e000014", "e000015", "e000016", "e000017", "e000018", "e000019", "e000020", "e000021", "e000022"], "pageNumber": 1}], "equations": [], "pageCount": 1, "documentId": "34c1363d-5506-5948-9607-91b2731623ca", "provenance": {"engine": "glm-ocr-markdown", "application": "syllabai-parser", "extractedAt": "2026-09-13T12:55:49.618301739Z", "engineVersion": "1.1.0", "schemaVersion": "1.0", "extractionParams": {"pageBoundaries": "none-in-source", "sourceLineCount": 102, "upstreamConverter": "zai-glm-ocr", "entityDecodedLines": 0, "signedUrlFigureRefs": 0, "normalizedHtmlEntities": true}}, "textBlocks": [{"role": "paragraph", "text": "PMT", "confidence": 1.0, "element_id": "e000000", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 0, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Pearson Edexcel", "confidence": 1.0, "element_id": "e000001", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 1, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Mark Scheme (Results)", "confidence": 1.0, "element_id": "e000002", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 2, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Summer 2022", "confidence": 1.0, "element_id": "e000003", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 3, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Pearson Edexcel International GCSE", "confidence": 1.0, "element_id": "e000004", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 4, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "In Chemistry (4CH1) Paper 1C", "confidence": 1.0, "element_id": "e000005", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 5, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Edexcel and BTEC Qualifications", "confidence": 1.0, "element_id": "e000006", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 6, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Edexcel and BTEC qualifications are awarded by Pearson, the UK''s largest awarding body. We provide a wide range of qualifications including academic, vocational, occupational and specific programmes for employers. For further information visit our qualifications websites at www.edexcel.com or www.btec.co.uk. Alternatively, you can get in touch with us using the details on our contact us page at www.edexcel.com/contactus.", "confidence": 1.0, "element_id": "e000007", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 7, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Pearson: helping people progress, everywhere", "confidence": 1.0, "element_id": "e000008", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 8, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Pearson aspires to be the world''s leading learning company. Our aim is to help everyone progress in their lives through education. We believe in every kind of learning, for all kinds of people, wherever they are in the world. We''ve been involved in education for over 150 years, and by working across 70 countries, in 100 languages, we have built an international reputation for our commitment to high standards and raising achievement through innovation in education. Find out more about how we can help you and your students at: www.pearson.com/uk", "confidence": 1.0, "element_id": "e000009", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 9, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Summer 2022", "confidence": 1.0, "element_id": "e000010", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 10, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Question Paper Log Number P70945A", "confidence": 1.0, "element_id": "e000011", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 11, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Publications Code 4CH1_1C_2206_MS", "confidence": 1.0, "element_id": "e000012", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 12, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "All the material in this publication is copyright", "confidence": 1.0, "element_id": "e000013", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 13, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "$ \\textcircled{c} $ Pearson Education Ltd 2022", "confidence": 1.0, "element_id": "e000014", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 14, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "All candidates must receive the same treatment. Examiners must mark the first candidate in exactly the same way as they mark the last.", "confidence": 1.0, "element_id": "e000015", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 15, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Mark schemes should be applied positively. Candidates must be rewarded for what they have shown they can do rather than penalised for omissions.", "confidence": 1.0, "element_id": "e000016", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 16, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Examiners should mark according to the mark scheme not according to their perception of where the grade boundaries may lie.", "confidence": 1.0, "element_id": "e000017", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 17, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "There is no ceiling on achievement. All marks on the mark scheme should be used appropriately.", "confidence": 1.0, "element_id": "e000018", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 18, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "All the marks on the mark scheme are designed to be awarded. Examiners should always award full marks if deserved, i.e. if the answer matches the mark scheme. Examiners should also be prepared to award zero marks if the candidate''s response is not worthy of credit according to the mark scheme.", "confidence": 1.0, "element_id": "e000019", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 19, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Where some judgement is required,mark schemes will provide the principles by which marks will be awarded and exemplification may be limited.", "confidence": 1.0, "element_id": "e000020", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 20, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "When examiners are in doubt regarding the application of the mark scheme to a candidate''s response,the team leader must be consulted.", "confidence": 1.0, "element_id": "e000021", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 21, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Crossed out work should be marked UNLESS the candidate has replaced it with an alternative response.", "confidence": 1.0, "element_id": "e000022", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 22, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "schemaVersion": "1.0"}', NULL, '2026-09-13 12:56:10.270125+00');
INSERT INTO public.documents VALUES ('1f57c0bc-a6ac-4a44-b5cc-bc488ee6dead', 'a44a4e4c-bfba-5c09-b54a-1101049d015d', '1.0', 1, 'QUESTION_PAPER', 'corpus/igcse-chemistry-4ch0-1c-2022junr/QP.md', 'QP.md', 'text/markdown', 'a0219100209339840bfceee1a7dd459e65eacd462bb849f60b01bbaf1992d898', 'SHA-256', 1, 213, 196, 14, 'glm-ocr-markdown', '1.1.0', '2026-09-13 12:55:50.355863+00', '{"pages": [{"width": null, "height": null, "pageNumber": 1}], "source": {"uri": "corpus/igcse-chemistry-4ch0-1c-2022junr/QP.md", "checksum": "a0219100209339840bfceee1a7dd459e65eacd462bb849f60b01bbaf1992d898", "fileName": "QP.md", "mimeType": "text/markdown", "checksumAlgorithm": "SHA-256"}, "tables": [{"rows": [["Please check the examination details below before entering your candidate information"], ["Candidate surname", "Other names"], ["Centre Number", "Candidate Number"], ["Pearson Edexcel International GCSE (9-1)"], ["Time 2 hours", "Paper reference", "4CH1/1CR 4SD0/1CR"], ["Chemistry\nUNIT: 4CH1\nScience (Double Award) 4SD0\nPAPER: 1CR"], ["You must have:\nCalculator, ruler", "Total Marks"]], "text": "Please check the examination details below before entering your candidate information\nCandidate surname | Other names\nCentre Number | Candidate Number\nPearson Edexcel International GCSE (9-1)\nTime 2 hours | Paper reference | 4CH1/1CR 4SD0/1CR\nChemistry\nUNIT: 4CH1\nScience (Double Award) 4SD0\nPAPER: 1CR\nYou must have:\nCalculator, ruler | Total Marks", "row_count": 7, "confidence": 1.0, "element_id": "e000000", "page_number": 1, "bounding_box": null, "column_count": 1, "element_type": "table", "reading_order": 0, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["7Li lithium3", "9Be beryllium4", "Key", "4He helium2"], ["23Na sodium11", "24Mg magnesium12", "relative atomic mass atomic symbol atomic (proton) number", "20Ne neon10"], ["39K potassium19", "40Ca calcium20", "45Sc scandium21", "48Ti titanium22", "51V vanadium23", "52Cr chromium24", "55Mn mang