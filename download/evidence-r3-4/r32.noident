INSERT INTO public.question_parts VALUES ('653f265b-e338-4678-b9e8-ceb5121d95d5', '65355ad4-7557-4035-80df-54307fde829c', 'd', 'Some fuel oil undergoes catalytic cracking. This involves the conversion of long-chain alkanes into alkenes and short-chain alkanes.', NULL, 0, 3, '2026-09-13 12:53:11.614625+00');
