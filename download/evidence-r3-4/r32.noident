ance": [{"kind": "note", "text": "i"}, {"kind": "note", "text": "M1"}, {"kind": "note", "text": "bubbles / fizzing / effervescence"}, {"kind": "note", "text": "Accept gas formed /given off"}, {"kind": "ignore", "text": "Ignore any name or formula"}, {"kind": "note", "text": "M2"}, {"kind": "note", "text": "iron/solid disappears OR green/colourless solution (forms)"}, {"kind": "note", "text": "Accept iron/solid gets smaller / dissolves"}, {"kind": "ignore", "text": "Ignore references to heat change / change in pH"}, {"kind": "note", "text": "ii"}, {"kind": "note", "text": "iron sulfate AND hydrogen (in either order)"}, {"kind": "note", "text": "Penalise oxidation states other than (II)"}, {"kind": "note", "text": "Accept ferrous sulfate"}, {"kind": "note", "text": "Reject ferric sulfate"}, {"kind": "note", "text": "b"}, {"kind": "note", "text": "2(1)2"}, {"kind": "note", "text": "Accept multiples and fractions"}, {"kind": "note", "text": "c"}, {"kind": "note", "text": "i"}, {"kind": "note", "text": "M1M2"}, {"kind": "note", "text": "white blue"}, {"kind": "ignore", "text": "Ignore colourlessIgnore all qualifiers such as pale / dark"}, {"kind": "note", "text": "ii"}, {"kind": "note", "text": "D"}, {"kind": "note", "text": "iii"}, {"kind": "note", "text": "M1M2"}, {"kind": "note", "text": "boiling point / melting/freezing point100℃/0℃"}, {"kind": "note", "text": "Accept just° or C but not just numberValue must match propertyAccept correct values in KIgnore other physical properties such as pH / density"}], "answerText": "a", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "3", "marks": 1, "number": 3, "entryId": "ms-cd35c495-q3", "guidance": [{"kind": "note", "text": "i"}, {"kind": "note", "text": "low density / less dense than air"}, {"kind": "note", "text": "Accept lighter than air / the lightest gas but not just light / lightweight"}, {"kind": "note", "text": "ii"}, {"kind": "note", 