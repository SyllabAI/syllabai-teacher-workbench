INSERT INTO public.questions VALUES ('80fbe778-5f4a-4b03-892b-620472858e0f', 'q03-c64b6fb8', 'STRUCTURED', 'Sulfur dioxide $ \left( \mathrm{S O}_{2} \right) $ and hydrogen sulfide $ \left( \mathrm{H}_{2} \mathrm{S} \right) $ are both gases. The two gases react together to form solid sulfur and water.', 8, 3, 720, NULL, '914f7ed8-2950-415d-9cbe-6a4c1956defe', 'PAST_PAPER', true, 1, '2026-09-13 13:02:53.718386+00', '17410381-8b62-4842-8361-479033de8ff6');
