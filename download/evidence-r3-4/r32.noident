INSERT INTO public.questions VALUES ('ca8ab610-3907-42c2-b14b-f4e1f6a7ab2e', 'q01-3815dec0', 'STRUCTURED', 'A student investigates some food colourings, each of which is made up of one or more dyes. She produces a chromatogram using the safe colourings red (SR), blue (SB) and green (SG) and food colourings red (FR), blue (FB) and green (FG). The diagram shows her chromatogram. reference line', 3, 3, 270, NULL, '2a42a372-d7b7-4e4d-bb37-bb4b72d68736', 'PAST_PAPER', true, 1, '2026-09-13 12:58:26.819389+00', '3e181da0-80f7-4736-a8e0-8a078a560c42');
INSERT INTO public.questions VALUES ('b0fc8b78-3054-4b35-b2bc-14fa69887d26', 'q02-3815dec0', 'STRUCTURED', 'This apparatus is used to separate a mixture of ethanol (boiling point 78 $ ^{\circ} \mathrm{C} $) and water (boiling point 100 $ ^{\circ} \mathrm{C} $).', 4, 3, 360, NULL, '2a42a372-d7b7-4e4d-bb37-bb4b72d68736', 'PAST_PAPER', true, 1, '2026-09-13 12:58:26.819866+00', '3e181da0-80f7-4736-a8e0-8a078a560c42');
