INSERT INTO public.question_parts VALUES ('69f40ea7-61fc-4a03-81cb-ea69d7394717', 'ea64a946-123a-4c5a-8fd8-ed10856ccb98', 'b-iii', 'The student draws an energy level diagram for the complete combustion of methanol. $\begin{array}{c c} \mathrm {e n e r g y} & \mathrm {c a r b o n d i o x i d e} \\ \hline \mathrm {m e t h a n o l} & \mathrm {c a r b o n d i o x i d e} \\ \end{array}$ Identify the two mistakes in his diagram.', NULL, 0, 6, '2026-09-13 12:59:56.393947+00');
INSERT INTO public.question_parts VALUES ('f7254939-6562-4344-a499-08ae8b90945c', 'ea64a946-123a-4c5a-8fd8-ed10856ccb98', 'c', 'The student is given this table of average (mean) bond energies. The equation for the complete combustion of methanol is $\mathrm {H} - \mathrm {C} - \mathrm {O} - \mathrm {H} + 1. 5 \mathrm {O} = \mathrm {O} \rightarrow \mathrm {O} = \mathrm {C} = \mathrm {O} + 2 \mathrm {H} - \mathrm {O} - \mathrm {H}$ Use this equation and the information in the table to calculate another value for the molar enthalpy change, $ \Delta H $ , for the combustion of methanol. $\Delta H =$ Every effort has been made to contact copyright holders to obtain their permission for the use of copyright material. Pearson Education Ltd. will, if notified, be happy to rectify any errors or omissions and include any such rectifications in future editions.', NULL, 0, 7, '2026-09-13 12:59:56.393982+00');
