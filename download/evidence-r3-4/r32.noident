INSERT INTO public.question_versions VALUES ('7cf54b3a-2ffb-482b-82e5-6461725d3f6b', 'd45e6feb-1f8f-47f5-ad58-f7234544b8c1', 1, 'Potassium and lithium are Group 1 metals that exist as isotopes.', 11, 3, 990, NULL, 'SUGGESTED', '1a97e8dd-750d-5c9f-966d-c2a08df67fe3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:55.964869+00');
INSERT INTO public.question_versions VALUES ('a5b6b77b-3994-493a-a654-16a14aa5be3f', '1bd6a0ff-b8cc-4ebf-8c71-bbac3a79fe77', 1, 'Lithium hydroxide (LiOH) and lithium peroxide $ \left( \mathrm{L i}_{2} \mathrm{O}_{2} \right) $ have been used in spacecraft to remove the carbon dioxide astronauts breathe out. The equations for the reactions with carbon dioxide are $2 \mathrm {L i O H} + \mathrm {C O} _ {2} \rightarrow \mathrm {L i} _ {2} \mathrm {C O} _ {3} + \mathrm {H} _ {2} \mathrm {O}$ $2 \mathrm {L i} _ {2} \mathrm {O} _ {2} + 2 \mathrm {C O} _ {2} \rightarrow 2 \mathrm {L i} _ {2} \mathrm {C O} _ {3} + \mathrm {O} _ {2}$', 1, 3, 90, NULL, 'SUGGESTED', '1a97e8dd-750d-5c9f-966d-c2a08df67fe3', 0.45, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:55.965223+00');
INSERT INTO public.question_versions VALUES ('36a68289-b1c7-4ff4-bcdc-ef3f3b0bb970', 'e6790006-0009-4b96-8348-70fd75098269', 1, 'This question is about the laboratory preparation of salts.', 14, 3, 1260, NULL, 'SUGGESTED', '1a97e8dd-750d-5c9f-966d-c2a08df67fe3', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:55.965575+00');
INSERT INTO public.question_versions VALUES ('ad9b508e-f837-4b1e-b0fb-40ae9f5e48c0', '088c2ebb-e1fa-43cd-92c9-0ee6c2b447ab', 1, 'The box contains the names of some substances. Choose a substance from the box that best matches each description. Each substance may be used once, more than once or not at all.', 5, 3, 450, NULL, 'SUGGESTED', '24df1df1-76c7-51e1-88c7-1ff3dd24bf7e', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:56.202805+00');
INSERT INTO public.question_versions VALUES ('ce86bf77-ed13-490a-9d69-e53b058f6bfd', '83257722-1fc9-49a0-b53d-76b310edf27a', 1, 'Oxides can be made by burning elements in air. The table gives some information about the oxides of four elements.', 6, 3, 540, NULL, 'SUGGESTED', '24df1df1-76c7-51e1-88c7-1ff3dd24bf7e', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:56.203219+00');
INSERT INTO public.question_versions VALUES ('b98680ac-eda3-4f0b-8b01-b39b46dd4fcf', '2fcb3ee8-da8c-42cc-8f66-b4c40816273e', 1, 'This question is about the reactivity of metals.', 8, 3, 720, NULL, 'SUGGESTED', '24df1df1-76c7-51e1-88c7-1ff3dd24bf7e', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:56.203522+00');
