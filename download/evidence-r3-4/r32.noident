INSERT INTO public.question_parts VALUES ('a1956458-11a8-4c4c-9ba8-5cd3b14d6404', '9d893a1b-db33-4bf0-a722-7403d77c2c9e', 'b-iv', 'The ionic half-equation for the reaction at the negative electrode in stage 4 is $\mathrm {M g} ^ {2 +} + 2 \mathrm {e} ^ {-} \rightarrow \mathrm {M g}$ Write the ionic half-equation for the reaction at the positive electrode.', NULL, 0, 5, '2026-09-13 12:59:09.40165+00');
INSERT INTO public.question_parts VALUES ('956931cd-5bde-4c8e-a76e-2d82a71496f0', '9d893a1b-db33-4bf0-a722-7403d77c2c9e', 'c', 'A manufacturer makes a batch of magnesium by electrolysing magnesium chloride.', NULL, 0, 6, '2026-09-13 12:59:09.401705+00');
INSERT INTO public.question_parts VALUES ('1c135928-e683-4e2e-9bf5-7eb625f6d432', '9d893a1b-db33-4bf0-a722-7403d77c2c9e', 'c-i', 'Calculate the mass of magnesium chloride $ \mathrm{(M g C l_{2})} $ needed to make 48 kg of magnesium.', NULL, 0, 7, '2026-09-13 12:59:09.401754+00');
INSERT INTO public.question_parts VALUES ('a514cf18-2b29-4924-9508-e4186601eb8e', '9d893a1b-db33-4bf0-a722-7403d77c2c9e', 'c-ii', 'Calculate the amount, in moles, of electrons needed to make 48 kg of magnesium.', NULL, 0, 8, '2026-09-13 12:59:09.401802+00');
INSERT INTO public.question_parts VALUES ('bb189e7c-200b-4bcb-935a-ca0b20d87780', '9d893a1b-db33-4bf0-a722-7403d77c2c9e', 'd', 'Magnesium oxide can be used to make magnesium sulfate by this reaction. $\mathrm {M g O (s)} + \mathrm {H} _ {2} \mathrm {S O} _ {4} (\mathrm {a q}) \rightarrow \mathrm {M g S O} _ {4} (\mathrm {a q}) + \mathrm {H} _ {2} \mathrm {O (I)}$ A student is provided with a beaker of dilute sulfuric acid. Outline the steps she should use to obtain a pure sample of hydrated magnesium sulfate crystals using this reaction. Every effort has been made to contact copyright holders to obtain their permission for the use of copyright material. Pearson Education Ltd. will, if notified, be happy to rectify any errors or omissions and include any such rectifications in future editions.', NULL, 0, 9, '2026-09-13 12:59:09.401834+00');
INSERT INTO public.question_parts VALUES ('4bf038db-1923-4e2d-933a-0138ce81851d', '172a9a9e-ed8e-42ab-91e0-4e8d11b53c0a', 'a', 'Complete the table to show the name of the quantity that can be measured by each piece of apparatus, and a common unit used for that quantity. One example of each has been done for you.', NULL, 0, 0, '2026-09-13 12:59:09.565661+00');
