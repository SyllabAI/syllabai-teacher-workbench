INSERT INTO public.questions VALUES ('fb879746-d661-4dac-a184-a798194aaa8e', 'q04-7682f9e7', 'STRUCTURED', 'A solution of hydrogen peroxide decomposes when a catalyst of manganese(IV) oxide is added. The products of the reaction are water and oxygen.', 14, 3, 1260, NULL, 'c6052352-0263-4d33-b606-b0febf011eeb', 'PAST_PAPER', true, 1, '2026-09-13 12:55:23.68171+00', '0d1e83c1-a893-422f-92ab-cc062f8a44e3');
INSERT INTO public.questions VALUES ('209c055d-39cf-4693-879b-19d4aefd1467', 'q05-7682f9e7', 'STRUCTURED', '(a) The diagram shows the displayed formula of the organic compound methanol, $ \mathrm{C H_{3} O H} $ (i) Determine the number of atoms in one molecule of methanol. (ii) State why methanol is not a hydrocarbon.', 1, 3, 90, NULL, 'c6052352-0263-4d33-b606-b0febf011eeb', 'PAST_PAPER', true, 1, '2026-09-13 12:55:23.682034+00', '0d1e83c1-a893-422f-92ab-cc062f8a44e3');
