INSERT INTO public.question_parts VALUES ('29b2126f-25e6-4e71-a3e7-fd42c8ffa2f1', 'b16c4d2a-7c7b-4e65-bb71-059a57c29c9f', 'a', 'The table gives some information about the first four elements in Group 0.', NULL, 0, 0, '2026-09-13 12:54:39.715693+00');
