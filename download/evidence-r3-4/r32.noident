INSERT INTO public.question_versions VALUES ('a260160e-3688-4a44-91c4-4b48ab4496ea', '5dfac153-13d5-41f0-8cba-7bd71f68ed8b', 1, 'A student does some experiments to find the heat energy released when natural gas burns. She uses this apparatus.', 15, 3, 1350, NULL, 'SUGGESTED', '7a337178-d58f-5b51-8355-63df0327ca7c', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:59:08.921741+00');
