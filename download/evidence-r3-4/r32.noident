INSERT INTO public.question_parts VALUES ('0f19f09b-ba6c-4b61-915e-2c116733d50a', 'b16c4d2a-7c7b-4e65-bb71-059a57c29c9f', 'c-iii', 'Explain whether or not a reaction takes place when bromine water is added to sodium chloride solution.', NULL, 0, 7, '2026-09-13 12:54:39.716091+00');
INSERT INTO public.question_parts VALUES ('8e439741-9bcb-4535-9582-c39b0d69720f', 'b16c4d2a-7c7b-4e65-bb71-059a57c29c9f', 'c-iv', 'The displacement reaction between potassium iodide and chlorine can be represented by the ionic equation $2 \mathrm {I} ^ {-} + \mathrm {C l} _ {2} \rightarrow \mathrm {I} _ {2} + 2 \mathrm {C l} ^ {-}$ Explain why this is described as a redox reaction.', NULL, 0, 8, '2026-09-13 12:54:39.716145+00');
