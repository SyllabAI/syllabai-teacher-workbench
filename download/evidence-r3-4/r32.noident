INSERT INTO public.questions VALUES ('461a07ac-7f10-43c1-ba36-a2ee11d1aab2', 'q04-c937af6f', 'STRUCTURED', 'A teacher uses this apparatus to find the percentage of oxygen in a gaseous mixture of oxygen and argon. This is the teacher''s method. Step 1 heat the copper powder Step 2 push the plunger on syringe A to pass the mixture of oxygen and argon over the hot copper so that the mixture moves into syringe B Step 3 push the plunger on syringe B to pass the mixture of oxygen and argon over the hot copper so that the mixture moves into syringe A Step 4 record the reading on syringe A Step 5 repeat Steps 2, 3 and 4 a number of times The volume of gas decreases as the oxygen reacts with the copper. Argon is unreactive so does not react with the copper. The copper powder turns black.', 8, 3, 720, NULL, '147adf7e-ddfa-4cb3-a9c8-d6a73c3924c2', 'PAST_PAPER', true, 1, '2026-09-13 12:56:09.797573+00', 'b8da760e-7fab-430e-8503-ab90deba1d82');
