INSERT INTO public.questions VALUES ('f1e30b42-71cd-471b-802a-7e9fbcd43938', 'q02-a28db1ae', 'STRUCTURED', 'This question is about elements in Group 7 and their compounds. The table gives information about some of these elements.', 9, 3, 810, NULL, '3e6ec412-855f-4035-8b01-0ef74f105bd3', 'PAST_PAPER', true, 1, '2026-09-13 13:01:26.427394+00', 'eb588b9a-dd71-4197-b667-428d1f5af3ae');
INSERT INTO public.questions VALUES ('3dfab673-1570-49bb-a875-03a780103db1', 'q03-a28db1ae', 'STRUCTURED', '(a) Explain why metals conduct electricity but covalent compounds do not conduct electricity.', 13, 3, 1170, NULL, '3e6ec412-855f-4035-8b01-0ef74f105bd3', 'PAST_PAPER', true, 1, '2026-09-13 13:01:26.427636+00', 'eb588b9a-dd71-4197-b667-428d1f5af3ae');
INSERT INTO public.questions VALUES ('e1e4ad9e-b20b-455f-9cdb-53a80bcc511f', 'q04-a28db1ae', 'STRUCTURED', 'This question is about alcohols, carboxylic acids and esters.', 7, 3, 630, NULL, '3e6ec412-855f-4035-8b01-0ef74f105bd3', 'PAST_PAPER', true, 1, '2026-09-13 13:01:26.427935+00', 'eb588b9a-dd71-4197-b667-428d1f5af3ae');
INSERT INTO public.questions VALUES ('dda73d31-8f36-44b2-921c-ac669d7ebe82', 'q01-53711967', 'STRUCTURED', 'The diagram represents a particle of ammonia.', 3, 3, 270, NULL, 'd5bd43f8-06e9-462d-b8f9-50854cf0026a', 'PAST_PAPER', true, 1, '2026-09-13 12:59:09.203183+00', 'bc4d84a5-da0e-4532-b04b-b2c79be235ae');
INSERT INTO public.questions VALUES ('4167af29-a507-40ad-a5d4-5ef47c2a50f8', 'q02-53711967', 'STRUCTURED', 'The solubility of a solid in water is the maximum mass of the solid that can dissolve in 100 g of water at a given temperature. An aqueous solution containing this maximum mass can be described as a saturated solution. The graph shows the solubilities of three solids at different temperatures.', 4, 3, 360, NULL, 'd5bd43f8-06e9-462d-b8f9-50854cf0026a', 'PAST_PAPER', true, 1, '2026-09-13 12:59:09.203706+00', 'bc4d84a5-da0e-4532-b04b-b2c79be235ae');
INSERT INTO public.questions VALUES ('009e705c-cfe6-4cf7-bc78-e62c75f8130b', 'q03-53711967', 'STRUCTURED', 'The diagram shows how iron is produced in a blast furnace.', 10, 3, 900, NULL, 'd5bd43f8-06e9-462d-b8f9-50854cf0026a', 'PAST_PAPER', true, 1, '2026-09-13 12:59:09.204063+00', 'bc4d84a5-da0e-4532-b04b-b2c79be235ae');
INSERT INTO public.questions VALUES ('a59e5d79-8949-40bf-b621-b575c2ced82e', 'q04-53711967', 'STRUCTURED', '(a) Wine can be made from grapes. The grapes are crushed to produce an aqueous solution containing glucose. Yeast is then added to this solution. The solution is kept at a constant temperature for a period of time. The glucose is converted into ethanol. (i) Name the process in which glucose is converted into ethanol. (ii) What is the purpose of the yeast?', 1, 3, 90, NULL, 'd5bd43f8-06e9-462d-b8f9-50854cf0026a', 'PAST_PAPER', true, 1, '2026-09-13 12:59:09.204369+00', 'bc4d84a5-da0e-4532-b04b-b2c79be235ae');
INSERT INTO public.questions VALUES ('776970d6-fa64-4ba1-a44c-0b25e6ab8de8', 'q05-53711967', 'STRUCTURED', 'A student uses this apparatus to investigate the temperature change that occurs when potassium hydroxide is dissolved in water. She uses this method. pour $ 5 0 \mathrm{c m}^{3} $ of water into the polystyrene cup and measure the temperature of the water add 3g of potassium hydroxide and stir record the highest temperature of the solution', 5, 3, 450, NULL, 'd5bd43f8-06e9-462d-b8f9-50854cf0026a', 'PAST_PAPER', true, 1, '2026-09-13 12:59:09.204712+00', 'bc4d84a5-da0e-4532-b04b-b2c79be235ae');
INSERT INTO public.questions VALUES ('a80e1882-5e6e-490a-8b40-7776c5af722e', 'q06-53711967', 'STRUCTURED', 'Potassium sulfide is an ionic compound.', 7, 3, 630, NULL, 'd5bd43f8-06e9-462d-b8f9-50854cf0026a', 'PAST_PAPER', true, 1, '2026-09-13 12:59:09.206894+00', 'bc4d84a5-da0e-4532-b04b-b2c79be235ae');
INSERT INTO public.questions VALUES ('b6c426f2-5da3-4daf-ba5b-e6052425f74b', 'q07-53711967', 'STRUCTURED', 'Sulfuric acid can be manufactured from sulfur in a four-stage process. stage 1 sulfur is burned in air to form sulfur dioxide $S + O _ {2} \rightarrow S O _ {2}$ stage 2 the sulfur dioxide is reacted with more oxygen to form sulfur trioxide $\mathrm {S O} _ {2} + \frac {1}{2} \mathrm {O} _ {2} \rightarrow \mathrm {S O} _ {3}$ stage 3 the sulfur trioxide is absorbed in concentrated sulfuric acid to make oleum $\mathrm {S O} _ {3} + \mathrm {H} _ {2} \mathrm {S O} _ {4} \rightarrow \mathrm {H} _ {2} \mathrm {S} _ {2} \mathrm {O} _ {7}$ stage 4 the oleum is carefully diluted with water to form sulfuric acid', 1, 3, 90, NULL, 'd5bd43f8-06e9-462d-b8f9-50854cf0026a', 'PAST_PAPER', true, 1, '2026-09-13 12:59:09.207385+00', 'bc4d84a5-da0e-4532-b04b-b2c79be235ae');
INSERT INTO public.questions VALUES ('6a3b22d1-131f-44ec-8977-712ef7e7b901', 'q08-53711967', 'STRUCTURED', 'A student is supplied with aqueous solutions of these substances. bromine chlorine iodine potassium bromide potassium chloride potassium iodide Describe two experiments the student could perform, using some of the solutions, to show the order of reactivity of bromine, chlorine and iodine. Your answer should include the observations that the student would expect to make, and a chemical equation for one of the reactions.', 5, 3, 450, NULL, 'd5bd43f8-06e9-462d-b8f9-50854cf0026a', 'PAST_PAPER', true, 1, '2026-09-13 12:59:09.207767+00', 'bc4d84a5-da0e-4532-b04b-b2c79be235ae');
INSERT INTO public.questions VALUES ('155bcfb5-4e0d-4508-b395-ce56952667f6', 'q09-53711967', 'STRUCTURED', 'Nitrogen dioxide $ \left( \mathrm{N O}_{2} \right) $ is a brown gas. Dinitrogen tetraoxide $ \left(\mathrm{N}_{2} \mathrm{O}_{4}\right) $ is a colourless gas. The two gases can exist together in dynamic equilibrium according to the equation $2 \mathrm {N O} _ {2} (\mathrm {g}) \rightleftharpoons \mathrm {N} _ {2} \mathrm {O} _ {4} (\mathrm {g}) \quad \Delta H = - 5 8 \mathrm {k J / m o l}$ A mixture of nitrogen dioxide gas and dinitrogen tetraoxide gas is allowed to reach equilibrium in a sealed container at $ 2 0^{\circ} \mathrm{C} $ . This equilibrium mixture is brown in colour.', 5, 3, 450, NULL, 'd5bd43f8-06e9-462d-b8f9-50854cf0026a', 'PAST_PAPER', true, 1, '2026-09-13 12:59:09.208079+00', 'bc4d84a5-da0e-4532-b04b-b2c79be235ae');
INSERT INTO public.questions VALUES ('2dd38167-5c66-4a2c-b18b-89cc1ebb41c0', 'q05-a28db1ae', 'STRUCTURED', 'Hydrogen peroxide solution decomposes slowly at room temperature to form water and oxygen. The equation for the reaction is $2 \mathrm {H} _ {2} \mathrm {O} _ {2} \rightarrow 2 \mathrm {H} _ {2} \mathrm {O} + \mathrm {O} _ {2}$', 1, 3, 90, NULL, '3e6ec412-855f-4035-8b01-0ef74f105bd3', 'PAST_PAPER', true, 1, '2026-09-13 13:01:26.428164+00', 'eb588b9a-dd71-4197-b667-428d1f5af3ae');
INSERT INTO public.questions VALUES ('10b50d08-294f-489d-bc59-645dfc217d91', 'q06-a28db1ae', 'STRUCTURED', 'A student does a titration using dilute sulfuric acid to find the concentration of a solution of potassium hydroxide. The student adds $ 2 5. 0 \mathrm{c m}^{3} $ of the potassium hydroxide solution to a conical flask. He then adds a few drops of methyl orange indicator. The student does the titration four times.', 1, 3, 90, NULL, '3e6ec412-855f-4035-8b01-0ef74f105bd3', 'PAST_PAPER', true, 1, '2026-09-13 13:01:26.428369+00', 'eb588b9a-dd71-4197-b667-428d1f5af3ae');
INSERT INTO public.questions VALUES ('a2dbbe19-9ac2-49f2-8e95-23dd7acfd33c', 'q07-a28db1ae', 'STRUCTURED', 'A sample of a gaseous hydrocarbon, X, has a volume of $ 6 0 0 \mathrm{c m}^{3} $ at room temperature and pressure (rtp).', 1, 3, 90, NULL, '3e6ec412-855f-4035-8b01-0ef74f105bd3', 'PAST_PAPER', true, 1, '2026-09-13 13:01:26.452579+00', 'eb588b9a-dd71-4197-b667-428d1f5af3ae');
INSERT INTO public.questions VALUES ('f3a6379d-c26d-4c0f-8c0c-ce303316b4c2', 'q08-a28db1ae', 'STRUCTURED', 'This question is about ammonia gas, $ \mathrm{N H_{3}} $', 7, 3, 630, NULL, '3e6ec412-855f-4035-8b01-0ef74f105bd3', 'PAST_PAPER', true, 1, '2026-09-13 13:01:26.453295+00', 'eb588b9a-dd71-4197-b667-428d1f5af3ae');
INSERT INTO public.questions VALUES ('0e386c90-b272-483f-bcba-2440c23bc2e3', 'q04-d9f7c281', 'STRUCTURED', 'A student does a titration to find the concentration of potassium hydroxide solution. This is the student''s method. add $ 2 5. 0 \mathrm{c m}^{3} $ of the potassium hydroxide solution to a conical flask add a few drops of methyl orange indicator to the conical flask fill a burette with dilute sulfuric acid and record the initial burette reading place the conical flask on a white tile add the acid from the burette to the mixture in the conical flask, swirling the flask continuously when the indicator changes colour at the end point, record the final burette reading Repeat the titration to obtain concordant results.', 1, 3, 90, NULL, '1eadc1ae-d0f5-405f-9a3c-bbfcb58eeb34', 'PAST_PAPER', true, 1, '2026-09-13 13:03:38.504823+00', '6538f327-91b4-4cfb-beef-f401554e16b6');
INSERT INTO public.questions VALUES ('d08e7d9f-0cf9-4233-9b02-a48a3d83b372', 'q06-d9f7c281', 'STRUCTURED', 'Ethanoic acid reacts with methanol to form an ester. The equation shows the displayed formulae for the reactants and products. $\begin{array}{l} \mathrm {H} \mathrm {C} \mathrm {C} \mathrm {O} \mathrm {H} + \mathrm {H} \mathrm {C} \mathrm {O} \mathrm {H} \rightarrow \mathrm {H} \mathrm {C} \mathrm {C} \mathrm {O} \mathrm {C} \mathrm {H} + \mathrm {H} \mathrm {O} \mathrm {H} \\ \mathrm {H} \\ \end{array}$', 6, 3, 540, NULL, '1eadc1ae-d0f5-405f-9a3c-bbfcb58eeb34', 'PAST_PAPER', true, 1, '2026-09-13 13:03:38.505314+00', '6538f327-91b4-4cfb-beef-f401554e16b6');
INSERT INTO public.questions VALUES ('171b0598-057d-494f-9679-989f3ad13ff1', 'q07-d9f7c281', 'STRUCTURED', 'Methane reacts with steam to form carbon monoxide and hydrogen. This is the equation for the reaction. $\mathrm {C H} _ {4} (\mathrm {g}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {g}) \rightleftharpoons \mathrm {C O} (\mathrm {g}) + 3 \mathrm {H} _ {2} (\mathrm {g}) \quad \Delta H = + 2 0 6 \mathrm {k J / m o l}$', 11, 3, 990, NULL, '1eadc1ae-d0f5-405f-9a3c-bbfcb58eeb34', 'PAST_PAPER', true, 1, '2026-09-13 13:03:38.50558+00', '6538f327-91b4-4cfb-beef-f401554e16b6');
INSERT INTO public.questions VALUES ('20d07066-4751-4519-a8f7-94f3f6322a99', 'q01-ac266f2c', 'STRUCTURED', 'The table shows the numbers of protons, neutrons and electrons in some atoms and ions.', 7, 3, 630, NULL, '18b12ba8-345a-4c21-920e-2f3628b93aba', 'PAST_PAPER', true, 1, '2026-09-13 12:59:09.386017+00', 'b0df0662-1360-4579-a62a-a589edcd9855');
INSERT INTO public.questions VALUES ('111dd417-06ce-4a25-b905-678dcab63746', 'q02-ac266f2c', 'STRUCTURED', 'The equation for the thermal decomposition of copper(II) carbonate is $\mathrm {C u C O} _ {3} (\mathrm {s}) \rightarrow \mathrm {C u O} (\mathrm {s}) + \mathrm {C O} _ {2} (\mathrm {g})$ She uses this method. weigh the crucible, lid and copper(II) carbonate heat the crucible, lid and contents for 2 minutes allow to cool and then reweigh heat for a second period of 2 minutes allow to cool and then reweigh heat for a third period of 2 minutes allow to cool and then reweigh The table shows the student''s results. A student investigates the decomposition of copper(II) carbonate using this apparatus.', 1, 3, 90, NULL, '18b12ba8-345a-4c21-920e-2f3628b93aba', 'PAST_PAPER', true, 1, '2026-09-13 12:59:09.386525+00', 'b0df0662-1360-4579-a62a-a589edcd9855');
INSERT INTO public.questions VALUES ('0dcaff67-99ac-4ed7-be44-8a55180c25a1', 'q03-ac266f2c', 'STRUCTURED', 'This question is about halogens and halides.', 10, 3, 900, NULL, '18b12ba8-345a-4c21-920e-2f3628b93aba', 'PAST_PAPER', true, 1, '2026-09-13 12:59:09.386973+00', 'b0df0662-1360-4579-a62a-a589edcd9855');
INSERT INTO public.questions VALUES ('99fd93d2-d944-4dfe-a3ae-4050d58d95a1', 'q04-ac266f2c', 'STRUCTURED', 'The scheme shows some reactions involving ethanol.', 10, 3, 900, NULL, '18b12ba8-345a-4c21-920e-2f3628b93aba', 'PAST_PAPER', true, 1, '2026-09-13 12:59:09.387299+00', 'b0df0662-1360-4579-a62a-a589edcd9855');
INSERT INTO public.questions VALUES ('3f61b4d6-c8c0-4940-a14d-93cc95d7504c', 'q05-ac266f2c', 'STRUCTURED', 'A student uses this apparatus to measure the temperature change when lithium iodide dissolves in water. He measures the steady temperature of the water before adding the lithium iodide. He then adds the lithium iodide, stirs the mixture until all the solid dissolves and records the maximum temperature reached. The diagram shows the thermometer readings before and after dissolving the lithium iodide.', 1, 3, 90, NULL, '18b12ba8-345a-4c21-920e-2f3628b93aba', 'PAST_PAPER', true, 1, '2026-09-13 12:59:09.387644+00', 'b0df0662-1360-4579-a62a-a589edcd9855');
INSERT INTO public.questions VALUES ('e6e75c4e-b26c-4186-90e5-580fd87a5afd', 'q06-ac266f2c', 'STRUCTURED', 'Magnesium and its compounds have many uses. Magnesium is never found as an element in the Earth''s crust, but its compounds occur naturally in rocks and seawater.', 14, 3, 1260, NULL, '18b12ba8-345a-4c21-920e-2f3628b93aba', 'PAST_PAPER', true, 1, '2026-09-13 12:59:09.388001+00', 'b0df0662-1360-4579-a62a-a589edcd9855');
INSERT INTO public.questions VALUES ('a126cfc4-1d63-4d14-b3fe-2be88d7d78cb', 'q01-f37697b2', 'STRUCTURED', 'Use the Periodic Table to help you answer this question.', 6, 3, 540, NULL, '1d8c6b3c-b693-4155-8fd3-a287cdc29a1b', 'PAST_PAPER', true, 1, '2026-09-13 13:02:53.412644+00', '065f2ced-0e47-4744-92d5-a46ed2cdd962');
