INSERT INTO public.question_parts VALUES ('91ee4c66-449d-4a9f-a14a-ca4121d8f8a6', '4a0830c2-8338-491c-bddb-cfd73a18e193', 'b-ii', 'What is the formula of the cation in the electrolyte? A $ \mathrm{H^{+}} $ B $ \mathrm{Cl^{-}} $ C $ \mathrm{Na^{+}} $ D $ \mathrm{OH^{-}} $', NULL, 0, 4, '2026-09-13 13:03:38.363977+00');
INSERT INTO public.question_parts VALUES ('25dc9359-2762-4b67-a3ef-5c518825c846', '4a0830c2-8338-491c-bddb-cfd73a18e193', 'b-iii', 'During the production of sodium, small explosions can be heard. Explain why using sodium chloride that is not completely dry could cause these small explosions.', NULL, 0, 5, '2026-09-13 13:03:38.364007+00');
INSERT INTO public.question_parts VALUES ('512c8dda-5057-4976-901b-7359a4105c74', '4a0830c2-8338-491c-bddb-cfd73a18e193', 'b-iv', 'Give ionic half-equations for the reactions at the anode and cathode. anode ... cathode', NULL, 0, 6, '2026-09-13 13:03:38.364039+00');
INSERT INTO public.question_parts VALUES ('e1d39d52-c8c7-4e01-81e8-7fded6dc7f64', '4a0830c2-8338-491c-bddb-cfd73a18e193', 'c', 'Explain why the reactivity of metals in Group 1 increases from lithium to potassium.', NULL, 0, 7, '2026-09-13 13:03:38.364068+00');
INSERT INTO public.question_parts VALUES ('e822ba3c-167a-4110-a882-f9f85c2532d3', '0a91a926-a7e8-4eee-910d-777656e3467e', 'a', 'Give the reason for using the white tile.', NULL, 0, 0, '2026-09-13 13:03:38.364108+00');
INSERT INTO public.question_parts VALUES ('08b6b225-40ee-483f-9e5f-fcb492e06231', '0a91a926-a7e8-4eee-910d-777656e3467e', 'b', 'Universal indicator is not a suitable indicator to use in a titration. Complete the table to show the name of a suitable indicator and its final colour in this titration.', NULL, 0, 1, '2026-09-13 13:03:38.364145+00');
INSERT INTO public.question_parts VALUES ('28b4c1dd-1491-4040-8aca-fbfed4b46790', '0a91a926-a7e8-4eee-910d-777656e3467e', 'c', 'The student wants to obtain an accurate value for the volume of sodium hydroxide solution needed to neutralise the $ 2 5. 0 \mathrm{c m}^{3} $ of nitric acid. Describe all the further steps the student should take.', NULL, 0, 2, '2026-09-13 13:03:38.364176+00');
INSERT INTO public.question_parts VALUES ('c93a398e-2566-4c16-96a0-525df12bb4a7', '0a91a926-a7e8-4eee-910d-777656e3467e', 'd', 'This is a summary of the student''s results. volume of $ \mathrm{H N O}_{3} $ used $ = 2 5. 0 \mathrm{c m}^{3} $ concentration of NaOH solution = 0.350 mol/dm $ ^{3} $ volume of NaOH solution needed for neutralisation $ = 1 8. 8 0 \mathrm{c m}^{3} $ The equation for the reaction is $\mathrm {H N O} _ {3} + \mathrm {N a O H} \rightarrow \mathrm {N a N O} _ {3} + \mathrm {H} _ {2} \mathrm {O}$', NULL, 0, 3, '2026-09-13 13:03:38.36421+00');
INSERT INTO public.question_parts VALUES ('cbb44c03-93b1-4845-9852-ae76035ced1c', '0a91a926-a7e8-4eee-910d-777656e3467e', 'd-i', 'Calculate the amount, in moles, of NaOH that reacts. $\mathrm {a m o u n t o f N a O H} =$', NULL, 0, 4, '2026-09-13 13:03:38.36424+00');
INSERT INTO public.question_parts VALUES ('096ae73a-3e43-4f4b-85cb-3b3dda92b2c2', '0a91a926-a7e8-4eee-910d-777656e3467e', 'd-ii', 'Determine the amount, in moles, of $ \mathrm{H N O_{3}} $ that reacts. $\mathrm {a m o u n t o f H N O} _ {3} =$', NULL, 0, 5, '2026-09-13 13:03:38.364274+00');
INSERT INTO public.question_parts VALUES ('c5eab628-2964-402d-a231-36e6832ba758', '0a91a926-a7e8-4eee-910d-777656e3467e', 'd-iii', 'Calculate the concentration, in mol/dm $ ^{3} $ , of the $ \mathrm{H N O}_{3} $ $\mathrm {m o l / d m ^ {3}}$', NULL, 0, 6, '2026-09-13 13:03:38.364786+00');
INSERT INTO public.question_parts VALUES ('f7610712-5d88-471c-9f99-0c317a3adeae', '8c8752c2-162e-4fb1-ba16-a277ed84c465', 'a', 'In a car engine, nitrogen reacts with oxygen to form nitrogen monoxide. The equation for the reaction is $\mathrm {N} _ {2} + \mathrm {O} _ {2} \rightarrow 2 \mathrm {N O} \quad \Delta H = + 1 8 1 \mathrm {k J}$ Draw a labelled reaction profile diagram showing $ \Delta H $ and the activation energy for the reaction.', NULL, 0, 0, '2026-09-13 13:03:38.364934+00');
INSERT INTO public.question_parts VALUES ('122cfa95-4b47-4eea-a021-6f924cd51fc4', '8c8752c2-162e-4fb1-ba16-a277ed84c465', 'b', 'In the Haber process, nitrogen reacts with hydrogen to form ammonia. This equation represents the reaction. $\mathrm {N} \equiv \mathrm {N} + 3 \mathrm {H} - \mathrm {H} \rightarrow 2 \mathrm {H} - \mathrm {N} - \mathrm {H}$ The table gives values of some bond energies.', NULL, 0, 1, '2026-09-13 13:03:38.364973+00');
INSERT INTO public.question_parts VALUES ('a061c4e2-777b-44e4-bf48-a4e1c5052129', '8c8752c2-162e-4fb1-ba16-a277ed84c465', 'b-i', 'Calculate the total amount of energy, in kJ, needed to break the bonds in the reactants.', NULL, 0, 2, '2026-09-13 13:03:38.365008+00');
INSERT INTO public.question_parts VALUES ('9418be45-d3ed-4062-9588-59c2d1e5e576', '8c8752c2-162e-4fb1-ba16-a277ed84c465', 'b-ii', 'Calculate the total amount of energy, in kJ, released in forming the bonds in the product.', NULL, 0, 3, '2026-09-13 13:03:38.365043+00');
