op_1_1789069595509.png", "format": "png", "confidence": 1.0, "element_id": "e000042", "page_number": 1, "source_name": "assets/crop_1_1789069595509.png", "bounding_box": null, "element_type": "figure", "reading_order": 42, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"alt": "OCR图片", "text": "assets/crop_1_1789069595538.png", "format": "png", "confidence": 1.0, "element_id": "e000067", "page_number": 1, "source_name": "assets/crop_1_1789069595538.png", "bounding_box": null, "element_type": "figure", "reading_order": 67, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"alt": "OCR图片", "text": "assets/crop_1_1789069595548.png", "format": "png", "confidence": 1.0, "element_id": "e000073", "page_number": 1, "source_name": "assets/crop_1_1789069595548.png", "bounding_box": null, "element_type": "figure", "reading_order": 73, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"alt": "OCR图片", "text": "assets/crop_2_1789069595555.png", "format": "png", "confidence": 1.0, "element_id": "e000080", "page_number": 1, "source_name": "assets/crop_2_1789069595555.png", "bounding_box": null, "element_type": "figure", "reading_order": 80, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"alt": "OCR图片", "text": "assets/crop_3_1789069595560.png", "format": "png", "confidence": 1.0, "element_id": "e000082", "page_number": 1, "source_name": "assets/crop_3_1789069595560.png", "bounding_box": null, "element_type": "figure", "reading_order": 82, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"alt": "OCR图片", "text": "assets/crop_1_1789069595586.png", "format": "png", "confidence": 1.0, "element_id": "e000092", "page_number": 1, "source_name": "assets/crop_1_1789069595586.png", "bounding_box": null, "element_type": "figure", "reading_order": 92, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"alt": "OCR图片", "text": "assets/crop_1_1789069595634.png", "format": "png", "confidence": 1.0, "element_id": "e000118", "page_number": 1, "source_name": "assets/crop_1_1789069595634.png", "bounding_box": null, "element_type": "figure", "reading_order": 118, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"alt": "OCR图片", "text": "assets/crop_1_1789069595674.png", "format": "png", "confidence": 1.0, "element_id": "e000139", "page_number": 1, "source_name": "assets/crop_1_1789069595674.png", "bounding_box": null, "element_type": "figure", "reading_order": 139, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"alt": "OCR图片", "text": "assets/crop_1_1789069595701.png", "format": "png", "confidence": 1.0, "element_id": "e000141", "page_number": 1, "source_name": "assets/crop_1_1789069595701.png", "bounding_box": null, "element_type": "figure", "reading_order": 141, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "version": 1, "sections": [{"level": 2, "title": "Instructions", "sectionId": "s001", "elementIds": ["e000002", "e000003", "e000004", "e000005", "e000006"], "pageNumber": 1}, {"level": 2, "title": "Information", "sectionId": "s002", "elementIds": ["e000008", "e000009", "e000010"], "pageNumber": 1}, {"level": 2, "title": "Advice", "sectionId": "s003", "elementIds": ["e000012", "e000013", "e000014", "e000015", "e000016", "e000018"], "pageNumber": 1}, {"level": 2, "title": "Answer ALL questions. Write your answers in the spaces provided.", "sectionId": "s004", "elementIds": ["e000020", "e000022", "e000023", "e000024", "e000025", "e000026", "e000027", "e000028", "e000029", "e000030", "e000032", "e000033"], "pageNumber": 1}, {"level": 2, "title": "relative atomic mass", "sectionId": "s005", "elementIds": ["e000035", "e000036", "e000037"], "pageNumber": 1}, {"level": 2, "title": "BLANK PAGE", "sectionId": "s006", "elementIds": ["e000040", "e000041", "e000043", "e000044", "e000045", "e000046", "e000047", "e000048", "e000049", "e000050", "e000052", "e000053", "e000054", "e000055", "e000056", "e000057", "e000058", "e000059", "e000060", "e000061", "e000062", "e000063", "e000064", "e000065", "e000066", "e000068", "e000069", "e000070", "e000071", "e000072", "e000074", "e000075", "e000076", "e000077", "e000078", "e000079", "e000081", "e000083", "e000086", "e000087", "e000088", "e000089", "e000090", "e000091"], "pageNumber": 1}, {"level": 2, "title": "BLANK PAGE", "sectionId": "s007", "elementIds": ["e000094", "e000095", "e000096", "e000097", "e000098", "e000100", "e000101", "e000102", "e000103", "e000105", "e000106", "e000107", "e000108", "e000109", "e000110", "e000112", "e000113", "e000114", "e000116", "e000117", "e000119", "e000120", "e000121", "e000122", "e000123", "e000124", "e000125", "e000126", "e000127", "e000128", "e000129", "e000130", "e000132", "e000133", "e000134", "e000135", "e000136", "e000137", "e000138"], "pageNumber": 1}, {"level": 2, "title": "BLANK PAGE", "sectionId": "s008", "elementIds": [], "pageNumber": 1}], "equations": [{"text": "\\begin{array}{l} \\square A 0 ^ {\\circ} C \\\\ \\square B 1 0 ^ {\\circ} C \\\\ \\square C 3 0 ^ {\\circ} C \\\\ \\square D 8 0 ^ {\\circ} C \\\\ \\end{array}", "latex": "\\begin{array}{l} \\square A 0 ^ {\\circ} C \\\\ \\square B 1 0 ^ {\\circ} C \\\\ \\square C 3 0 ^ {\\circ} C \\\\ \\square D 8 0 ^ {\\circ} C \\\\ \\end{array}", "confidence": 1.0, "element_id": "e000099", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 99, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {C} _ {2} \\mathrm {H} _ {4} (\\mathrm {g}) + \\mathrm {H} _ {2} \\mathrm {O} (\\mathrm {g}) \\rightarrow \\mathrm {C} _ {2} \\mathrm {H} _ {5} \\mathrm {O H} (\\mathrm {g})", "latex": "\\mathrm {C} _ {2} \\mathrm {H} _ {4} (\\mathrm {g}) + \\mathrm {H} _ {2} \\mathrm {O} (\\mathrm {g}) \\rightarrow \\mathrm {C} _ {2} \\mathrm {H} _ {5} \\mathrm {O H} (\\mathrm {g})", "confidence": 1.0, "element_id": "e000104", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 104, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {C H} _ {3} \\mathrm {C O O H} (\\mathrm {a q}) + \\dots \\dots \\dots \\dots \\dots \\dots \\mathrm {N a} (\\mathrm {s}) \\rightarrow", "latex": "\\mathrm {C H} _ {3} \\mathrm {C O O H} (\\mathrm {a q}) + \\dots \\dots \\dots \\dots \\dots \\dots \\mathrm {N a} (\\mathrm {s}) \\rightarrow", "confidence": 1.0, "element_id": "e000111", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 111, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {N} _ {2} \\mathrm {O} _ {4} (\\mathrm {g}) \\rightleftharpoons 2 \\mathrm {N O} _ {2} (\\mathrm {g})", "latex": "\\mathrm {N} _ {2} \\mathrm {O} _ {4} (\\mathrm {g}) \\rightleftharpoons 2 \\mathrm {N O} _ {2} (\\mathrm {g})", "confidence": 1.0, "element_id": "e000115", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 115, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {N a C l O} (\\mathrm {a q}) + 2 \\mathrm {H C l} (\\mathrm {a q}) \\rightarrow \\mathrm {N a C l} (\\mathrm {a q}) + \\mathrm {H} _ {2} \\mathrm {O} (\\mathrm {I}) + \\mathrm {C l} _ {2} (\\mathrm {g})", "latex": "\\mathrm {N a C l O} (\\mathrm {a q}) + 2 \\mathrm {H C l} (\\mathrm {a q}) \\rightarrow \\mathrm {N a C l} (\\mathrm {a q}) + \\mathrm {H} _ {2} \\mathrm {O} (\\mathrm {I}) + \\mathrm {C l} _ {2} (\\mathrm {g})", "confidence": 1.0, "element_id": "e000131", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 131, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "pageCount": 1, "documentId": "16e341a9-4824-549a-be76-abca668eb91f", "provenance": {"engine": "glm-ocr-markdown", "application": "syllabai-parser", "extractedAt": "2026-09-13T13:00:20.383374399Z", "engineVersion": "1.1.0", "schemaVersion": "1.0", "extractionParams": {"pageBoundaries": "none-in-source", "sourceLineCount": 175, "upstreamConverter": "zai-glm-ocr", "entityDecodedLines": 0, "signedUrlFigureRefs": 0, "normalizedHtmlEntities": true}}, "textBlocks": [{"role": "heading", "text": "Instructions", "confidence": 1.0, "element_id": "e000001", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 1, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Use black ink or ball-point pen.", "confidence": 1.0, "element_id": "e000002", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 2, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Fill in the boxes at the top of this page with your name, centre number and candidate number.", "confidence": 1.0, "element_id": "e000003", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 3, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer all questions.", "confidence": 1.0, "element_id": "e000004", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 4, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer the questions in the spaces provided", "confidence": 1.0, "element_id": "e000005", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 5, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Some questions must be answered with a cross in a box. If you change your mind about an answer, put a line through the box and then mark your new answer with a cross.", "confidence": 1.0, "element_id": "e000006", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 6, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Information", "confidence": 1.0, "element_id": "e000007", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 7, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The total mark for this paper is 70.", "confidence": 1.0, "element_id": "e000008", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 8, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The marks for each question are shown in brackets", "confidence": 1.0, "element_id": "e000009", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 9, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "use this as a guide as to how much time to spend on each question.", "confidence": 1.0, "element_id": "e000010", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 10, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Advice", "confidence": 1.0, "element_id": "e000011", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 11, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Try to answer every question.", "confidence": 1.0, "element_id": "e000012", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 12, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Read each question carefully before you start to answer it.", "confidence": 1.0, "element_id": "e000013", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 13, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Check your answers if you have time at the end.", "confidence": 1.0, "element_id": "e000014", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 14, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Turn over", "confidence": 1.0, "element_id": "e000015", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 15, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The Periodic Table of the Elements", "confidence": 1.0, "element_id": "e000016", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 16, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The lanthanoids (atomic numbers 58-71) and the actinoids (atomic numbers 90-103) have been omitted The relative atomic masses of copper and chlorine have not been rounded to the nearest whole number.", "confidence": 1.0, "element_id": "e000018", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 18, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Answer ALL questions. Write your answers in the spaces provided.", "confidence": 1.0, "element_id": "e000019", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 19, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "1 The diagram shows the particles in an atom of an element.", "confidence": 1.0, "element_id": "e000020", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 20, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) The box gives the names of some particles.", "confidence": 1.0, "element_id": "e000022", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 22, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "electron ion molecule neutron proton", "confidence": 1.0, "element_id": "e000023", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 23, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Use words from the box to label the diagram.", "confidence": 1.0, "element_id": "e000024", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 24, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Give the mass number of this atom.", "confidence": 1.0, "element_id": "e000025", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 25, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Complete the sentence about isotopes.", "confidence": 1.0, "element_id": "e000026", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 26, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Isotopes are atoms that have the same number of ...", "confidence": 1.0, "element_id": "e000027", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 27, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "but have a different number of ...", "confidence": 1.0, "element_id": "e000028", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 28, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 1 = 6 marks)", "confidence": 1.0, "element_id": "e000029", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 29, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "2 The table gives some information about the halogens, chlorine, bromine and iodine.", "confidence": 1.0, "element_id": "e000030", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 30, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Complete the table.", "confidence": 1.0, "element_id": "e000032", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 32, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Chlorine has two isotopes of mass numbers 35 and 37 The relative percentage of each isotope in a sample of chlorine is chlorine-35 77.78% chlorine-37 22.22% Calculate the relative atomic mass of this sample of chlorine. Give your answer to one decimal place.", "confidence": 1.0, "element_id": "e000033", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 33, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "relative atomic mass", "confidence": 1.0, "element_id": "e000034", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 34, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) A student is given an aqueous solution of chlorine and an aqueous solution of potassium bromide.", "confidence": 1.0, "element_id": "e000035", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 35, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Explain how he can use these two solutions to compare the reactivity of chlorine with the reactivity of bromine.", "confidence": 1.0, "element_id": "e000036", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 36, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 2 = 9 marks)", "confidence": 1.0, "element_id": "e000037", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 37, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000039", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 39, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "3 Methanol, ethanol, propanol and butanol are alcohols. They are all liquids that evaporate easily when warmed.", "confidence": 1.0, "element_id": "e000040", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 40, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A student uses this apparatus to compare the time taken for the four liquids to evaporate.", "confidence": 1.0, "element_id": "e000041", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 41, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "She uses this method.", "confidence": 1.0, "element_id": "e000043", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 43, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "pour some methanol into an evaporating basin", "confidence": 1.0, "element_id": "e000044", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 44, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "place the evaporating basin on top of a beaker containing hot water", "confidence": 1.0, "element_id": "e000045", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 45, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "measure the time taken for the methanol to evaporate completely", "confidence": 1.0, "element_id": "e000046", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 46, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "repeat the experiment with each of the other alcohols, using the same apparatus", "confidence": 1.0, "element_id": "e000047", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 47, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) State two variables the student should control to make sure her results are valid.", "confidence": 1.0, "element_id": "e000048", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 48, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) State why it is not safe to heat the evaporating basin directly with a Bunsen flame.", "confidence": 1.0, "element_id": "e000049", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 49, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) The table shows the results of experiments done by four students, A, B, C and D.", "confidence": 1.0, "element_id": "e000050", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 50, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Calculate the mean (average) time for butanol to evaporate.", "confidence": 1.0, "element_id": "e000052", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 52, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "mean time=", "confidence": 1.0, "element_id": "e000053", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 53, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Explain how the results show which alcohol evaporates most easily.", "confidence": 1.0, "element_id": "e000054", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 54, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) State the relationship between the number of carbon atoms in the molecule and how easily the alcohol evaporates.", "confidence": 1.0, "element_id": "e000055", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 55, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 3 = 9 marks)", "confidence": 1.0, "element_id": "e000056", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 56, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "4 This question is about metals.", "confidence": 1.0, "element_id": "e000057", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 57, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Which statement describes metallic bonding?", "confidence": 1.0, "element_id": "e000058", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 58, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A electrostatic attraction between oppositely charged ions", "confidence": 1.0, "element_id": "e000059", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 59, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B electrostatic attraction between the nuclei of two atoms and a pair of electrons shared between them", "confidence": 1.0, "element_id": "e000060", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 60, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C electrostatic attraction between positively charged particles and delocalised electrons", "confidence": 1.0, "element_id": "e000061", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 61, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D electrostatic attraction between atoms", "confidence": 1.0, "element_id": "e000062", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 62, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Aluminium is malleable and can be easily shaped to make saucepans used for cooking food.", "confidence": 1.0, "element_id": "e000063", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 63, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "State two other properties of aluminium that make it suitable for saucepans used for cooking food.", "confidence": 1.0, "element_id": "e000064", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 64, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Magnalium is an alloy of aluminium and magnesium.", "confidence": 1.0, "element_id": "e000065", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 65, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The diagram shows how the atoms are arranged in this alloy.", "confidence": 1.0, "element_id": "e000066", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 66, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) State what is meant by the term alloy.", "confidence": 1.0, "element_id": "e000068", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 68, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Explain why magnalium is harder than aluminium.", "confidence": 1.0, "element_id": "e000069", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 69, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 4 = 7 marks)", "confidence": 1.0, "element_id": "e000070", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 70, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "5 During the Second World War, engineers developed a rocket-powered aircraft.", "confidence": 1.0, "element_id": "e000071", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 71, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "combustion chamber", "confidence": 1.0, "element_id": "e000072", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 72, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The aircraft carried these two liquids", "confidence": 1.0, "element_id": "e000074", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 74, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "hydrazine, $ \\mathrm{N_{2} H_{4}} $", "confidence": 1.0, "element_id": "e000075", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 75, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "hydrogen peroxide, $ \\mathrm{H_{2}O_{2}} $", "confidence": 1.0, "element_id": "e000076", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 76, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "When these two liquids mix in the combustion chamber, they evaporate and then react rapidly to form nitrogen gas, $ \\mathrm{N}_{2} $ , and steam, $ \\mathrm{H}_{2}\\mathrm{O} $", "confidence": 1.0, "element_id": "e000077", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 77, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The reaction is exothermic.", "confidence": 1.0, "element_id": "e000078", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 78, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The equation for the reaction is", "confidence": 1.0, "element_id": "e000079", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 79, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The displayed formulae for the reactants and products are", "confidence": 1.0, "element_id": "e000081", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 81, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) The tables give the bond energies for the bonds broken in the reactants and the bonds made in the products.", "confidence": 1.0, "element_id": "e000083", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 83, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Use the data in the tables to calculate the total amount of energy required to break all of the bonds in the reactants.", "confidence": 1.0, "element_id": "e000086", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 86, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Use the data in the tables to calculate the total amount of energy released when all of the bonds in the products are made.", "confidence": 1.0, "element_id": "e000087", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 87, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Calculate the enthalpy change, $ \\Delta H $ , in kJ/mol, for the reaction Include a sign in your answer.", "confidence": 1.0, "element_id": "e000088", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 88, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "$ \\Delta H= $ kJ/mol", "confidence": 1.0, "element_id": "e000089", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 89, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Explain, in terms of bonds broken and bonds made, why this reaction is exothermic.", "confidence": 1.0, "element_id": "e000090", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 90, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Draw an energy level diagram for the reaction between $ \\mathrm{N_{2} H_{4}} $ and $ \\mathrm{H_{2}O_{2}} $", "confidence": 1.0, "element_id": "e000091", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 91, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000093", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 93, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "6 Some cars in Brazil use ethanol, $ \\mathrm{C_{2} H_{5} O H} $ , as a fuel instead of petrol.", "confidence": 1.0, "element_id": "e000094", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 94, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The ethanol is made by the fermentation of glucose which is obtained from sugar cane.", "confidence": 1.0, "element_id": "e000095", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 95, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The sugar is extracted from the sugar cane and then dissolved in water to make a sugar solution.", "confidence": 1.0, "element_id": "e000096", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 96, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) (i) Name the substance that is added to the sugar solution that causes glucose to ferment.", "confidence": 1.0, "element_id": "e000097", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 97, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Which temperature is the most suitable for fermentation?", "confidence": 1.0, "element_id": "e000098", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 98, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Explain why fermentation is done in the absence of air.", "confidence": 1.0, "element_id": "e000100", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 100, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) (i) State what is meant by the term fuel.", "confidence": 1.0, "element_id": "e000101", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 101, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Write a chemical equation for the complete combustion of ethanol in air.", "confidence": 1.0, "element_id": "e000102", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 102, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Ethanol is also manufactured by reacting steam with ethene, $ \\mathrm{C_{2} H_{4}} $ The equation for this reaction is", "confidence": 1.0, "element_id": "e000103", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 103, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "State the conditions of temperature and pressure used in this process.", "confidence": 1.0, "element_id": "e000105", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 105, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) When ethanol is heated with acidified potassium dichromate(VI), it is oxidised to ethanoic acid.", "confidence": 1.0, "element_id": "e000106", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 106, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) State the colour change that occurs in the potassium dichromate(VI) during this reaction.", "confidence": 1.0, "element_id": "e000107", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 107, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The structural formula of ethanoic acid is $ \\mathrm{C H_{3} C O O H} $", "confidence": 1.0, "element_id": "e000108", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 108, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Draw the displayed formula of ethanoic acid.", "confidence": 1.0, "element_id": "e000109", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 109, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Complete the equation for the reaction of ethanoic acid with sodium.", "confidence": 1.0, "element_id": "e000110", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 110, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "7 Dinitrogen tetraoxide, $ \\mathrm{N_{2}O_{4}} $ , is a colourless gas.", "confidence": 1.0, "element_id": "e000112", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 112, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Nitrogen dioxide, $ \\mathrm{N O}_{2} $ is a brown gas.", "confidence": 1.0, "element_id": "e000113", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 113, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The two gases can exist together in dynamic equilibrium according to the equation", "confidence": 1.0, "element_id": "e000114", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 114, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Explain what is meant by the term dynamic equilibrium.", "confidence": 1.0, "element_id": "e000116", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 116, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Some $ \\mathrm{N_{2}O_{4}} $ and some $ \\mathrm{NO_{2}} $ are put into a sealed gas syringe and allowed to form an equilibrium mixture.", "confidence": 1.0, "element_id": "e000117", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 117, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "This equilibrium mixture is brown.", "confidence": 1.0, "element_id": "e000119", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 119, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) The pressure of the gas in the syringe is increased by pushing in the piston. The mixture is then allowed to reach a new equilibrium at the same temperature as before.", "confidence": 1.0, "element_id": "e000120", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 120, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Explain why the new equilibrium mixture contains less $ \\mathrm{N O_{2}} $ than the original equilibrium mixture.", "confidence": 1.0, "element_id": "e000121", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 121, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) A student suggests that the new equilibrium mixture would be lighter in colour than the original equilibrium mixture, as there is now less $ \\mathrm{N O_{2}} $ present. Suggest why the new equilibrium mixture is actually darker than the original.", "confidence": 1.0, "element_id": "e000122", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 122, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Carbon monoxide, CO, and oxides of nitrogen are produced in a car engine when petrol is burned.", "confidence": 1.0, "element_id": "e000123", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 123, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "These oxides can be partly removed by using a catalytic converter fitted to the car''s exhaust system.", "confidence": 1.0, "element_id": "e000124", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 124, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) State how oxides of nitrogen are produced in the car engine.", "confidence": 1.0, "element_id": "e000125", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 125, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Give a disadvantage of allowing oxides of nitrogen to escape into the atmosphere.", "confidence": 1.0, "element_id": "e000126", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 126, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Write a chemical equation for the reaction between nitrogen monoxide, NO, and carbon monoxide to form carbon dioxide and nitrogen.", "confidence": 1.0, "element_id": "e000127", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 127, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 7 = 8 marks)", "confidence": 1.0, "element_id": "e000128", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 128, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "8 The concentration of NaClO(aq) in a solution of bleach is found by reacting it with hydrochloric acid.", "confidence": 1.0, "element_id": "e000129", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 129, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The equation for the reaction is", "confidence": 1.0, "element_id": "e000130", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 130, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "An excess of dilute hydrochloric acid is added to $ 4. 0 0 \\mathrm{c m}^{3} $ of bleach solution. $ 6 0. 0 \\mathrm{c m}^{3} $ of chlorine gas is produced.", "confidence": 1.0, "element_id": "e000132", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 132, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Explain a safety precaution that should be taken when doing this experiment.", "confidence": 1.0, "element_id": "e000133", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 133, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) (i) Calculate the amount, in moles, of chlorine gas produced. Assume one mole of chlorine gas occupies $ 2 4 0 0 0 \\mathrm{c m}^{3}. $", "confidence": 1.0, "element_id": "e000134", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 134, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Determine the amount, in moles, of $ \\mathrm{N a C l O} $ in $ 4. 0 0 \\mathrm{c m}^{3} $ of bleach.", "confidence": 1.0, "element_id": "e000135", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 135, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Calculate the concentration, in mol/dm $ ^{3} $ , of the bleach solution.", "confidence": 1.0, "element_id": "e000136", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 136, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 8 = 7 marks)", "confidence": 1.0, "element_id": "e000137", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 137, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "TOTAL FOR PAPER = 70 MARKS", "confidence": 1.0, "element_id": "e000138", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 138, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000140", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 140, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "schemaVersion": "1.0"}', NULL, '2026-09-13 13:00:40.720064+00');
INSERT INTO public.documents VALUES ('f078021a-bed9-4dfb-8cbe-eb62c711a275', 'c3ace227-3560-52cd-8427-ff529ed96620', '1.0', 1, 'MARK_SCHEME', 'corpus/igcse-chemistry-4ch0-2c-2019jun/MS.md', 'MS.md', 'text/markdown', 'e10577bf8fd8830af036eaa2440d955b8db3328a0093ee4ebbfddbb56826c258', 'SHA-256', 1, 36, 36, 15, 'glm-ocr-markdown', '1.1.0', '2026-09-13 13:00:20.452902+00', '{"pages": [{"width": null, "height": null, "pageNumber": 1}], "source": {"uri": "corpus/igcse-chemistry-4ch0-2c-2019jun/MS.md", "checksum": "e10577bf8fd8830af036eaa2440d955b8db3328a0093ee4ebbfddbb56826c258", "fileName": "MS.md", "mimeType": "text/markdown", "checksumAlgorithm": "SHA-256"}, "tables": [{"rows": [["Question number", "Answer", "Additional guidance", "Marks"], ["1(a)", "原子模型", "1 mark for each correct answer", "3"], ["(b)", "13", "", "1"], ["(c)", "M1 protons\nM2 neutrons", "IGNORE electrons", "2"], ["", "", "Total", "6"]], "text": "Question number | Answer | Additional guidance | Marks\n1(a) | 原子模型 | 1 mark for each correct answer | 3\n(b) | 13 |  | 1\n(c) | M1 protons\nM2 neutrons | IGNORE electrons | 2\n |  | Total | 6", "row_count": 5, "confidence": 1.0, "element_id": "e000019", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 19, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Additional guidance", "Marks"], ["2(a)", "Name of halogen", "Physical state at room temperature", "Colour", "ALLOW black\nALLOW any combination of grey and black eg grey-black", "2"], ["chlorine", "gas", "pale green"], ["bromine", "liquid", "red-brown"], ["iodine", "solid", "(dark) grey"], ["(b)", "M1 (35×77.78)+(37×22.22)\nOR 3544.44\nM2 3544.44÷100 OR 35.4444 OR M1÷100\nM3 35.4", "(35×0.7778)+(37×0.2222)\nOR 35.4444/35.444/35.44 with no working scores2\n35.4 with no working scores3\nM3 can be ECF from an incorrect M2", "3"]], "text": "Question number | Answer | Additional guidance | Marks\n2(a) | Name of halogen | Physical state at room temperature | Colour | ALLOW black\nALLOW any combination of grey and black eg grey-black | 2\nchlorine | gas | pale green\nbromine | liquid | red-brown\niodine | solid | (dark) grey\n(b) | M1 (35×77.78)+(37×22.22)\nOR 3544.44\nM2 3544.44÷100 OR 35.4444 OR M1÷100\nM3 35.4 | (35×0.7778)+(37×0.2222)\nOR 35.4444/35.444/35.44 with no working scores2\n35.4 with no working scores3\nM3 can be ECF from an incorrect M2 | 3", "row_count": 6, "confidence": 1.0, "element_id": "e000020", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 20, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["(c)", "An explanation that links together the following four points:", "", ""], ["", "M1 add chlorine (solution) to potassium bromide(solution)", "ACCEPT mix the two solutions", "4"], ["", "M2 (solution) turns orange", "ALLOW any combination of orange/yellow/brownIGNORE other observationseg bubbles", ""], ["", "M3 bromine/Br2is displaced", "ALLOW bromine/Br2is produced/formed", ""], ["", "", "IGNORE state of bromineREJECT bromideIGNORE a displacement reaction occursM3 can be scored by Br2as a product in an equation", ""], ["", "M4 (therefore) chlorine is more reactive(than bromine)", "ACCEPT reverse argument“If a reaction occurs then chlorine is more reactive than bromine”scores M4", ""], ["", "", "Total", "9"]], "text": "(c) | An explanation that links together the following four points: |  | \n | M1 add chlorine (solution) to potassium bromide(solution) | ACCEPT mix the two solutions | 4\n | M2 (solution) turns orange | ALLOW any combination of orange/yellow/brownIGNORE other observationseg bubbles | \n | M3 bromine/Br2is displaced | ALLOW bromine/Br2is produced/formed | \n |  | IGNORE state of bromineREJECT bromideIGNORE a displacement reaction occursM3 can be scored by Br2as a product in an equation | \n | M4 (therefore) chlorine is more reactive(than bromine) | ACCEPT reverse argument“If a reaction occurs then chlorine is more reactive than bromine”scores M4 | \n |  | Total | 9", "row_count": 7, "confidence": 1.0, "element_id": "e000021", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 21, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Additional guidance", "Marks"], ["3", "(a)", "M1 the volume of liquid/alcohol", "ALLOW amount of liquid/alcohol\nIGNORE mass\nIGNORE volume of water", "2"], ["M2 the temperature of the water", "ALLOW temperature of surroundings\nIGNORE references to temperature of the alcohol"], ["alcohols/the liquids are flammable/catch fire easily", "ALLOW alcohols/the liquids can be easily ignited\nALLOW any named alcohol from the table"], ["(c)", "(i)", "M1(64+63+60)÷3", "", "2"], ["M2=62", "ALLOW 62.3\n62/62.3 with no working scores 2\nALLOW 69/69.25/69.3 for 1 mark"], ["(ii)", "An explanation including the following two points:\nM1 methanol/CH3OH (evaporates most easily)\nM2 because the time taken is the shortest", "ACCEPT because has lowest (mean) time", "2"]], "text": "Question number | Answer | Additional guidance | Marks\n3 | (a) | M1 the volume of liquid/alcohol | ALLOW amount of liquid/alcohol\nIGNORE mass\nIGNORE volume of water | 2\nM2 the temperature of the water | ALLOW temperature of surroundings\nIGNORE references to temperature of the alcohol\nalcohols/the liquids are flammable/catch fire easily | ALLOW alcohols/the liquids can be easily ignited\nALLOW any named alcohol from the table\n(c) | (i) | M1(64+63+60)÷3 |  | 2\nM2=62 | ALLOW 62.3\n62/62.3 with no working scores 2\nALLOW 69/69.25/69.3 for 1 mark\n(ii) | An explanation including the following two points:\nM1 methanol/CH3OH (evaporates most easily)\nM2 because the time taken is the shortest | ACCEPT because has lowest (mean) time | 2", "row_count": 7, "confidence": 1.0, "element_id": "e000022", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 22, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["", "", "", ""], ["Question Number", "Answer", "Additional Guidance", "Marks"], ["(iii)", "M1 as the number of carbon atoms increasesM2 the ease of evaporation decreases/the less easily the alcohol evaporates", "ALLOW the less volatile the alcoholIGNORE the slower the alcohol evaporatesIGNORE references to time takenALLOW correct reverse argument", "2"], ["", "", "Total", "9"]], "text": " |  |  | \nQuestion Number | Answer | Additional Guidance | Marks\n(iii) | M1 as the number of carbon atoms increasesM2 the ease of evaporation decreases/the less easily the alcohol evaporates | ALLOW the less volatile the alcoholIGNORE the slower the alcohol evaporatesIGNORE references to time takenALLOW correct reverse argument | 2\n |  | Total | 9", "row_count": 4, "confidence": 1.0, "element_id": "e000023", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 23, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Additional guidance", "Marks"], ["4(a)", "C(electrostatic attraction between positively charged particles and delocalised electrons) is correct as it describes metallic bondingA is incorrect since it describes ionic bonding not metallic bondingB is incorrect since it describes covalent bonding not metallic bondingD is incorrect since it describes interatomic or intermolecular forces not metallic bonding", "", "1"], ["(b)", "Any two from the following:M1 good conductor of heat/thermal energyM2 does not react with food/affect flavour of foodM3 resistant to corrosionM4 high melting pointM5 low density/lightweight/strong", "IGNORE non-toxicALLOW does not corrode/rustIGNORE unreactive/inertIGNORE references to recyclingIGNORE light", "2"]], "text": "Question number | Answer | Additional guidance | Marks\n4(a) | C(electrostatic attraction between positively charged particles and delocalised electrons) is correct as it describes metallic bondingA is incorrect since it describes ionic bonding not metallic bondingB is incorrect since it describes covalent bonding not metallic bondingD is incorrect since it describes interatomic or intermolecular forces not metallic bonding |  | 1\n(b) | Any two from the following:M1 good conductor of heat/thermal energyM2 does not react with food/affect flavour of foodM3 resistant to corrosionM4 high melting pointM5 low density/lightweight/strong | IGNORE non-toxicALLOW does not corrode/rustIGNORE unreactive/inertIGNORE references to recyclingIGNORE light | 2", "row_count": 3, "confidence": 1.0, "element_id": "e000024", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 24, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Additional guidance", "Marks"], ["4(c)(i)", "a mixture of(two or more)elements,one ofwhich isa metal", "ACCEPTa mixture of(two ormore)metalsALLOWcombination for mixtureREJECTcompound or references tochemical bonding", "1"], ["(ii)", "An explanation that links together the following threepoints:", "ALLOWlattice/layers/rows of atoms are disrupted/distortedALLOWlattice/layers/rows of atoms less regular", "3"], ["", "M1the regular arrangement of atoms isdistorted/disruptedOWTTE", "ALLOWmagnesium and aluminium atoms are of different sizes", ""], ["", "M2because magnesium atoms are larger than aluminium atoms", "ALLOWlayers cannot(as easily)slide over one another", ""], ["", "M3and therefore it is more difficult for the layers toslide over one another", "IGNOREreferences to strength ofmetallic bonds", ""], ["", "", "Total", "7"]], "text": "Question number | Answer | Additional guidance | Marks\n4(c)(i) | a mixture of(two or more)elements,one ofwhich isa metal | ACCEPTa mixture of(two ormore)metalsALLOWcombination for mixtureREJECTcompound or references tochemical bonding | 1\n(ii) | An explanation that links together the following threepoints: | ALLOWlattice/layers/rows of atoms are disrupted/distortedALLOWlattice/layers/rows of atoms less regular | 3\n | M1the regular arrangement of atoms isdistorted/disruptedOWTTE | ALLOWmagnesium and aluminium atoms are of different sizes | \n | M2because magnesium atoms are larger than aluminium atoms | ALLOWlayers cannot(as easily)slide over one another | \n | M3and therefore it is more difficult for the layers toslide over one another | IGNOREreferences to strength ofmetallic bonds | \n |  | Total | 7", "row_count": 7, "confidence": 1.0, "element_id": "e000025", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 25, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Additional guidance", "Marks"], ["5(a)(i)(ii)(iii)", "(bonds broken)3861(kJ)", "", "1"], ["(bonds made)4649(kJ)", "", "1"], ["M1 subtraction of Σ(bonds made) made and Σ(bonds broken)", "In(iii)ECF from(i)和(ii)must be appliedSubtraction can be in any order", "3"], ["M2 correct evaluation of the calculation shown inM1IGNORE signM3If Σ(bonds made)＞Σ(bonds broken)final answer must be negativeIf Σ(bonds made)＜Σ(bonds broken)final answer must be positive(and+sign given)", "Expected final answer is-788(kJ/mol)", ""], ["", "", "-788 with no working scores3(+)788 scores2", ""]], "text": "Question number | Answer | Additional guidance | Marks\n5(a)(i)(ii)(iii) | (bonds broken)3861(kJ) |  | 1\n(bonds made)4649(kJ) |  | 1\nM1 subtraction of Σ(bonds made) made and Σ(bonds broken) | In(iii)ECF from(i)和(ii)must be appliedSubtraction can be in any order | 3\nM2 correct evaluation of the calculation shown inM1IGNORE signM3If Σ(bonds made)＞Σ(bonds broken)final answer must be negativeIf Σ(bonds made)＜Σ(bonds broken)final answer must be positive(and+sign given) | Expected final answer is-788(kJ/mol) | \n |  | -788 with no working scores3(+)788 scores2 | ", "row_count": 6, "confidence": 1.0, "element_id": "e000026", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 26, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["(b)", "An explanation that links together the following two points：\nM1 more energy is given out when the bonds are made\nM2 than is taken in when the bonds are broken", "If state/imply that energy required to make bonds OR\nIf state/imply that energy released when bonds are broken scores 0/2\nACCEPT correct reverse argument", "2"]], "text": "(b) | An explanation that links together the following two points：\nM1 more energy is given out when the bonds are made\nM2 than is taken in when the bonds are broken | If state/imply that energy required to make bonds OR\nIf state/imply that energy released when bonds are broken scores 0/2\nACCEPT correct reverse argument | 2", "row_count": 1, "confidence": 1.0, "element_id": "e000027", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 27, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Additional guidance", "Marks"], ["5(c)", "energy\nhydrazine+hydrogen peroxide\nnitrogen+water\nM1 right hand line below left hand line\nM2 correct names/formulae of both reactants\nM3 correct names/formulae of both products", "IGNORE horizontal axis drawn\nIGNORE enthalpy change shown\nIGNORE activation energy shown\nIf only use words reactants(on left) and products(on right) award 1 mark from M2 and M3", "3"], ["", "", "Total", "10"]], "text": "Question number | Answer | Additional guidance | Marks\n5(c) | energy\nhydrazine+hydrogen peroxide\nnitrogen+water\nM1 right hand line below left hand line\nM2 correct names/formulae of both reactants\nM3 correct names/formulae of both products | IGNORE horizontal axis drawn\nIGNORE enthalpy change shown\nIGNORE activation energy shown\nIf only use words reactants(on left) and products(on right) award 1 mark from M2 and M3 | 3\n |  | Total | 10", "row_count": 3, "confidence": 1.0, "element_id": "e000028", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 28, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Additional guidance", "Marks"], ["6(a)(i)", "yeast", "IGNORE zymase", "1"], ["(ii)", "C(30℃) is correct as it is the most suitable temperature for fermentationA is incorrect as at 0℃ the enzymes would not be active so not the most suitable temperature for fermentationB is incorrect as at 10℃ the enzymes would not be very active so not the most suitable temperature for fermentationD is incorrect as at 80℃ the enzymes would be denatured so not the most suitable temperature for fermentation", "", "1"], ["(iii)", "An explanation using either of the following linked pairs:M1 oxygen in the air would react with ethanolM2 to form ethanoic acidORM1 the fermentation/reaction/respiration needs to be anaerobicM2 ethanol would not be formed/CO2andH2O would form", "ACCEPT ethanol would be oxidisedALLOW to form carboxylic acidALLOW to form vinegar", "2"]], "text": "Question number | Answer | Additional guidance | Marks\n6(a)(i) | yeast | IGNORE zymase | 1\n(ii) | C(30℃) is correct as it is the most suitable temperature for fermentationA is incorrect as at 0℃ the enzymes would not be active so not the most suitable temperature for fermentationB is incorrect as at 10℃ the enzymes would not be very active so not the most suitable temperature for fermentationD is incorrect as at 80℃ the enzymes would be denatured so not the most suitable temperature for fermentation |  | 1\n(iii) | An explanation using either of the following linked pairs:M1 oxygen in the air would react with ethanolM2 to form ethanoic acidORM1 the fermentation/reaction/respiration needs to be anaerobicM2 ethanol would not be formed/CO2andH2O would form | ACCEPT ethanol would be oxidisedALLOW to form carboxylic acidALLOW to form vinegar | 2", "row_count": 4, "confidence": 1.0, "element_id": "e000029", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 29, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["(b)(i)", "a substance that releases thermal energy/heat(energy)when burned/combusted", "IGNORE energy on its own", "1"], ["(ii)", "C2H5OH+3O2→2CO2+3H2OM1 all formulae correctM2 correctly balanced", "ACCEPT multiplesM2 DEP M1", "2"]], "text": "(b)(i) | a substance that releases thermal energy/heat(energy)when burned/combusted | IGNORE energy on its own | 1\n(ii) | C2H5OH+3O2→2CO2+3H2OM1 all formulae correctM2 correctly balanced | ACCEPT multiplesM2 DEP M1 | 2", "row_count": 2, "confidence": 1.0, "element_id": "e000030", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 30, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Additional guidance", "Marks"], ["6(c)", "M1(temperature)300℃", "ACCEPT any value or range of values between250and350℃If no unit given assume it isCelsiusACCEPT equivalent temperatures in other units provided the unit is given", "2"], ["M260-70atm", "ACCEPT any value or range of values between60and70atmIf no unit given assume it isatmACCEPT equivalent pressures in other units provided the unit is given", ""], ["(d)(i)", "(from) orange(to) green", "", "1"], ["CH3COONa+1/2H2", "IGNORE bond angles scores1mark", "2"], ["M1for both products correctM2for correctly balanced", "ALLOW NaCH3COOACCEPT multiplesM2DEP M1", "2"], ["", "", "Total", "14"]], "text": "Question number | Answer | Additional guidance | Marks\n6(c) | M1(temperature)300℃ | ACCEPT any value or range of values between250and350℃If no unit given assume it isCel