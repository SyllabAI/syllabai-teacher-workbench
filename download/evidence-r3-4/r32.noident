INSERT INTO public.document_chunks VALUES ('246c9fac-d56a-475b-8079-5a3cc28d127e', '78a6dd0b-acf9-4d37-a86d-4dcb1892e72b', 7, '(ii) The temperature change in this experiment shows that dissolving lithium iodide in water to form lithium iodide solution is an exothermic process.
