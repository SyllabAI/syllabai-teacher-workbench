INSERT INTO public.question_parts VALUES ('5d8ab823-98aa-4d5e-b38f-62f432c98182', '2b5e3b9a-3ee9-42fb-b7ed-099a8f428f37', 'c', 'The empirical formula of compound X is $ \mathrm{C u S O_{9} H_{1 0}} $ Write the formula of compound X to show its water of crystallisation.', NULL, 0, 2, '2026-09-13 12:57:41.990071+00');
