INSERT INTO public.document_chunks VALUES ('371bb65e-a347-423a-b0b9-a05b977507a0', '5f9d541f-db62-4bf9-862d-811c70ced228', 5, 'When the magnesium fuse is lit, a very exothermic reaction occurs.
