INSERT INTO public.question_parts VALUES ('ead6ce6c-0167-4caf-947b-d3b5fb6d3199', '2f786e0c-d9de-4226-994f-5e74fd055ec5', 'b-iv', 'Give the name of this compound.', NULL, 0, 5, '2026-09-13 12:58:26.499205+00');
INSERT INTO public.question_parts VALUES ('3ef1952b-13c4-4dce-b628-4607288bb9aa', '2f786e0c-d9de-4226-994f-5e74fd055ec5', 'b-v', 'Give the general formula of the homologous series that contains this compound.', NULL, 0, 6, '2026-09-13 12:58:26.499246+00');
INSERT INTO public.question_parts VALUES ('321cfdbc-3260-4bce-9df5-4663b46c55f6', '2f786e0c-d9de-4226-994f-5e74fd055ec5', 'c', 'The products of the complete combustion of hydrocarbons are carbon dioxide and water.', NULL, 0, 7, '2026-09-13 12:58:26.499288+00');
INSERT INTO public.question_parts VALUES ('dcef68ee-1525-483a-8db9-c8be249fc67c', '2f786e0c-d9de-4226-994f-5e74fd055ec5', 'c-i', 'Balance the equation to show the complete combustion of ethene $ \left( \mathrm{C}_{2} \mathrm{H}_{4} \right) $ $\mathrm {C} _ {2} \mathrm {H} _ {4} + \dots \dots \dots \mathrm {O} _ {2} \rightarrow \dots \dots \dots \mathrm {C O} _ {2} + \dots \dots \dots \mathrm {H} _ {2} \mathrm {O}$', NULL, 0, 8, '2026-09-13 12:58:26.499337+00');
INSERT INTO public.question_parts VALUES ('6735a1a4-5ac4-4db0-9702-af9d78af70f7', '2f786e0c-d9de-4226-994f-5e74fd055ec5', 'c-ii', 'Draw a dot and cross diagram to show the bonding in an ethene molecule. Show only the outer electrons in each atom.', NULL, 0, 9, '2026-09-13 12:58:26.499406+00');
INSERT INTO public.question_parts VALUES ('d66341d7-a3c8-4380-afd5-5ee8b36d44d0', '2f786e0c-d9de-4226-994f-5e74fd055ec5', 'd', 'Ethanol can be manufactured by the hydration of ethene. The equation for this reaction is', NULL, 0, 10, '2026-09-13 12:58:26.499456+00');
INSERT INTO public.question_parts VALUES ('07bac0f5-322a-4b83-b513-2facbfb34751', '41617f11-2a6b-4568-9443-30e5fce0c4de', 'a', 'Suggest why the copper strips would dry more quickly when washed with ethanol rather than with water.', NULL, 0, 0, '2026-09-13 12:58:26.499504+00');
INSERT INTO public.question_parts VALUES ('11cda438-0df4-4710-a455-9bcb27452e3f', '41617f11-2a6b-4568-9443-30e5fce0c4de', 'b', 'The student''s results are shown in the table. The table shows that the decrease in mass of the positive electrode was 0.32 g.', NULL, 0, 1, '2026-09-13 12:58:26.499549+00');
INSERT INTO public.question_parts VALUES ('51e8542e-4631-4e29-8f29-7ec94a5223f9', '41617f11-2a6b-4568-9443-30e5fce0c4de', 'b-i', 'Calculate the increase in mass, in grams, of the negative electrode.', NULL, 0, 2, '2026-09-13 12:58:26.499592+00');
INSERT INTO public.question_parts VALUES ('b42c530d-1b11-447c-937e-a21bf015c57d', '41617f11-2a6b-4568-9443-30e5fce0c4de', 'b-ii', 'The ionic half-equations show that the increase in mass of the negative electrode should be the same as the decrease in mass of the positive electrode. Suggest two reasons why the increase in mass of the negative electrode in the student''s experiment was less than expected.', NULL, 0, 3, '2026-09-13 12:58:26.499631+00');
INSERT INTO public.question_parts VALUES ('5b02044c-a212-48c2-81e6-fc565329687b', '41617f11-2a6b-4568-9443-30e5fce0c4de', 'c', 'Another student investigated the effect of changing the electrical charge, in faradays, passed during the electrolysis. He wanted to find how this affected the increase in mass of the negative electrode. One faraday is the electrical charge of one mole of electrons. His results are shown in the table.', NULL, 0, 4, '2026-09-13 12:58:26.499668+00');
INSERT INTO public.question_parts VALUES ('6f9c3c00-3e2c-4237-ab02-db399d4e1640', '41617f11-2a6b-4568-9443-30e5fce0c4de', 'c-i', 'On the grid, plot a graph of increase in mass against electrical charge Draw a straight line of best fit. Start your line at the origin (0,0). Increase in mass in g', NULL, 0, 5, '2026-09-13 12:58:26.49972+00');
INSERT INTO public.question_parts VALUES ('9a221b70-c283-489a-a436-46701ff19125', '41617f11-2a6b-4568-9443-30e5fce0c4de', 'c-ii', 'Draw a circle around the anomalous result.', NULL, 0, 6, '2026-09-13 12:58:26.499754+00');
INSERT INTO public.question_parts VALUES ('86ca5cda-2e51-47a4-a845-e2b699f57c2e', '41617f11-2a6b-4568-9443-30e5fce0c4de', 'c-iii', 'Suggest why the straight line should go through the origin.', NULL, 0, 7, '2026-09-13 12:58:26.499805+00');
INSERT INTO public.question_parts VALUES ('67877a06-7c90-410e-821e-b3c37cf96c67', '41617f11-2a6b-4568-9443-30e5fce0c4de', 'c-iv', 'Explain why the graph shows that the increase in mass is directly proportional to the electrical charge passed.', NULL, 0, 8, '2026-09-13 12:58:26.499842+00');
