INSERT INTO public.questions VALUES ('3bab7bba-3159-4b1c-8328-11da89bd850d', 'q16-2f82da9d', 'STRUCTURED', 'The mineral rozenite contains crystals of hydrated iron(II) sulfate, $ \mathrm{F e S O_{4}. x H_{2} O} $ She uses this apparatus to remove and collect the water of crystallisation from a sample of iron(II) sulfate crystals. She uses this method. weigh empty tube A to find its mass place a sample of hydrated iron(II) sulfate crystals into tube A and reweigh heat tube A allow tube A to cool and reweigh repeat the process until the mass no longer changes Heating until the mass no longer changes is known as heating to constant mass. When iron(II) sulfate crystals are heated gently, they decompose according to this equation. $\mathrm {F e S O} _ {4}. x \mathrm {H} _ {2} \mathrm {O} \rightarrow \mathrm {F e S O} _ {4} + x \mathrm {H} _ {2} \mathrm {O}$ These are the student''s results. A student wants to find the value of x.', 8, 3, 720, NULL, '4db63338-5d31-45b9-87ca-c5e5ae693ae1', 'PAST_PAPER', true, 1, '2026-09-13 12:53:56.395311+00', '5cd177ba-bfaf-4adc-8e89-e65c40880fe3');
INSERT INTO public.questions VALUES ('2b392f20-e26e-4579-8126-f5669473404d', 'q03-517cf287', 'STRUCTURED', 'Solutions of silver nitrate and potassium chloride react together to make the insoluble salt, silver chloride. Step 1 add $ 2 5 \mathrm{c m}^{3} $ of silver nitrate solution to a conical flask Step 2 add potassium chloride solution to the flask Step 3 filter off the silver chloride A student uses this method to prepare a sample of silver chloride.', 6, 3, 540, NULL, 'f01f60ef-5693-4171-9695-ea236e97ddc3', 'PAST_PAPER', true, 1, '2026-09-13 13:01:25.618752+00', '61f7a985-439f-4e5c-944b-f5a5bb285358');
