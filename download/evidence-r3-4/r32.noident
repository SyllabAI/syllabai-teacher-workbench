INSERT INTO public.question_versions VALUES ('873a058e-f5c6-4403-96e5-6dba59f0e246', '13e3d915-9572-49fa-9d36-ef058e06c81f', 1, '(a) The term species is sometimes used to refer to neutral atoms and to positive and negative ions. The table shows the numbers of subatomic particles in eight different species. (i) Explain which two letters represent neutral atoms of the same element. (ii) Explain which two letters represent negative ions formed from the same element. (iii) Explain which letter represents the atom with the lowest mass number. (iv) What is the electronic configuration of species E? A 5 5 5 B 5 6 5 C 6 7 5 D 6 7 7', 12, 3, 1080, NULL, 'SUGGESTED', '0dbea9f5-3ede-55a0-b01d-36d01523042a', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:53:55.591094+00');
