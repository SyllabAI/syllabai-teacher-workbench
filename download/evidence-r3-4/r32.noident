INSERT INTO public.question_parts VALUES ('b4a7719a-14b4-42f5-ae2d-90daad885161', '36def696-25bd-4b05-9e54-2075a3ddc56e', 'a-ii', 'State how the appearance of the limewater changes during the reaction.', NULL, 0, 2, '2026-09-13 12:59:56.21665+00');
INSERT INTO public.question_parts VALUES ('e52f00c8-e791-4841-b367-98a946c137bc', '36def696-25bd-4b05-9e54-2075a3ddc56e', 'a-iii', 'State the temperature at which this reaction is carried out in industry.', NULL, 0, 3, '2026-09-13 12:59:56.216695+00');
INSERT INTO public.question_parts VALUES ('9900a658-d51f-4dcc-b5a3-530448262559', '36def696-25bd-4b05-9e54-2075a3ddc56e', 'b', 'Ethanol can be used as a fuel. This is the equation for the complete combustion of ethanol. $\mathrm {C} _ {2} \mathrm {H} _ {5} \mathrm {O H} + 3 \mathrm {O} _ {2} \rightarrow 2 \mathrm {C O} _ {2} + 3 \mathrm {H} _ {2} \mathrm {O}$ These are the displayed formulae for ethanol, oxygen, carbon dioxide and water. The table gives some average (mean) bond energies. Use this information to calculate the enthalpy change $ (\Delta H) $ when one mole of ethanol is completely burned.', NULL, 0, 4, '2026-09-13 12:59:56.216746+00');
INSERT INTO public.question_parts VALUES ('a151cbde-0af1-449e-8c55-0e269deeaba4', '36def696-25bd-4b05-9e54-2075a3ddc56e', 'c', 'Ethanol and methanol can both be used as fuels. A student uses this apparatus to find out how much energy is produced when one mole of ethanol and one mole of methanol are burned. The table shows some of the student''s results.', NULL, 0, 5, '2026-09-13 12:59:56.216796+00');
INSERT INTO public.question_parts VALUES ('1c6ca35b-924a-4cb5-9a67-4cae8cb97f3c', '36def696-25bd-4b05-9e54-2075a3ddc56e', 'c-i', 'Calculate the energy given out by 1 mol of methanol.', NULL, 2, 6, '2026-09-13 12:59:56.216845+00');
INSERT INTO public.question_parts VALUES ('35234ce5-d692-4bc3-a1a0-9463258fd892', '36def696-25bd-4b05-9e54-2075a3ddc56e', 'c-ii', 'The student uses the same burner and copper can in each experiment. State two other factors that the student should keep the same in each experiment. (2)', NULL, 0, 7, '2026-09-13 12:59:56.216895+00');
INSERT INTO public.question_parts VALUES ('821d5fb6-f949-4668-a6bb-d0d18b6fbf8e', '36def696-25bd-4b05-9e54-2075a3ddc56e', 'c-iii', 'A data book states that the energy given out when 1 mol of ethanol is burned is 1371 kJ. Suggest two reasons why the student''s value is much less than this.', NULL, 0, 8, '2026-09-13 12:59:56.216935+00');
INSERT INTO public.question_parts VALUES ('67994b51-5805-4002-bae7-6033117415dc', 'cd41ddb1-3981-4760-be5a-089e47ef8720', 'a', 'In one experiment, a sample of 0.050 mol of $ \mathrm{M g C O_{3}} $ is added to 0.080 mol of HCl. Show, by calculation, that the $ \mathrm{M g C O_{3}} $ is in excess.', NULL, 0, 0, '2026-09-13 12:59:56.216994+00');
