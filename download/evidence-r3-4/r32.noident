INSERT INTO public.question_parts VALUES ('1bb3ac33-7ee4-4a94-a16c-5788a81eaa2d', 'f71dc47e-b1b6-4956-868b-5c109c7ac520', 'a', 'Plot these results on the grid provided. The last two points have been plotted for you. Draw a straight line of best fit for the points you have plotted. mass of sample after heating / g', NULL, 0, 0, '2026-09-13 13:04:21.528305+00');
INSERT INTO public.question_parts VALUES ('64d0df06-332d-440c-ab57-52b43e8f1429', 'f71dc47e-b1b6-4956-868b-5c109c7ac520', 'b', 'Predict the mass of sample remaining after heating for 2.5 minutes. Show on the graph how you obtain your answer.', NULL, 0, 1, '2026-09-13 13:04:21.528334+00');
INSERT INTO public.question_parts VALUES ('2ff30d6c-3495-4c7e-b3da-d12c9f269e6d', 'f71dc47e-b1b6-4956-868b-5c109c7ac520', 'c', 'State why the last two masses in the table are exactly the same.', NULL, 0, 2, '2026-09-13 13:04:21.528361+00');
INSERT INTO public.question_parts VALUES ('226b0962-efa5-4626-85e1-36434673723c', 'f71dc47e-b1b6-4956-868b-5c109c7ac520', 'd', 'A sample of nesquehonite contains 1.68 g of $ \mathrm{M g C O_{3}} $ and 1.08 g of $ \mathrm{H_{2}O}. $ Calculate the value of x in the formula $ \mathrm{M g C O_{3}. x H_{2}O} $ $ [ M_{r} $ of $ \mathrm{M g C O_{3}} $ = 84; $ M_{r} $ of $ \mathrm{H_{2}O}=18] $', NULL, 0, 3, '2026-09-13 13:04:21.528386+00');
INSERT INTO public.question_parts VALUES ('7f218012-a280-4912-b7ac-4bd93f0f4706', 'f71dc47e-b1b6-4956-868b-5c109c7ac520', 'e', 'When anhydrous magnesium carbonate is heated strongly, it decomposes. The equation for the reaction is: $\mathrm {M g C O} _ {3} (\mathrm {s}) \rightarrow \mathrm {M g O} (\mathrm {s}) + \mathrm {C O} _ {2} (\mathrm {g})$ Calculate the volume of carbon dioxide formed in $ cm^{3} $ , at rtp, when 4.2 g of anhydrous magnesium carbonate are completely decomposed. $ [ M_{r} $ of $ MgCO_{3}=84] $ [Assume that the molar volume at rtp of carbon dioxide is $ 24\mathrm{d m}^{3} $ ]', NULL, 0, 4, '2026-09-13 13:04:21.528413+00');
INSERT INTO public.question_parts VALUES ('504d9f61-152c-4d7a-8f91-1c394aca994e', '2d726862-a4df-4a15-856b-21a906fed8c9', 'a', 'The first stage in the manufacture of ammonium nitrate is to react ammonia gas with oxygen gas. $4 \mathrm {N H} _ {3} (\mathrm {g}) + 5 \mathrm {O} _ {2} (\mathrm {g}) \rightleftharpoons 4 \mathrm {N O} (\mathrm {g}) + 6 \mathrm {H} _ {2} \mathrm {O} (\mathrm {g}) \quad \Delta H = - 9 0 7 \mathrm {k J / m o l}$ The reaction is carried out at a pressure of about 10 atm and at a temperature of $ 8 0 0^{\circ} \mathrm{C} $ , in the presence of a catalyst. If the mixture is left for long enough in a sealed container, the reaction reaches a position of dynamic equilibrium. Graph A shows how the percentage of nitrogen monoxide (NO) in the equilibrium mixture varies with temperature at constant pressure. Graph B shows how the percentage of nitrogen monoxide (NO) in the equilibrium mixture varies with pressure at constant temperature.', NULL, 0, 0, '2026-09-13 13:04:21.528443+00');
INSERT INTO public.question_parts VALUES ('ff738228-e18e-4ec3-8095-56844a155c7c', '2d726862-a4df-4a15-856b-21a906fed8c9', 'a-i', 'Explain why the percentage of NO at equilibrium decreases in each case.', NULL, 4, 1, '2026-09-13 13:04:21.528472+00');
INSERT INTO public.question_parts VALUES ('ea416a6c-ca42-419e-bb56-972f6b188b64', '2d726862-a4df-4a15-856b-21a906fed8c9', 'a-ii', 'Explain why the use of a catalyst has no effect on the position of equilibrium in a reversible reaction.', NULL, 0, 2, '2026-09-13 13:04:21.528495+00');
INSERT INTO public.question_parts VALUES ('45cf9ccb-0b61-49f7-95f9-8d9a8a2c4693', '2d726862-a4df-4a15-856b-21a906fed8c9', 'b', 'The second stage in the manufacture of ammonium nitrate is to convert the nitrogen monoxide into nitric acid. The nitric acid is then reacted with concentrated aqueous ammonia as shown in this equation. $\mathrm {H N O} _ {3} (\mathrm {a q}) + \mathrm {N H} _ {3} (\mathrm {a q}) \rightarrow \mathrm {N H} _ {4} \mathrm {N O} _ {3} (\mathrm {a q})$', NULL, 0, 3, '2026-09-13 13:04:21.528521+00');
INSERT INTO public.question_parts VALUES ('f95a530f-999a-4aab-82c2-e72a1adef2c6', '2d726862-a4df-4a15-856b-21a906fed8c9', 'b-i', 'State, in terms of proton transfer, why this reaction is classified as an acid-base reaction.', NULL, 0, 4, '2026-09-13 13:04:21.551027+00');
INSERT INTO public.question_parts VALUES ('b60fa00b-571d-42c8-a51f-a9fb9250198c', '2d726862-a4df-4a15-856b-21a906fed8c9', 'b-ii', 'Calculate the volume of $ 1 4. 8 \mathrm{m o l} / \mathrm{d m}^{3} $ aqueous ammonia that is required to exactly neutralise $ 1 5 0 \mathrm{d m}^{3} $ of a solution of nitric acid of concentration $ 1 5. 8 \mathrm{m o l} / \mathrm{d m}^{3}. $', NULL, 0, 5, '2026-09-13 13:04:21.551152+00');
INSERT INTO public.question_parts VALUES ('061c2ff7-e132-4958-9b48-2dc7d3605f15', '35707b71-d4ea-4116-94bb-74a2d61ab72a', 'a', 'An addition polymer can be formed from the monomer $ \mathrm{C H_{2}=C H C l} $', NULL, 0, 0, '2026-09-13 13:04:21.551207+00');
INSERT INTO public.question_parts VALUES ('e36c23ab-1427-48ad-b4a8-6e1e21cde221', '35707b71-d4ea-4116-94bb-74a2d61ab72a', 'a-i', 'Name this monomer.', NULL, 0, 1, '2026-09-13 13:04:21.551236+00');
INSERT INTO public.question_parts VALUES ('5c240118-cb1b-4dfa-ab2c-a43f373f8abb', '35707b71-d4ea-4116-94bb-74a2d61ab72a', 'a-ii', 'Name the addition polymer formed from this monomer.', NULL, 0, 2, '2026-09-13 13:04:21.551263+00');
INSERT INTO public.question_parts VALUES ('d884cf9b-2198-44f8-b8a6-c373dc7e4ddd', '35707b71-d4ea-4116-94bb-74a2d61ab72a', 'b', 'The diagram shows the repeat unit of a different addition polymer. Draw the displayed formula of the monomer used to make this polymer.', NULL, 0, 3, '2026-09-13 13:04:21.551292+00');
INSERT INTO public.question_parts VALUES ('bc89b84d-6609-433a-9beb-8e6ec2d5ef96', '35707b71-d4ea-4116-94bb-74a2d61ab72a', 'c', 'Polyesters are condensation polymers. The structures of two monomers that are used to make a polyester are: HO—CH $ _{2} $ CH $ _{2} $ —OH', NULL, 0, 4, '2026-09-13 13:04:21.551317+00');
INSERT INTO public.question_parts VALUES ('e3ca6e20-2d63-4c79-b09e-0d033f2f4e1b', '35707b71-d4ea-4116-94bb-74a2d61ab72a', 'c-i', 'Draw the structure of the repeat unit of the polyester formed from these two monomers.', NULL, 0, 5, '2026-09-13 13:04:21.551346+00');
INSERT INTO public.question_parts VALUES ('7ba1563c-a72c-44a9-99ef-64d328d19219', '35707b71-d4ea-4116-94bb-74a2d61ab72a', 'c-ii', 'Identify the small molecule formed when these two monomers form the polyester.', NULL, 0, 6, '2026-09-13 13:04:21.551369+00');
INSERT INTO public.question_parts VALUES ('bc4cf239-0fee-4b61-b194-4f41f8ecdc54', '4b73f97d-24e7-4d6d-876a-125b889926d3', 'a', 'The grapes are collected and crushed to produce an aqueous solution containing glucose. Yeast is added to the solution and the mixture is left to ferment at a temperature of about $ 3 0^{\circ} \mathrm{C} $ in the absence of air.', NULL, 0, 0, '2026-09-13 13:04:21.551669+00');
INSERT INTO public.question_parts VALUES ('7ab99816-b427-4310-b800-047316cad6b6', '4b73f97d-24e7-4d6d-876a-125b889926d3', 'a-i', 'State why yeast is added.', NULL, 0, 1, '2026-09-13 13:04:21.551749+00');
INSERT INTO public.question_parts VALUES ('3c92edc4-7511-4e75-842e-cdf2f48fd5a2', '4b73f97d-24e7-4d6d-876a-125b889926d3', 'a-ii', 'Explain why another organic compound may also be formed if fermentation is carried out in the presence of air.', NULL, 0, 2, '2026-09-13 13:04:21.551779+00');
INSERT INTO public.question_parts VALUES ('0e830880-6c68-4287-88eb-ef43dca860b3', '4b73f97d-24e7-4d6d-876a-125b889926d3', 'a-iii', 'Explain why $ 3 0^{\circ} \mathrm{C} $ is considered to be an optimum temperature for this reaction.', NULL, 0, 3, '2026-09-13 13:04:21.551807+00');
INSERT INTO public.question_parts VALUES ('d39ce80e-5271-4358-b624-d56568a89dd4', '4b73f97d-24e7-4d6d-876a-125b889926d3', 'b', 'Ethanol can also be manufactured by reacting ethene with steam.', NULL, 0, 4, '2026-09-13 13:04:21.551831+00');
INSERT INTO public.question_parts VALUES ('bb816553-6824-4fee-a4fa-4c3bf80bc9ad', '4b73f97d-24e7-4d6d-876a-125b889926d3', 'b-i', 'Write the chemical equation for this reaction.', NULL, 0, 5, '2026-09-13 13:04:21.55186+00');
INSERT INTO public.question_parts VALUES ('5fd156b5-5de8-4ba4-bf99-3f975244310e', '4b73f97d-24e7-4d6d-876a-125b889926d3', 'b-ii', 'Name the type of reaction that occurs.', NULL, 0, 6, '2026-09-13 13:04:21.551886+00');
INSERT INTO public.question_parts VALUES ('cc695d18-b2f2-4a8f-9d40-1e5858093c5a', '4b73f97d-24e7-4d6d-876a-125b889926d3', 'b-iii', 'State two conditions used for this reaction in industry.', NULL, 0, 7, '2026-09-13 13:04:21.551922+00');
INSERT INTO public.question_parts VALUES ('03fe6425-dabf-401e-a288-e97c4f2067a3', '4b73f97d-24e7-4d6d-876a-125b889926d3', 'c', 'Grapes also contain esters. The formula of an ester is shown. Deduce the name of the carboxylic acid and the alcohol that can react together to make this ester. carboxylic acid alcohol..', NULL, 0, 8, '2026-09-13 13:04:21.551949+00');
