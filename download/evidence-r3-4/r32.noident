INSERT INTO public.questions VALUES ('cdded9be-1442-447e-ac2a-6707130703e2', 'q04-8569da15', 'STRUCTURED', '(a) The diagram shows a fractionating column used to separate crude oil into fractions. (i) Give one use for refinery gases and one use for bitumen. refinery gases bitumen (ii) Give a reason why refinery gases rise to the top of the column. (iii) State what must happen to the crude oil before it is pumped into the column.', 9, 3, 810, NULL, '47804504-39de-4ee1-92a2-a7db8b622911', 'PAST_PAPER', true, 1, '2026-09-13 13:03:38.672832+00', 'a1fe4676-0a3e-4bb5-9ac4-d0910cebf652');
INSERT INTO public.questions VALUES ('e24f49c9-20cd-4044-91fd-cec45af85f0b', 'q05-8569da15', 'STRUCTURED', 'This question is about the insoluble salt, lead(II) bromide. Lead(II) bromide can be made by a precipitation reaction. This is the equation for the reaction. $\mathrm {P b} \left(\mathrm {N O} _ {3}\right) _ {2} (\mathrm {a q}) + 2 \mathrm {K B r} (\mathrm {a q}) \rightarrow \mathrm {P b B r} _ {2} (\mathrm {s}) + 2 \mathrm {K N O} _ {3} (\mathrm {a q})$', 1, 3, 90, NULL, '47804504-39de-4ee1-92a2-a7db8b622911', 'PAST_PAPER', true, 1, '2026-09-13 13:03:38.673076+00', 'a1fe4676-0a3e-4bb5-9ac4-d0910cebf652');
INSERT INTO public.questions VALUES ('608ac57a-abd0-40d4-bac0-1f5749dd5099', 'q06-8569da15', 'STRUCTURED', '(a) Describe the forces of attraction in metallic bonding.', 15, 3, 1350, NULL, '47804504-39de-4ee1-92a2-a7db8b622911', 'PAST_PAPER', true, 1, '2026-09-13 13:03:38.673295+00', 'a1fe4676-0a3e-4bb5-9ac4-d0910cebf652');
INSERT INTO public.questions VALUES ('36a2dc3a-71b2-45c2-a9de-4382582e1283', 'q02-3745aeee', 'STRUCTURED', '(a) The diagram represents an atom of an element. (i) What is the name of the particle labelled W? (ii) What is the mass number of this atom? A 4 B 5 C 9 D 13', 6, 3, 540, NULL, '8b853a0d-1f3e-4b11-bc42-6a02bbc88a60', 'PAST_PAPER', true, 1, '2026-09-13 13:04:21.290924+00', 'cf7567d7-fb54-48e9-a7df-e7564ce02a71');
INSERT INTO public.questions VALUES ('f7d2fc73-cfbb-4317-83e9-38c6909fb8d9', 'q03-3745aeee', 'STRUCTURED', 'This question is about magnesium metal and its compounds.', 1, 3, 90, NULL, '8b853a0d-1f3e-4b11-bc42-6a02bbc88a60', 'PAST_PAPER', true, 1, '2026-09-13 13:04:21.291269+00', 'cf7567d7-fb54-48e9-a7df-e7564ce02a71');
INSERT INTO public.questions VALUES ('2d442e82-b583-4084-93ef-257cf5d2f5f5', 'q04-3745aeee', 'STRUCTURED', 'This question is about the manufacture of ethanol by the fermentation of glucose.', 1, 3, 90, NULL, '8b853a0d-1f3e-4b11-bc42-6a02bbc88a60', 'PAST_PAPER', true, 1, '2026-09-13 13:04:21.29209+00', 'cf7567d7-fb54-48e9-a7df-e7564ce02a71');
INSERT INTO public.questions VALUES ('b9a167eb-64d7-4eae-8c2b-6da3e989075b', 'q05-3745aeee', 'STRUCTURED', 'Sodium sulfate can be prepared by the reaction between sodium hydroxide solution and sodium hydrogensulfate $ \mathrm{(N a H S O_{4})} $ solution. This is the equation for the reaction. $\mathrm {N a O H} (\mathrm {a q}) + \mathrm {N a H S O} _ {4} (\mathrm {a q}) \rightarrow \mathrm {N a} _ {2} \mathrm {S O} _ {4} (\mathrm {a q}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {I})$ Sodium hydrogensulfate solution is acidic. The student does a titration. A student adds $ 2 5. 0 \mathrm{c m}^{3} $ of sodium hydroxide solution to a conical flask and adds two drops of indicator.', 14, 3, 1260, NULL, '8b853a0d-1f3e-4b11-bc42-6a02bbc88a60', 'PAST_PAPER', true, 1, '2026-09-13 13:04:21.292586+00', 'cf7567d7-fb54-48e9-a7df-e7564ce02a71');
INSERT INTO public.questions VALUES ('b1be0beb-9eca-4048-97fc-615009d982a0', 'q06-3745aeee', 'STRUCTURED', 'This question is about electrolysis.', 11, 3, 990, NULL, '8b853a0d-1f3e-4b11-bc42-6a02bbc88a60', 'PAST_PAPER', true, 1, '2026-09-13 13:04:21.298966+00', 'cf7567d7-fb54-48e9-a7df-e7564ce02a71');
INSERT INTO public.questions VALUES ('affe86c5-6438-47ed-8eff-f342f4697229', 'q07-3745aeee', 'STRUCTURED', 'Gaseous ethanol is manufactured by reacting ethene gas with steam. This is the equation for the reaction. $\mathrm {C} _ {2} \mathrm {H} _ {4} (\mathrm {g}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {g}) \rightleftharpoons \mathrm {C} _ {2} \mathrm {H} _ {5} \mathrm {O H} (\mathrm {g})$', 15, 3, 1350, NULL, '8b853a0d-1f3e-4b11-bc42-6a02bbc88a60', 'PAST_PAPER', true, 1, '2026-09-13 13:04:21.299372+00', 'cf7567d7-fb54-48e9-a7df-e7564ce02a71');
INSERT INTO public.questions VALUES ('d2206395-1841-434a-8fba-6cb5ebb8fe2f', 'q01-3c53d76f', 'STRUCTURED', 'The table shows some properties of four substances, P, Q, R and S. Use the information in the table to answer the following questions. You may use each letter once, more than once or not at all. Choose a substance that:', 4, 3, 360, NULL, '44b22d64-0841-4684-90e4-14e2b32cda55', 'PAST_PAPER', true, 1, '2026-09-13 13:04:21.507855+00', '3a6b72b8-077b-4cb0-af32-ac9603696a15');
INSERT INTO public.questions VALUES ('6bf422d6-6030-473a-a44a-543b10cefade', 'q02-3c53d76f', 'STRUCTURED', 'This is a method used to measure the solubility of a solid in water: add an excess of solid to some water in a boiling tube and stir measure the temperature of the saturated solution formed weigh an empty evaporating basin pour some of the saturated solution into the evaporating basin weigh the basin and contents heat the evaporating basin to remove all of the water weigh the evaporating basin and remaining solid.', 7, 3, 630, NULL, '44b22d64-0841-4684-90e4-14e2b32cda55', 'PAST_PAPER', true, 1, '2026-09-13 13:04:21.510108+00', '3a6b72b8-077b-4cb0-af32-ac9603696a15');
INSERT INTO public.questions VALUES ('109efaa8-8c71-4b25-9cb0-41698f4cdf50', 'q03-3c53d76f', 'STRUCTURED', 'Astatine, bromine, chlorine, fluorine and iodine are all halogens. They are found in Group 7 of the Periodic Table.', 7, 3, 630, NULL, '44b22d64-0841-4684-90e4-14e2b32cda55', 'PAST_PAPER', true, 1, '2026-09-13 13:04:21.511374+00', '3a6b72b8-077b-4cb0-af32-ac9603696a15');
INSERT INTO public.questions VALUES ('88a62dee-24ac-41c3-886b-abc47a8a44a1', 'q04-3c53d76f', 'STRUCTURED', 'A technician finds a white solid in an unlabelled beaker. She knows that the solid is one of the following substances: potassium chloride potassium sulfate sodium chloride sodium sulfate. Describe how the technician can use chemical tests to identify the solid in the beaker.', 6, 3, 540, NULL, '44b22d64-0841-4684-90e4-14e2b32cda55', 'PAST_PAPER', true, 1, '2026-09-13 13:04:21.513289+00', '3a6b72b8-077b-4cb0-af32-ac9603696a15');
INSERT INTO public.questions VALUES ('720a9209-1034-42a4-97ab-08dc7a3fccff', 'q05-3c53d76f', 'STRUCTURED', 'Zinc metal is obtained from sulfide ores. The most common ore of zinc is sphalerite, which contains zinc sulfide (ZnS) and a small amount of cadmium sulfide (CdS). The stages involved in the extraction of zinc from sphalerite are: Stage1 Sphalerite is strongly heated in air. $2 \mathrm {Z n S} (\mathrm {s}) + 3 \mathrm {O} _ {2} (\mathrm {g}) \rightarrow 2 \mathrm {Z n O} (\mathrm {s}) + 2 \mathrm {S O} _ {2} (\mathrm {g})$ $2 \mathrm {C d S} (\mathrm {s}) + 3 \mathrm {O} _ {2} (\mathrm {g}) \rightarrow 2 \mathrm {C d O} (\mathrm {s}) + 2 \mathrm {S O} _ {2} (\mathrm {g})$ Stage 2 The mixture of oxides is reacted with sulfuric acid. $\mathrm {Z n O (s)} + \mathrm {H} _ {2} \mathrm {S O} _ {4} (\mathrm {a q}) \rightarrow \mathrm {Z n S O} _ {4} (\mathrm {a q}) + \mathrm {H} _ {2} \mathrm {O} (\mathrm {I})$ $\mathrm {C d O (s)} + \mathrm {H} _ {2} \mathrm {S O} _ {4} (\mathrm {a q}) \rightarrow \mathrm {C d S O} _ {4} (\mathrm {a q}) + \mathrm {H} _ {2} \mathrm {O (l)}$ Stage 3 Zinc dust is added to the solution containing zinc sulfate and cadmium sulfate to remove the cadmium ions. $\mathrm {C d} ^ {2 +} (\mathrm {a q}) + \mathrm {Z n} (\mathrm {s}) \rightarrow \mathrm {C d} (\mathrm {s}) + \mathrm {Z n} ^ {2 +} (\mathrm {a q})$ Stage 4 The solid cadmium is filtered off and the pure zinc sulfate solution is electrolysed.', 8, 3, 720, NULL, '44b22d64-0841-4684-90e4-14e2b32cda55', 'PAST_PAPER', true, 1, '2026-09-13 13:04:21.5148+00', '3a6b72b8-077b-4cb0-af32-ac9603696a15');
INSERT INTO public.questions VALUES ('bcc5c8f8-8ce2-488d-8097-7afef31cff08', 'q06-3c53d76f', 'STRUCTURED', 'The mineral nesquehonite is a form of hydrated magnesium carbonate. The formula, $ \mathrm{M g C O_{3}. x H_{2} O} $ , shows that nesquehonite contains water of crystallisation. When a sample of nesquohonite is heated gently, the water of crystallisation is given off and anhydrous magnesium carbonate is left. Six students are each given a sample of nesquehonite of mass 6.1 g. The students heat their samples for different times. The samples are then allowed to cool before being reweighed. The table shows their results.', 11, 3, 990, NULL, '44b22d64-0841-4684-90e4-14e2b32cda55', 'PAST_PAPER', true, 1, '2026-09-13 13:04:21.515291+00', '3a6b72b8-077b-4cb0-af32-ac9603696a15');
INSERT INTO public.questions VALUES ('88044413-80bb-4ae7-8fc8-f5ec3224181f', 'q07-3c53d76f', 'STRUCTURED', 'Ammonia is manufactured on a large scale and is used to make fertilisers such as ammonium nitrate $ \mathrm{(N H_{4} N O_{3})}. $', 1, 3, 90, NULL, '44b22d64-0841-4684-90e4-14e2b32cda55', 'PAST_PAPER', true, 1, '2026-09-13 13:04:21.51567+00', '3a6b72b8-077b-4cb0-af32-ac9603696a15');
INSERT INTO public.questions VALUES ('00a6cc4c-ed10-4298-844f-6aaf910837a7', 'q08-3c53d76f', 'STRUCTURED', 'Polymers can be classified as addition polymers or condensation polymers.', 1, 3, 90, NULL, '44b22d64-0841-4684-90e4-14e2b32cda55', 'PAST_PAPER', true, 1, '2026-09-13 13:04:21.51642+00', '3a6b72b8-077b-4cb0-af32-ac9603696a15');
INSERT INTO public.questions VALUES ('68976259-5da6-40e0-a1e5-ab0c1bea7a3b', 'q09-3c53d76f', 'STRUCTURED', 'Grapes contain glucose that can be fermented to make ethanol.', 12, 3, 1080, NULL, '44b22d64-0841-4684-90e4-14e2b32cda55', 'PAST_PAPER', true, 1, '2026-09-13 13:04:21.51706+00', '3a6b72b8-077b-4cb0-af32-ac9603696a15');
