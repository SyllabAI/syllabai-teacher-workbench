INSERT INTO public.question_parts VALUES ('c92c1a7a-9f39-43f0-bcd6-278f03c79558', 'ffcd5b0a-676e-4b28-9155-4c56767da24a', 'c-i', 'A mass of 0.500g of zinc is reacted with an excess of copper(II) sulfate solution. The heat energy change is 1.67 kJ. Calculate the molar enthalpy change, $ \Delta H $ , in kJ/mol. Include a sign in your answer. Give your answer to three significant figures. $\Delta H =$', NULL, 0, 6, '2026-09-13 12:54:40.61048+00');
INSERT INTO public.question_parts VALUES ('d4899b3b-fb4e-4d2e-a858-6fe3cccce3d9', 'ffcd5b0a-676e-4b28-9155-4c56767da24a', 'c-ii', 'The ionic equation for the reaction between zinc and copper(II) sulfate is $\mathrm {Z n} (\mathrm {s}) + \mathrm {C u} ^ {2 +} (\mathrm {a q}) \rightarrow \mathrm {Z n} ^ {2 +} (\mathrm {a q}) + \mathrm {C u} (\mathrm {s})$ Explain why this is a redox reaction.', NULL, 0, 7, '2026-09-13 12:54:40.610518+00');
