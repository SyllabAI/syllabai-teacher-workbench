INSERT INTO public.questions VALUES ('622fb21d-e467-4b24-a25f-d3b9db4b8f74', 'q05-d9f7c281', 'STRUCTURED', 'When copper(II) sulfate solution is electrolysed, copper forms at the negative electrode. A student uses this apparatus to investigate the electrolysis of copper(II) sulfate solution.', 10, 3, 900, NULL, '1eadc1ae-d0f5-405f-9a3c-bbfcb58eeb34', 'PAST_PAPER', true, 1, '2026-09-13 13:03:38.505075+00', '6538f327-91b4-4cfb-beef-f401554e16b6');
INSERT INTO public.questions VALUES ('aab2a4ef-255e-4d24-ae78-b1c1f3efa7a7', 'q02-b5287cd4', 'STRUCTURED', 'Structures made of iron can rust.', 5, 3, 450, NULL, '1e61f0e6-54c5-47de-b0a4-358b01066ef9', 'PAST_PAPER', true, 1, '2026-09-13 13:04:21.01891+00', '18a83861-0171-448b-b9b9-a54078160e47');
