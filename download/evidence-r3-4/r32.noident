tem"], "questions": [{"mcq": false, "qwc": false, "stem": "The diagram represents an atom of an element.", "marks": 5, "parts": [{"qwc": false, "text": "What is the particle labelled X? A an electron B an ion C a proton D a neutron", "label": "a", "marks": null, "partId": "q01-65fd691d-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "What is the mass number of this atom? A 4 B 5 C 9 D 13", "label": "a-ii", "marks": null, "partId": "q01-65fd691d-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Name the element that contains these atoms.", "label": "a-iii", "marks": null, "partId": "q01-65fd691d-pa-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Hydrogen has three isotopes. State, in terms of subatomic particles, one way in which these isotopes are the same and one way in which they are different. different", "label": "b", "marks": null, "partId": "q01-65fd691d-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 1, "figures": [{"url": "assets/crop_1_1789069505792.png", "width": 621, "format": "png", "height": 581, "sha256": "4468b9157039083ee2eb9ab93994014e0bde11ee8c627eee0b25a5386b646026", "assetId": "img:4468b9157039083ee2eb9ab93994014e0bde11ee8c627eee0b25a5386b646026", "mimeType": "image/jpeg", "elementId": "e000023", "sourceName": "assets/crop_1_1789069505792.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q01-65fd691d", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "A small piece of magnesium ribbon is added to dilute sulfuric acid in a test tube. Hydrogen gas is produced.", "marks": 4, "parts": [{"qwc": false, "text": "State two observations that are seen during the reaction.", "label": "a", "marks": null, "partId": "q02-65fd691d-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The reaction is exothermic. State what happens to the temperature of the acid during the reaction.", "label": "b", "marks": null, "partId": "q02-65fd691d-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Write a word equation for the reaction.", "label": "c", "marks": null, "partId": "q02-65fd691d-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 2, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q02-65fd691d", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "This apparatus can be used to prepare carbon dioxide from reagents A and B.", "marks": 6, "parts": [{"qwc": false, "text": "Calcium chloride and water are also products of the reaction between A and B. Identify reagent A and reagent B.", "label": "a", "marks": null, "partId": "q03-65fd691d-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "In the diagram, the carbon dioxide is collected over water. State another way of collecting the carbon dioxide.", "label": "b", "marks": null, "partId": "q03-65fd691d-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "At the end of the experiment, the solution in the trough is weakly acidic.", "label": "c", "marks": null, "partId": "q03-65fd691d-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State the colour of the solution when some Universal Indicator is added.", "label": "c-i", "marks": null, "partId": "q03-65fd691d-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give the name and the formula of the acid that forms when carbon dioxide dissolves in water. name ... formula", "label": "c-ii", "marks": null, "partId": "q03-65fd691d-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 3, "figures": [{"url": "assets/crop_1_1789069505814.png", "width": 1217, "format": "png", "height": 607, "sha256": "b257e6a096232ee900aa044d52627926deac5fcd6ab20a94ffe3ef84212384b1", "assetId": "img:b257e6a096232ee900aa044d52627926deac5fcd6ab20a94ffe3ef84212384b1", "mimeType": "image/jpeg", "elementId": "e000046", "sourceName": "assets/crop_1_1789069505814.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q03-65fd691d", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "Crude oil is a complex mixture containing many compounds and is a source of many chemicals.", "marks": 9, "parts": [{"qwc": false, "text": "Most of the compounds in crude oil contain two elements. Name these two elements. and", "label": "a", "marks": null, "partId": "q04-65fd691d-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Crude oil is separated into fractions in order to produce useful chemicals.", "label": "b", "marks": null, "partId": "q04-65fd691d-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State what is meant by the term fraction.", "label": "b-i", "marks": null, "partId": "q04-65fd691d-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Describe the industrial process used to obtain fractions from crude oil.", "label": "b-ii", "marks": null, "partId": "q04-65fd691d-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The box shows four fractions obtained from crude oil. bitumen diesel fuel oil gasoline", "label": "c", "marks": null, "partId": "q04-65fd691d-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Which of these fractions contains compounds with the highest boiling points?", "label": "c-i", "marks": null, "partId": "q04-65fd691d-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Which of these fractions is the most volatile?", "label": "c-ii", "marks": null, "partId": "q04-65fd691d-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Fuel oil can be burned to heat homes. If combustion is incomplete, a dangerous gas is produced.", "label": "d", "marks": null, "partId": "q04-65fd691d-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Name this gas.", "label": "d-i", "marks": null, "partId": "q04-65fd691d-pd-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State why this gas is dangerous.", "label": "d-ii", "marks": null, "partId": "q04-65fd691d-pd-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 4, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q04-65fd691d", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "Ammonia is a toxic gas that is very soluble in water. This is the teacher''s method. pour 100 $ cm^{3} $ of water into the beaker and measure the temperature of the water place the beaker on the balance and record the mass of the beaker and water bubble ammonia into the water until the mass is constant record the constant mass The teacher repeats the experiment with the water at different temperatures. The table shows the teacher''s results. A teacher uses this apparatus to investigate the solubility of ammonia in water at different temperatures.", "marks": 6, "parts": [{"qwc": false, "text": "Calculate the mass of ammonia dissolved in $ 1 0 0 \\mathrm{c m}^{3} $ of water at $ 2 5 \\mathrm{^o C}. $", "label": "a", "marks": null, "partId": "q05-65fd691d-pa", "figures": [], "confidence": 0.55, "answerPrompts": ["mass of ammonia"]}, {"qwc": false, "text": "State the relationship between temperature and solubility of ammonia.", "label": "a-ii", "marks": null, "partId": "q05-65fd691d-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain one safety precaution that the teacher should take when doing this experiment.", "label": "b", "marks": null, "partId": "q05-65fd691d-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "When the teacher does the experiment at a higher temperature, the reading on the balance gradually increases but then slowly decreases. Suggest why the reading on the balance slowly decreases.", "label": "c", "marks": null, "partId": "q05-65fd691d-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Ammonia is an alkaline gas. Suggest a different method that the teacher could use to compare the mass of ammonia dissolved in the water at different temperatures.", "label": "d", "marks": null, "partId": "q05-65fd691d-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 5, "figures": [{"url": "assets/crop_1_1789069505838.png", "width": 1157, "format": "png", "height": 614, "sha256": "78bba91522f83ba2702eaba6658e234792225a4bc471699c32d15436387caee3", "assetId": "img:78bba91522f83ba2702eaba6658e234792225a4bc471699c32d15436387caee3", "mimeType": "image/jpeg", "elementId": "e000074", "sourceName": "assets/crop_1_1789069505838.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q05-65fd691d", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000082"]}, {"mcq": false, "qwc": false, "stem": "Ethanol can be made by two different methods. method1 fermentation of glucose method2 reaction of ethene with steam", "marks": 10, "parts": [{"qwc": false, "text": "Name the catalyst used in each method. method 1", "label": "a", "marks": null, "partId": "q06-65fd691d-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Two companies produce ethanol for different purposes. The table gives some information about each company. Explain which method of production each company is more likely to use. Company A Company B", "label": "b", "marks": 4, "partId": "q06-65fd691d-pb", "figures": [], "confidence": 0.8, "answerPrompts": []}, {"qwc": false, "text": "Most of the ethene used to make polymers is produced by the cracking of crude oil fractions.", "label": "c", "marks": null, "partId": "q06-65fd691d-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "One of the polymers made from ethene is poly(ethene). Complete the equation to show the formation of poly(ethene) from ethene.", "label": "c-i", "marks": null, "partId": "q06-65fd691d-pc-i", "figures": [{"url": "assets/crop_1_1789069505858.png", "width": 347, "format": "png", "height": 199, "sha256": "b05ae8a5520739bfd8f4b89570932d6b14ad2c3daf6c3a7b5882a0aeceb696a1", "assetId": "img:b05ae8a5520739bfd8f4b89570932d6b14ad2c3daf6c3a7b5882a0aeceb696a1", "mimeType": "image/jpeg", "elementId": "e000106", "sourceName": "assets/crop_1_1789069505858.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The kerosene fraction obtained from crude oil contains a hydrocarbon with the formula $ \\mathrm{C_{1 6} H_{3 4}} $ Complete the equation to show the formation of ethene and one molecule of another hydrocarbon from the cracking of $ \\mathrm{C_{1 6} H_{3 4}} $ $\\mathrm {C} _ {1 6} \\mathrm {H} _ {3 4} \\rightarrow 2 \\mathrm {C} _ {2} \\mathrm {H} _ {4} +$", "label": "c-ii", "marks": null, "partId": "q06-65fd691d-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Suggest why it may be necessary, in future, to make ethene from ethanol.", "label": "c-iii", "marks": null, "partId": "q06-65fd691d-pc-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 6, "figures": [{"url": "assets/crop_1_1789069505858.png", "width": 347, "format": "png", "height": 199, "sha256": "b05ae8a5520739bfd8f4b89570932d6b14ad2c3daf6c3a7b5882a0aeceb696a1", "assetId": "img:b05ae8a5520739bfd8f4b89570932d6b14ad2c3daf6c3a7b5882a0aeceb696a1", "mimeType": "image/jpeg", "elementId": "e000106", "sourceName": "assets/crop_1_1789069505858.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q06-65fd691d", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000098"]}, {"mcq": false, "qwc": false, "stem": "A student uses this apparatus to investigate the change in temperature when dilute hydrochloric acid is added to aqueous sodium hydroxide. This is the student''s method. pour some aqueous sodium hydroxide into the polystyrene cup record the temperature of the sodium hydroxide add some dilute hydrochloric acid and stir the mixture record the highest temperature of the mixture The student repeats the experiment using different volumes of the two solutions.", "marks": 12, "parts": [{"qwc": false, "text": "Explain why the student uses a polystyrene cup to contain the solution,rather than a beaker.", "label": "a", "marks": null, "partId": "q07-65fd691d-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The diagram shows the thermometer readings for one experiment before and after adding the acid. Record the temperatures before and after adding the acid. before ... °C after ... °C", "label": "b", "marks": null, "partId": "q07-65fd691d-pb", "figures": [{"url": "assets/crop_2_1789069505878.png", "width": 552, "format": "png", "height": 435, "sha256": "4ab4f0fc570b88331a1a9666e9f8d085819decf3922f277cc8567c32f12d352d", "assetId": "img:4ab4f0fc570b88331a1a9666e9f8d085819decf3922f277cc8567c32f12d352d", "mimeType": "image/jpeg", "elementId": "e000123", "sourceName": "assets/crop_2_1789069505878.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The table shows the results of a series of experiments. The initial temperatures of the aqueous sodium hydroxide and the dilute hydrochloric acid are the same.", "label": "c", "marks": null, "partId": "q07-65fd691d-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Plot the results from the table on the grid. Highest temperature of mixture in $ ^{\\circ} \\mathrm{C} $ Volume of aqueous sodium hydroxide in $ \\mathrm{c m}^{3} $ Draw a straight line of best fit for experiments 1,2 and 3. Draw a second straight line of best fit for experiments 4,5 and 6. Extend both lines so that they cross.", "label": "c-i", "marks": null, "partId": "q07-65fd691d-pc-i", "figures": [{"url": "assets/crop_1_1789069505902.png", "width": 1055, "format": "png", "height": 1039, "sha256": "a2ef520b66c1c8709bb9ff82a308e93dcaea2a43dd43407ed94f936b42abb334", "assetId": "img:a2ef520b66c1c8709bb9ff82a308e93dcaea2a43dd43407ed94f936b42abb334", "mimeType": "image/jpeg", "elementId": "e000132", "sourceName": "assets/crop_1_1789069505902.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The point where the two lines cross indicates when equal amounts, in moles, of sodium hydroxide and hydrochloric acid react. Use your graph to find the volumes that contain equal amounts of sodium hydroxide and hydrochloric acid. volume of sodium hydroxide volume of hydrochloric acid", "label": "c-ii", "marks": null, "partId": "q07-65fd691d-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The equation for the reaction between sodium hydroxide and hydrochloric acid is $\\mathrm {N a O H} + \\mathrm {H C l} \\rightarrow \\mathrm {N a C l} + \\mathrm {H} _ {2} \\mathrm {O}$ Explain which solution, the sodium hydroxide or the hydrochloric acid, has the greater concentration.", "label": "c-iii", "marks": null, "partId": "q07-65fd691d-pc-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 7, "figures": [{"url": "assets/crop_1_1789069505871.png", "width": 701, "format": "png", "height": 429, "sha256": "3eaf4fcfa1157a21270c9acb069f4471151e158e0e3cd8b3c8d0db9694c2e78b", "assetId": "img:3eaf4fcfa1157a21270c9acb069f4471151e158e0e3cd8b3c8d0db9694c2e78b", "mimeType": "image/jpeg", "elementId": "e000114", "sourceName": "assets/crop_1_1789069505871.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789069505878.png", "width": 552, "format": "png", "height": 435, "sha256": "4ab4f0fc570b88331a1a9666e9f8d085819decf3922f277cc8567c32f12d352d", "assetId": "img:4ab4f0fc570b88331a1a9666e9f8d085819decf3922f277cc8567c32f12d352d", "mimeType": "image/jpeg", "elementId": "e000123", "sourceName": "assets/crop_2_1789069505878.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_1_1789069505902.png", "width": 1055, "format": "png", "height": 1039, "sha256": "a2ef520b66c1c8709bb9ff82a308e93dcaea2a43dd43407ed94f936b42abb334", "assetId": "img:a2ef520b66c1c8709bb9ff82a308e93dcaea2a43dd43407ed94f936b42abb334", "mimeType": "image/jpeg", "elementId": "e000132", "sourceName": "assets/crop_1_1789069505902.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q07-65fd691d", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000129"]}, {"mcq": false, "qwc": false, "stem": "A student does a titration to find the concentration of a solution of nitric acid. This is the student''s method. pipette 25.0 $ cm^{3} $ of the nitric acid into a conical flask add a few drops of indicator add aqueous potassium hydroxide from a burette until the indicator just changes colour determine the volume of alkali added from the burette The concentration of the potassium hydroxide solution is 0.0200 mol/dm $ ^{3} $ The volume of potassium hydroxide required to neutralise the acid is $ 2 3. 5 0 \\mathrm{c m}^{3}. $ The equation for the reaction between nitric acid and potassium hydroxide is $\\mathrm {H N O} _ {3} + \\mathrm {K O H} \\rightarrow \\mathrm {K N O} _ {3} + \\mathrm {H} _ {2} \\mathrm {O}$", "marks": 8, "parts": [{"qwc": false, "text": "Calculate the amount, in moles, of KOH used in this titration. $\\mathrm {a m o u n t o f K O H} =$", "label": "a", "marks": null, "partId": "q08-65fd691d-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the concentration, in mol/dm $ ^{3} $ , of the nitric acid.", "label": "a-ii", "marks": null, "partId": "q08-65fd691d-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The student makes a solution of potassium nitrate by neutralising aqueous potassium hydroxide with dilute nitric acid. Describe how he could use crystallisation to obtain a pure, dry sample of potassium nitrate crystals from the solution of potassium nitrate. Every effort has been made to contact copyright holders to obtain their permission for the use of copyright material. Pearson Education Ltd. will, if notified, be happy to rectify any errors or omissions and include any such rectifications in future editions.", "label": "b", "marks": null, "partId": "q08-65fd691d-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 8, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q08-65fd691d", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}], "paperTotal": 60, "schemaVersion": "1.0", "sectionTotals": {}, "questionTotals": {"1": 5, "2": 4, "3": 6, "4": 9, "5": 6, "6": 10, "7": 12, "8": 8}, "reviewRequired": true, "extractionMethod": "glm-ocr-qp-v1", "frontMatterFigures": []}', '{"paper": {"board": "Edexcel", "session": "Summer 2017", "subject": null, "duration": null, "examDate": null, "logNumber": null, "qualification": null, "paperReference": null, "publicationCode": null, "canonicalDocumentId": "4f3e8b3c-78e8-5005-b586-cbe9d600cb5e"}, "entries": [{"mcq": false, "qwc": false, "label": "1(a)(i)", "marks": 1, "number": 1, "entryId": "ms-4f3e8b3c-q1ai", "guidance": [{"kind": "note", "text": "The only correct answer is C"}, {"kind": "note", "text": "A is not correct because X is not an electron"}, {"kind": "note", "text": "B is not correct because X is not an ion"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "C(9)"}, {"kind": "note", "text": "The only correct answer is C"}, {"kind": "note", "text": "A is not correct because the sum of the number of protons and neutrons is 9 not 4"}, {"kind": "note", "text": "B is not correct because the sum of the number of protons and neutrons is 9 not 5"}, {"kind": "note", "text": "(iii)"}, {"kind": "note", "text": "beryllium"}, {"kind": "note", "text": "ACCEPT Be"}], "answerText": "C(proton)", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "2(a)", "marks": 2, "number": 2, "entryId": "ms-4f3e8b3c-q2a", "guidance": [{"kind": "note", "text": "ACCEPT fizzing"}, {"kind": "note", "text": "M2 magnesium disappears/magnesium gets smaller"}, {"kind": "note", "text": "ACCEPT magnesium dissolves"}, {"kind": "note", "text": "(b) increases"}, {"kind": "note", "text": "ACCEPT gets hotter"}, {"kind": "note", "text": "(c) magnesium+(dilute)sulfuric acid→magnesium sulfate+hydrogen"}, {"kind": "allow", "text": "ALLOW chemical equationIf both word and chemical equation given mark word equation only"}, {"kind": "note", "text": "Total"}], "answerText": "M1 bubbles(of gas)/effervescence\nALLOW solid for magnesium\nIGNORE reference to movement\nIGNORE reference to temperature change", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "3(a)", "marks": 2, "number": 3, "entryId": "ms-4f3e8b3c-q3a", "guidance": [{"kind": "note", "text": "If both name and formula given, both must be correct."}, {"kind": "note", "text": "State symbol not needed, but penalise if incorrect"}, {"kind": "note", "text": "If both name and formula given, both must be correct"}, {"kind": "note", "text": "(b)"}, {"kind": "note", "text": "(gas) syringe/downward delivery(in air)"}, {"kind": "note", "text": "ACCEPT upward displacement of air"}, {"kind": "note", "text": "(c)(i)"}, {"kind": "note", "text": "orange/yellow"}, {"kind": "note", "text": "ACCEPT yellow-orange"}, {"kind": "ignore", "text": "IGNORE shades or qualifiers,e.g. light"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "M1(name) carbonic acid"}, {"kind": "note", "text": "M2(formula)H2CO3"}, {"kind": "allow", "text": "ALLOW as the only product of an equation"}, {"kind": "note", "text": "Total"}], "answerText": "M1(A) hydrochloric acid/HCl(aq)\nM2(B) calcium carbonate/marble\n/limestone/chalk/CaCO3", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "4(a)", "marks": 1, "number": 4, "entryId": "ms-4f3e8b3c-q4a", "guidance": [{"kind": "note", "text": "ACCEPT in either order"}, {"kind": "note", "text": "ACCEPT C and H"}, {"kind": "note", "text": "if both names and symbols given, mark name only"}, {"kind": "note", "text": "(b)(i)"}, {"kind": "note", "text": "(a mixture of)"}, {"kind": "note", "text": "compounds/hydrocarbons/substances with similar boiling points"}, {"kind": "note", "text": "REJECT elements"}, {"kind": "note", "text": "REJECT same boiling points"}, {"kind": "allow", "text": "ALLOW references to condense at similar temperatures"}, {"kind": "allow", "text": "ALLOW references to similar carbon chain length"}, {"kind": "ignore", "text": "IGNORE references to other physical properties e.g. viscosity"}, {"kind": "ignore", "text": "IGNORE references to similar chemical properties"}], "answerText": "hydrogen AND carbon", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "6(a)", "marks": 2, "number": 6, "entryId": "ms-4f3e8b3c-q6a", "guidance": [{"kind": "note", "text": "ACCEPT yeast"}, {"kind": "note", "text": "M2(method 2)phosphoric acid/H3PO4"}, {"kind": "note", "text": "If both name and formula given, mark name only"}, {"kind": "note", "text": "(b)"}, {"kind": "note", "text": "M1company A chooses method 1/fermentation AND company B chooses method 2/ethene with steam/hydration"}, {"kind": "note", "text": "M2company A has(access to)a supply of sugar(cane)/glucose"}, {"kind": "note", "text": "M3company B can obtain ethene from crude oil/an oil refinery"}, {"kind": "note", "text": "M4company A does not need pure ethanol/company B does need pure ethanol"}, {"kind": "ignore", "text": "IGNORE company A only needs a dilute solution of ethanolIGNORE references to batch/continuous processes"}, {"kind": "note", "text": "(c)(i)"}, {"kind": "note", "text": "Chemical structure"}, {"kind": "note", "text": "M1one correct repeat unit drawn with continuation bonds e.g.HCCHnor-CH2-CH2-M2rest of diagram correct ie brackets and balanced using n"}], "answerText": "M1(method 1)zymase", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "7(a)", "marks": 2, "number": 7, "entryId": "ms-4f3e8b3c-q7a", "guidance": [{"kind": "allow", "text": "ALLOW polystyrene is an insulator"}, {"kind": "note", "text": "M2 so less heat(energy)/thermal energy is transferred/lost to the surroundings/atmosphere/air"}, {"kind": "note", "text": "REJECT no heat loss to the surroundings"}, {"kind": "note", "text": "(b)"}, {"kind": "note", "text": "M1(before)18.6(0℃)"}, {"kind": "note", "text": "one mark for correct answers in the wrong order"}, {"kind": "note", "text": "M2(after)22.8(0℃)"}, {"kind": "ignore", "text": "Ignore trailing zeros e.g. accept 18.60"}], "answerText": "M1 polystyrene is a better insulator", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "8(b)", "marks": 4, "number": 8, "entryId": "ms-4f3e8b3c-q8b", "guidance": [{"kind": "note", "text": "ACCEPT heat/boil to produce a (hot) saturated/concentrated solution"}, {"kind": "note", "text": "ACCEPT heat/boil until crystals start/begin to form"}, {"kind": "allow", "text": "ALLOW (heat/boil to) evaporate some of the water"}, {"kind": "allow", "text": "ALLOW heat/boil to crystallisation point"}, {"kind": "ignore", "text": "IGNORE references to filtering before heating"}, {"kind": "note", "text": "M2cool/leave (the solution) until crystals have formed"}, {"kind": "note", "text": "M2 DEP on M1"}, {"kind": "note", "text": "M3filter (to remove the crystals)"}, {"kind": "note", "text": "AND"}, {"kind": "note", "text": "wash with (a little deionised/distilled) water"}, {"kind": "note", "text": "ACCEPT decant/pour off the liquid/(excess solution)"}, {"kind": "note", "text": "M4suitable method of drying the crystals"}, {"kind": "note", "text": "M3 dep on crystals having been formed"}, {"kind": "note", "text": "e.g. place in (warm) oven / leave to dry (in warm place) / use filter paper / use kitchen towel"}, {"kind": "note", "text": "REJECT any reference to heating directly with a flame, e.g. with a Bunsen"}, {"kind": "note", "text": "If M1 not scored then award 1 mark out of 4 for leaving the solution until the water evaporates fully OR for evaporating solution to dryness"}, {"kind": "note", "text": "Total"}], "answerText": "M1heat/boil until crystals form in a sample of solution that has been removed and cooled", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}], "icTable": null, "warnings": ["1(a)(i): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "1(a)(i): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "orphan row before first entry: (b)", "orphan ro