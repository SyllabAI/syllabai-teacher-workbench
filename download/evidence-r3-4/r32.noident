INSERT INTO public.question_parts VALUES ('53626eb2-29f5-4529-b7c4-f2e2d0023267', '92db095e-62d3-44a7-8c60-5757b909c4ab', 'b', 'The glucose is then converted into ethanol by the yeast $\mathrm {C} _ {6} \mathrm {H} _ {1 2} \mathrm {O} _ {6} (\mathrm {a q}) \rightarrow 2 \mathrm {C} _ {2} \mathrm {H} _ {5} \mathrm {O H} (\mathrm {a q}) + 2 \mathrm {C O} _ {2} (\mathrm {g})$', NULL, 0, 1, '2026-09-13 12:58:26.161358+00');
INSERT INTO public.question_parts VALUES ('f3a9711e-3f48-4e72-bc2c-71372e0c05dc', '92db095e-62d3-44a7-8c60-5757b909c4ab', 'b-i', 'How would you know when the reaction has stopped?', NULL, 0, 2, '2026-09-13 12:58:26.16198+00');
