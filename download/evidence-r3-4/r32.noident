INSERT INTO public.glm_ocr_bridge_records VALUES ('fe111471-0709-4851-a124-4a2682ab9e3d', '6b673149-944d-40fc-81f1-81f73a6fa2b4', 'glm-ocr-v1', '52406e2b-9978-509d-bf40-4f29fdebe0e5', 'd299302d-d0b8-5cd7-8f69-a6f48fa70a73', '257fd780-68eb-4709-b15f-82217b4feb34', 'b99ccd84-6575-44d9-a090-7c3036549e82', '868a150c1aaee47589fd20603212263b9eb9d634dd6881ed5e6e7d0aeca3387f', 'c396f41c067ee5536a0ca7f6c40848aeebd23852d4eecbb024abdd71c39ce058', 'glm-ocr-qp-v1+glm-ocr-ms-v1', 'OK', '[{"detail": "Q1: QP total 5 vs MS total unknown (qp-only)", "source": "RECONCILIATION", "msMarks": null, "qpMarks": 5, "severity": "qp-only", "questionNumber": "1"}, {"detail": "Q2: QP total 10 vs MS total unknown (qp-only)", "source": "RECONCILIATION", "msMarks": null, "qpMarks": 10, "severity": "qp-only", "questionNumber": "2"}, {"detail": "Q4: QP total 8 vs MS total unknown (qp-only)", "source": "RECONCILIATION", "msMarks": null, "qpMarks": 8, "severity": "qp-only", "questionNumber": "4"}, {"detail": "Q5: QP total 12 vs MS total unknown (qp-only)", "source": "RECONCILIATION", "msMarks": null, "qpMarks": 12, "severity": "qp-only", "questionNumber": "5"}, {"detail": "Q6: QP total 12 vs MS total unknown (qp-only)", "source": "RECONCILIATION", "msMarks": null, "qpMarks": 12, "severity": "qp-only", "questionNumber": "6"}, {"detail": "Q7: QP total 12 vs MS total unknown (qp-only)", "source": "RECONCILIATION", "msMarks": null, "qpMarks": 12, "severity": "qp-only", "questionNumber": "7"}, {"detail": "1: bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "1: bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "1: bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "2(a): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "2(a): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "2(a): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "2(d): bare integer cell \"2\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "3(a): bare integer cell \"2\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "3(a): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "3(a): bare integer cell \"2\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "4(a): bare integer cell \"2\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "4(a): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "4(c)(i): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "5(a)(i): bare integer cell \"3\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "5(a)(i): bare integer cell \"2\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "5(a)(i): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "5(a)(i): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "5(c): bare integer cell \"2\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "6(a): bare integer cell \"2\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "6(c)(i): bare integer cell \"4\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "6(c)(i): bare integer cell \"2\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "7(a): bare integer cell \"4\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "7(c): bare integer cell \"4\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}]', '{"paper": {"board": "Edexcel", "session": null, "subject": null, "duration": null, "examDate": null, "logNumber": null, "qualification": null, "paperReference": "4CH1/2CR", "publicationCode": null, "canonicalDocumentId": "52406e2b-9978-509d-bf40-4f29fdebe0e5"}, "warnings": [], "questions": [{"mcq": false, "qwc": false, "stem": "(a) Two substances are needed to cause iron to rust. Name these two substances.", "marks": 5, "parts": [{"qwc": false, "text": "The box gives the names of some substances. calcium copper gold iodine methane zinc Use words from the box to answer these questions.", "label": "b", "marks": null, "partId": "q01-52406e2b-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give the name of a non-metallic element.", "label": "b-i", "marks": null, "partId": "q01-52406e2b-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give the name of a compound.", "label": "b-ii", "marks": null, "partId": "q01-52406e2b-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give the name of the metal that is lowest in the reactivity series.", "label": "b-iii", "marks": null, "partId": "q01-52406e2b-pb-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 1, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q01-52406e2b", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "Crude oil is a mixture of hydrocarbons.", "marks": 10, "parts": [{"qwc": false, "text": "This passage is about the industrial separation of crude oil. Complete the passage by adding the missing words. Crude oil is to form vapour. The vapour is passed through a column. The refinery gases are collected at the top of the column because they have low", "label": "a", "marks": null, "partId": "q02-52406e2b-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Bitumen is collected at the bottom of the column. Give one use of bitumen.", "label": "b", "marks": null, "partId": "q02-52406e2b-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "One of the hydrocarbons in crude oil is an alkane with this structural formula. $\\mathrm {C H} _ {3} \\mathrm {C H} _ {2} \\mathrm {C H} _ {2} \\mathrm {C H} _ {2} \\mathrm {C H} _ {3}$", "label": "c", "marks": null, "partId": "q02-52406e2b-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give the name of this alkane.", "label": "c-i", "marks": null, "partId": "q02-52406e2b-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the relative molecular mass $ ( M_{r} ) $ of this alkane.", "label": "c-ii", "marks": null, "partId": "q02-52406e2b-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Catalytic cracking is used to convert long-chain alkanes into shorter-chain alkanes. Give the name of the catalyst and the temperature used in catalytic cracking. catalyst temperature", "label": "d", "marks": null, "partId": "q02-52406e2b-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Catalytic cracking also produces alkenes. Decane $ \\left( \\mathrm{C}_{1 0} \\mathrm{H}_{2 2} \\right) $ can undergo cracking to give $ \\mathrm{C}_{4} \\mathrm{H}_{1 0} $ and two different alkenes. Complete the equation for this cracking process. $\\mathrm {C} _ {1 0} \\mathrm {H} _ {2 2} \\rightarrow \\mathrm {C} _ {4} \\mathrm {H} _ {1 0} +$", "label": "e", "marks": null, "partId": "q02-52406e2b-pe", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 2, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q02-52406e2b", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "A student does a titration to find the concentration of a solution of dilute sulfuric acid. The student uses these solutions and this apparatus. dilute sulfuric acid potassium hydroxide solution of concentration 0.240mol/dm $ ^{3} $ methyl orange indicator", "marks": 0, "parts": [{"qwc": false, "text": "The student wants to find the volume of sulfuric acid needed to neutralise $ 2 5. 0 \\mathrm{c m}^{3} $ of the potassium hydroxide solution. Describe how the student should do this titration. Assume that all pieces of apparatus are clean and dry.", "label": "a", "marks": null, "partId": "q03-52406e2b-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The student needs $ 1 5. 0 0 \\mathrm{c m}^{3} $ of sulfuric acid to neutralise $ 2 5. 0 \\mathrm{c m}^{3} $ of the potassium hydroxide solution. This is the equation for the reaction. $2 \\mathrm {K O H} + \\mathrm {H} _ {2} \\mathrm {S O} _ {4} \\rightarrow \\mathrm {K} _ {2} \\mathrm {S O} _ {4} + 2 \\mathrm {H} _ {2} \\mathrm {O}$", "label": "b", "marks": null, "partId": "q03-52406e2b-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the amount, in moles, of KOH in $ 2 5. 0 \\mathrm{c m}^{3} $ of potassium hydroxide solution of concentration $ 0. 2 4 0 \\mathrm{m o l} / \\mathrm{d m}^{3}. $ $\\mathrm {a m o u n t o f K O H} =$", "label": "b-i", "marks": null, "partId": "q03-52406e2b-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the amount, in moles, of $ \\mathrm{H_{2} S O_{4}} $ in $ 1 5. 0 0 \\mathrm{c m}^{3} $ of the sulfuric acid. $\\mathrm {a m o u n t o f H _ {2} S O _ {4}} =$", "label": "b-ii", "marks": null, "partId": "q03-52406e2b-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the concentration, in mol/dm $ ^{3} $ , of the sulfuric acid. $\\mathrm {m o l} / \\mathrm {d m} ^ {3}$", "label": "b-iii", "marks": null, "partId": "q03-52406e2b-pb-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 3, "figures": [{"url": "assets/crop_1_1789064231510.png", "width": 298, "format": "png", "height": 446, "sha256": "fe78cc605f1a79b900c0e8b0478dedc8691b7582007e4fc3379e16c3eb4ef1b9", "assetId": "img:fe78cc605f1a79b900c0e8b0478dedc8691b7582007e4fc3379e16c3eb4ef1b9", "mimeType": "image/jpeg", "elementId": "e000055", "sourceName": "assets/crop_1_1789064231510.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_2_1789064231516.png", "width": 100, "format": "png", "height": 606, "sha256": "39536862b5b9892c95dd89b5726c515576256d9ac21c24fbd39ccca63d49506c", "assetId": "img:39536862b5b9892c95dd89b5726c515576256d9ac21c24fbd39ccca63d49506c", "mimeType": "image/jpeg", "elementId": "e000056", "sourceName": "assets/crop_2_1789064231516.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_3_1789064231520.png", "width": 90, "format": "png", "height": 798, "sha256": "aa94c07dbac1a8dc1f3af39242addd8d0208826ede17f83eb14724fb5c8a78f3", "assetId": "img:aa94c07dbac1a8dc1f3af39242addd8d0208826ede17f83eb14724fb5c8a78f3", "mimeType": "image/jpeg", "elementId": "e000057", "sourceName": "assets/crop_3_1789064231520.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.45, "marksKnown": false, "questionId": "q03-52406e2b", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "This question is about alcohols, carboxylic acids and their reactions.", "marks": 8, "parts": [{"qwc": false, "text": "The boxes give some information about a carboxylic acid. Complete the boxes by giving the missing information.", "label": "a", "marks": null, "partId": "q04-52406e2b-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Ethanol can be oxidised to produce a carboxylic acid.", "label": "b", "marks": null, "partId": "q04-52406e2b-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give the names of the two reagents used in this oxidation reaction.", "label": "b-i", "marks": null, "partId": "q04-52406e2b-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Which of these colour changes occurs during the reaction? A green to orange B orange to green C red to yellow D yellow to red", "label": "b-ii", "marks": null, "partId": "q04-52406e2b-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Alcohols and carboxylic acids can be heated together to form esters.", "label": "c", "marks": null, "partId": "q04-52406e2b-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State why it is better to heat the mixture using a water bath rather than directly with a Bunsen burner flame.", "label": "c-i", "marks": null, "partId": "q04-52406e2b-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "An ester has the structural formula $ \\mathrm{C H_{3} C H_{2} C O O C H_{3}} $ Which of these is the name of this ester? A ethyl methanoate B methyl ethanoate C methyl propanoate D propyl methanoate", "label": "c-ii", "marks": null, "partId": "q04-52406e2b-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 4, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q04-52406e2b", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000072"]}, {"mcq": false, "qwc": false, "stem": "This question is about three stages in the manufacture of sulfuric acid.", "marks": 12, "parts": [{"qwc": false, "text": "In stage 1, sulfur is burned in oxygen to form sulfur dioxide gas. $\\mathrm {S} (\\mathrm {s}) + \\mathrm {O} _ {2} (\\mathrm {g}) \\rightarrow \\mathrm {S O} _ {2} (\\mathrm {g})$", "label": "a", "marks": null, "partId": "q05-52406e2b-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State one environmental problem caused by the release of sulfur dioxide into the atmosphere.", "label": "a-i", "marks": null, "partId": "q05-52406e2b-pa-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "A mass of 6.4 tonnes of sulfur is burned to produce sulfur dioxide gas. Calculate the maximum volume, in $ \\mathrm{d m}^{3} $ , of sulfur dioxide gas that can be produced at rtp. [molar volume of sulfur dioxide gas at rtp=24 dm $ ^{3} $] [1 tonne=10 $ ^{6} $ g] Give your answer in standard form.", "label": "a-ii", "marks": null, "partId": "q05-52406e2b-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": ["maximum volume"]}, {"qwc": false, "text": "In stage 2, sulfur dioxide is reacted with oxygen to form sulfur trioxide gas. $2 \\mathrm {S O} _ {2} (\\mathrm {g}) + \\mathrm {O} _ {2} (\\mathrm {g}) \\rightleftharpoons 2 \\mathrm {S O} _ {3} (\\mathrm {g})$ The yield of sulfur trioxide is approximately 98%.", "label": "b", "marks": null, "partId": "q05-52406e2b-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "A catalyst is used in this reaction. Explain how a catalyst increases the rate of a reaction.", "label": "b-i", "marks": null, "partId": "q05-52406e2b-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The temperature is kept constant. Give a reason why increasing the pressure would increase the yield of sulfur trioxide.", "label": "b-ii", "marks": null, "partId": "q05-52406e2b-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Suggest why it is not necessary to increase the pressure in stage 2.", "label": "b-iii", "marks": null, "partId": "q05-52406e2b-pb-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "In stage 3, the sulfur trioxide is reacted with concentrated sulfuric acid to form a liquid called oleum, $ \\mathrm{H_{2} S_{2} O_{7}} $ The oleum is then added to water to form concentrated sulfuric acid. Complete the chemical equations for these two reactions. $\\mathrm {H} _ {2} \\mathrm {S} _ {2} \\mathrm {O} _ {7}$ $\\mathrm {H} _ {2} \\mathrm {S} _ {2} \\mathrm {O} _ {7} +$", "label": "c", "marks": null, "partId": "q05-52406e2b-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Sulfuric acid reacts with ammonia to form ammonium sulfate, $ \\mathrm{(N H_{4})_{2} S O_{4}} $ Calculate the percentage by mass of nitrogen in ammonium sulfate. $ [M_{\\mathrm{r}} $ of $ \\mathrm{(N H_{4})_{2} S O_{4}}=1 3 2 ] $", "label": "d", "marks": null, "partId": "q05-52406e2b-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 5, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q05-52406e2b", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "A teacher prepares the insoluble salt lead(II) bromide $ \\mathrm{(P b B r_{2})} $ by mixing solutions of lead(II) nitrate and sodium bromide.", "marks": 12, "parts": [{"qwc": false, "text": "Describe what the teacher should do next to obtain a pure, dry sample of lead(II) bromide.", "label": "a", "marks": null, "partId": "q06-52406e2b-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The teacher then sets up a circuit in a fume cupboard using the pure, dry sample of lead(II) bromide. Explain why the lamp does not light when the lead(II) bromide is solid.", "label": "b", "marks": null, "partId": "q06-52406e2b-pb", "figures": [{"url": "assets/crop_1_1789064231596.png", "width": 1263, "format": "png", "height": 669, "sha256": "76cca179647e888cfa4e9e308bbe7be1798e66ba6a86eb496f0c7319d51378c3", "assetId": "img:76cca179647e888cfa4e9e308bbe7be1798e66ba6a86eb496f0c7319d51378c3", "mimeType": "image/jpeg", "elementId": "e000116", "sourceName": "assets/crop_1_1789064231596.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The teacher heats the lead(II) bromide. When the lead(II) bromide is molten, the lamp lights and bromine forms at the positive electrode.", "label": "c", "marks": null, "partId": "q06-52406e2b-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State what observation would be made at the positive electrode.", "label": "c-i", "marks": null, "partId": "q06-52406e2b-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain how bromide ions in the molten lead(II) bromide become bromine molecules at the positive electrode.", "label": "c-ii", "marks": null, "partId": "q06-52406e2b-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Write an ionic half-equation for the reaction that occurs at the negative electrode. Include state symbols in your equation.", "label": "d", "marks": null, "partId": "q06-52406e2b-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 6, "figures": [{"url": "assets/crop_1_1789064231596.png", "width": 1263, "format": "png", "height": 669, "sha256": "76cca179647e888cfa4e9e308bbe7be1798e66ba6a86eb496f0c7319d51378c3", "assetId": "img:76cca179647e888cfa4e9e308bbe7be1798e66ba6a86eb496f0c7319d51378c3", "mimeType": "image/jpeg", "elementId": "e000116", "sourceName": "assets/crop_1_1789064231596.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q06-52406e2b", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "The reaction between hydrogen and chlorine is exothermic. This is the equation for the reaction. $\\mathrm {H} _ {2} (\\mathrm {g}) + \\mathrm {C l} _ {2} (\\mathrm {g}) \\rightarrow 2 \\mathrm {H C l} (\\mathrm {g}) \\quad \\Delta H = - 1 8 4 \\mathrm {k J}$", "marks": 12, "parts": [{"qwc": false, "text": "State the meaning of the term exothermic.", "label": "a", "marks": null, "partId": "q07-52406e2b-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The table gives the bond energies for the H—H and H—Cl bonds. Use the equation and information from the table to calculate the bond energy of the CI一CI bond. $\\mathrm {b o n d e n e r g y} =$", "label": "b", "marks": null, "partId": "q07-52406e2b-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain why this reaction is exothermic. Refer to bond-breaking and bond-making in your answer.", "label": "c", "marks": null, "partId": "q07-52406e2b-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Complete the reaction profile diagram to show the position of the products, the enthalpy change $ \\left( \\Delta H\\right) $ and the activation energy $ \\left( E_{\\mathrm{a}}\\right) $ for the reaction.", "label": "d", "marks": null, "partId": "q07-52406e2b-pd", "figures": [{"url": "assets/crop_1_1789064231614.png", "width": 764, "format": "png", "height": 913, "sha256": "ff3e325cffea2813839c4ee84ac502628e60ce3787a6179dffc20aff39fc4821", "assetId": "img:ff3e325cffea2813839c4ee84ac502628e60ce3787a6179dffc20aff39fc4821", "mimeType": "image/jpeg", "elementId": "e000135", "sourceName": "assets/crop_1_1789064231614.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}], "number": 7, "figures": [{"url": "assets/crop_1_1789064231614.png", "width": 764, "format": "png", "height": 913, "sha256": "ff3e325cffea2813839c4ee84ac502628e60ce3787a6179dffc20aff39fc4821", "assetId": "img:ff3e325cffea2813839c4ee84ac502628e60ce3787a6179dffc20aff39fc4821", "mimeType": "image/jpeg", "elementId": "e000135", "sourceName": "assets/crop_1_1789064231614.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q07-52406e2b", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000129"]}], "paperTotal": 70, "schemaVersion": "1.0", "sectionTotals": {}, "questionTotals": {"1": 5, "2": 10, "4": 8, "5": 12, "6": 12, "7": 12}, "reviewRequired": true, "extractionMethod": "glm-ocr-qp-v1", "frontMatterFigures": []}', '{"paper": {"board": "Edexcel", "session": "January 2022", "subject": null, "duration": null, "examDate": null, "logNumber": null, "qualification": null, "paperReference": null, "publicationCode": "4CH1_2CR_2201_MS", "canonicalDocumentId": "d299302d-d0b8-5cd7-8f69-a6f48fa70a73"}, "entries": [{"mcq": false, "qwc": false, "label": "1", "marks": 2, "number": 1, "entryId": "ms-d299302d-q1", "guidance": [{"kind": "note", "text": "M1 oxygen"}, {"kind": "allow", "text": "ALLOW air"}, {"kind": "note", "text": "M2 water/water vapour"}, {"kind": "allow", "text": "ALLOW moisture"}, {"kind": "allow", "text": "ALLOW answers in either order"}, {"kind": "note", "text": "(b)(i)"}, {"kind": "note", "text": "iodine"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "methane"}, {"kind": "note", "text": "(iii)"}, {"kind": "note", "text": "gold"}, {"kind": "note", "text": "Total 5"}], "answerText": "(a)", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "2(a)", "marks": 3, "number": 2, "entryId": "ms-d299302d-q2a", "guidance": [{"kind": "allow", "text": "ALLOW boiled"}, {"kind": "ignore", "text": "IGNORE"}, {"kind": "note", "text": "vapourised/evaporated"}, {"kind": "note", "text": "M2 fractionating"}, {"kind": "note", "text": "ACCEPT fractional distillation"}, {"kind": "note", "text": "M3 boiling point(s)"}, {"kind": "note", "text": "ACCEPT boiling temperature(s)"}, {"kind": "ignore", "text": "IGNORE melting point(s)/low density"}, {"kind": "note", "text": "(b) road surfacing/roofing"}, {"kind": "allow", "text": "ALLOW roads"}, {"kind": "note", "text": "(c)(i)"}, {"kind": "note", "text": "pentane"}, {"kind": "note", "text": "(Mr=5x12+12x1=)72"}, {"kind": "note", "text": "(ii)"}], "answerText": "M1 heated", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "2(d)", "marks": 2, "number": 2, "entryId": "ms-d299302d-q2d", "guidance": [{"kind": "note", "text": "ACCEPTaluminiumoxide/silicon dioxide/Al2O3/SiO2/zeolite(s)/aluminosilicate(s)"}, {"kind": "note", "text": "M2any temperature in the range600-700℃inclusive"}, {"kind": "note", "text": "(e)"}, {"kind": "note", "text": "(C10H22→C4H10)+C2H4+C4H8"}, {"kind": "note", "text": "alkenes can be in eitherorder"}, {"kind": "note", "text": "M1C2H4"}, {"kind": "note", "text": "M2C4H8"}, {"kind": "allow", "text": "ALLOW1mark forC6H12/2C3H6/C3H6+C3H6"}, {"kind": "allow", "text": "ALLOWcorrectdisplayedformulae"}, {"kind": "note", "text": "Total10"}], "answerText": "M1alumina/silica", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "3(a)", "marks": 6, "number": 3, "entryId": "ms-d299302d-q3a", "guidance": [{"kind": "note", "text": "M1use the pipette to add(25cm3of) potassium hydroxide(solution)to the(conical)flask"}, {"kind": "note", "text": "M2add a few drops of methyl orange(to the flask)"}, {"kind": "note", "text": "M3add sulfuric acid to the burette and record the initial burette reading"}, {"kind": "allow", "text": "ALLOWfill burette with sulfuric acid to“0”mark"}, {"kind": "note", "text": "M4add sulfuric acid(from the burette)to the flask,swirling(continuously)"}, {"kind": "allow", "text": "ALLOWshaking(gently)/stirring"}, {"kind": "note", "text": "M5until the(methyl orange)indicator turns red/orange"}, {"kind": "note", "text": "M6take the final burette reading and find volume of acid added(by finding difference between initial and final burette readings)"}, {"kind": "allow", "text": "ALLOWtake final burette reading only if previously filled burette to“0”mark"}, {"kind": "note", "text": "M7repeat(the titration)adding the acid dropwise near the end-point/repeat(the titration)to obtain concordant results"}, {"kind": "note", "text": "ACCEPTrepeat(the titration)to obtain results within0.2cm3of each other"}, {"kind": "note", "text": "(b)(i)"}, {"kind": "note", "text": "M10.0250x0.240OR25.0x0.2401000"}, {"kind": "note", "text": "correct answer without working scores2"}, {"kind": "note", "text": "M20.006(00)"}, {"kind": "note", "text": "If no division by1000giving an answer of6award1mark"}, {"kind": "note", "text": "(0.006÷2=)0.003"}, {"kind": "allow", "text": "ALLOWECFfrom(i)"}, {"kind": "note", "text": "M10.003(00)x100015.00"}, {"kind": "note", "text": "(iii)"}, {"kind": "note", "text": "M20.2(00)"}, {"kind": "allow", "text": "ALLOWECFfrom(ii)"}, {"kind": "note", "text": "correct answer without working scores2"}, {"kind": "note", "text": "answer to(ii)÷15.00scores1"}, {"kind": "note", "text": "do not penalise not multiplying by1000in(iii)if they have not divided by1000in(i)"}, {"kind": "note", "text": "Total11"}], "answerText": "A description that includes six of the following points", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "4(a)", "marks": 3, "number": 4, "entryId": "ms-d299302d-q4a", "guidance": [{"kind": "note", "text": "CH3COOH"}, {"kind": "note", "text": "1 mark for each correct answerALLOW acetic acidMust show O-H bond"}, {"kind": "note", "text": "ethanoic acid"}, {"kind": "note", "text": "CH2O"}, {"kind": "note", "text": "H-C-C"}, {"kind": "note", "text": "(b)(i)"}, {"kind": "note", "text": "M1 potassium dichromate(VI)M2(dilute)sulfuric acid"}, {"kind": "note", "text": "VI not essential for the markACCEPT sodium dichromate(VI)ALLOW K2Cr2O7ALLOW concentrated sulfuric acidALLOW H2SO4ACCEPT reagents in either order"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "B orange to greenA is incorrect as the colour does not change from green to orangeC is incorrect as the colour does not change from red to yellowD is incorrect as the colour does not change from yellow to red"}], "answerText": "structural formula\nname\nempirical formula\ndisplayed formula", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "4(c)(i)", "marks": 1, "number": 4, "entryId": "ms-d299302d-q4ci", "guidance": [{"kind": "note", "text": "ACCEPT esters/mixture are/is flammable/might catch fire/might ignite"}, {"kind": "allow", "text": "ALLOW alcohol/ester/carboxylic acid might evaporate"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "C methyl propanoate"}, {"kind": "note", "text": "A ethyl methanoate is not the correct name of the compound"}, {"kind": "note", "text": "B methyl ethanoate is not the correct name of the compound"}, {"kind": "note", "text": "D propyl methanoate is not the correct name of the compound"}, {"kind": "note", "text": "Total 8"}], "answerText": "alcohols are flammable/might catch fire/might ignite", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "5(a)(i)", "marks": 1, "number": 5, "entryId": "ms-d299302d-q5ai", "guidance": [{"kind": "allow", "text": "ALLOW any detrimental effect of acid rain e.g. kills fish, damages limestone buildings"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "M1 find moles of sulfurM2 multiply moles by 24M3 answer in standard formExample calculationM1 6.4x106÷32OR2.0x105/200000M2 2.0x105x24/200000x24/4800000M3 4.8x106"}, {"kind": "allow", "text": "ALLOW ECF as long as an attempt has been made to calculate molesCorrect answer without working scores34800000(dm3) without working scores2"}, {"kind": "note", "text": "(b)(i)"}, {"kind": "note", "text": "An explanation that links the following two pointsM1 provides an alternative (reaction) pathway/routeM2 with a lower activation energy OWTTE"}, {"kind": "note", "text": "ACCEPT so more particles/collisions have energy greater than the activation energyALLOW lowers the energy needed to start the reaction"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "fewer moles (of gas) on RHS (than on (LHS))"}, {"kind": "allow", "text": "ALLOW 3 moles (of gas) on LHS and 2 moles (of) gas on RHSALLOW fewer moles of product/SO3(gas)(than of reactants/SO2andO2(gas))ALLOW molecules in place of molesIGNORE references to rate"}, {"kind": "note", "text": "(iii)"}, {"kind": "note", "text": "as yield is approximately 98%/very high(it is not necessary to increase the pressure) OWTTE"}, {"kind": "allow", "text": "ALLOW reference to reaction rate(already high enough) as catalyst used OWTTE"}], "answerText": "(produces) acid rain", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "5(c)", "marks": 2, "number": 5, "entryId": "ms-d299302d-q5c", "guidance": [{"kind": "allow", "text": "ALLOW multiples"}, {"kind": "note", "text": "M2H2S2O7+H2O→2H2SO4"}, {"kind": "note", "text": "(d)"}, {"kind": "note", "text": "M1(2x14÷132)x100"}, {"kind": "note", "text": "M221.21(%)"}, {"kind": "allow", "text": "ALLOW any number of sig figs except1"}, {"kind": "allow", "text": "ALLOW ECF fromM1as long as132used correctlyCorrect answer without working scores2"}, {"kind": "note", "text": "Total12"}], "answerText": "M1SO3+H2SO4→H2S2O7", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "6(a)", "marks": 3, "number": 6, "entryId": "ms-d299302d-q6a", "guidance": [{"kind": "note", "text": "M1 filter"}, {"kind": "note", "text": "M2 wash the precipitate/solid/lead(II) bromide/residue (with distilled water)"}, {"kind": "note", "text": "M3 dry with filter paper/in a (warm) oven"}, {"kind": "allow", "text": "ALLOW leave to dry or any other suitable method"}, {"kind": "note", "text": "REJECT direct heating e.g. with a Bunsen burner"}, {"kind": "note", "text": "If description relates to preparation of a soluble salt allow 1 mark only for M3 for a suitable method of drying the solid"}, {"kind": "note", "text": "(b)"}, {"kind": "note", "text": "M1 solid lead(II) bromide does not conduct electricity"}, {"kind": "allow", "text": "ALLOW lead(II) bromide only conducts when molten"}, {"kind": "allow", "text": "ALLOW when lead(II) bromide is solid no electricity/current flow(s) through the circuit/lamp"}, {"kind": "note", "text": "M2 because ions cannot move/are in fixed positions"}, {"kind": "note", "text": "REJECT reference to (delocalised) electrons/atoms cannot move in solid"}], "answerText": "A description that refers to the following three points", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "6(c)(i)", "marks": 1, "number": 6, "entryId": "ms-d299302d-q6ci", "guidance": [{"kind": "allow", "text": "ALLOW orange/orange-brown"}, {"kind": "note", "text": "(ii)"}, {"kind": "note", "text": "An explanation that links the following four points"}, {"kind": "note", "text": "Penalise incorrect use of ide/ine once only"}, {"kind": "note", "text": "M1 bromide ions are negatively charged/Br-"}, {"kind": "allow", "text": "ALLOW bromide ions are anions"}, {"kind": "note", "text": "M2(so bromide ions/they) are attracted to the positive electrode"}, {"kind": "allow", "text": "ALLOW anode"}, {"kind": "note", "text": "M3(at the positive electrode) bromide ions/they lose/give up electron(s)(to form bromine atoms)"}, {"kind": "allow", "text": "ALLOW bromide ions are oxidisedALLOW Br-→Br+e(-)"}, {"kind": "note", "text": "M4(bromine atoms) join in pairs to form bromine molecules/Br2OWTTE"}, {"kind": "allow", "text": "ALLOW Br+Br→Br22Br-→Br2+2e(-)scores M1 M3 and M4"}, {"kind": "note", "text": "(d)"}, {"kind": "note", "text": "Pb2+(l)+2e(-)→Pb(s)"}, {"kind": "allow", "text": "ALLOW Pb(l)"}, {"kind": "note", "text": "M1 formulae and balancing correct"}, {"kind": "allow", "text": "ALLOW multiples and fractions"}, {"kind": "note", "text": "M2 both state s