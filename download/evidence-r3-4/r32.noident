INSERT INTO public.question_parts VALUES ('8b004f09-0ff3-45c5-8aef-7db2960a5fdd', '65355ad4-7557-4035-80df-54307fde829c', 'b', 'Most compounds in crude oil are hydrocarbons. State the meaning of the term hydrocarbons.', NULL, 0, 1, '2026-09-13 12:53:11.6146+00');
