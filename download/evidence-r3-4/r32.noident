INSERT INTO public.document_chunks VALUES ('80d499fc-3fd7-4e60-a033-e55477160cc2', '648145ca-d12b-4807-8cfd-089258546f94', 1, 'Pearson: helping people progress, everywhere Our aim is to help everyone progress in their lives through education. We believe in every kind of learning, for all kinds of people, wherever they are in the world. We''ve been involved in education for over 150 years, and by working across 70 countries, in 100 languages, we have built an international reputation for our commitment to high standards and raising achievement through innovation in education. Find out more about how we can help you and your students at: www.pearson.com/uk
