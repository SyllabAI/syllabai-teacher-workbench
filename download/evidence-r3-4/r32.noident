INSERT INTO public.question_versions VALUES ('57af6c7a-2f4c-4ec9-b385-16dba692af7b', '68585c88-81cf-40d0-9457-8e0d751a55ae', 1, 'This question is about hydrated compounds. Crystals of hydrated barium chloride $ \mathrm{(B a C I_{2}. x H_{2} O)} $ contain water of crystallisation. This is the student''s method. Step 1 record mass of tube A when empty Step 2 place a sample of hydrated barium chloride crystals in tube A and record new mass Step 3 heat tube A Step 4 allow tube A to cool and record mass Repeat steps 3 and 4 until the mass recorded in step 4 is constant. These are the student''s results. $\mathrm {m a s s o f t u b e A} = 1 0. 5 5 \mathrm {g}$ $\mathrm {m a s s o f t u b e A a n d B a C l} _ {2}. \mathrm {x H} _ {2} \mathrm {O} = 1 6. 6 5 \mathrm {g}$ $\mathrm {f i n a l m a s s o f t u b e A a n d B a C l} _ {2} = 1 5. 7 5 \mathrm {g}$ A student uses this apparatus to remove and collect the water from some crystals.', 13, 3, 1170, NULL, 'SUGGESTED', '1469520f-ed72-53be-81de-88075d45a670', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:56:55.65979+00');
