INSERT INTO public.question_parts VALUES ('e33ec69b-90ab-4ae6-955d-25ea345ea7f6', '7c2d4014-6411-40c3-8c69-b0bf2935ad18', 'b-ii', 'The reaction occurs because chlorine is more reactive than bromine. Bromine is below chlorine in Group 7. Explain the decrease in reactivity from chlorine to bromine.', NULL, 0, 5, '2026-09-13 13:01:26.45859+00');
INSERT INTO public.question_parts VALUES ('a1455626-5324-49cc-b6d2-6ccfbb2025bc', '7c2d4014-6411-40c3-8c69-b0bf2935ad18', 'c', 'Elements in Group 7 react with elements in Group 1 to form ionic compounds. Which pair of ions both have the electronic configuration 2.8.8? A $ \mathrm{L i^{+} a n d C l^{-}} $ B $ \mathrm{K^{+} a n d F^{-}} $ C $ \mathrm{L i^{+} a n d F^{-}} $ D $ \mathrm{K^{+} a n d C l^{-}} $', NULL, 0, 6, '2026-09-13 13:01:26.458603+00');
INSERT INTO public.question_parts VALUES ('cb0e2689-635b-4f7e-a4c6-a49452c533c7', '53954a3b-c4e8-4485-908d-ba17dbae58bc', 'b', 'Hydrogen chloride, HCl, is a covalent substance. When hydrogen chloride is added to water, a solution of dilute hydrochloric acid is formed. This solution does conduct electricity. Name the type of particle in the solution of the dilute hydrochloric acid that allows it to conduct electricity.', NULL, 0, 0, '2026-09-13 13:01:26.45862+00');
INSERT INTO public.question_parts VALUES ('e9e2461c-1be9-431c-bef1-b6df9bfba5ea', '53954a3b-c4e8-4485-908d-ba17dbae58bc', 'c', 'The teacher uses this apparatus to investigate the electrolysis of a solution of dilute hydrochloric acid. The ammeter measures the current. The teacher wants to find out if there is a relationship between current and volume of gas collected at each electrode. After 5 minutes she records the volume of gas collected in syringe X and syringe Y. She adjusts the power supply until the current is 0.1 amp. The teacher repeats the experiment several times, using a different current each time. The table gives the teacher''s results for syringe Y.', NULL, 0, 1, '2026-09-13 13:01:26.458645+00');
INSERT INTO public.question_parts VALUES ('26c07970-f3c0-48b8-adde-3ddc9cf97d59', '53954a3b-c4e8-4485-908d-ba17dbae58bc', 'c-i', 'Plot the results for syringe Y.', NULL, 0, 2, '2026-09-13 13:01:26.458656+00');
