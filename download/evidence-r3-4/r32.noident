INSERT INTO public.question_versions VALUES ('b7265bc7-676d-4e86-88d1-6dacc1ea3f3c', '2b392f20-e26e-4579-8126-f5669473404d', 1, 'Solutions of silver nitrate and potassium chloride react together to make the insoluble salt, silver chloride. Step 1 add $ 2 5 \mathrm{c m}^{3} $ of silver nitrate solution to a conical flask Step 2 add potassium chloride solution to the flask Step 3 filter off the silver chloride A student uses this method to prepare a sample of silver chloride.', 6, 3, 540, NULL, 'SUGGESTED', '517cf287-98ae-553f-9c06-a0b2adeb4644', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:01:25.618991+00');
