INSERT INTO public.document_chunks VALUES ('4dc33ca7-f1b3-476e-9719-452198c215ea', '1f57c0bc-a6ac-4a44-b5cc-bc488ee6dead', 7, 'Silicon dioxide has the same type of structure as diamond.
