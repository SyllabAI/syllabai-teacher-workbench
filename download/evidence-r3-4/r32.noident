INSERT INTO public.document_chunks VALUES ('11f20e66-2d91-4571-a7f5-8d3f15b8edcb', '95953f32-ae73-47aa-9973-b0c99b6c7af1', 8, '(i) Calculate the amount, in moles, of chlorine gas in $ 1 8 \mathrm{c m}^{3}. $
