onfidence": 1.0, "element_id": "e000163", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 163, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {C a C O} _ {3} + 2 \\mathrm {H C l} \\rightarrow \\mathrm {C a C l} _ {2} + \\mathrm {H} _ {2} \\mathrm {O} + \\mathrm {C O} _ {2}", "latex": "\\mathrm {C a C O} _ {3} + 2 \\mathrm {H C l} \\rightarrow \\mathrm {C a C l} _ {2} + \\mathrm {H} _ {2} \\mathrm {O} + \\mathrm {C O} _ {2}", "confidence": 1.0, "element_id": "e000170", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 170, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\mathrm {M g} + 2 \\mathrm {H N O} _ {3} \\rightarrow", "latex": "\\mathrm {M g} + 2 \\mathrm {H N O} _ {3} \\rightarrow", "confidence": 1.0, "element_id": "e000193", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 193, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"text": "\\Delta H =", "latex": "\\Delta H =", "confidence": 1.0, "element_id": "e000202", "page_number": 1, "bounding_box": null, "element_type": "equation", "reading_order": 202, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "pageCount": 1, "documentId": "9bf32939-91d0-5bf6-84a4-3ca84d7a67a3", "provenance": {"engine": "glm-ocr-markdown", "application": "syllabai-parser", "extractedAt": "2026-09-13T12:56:37.353364896Z", "engineVersion": "1.1.0", "schemaVersion": "1.0", "extractionParams": {"pageBoundaries": "none-in-source", "sourceLineCount": 266, "upstreamConverter": "zai-glm-ocr", "entityDecodedLines": 0, "signedUrlFigureRefs": 0, "normalizedHtmlEntities": true}}, "textBlocks": [{"role": "heading", "text": "Instructions", "confidence": 1.0, "element_id": "e000001", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 1, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Use black ink or ball-point pen.", "confidence": 1.0, "element_id": "e000002", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 2, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Fill in the boxes at the top of this page with your name, centre number and candidate number.", "confidence": 1.0, "element_id": "e000003", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 3, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer all questions.", "confidence": 1.0, "element_id": "e000004", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 4, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Answer the questions in the spaces provided", "confidence": 1.0, "element_id": "e000005", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 5, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "there may be more space than you need.", "confidence": 1.0, "element_id": "e000006", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 6, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Show all the steps in any calculations and state the units.", "confidence": 1.0, "element_id": "e000007", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 7, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Information", "confidence": 1.0, "element_id": "e000008", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 8, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The total mark for this paper is 110.", "confidence": 1.0, "element_id": "e000009", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 9, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "The marks for each question are shown in brackets", "confidence": 1.0, "element_id": "e000010", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 10, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "use this as a guide as to how much time to spend on each question.", "confidence": 1.0, "element_id": "e000011", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 11, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Advice", "confidence": 1.0, "element_id": "e000012", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 12, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Read each question carefully before you start to answer it.", "confidence": 1.0, "element_id": "e000013", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 13, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Write your answers neatly and in good English.", "confidence": 1.0, "element_id": "e000014", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 14, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Try to answer every question.", "confidence": 1.0, "element_id": "e000015", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 15, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Check your answers if you have time at the end.", "confidence": 1.0, "element_id": "e000016", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 16, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Turn over", "confidence": 1.0, "element_id": "e000017", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 17, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "$ ^{*} $ The lanthanoids (atomic numbers 58-71) and the actinoids (atomic numbers 90-103) have been omitted.", "confidence": 1.0, "element_id": "e000019", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 19, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The relative atomic masses of copper and chlorine have not been rounded to the nearest whole number.", "confidence": 1.0, "element_id": "e000020", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 20, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Answer ALL questions.", "confidence": 1.0, "element_id": "e000021", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 21, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Some questions must be answered with a cross in a box. If you change your mind about an answer, put a line through the box and then mark your new answer with a cross.", "confidence": 1.0, "element_id": "e000022", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 22, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "1 The box gives the names of some substances.", "confidence": 1.0, "element_id": "e000023", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 23, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Complete the table by choosing a substance from the box that matches each description.", "confidence": 1.0, "element_id": "e000025", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 25, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Each substance may be used once, more than once or not at all.", "confidence": 1.0, "element_id": "e000026", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 26, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Describe a test for chlorine.", "confidence": 1.0, "element_id": "e000028", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 28, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(2)", "confidence": 1.0, "element_id": "e000029", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 29, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "2 This question is about the reactivities of metals.", "confidence": 1.0, "element_id": "e000031", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 31, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) The table shows the reactions of four metals, P, Q, R and S, with water and with dilute hydrochloric acid.", "confidence": 1.0, "element_id": "e000032", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 32, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The letters are not the symbols of the elements.", "confidence": 1.0, "element_id": "e000033", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 33, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Deduce the order of reactivity of the metals.", "confidence": 1.0, "element_id": "e000035", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 35, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Give the letter of the metal that could be zinc.", "confidence": 1.0, "element_id": "e000037", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 37, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Give a word equation for the reaction between aluminium and hydrochloric acid.", "confidence": 1.0, "element_id": "e000038", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 38, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iv) Give the name of a metal that could be P.", "confidence": 1.0, "element_id": "e000039", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 39, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(v) Give a reason why the reaction of Q with dilute hydrochloric acid is not done.", "confidence": 1.0, "element_id": "e000040", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 40, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The diagram shows the apparatus used to demonstrate the reaction between aluminium and iron(III) oxide.", "confidence": 1.0, "element_id": "e000041", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 41, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "When the magnesium fuse is lit, a very exothermic reaction occurs.", "confidence": 1.0, "element_id": "e000043", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 43, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "This is the equation for the reaction.", "confidence": 1.0, "element_id": "e000044", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 44, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) State what is meant by the term exothermic.", "confidence": 1.0, "element_id": "e000046", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 46, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) State why aluminium displaces iron.", "confidence": 1.0, "element_id": "e000047", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 47, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Explain why this reaction is a redox reaction.", "confidence": 1.0, "element_id": "e000048", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 48, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 2 = 9 marks)", "confidence": 1.0, "element_id": "e000049", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 49, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "3 The diagram represents an atom of element Z.", "confidence": 1.0, "element_id": "e000050", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 50, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Z is not the symbol of the element.", "confidence": 1.0, "element_id": "e000051", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 51, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) (i) Give the number of the group to which element Z belongs.", "confidence": 1.0, "element_id": "e000053", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 53, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Give the number of the period to which element Z belongs.", "confidence": 1.0, "element_id": "e000054", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 54, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Give the formula of the compound that forms when Z reacts with fluorine.", "confidence": 1.0, "element_id": "e000055", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 55, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) One mole of Z contains $ 6. 0 \\times1 0^{2 3} $ atoms.", "confidence": 1.0, "element_id": "e000056", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 56, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Calculate the number of electrons in one mole of atoms of element Z.", "confidence": 1.0, "element_id": "e000057", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 57, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Give your answer in standard form.", "confidence": 1.0, "element_id": "e000058", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 58, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "number of electrons=", "confidence": 1.0, "element_id": "e000059", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 59, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) A sample of element Z contains three isotopes. The table shows the numbers of particles in the nucleus of each isotope and the percentage abundance of each isotope.", "confidence": 1.0, "element_id": "e000060", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 60, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Use the information in the table to calculate the relative atomic mass $ ( A_{r} ) $ of element Z.", "confidence": 1.0, "element_id": "e000062", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 62, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Give your answer to one decimal place.", "confidence": 1.0, "element_id": "e000063", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 63, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) Deduce the name of element Z.", "confidence": 1.0, "element_id": "e000064", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 64, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 3 = 10 marks)", "confidence": 1.0, "element_id": "e000065", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 65, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "4 Caffeine is a stimulant found in coffee, tea and some soft drinks.", "confidence": 1.0, "element_id": "e000066", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 66, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) The molecular formula of caffeine is $ \\mathrm{C_{8} H_{10} N_{4}O_{2}} $", "confidence": 1.0, "element_id": "e000067", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 67, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Determine the number of atoms in one molecule of caffeine.", "confidence": 1.0, "element_id": "e000068", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 68, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Calculate the relative formula mass $ ( M_{r} ) $ of caffeine.", "confidence": 1.0, "element_id": "e000069", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 69, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) Give the empirical formula for caffeine.", "confidence": 1.0, "element_id": "e000071", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 71, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Ethanol can be obtained from a solution of caffeine in ethanol using this apparatus.", "confidence": 1.0, "element_id": "e000072", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 72, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Give the name of the method of separation shown in the diagram.", "confidence": 1.0, "element_id": "e000074", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 74, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Describe what happens to the ethanol vapour in apparatus X.", "confidence": 1.0, "element_id": "e000075", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 75, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Calcium bromide is an ionic compound.", "confidence": 1.0, "element_id": "e000076", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 76, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The table shows the formulae and melting points of caffeine and calcium bromide.", "confidence": 1.0, "element_id": "e000077", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 77, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The relative formula mass of calcium bromide is similar to the relative formula mass of caffeine.", "confidence": 1.0, "element_id": "e000079", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 79, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Explain why calcium bromide has a much higher melting point than caffeine.", "confidence": 1.0, "element_id": "e000080", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 80, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "5 A student uses paper chromatography in an experiment to separate the dyes in four different felt tip pens, E, F, G and H.", "confidence": 1.0, "element_id": "e000081", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 81, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "The diagram shows the appearance of the paper before and after the experiment.", "confidence": 1.0, "element_id": "e000082", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 82, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "before", "confidence": 1.0, "element_id": "e000084", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 84, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "after", "confidence": 1.0, "element_id": "e000086", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 86, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) (i) The chromatography paper is placed in a solvent. Explain why the spots on the baseline are placed above the level of the solvent.", "confidence": 1.0, "element_id": "e000087", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 87, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(2)", "confidence": 1.0, "element_id": "e000088", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 88, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Explain which two felt tip pens contain the same dye.", "confidence": 1.0, "element_id": "e000089", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 89, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(2)", "confidence": 1.0, "element_id": "e000090", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 90, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(iii) The student thought that both F and G contained only one dye.", "confidence": 1.0, "element_id": "e000091", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 91, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Explain why the student can only be certain about one of these dyes.", "confidence": 1.0, "element_id": "e000092", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 92, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Calculate the $ R_{f} $ value for the dye in G. Show your working.", "confidence": 1.0, "element_id": "e000093", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 93, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "6 This question is about some Group 1 elements and their compounds.", "confidence": 1.0, "element_id": "e000094", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 94, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) A teacher adds a small piece of sodium to a trough of water.", "confidence": 1.0, "element_id": "e000095", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 95, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Give two observations that are made when sodium reacts with water.", "confidence": 1.0, "element_id": "e000096", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 96, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) After the reaction has stopped, the teacher adds a few drops of phenolphthalein to the solution in the trough.", "confidence": 1.0, "element_id": "e000097", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 97, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Explain the colour of the phenolphthalein after it is added to the solution.", "confidence": 1.0, "element_id": "e000098", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 98, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) A student does a flame test to see if a white solid contains lithium ions. They clean a platinum wire before using it for the flame test.", "confidence": 1.0, "element_id": "e000099", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 99, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Explain why the student needs to clean the platinum wire.", "confidence": 1.0, "element_id": "e000100", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 100, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) What is the colour of the flame if the solid contains lithium ions?", "confidence": 1.0, "element_id": "e000101", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 101, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A lilac", "confidence": 1.0, "element_id": "e000102", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 102, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B orange", "confidence": 1.0, "element_id": "e000103", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 103, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C red", "confidence": 1.0, "element_id": "e000104", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 104, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D yellow", "confidence": 1.0, "element_id": "e000105", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 105, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Potassium aluminium sulfate can be used in baking.", "confidence": 1.0, "element_id": "e000106", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 106, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Anhydrous potassium aluminium sulfate has the formula $ \\mathrm{K A I} \\left( \\mathrm{S O}_{4} \\right)_{2} $", "confidence": 1.0, "element_id": "e000107", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 107, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Give the formula of each ion in potassium aluminium sulfate.", "confidence": 1.0, "element_id": "e000108", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 108, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "potassium ion", "confidence": 1.0, "element_id": "e000109", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 109, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "aluminium ion", "confidence": 1.0, "element_id": "e000110", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 110, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "sulfate ion", "confidence": 1.0, "element_id": "e000111", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 111, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Potassium aluminium sulfate is normally found as a hydrated salt, with the formula $ \\mathrm{K A I ( S O_{4} )_{2}. x H_{2} O} $", "confidence": 1.0, "element_id": "e000112", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 112, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "When 23.7 g of the hydrated salt is heated to remove all the water, 12.9 g of the anhydrous salt is formed.", "confidence": 1.0, "element_id": "e000113", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 113, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Calculate the value of x.", "confidence": 1.0, "element_id": "e000114", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 114, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "7 This question is about nitrogen and its compounds.", "confidence": 1.0, "element_id": "e000116", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 116, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) What is the approximate percentage by volume of nitrogen in the atmosphere?", "confidence": 1.0, "element_id": "e000117", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 117, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A 1%", "confidence": 1.0, "element_id": "e000118", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 118, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B 20%", "confidence": 1.0, "element_id": "e000119", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 119, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C 70%", "confidence": 1.0, "element_id": "e000120", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 120, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D 80%", "confidence": 1.0, "element_id": "e000121", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 121, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) Complete the dot-and-cross diagram for a molecule of nitrogen. Show outer electrons only.", "confidence": 1.0, "element_id": "e000122", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 122, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "N N", "confidence": 1.0, "element_id": "e000123", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 123, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) Nitrogen dioxide produced in car engines reacts with water vapour and oxygen in the atmosphere to form nitric acid.", "confidence": 1.0, "element_id": "e000124", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 124, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Give a chemical equation for this reaction.", "confidence": 1.0, "element_id": "e000125", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 125, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Nitric acid forms acid rain.", "confidence": 1.0, "element_id": "e000126", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 126, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "State one environmental effect of acid rain.", "confidence": 1.0, "element_id": "e000127", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 127, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) Ammonium carbonate contains nitrogen.", "confidence": 1.0, "element_id": "e000128", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 128, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) What is the formula of ammonium carbonate?", "confidence": 1.0, "element_id": "e000129", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 129, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A $ \\mathrm{N H_{3} C O_{3}} $", "confidence": 1.0, "element_id": "e000130", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 130, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B $ \\mathrm{(N H_{3})_{2} C O_{3}} $", "confidence": 1.0, "element_id": "e000131", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 131, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "C $ \\mathrm{N H_{4} C O_{3}} $", "confidence": 1.0, "element_id": "e000132", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 132, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D $ \\mathrm{(N H_{4})_{2} C O_{3}} $", "confidence": 1.0, "element_id": "e000133", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 133, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) A technician finds an unlabelled bottle on a shelf that could be ammonium carbonate solution.", "confidence": 1.0, "element_id": "e000134", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 134, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Describe tests that the technician should do to confirm that the solution contains ammonium ions and carbonate ions.", "confidence": 1.0, "element_id": "e000135", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 135, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "8 This question is about hydrocarbons.", "confidence": 1.0, "element_id": "e000136", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 136, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) The molecular formula $ \\mathrm{C_{4} H_{8}} $ represents all the isomers of an alkene.", "confidence": 1.0, "element_id": "e000137", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 137, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Explain what is meant by the term isomers.", "confidence": 1.0, "element_id": "e000138", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 138, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The displayed formula of one of the isomers of the alkene is shown.", "confidence": 1.0, "element_id": "e000139", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 139, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Draw displayed formulae for two other alkene isomers with the molecular formula $ \\mathrm{C_{4} H_{8}} $", "confidence": 1.0, "element_id": "e000141", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 141, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(2)", "confidence": 1.0, "element_id": "e000142", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 142, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) But-1-ene reacts with bromine to form a compound with molecular formula $ \\mathrm{C_{4}H_{8}Br_{2}} $", "confidence": 1.0, "element_id": "e000144", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 144, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "What is the name given to this type of reaction?", "confidence": 1.0, "element_id": "e000145", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 145, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "A addition", "confidence": 1.0, "element_id": "e000146", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 146, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(1)", "confidence": 1.0, "element_id": "e000147", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 147, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "B combustion", "confidence": 1.0, "element_id": "e000148", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 148, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "decomposition", "confidence": 1.0, "element_id": "e000149", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 149, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "D substitution", "confidence": 1.0, "element_id": "e000150", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 150, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) The alkene $ \\mathrm{C}_{3} \\mathrm{H}_{6} $ can be polymerised to form the polymer poly(propene).", "confidence": 1.0, "element_id": "e000151", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 151, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Draw the repeat unit of poly(propene).", "confidence": 1.0, "element_id": "e000152", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 152, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) These are two methods for disposing of polymers such as poly(propene) method 1 burying them in landfill sites method 2 burning them to release heat energy State one environmental problem linked to each of these methods of disposal. (2) method 1", "confidence": 1.0, "element_id": "e000153", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 153, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "method 2", "confidence": 1.0, "element_id": "e000154", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 154, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) Complete combustion of one mole of an alkane produces 396 g of carbon dioxide and 180 g of water.", "confidence": 1.0, "element_id": "e000155", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 155, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "This is the equation for the reaction.", "confidence": 1.0, "element_id": "e000156", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 156, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Calculate the values of x,y and z.", "confidence": 1.0, "element_id": "e000158", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 158, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(e) In a petrol engine, incomplete combustion occurs because there is a limited supply of oxygen.", "confidence": 1.0, "element_id": "e000160", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 160, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Petrol contains octane, $ C_{8} H_{1 8} $", "confidence": 1.0, "element_id": "e000161", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 161, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Complete the equation for this reaction, including state symbols.", "confidence": 1.0, "element_id": "e000162", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 162, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) Explain one problem for humans caused by a product of this incomplete combustion.", "confidence": 1.0, "element_id": "e000164", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 164, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 8 = 15 marks)", "confidence": 1.0, "element_id": "e000165", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 165, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "9 A student uses this apparatus to investigate the rate of reaction between marble chips and dilute hydrochloric acid.", "confidence": 1.0, "element_id": "e000166", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 166, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "This is the equation for the reaction.", "confidence": 1.0, "element_id": "e000168", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 168, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) During the reaction the reading on the balance decreases because mass is lost from the flask.", "confidence": 1.0, "element_id": "e000169", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 169, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) State why mass is lost from the flask.", "confidence": 1.0, "element_id": "e000171", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 171, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) State the purpose of the cotton wool.", "confidence": 1.0, "element_id": "e000172", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 172, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) This is a graph of the student''s results.", "confidence": 1.0, "element_id": "e000173", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 173, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Loss in mass in g", "confidence": 1.0, "element_id": "e000174", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 174, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Time in minutes", "confidence": 1.0, "element_id": "e000176", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 176, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(i) Explain the shape of the graph.", "confidence": 1.0, "element_id": "e000177", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 177, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "You should assume that the marble chips are in excess.", "confidence": 1.0, "element_id": "e000178", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 178, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(4)", "confidence": 1.0, "element_id": "e000179", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 179, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) On the grid, draw the curve you would expect to obtain if the student uses the same volume of hydrochloric acid but with half the concentration.", "confidence": 1.0, "element_id": "e000180", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 180, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Assume that all other conditions are kept the same.", "confidence": 1.0, "element_id": "e000181", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 181, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) The student repeats the experiment using the same mass of smaller marble chips.", "confidence": 1.0, "element_id": "e000182", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 182, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Explain, using particle collision theory, how using smaller marble chips would affect the rate of this reaction.", "confidence": 1.0, "element_id": "e000183", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 183, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Assume that all other conditions are kept the same as in the initial experiment.", "confidence": 1.0, "element_id": "e000184", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 184, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 9 = 11 marks)", "confidence": 1.0, "element_id": "e000185", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 185, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "10 A student investigates the reaction between magnesium and nitric acid. The student uses this method.", "confidence": 1.0, "element_id": "e000186", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 186, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "add $ 4 0 \\mathrm{c m}^{3} $ of dilute nitric acid to a glass beaker", "confidence": 1.0, "element_id": "e000187", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 187, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "record the temperature of the acid", "confidence": 1.0, "element_id": "e000188", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 188, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "find the mass of a strip of magnesium ribbon", "confidence": 1.0, "element_id": "e000189", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 189, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "add the magnesium ribbon to the nitric acid", "confidence": 1.0, "element_id": "e000190", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 190, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "when all the magnesium has reacted, record the highest temperature reached", "confidence": 1.0, "element_id": "e000191", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 191, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(a) Complete the chemical equation for this reaction.", "confidence": 1.0, "element_id": "e000192", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 192, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(b) The thermometer shows the highest temperature reached.", "confidence": 1.0, "element_id": "e000194", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 194, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Complete the table by giving the temperatures to the nearest 0.1 $ ^{\\circ} \\mathrm{C} $", "confidence": 1.0, "element_id": "e000196", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 196, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(c) (i) Show that the heat energy change (Q) for this reaction is about 2800 J. [for $ 1. 0 \\mathrm{c m}^{3} $ of solution, mass = 1.0 g] [for the solution, c = 4.2 J/g/ $ ^{\\circ} C $]", "confidence": 1.0, "element_id": "e000198", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 198, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(ii) The mass of magnesium used by the student was 0.12 g.", "confidence": 1.0, "element_id": "e000199", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 199, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Calculate the value of the enthalpy change $ (\\Delta H) $ , in kJ/mol, for the magnesium reacting with nitric acid.", "confidence": 1.0, "element_id": "e000200", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 200, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Give your answer to two significant figures, including a sign in your answer.", "confidence": 1.0, "element_id": "e000201", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 201, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(d) Explain why using a polystyrene cup, instead of a glass beaker, would give a more accurate result.", "confidence": 1.0, "element_id": "e000203", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 203, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Total for Question 10 = 11 marks)", "confidence": 1.0, "element_id": "e000204", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 204, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "TOTAL FOR PAPER=110 MARKS", "confidence": 1.0, "element_id": "e000205", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 205, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "BLANK PAGE", "confidence": 1.0, "element_id": "e000206", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 206, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "schemaVersion": "1.0"}', NULL, '2026-09-13 12:56:56.519168+00');
INSERT INTO public.documents VALUES ('6644e1e4-cc75-4c87-824b-e18f7c70a0f1', 'dea3eaf3-b1a7-5b42-a475-14d77e5e39bf', '1.0', 1, 'MARK_SCHEME', 'corpus/igcse-chemistry-4ch0-1c-2024jun/MS.md', 'MS.md', 'text/markdown', 'f326b266ddf96922c4c9f5f2539c442086b98e5ef916744931aeb0d7577f16c4', 'SHA-256', 1, 36, 36, 15, 'glm-ocr-markdown', '1.1.0', '2026-09-13 12:56:37.413926+00', '{"pages": [{"width": null, "height": null, "pageNumber": 1}], "source": {"uri": "corpus/igcse-chemistry-4ch0-1c-2024jun/MS.md", "checksum": "f326b266ddf96922c4c9f5f2539c442086b98e5ef916744931aeb0d7577f16c4", "fileName": "MS.md", "mimeType": "text/markdown", "checksumAlgorithm": "SHA-256"}, "tables": [{"rows": [["Question number", "Answer", "Notes", "Marks"], ["1(a)", "", "Description", "Substance", "ALLOW Li\nALLOW Br/Br2\nREJECT Br-\nALLOW C2H4\nALLOW Li", "5"], ["a good conductor of electricity", "lithium"], ["an element that is a liquid at room temperature", "bromine"], ["a substance that can be used to form a polymer", "ethene"], ["an element that forms a basic oxide", "lithium"], ["a substance that has a giant covalent structure", "diamond"], ["(b)", "A description that refers to the following two points\nM1(use damp blue) litmus paper\nM2(litmus paper) bleached/turns white\nIgnore gas/solution", "ALLOW universal indicator paper\nACCEPT blue litmus paper turns red and then bleached\nIGNORE gas/solution\nALLOW\nM1 bromide solution\nM2 turns brown\nREJECT iodide solution\nM2 dep on M1\nRed litmus paper turns blue then bleaches/turns white scores M1 only", "2", "Total 7"]], "text": "Question number | Answer | Notes | Marks\n1(a) |  | Description | Substance | ALLOW Li\nALLOW Br/Br2\nREJECT Br-\nALLOW C2H4\nALLOW Li | 5\na good conductor of electricity | lithium\nan element that is a liquid at room temperature | bromine\na substance that can be used to form a polymer | ethene\nan element that forms a basic oxide | lithium\na substance that has a giant covalent structure | diamond\n(b) | A description that refers to the following two points\nM1(use damp blue) litmus paper\nM2(litmus paper) bleached/turns white\nIgnore gas/solution | ALLOW universal indicator paper\nACCEPT blue litmus paper turns red and then bleached\nIGNORE gas/solution\nALLOW\nM1 bromide solution\nM2 turns brown\nREJECT iodide solution\nM2 dep on M1\nRed litmus paper turns blue then bleaches/turns white scores M1 only | 2 | Total 7", "row_count": 8, "confidence": 1.0, "element_id": "e000022", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 22, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["2", "(a)(i)", "most reactive Q\nS\nR\nleast reactive P", "", "1"], ["(ii)", "R", "", "1"], ["(iii)", "aluminium+hydrochloric acid→aluminium chloride+hydrogen", "ALLOW\n2Al+6HCl→2AlCl3+3H2or multiples or fractions", "1"], ["(iv)", "copper/silver/gold", "ALLOW platinum or any other metal that does not react with hydrochloric acid\nALLOW correct symbol", "1"], ["(v)", "explosive/dangerous/violent/unsafe", "IGNORE volatile/vigorous", "1"], ["(b)(i)", "heat/thermal energy is given out/released(to the surroundings)", "IGNORE energy on its own", "1"], ["(ii)", "aluminium is more reactive/higher in the reactivity series(than iron)ORA", "ACCEPT aluminium is a better/stronger reducing agent\nALLOW Al", "1"], ["(iii)", "An explanation that links the following two points\nM1 aluminium/Al gains oxygen and iron(III) oxide/Fe2O3 loses oxygen\nM2(so) aluminium/Al is oxidised and iron(III) oxide/Fe2O3 is reduced\nOR\nM1 Aluminium/Al gains oxygen so is oxidised\nM2 Iron(III) oxide/Fe2O3 loses oxygen so is reduced", "ACCEPT aluminium/Al loses electrons and iron ions/Fe3+ gain electrons for M1\nACCEPT correct changes in oxidation numbers\nACCEPT aluminium/Al loses electrons so is oxidised scores for M1 and iron ions/Fe3+ gain electrons so is reduced for M2\nREJECT iron loses oxygen for M2", "2"], ["", "", "", "Total 9"]], "text": "Question number | Answer | Notes | Marks\n2 | (a)(i) | most reactive Q\nS\nR\nleast reactive P |  | 1\n(ii) | R |  | 1\n(iii) | aluminium+hydrochloric acid→aluminium chloride+hydrogen | ALLOW\n2Al+6HCl→2AlCl3+3H2or multiples or fractions | 1\n(iv) | copper/silver/gold | ALLOW platinum or any other metal that does not react with hydrochloric acid\nALLOW correct symbol | 1\n(v) | explosive/dangerous/violent/unsafe | IGNORE volatile/vigorous | 1\n(b)(i) | heat/thermal energy is given out/released(to the surroundings) | IGNORE energy on its own | 1\n(ii) | aluminium is more reactive/higher in the reactivity series(than iron)ORA | ACCEPT aluminium is a better/stronger reducing agent\nALLOW Al | 1\n(iii) | An explanation that links the following two points\nM1 aluminium/Al gains oxygen and iron(III) oxide/Fe2O3 loses oxygen\nM2(so) aluminium/Al is oxidised and iron(III) oxide/Fe2O3 is reduced\nOR\nM1 Aluminium/Al gains oxygen so is oxidised\nM2 Iron(III) oxide/Fe2O3 loses oxygen so is reduced | ACCEPT aluminium/Al loses electrons and iron ions/Fe3+ gain electrons for M1\nACCEPT correct changes in oxidation numbers\nACCEPT aluminium/Al loses electrons so is oxidised scores for M1 and iron ions/Fe3+ gain electrons so is reduced for M2\nREJECT iron loses oxygen for M2 | 2\n |  |  | Total 9", "row_count": 10, "confidence": 1.0, "element_id": "e000023", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 23, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["3", "(a)(i)", "2", "ALLOW two", "1"], ["(ii)", "3", "ALLOW three", "1"], ["(iii)", "ZF2", "ALLOW MgF2ALLOW F2MgALLOW F2ZREJECT MgFI2Penalise incorrect case or superscripts", "1"], ["(b)", "", "M1 12×6.0×1023", "ALLOW ecf if incorrect number of electrons x6.0×1023ALLOW ecf if /12 ONLY rather than x12 giving5(.0)×1022", "2"], ["M2 7.2×1024", "4"], ["(c)", "", "M1(isotopic masses)24,25 and 26", "M2 subsumes M1", ""], ["M2 79.0×24+10.0×25+11.0×26 OR 2432"], ["M3 79.0×24+10.0×25+11.0×26 OR 2432 OR 24.32100100", "24.3 without working scores4"], ["M4 24.3", "24.32 without working scores3"], ["", "", "M4 scores only if numbers from the table are used.", ""], ["(d)", "", "magnesium", "ALLOW Mg", "1"], ["", "", "Total 10"]], "text": "Question number | Answer | Notes | Marks\n3 | (a)(i) | 2 | ALLOW two | 1\n(ii) | 3 | ALLOW three | 1\n(iii) | ZF2 | ALLOW MgF2ALLOW F2MgALLOW F2ZREJECT MgFI2Penalise incorrect case or superscripts | 1\n(b) |  | M1 12×6.0×1023 | ALLOW ecf if incorrect number of electrons x6.0×1023ALLOW ecf if /12 ONLY rather than x12 giving5(.0)×1022 | 2\nM2 7.2×1024 | 4\n(c) |  | M1(isotopic masses)24,25 and 26 | M2 subsumes M1 | \nM2 79.0×24+10.0×25+11.0×26 OR 2432\nM3 79.0×24+10.0×25+11.0×26 OR 2432 OR 24.32100100 | 24.3 without working scores4\nM4 24.3 | 24.32 without working scores3\n |  | M4 scores only if numbers from the table are used. | \n(d) |  | magnesium | ALLOW Mg | 1\n |  | Total 10", "row_count": 13, "confidence": 1.0, "element_id": "e000024", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 24, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["4", "(a)", "(i)", "24", "", "1"], ["", "correct answer of 194 scores 2", "2"], ["M1 12×8+1×10+14×4+16×2", "No ECF", ""], ["M2 194", "", ""], ["(iii)", "C4H5N2O", "ALLOW atoms in any order", "1"], ["(b)", "(i)", "(simple) distillation", "", "REJECT fractional distillation", "1"], ["", "", "2"], ["A description that refers to two of the following points", "", "", ""], ["M1 (the condenser/X) cools the (ethanol) vapourM2 so it condenses OR forms liquid (ethanol)", "", "", "5"], ["(c)", "", "M1 calcium bromide is a giant (ionic) lattice/structureM2 with many/strong electrostatic attractions between (oppositely charged) ions", "", "ALLOW many/strong ionic bondsNo M2 if covalent bonds or IMF given here", ""], ["M3 caffeine has a simple molecular structure", "ALLOW simple covalent structure", ""], ["M4 caffeine has weak intermolecular forces/weak forces between molecules", "REJECT weak forces between bonds", ""], ["M5 more energy is needed to break the electrostatic attractions (in calcium bromide) than to overcome the intermolecular forces (in caffeine) OWTTE", "No M5 if reference to breaking covalent bondsNo M5 if reference to incorrect bonds", ""], ["", "", "Total 12"]], "text": "Question number | Answer | Notes | Marks\n4 | (a) | (i) | 24 |  | 1\n | correct answer of 194 scores 2 | 2\nM1 12×8+1×10+14×4+16×2 | No ECF | \nM2 194 |  | \n(iii) | C4H5N2O | ALLOW atoms in any order | 1\n(b) | (i) | (simple) distillation |  | REJECT fractional distillation | 1\n |  | 2\nA description that refers to two of the following points |  |  | \nM1 (the condenser/X) cools the (ethanol) vapourM2 so it condenses OR forms liquid (ethanol) |  |  | 5\n(c) |  | M1 calcium bromide is a giant (ionic) lattice/structureM2 with many/strong electrostatic attractions between (oppositely charged) ions |  | ALLOW many/strong ionic bondsNo M2 if covalent bonds or IMF given here | \nM3 caffeine has a simple molecular structure | ALLOW simple covalent structure | \nM4 caffeine has weak intermolecular forces/weak forces between molecules | REJECT weak forces between bonds | \nM5 more energy is needed to break the electrostatic attractions (in calcium bromide) than to overcome the intermolecular forces (in caffeine) OWTTE | No M5 if reference to breaking covalent bondsNo M5 if reference to incorrect bonds | \n |  | Total 12", "row_count": 15, "confidence": 1.0, "element_id": "e000025", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 25, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["Question number", "Answer", "Notes", "Marks"], ["5(a)(