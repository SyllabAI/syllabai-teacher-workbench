ointing fromH2+Cl2level to2HCl/products level", ""], ["M3curve with hump/peak shown on diagram going up fromH2+Cl2line and ending at2HCl/products line", "REJECTarrow pointing from2HCl/products level toH2+Cl2level", ""], ["M4vertical line fromH2+Cl2level to top of hump level and labelledactivation energy/Ea", "ACCEPTdouble headed arrow or arrow pointing fromH2+Cl2level to top of humpREJECTarrow pointing from top of hump toH2+Cl2levelIf endothermic diagram shown,can scoreM2M3(peak/hump must be above products line)andM4", "Total12"]], "text": "Question number | Answer | Notes | Marks\n7(c) | An explanation that links the following three points |  | 3\nM1energy needed to break bonds / bond-breaking is endothermic | ALLOWenergy is absorbed/taken in | \nM2energy given out when bonds are formed / bond-forming is exothermic | ALLOWenergy is released | \nM3energy given out is greater than energy needed (so exothermic) OWTTE | M3DEP M1M2more energy released when new bonds are formed(in products) than is needed to break the bonds(in reactants)OWTTE scoresM1M2M3If any contradictory statements max1 | \n(d) | M1horizontal line to show products below reactants and to the right of reactants and labelled2HCl | ALLOWproducts for2HCl | 4\nM2vertical line fromH2+Cl2level to2HCl/products level and labelledenthalpy change/ΔH/-184 | ACCEPTdouble headed arrow or arrow pointing fromH2+Cl2level to2HCl/products level | \nM3curve with hump/peak shown on diagram going up fromH2+Cl2line and ending at2HCl/products line | REJECTarrow pointing from2HCl/products level toH2+Cl2level | \nM4vertical line fromH2+Cl2level to top of hump level and labelledactivation energy/Ea | ACCEPTdouble headed arrow or arrow pointing fromH2+Cl2level to top of humpREJECTarrow pointing from top of hump toH2+Cl2levelIf endothermic diagram shown,can scoreM2M3(peak/hump must be above products line)andM4 | Total12", "row_count": 9, "confidence": 1.0, "element_id": "e000034", "page_number": 1, "bounding_box": null, "column_count": 4, "element_type": "table", "reading_order": 34, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "figures": [], "version": 1, "sections": [{"level": 2, "title": "Edexcel and BTEC Qualifications", "sectionId": "s001", "elementIds": ["e000007"], "pageNumber": 1}, {"level": 2, "title": "Pearson: helping people progress, everywhere", "sectionId": "s002", "elementIds": ["e000009", "e000010", "e000011", "e000012", "e000013", "e000014", "e000015", "e000016", "e000017", "e000018", "e000019", "e000020", "e000021", "e000022"], "pageNumber": 1}], "equations": [], "pageCount": 1, "documentId": "d299302d-d0b8-5cd7-8f69-a6f48fa70a73", "provenance": {"engine": "glm-ocr-markdown", "application": "syllabai-parser", "extractedAt": "2026-09-13T13:02:34.404655652Z", "engineVersion": "1.1.0", "schemaVersion": "1.0", "extractionParams": {"pageBoundaries": "none-in-source", "sourceLineCount": 45, "upstreamConverter": "zai-glm-ocr", "entityDecodedLines": 0, "signedUrlFigureRefs": 0, "normalizedHtmlEntities": true}}, "textBlocks": [{"role": "paragraph", "text": "PMT", "confidence": 1.0, "element_id": "e000000", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 0, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Pearson Edexcel", "confidence": 1.0, "element_id": "e000001", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 1, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Mark Scheme (Results)", "confidence": 1.0, "element_id": "e000002", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 2, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "January 2022", "confidence": 1.0, "element_id": "e000003", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 3, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Pearson Edexcel International GCSE", "confidence": 1.0, "element_id": "e000004", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 4, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "In Chemistry (4CH1) Paper 2CR", "confidence": 1.0, "element_id": "e000005", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 5, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Edexcel and BTEC Qualifications", "confidence": 1.0, "element_id": "e000006", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 6, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Edexcel and BTEC qualifications are awarded by Pearson, the UK''s largest awarding body. We provide a wide range of qualifications including academic, vocational, occupational and specific programmes for employers. For further information visit our qualifications websites at www.edexcel.com or www.btec.co.uk. Alternatively, you can get in touch with us using the details on our contact us page at www.edexcel.com/contactus.", "confidence": 1.0, "element_id": "e000007", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 7, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Pearson: helping people progress, everywhere", "confidence": 1.0, "element_id": "e000008", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 8, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Pearson aspires to be the world''s leading learning company. Our aim is to help everyone progress in their lives through education. We believe in every kind of learning, for all kinds of people, wherever they are in the world. We''ve been involved in education for over 150 years, and by working across 70 countries, in 100 languages, we have built an international reputation for our commitment to high standards and raising achievement through innovation in education. Find out more about how we can help you and your students at: www.pearson.com/uk", "confidence": 1.0, "element_id": "e000009", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 9, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "January 2022", "confidence": 1.0, "element_id": "e000010", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 10, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Question Paper Log Number P70704", "confidence": 1.0, "element_id": "e000011", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 11, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Publications Code 4CH1_2CR_2201_MS", "confidence": 1.0, "element_id": "e000012", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 12, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "All the material in this publication is copyright", "confidence": 1.0, "element_id": "e000013", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 13, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "$ \\textcircled{c} $ Pearson Education Ltd 2022", "confidence": 1.0, "element_id": "e000014", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 14, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "All candidates must receive the same treatment. Examiners must mark the first candidate in exactly the same way as they mark the last.", "confidence": 1.0, "element_id": "e000015", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 15, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Mark schemes should be applied positively. Candidates must be rewarded for what they have shown they can do rather than penalised for omissions.", "confidence": 1.0, "element_id": "e000016", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 16, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Examiners should mark according to the mark scheme not according to their perception of where the grade boundaries may lie.", "confidence": 1.0, "element_id": "e000017", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 17, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "There is no ceiling on achievement. All marks on the mark scheme should be used appropriately.", "confidence": 1.0, "element_id": "e000018", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 18, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "All the marks on the mark scheme are designed to be awarded. Examiners should always award full marks if deserved, i.e. if the answer matches the mark scheme. Examiners should also be prepared to award zero marks if the candidate''s response is not worthy of credit according to the mark scheme.", "confidence": 1.0, "element_id": "e000019", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 19, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Where some judgement is required,mark schemes will provide the principles by which marks will be awarded and exemplification may be limited.", "confidence": 1.0, "element_id": "e000020", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 20, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "When examiners are in doubt regarding the application of the mark scheme to a candidate''s response, the team leader must be consulted.", "confidence": 1.0, "element_id": "e000021", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 21, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Crossed out work should be marked UNLESS the candidate has replaced it with an alternative response.", "confidence": 1.0, "element_id": "e000022", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 22, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "schemaVersion": "1.0"}', NULL, '2026-09-13 13:02:54.040338+00');
INSERT INTO public.documents VALUES ('ac2aba36-9617-4bd6-9812-9e3e35a87702', '50791a3d-0583-5c34-91ae-6f68d3197e06', '1.0', 1, 'QUESTION_PAPER', 'corpus/igcse-chemistry-4ch0-2c-2022jun/QP.md', 'QP.md', 'text/markdown', '56c67b2c2a9f310a2f61e9dadbc6ec7db14818c2035ba34036e1f2442ef8f71d', 'SHA-256', 1, 153, 144, 9, 'glm-ocr-markdown', '1.1.0', '2026-09-13 13:02:34.978401+00', '{"pages": [{"width": null, "height": null, "pageNumber": 1}], "source": {"uri": "corpus/igcse-chemistry-4ch0-2c-2022jun/QP.md", "checksum": "56c67b2c2a9f310a2f61e9dadbc6ec7db14818c2035ba34036e1f2442ef8f71d", "fileName": "QP.md", "mimeType": "text/markdown", "checksumAlgorithm": "SHA-256"}, "tables": [{"rows": [["Please check the examination details below before entering your candidate information"], ["Candidate surname", "Other names"], ["Centre Number", "Candidate Number"], ["Pearson Edexcel International GCSE (9-1)"], ["Time", "1 hour 15 minutes", "Paper reference 4CH1/2C"], ["Chemistry\nUNIT: 4CH1\nPAPER: 2C"], ["You must have:\nCalculator, ruler"], ["Total Marks"]], "text": "Please check the examination details below before entering your candidate information\nCandidate surname | Other names\nCentre Number | Candidate Number\nPearson Edexcel International GCSE (9-1)\nTime | 1 hour 15 minutes | Paper reference 4CH1/2C\nChemistry\nUNIT: 4CH1\nPAPER: 2C\nYou must have:\nCalculator, ruler\nTotal Marks", "row_count": 8, "confidence": 1.0, "element_id": "e000000", "page_number": 1, "bounding_box": null, "column_count": 1, "element_type": "table", "reading_order": 0, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["7Li lithium3", "9Be beryllium4", "Key", "4He helium2"], ["23Na sodium11", "24Mg magnesium12", "relative atomic mass atomic symbol atomic (proton) number", "20Ne neon10"], ["39K potassium19", "40Ca calcium20", "45Sc scandium21", "48Ti titanium22", "51V vanadium23", "52Cr chromium24", "55Mn manganese25", "56Fe iron26", "59Co cobalt27", "59Ni nickel28", "63