INSERT INTO public.question_parts VALUES ('9b122393-da52-4908-8690-79ad2a68c8a1', '608d28f0-bd03-4c03-b811-885f21740fe7', 'c', 'Ethene $ \mathrm{C_{2} H_{4}} $ can be produced by cracking long-chain hydrocarbon molecules obtained from crude oil. The ethene produced can then be used to make ethanol. Ethanol can also be made by the fermentation of sugars.', NULL, 0, 4, '2026-09-13 12:57:41.990129+00');
INSERT INTO public.question_parts VALUES ('fbfde5b0-5ab7-414f-ab49-5d03215c3fdd', '608d28f0-bd03-4c03-b811-885f21740fe7', 'c-i', 'Give two advantages of making ethanol from ethene, rather than by fermentation.', NULL, 0, 5, '2026-09-13 12:57:41.990136+00');
INSERT INTO public.question_parts VALUES ('1ca393e5-85f1-4160-b0a4-520d0e3f5e4b', '608d28f0-bd03-4c03-b811-885f21740fe7', 'c-ii', 'Suggest two reasons why ethanol is sometimes made by fermentation,rather than from ethene.', NULL, 0, 6, '2026-09-13 12:57:41.990144+00');
INSERT INTO public.question_parts VALUES ('01f40b97-9735-4002-a5e6-32287a2bb4ec', '55c24497-9608-4333-847f-9879a4df9339', 'a', 'Calculate the amount, in moles, of iodine in $ 1 5. 0 0 \mathrm{c m}^{3} $ of a 0.0010 mol/dm $ ^{3} $ solution.', NULL, 0, 0, '2026-09-13 12:57:41.990155+00');
