INSERT INTO public.question_parts VALUES ('1fb15fb1-357c-408c-80b5-2723b6497f0f', 'b494b826-3ab7-4dff-b11a-313ad4a37ced', 'd', 'The equation for the reaction can be shown using displayed formulae. $2 \mathrm {H} - \mathrm {O} - \mathrm {O} - \mathrm {H} \rightarrow 2 \mathrm {H} - \mathrm {O} - \mathrm {H} + \mathrm {O} = \mathrm {O} \quad \Delta H = - 2 0 4 \mathrm {k J}$ The table gives the bond energies for two of the bonds.', NULL, 0, 3, '2026-09-13 13:01:26.458974+00');
INSERT INTO public.question_parts VALUES ('da5b6f4d-8295-4e00-b81e-58c987998da1', 'b494b826-3ab7-4dff-b11a-313ad4a37ced', 'd-i', 'Use this information to calculate the total amount of energy needed to break all the bonds in two moles of $ \mathrm{H_{2}O_{2}} $', NULL, 0, 4, '2026-09-13 13:01:26.458984+00');
