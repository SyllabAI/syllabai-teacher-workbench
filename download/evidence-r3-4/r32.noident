INSERT INTO public.question_parts VALUES ('6c558f24-b62a-483c-8d21-6a8385150e71', 'b2c53df1-0e90-453e-8630-680143e6572a', 'c-iii', 'The ionic equation for the reaction between bromine and sodium iodide is $\mathrm {B r} _ {2} (\mathrm {a q}) + 2 \mathrm {I} ^ {-} (\mathrm {a q}) \rightarrow \mathrm {I} _ {2} (\mathrm {a q}) + 2 \mathrm {B r} ^ {-} (\mathrm {a q})$ Explain why this is a redox reaction.', NULL, 0, 7, '2026-09-13 12:55:23.885276+00');
INSERT INTO public.question_parts VALUES ('d73aa537-71f5-4b77-a494-6a51e6d8a7e2', '5f77af34-6181-400c-a251-dab415310d81', 'b', 'Name the poisonous gas that forms when propane is burned in a limited supply of air.', NULL, 0, 0, '2026-09-13 12:55:23.885311+00');
