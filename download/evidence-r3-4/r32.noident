INSERT INTO public.document_chunks VALUES ('34a41641-99ff-4076-96f8-f427883e76ef', '4fb2b7ef-edd6-4fee-9cac-63862a8f10f4', 4, 'What is the mass number of this element?
A 12
B 13
C 25
D 49
(iii) State why atoms have no overall charge.
(iv) What is the charge on the ion usually formed from this element?
A 1+
B 2+
C 1-
D 2-
(b) There are two isotopes of the element lithium.
