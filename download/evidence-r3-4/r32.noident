INSERT INTO public.question_parts VALUES ('632c5d41-3801-4a0d-ad3f-9584977d36f0', '8649ae28-2c44-4a8c-b836-e36456c9c697', 'b', 'The chemical equation for the preparation of the insoluble salt lead(II) sulfate is shown below. Complete the equation by adding state symbols. $\mathrm {P b} \left(\mathrm {N O} _ {3}\right) _ {2} (\dots \dots \dots) + \mathrm {N a} _ {2} \mathrm {S O} _ {4} (\dots \dots \dots) \rightarrow \mathrm {P b S O} _ {4} (\dots \dots \dots) + 2 \mathrm {N a N O} _ {3} (\dots \dots \dots)$', NULL, 0, 3, '2026-09-13 12:41:17.399342+00');
