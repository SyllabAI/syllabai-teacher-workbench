INSERT INTO public.question_versions VALUES ('56103ceb-8743-45c1-9c2f-2a1e6607b9ed', '99672fe5-cfc4-46bd-8c0f-a8aa55e9fc1d', 1, 'Rusting occurs when iron is exposed to air and water. During rusting, iron reacts with oxygen from the air to form an oxide. Some students set up this apparatus to measure the volume of oxygen in a sample of air. Each student used an excess of wet iron filings. At the start of the experiment the reading on the syringe was recorded and the apparatus was then left for a week until the reaction was completed. At the end of the experiment the reading on the syringe was recorded again.', 12, 3, 1080, NULL, 'SUGGESTED', 'b8d86e00-c8b7-558b-aa1b-8c696b72fd99', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 12:41:17.305143+00');
