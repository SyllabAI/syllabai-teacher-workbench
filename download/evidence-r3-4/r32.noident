INSERT INTO public.question_parts VALUES ('8f4886e9-cec1-4a4d-b3ba-2baf4d401ddb', 'a8cbb4e6-9dd7-4a11-94bb-170ab8ad87e0', 'c', 'The chromatogram shows the results for inks V, W, X, Y and Z.', NULL, 0, 2, '2026-09-13 12:54:40.215118+00');
INSERT INTO public.question_parts VALUES ('c6d176d4-9e64-4b07-b726-6de11eb6d007', 'a8cbb4e6-9dd7-4a11-94bb-170ab8ad87e0', 'c-i', 'Explain which ink contains a dye that is insoluble in the solvent.', NULL, 0, 3, '2026-09-13 12:54:40.215149+00');
