INSERT INTO public.question_versions VALUES ('2232856b-ba1a-4fb4-a1e3-d9366fab259a', '78470d42-c64e-4d59-b044-eab35578d719', 1, 'Titanium is an important metal in industry. Titanium dioxide $ \left( \mathrm{T i O}_{2} \right) $ can be converted into titanium metal in two stages. Stage 1 titanium dioxide is converted into titanium(IV) chloride $ \left( \mathrm{T i C l}_{4} \right) $ Stage 2 titanium(IV) chloride is converted into titanium', 9, 3, 810, NULL, 'SUGGESTED', '50791a3d-0583-5c34-91ae-6f68d3197e06', 0.6, 'glm-ocr-qp-v1+glm-ocr-ms-v1', '2026-09-13 13:02:54.190564+00');
