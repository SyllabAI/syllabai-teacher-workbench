INSERT INTO public.question_parts VALUES ('0b360297-8487-45b9-b70f-ca1c294e8d6b', '852cba5b-5284-498a-83ba-1d2320af7ff2', 'a', 'State two observations that can be made when dilute hydrochloric acid is added to calcium carbonate.', NULL, 0, 0, '2026-09-13 12:58:26.158696+00');
