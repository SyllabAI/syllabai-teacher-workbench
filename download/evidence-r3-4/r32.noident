INSERT INTO public.document_chunks VALUES ('b2b05318-c5e1-4b20-9e64-7c715563b86d', 'f05f556d-e1d4-4177-a5f3-8542f0fcf82e', 0, 'Please check the examination details below before entering your candidate information
