INSERT INTO public.questions VALUES ('35f98aa7-19a5-4f88-a634-974263e7cab5', 'q04-35fdc8b0', 'STRUCTURED', '(a) The diagram represents the structure of copper metal. Explain three properties of copper that make it a suitable metal to use in electrical wiring.', 11, 3, 990, NULL, 'fdf0a0a8-ac5a-4ef5-9c2a-65e1ef1047a8', 'PAST_PAPER', true, 1, '2026-09-13 13:03:37.866404+00', '24d55d2f-4250-4616-9d6f-7c4f480e84fa');
