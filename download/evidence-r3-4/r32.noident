INSERT INTO public.document_chunks VALUES ('6edc1751-8a0e-4c8e-877e-10bd3588d3dc', '364817b6-d2d4-491c-8a54-bd3b88cda453', 3, 'The lanthanoids (atomic numbers 58-71) and the actinoids (atomic numbers 90-103) have been omitted
