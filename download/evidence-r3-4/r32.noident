n": "1.1.0"}, {"role": "paragraph", "text": "Pearson Edexcel International GCSE", "confidence": 1.0, "element_id": "e000004", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 4, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "In Chemistry (4CH1) Paper 1C and Science", "confidence": 1.0, "element_id": "e000005", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 5, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "(Double Award) (4SD0) Paper 1C", "confidence": 1.0, "element_id": "e000006", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 6, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Edexcel and BTEC Qualifications", "confidence": 1.0, "element_id": "e000007", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 7, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Edexcel and BTEC qualifications are awarded by Pearson, the UK''s largest awarding body. We provide a wide range of qualifications including academic, vocational, occupational and specific programmes for employers. For further information visit our qualifications websites at www.edexcel.com or www.btec.co.uk. Alternatively, you can get in touch with us using the details on our contact us page at www.edexcel.com/contactus.", "confidence": 1.0, "element_id": "e000008", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 8, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "Pearson: helping people progress, everywhere", "confidence": 1.0, "element_id": "e000009", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 9, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Pearson aspires to be the world''s leading learning company. Our aim is to help everyone progress in their lives through education. We believe in every kind of learning, for all kinds of people, wherever they are in the world. We''ve been involved in education for over 150 years, and by working across 70 countries, in 100 languages, we have built an international reputation for our commitment to high standards and raising achievement through innovation in education. Find out more about how we can help you and your students at: www.pearson.com/uk", "confidence": 1.0, "element_id": "e000010", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 10, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "January 2022", "confidence": 1.0, "element_id": "e000011", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 11, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Question Paper Log Number P70701A", "confidence": 1.0, "element_id": "e000012", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 12, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "Publications Code 4CH1_1C_2201_MS", "confidence": 1.0, "element_id": "e000013", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 13, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "All the material in this publication is copyright", "confidence": 1.0, "element_id": "e000014", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 14, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "paragraph", "text": "$ \\textcircled{c} $ Pearson Education Ltd 2022", "confidence": 1.0, "element_id": "e000015", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 15, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "heading", "text": "General Marking Guidance", "confidence": 1.0, "element_id": "e000016", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": 2, "reading_order": 16, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "All candidates must receive the same treatment. Examiners must mark the first candidate in exactly the same way as they mark the last.", "confidence": 1.0, "element_id": "e000017", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 17, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Mark schemes should be applied positively. Candidates must be rewarded for what they have shown they can do rather than penalised for omissions.", "confidence": 1.0, "element_id": "e000018", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 18, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Examiners should mark according to the mark scheme not according to their perception of where the grade boundaries may lie.", "confidence": 1.0, "element_id": "e000019", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 19, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "There is no ceiling on achievement. All marks on the mark scheme should be used appropriately.", "confidence": 1.0, "element_id": "e000020", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 20, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "All the marks on the mark scheme are designed to be awarded. Examiners should always award full marks if deserved, i.e. if the answer matches the mark scheme. Examiners should also be prepared to award zero marks if the candidate''s response is not worthy of credit according to the mark scheme.", "confidence": 1.0, "element_id": "e000021", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 21, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Where some judgement is required,mark schemes will provide the principles by which marks will be awarded and exemplification may be limited.", "confidence": 1.0, "element_id": "e000022", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 22, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "When examiners are in doubt regarding the application of the mark scheme to a candidate''s response,the team leader must be consulted.", "confidence": 1.0, "element_id": "e000023", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 23, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"role": "list_item", "text": "Crossed out work should be marked UNLESS the candidate has replaced it with an alternative response.", "confidence": 1.0, "element_id": "e000024", "page_number": 1, "bounding_box": null, "element_type": "text_block", "heading_level": null, "reading_order": 24, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}], "schemaVersion": "1.0"}', NULL, '2026-09-13 12:56:09.771397+00');
INSERT INTO public.documents VALUES ('22e9cb56-a04c-4852-a4c0-2b1ca8bbb735', 'a6e3bced-d8d1-54cc-9cbe-1eaccef300f2', '1.0', 1, 'QUESTION_PAPER', 'corpus/igcse-chemistry-4ch0-1c-2022janr/QP.md', 'QP.md', 'text/markdown', '29f395966957443e2e22a54e2c11c0cc340c9c9a976f128016aa80f0ac24cb68', 'SHA-256', 1, 200, 192, 12, 'glm-ocr-markdown', '1.1.0', '2026-09-13 12:55:48.812876+00', '{"pages": [{"width": null, "height": null, "pageNumber": 1}], "source": {"uri": "corpus/igcse-chemistry-4ch0-1c-2022janr/QP.md", "checksum": "29f395966957443e2e22a54e2c11c0cc340c9c9a976f128016aa80f0ac24cb68", "fileName": "QP.md", "mimeType": "text/markdown", "checksumAlgorithm": "SHA-256"}, "tables": [{"rows": [["Please check the examination details below before entering your candidate information"], ["Candidate surname", "Other names"], ["Centre Number", "Candidate Number"], ["Pearson Edexcel International GCSE (9-1)"], ["Time", "2 hours", "Paper reference 4CH1/1CR 4SD0/1CR"], ["Chemistry\nUNIT: 4CH1\nScience (Double Award) 4SD0\nPAPER: 1CR"], ["You must have:\nCalculator, ruler", "Total Marks"]], "text": "Please check the examination details below before entering your candidate information\nCandidate surname | Other names\nCentre Number | Candidate Number\nPearson Edexcel International GCSE (9-1)\nTime | 2 hours | Paper reference 4CH1/1CR 4SD0/1CR\nChemistry\nUNIT: 4CH1\nScience (Double Award) 4SD0\nPAPER: 1CR\nYou must have:\nCalculator, ruler | Total Marks", "row_count": 7, "confidence": 1.0, "element_id": "e000000", "page_number": 1, "bounding_box": null, "column_count": 1, "element_type": "table", "reading_order": 0, "source_engine": "glm-ocr-markdown", "source_engine_version": "1.1.0"}, {"rows": [["7Li lithium3", "9Be beryllium4", "Key", "4He helium2"], ["23Na sodium11", "24Mg magnesium12", "relative atomic mass atomic symbol atomic (proton) number", "20Ne neon10"], ["39K potassium19", "40Ca calcium20", "45Sc scandium21", "48Ti titanium22", "51V vanadium23", "52Cr chromium24", "55Mn mang