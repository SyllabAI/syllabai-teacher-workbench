INSERT INTO public.questions VALUES ('3531f967-55a4-4310-8f0c-b444e1d1bfd0', 'q07-24df1df1', 'STRUCTURED', 'Magnesium chloride can be made by reacting excess magnesium carbonate with dilute hydrochloric acid. The equation for the reaction is $\mathrm {M g C O} _ {3} + 2 \mathrm {H C l} \rightarrow \mathrm {M g C l} _ {2} + \mathrm {H} _ {2} \mathrm {O} + \mathrm {C O} _ {2}$', 7, 3, 630, NULL, 'db5123d6-9b53-4e6a-bb17-aa44fd31b616', 'PAST_PAPER', true, 1, '2026-09-13 12:59:56.20576+00', '1fbc97dd-1ba2-4e76-9e11-b7d7c3754987');
INSERT INTO public.questions VALUES ('adab564e-17c3-40ab-acf7-e2795aaa7a14', 'q08-24df1df1', 'STRUCTURED', 'When nitrogen dioxide gas $ \mathrm{(N O_{2})} $ is placed in a sealed flask, it reacts to form dinitrogen tetraoxide gas $ \mathrm{(N_{2}O_{4})}. $ The equation for the reaction is $\begin{array}{c c c} 2 \mathrm {N O} _ {2} (\mathrm {g}) & \rightleftharpoons & \mathrm {N} _ {2} \mathrm {O} _ {4} (\mathrm {g}) \\ \mathrm {b r o w n g a s} & & \mathrm {c o l o u r l e s s g a s} \end{array}$ A sample of pure $ \mathrm{N O_{2}} $ is placed in a sealed flask at $ 2 5^{\circ} \mathrm{C} $ . The flask is left until a dynamic equilibrium is reached.', 8, 3, 720, NULL, 'db5123d6-9b53-4e6a-bb17-aa44fd31b616', 'PAST_PAPER', true, 1, '2026-09-13 12:59:56.206053+00', '1fbc97dd-1ba2-4e76-9e11-b7d7c3754987');
INSERT INTO public.questions VALUES ('84c2e21a-7ab7-47e7-8af3-56d2728cad22', 'q01-afe3708e', 'STRUCTURED', 'This question is about the unsaturated hydrocarbon, ethene. The displayed formula of ethene is', 7, 3, 630, NULL, '256c77b5-e400-4296-8bf5-3c897ec4f247', 'PAST_PAPER', true, 1, '2026-09-13 13:02:53.902979+00', 'c639e7c5-4f02-40c6-8854-5737b423aa3e');
