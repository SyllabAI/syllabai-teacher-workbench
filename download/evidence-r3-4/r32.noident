INSERT INTO public.questions VALUES ('74ff2290-9a94-462a-a581-7d0c93aaf178', 'q03-c98f5542', 'STRUCTURED', '(a) The diagram represents an atom of an element. (i) What is the particle labelled W? (ii) An atom of this element contains 13 neutrons. What is the mass number of this element? (iii) State why atoms have no overall charge. (iv) What is the charge on the ion usually formed from this element? A 1+ B 2+ C 1- D 2-', 8, 3, 720, NULL, '0047ce97-25b1-4cde-8e07-494e74df153b', 'PAST_PAPER', true, 1, '2026-09-13 12:56:56.41147+00', 'b717a499-c0a2-44a0-8176-7c7e3665d3f5');
