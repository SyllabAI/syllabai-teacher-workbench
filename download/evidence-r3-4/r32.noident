INSERT INTO public.question_parts VALUES ('0c1980eb-273a-447c-a5d1-b2f747a471e5', '4973ce20-68f6-4911-bdd6-59e661939493', 'b', 'Iron ore contains the impurity silicon dioxide. The purpose of the limestone is to remove this impurity. The word equations for the reactions that occur are reaction 1 calcium carbonate $ \rightarrow $ calcium oxide+ carbon dioxide reaction 2 calcium oxide + silicon dioxide $ \rightarrow $ calcium silicate Write a chemical equation for each of these reactions. reaction 1 reaction 2', NULL, 0, 1, '2026-09-13 12:53:55.960804+00');
INSERT INTO public.question_parts VALUES ('7914a49d-dfae-42a1-b8d9-6410c4141abc', '4973ce20-68f6-4911-bdd6-59e661939493', 'c', 'The equation for a reaction that occurs in the blast furnace is $2 \mathrm {F e} _ {2} \mathrm {O} _ {3} + 3 \mathrm {C} \rightarrow 4 \mathrm {F e} + 3 \mathrm {C O} _ {2}$ Explain, with reference to the reactants in this equation, why this is a redox reaction.', NULL, 0, 2, '2026-09-13 12:53:55.960842+00');
INSERT INTO public.question_parts VALUES ('3cb23404-2e7c-4ada-8c65-79fb258f2d87', '5d96a57f-bdb2-4f02-a696-f3fe67b450e7', 'a', 'The passage is about the fractional distillation of crude oil. Use words from the box to complete the passage. You may use each word once, more than once or not at all. boiling point condensation melting point sublimation temperature vaporisation The crude oil is heated so that ... occurs. The column has a ... gradient. The compounds in the crude oil pass up the column and ... occurs at different heights depending on the ... of each fraction.', NULL, 0, 0, '2026-09-13 12:53:55.960919+00');
INSERT INTO public.question_parts VALUES ('0108765e-bee9-4eed-9370-9dc72025e225', '5d96a57f-bdb2-4f02-a696-f3fe67b450e7', 'b', 'The table lists some statements about cracking. Place ticks ( $ \checkmark $ ) in the boxes to show the three correct statements.', NULL, 3, 1, '2026-09-13 12:53:55.960966+00');
INSERT INTO public.question_parts VALUES ('5a40c849-5437-4533-825b-ca0917a4b9dc', '5d96a57f-bdb2-4f02-a696-f3fe67b450e7', 'c', 'When one molecule of butane is cracked, there are three possible reactions. The equations for these reactions are $\mathrm {r e a c t i o n} 1 \quad \mathrm {C} _ {4} \mathrm {H} _ {1 0} \rightarrow \mathrm {C} _ {3} \mathrm {H} _ {6} + \mathrm {C H} _ {4}$ reaction 2 $ C_{4} H_{1 0} \rightarrow C_{2} H_{6}+C_{2} H_{4} $ reaction 3 $\mathrm {C} _ {4} \mathrm {H} _ {1 0} \rightarrow \mathrm {C} _ {4} \mathrm {H} _ {8} + \mathrm {H} _ {2}$', NULL, 0, 2, '2026-09-13 12:53:55.961027+00');
INSERT INTO public.question_parts VALUES ('252bce3d-9371-4790-a9d2-885cb0470a83', '5d96a57f-bdb2-4f02-a696-f3fe67b450e7', 'c-i', 'One product in each of these reactions is an alkene. What is the general formula for the homologous series of alkenes?', NULL, 0, 3, '2026-09-13 12:53:55.961059+00');
