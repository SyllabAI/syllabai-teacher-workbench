y": "warning", "questionNumber": null}, {"detail": "7(a): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "7(a): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "7(a): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "7(c)(i): bare integer cell \"2\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "7(c)(i): bare integer cell \"8\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "8(a): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "8(a): bare integer cell \"11\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "8(a): bare integer cell \"11\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "8(a): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "8(a): bare integer cell \"8\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}]', '{"paper": {"board": "Edexcel", "session": "January 2012", "subject": null, "duration": null, "examDate": "Friday 20 January 2012 – Morning", "logNumber": null, "qualification": null, "paperReference": "4CH0/2C", "publicationCode": null, "canonicalDocumentId": "d5f4942f-e594-5148-a6cf-63b92cb75147"}, "warnings": ["unclassified heading: In each part of this question, place a cross ( $ \\boxtimes $ ) in one box to identify the letter, A to E, that represents", "unclassified heading: TURN OVER FOR QUESTION 8"], "questions": [{"mcq": false, "qwc": false, "stem": "(a) Complete the table to show the relative mass and relative charge of a proton, a neutron and an electron.", "marks": 0, "parts": [{"qwc": false, "text": "The symbol for an atom of one isotope of hydrogen is $ _{1}^{3} \\mathrm{H} $", "label": "b", "marks": null, "partId": "q01-d5f4942f-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "State the number of protons, neutrons and electrons present in one atom of this isotope. Number of protons ... Number of neutrons ... Number of electrons ...", "label": "b-i", "marks": null, "partId": "q01-d5f4942f-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "What is meant by the term isotopes?", "label": "b-ii", "marks": null, "partId": "q01-d5f4942f-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Bromine has two naturally-occurring isotopes with mass numbers 79 and 81. A sample of bromine contained the two isotopes in the following proportions: bromine-79=50.7% and bromine-81=49.3% Use this information to calculate the relative atomic mass of bromine. Give your answer to two decimal places.", "label": "c", "marks": null, "partId": "q01-d5f4942f-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 1, "figures": [], "options": [], "section": null, "confidence": 0.45, "marksKnown": false, "questionId": "q01-d5f4942f", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000021"]}, {"mcq": false, "qwc": false, "stem": "Use the Periodic Table on page 2 to help you answer this question.", "marks": 6, "parts": [{"qwc": false, "text": "Part of the Periodic Table is shown.", "label": "a", "marks": null, "partId": "q02-d5f4942f-pa", "figures": [{"url": "assets/crop_1_1789063862499.png", "width": 1444, "format": "png", "height": 492, "sha256": "61a9c8f19186688832bebc7bc0b73add23b552475d922b7aa20bccdd1f50c4f5", "assetId": "img:61a9c8f19186688832bebc7bc0b73add23b552475d922b7aa20bccdd1f50c4f5", "mimeType": "image/jpeg", "elementId": "e000033", "sourceName": "assets/crop_1_1789063862499.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "a metal that reacts violently with water", "label": "a-i", "marks": null, "partId": "q02-d5f4942f-pa-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "a noble gas A B C D E □ □ □ □ □", "label": "a-ii", "marks": null, "partId": "q02-d5f4942f-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "a Group 2 metal A B C D E □ □ □ □ □", "label": "a-iii", "marks": null, "partId": "q02-d5f4942f-pa-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "a halogen A B C D E □ □ □ □ □", "label": "a-iv", "marks": 1, "partId": "q02-d5f4942f-pa-iv", "figures": [], "confidence": 0.8, "answerPrompts": []}, {"qwc": false, "text": "Complete these sentences by placing a cross ( $ \\boxtimes $ ) in one box next to the correct answer.", "label": "b", "marks": null, "partId": "q02-d5f4942f-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The elements in the Periodic Table are arranged in order of increasing number of neutrons atomic number relative atomic mass mass number", "label": "b-i", "marks": null, "partId": "q02-d5f4942f-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Elements in the same group in the Periodic Table have the same number of electrons in the outer shell protons in the nucleus neutrons in the nucleus atoms", "label": "b-ii", "marks": null, "partId": "q02-d5f4942f-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 2, "figures": [{"url": "assets/crop_1_1789063862499.png", "width": 1444, "format": "png", "height": 492, "sha256": "61a9c8f19186688832bebc7bc0b73add23b552475d922b7aa20bccdd1f50c4f5", "assetId": "img:61a9c8f19186688832bebc7bc0b73add23b552475d922b7aa20bccdd1f50c4f5", "mimeType": "image/jpeg", "elementId": "e000033", "sourceName": "assets/crop_1_1789063862499.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q02-d5f4942f", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "Lead(II) sulfate, $ \\mathrm{P b S O_{4}} $ , is an insoluble salt. It can be made as a precipitate from a solution of lead(II) nitrate, $ \\mathrm{P b ( N O_{3} )_{2}} $", "marks": 8, "parts": [{"qwc": false, "text": "Identify a substance that could be added to lead(II) nitrate solution to form a precipitate of lead(II) sulfate.", "label": "a", "marks": null, "partId": "q03-d5f4942f-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Write a chemical equation for the reaction between lead(II) nitrate and the substance you identified in (a)(i).", "label": "a-ii", "marks": null, "partId": "q03-d5f4942f-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Outline how you would produce a pure, dry sample of lead(II) sulfate from the reaction mixture in (a)(ii).", "label": "a-iii", "marks": null, "partId": "q03-d5f4942f-pa-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "A solution of lead(II) nitrate can be made by reacting solid lead(II) carbonate with dilute nitric acid. The equation for this reaction is: $\\mathrm {P b C O} _ {3} (\\mathrm {s}) + 2 \\mathrm {H N O} _ {3} (\\mathrm {a q}) \\rightarrow \\mathrm {P b} (\\mathrm {N O} _ {3}) _ {2} (\\mathrm {a q}) + \\mathrm {C O} _ {2} (\\mathrm {g}) + \\mathrm {H} _ {2} \\mathrm {O} (\\mathrm {l})$ State two observations you would make when dilute nitric acid is added to solid lead(II) carbonate.", "label": "b", "marks": null, "partId": "q03-d5f4942f-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 3, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q03-d5f4942f", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "When magnesium is burned in air, it reacts with oxygen, $ \\mathrm{O_{2}} $ , to form magnesium oxide, MgO A class of students investigated the relationship between the mass of magnesium burned and the mass of magnesium oxide formed. Each student was given a different mass of clean magnesium to heat. The students used the following method. Weigh a crucible and lid Place the magnesium ribbon in the crucible, replace the lid, and reweigh Heat the crucible as shown in the diagram until the magnesium burns Lift the lid from time to time until there is no sign of further reaction Allow the crucible and lid to cool and reweigh Repeat the heating, cooling and reweighing until two consecutive masses are the same Calculate the mass of magnesium oxide formed", "marks": 0, "parts": [{"qwc": false, "text": "Why is it necessary to lift the lid from time to time while heating?", "label": "a", "marks": null, "partId": "q04-d5f4942f-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Why is it necessary to repeat the heating until two consecutive masses are the same?", "label": "a-ii", "marks": 1, "partId": "q04-d5f4942f-pa-ii", "figures": [], "confidence": 0.8, "answerPrompts": []}, {"qwc": false, "text": "Show how the mass of magnesium oxide formed can be calculated from the readings obtained.", "label": "b", "marks": null, "partId": "q04-d5f4942f-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The results of each experiment are given in the table.", "label": "c", "marks": null, "partId": "q04-d5f4942f-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Plot the results on the grid and draw a straight line of best fit.", "label": "c-i", "marks": null, "partId": "q04-d5f4942f-pc-i", "figures": [{"url": "assets/crop_1_1789063862546.png", "width": 982, "format": "png", "height": 1524, "sha256": "2465999f4c0a70cf3c764d6b8b0f17308239e88ba8417449d27144a71bcec126", "assetId": "img:2465999f4c0a70cf3c764d6b8b0f17308239e88ba8417449d27144a71bcec126", "mimeType": "image/jpeg", "elementId": "e000086", "sourceName": "assets/crop_1_1789063862546.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Draw a circle around the anomalous result.", "label": "c-ii", "marks": null, "partId": "q04-d5f4942f-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Use your graph to find the mass of magnesium oxide formed when 0.48 g of magnesium is burned.", "label": "c-iii", "marks": null, "partId": "q04-d5f4942f-pc-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 4, "figures": [{"url": "assets/crop_1_1789063862523.png", "width": 882, "format": "png", "height": 492, "sha256": "a792aaecbf49e70f73ccaf3dd779dd602cc315839d88254191a07a8b2d854010", "assetId": "img:a792aaecbf49e70f73ccaf3dd779dd602cc315839d88254191a07a8b2d854010", "mimeType": "image/jpeg", "elementId": "e000074", "sourceName": "assets/crop_1_1789063862523.png", "availability": "available", "formatMismatch": true}, {"url": "assets/crop_1_1789063862546.png", "width": 982, "format": "png", "height": 1524, "sha256": "2465999f4c0a70cf3c764d6b8b0f17308239e88ba8417449d27144a71bcec126", "assetId": "img:2465999f4c0a70cf3c764d6b8b0f17308239e88ba8417449d27144a71bcec126", "mimeType": "image/jpeg", "elementId": "e000086", "sourceName": "assets/crop_1_1789063862546.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.45, "marksKnown": false, "questionId": "q04-d5f4942f", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000084"]}, {"mcq": false, "qwc": false, "stem": "The apparatus shown can be used to electrolyse aqueous sodium chloride in the laboratory.", "marks": 0, "parts": [{"qwc": false, "text": "Gases are evolved at both electrodes.", "label": "a", "marks": null, "partId": "q05-d5f4942f-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Describe a chemical test to show that the gas evolved at the positive electrode is chlorine.", "label": "a-i", "marks": null, "partId": "q05-d5f4942f-pa-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Identify gas A.", "label": "a-ii", "marks": null, "partId": "q05-d5f4942f-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Some of the solution formed after the electrolysis was tested with the indicator phenolphthalein. The indicator turned pink Explain this result.", "label": "b", "marks": null, "partId": "q05-d5f4942f-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The equation for the reaction taking place at the positive electrode is: $2 \\mathrm {C l} ^ {-} (\\mathrm {a q}) \\rightarrow \\mathrm {C l} _ {2} (\\mathrm {g}) + 2 \\mathrm {e} ^ {-}$ Ten faradays (10 F) of electricity were passed through an aqueous solution of sodium chloride.", "label": "c", "marks": null, "partId": "q05-d5f4942f-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the amount, in moles, of chlorine formed.", "label": "c-i", "marks": null, "partId": "q05-d5f4942f-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the volume of chlorine formed. (One mole of a gas occupies $ 2 4 \\mathrm{~ d m}^{3} $ at this temperature and pressure)", "label": "c-ii", "marks": null, "partId": "q05-d5f4942f-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 5, "figures": [{"url": "assets/crop_1_1789063862560.png", "width": 1094, "format": "png", "height": 894, "sha256": "1798692073bc936dd517db1c5a91d9688012d33e64d5c9236da70e48bbb9233c", "assetId": "img:1798692073bc936dd517db1c5a91d9688012d33e64d5c9236da70e48bbb9233c", "mimeType": "image/jpeg", "elementId": "e000090", "sourceName": "assets/crop_1_1789063862560.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.45, "marksKnown": false, "questionId": "q05-d5f4942f", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "Compound X is a blue, crystalline solid. It contains copper(II) ions $ \\mathrm{(C u^{2+})} $ , sulfate ions $ \\mathrm{(S O_{4}^{2-})} $ and water of crystallisation.", "marks": 5, "parts": [{"qwc": false, "text": "A student dissolved some of compound X in water and then added aqueous sodium hydroxide solution. She obtained a blue precipitate. Give the formula of the blue precipitate formed in the reaction.", "label": "a", "marks": null, "partId": "q06-d5f4942f-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Another student tested a solution of compound X for sulfate ions using dilute hydrochloric acid, followed by a few drops of barium chloride solution. She obtained a white precipitate. Why is the dilute hydrochloric acid necessary in this test?", "label": "b", "marks": null, "partId": "q06-d5f4942f-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The empirical formula of compound X is $ \\mathrm{C u S O_{9} H_{1 0}} $ Write the formula of compound X to show its water of crystallisation.", "label": "c", "marks": null, "partId": "q06-d5f4942f-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Compound X gives a blue-green colour in a flame test. Outline how you would carry out a flame test.", "label": "d", "marks": null, "partId": "q06-d5f4942f-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 6, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q06-d5f4942f", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "The table shows percentage by mass of the fractions obtained from a sample of crude oil and the percentage market demand for these fractions.", "marks": 8, "parts": [{"qwc": false, "text": "Why is the market demand for the gasoline fraction greater than that for the fuel oil fraction? (1)", "label": "a", "marks": null, "partId": "q07-d5f4942f-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Cracking is used to make long-chain hydrocarbon molecules into shorter-chain hydrocarbon molecules.", "label": "b", "marks": null, "partId": "q07-d5f4942f-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Complete the equation to show the other hydrocarbon molecule formed when $ \\mathrm{C_{20}H_{42}} $ is cracked. $\\mathrm {C} _ {2 0} \\mathrm {H} _ {4 2} \\rightarrow \\mathrm {C} _ {1 6} \\mathrm {H} _ {3 4} +$", "label": "b-i", "marks": null, "partId": "q07-d5f4942f-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give the name of a catalyst used in industry to crack long-chain hydrocarbons and state a temperature at which cracking is carried out. Catalyst Temperature", "label": "b-ii", "marks": null, "partId": "q07-d5f4942f-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Ethene $ \\mathrm{C_{2} H_{4}} $ can be produced by cracking long-chain hydrocarbon molecules obtained from crude oil. The ethene produced can then be used to make ethanol. Ethanol can also be made by the fermentation of sugars.", "label": "c", "marks": null, "partId": "q07-d5f4942f-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give two advantages of making ethanol from ethene, rather than by fermentation.", "label": "c-i", "marks": null, "partId": "q07-d5f4942f-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Suggest two reasons why ethanol is sometimes made by fermentation,rather than from ethene.", "label": "c-ii", "marks": null, "partId": "q07-d5f4942f-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 7, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q07-d5f4942f", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000112"]}, {"mcq": false, "qwc": false, "stem": "Sulfur dioxide, $ \\mathrm{S O_{2}} $ , is used as a preservative in wine. The sulfur dioxide content of a wine can be found by titration. A chemist found that $ 2 5. 0 \\mathrm{c m}^{3} $ of a sample of wine reacted with exactly $ 1 5. 0 0 \\mathrm{c m}^{3} $ of 0.0010 mol/dm $ ^{3} $ aqueous iodine, $ \\mathrm{I}_{2} $ (aq). The equation for the reaction is $\\mathrm {S O} _ {2} (\\mathrm {a q}) + \\mathrm {I} _ {2} (\\mathrm {a q}) + 2 \\mathrm {H} _ {2} \\mathrm {O} (\\mathrm {l}) \\rightarrow \\mathrm {S O} _ {4} ^ {2 -} (\\mathrm {a q}) + 2 \\mathrm {I} ^ {-} (\\mathrm {a q}) + 4 \\mathrm {H} ^ {+} (\\mathrm {a q})$", "marks": 8, "parts": [{"qwc": false, "text": "Calculate the amount, in moles, of iodine in $ 1 5. 0 0 \\mathrm{c m}^{3} $ of a 0.0010 mol/dm $ ^{3} $ solution.", "label": "a", "marks": null, "partId": "q08-d5f4942f-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Deduce the amount, in moles, of sulfur dioxide in $ 2 5. 0 \\mathrm{c m}^{3} $ of the wine.", "label": "b", "marks": null, "partId": "q08-d5f4942f-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the concentration, in mol/dm $ ^{3} $ , of sulfur dioxide in the wine.", "label": "c", "marks": null, "partId": "q08-d5f4942f-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the concentration, in $ \\mathrm{g / d m^{3}} $ of sulfur dioxide in the wine.", "label": "d", "marks": null, "partId": "q08-d5f4942f-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "A concentration of sulfur dioxide that is greater than $ 0. 1 6 \\mathrm{~ g / d m^{3}} $ makes wine unpleasant to drink. Use the value you have calculated in (d) to state whether the wine is drinkable.", "label": "e", "marks": null, "partId": "q08-d5f4942f-pe", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 8, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q08-d5f4942f", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}], "paperTotal": 60, "schemaVersion": "1.0", "sectionTotals": {}, "questionTotals": {"2": 6, "3": 8, "6": 5, "7": 8, "8": 8}, "reviewRequired": true, "extractionMethod": "glm-ocr-qp-v1", "frontMatterFigures": []}', '{"paper": {"board": null, "session": "January 2012", "subject": null, "duration": null, "examDate": null, "logNumber": null, "qualification": null, "paperReference": null, "publicationCode": null, "canonicalDocumentId": "60b14f60-96c3-5718-8982-5161a4b9496a"}, "entries": [{"mcq": false, "qwc": false, "label": "1(a)", "marks": 4, "number": 1, "entryId": "ms-60b14f60-q1a", "guidance": [{"kind": "note", "text": "Proton"}, {"kind": "note", "text": "Neutron"}, {"kind": "note", "text": "Electron"}, {"kind": "note", "text": "+1"}, {"kind": "note", "text": "-1/oneZerominus one/negative"}, {"kind": "note", "text"