INSERT INTO public.question_parts VALUES ('451d6973-2345-4561-8003-ee7984b24dcd', '67f4317b-7c33-4d9b-9fce-21852979fbd0', 'a-iii', 'What type of reaction takes place when bromine reacts with a compound containing a C=C bond?', NULL, 0, 2, '2026-09-13 12:58:26.375457+00');
INSERT INTO public.question_parts VALUES ('29ce8908-e921-465e-bfeb-e6f74fc16f71', '67f4317b-7c33-4d9b-9fce-21852979fbd0', 'b', 'In February 2005, some companies had to remove their pizzas from sale because the food colourings in them were found to contain the artificial dye called Sudan 1, which is known to cause cancer. The chromatogram shows how the dyes in the colourings were detected and identified.', NULL, 0, 3, '2026-09-13 12:58:26.375511+00');
INSERT INTO public.question_parts VALUES ('14321962-5612-4b85-b371-de1a583ec3da', '67f4317b-7c33-4d9b-9fce-21852979fbd0', 'b-i', 'Which one of the food colourings, A, B, C or D, is made up of only one dye?', NULL, 0, 4, '2026-09-13 12:58:26.375554+00');
INSERT INTO public.question_parts VALUES ('04bbd8d0-373e-477d-9491-0026564847ee', '67f4317b-7c33-4d9b-9fce-21852979fbd0', 'b-ii', 'Identify the food colourings that may have contained Sudan 1.', NULL, 0, 5, '2026-09-13 12:58:26.375599+00');
INSERT INTO public.question_parts VALUES ('c781ced0-fe43-4d76-94fc-e472c6dacb16', '67f4317b-7c33-4d9b-9fce-21852979fbd0', 'b-iii', 'Explain how the chromatogram shows that the five food colourings are different from each other.', NULL, 0, 6, '2026-09-13 12:58:26.375648+00');
