iguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "6(a)(i): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "6(a)(i): bare integer cell \"2\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "6(a)(i): bare integer cell \"2\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "7(a): bare integer cell \"2\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "7(a): bare integer cell \"5\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "7(a): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "7(a): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "7(a): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "8(a): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "8(a): bare integer cell \"1\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}, {"detail": "8(a): bare integer cell \"2\" skipped (rubric/rowspan ambiguity)", "source": "MS_WARNING", "msMarks": null, "qpMarks": null, "severity": "warning", "questionNumber": null}]', '{"paper": {"board": "Edexcel", "session": null, "subject": null, "duration": null, "examDate": null, "logNumber": null, "qualification": null, "paperReference": "4CH1/2CR", "publicationCode": null, "canonicalDocumentId": "75c7a386-54b6-54d3-a2ba-47635a55fcdc"}, "warnings": ["Q4: incomplete MCQ option set folded into stem"], "questions": [{"mcq": false, "qwc": false, "stem": "In this question the answer to each part is a number.", "marks": 4, "parts": [{"qwc": false, "text": "Give the pH value of a neutral solution.", "label": "a", "marks": null, "partId": "q01-75c7a386-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give a pH value of a weakly acidic solution.", "label": "b", "marks": null, "partId": "q01-75c7a386-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give the number of the Group in the Periodic Table that contains the elements that do not readily react.", "label": "c", "marks": null, "partId": "q01-75c7a386-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give the number of different elements present in glucose, $ \\mathrm{C_{6} H_{1 2} O_{6}} $", "label": "d", "marks": null, "partId": "q01-75c7a386-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 1, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q01-75c7a386", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "The solubility of a solid depends on the solvent used.", "marks": 0, "parts": [{"qwc": false, "text": "State one other factor that affects the solubility.", "label": "a", "marks": null, "partId": "q02-75c7a386-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "A student wants to find the solubility of a salt in water. The steps in the student''s method are not in the correct order. Step A gently heat the evaporating basin and solution to remove all the water Step B filter to obtain $ 5 0. 0 \\mathrm{c m}^{3} $ of saturated solution Step C record the mass of the evaporating basin and salt solution Step D record the mass of an empty evaporating basin Step E record the mass of the evaporating basin and the dry salt Step F put $ 5 0. 0 \\mathrm{c m}^{3} $ of water into a beaker Step G add the salt to the water a little at a time and stir until no more dissolves Step H pour the $ 5 0. 0 \\mathrm{c m}^{3} $ of saturated salt solution into the evaporating basin", "label": "b", "marks": null, "partId": "q02-75c7a386-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The flowchart shows the correct order of some of the steps. Complete the flowchart by putting the remaining steps in the correct order.", "label": "b-i", "marks": 2, "partId": "q02-75c7a386-pb-i", "figures": [{"url": "assets/crop_1_1789064281803.png", "width": 1746, "format": "png", "height": 1080, "sha256": "9e98be4ac8c8007c44f95e9d3c099520cc62897666ae9b67ab850e0f0b4610df", "assetId": "img:9e98be4ac8c8007c44f95e9d3c099520cc62897666ae9b67ab850e0f0b4610df", "mimeType": "image/jpeg", "elementId": "e000043", "sourceName": "assets/crop_1_1789064281803.png", "availability": "available", "formatMismatch": true}], "confidence": 0.8, "answerPrompts": []}], "number": 2, "figures": [{"url": "assets/crop_1_1789064281803.png", "width": 1746, "format": "png", "height": 1080, "sha256": "9e98be4ac8c8007c44f95e9d3c099520cc62897666ae9b67ab850e0f0b4610df", "assetId": "img:9e98be4ac8c8007c44f95e9d3c099520cc62897666ae9b67ab850e0f0b4610df", "mimeType": "image/jpeg", "elementId": "e000043", "sourceName": "assets/crop_1_1789064281803.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.45, "marksKnown": false, "questionId": "q02-75c7a386", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000044"]}, {"mcq": false, "qwc": false, "stem": "When 10.0kg of a solid fuel is burned,the heat energy produced is $ 3. 2 8 \\times1 0^{5} $ kJ.", "marks": 9, "parts": [{"qwc": false, "text": "Calculate the heat energy, in kJ/mol, produced by the fuel. You should assume that the fuel is pure carbon. Give your answer to three significant figures. [for carbon, $ A_{\\mathrm{r}}=1 2 $]", "label": "a", "marks": null, "partId": "q03-75c7a386-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The fuel actually contains some impurities, including sulfur. There is 600g of sulfur in 20kg of fuel.", "label": "b", "marks": null, "partId": "q03-75c7a386-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the percentage of sulfur in the fuel.", "label": "b-i", "marks": null, "partId": "q03-75c7a386-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "When the fuel burns,the 600g of sulfur produces sulfur dioxide gas. $S + O _ {2} \\rightarrow S O _ {2}$ Calculate the volume, in $ cm^{3} $ , of sulfur dioxide gas that would be produced at room temperature and pressure (rtp) when the fuel burns. [for a gas, molar volume = 24 dm $ ^{3} $ at rtp]", "label": "b-ii", "marks": null, "partId": "q03-75c7a386-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": ["volume of sulfur dioxide"]}, {"qwc": false, "text": "State the name of the environmental problem caused by sulfur dioxide in the atmosphere.", "label": "b-iii", "marks": null, "partId": "q03-75c7a386-pb-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 3, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q03-75c7a386", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "(a) Hand sanitiser liquids are used regularly to reduce the spread of infections. Three compounds P, Q and R are often present in these liquids. (i) What type of formula is shown for P? (ii) Compounds P, Q and R are members of the same homologous series. Give two properties of a homologous series. (iii) Name the homologous series that contains compounds P, Q and R. (iv) Give the name of compound Q. A a displayed formula B an empirical formula C a molecular formula D a structural formula", "marks": 0, "parts": [{"qwc": false, "text": "Diols and dicarboxylic acids react together in polymerisation reactions to form polyesters.", "label": "b", "marks": null, "partId": "q04-75c7a386-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain the name given to the type of polymerisation that occurs in these reactions.", "label": "b-i", "marks": null, "partId": "q04-75c7a386-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Complete the equation for the polymerisation reaction by giving the displayed formula of the repeat unit of the polymer.", "label": "b-ii", "marks": null, "partId": "q04-75c7a386-pb-ii", "figures": [{"url": "assets/crop_1_1789064281840.png", "width": 1720, "format": "png", "height": 1585, "sha256": "40356a2a334e9bcd25da5ce436775a59e73cd619134dfd1a656c486b3ef667f0", "assetId": "img:40356a2a334e9bcd25da5ce436775a59e73cd619134dfd1a656c486b3ef667f0", "mimeType": "image/jpeg", "elementId": "e000074", "sourceName": "assets/crop_1_1789064281840.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}], "number": 4, "figures": [{"url": "assets/crop_1_1789064281840.png", "width": 1720, "format": "png", "height": 1585, "sha256": "40356a2a334e9bcd25da5ce436775a59e73cd619134dfd1a656c486b3ef667f0", "assetId": "img:40356a2a334e9bcd25da5ce436775a59e73cd619134dfd1a656c486b3ef667f0", "mimeType": "image/jpeg", "elementId": "e000074", "sourceName": "assets/crop_1_1789064281840.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.45, "marksKnown": false, "questionId": "q04-75c7a386", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000062"]}, {"mcq": false, "qwc": false, "stem": "This question is about the element phosphorus and some of its compounds.", "marks": 11, "parts": [{"qwc": false, "text": "The atomic number of phosphorus is 15 Give the electronic configuration of an atom of phosphorus.", "label": "a", "marks": null, "partId": "q05-75c7a386-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calcium phosphide is an ionic compound used in pest control. The formula of a calcium ion is $ \\mathrm{C a}^{2+} $ Explain why the formula of calcium phosphide is $ \\mathrm{C a}_{3} \\mathrm{P}_{2} $", "label": "b", "marks": null, "partId": "q05-75c7a386-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calcium phosphide can be produced by heating calcium phosphate with carbon.", "label": "c", "marks": null, "partId": "q05-75c7a386-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Complete the equation for the reaction. $\\mathrm {C a} _ {3} \\left(\\mathrm {P O} _ {4}\\right) _ {2} + \\dots \\dots \\dots \\dots \\mathrm {C} \\rightarrow \\mathrm {C a} _ {3} \\mathrm {P} _ {2} + \\dots \\dots \\dots \\dots \\mathrm {C O}$", "label": "c-i", "marks": null, "partId": "q05-75c7a386-pc-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain the role of carbon in the reaction.", "label": "c-ii", "marks": null, "partId": "q05-75c7a386-pc-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calcium phosphide reacts with water to form calcium hydroxide and phosphine, $ \\mathrm{P H_{3}} $ Give a chemical equation for this reaction.", "label": "d", "marks": null, "partId": "q05-75c7a386-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain why calcium phosphide has a high melting point. You should refer to structure and bonding in your answer.", "label": "e", "marks": null, "partId": "q05-75c7a386-pe", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 5, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q05-75c7a386", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "Iron metal was discovered several thousand years ago. Iron is produced industrially from iron(III) oxide by extraction using carbon. Sodium is a metal in Group 1 of the Periodic Table. Sodium was discovered by Sir Humphrey Davy in 1807. It is produced industrially by the electrolysis of sodium chloride.", "marks": 13, "parts": [{"qwc": false, "text": "Explain, using the reactivity series, why carbon can be used to extract iron from iron(III) oxide.", "label": "a", "marks": null, "partId": "q06-75c7a386-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Suggest why sodium was not discovered until 1807.", "label": "a-ii", "marks": null, "partId": "q06-75c7a386-pa-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The diagram shows a simplified version of the Downs cell, which can be used to produce sodium industrially. The electrolyte is molten sodium chloride.", "label": "b", "marks": null, "partId": "q06-75c7a386-pb", "figures": [{"url": "assets/crop_1_1789064281871.png", "width": 1403, "format": "png", "height": 820, "sha256": "ee14f1ee1fc76acb29a6e6979a4fa168c406fdba406522fb2d601930a508dcf5", "assetId": "img:ee14f1ee1fc76acb29a6e6979a4fa168c406fdba406522fb2d601930a508dcf5", "mimeType": "image/jpeg", "elementId": "e000093", "sourceName": "assets/crop_1_1789064281871.png", "availability": "available", "formatMismatch": true}], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain why the molten electrolyte conducts electricity.", "label": "b-i", "marks": null, "partId": "q06-75c7a386-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "What is the formula of the cation in the electrolyte? A $ \\mathrm{H^{+}} $ B $ \\mathrm{Cl^{-}} $ C $ \\mathrm{Na^{+}} $ D $ \\mathrm{OH^{-}} $", "label": "b-ii", "marks": null, "partId": "q06-75c7a386-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "During the production of sodium, small explosions can be heard. Explain why using sodium chloride that is not completely dry could cause these small explosions.", "label": "b-iii", "marks": null, "partId": "q06-75c7a386-pb-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Give ionic half-equations for the reactions at the anode and cathode. anode ... cathode", "label": "b-iv", "marks": null, "partId": "q06-75c7a386-pb-iv", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Explain why the reactivity of metals in Group 1 increases from lithium to potassium.", "label": "c", "marks": null, "partId": "q06-75c7a386-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 6, "figures": [{"url": "assets/crop_1_1789064281871.png", "width": 1403, "format": "png", "height": 820, "sha256": "ee14f1ee1fc76acb29a6e6979a4fa168c406fdba406522fb2d601930a508dcf5", "assetId": "img:ee14f1ee1fc76acb29a6e6979a4fa168c406fdba406522fb2d601930a508dcf5", "mimeType": "image/jpeg", "elementId": "e000093", "sourceName": "assets/crop_1_1789064281871.png", "availability": "available", "formatMismatch": true}], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q06-75c7a386", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": []}, {"mcq": false, "qwc": false, "stem": "A student is asked to find the concentration of a solution of nitric acid by doing a titration. The student is provided with sodium hydroxide solution with a concentration of $ 0.350\\mathrm{mol/dm}^{3} $ These are the first four steps in the student''s method. use a pipette to add exactly $ 2 5. 0 \\mathrm{c m}^{3} $ of the nitric acid solution to a conical flask placed on a white tile add a few drops of indicator to the flask use a burette to add sodium hydroxide solution to the flask until the indicator has changed colour record the volume needed for the indicator to change colour", "marks": 0, "parts": [{"qwc": false, "text": "Give the reason for using the white tile.", "label": "a", "marks": null, "partId": "q07-75c7a386-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Universal indicator is not a suitable indicator to use in a titration. Complete the table to show the name of a suitable indicator and its final colour in this titration.", "label": "b", "marks": null, "partId": "q07-75c7a386-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "The student wants to obtain an accurate value for the volume of sodium hydroxide solution needed to neutralise the $ 2 5. 0 \\mathrm{c m}^{3} $ of nitric acid. Describe all the further steps the student should take.", "label": "c", "marks": null, "partId": "q07-75c7a386-pc", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "This is a summary of the student''s results. volume of $ \\mathrm{H N O}_{3} $ used $ = 2 5. 0 \\mathrm{c m}^{3} $ concentration of NaOH solution = 0.350 mol/dm $ ^{3} $ volume of NaOH solution needed for neutralisation $ = 1 8. 8 0 \\mathrm{c m}^{3} $ The equation for the reaction is $\\mathrm {H N O} _ {3} + \\mathrm {N a O H} \\rightarrow \\mathrm {N a N O} _ {3} + \\mathrm {H} _ {2} \\mathrm {O}$", "label": "d", "marks": null, "partId": "q07-75c7a386-pd", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the amount, in moles, of NaOH that reacts. $\\mathrm {a m o u n t o f N a O H} =$", "label": "d-i", "marks": null, "partId": "q07-75c7a386-pd-i", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Determine the amount, in moles, of $ \\mathrm{H N O_{3}} $ that reacts. $\\mathrm {a m o u n t o f H N O} _ {3} =$", "label": "d-ii", "marks": null, "partId": "q07-75c7a386-pd-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the concentration, in mol/dm $ ^{3} $ , of the $ \\mathrm{H N O}_{3} $ $\\mathrm {m o l / d m ^ {3}}$", "label": "d-iii", "marks": null, "partId": "q07-75c7a386-pd-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 7, "figures": [], "options": [], "section": null, "confidence": 0.45, "marksKnown": false, "questionId": "q07-75c7a386", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000118"]}, {"mcq": false, "qwc": false, "stem": "This question is about reactions involving nitrogen.", "marks": 8, "parts": [{"qwc": false, "text": "In a car engine, nitrogen reacts with oxygen to form nitrogen monoxide. The equation for the reaction is $\\mathrm {N} _ {2} + \\mathrm {O} _ {2} \\rightarrow 2 \\mathrm {N O} \\quad \\Delta H = + 1 8 1 \\mathrm {k J}$ Draw a labelled reaction profile diagram showing $ \\Delta H $ and the activation energy for the reaction.", "label": "a", "marks": null, "partId": "q08-75c7a386-pa", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "In the Haber process, nitrogen reacts with hydrogen to form ammonia. This equation represents the reaction. $\\mathrm {N} \\equiv \\mathrm {N} + 3 \\mathrm {H} - \\mathrm {H} \\rightarrow 2 \\mathrm {H} - \\mathrm {N} - \\mathrm {H}$ The table gives values of some bond energies.", "label": "b", "marks": null, "partId": "q08-75c7a386-pb", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the total amount of energy, in kJ, needed to break the bonds in the reactants.", "label": "b-i", "marks": null, "partId": "q08-75c7a386-pb-i", "figures": [], "confidence": 0.55, "answerPrompts": ["energy needed"]}, {"qwc": false, "text": "Calculate the total amount of energy, in kJ, released in forming the bonds in the product.", "label": "b-ii", "marks": null, "partId": "q08-75c7a386-pb-ii", "figures": [], "confidence": 0.55, "answerPrompts": []}, {"qwc": false, "text": "Calculate the enthalpy change, $ \\Delta H $ , for the reaction. You should include a sign in your answer. $\\Delta H =$", "label": "b-iii", "marks": null, "partId": "q08-75c7a386-pb-iii", "figures": [], "confidence": 0.55, "answerPrompts": []}], "number": 8, "figures": [], "options": [], "section": null, "confidence": 0.6, "marksKnown": true, "questionId": "q08-75c7a386", "answerPrompts": [], "numberingStyle": "space", "tableElementIds": ["e000142"]}], "paperTotal": 70, "schemaVersion": "1.0", "sectionTotals": {}, "questionTotals": {"1": 4, "3": 9, "5": 11, "6": 13, "8": 8}, "reviewRequired": true, "extractionMethod": "glm-ocr-qp-v1", "frontMatterFigures": []}', '{"paper": {"board": "Edexcel", "session": "January 2023", "subject": null, "duration": null, "examDate": null, "logNumber": "P71895A", "qualification": null, "paperReference": null, "publicationCode": "4CH1_2CR_MS_2301", "canonicalDocumentId": "4f0f4ff7-054e-50a5-a9d9-a5cb0475161c"}, "entries": [{"mcq": false, "qwc": false, "label": "1(a)", "marks": 1, "number": 1, "entryId": "ms-4f0f4ff7-q1a", "guidance": [{"kind": "note", "text": "(b)"}, {"kind": "note", "text": "any value ≥4 but<7"}, {"kind": "note", "text": "(c)"}, {"kind": "allow", "text": "ALLOW Group 8"}, {"kind": "note", "text": "(d)"}], "answerText": "7", "confidence": 0.75, "markPoints": [], "correctOption": null, "marksCellSource": "label row"}, {"mcq": false, "qwc": false, "label": "2(a)", "marks": 1, "number": 2, "entryId": "ms-4f0f4ff7-q2a", "guidance": [{"kind": "allow", "text": "ALLOW volume/amount of solvent"}, {"kind"